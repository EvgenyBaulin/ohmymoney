    "lessons.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul haqqında qısa dərslər, hərəsində beş kart"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кароткія ўрокі пра грошы, па пяць картак"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátké lekce o penězích, každá na pěti kartách"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Lektionen über Geld, je fünf Karten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short lessons of money, five cards each"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecciones breves de dinero, cinco tarjetas cada una"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De courtes leçons d'argent, cinq cartes chacune"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարճ դասեր փողի մասին՝ յուրաքանչյուրը հինգ քարտով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brevi lezioni sul denaro, cinque schede ciascuna"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოკლე გაკვეთილები ფინანსებზე, თითოეული 5 ბარათით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша туралы қысқа сабақтар, әрқайсысында бес карта"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча тууралуу кыска сабактар, ар биринде беш карточка"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótkie lekcje o pieniądzach, po pięć kart każda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lições rápidas sobre dinheiro, com cinco cartões cada"
          }
        },
        "pt-PT": {
          "stringUnit": {
