    "missed.days.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər sətir üçün kateqoriya seçin; «Naməlum» da seçilə bilər. Hesabın sətirlərinin cəmi əskik məbləğə bərabər olmalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кожнага радка патрэбна катэгорыя; «Невядома» таксама можна выбраць. Сума радкоў рахунку павінна супадаць з сумай, якой на ім не стае."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý řádek potřebuje kategorii; můžete vybrat i «Unknown». Součet řádků účtu musí odpovídat chybějící částce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile braucht eine Kategorie; „Unbekannt“ ist auch eine Wahl. Die Zeilen eines Kontos ergeben zusammen, was darauf fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each line needs a category; «Unknown» is a choice too. The lines of an account add up to what is missing on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada línea necesita una categoría; «Desconocida» también es una elección. Las líneas de una cuenta suman lo que falta en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne a besoin d'une catégorie ; « Inconnue » est aussi un choix. Les lignes d'un compte font ensemble ce qui manque sur ce compte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր տողի համար ընտրեք կատեգորիա․ կարելի է ընտրել նաև «Անհայտ»։ Հաշվի տողերի գումարը պետք է հավասար լինի պակասող գումարին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni riga richiede una categoria; puoi scegliere anche «Sconosciuta». La somma delle righe di un conto deve corrispondere all’importo mancante."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველა სტრიქონს კატეგორია სჭირდება; შეგიძლიათ აირჩიოთ «უცნობიც». ანგარიშის სტრიქონების ჯამი მის დანაკლისს უნდა უდრიდეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр жолға санат керек; «Белгісіз» те таңдау болып саналады. Есеп-шот жолдарының қосындысы сол шотта жоқ соммаға тең болуы керек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир сапка категория тандаңыз; «Белгисиз» деп да тандасаңыз болот. Эсептин саптарынын суммасы анын жетишпеген калдыгына барабар болушу керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda pozycja wymaga kategorii; możesz też wybrać «Nieznane». Suma pozycji konta musi odpowiadać brakującej kwocie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha precisa de uma categoria; «Desconhecido» também é uma opção. A soma das linhas de cada conta deve corresponder ao valor que falta nela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha precisa de uma categoria; também pode escolher «Desconhecida». A soma das linhas de cada conta tem de corresponder ao valor em falta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой строки нужна категория; «Не помню» — тоже выбор. Строки счёта складываются в то, чего на нём не хватает."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ҳар сатр категория лозим аст; «Номаълум»-ро ҳам интихоб кардан мумкин аст. Ҷамъи сатрҳои ҳар ҳисоб бояд ба маблағи норасидаи он баробар бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satır için bir kategori seç; «Bilinmiyor» da seçilebilir. Bir hesaba ait satırların toplamı, o hesaptaki eksik tutara eşit olmalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рядок потребує категорії; «Невідомо» — теж вибір. Рядки одного рахунку разом мають дорівнювати тому, чого на ньому бракує."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir qatorga toifa kerak; «Noma’lum»ni ham tanlash mumkin. Hisob qatorlari yig‘indisi undagi yetishmayotgan summaga teng bo‘lishi kerak."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每列都需要類別，也可選擇「未知」。每個帳戶的項目總額須等於其未記錄金額。"
          }
        }
      }
    },
