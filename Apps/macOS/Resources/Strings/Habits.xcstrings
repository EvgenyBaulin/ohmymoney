    "look.habit.evening": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün xərc yoxdur?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сёння без выдаткаў?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes žádné výdaje?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute keine Ausgaben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No spending today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sin gastos hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de dépense aujourd'hui ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօր ծախսեր չե՞ն եղել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna spesa oggi?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღეს არაფერი დაგიხარჯავთ?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін шығын болмады ма?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүн чыгаша болгон жокпу?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś bez wydatków?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum gasto hoje?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem despesas hoje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня трат не было?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имрӯз хароҷот набуд?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün harcama yok mu?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні без витрат?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun xarajat bo‘lmadimi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天沒有支出嗎？"
          }
        }
      }
    },
    "look.habit.eveningRemind": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü xərcləri qeyd edin — yoxsa bu gün xərc olmayıb?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запішыце сённяшнія выдаткі — ці іх не было?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište dnešní výdaje. Nebo dnes žádné nebyly?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie die heutigen Ausgaben auf — oder gab es heute keine?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down today's spending — or was there none today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote los gastos de hoy — ¿o hoy no hubo ninguno?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez vos dépenses du jour — ou n'y en a-t-il eu aucune aujourd'hui ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրանցեք այսօրվա ծախսերը, թե՞ ծախսեր չեն եղել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra le spese di oggi. Oggi non hai speso nulla?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაწერეთ დღევანდელი ხარჯები — თუ დღეს არაფერი დაგიხარჯავთ?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгінгі шығынды жазыңыз — әлде бүгін ештеңе болмады ма?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүнкү чыгашаларды жазыңыз — же бүгүн чыгаша болгон жокпу?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz dzisiejsze wydatki — a może dziś ich nie było?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre os gastos de hoje — ou não houve nenhum?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registe as despesas de hoje — ou não teve nenhuma?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите траты за день — или сегодня трат не было?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти имрӯзаро сабт кунед — ё имрӯз хароҷот набуд?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü harcamalarını kaydet — yoksa bugün harcama yapmadın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть сьогоднішні витрати — або сьогодні їх не було?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugungi xarajatlarni yozing — yoki bugun xarajat bo‘lmadimi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記下今天的支出，還是今天沒有支出？"
          }
        }
      }
    },
