    "missed.balances.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər hesabın cari qalığını daxil edin. Ən azı bir dəfə sayılmış «Cəmi» hesabları göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце бягучы рэштавы баланс кожнага рахунку. Паказаны рахункі ў «Агулам», якія звяраліся хаця б раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte aktuální zůstatek každého účtu. Zobrazují se účty v «Total», které jste alespoň jednou zkontrolovali."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie ein, was jedes Konto jetzt hält. Konten in „Gesamt“, die mindestens einmal gezählt wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type what each account holds now. Accounts in «Total» that were counted at least once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba lo que tiene ahora cada cuenta. Cuentas en «Total» que se contaron al menos una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ce que contient chaque compte maintenant. Les comptes du « Total » qui ont été comptés au moins une fois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք յուրաքանչյուր հաշվի ընթացիկ մնացորդը։ Ցուցադրված են «Ընդամենը» բաժնի առնվազն մեկ անգամ հաշվառված հաշիվները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il saldo attuale di ogni conto. Sono inclusi i conti in «Totale» conteggiati almeno una volta."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ თითოეულ ანგარიშზე არსებული თანხა. ნაჩვენებია «სულ»-ში შემავალი ანგარიშები, რომლებიც ერთხელ მაინც აღრიცხეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр есеп-шотта қазір қанша барын теріңіз. «Барлығына» кіретін, кемінде бір рет санаған есеп-шоттар."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир эсептин азыркы калдыгын киргизиңиз. Бул жерде «Жалпы» бөлүмүндөгү кеминде бир жолу эсептелген эсептер көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz obecne saldo każdego konta. Pokazano konta w «Razem» policzone co najmniej raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o saldo atual de cada conta. São mostradas as contas em «Total» que já foram contadas ao menos uma vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o saldo atual de cada conta. São apresentadas as contas em «Total» que já foram contadas pelo menos uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите, сколько сейчас на каждом счёте. Здесь счета из «Всего», которые хотя бы раз сверялись."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи кунунии ҳар ҳисобро ворид кунед. Ҳисобҳои «Ҳамагӣ», ки ақаллан як бор ҳисоб шудаанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hesabın güncel bakiyesini gir. «Toplam» içindeki en az bir kez sayılmış hesaplar gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть, скільки зараз є на кожному рахунку. Враховуються рахунки «Усього», які звіряли хоча б раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir hisobdagi joriy qoldiqni kiriting. «Jami»ga kiritilgan va kamida bir marta hisoblangan hisoblar ko‘rsatiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入各帳戶目前的餘額。僅顯示「總計」中至少盤點過一次的帳戶。"
          }
        }
      }
    },
    "missed.balances.missing": {
      "extractionState": "manual",
      "localizations": {
