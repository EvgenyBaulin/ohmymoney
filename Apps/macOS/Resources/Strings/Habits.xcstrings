    "settings.habits.eveningHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bu gün xərc yoxdur?» günü seriyaya əlavə edir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сёння без выдаткаў?» дадае дзень у серыю"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volba «Dnes žádné výdaje?» započítá den do řady"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Heute keine Ausgaben?“ zählt den Tag in der Serie mit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«No spending today?» counts the day in the streak"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«¿Sin gastos hoy?» cuenta el día en la racha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Pas de dépense aujourd'hui ? » compte le jour dans la série"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Այսօր ծախսեր չե՞ն եղել» պատասխանը օրը ներառում է շարքում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nessuna spesa oggi?» aggiunge il giorno alla serie"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«დღეს არაფერი დაგიხარჯავთ?» დღეს სერიაში ჩათვლის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Бүгін шығын болмады ма?» күнді қатардағы санға есептейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Бүгүн чыгаша болгон жокпу?» деген суроого жооп күндү катары менен жазылган күндөргө кошот"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedź «Dziś bez wydatków?» zalicza dzień do serii"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nenhum gasto hoje?» conta o dia na sequência"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sem despesas hoje?» conta o dia para a sequência"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сегодня трат не было?» засчитывает день в серию"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«Имрӯз хароҷот набуд?» рӯзро ба пайдарпайӣ илова мекунад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bugün harcama yok mu?» günü seriye ekler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сьогодні без витрат?» зараховує день до серії"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bugun xarajat bo‘lmadimi?» kunni ketma-ketlikka qo‘shadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「今天沒有支出嗎？」也會計入連續記帳天數"
          }
        }
      }
    },
