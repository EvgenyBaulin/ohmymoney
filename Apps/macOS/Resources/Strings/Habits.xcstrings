    "goal.why.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app reminds you of it when the goal money looks spent, the plan is lowered or the goal is deleted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se lo recuerda cuando el dinero del objetivo parece gastado, el plan se baja o el objetivo se elimina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application vous le rappelle quand l'argent de l'objectif semble dépensé, que le plan est abaissé ou que l'objectif est supprimé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение напомнит это, когда деньги цели потрачены, взнос уменьшен или цель удаляется"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок нагадає про це, коли гроші цілі здаються витраченими, план знижено або ціль видалено"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app te lo ricorda quando il denaro per l’obiettivo risulta speso, il piano viene ridotto o l’obiettivo viene eliminato"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат ақшасы жұмсалып кеткендей көрінгенде, жоспар төмендеген немесе мақсат жойылған кезде қолданба осыны еске салады"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма нагадае пра гэта, калі грошы на мэту будуць выглядаць патрачанымі, план будзе зменшаны або мэта выдалена"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erinnert Sie daran, wenn das Zielgeld ausgegeben scheint, der Plan gesenkt wird oder das Ziel gelöscht wird"
          }
        }
      }
    },
