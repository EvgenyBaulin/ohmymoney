    "badges.kind.count12": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir il ərzində hər ay sayım"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверка штомесяц на працягу года"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola každý měsíc po celý rok"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählung jeden Monat ein Jahr lang"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A count every month for a year"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recuento cada mes durante un año"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bilan chaque mois pendant un an"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվառում ամեն ամիս՝ մեկ տարի շարունակ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conteggio al mese per un anno"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აღრიცხვა ყოველთვიურად, ერთი წლის განმავლობაში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір жыл бойы әр ай сайын санау"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир жыл бою ай сайын эсептөө"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczenie co miesiąc przez rok"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma contagem por mês durante um ano"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma contagem por mês durante um ano"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверка каждый месяц — год"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобкунӣ ҳар моҳ дар давоми як сол"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yıl boyunca her ay sayım"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Облік щомісяця протягом року"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yil davomida har oy hisoblash"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續一年每月盤點"
          }
        }
      }
    },
