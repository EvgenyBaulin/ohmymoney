    "missed.balances.more": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydlərdə göstəriləndən çoxdur — bəlkə də qeyd olunmamış gəlirdir; xərc kimi bölüşdürülmür"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш, чым у запісах — магчыма, гэта незапісаны даход; ён не размяркоўваецца як выдаткі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Více než podle záznamů. Možná jde o nezapsaný příjem; částka se nerozpočítá jako výdaj"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr, als die Aufzeichnungen sagen — vielleicht eine nicht notierte Einnahme; sie wird nicht als Ausgabe verteilt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than the records say — perhaps an income not written down; it is not laid out as spending"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más de lo que dicen los registros — quizá un ingreso sin anotar; no se reparte como gasto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus que ce que disent les saisies — peut-être un revenu non noté ; il n'est pas réparti en dépenses"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելին է, քան ըստ գրառումների․ գուցե եկամուտ չի գրանցվել։ Այն որպես ծախս չի բաշխվի"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo supera quello registrato: potrebbe esserci un’entrata non registrata, che non verrà ripartita come spesa"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩანაწერებზე მეტია — შესაძლოა, შემოსავალი არ ჩაგიწერიათ; ეს თანხა ხარჯად არ ნაწილდება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазбалар айтқаннан көп — мүмкін жазылмаған табыс; ол шығын ретінде көрсетілмейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазууларда көрсөтүлгөндөн көп — балким, киреше жазылбай калган; ал чыгаша катары бөлүштүрүлбөйт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Więcej niż wynika z wpisów — być może to niezapisany przychód; nie zostanie rozpisany jako wydatek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maior que o saldo nos registros — talvez seja uma receita não registrada; ela não será distribuída como gasto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Superior ao valor nos registos — talvez haja um rendimento por registar; a diferença não é distribuída como despesa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше, чем по записям — похоже на незаписанный доход; как трату его не раскладываем"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз маблағи дар сабтҳо буда бештар аст — шояд даромаде сабт нашудааст; он ҳамчун хароҷот тақсим намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlardakinden fazla — kaydedilmemiş bir gelir olabilir; harcama olarak dağıtılmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше, ніж показують записи, — можливо, дохід, якого не записали; він не розкладається як витрата"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yozuvdagidan ko‘p — ehtimol, daromad yozilmagan; bu xarajat sifatida taqsimlanmaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高於記錄餘額，可能有未記錄的收入；不會列為支出"
          }
        }
      }
    },
    "missed.balances.noAccounts": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Cəmi» bölməsindəki hesabların heç biri hələ sayılmayıb. Əvvəlcə sayım edin ki, müqayisə mümkün olsun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніводзін рахунак у «Агулам» яшчэ не звяраўся. Спачатку зрабіце зверку, каб было з чым параўнаць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím jste nezkontrolovali žádný účet v «Total». Nejprve proveďte kontrolu, aby měl průvodce s čím porovnávat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto in „Gesamt“ wurde bisher gezählt. Zählen Sie zuerst, dann weiß der Assistent, womit er vergleichen soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account in «Total» was counted yet. Make a count first, and the wizard will know what to compare with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se contó ninguna cuenta de «Total». Haga antes un recuento y el asistente sabrá con qué comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte du « Total » n'a encore été compté. Faites d'abord un bilan, et l'assistant saura à quoi comparer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ընդամենը» բաժնի ոչ մի հաշիվ դեռ չի հաշվառվել։ Նախ հաշվառում արեք, որպեսզի հնարավոր լինի համեմատել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conto in «Totale» è ancora stato conteggiato. Esegui prima un conteggio per avere un termine di confronto."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«სულ»-ში შემავალი არცერთი ანგარიში ჯერ არ აღრიცხულა. ჯერ აღრიცხეთ ანგარიშები, რათა შედარება შევძლოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Барлығына» кіретін бірде-бір есеп-шот әлі саналмаған. Алдымен санаңыз — шебер нешемен салыстыру керектігін біледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Жалпы» бөлүмүндөгү бир да эсеп эсептеле элек. Салыштыруу үчүн адегенде эсептеп чыгыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne konto w «Razem» nie zostało jeszcze policzone. Najpierw policz środki, aby było z czym porównać salda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta em «Total» foi contada ainda. Faça uma contagem primeiro para que o assistente tenha uma base de comparação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi contada nenhuma conta em «Total». Faça primeiro uma contagem para que o assistente possa comparar os valores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один счёт из «Всего» ещё не сверялся. Сначала сделайте сверку — тогда будет с чем сравнить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз ягон ҳисоб дар «Ҳамагӣ» ҳисоб нашудааст. Аввал ҳисоб кунед, то ёвар барои муқоиса маълумот дошта бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Toplam» içindeki hiçbir hesap henüz sayılmadı. Karşılaştırma yapılabilmesi için önce sayım yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден рахунок «Усього» ще не звірено. Спершу зробіть облік — майстер знатиме, з чим порівнювати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Jami»dagi hech bir hisob hali hisoblanmagan. Avval hisoblang, shunda yordamchi nima bilan solishtirishni biladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「總計」中的帳戶尚未盤點。請先盤點，才能比較餘額。"
          }
        }
      }
    },
    "missed.balances.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün qalıqlar qeydlərə uyğundur: bərpa ediləcək heç nə yoxdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе рэшткі супадаюць з запісамі: няма чаго аднаўляць"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny zůstatky odpovídají záznamům. Není co obnovit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Saldo stimmt mit den Aufzeichnungen überein: nichts wiederherzustellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every balance matches the records: nothing to restore"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada saldo coincide con los registros: nada que restaurar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque solde concorde avec les saisies : rien à restaurer"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բոլոր մնացորդները համընկնում են գրառումներին․ վերականգնելու բան չկա"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i saldi corrispondono alle registrazioni: niente da recuperare"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველა ნაშთი ემთხვევა ჩანაწერებს: აღსადგენი არაფერია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық теңгерім жазбаларға сәйкес: қайтаратын ештеңе жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бардык калдыктар жазууларга дал келет: калыбына келтире турган эч нерсе жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie salda zgadzają się z wpisami. Nie ma nic do odtworzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os saldos conferem com os registros: nada a restaurar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os saldos correspondem aos registos: não há nada a repor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все остатки сходятся с записями: восстанавливать нечего"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳамаи бақияҳо ба сабтҳо мувофиқанд: чизе барои барқарор кардан нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
