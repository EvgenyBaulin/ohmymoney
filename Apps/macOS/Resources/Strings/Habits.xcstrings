    "missed.changed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bərpa zamanı qalıqlar dəyişdi. Pəncərəni bağlayın və yenidən sayım edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэшткі змяніліся, пакуль майстар быў адкрыты. Закрыйце яго і зрабіце зверку зноў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatky se během práce s průvodcem změnily. Zavřete ho a proveďte kontrolu znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Salden haben sich geändert, während der Assistent offen war. Schließen Sie ihn und zählen Sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balances changed while the wizard was open. Close it and count again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos cambiaron mientras el asistente estaba abierto. Ciérrelo y cuente de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes ont changé pendant que l'assistant était ouvert. Fermez-le et comptez à nouveau."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մնացորդները փոխվել են, մինչ օգնականը բաց էր։ Փակեք այն և նորից հաշվառում արեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi sono cambiati durante la procedura. Chiudila ed esegui un nuovo conteggio."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაშთები შეიცვალა, სანამ აღდგენის ფანჯარა ღია იყო. დახურეთ და ხელახლა აღრიცხეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шебер ашық тұрғанда теңгерімдер өзгерді. Оны жауып, қайтадан санаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Калыбына келтирүү учурунда калдыктар өзгөрдү. Терезени жаап, кайра эсептеңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salda zmieniły się podczas działania asystenta. Zamknij go i policz środki ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos mudaram enquanto o assistente estava aberto. Feche-o e faça uma nova contagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos mudaram enquanto o assistente estava aberto. Feche-o e faça uma nova contagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока мастер был открыт, остатки изменились. Закройте его и посчитайте заново."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми кушода будани ёвар бақияҳо тағйир ёфтанд. Онро пӯшед ва аз нав ҳисоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sihirbaz açıkken bakiyeler değişti. Sihirbazı kapatıp yeniden sayım yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки змінилися, поки майстер був відкритий. Закрийте його і порахуйте знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yordamchi ochiq turganda qoldiqlar o‘zgardi. Uni yoping va qayta hisoblang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作期間餘額已變更。請關閉並重新盤點。"
          }
        }
      }
    },
