    "goal.why.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məqsəd üçün yığılan pul xərclənmiş görünəndə, plan azaldılanda və ya məqsəd silinəndə tətbiq bunu sizə xatırladır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма нагадае пра гэта, калі грошы на мэту будуць выглядаць патрачанымі, план будзе зменшаны або мэта выдалена"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace vám důvod připomene, když to vypadá, že jste peníze na cíl utratili, když snížíte plán nebo cíl smažete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erinnert Sie daran, wenn das Zielgeld ausgegeben scheint, der Plan gesenkt wird oder das Ziel gelöscht wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app reminds you of it when the goal money looks spent, the plan is lowered or the goal is deleted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se lo recuerda cuando el dinero del objetivo parece gastado, el plan se baja o el objetivo se elimina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application vous le rappelle quand l'argent de l'objectif semble dépensé, que le plan est abaissé ou que l'objectif est supprimé"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածը կհիշեցնի այդ մասին, երբ նպատակի գումարը ծախսված թվա, պլանը նվազեցվի կամ նպատակը ջնջվի"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app te lo ricorda quando il denaro per l’obiettivo risulta speso, il piano viene ridotto o l’obiettivo viene eliminato"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპი შეგახსენებთ, როცა მიზნისთვის გადადებული თანხა დახარჯულად გამოჩნდება, გეგმას შეამცირებთ ან მიზანს წაშლით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат ақшасы жұмсалып кеткендей көрінгенде, жоспар төмендеген немесе мақсат жойылған кезде қолданба осыны еске салады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Максатка топтолгон акча сарпталгандай көрүнгөндө, план азайтылганда же максат өчүрүлгөндө колдонмо муну эскертип турат"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja przypomni Ci o tym, gdy pieniądze na cel wydadzą się wydane, plan zostanie obniżony lub cel usunięty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app lembra você disso quando o dinheiro da meta parece ter sido gasto, o valor planejado é reduzido ou a meta é apagada"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app recorda-lhe este motivo quando o dinheiro do objetivo parecer gasto, o plano for reduzido ou o objetivo for apagado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение напомнит это, когда деньги цели потрачены, взнос уменьшен или цель удаляется"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вақте пули ҳадаф сарфшуда менамояд, нақша кам мешавад ё ҳадаф ҳазф мешавад, барнома инро ба шумо ёдрас мекунад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef için biriktirilen para harcanmış göründüğünde, plan azaltıldığında veya hedef silindiğinde uygulama bunu hatırlatır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок нагадає про це, коли гроші цілі здаються витраченими, план знижено або ціль видалено"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maqsad puli sarflangandek ko‘rinsa, reja kamaytirilsa yoki maqsad o‘chirilsa, ilova buni eslatadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當目標金額看似已花費、計畫金額降低或目標遭刪除時，App 會提醒你"
          }
        }
      }
    },
