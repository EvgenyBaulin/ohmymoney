    "settings.habits.beginnerHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mürəkkəb bölmələr görünür, lakin göstərəcək məlumat olana qədər solğun qalır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Складаныя раздзелы застаюцца бачнымі, але прыглушанымі, пакуль у іх няма даных"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složitější části zůstanou viditelné, ale ztlumené, dokud v nich nebude co zobrazit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komplexe Bereiche bleiben sichtbar, aber abgeblendet, bis es etwas zu zeigen gibt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complex sections stay visible but dimmed until they have something to show"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las secciones complejas se ven atenuadas hasta que tengan algo que mostrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sections complexes restent visibles mais atténuées tant qu'elles n'ont rien à montrer"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բարդ բաժինները տեսանելի են, բայց խամրած, մինչև դրանցում տվյալներ լինեն"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sezioni più complesse restano visibili ma attenuate finché non hanno contenuti da mostrare"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რთული განყოფილებები ჩანს, მაგრამ ჩამქრალია, სანამ მათში რამე გამოჩნდება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күрделі бөлімдер көрінеді, бірақ көрсетер нәрсесі пайда болғанша бозаңдау болып тұрады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Татаал бөлүмдөр көрсөтө турган маалымат пайда болгонго чейин күңүрт көрүнөт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bardziej złożone sekcje są widoczne, ale przygaszone, dopóki nie mają nic do pokazania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As seções mais complexas ficam visíveis, mas esmaecidas, até terem algo para mostrar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As secções mais complexas ficam visíveis, mas esbatidas, até terem algo para mostrar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сложные разделы видны, но приглушены, пока им нечего показать"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бахшҳои мураккаб то пайдо шудани маълумот намоён, вале хиратар мемонанд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmiş bölümler, gösterilecek bir şey olana kadar soluk görünür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Складні розділи лишаються видимими, але приглушеними, доки їм нема чого показати"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Murakkab bo‘limlar ko‘rinib turadi, ammo ko‘rsatadigan ma’lumot paydo bo‘lguncha xira bo‘ladi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進階區域會保持顯示但呈灰色，直到有內容可顯示"
          }
        }
      }
    },
    "settings.habits.evening": {
      "extractionState": "manual",
      "localizations": {
