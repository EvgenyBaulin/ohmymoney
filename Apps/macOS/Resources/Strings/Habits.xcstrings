    "missed.days.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each line needs a category; «Unknown» is a choice too. The lines of an account add up to what is missing on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada línea necesita una categoría; «Desconocida» también es una elección. Las líneas de una cuenta suman lo que falta en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne a besoin d'une catégorie ; « Inconnue » est aussi un choix. Les lignes d'un compte font ensemble ce qui manque sur ce compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой строки нужна категория; «Не помню» — тоже выбор. Строки счёта складываются в то, чего на нём не хватает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рядок потребує категорії; «Невідомо» — теж вибір. Рядки одного рахунку разом мають дорівнювати тому, чого на ньому бракує."
          }
        }
      }
    },
