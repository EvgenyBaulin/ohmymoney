    "settings.habits.beginnerHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complex sections stay visible but dimmed until they have something to show"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las secciones complejas se ven atenuadas hasta que tengan algo que mostrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sections complexes restent visibles mais atténuées tant qu'elles n'ont rien à montrer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сложные разделы видны, но приглушены, пока им нечего показать"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Складні розділи лишаються видимими, але приглушеними, доки їм нема чого показати"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sezioni più complesse restano visibili ma attenuate finché non hanno contenuti da mostrare"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күрделі бөлімдер көрінеді, бірақ көрсетер нәрсесі пайда болғанша бозаңдау болып тұрады"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Складаныя раздзелы застаюцца бачнымі, але прыглушанымі, пакуль у іх няма даных"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komplexe Bereiche bleiben sichtbar, aber abgeblendet, bis es etwas zu zeigen gibt"
          }
        }
      }
    },
    "settings.habits.evening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about the day's spending in the evening"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar por los gastos del día por la noche"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander le soir les dépenses du jour"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечером спрашивать о тратах за день"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Питати ввечері про витрати за день"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi delle spese della giornata la sera"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешке күндегі шығын туралы сұрау"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увечары пытацца пра выдаткі за дзень"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Abend nach den heutigen Ausgaben fragen"
          }
        }
      }
    },
    "settings.habits.eveningHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«No spending today?» counts the day in the streak"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«¿Sin gastos hoy?» cuenta el día en la racha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Pas de dépense aujourd'hui ? » compte le jour dans la série"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сегодня трат не было?» засчитывает день в серию"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сьогодні без витрат?» зараховує день до серії"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nessuna spesa oggi?» aggiunge il giorno alla serie"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Бүгін шығын болмады ма?» күнді қатардағы санға есептейді"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сёння без выдаткаў?» дадае дзень у серыю"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Heute keine Ausgaben?“ zählt den Tag in der Serie mit"
          }
        }
      }
    },
