        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom %1$@ bis %2$@ wurde nichts erfasst. Zuerst die Salden, dann die Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was entered from %1$@ to %2$@. First the balances, then the days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se anotó nada desde el %1$@ hasta el %2$@. Primero los saldos, luego los días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été saisi du %1$@ au %2$@. D'abord les soldes, puis les jours."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@ ժամանակահատվածում գրառումներ չեն եղել։ Նախ նշեք մնացորդները, ապա՝ օրերը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna registrazione dal %1$@ al %2$@. Prima i saldi, poi i giorni."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-დან %2$@-მდე ჩანაწერები არ არის. ჯერ ნაშთები შეიყვანეთ, შემდეგ — დღეები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ бастап %2$@ дейін ештеңе енгізілмеген. Алдымен теңгерімдер, содан кейін күндер."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күнүнөн %2$@ күнүнө чейин жазуу болгон жок. Адегенде калдыктарды, андан кийин күндөрдү толтуруңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wpisów od %1$@ do %2$@. Najpierw salda, potem dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum lançamento de %1$@ a %2$@. Primeiro os saldos, depois os dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve registos de %1$@ a %2$@. Primeiro os saldos, depois os dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С %1$@ по %2$@ ничего не записано. Сначала остатки, потом дни."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз %1$@ то %2$@ чизе сабт нашудааст. Аввал бақияҳо, баъд рӯзҳо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ile %2$@ arasında kayıt girilmedi. Önce bakiyeleri, sonra günleri düzenle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З %1$@ до %2$@ нічого не записано. Спершу залишки, потім дні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dan %2$@ gacha yozuv kiritilmagan. Avval qoldiqlarni, so‘ng kunlarni kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 %1$@ 到 %2$@ 沒有記帳。請先確認餘額，再分配日期。"
          }
        }
      }
    },
