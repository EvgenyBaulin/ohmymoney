    "sharedReport.encrypt.csv": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cədvəl bu parolla qorunan OhMyMoney faylına yazılır. Şifrələmə olmadan adi CSV faylı olur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Табліца змяшчаецца ў файл OhMyMoney, абаронены гэтым паролем. Без шыфравання гэта звычайны CSV-файл."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabulka se uloží do souboru OhMyMoney chráněného tímto heslem. Bez šifrování se uloží jako běžný soubor CSV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tabelle wird in einer OhMyMoney-Datei mit diesem Passwort geschützt. Ohne Verschlüsselung wird sie als einfache CSV-Datei gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table goes into an OhMyMoney file locked with this password. Without encryption it is a plain CSV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabla se guarda en un archivo de OhMyMoney protegido con esta contraseña. Sin cifrar, se guarda como CSV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau est placé dans un fichier OhMyMoney protégé par ce mot de passe. Sans chiffrement, il s’agit d’un simple fichier CSV."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Աղյուսակը կպահվի այս գաղտնաբառով պաշտպանված OhMyMoney ֆայլում։ Առանց գաղտնագրման այն սովորական CSV ֆայլ է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabella viene salvata in un file OhMyMoney protetto da questa password. Senza codifica è un semplice file CSV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表はこのパスワードでロックされたOhMyMoneyファイルに保存されます。暗号化しない場合は通常のCSVになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცხრილი შეინახება OhMyMoney ფაილში, რომელიც ამ პაროლით იქნება დაცული. დაშიფვრის გარეშე ის ჩვეულებრივი CSV ფაილია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кесте осы құпиясөзбен қорғалған OhMyMoney файлына сақталады. Шифрлаусыз ол кәдімгі CSV файлы болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблица ушул сырсөз менен корголгон OhMyMoney файлына сакталат. Шифрлөөсүз кадимки CSV файлы болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tabel wordt opgeslagen in een OhMyMoney-bestand dat met dit wachtwoord is beveiligd. Zonder versleuteling is het een gewoon CSV-bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela zostanie zapisana w pliku OhMyMoney zabezpieczonym tym hasłem. Bez szyfrowania zostanie zapisana jako zwykły plik CSV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabela é salva em um arquivo OhMyMoney protegido por esta senha. Sem criptografia, é um CSV comum."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabela é guardada num ficheiro OhMyMoney protegido com esta palavra-passe. Sem encriptação, é um ficheiro CSV simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблица ляжет в файл OhMyMoney, закрытый этим паролем. Без шифрования — обычный CSV."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷадвал дар файли OhMyMoney бо ин парол ҳифз мешавад. Бе рамзгузорӣ он файли одии CSV аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablo, bu parolayla kilitlenen bir OhMyMoney dosyasına kaydedilir. Şifrelenmezse düz bir CSV dosyası olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблицю буде збережено у файлі OhMyMoney, захищеному цим паролем. Без шифрування це звичайний файл CSV."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadval ushbu parol bilan himoyalangan OhMyMoney fayliga saqlanadi. Shifrlanmasa, oddiy CSV bo‘ladi."
          }
        }
      }
    },
