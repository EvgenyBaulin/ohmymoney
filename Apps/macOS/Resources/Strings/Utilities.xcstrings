    "utilities.reading.decreased": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Göstərici əvvəlkindən azdır — bu ay üçün sərfiyyat hesablanmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паказанне меншае за папярэдняе — спажыванне за месяц не ўлічваецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odečet je nižší než předchozí — za daný měsíc se nezapočítá žádná spotřeba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zählerstand ist niedriger als der vorherige. Für diesen Monat wird kein Verbrauch berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reading is lower than the one before — the month counts no use for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lectura es inferior a la anterior; no se contabiliza consumo para ese mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un relevé est inférieur au précédent : aucune consommation n’est comptée pour ce mois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցուցմունքը նախորդից փոքր է․ այս ամսվա սպառումը չի հաշվվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lettura è inferiore alla precedente: il consumo del mese è pari a zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検針値が前回を下回っているため、今月の使用量は計上されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩვენება წინაზე ნაკლებია — ამ თვის მოხმარება არ ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрсеткіш алдыңғысынан төмен — осы айда тұтыну есептелмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрсөткүч мурункусунан төмөн — бул айда сарптоо эсептелбейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stand is lager dan de vorige. Hiervoor wordt deze maand geen verbruik berekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczyt jest niższy od poprzedniego — zużycie za ten miesiąc nie jest naliczane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma leitura é menor que a anterior — nenhum consumo será contabilizado para ela neste mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma leitura é inferior à anterior — não é contabilizado consumo para esse contador neste mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно из показаний меньше предыдущего — за него расход не считается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нишондод аз нишондоди пешина камтар аст — барои ин моҳ сарф ҳисоб намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir endeks önceki değerden düşük; bu ay için tüketim hesaplanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показник менший за попередній — споживання за місяць не враховується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘rsatkich avvalgisidan kichik — bu oy uchun sarf hisoblanmaydi."
          }
        }
      }
    },
