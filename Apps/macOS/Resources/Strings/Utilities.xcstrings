        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo k PDF musí obsahovat pouze písmena latinky a číslice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine PDF-Datei darf das Passwort nur lateinische Buchstaben und Ziffern enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a PDF the password must use Latin letters and digits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña del PDF debe contener letras latinas y números."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un PDF, le mot de passe doit contenir des lettres latines et des chiffres."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-ի գաղտնաբառը պետք է պարունակի լատինատառ տառեր և թվեր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un PDF, la password deve contenere solo lettere latine e cifre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFのパスワードには英字と数字を使用してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-ის პაროლი ლათინური ასოებისა და ციფრებისგან უნდა შედგებოდეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF құпиясөзінде латын әріптері мен цифрлар ғана болуы керек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF үчүн сырсөздө латын тамгалары жана цифралар гана болушу керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een pdf moet het wachtwoord uit Latijnse letters en cijfers bestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło do pliku PDF musi zawierać tylko litery łacińskie i cyfry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para PDF, a senha deve conter letras latinas e números."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um PDF, a palavra-passe tem de usar letras latinas e algarismos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для PDF пароль — латиницей и цифрами."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои PDF парол бояд аз ҳарфҳои лотинӣ ва рақамҳо иборат бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF parolası Latin harfleri ve rakamlardan oluşmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль для PDF має складатися з латинських літер і цифр."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF uchun parolda lotin harflari va raqamlar bo‘lishi kerak."
          }
        }
      }
