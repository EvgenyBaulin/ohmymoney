    "sharedReport.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayla yalnız dövr üzrə seçilmiş hesablar və kateqoriyalar daxil edilir. Digər məlumatlarınız sizdə qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У файл трапяць толькі выбраныя рахункі і катэгорыі за гэты перыяд. Астатнія даныя застануцца ў вас."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do souboru se zahrnou jen vybrané účty a kategorie za dané období. Ostatní data zůstanou u vás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ausgewählten Konten und Kategorien des Zeitraums werden in die Datei aufgenommen. Deine übrigen Daten bleiben bei dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the chosen accounts and categories of the period go into the file. The rest of your data stays with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo solo incluye las cuentas y categorías seleccionadas del periodo. El resto de tus datos permanece contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les comptes et les catégories sélectionnés pour la période sont inclus dans le fichier. Le reste de vos données reste avec vous."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլում կներառվեն միայն ընտրված հաշիվներն ու տվյալ ժամանակաշրջանի կատեգորիաները։ Մնացած տվյալները կմնան ձեզ մոտ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file include solo i conti e le categorie scelti per il periodo. Il resto dei tuoi dati rimane con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した期間の口座とカテゴリのみがファイルに含まれます。その他のデータは共有されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილში მოხვდება მხოლოდ არჩეული ანგარიშებისა და კატეგორიების მონაცემები მითითებული პერიოდისთვის. დანარჩენი მონაცემები თქვენთან დარჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлға тек таңдалған шоттар мен санаттардың осы кезеңдегі деректері кіреді. Қалған деректеріңіз өзіңізде қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлга тандалган эсептер менен категориялардын көрсөтүлгөн мезгилдеги маалыматтары гана кирет. Калган маалыматтар сизде калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de gekozen rekeningen en categorieën uit deze periode worden in het bestand opgenomen. De rest van je gegevens blijft bij jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zawiera tylko dane z wybranego okresu dotyczące wybranych kont i kategorii. Pozostałe dane pozostają u Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as contas e categorias escolhidas do período são incluídas no arquivo. Seus outros dados permanecem com você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro inclui apenas as contas e categorias selecionadas para o período. Os restantes dados ficam consigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файл попадут только выбранные счета и категории за период. Остальные данные останутся у вас."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба файл танҳо ҳисобҳо ва категорияҳои интихобшудаи ин давра дохил мешаванд. Маълумоти дигаратон назди худатон мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaya yalnızca seçilen hesaplar ve kategoriler için belirtilen döneme ait veriler eklenir. Diğer verileriniz sizde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У файл увійдуть лише вибрані рахунки й категорії за цей період. Решта даних залишиться у вас."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylga faqat tanlangan hisoblar va turkumlarning davrga oid ma’lumotlari kiritiladi. Qolgan ma’lumotlaringiz o‘zingizda qoladi."
          }
        }
      }
    },
