    "utilities.bills.footer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər faktura eyni təchizatçının ötən ay və ötən ilin eyni ayı üzrə fakturaları ilə müqayisə edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожны рахунак параўноўваецца з рахункамі таго ж пастаўшчыка за мінулы месяц і за той жа месяц летась."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé vyúčtování se porovnává s vyúčtováním stejného poskytovatele za minulý měsíc a za stejný měsíc minulého roku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Rechnung wird mit der Rechnung desselben Anbieters vom Vormonat und vom gleichen Monat des Vorjahres verglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bill is compared with the same provider's bill of last month and of the same month last year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada factura se compara con la del mismo proveedor del mes anterior y del mismo mes del año pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque facture est comparée à celle du mois précédent et à celle du même mois de l’année précédente pour le même fournisseur."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր հաշիվ համեմատվում է նույն մատակարարի նախորդ ամսվա և անցյալ տարվա նույն ամսվա հաշիվների հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni bolletta viene confrontata con quella dello stesso fornitore del mese precedente e dello stesso mese dell’anno scorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各請求書は、同じ事業者の先月および前年同月の請求書と比較されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული ქვითარი შედარებულია იმავე მომწოდებლის გასული თვისა და გასული წლის იმავე თვის ქვითრებთან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр түбіртек сол қызмет көрсетушінің өткен айдағы және былтырғы осы айдағы түбіртектерімен салыстырылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир эсеп ошол эле кызмат көрсөтүүчүнүн өткөн айдагы жана былтыркы ушул айдагы эсептери менен салыштырылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke rekening wordt vergeleken met de rekening van dezelfde aanbieder van vorige maand en van dezelfde maand vorig jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy rachunek jest porównywany z rachunkiem tego samego dostawcy za poprzedni miesiąc i za ten sam miesiąc w zeszłym roku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada conta é comparada com a do mesmo fornecedor no mês passado e no mesmo mês do ano passado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fatura é comparada com a do mesmo fornecedor no mês anterior e no mesmo mês do ano passado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая квитанция сравнивается с квитанцией того же поставщика за прошлый месяц и за тот же месяц прошлого года."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳар ҳисоб бо ҳисоби моҳи гузашта ва ҳамон моҳи соли гузаштаи ҳамон таъминкунанда муқоиса мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her fatura, aynı sağlayıcının geçen ayki ve geçen yılın aynı ayındaki faturasıyla karşılaştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рахунок порівнюється з рахунком того самого постачальника за минулий місяць і за той самий місяць минулого року."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir hisob shu ta’minotchining o‘tgan oydagi va o‘tgan yilning shu oyidagi hisobi bilan solishtiriladi."
          }
        }
      }
    },
