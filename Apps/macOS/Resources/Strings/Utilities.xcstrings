    "utilities.reading.ask.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Göstərici əvvəlkindən azdır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паказанне меншае за папярэдняе"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odečet je nižší než předchozí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zählerstand ist niedriger als der letzte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reading is lower than the last one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura es inferior a la anterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relevé est inférieur au précédent"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցուցմունքը նախորդից փոքր է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
