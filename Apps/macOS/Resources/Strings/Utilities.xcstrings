    "utilities.reading.ask.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayğac dəyişdirilib, yoxsa yazı səhvidir? Hər iki halda göstərici saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічыльнік замянілі ці гэта памылка? Паказанне захавана ў любым выпадку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bylo měřidlo vyměněno, nebo jde o překlep? Odečet se v obou případech uloží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wurde der Zähler ausgetauscht oder liegt ein Tippfehler vor? Der Zählerstand wird in jedem Fall gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Was the meter replaced, or is it a typo? Either way the reading is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Se ha sustituido el contador o hay un error? La lectura se guardará en cualquier caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compteur a-t-il été remplacé ou s’agit-il d’une erreur de saisie ? Le relevé est enregistré dans les deux cas."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվիչը փոխվե՞լ է, թե՞ վրիպակ է։ Ամեն դեպքում ցուցմունքը կպահվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contatore è stato sostituito o c’è un errore di digitazione? In ogni caso, la lettura viene salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メーターを交換しましたか？それとも入力ミスですか？いずれの場合も検針値は保存されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მრიცხველი შეიცვალა თუ შეცდომით შეიყვანეთ? ჩვენება ორივე შემთხვევაში შეინახება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептегіш ауыстырылды ма, әлде қате енгізілді ме? Қалай болғанда да, көрсеткіш сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептегич алмаштырылдыбы же ката кеттиби? Кандай болбосун, көрсөткүч сакталды."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is de meter vervangen of is het een typfout? De meterstand wordt in beide gevallen bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy licznik został wymieniony, czy to literówka? Odczyt zostanie zachowany w obu przypadkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O medidor foi trocado ou houve um erro de digitação? A leitura foi salva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O contador foi substituído ou é um erro de escrita? A leitura é guardada em qualquer caso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счётчик заменили или это опечатка? В обоих случаях показание сохранится."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобкунак иваз шудааст ё хато навиштед? Дар ҳар сурат, нишондод нигоҳ дошта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayaç değiştirildi mi, yoksa yazım hatası mı var? Her iki durumda da değer kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічильник замінили чи це помилка? Показання збережено в будь-якому разі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblagich almashtirildimi yoki xato kiritildimi? Har ikkala holatda ham ko‘rsatkich saqlanadi."
          }
        }
      }
    },
