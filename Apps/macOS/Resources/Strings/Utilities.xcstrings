          "stringUnit": {
            "state": "translated",
            "value": "Sayaçlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічильники"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblagichlar"
          }
        }
      }
    },
    "utilities.meters.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ sayğac yoxdur. Sərfiyyatı ötən ay və ötən illə müqayisə etmək üçün su, elektrik və ya qaz sayğacı əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічыльнікаў пакуль няма. Дадайце лічыльнік вады, электрычнасці або газу, каб параўнаць спажыванне з мінулым месяцам і мінулым годам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádná měřidla. Přidejte vodu, elektřinu nebo plyn a porovnejte spotřebu s minulým měsícem a rokem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Zähler. Füge Wasser-, Strom- oder Gaszähler hinzu, um den Verbrauch mit dem Vormonat und dem Vorjahr zu vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No meters yet. Add water, electricity or gas to see what they use against last month and last year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay contadores. Añade uno de agua, electricidad o gas para comparar el consumo con el del mes anterior y el año pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compteur pour le moment. Ajoutez un compteur d’eau, d’électricité ou de gaz pour comparer sa consommation au mois et à l’année précédents."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվիչներ դեռ չկան։ Ավելացրեք ջրի, էլեկտրականության կամ գազի հաշվիչ՝ սպառումը նախորդ ամսվա և անցյալ տարվա հետ համեմատելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun contatore. Aggiungi acqua, energia elettrica o gas per confrontare i consumi con il mese scorso e l’anno scorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メーターはまだありません。水道、電気、ガスを追加すると、使用量を先月や前年と比較できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მრიცხველები ჯერ არ არის. დაამატეთ წყლის, ელექტროენერგიის ან გაზის მრიცხველი, რომ მოხმარება გასულ თვესა და გასულ წელს შეადაროთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептегіштер әлі жоқ. Тұтынуды өткен аймен және былтырғы көрсеткіштермен салыстыру үшін су, электр немесе газ есептегішін қосыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептегичтер жок. Өткөн ай жана былтыр менен салыштыруу үчүн суу, электр же газ эсептегичин кошуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen meters. Voeg water, elektriciteit of gas toe om het verbruik te vergelijken met vorige maand en vorig jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak liczników. Dodaj licznik wody, prądu lub gazu, aby porównać zużycie z poprzednim miesiącem i zeszłym rokiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum medidor ainda. Adicione água, energia elétrica ou gás para comparar o consumo com o mês e o ano passados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há contadores. Adicione água, eletricidade ou gás para comparar os consumos com o mês anterior e o ano passado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счётчиков пока нет. Добавьте воду, свет или газ — и будет видно расход к прошлому месяцу и прошлому году."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз ҳисобкунак нест. Об, барқ ё газро илова кунед, то масрафро бо моҳи гузашта ва соли гузашта муқоиса кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sayaç yok. Tüketimi geçen ay ve geçen yılla karşılaştırmak için su, elektrik veya gaz sayacı ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічильників ще немає. Додайте лічильник води, електроенергії чи газу, щоб порівняти споживання з минулим місяцем і минулим роком."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali hisoblagichlar yo‘q. Sarfni o‘tgan oy va o‘tgan yil bilan solishtirish uchun suv, elektr yoki gaz hisoblagichini qo‘shing."
          }
        }
      }
    },
