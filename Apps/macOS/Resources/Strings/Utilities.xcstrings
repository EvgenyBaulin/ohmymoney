    "utilities.reading.lower": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Göstərici əvvəlkindən azdır. Sayğac dəyişdirilibsə, yuxarıdakı açarı aktiv edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Меншае за папярэдняе паказанне. Калі лічыльнік заменены, уключыце перамыкач вышэй."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nižší než poslední odečet. Pokud bylo měřidlo vyměněno, zapněte přepínač výše."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedriger als der letzte Zählerstand. Wenn der Zähler ausgetauscht wurde, aktiviere den Schalter oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower than the last reading. If the meter was replaced, turn on the switch above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es inferior a la lectura anterior. Si se sustituyó el contador, activa la opción de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inférieur au dernier relevé. Si le compteur a été remplacé, activez l’option ci-dessus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցուցմունքը նախորդից փոքր է։ Եթե հաշվիչը փոխվել է, միացրեք վերևի անջատիչը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inferiore all’ultima lettura. Se il contatore è stato sostituito, attiva l’interruttore sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の検針値を下回っています。メーターを交換した場合は、上のスイッチをオンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო ჩვენებაზე ნაკლებია. თუ მრიცხველი შეიცვალა, ჩართეთ გადამრთველი ზემოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрсеткіш алдыңғысынан төмен. Есептегіш ауыстырылса, жоғарыдағы қосқышты қосыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрсөткүч мурункусунан төмөн. Эсептегич алмаштырылган болсо, жогорудагы которгучту күйгүзүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lager dan de vorige stand. Schakel de optie hierboven in als de meter is vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczyt jest niższy od poprzedniego. Jeśli licznik został wymieniony, włącz przełącznik powyżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menor que a leitura anterior. Se o medidor foi substituído, ative a opção acima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inferior à última leitura. Se o contador foi substituído, ative a opção acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше прошлого показания. Если счётчик заменили — включите переключатель выше."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз нишондоди пешина камтар аст. Агар ҳисобкунак иваз шуда бошад, гузаргоҳи болоро фаъол кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endeks önceki değerden düşük. Sayaç değiştirildiyse yukarıdaki anahtarı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менший за попередній показник. Якщо лічильник замінено, увімкніть перемикач вище."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi ko‘rsatkichdan kichik. Hisoblagich almashtirilgan bo‘lsa, yuqoridagi tugmani yoqing."
          }
        }
      }
    },
    "utilities.reading.restart": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayğac dəyişdirilib və ya dövrü tamamlayıb"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічыльнік заменены або абнуліўся"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měřidlo bylo vyměněno nebo se přetočilo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zähler wurde ausgetauscht oder ist übergelaufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meter was replaced or went round"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contador se sustituyó o dio la vuelta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compteur a été remplacé ou a fait un tour complet"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվիչը փոխվել է կամ զրոյից սկսել է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contatore è stato sostituito o ha fatto un giro completo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メーターを交換したか、一巡した"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მრიცხველი შეიცვალა ან განულდა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептегіш ауыстырылды немесе айналып шықты"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептегич алмаштырылды же кайра нөлдөн баштады"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meter is vervangen of rondgegaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licznik wymieniono lub się przekręcił"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O medidor foi substituído ou zerou"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O contador foi substituído ou deu a volta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счётчик заменили или он прошёл круг"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобкунак иваз шуд ё аз нав оғоз кард"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayaç değiştirildi veya sıfırlandı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічильник замінено або він обнулився"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblagich almashtirildi yoki nolga qaytdi"
          }
        }
      }
    },
    "utilities.reading.restart.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlki göstəricidən bəri sərfiyyat hesablanmır; hesab bu göstəricidən yenidən başlayır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спажыванне ад папярэдняга паказання не ўлічваецца; адлік пачынаецца з гэтага."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od předchozího odečtu se nic nezapočítá; výpočet začíná znovu tímto odečtem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit dem vorherigen Zählerstand wird kein Verbrauch berechnet. Die Zählung beginnt mit diesem Stand erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is counted since the reading before; the count starts again from this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se contabiliza consumo desde la lectura anterior; el cálculo vuelve a empezar con esta lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune consommation n’est comptée depuis le relevé précédent ; le calcul reprend à partir de celui-ci."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախորդ ցուցմունքից հետո սպառում չի հաշվվում․ հաշվարկը սկսվում է այս ցուցմունքից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene conteggiato alcun consumo dalla lettura precedente; il conteggio riparte da questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回からの使用量は計上されず、今回の検針値から再計算されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წინა ჩვენებიდან მოხმარება არ ითვლება; ათვლა ამ ჩვენებიდან იწყება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдыңғы көрсеткіштен бері тұтыну есептелмейді; есеп осы көрсеткіштен қайта басталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мурунку көрсөткүчтөн бери сарптоо эсептелбейт; эсеп ушул көрсөткүчтөн кайра башталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinds de vorige stand wordt niets berekend. De telling begint opnieuw vanaf deze stand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zużycie od poprzedniego odczytu nie jest naliczane. Liczenie zaczyna się od tego odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum consumo será contabilizado desde a leitura anterior; a contagem recomeça a partir desta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é contabilizado consumo desde a leitura anterior; a contagem recomeça a partir desta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С прошлого показания ничего не считается; счёт начинается заново с этого."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз нишондоди пешина сарф ҳисоб намешавад; ҳисоб аз ин нишондод аз нав оғоз мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki endeksten itibaren tüketim hesaplanmaz; hesaplama bu endeksten yeniden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Споживання від попереднього показника не враховується; облік починається з цього показника."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvalgi ko‘rsatkichdan beri sarf hisoblanmaydi; hisob shu ko‘rsatkichdan qayta boshlanadi."
          }
        }
      }
    },
