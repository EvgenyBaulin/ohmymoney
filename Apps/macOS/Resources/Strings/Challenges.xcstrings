    "challenges.limit.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dövrdə xərcləməyə icazə verdiyiniz ən çox məbləğ. Limitsiz hədəf pozula bilməz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Максімальная сума выдаткаў за перыяд. Выклік без ліміту нельга парушыць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvyšší částka, kterou si za dané období dovolíte utratit. Výzvu bez limitu nelze porušit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Höchstbetrag für diesen Zeitraum. Eine Challenge ohne Limit kann nicht scheitern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most you let yourself spend in the period. A challenge without a limit cannot be broken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo máximo que te permites gastar en el periodo. Un reto sin límite no se puede incumplir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant maximal à dépenser pendant la période. Un défi sans limite ne peut pas échouer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առավելագույն գումարը, որը թույլ եք տալիս ձեզ ծախսել այս ընթացքում։ Առանց սահմանաչափի մարտահրավերը հնարավոր չէ խախտել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il massimo che ti concedi di spendere nel periodo. Una sfida senza limite non può essere interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間中に使える金額の上限です。上限がないチャレンジは未達成になりません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაქსიმუმი, რომლის დახარჯვასაც ამ პერიოდში აპირებთ. ულიმიტო გამოწვევა ვერ დაირღვევა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы кезеңде жұмсауға рұқсат етілген ең үлкен сома. Лимитсіз сынақты бұзу мүмкін емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 기간에 지출할 수 있는 최대 금액입니다. 한도가 없으면 챌린지에 실패하지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул мезгилде коротууга уруксат берген эң жогорку сумма. Чеги жок чакырыкты бузуу мүмкүн эмес."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maximale bedrag dat je in deze periode wilt uitgeven. Een uitdaging zonder limiet kun je niet verbreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalna kwota, którą możesz wydać w tym okresie. Wyzwania bez limitu nie można przerwać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O máximo que você permite gastar no período. Um desafio sem limite não pode ser descumprido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O máximo que se permite gastar no período. Um desafio sem limite não pode ser incumprido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько можно потратить за период. Челлендж без лимита нельзя нарушить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи бештарине, ки дар ин давра сарф кардан мехоҳед. Чолиши бе ҳадро вайрон кардан мумкин нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönemde harcayabileceğiniz en yüksek tutar. Limitsiz bir hedef bozulamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальна сума витрат за період. Виклик без ліміту неможливо порушити."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu davrda sarflashga ruxsat bergan eng yuqori summa. Limitsiz sinovni buzib bo‘lmaydi."
          }
        }
      }
    },
