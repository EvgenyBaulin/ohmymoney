    "challenges.form.everything": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söz və kateqoriya seçilməzsə, bütün xərclərim nəzərə alınır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Без слоў і катэгорыі ўлічваюцца ўсе мае выдаткі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez slov a kategorie se počítají všechny mé výdaje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Suchwörter und Kategorie zählen alle meine Ausgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no words and no category, every expense of mine counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin palabras ni categoría, cuentan todos mis gastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans mots ni catégorie, toutes mes dépenses comptent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց բառերի և կատեգորիայի՝ հաշվի են առնվում իմ բոլոր ծախսերը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza parole né categoria, contano tutte le mie spese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーワードとカテゴリを指定しない場合、すべての支出が対象になります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სიტყვებისა და კატეგორიის გარეშე ყველა ჩემი ხარჯი ჩაითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сөздер мен санат көрсетілмесе, барлық шығындарым есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어와 카테고리를 지정하지 않으면 모든 지출이 포함됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сөздөр жана категория көрсөтүлбөсө, бардык чыгымдарым эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder woorden en categorie tellen al mijn uitgaven mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez słów i kategorii liczą się wszystkie moje wydatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem palavras ou categoria, todas as minhas despesas contam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem palavras nem categoria, todas as minhas despesas contam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без слов и категории считаются все мои расходы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бе калима ва категория ҳамаи хароҷоти ман ҳисоб мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözcük ve kategori belirtilmezse tüm harcamalarım sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без слів і категорії враховуються всі мої витрати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "So‘zlar va turkum kiritilmasa, barcha xarajatlarim hisobga olinadi."
          }
        }
      }
    },
