    "challenges.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız öz xərcləriniz: heç kimlə müqayisə edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі вашы выдаткі, без параўнання з іншымі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen vaše útraty, bez porovnávání s ostatními."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur deine eigenen Ausgaben: Es gibt keinen Vergleich mit anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own spending only: nothing is compared with anybody."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tus gastos: no se comparan con los de nadie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos dépenses uniquement, sans comparaison avec les autres."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն ձեր ծախսերը՝ առանց ուրիշների հետ համեմատելու։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le tue spese, senza confronti con altre persone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の支出だけが対象です。ほかの人とは比較されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ თქვენი ხარჯები: სხვებთან შედარების გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек өз шығындарыңыз: ешкіммен салыстыру жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 지출만 살펴보며 다른 사람과 비교하지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз чыгымдарыңыз гана: эч ким менен салыштырылбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen je eigen uitgaven, zonder vergelijking met anderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko Twoje wydatki, bez porównywania z innymi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas seus gastos, sem comparação com outras pessoas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os seus gastos, sem comparações com outras pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только ваши траты: ни с кем не сравниваются."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо хароҷоти худатон: бо касе муқоиса намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kendi harcamalarınız: kimseyle karşılaştırılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише ваші витрати — без порівнянь з іншими."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat o‘z xarajatlaringiz: hech kim bilan taqqoslanmaydi."
          }
        }
      }
    },
