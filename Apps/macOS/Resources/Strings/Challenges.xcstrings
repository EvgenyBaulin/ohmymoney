    "challenges.preset.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır hədəf sözləri əməliyyatın təsvirində, yerində və kateqoriyasında axtarır; dəqiqlik üçün kateqoriya seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гатовы выклік шукае свае словы ў апісанні, месцы і катэгорыі аперацыі. Для дакладнасці выберыце катэгорыю."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připravená výzva hledá svá slova v popisu, místě a kategorii transakce. Pro přesnější výsledek vyberte kategorii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vorlage sucht ihre Wörter in Beschreibung, Ort und Kategorie einer Buchung. Wähle eine Kategorie für ein genaueres Ergebnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ready-made challenge looks for its words in the description, place and category of an operation; pick a category to be exact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reto prediseñado busca sus palabras en la descripción, el lugar y la categoría de una operación; elige una categoría para mayor precisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un défi prêt à l’emploi recherche ses mots dans la description, le lieu et la catégorie d’une opération. Choisissez une catégorie pour plus de précision."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատրաստի մարտահրավերը որոնում է իր բառերը գործարքի նկարագրության, վայրի և կատեգորիայի մեջ։ Ավելի ճշգրիտ որոնման համար ընտրեք կատեգորիա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sfida già pronta cerca le sue parole nella descrizione, nel luogo e nella categoria di un’operazione; scegli una categoria per maggiore precisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットのキーワードは取引の説明、場所、カテゴリから検索されます。正確に絞り込むにはカテゴリを選択してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მზა გამოწვევა სიტყვებს ოპერაციის აღწერაში, ადგილსა და კატეგორიაში ეძებს; სიზუსტისთვის აირჩიეთ კატეგორია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайын сынақ сөздерді операцияның сипаттамасынан, орнынан және санатынан іздейді. Нақтылау үшін санатты таңдаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 챌린지는 거래의 설명, 장소 및 카테고리에서 단어를 찾습니다. 정확하게 지정하려면 카테고리를 선택하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Даяр чакырык өз сөздөрүн операциянын сүрөттөмөсүнөн, жеринен жана категориясынан издейт; тактоо үчүн категорияны тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kant-en-klare uitdaging zoekt naar woorden in de beschrijving, locatie en categorie van een transactie. Kies een categorie voor meer nauwkeurigheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe wyzwanie wyszukuje słowa w opisie, miejscu i kategorii operacji. Wybierz kategorię, aby zawęzić wyniki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um desafio pronto busca palavras na descrição, no local e na categoria de uma transação. Escolha uma categoria para maior precisão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um desafio predefinido procura as respetivas palavras na descrição, local e categoria de uma operação; escolha uma categoria para maior precisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовый челлендж ищет свои слова в описании, месте и категории операции; выберите категорию, чтобы было точно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чолиши омода калимаҳояшро дар тавсиф, ҷой ва категорияи амалиёт ҷустуҷӯ мекунад; барои дақиқӣ категорияеро интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır hedef, sözcüklerini işlemin açıklamasında, yerinde ve kategorisinde arar; daha kesin sonuç için bir kategori seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовий виклик шукає свої слова в описі, місці та категорії операції. Виберіть категорію для точності."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tayyor sinov so‘zlarni operatsiya tavsifi, joyi va turkumidan izlaydi. Aniqroq natija uchun turkumni tanlang."
          }
        }
      }
    },
