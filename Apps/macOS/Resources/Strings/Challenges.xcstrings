    "challenges.saved.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qənaəti hesablamaq üçün hələ əsas yoxdur: adətən xərclədiyiniz məbləği göstərin və ya əvvəlki dövrləri gözləyin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма базы для разліку эканоміі: пазначце звычайныя выдаткі або пачакайце папярэдніх перыядаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím chybí základ pro výpočet úspory. Zadejte obvyklou útratu nebo počkejte na předchozí období."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Vergleichsbasis für Ersparnisse: Gib deine üblichen Ausgaben an oder warte auf frühere Zeiträume."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No base yet to count a saving from: name what you usually spend, or wait for earlier periods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay una base para calcular el ahorro: indica lo que sueles gastar o espera a tener periodos anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune base pour calculer les économies : indiquez vos dépenses habituelles ou attendez les périodes précédentes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խնայողությունը հաշվարկելու հիմք դեռ չկա։ Նշեք ձեր սովորական ծախսը կամ սպասեք նախորդ շրջանների տվյալներին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna base per calcolare il risparmio: indica quanto spendi di solito o attendi i periodi precedenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "節約額を計算する基準がありません。通常の支出額を入力するか、過去の期間のデータがたまるまでお待ちください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დანაზოგის დასათვლელად მონაცემები ჯერ არ არის: მიუთითეთ ჩვეულებრივი ხარჯი ან დაელოდეთ წინა პერიოდების მონაცემებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үнемді есептеуге негіз әзірге жоқ: әдеттегі шығыныңызды көрсетіңіз немесе алдыңғы кезеңдер жиналғанша күтіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절약액을 계산할 기준이 없습니다. 평소 지출을 입력하거나 이전 기간이 쌓일 때까지 기다리세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Үнөмдү эсептөө үчүн негиз жок: адатта канча короторуңузду көрсөтүңүз же мурунку мезгилдердин маалыматтарын күтүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen basis om je besparing te berekenen. Geef aan wat je gewoonlijk uitgeeft of wacht op eerdere periodes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak podstawy do obliczenia oszczędności. Podaj zwykłe wydatki lub poczekaj na dane z wcześniejszych okresów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há uma base para calcular a economia. Informe quanto costuma gastar ou aguarde períodos anteriores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há base para calcular a poupança: indique o que costuma gastar ou aguarde por períodos anteriores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока не с чем сравнить: укажите, сколько обычно тратите, или подождите, пока накопятся прошлые периоды."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ҳисоб кардани сарфа ҳанӯз маълумоти асосӣ нест: хароҷоти маъмулии худро муайян кунед ё давраҳои пешинро интизор шавед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasarrufu hesaplamak için henüz bir temel yok: Genellikle harcadığınız tutarı belirtin veya önceki dönemlerin oluşmasını bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки немає бази для розрахунку заощаджень. Укажіть звичні витрати або зачекайте на попередні періоди."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejamni hisoblash uchun ma’lumot yetarli emas. Odatdagi sarfingizni kiriting yoki oldingi davrlar ma’lumotini kuting."
          }
        }
      }
    },
