    "challenges.form.baselineHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyni uzunluqlu əvvəlki dövrlərin medianını götürmək üçün boş saxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакіньце пустым, каб узяць медыяну папярэдніх перыядаў такой жа працягласці."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte prázdné pro použití mediánu předchozích stejně dlouhých období."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den Median früherer Zeiträume gleicher Länge zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty to take the median of the earlier periods of the same length."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para usar la mediana de los periodos anteriores de la misma duración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser la médiane des périodes précédentes de même durée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թողեք դատարկ՝ նույն տևողությամբ նախորդ շրջանների մեդիանն օգտագործելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per usare la mediana dei periodi precedenti della stessa durata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄にすると、過去の同じ長さの期間の中央値を使います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცარიელი დატოვებისას გამოყენებული იქნება იმავე ხანგრძლივობის წინა პერიოდების მედიანა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бос қалдырсаңыз, ұзақтығы бірдей алдыңғы кезеңдердің медианасы алынады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 같은 길이의 이전 기간 지출 중앙값을 사용합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мурунку бирдей узактыктагы мезгилдердин медианасын алуу үчүн бош калтырыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om de mediaan van eerdere periodes met dezelfde duur te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby użyć mediany z wcześniejszych okresów o tej samej długości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar a mediana dos períodos anteriores de mesma duração."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar a mediana dos períodos anteriores com a mesma duração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы взять медиану прошлых периодов такой же длины."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои истифодаи медианаи давраҳои пешини ҳамон дарозӣ холӣ гузоред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı uzunluktaki önceki dönemlerin ortancasını kullanmak için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім, щоб використати медіану попередніх періодів такої самої тривалості."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu uzunlikdagi oldingi davrlar medianasini olish uchun bo‘sh qoldiring."
          }
        }
      }
    },
