          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasso di cambio non disponibile: impossibile stimare una data"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cotação para esta moeda — data não calculada"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kurs für diese Währung — kein Datum berechnet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux pour cette devise — aucune date calculée"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл валюта үшін бағам жоқ — күні есептелмеді"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu para birimi için kur yok — tarih hesaplanamadı"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tipo para esta divisa — no se calcula la fecha"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu tej waluty — nie obliczono daty"
          }
        }
      }
    },
