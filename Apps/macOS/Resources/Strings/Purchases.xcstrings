    "purchases.settings.regretHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few days after a big purchase ask whether you would buy it again"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через несколько дней после крупной покупки спросить, купили бы вы её снова"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через кілька днів після великої покупки запитати, чи купили б ви її знову"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праз некалькі дзён пасля вялікай пакупкі спытаць, ці купілі б вы гэта зноў"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualche giorno dopo un acquisto importante, chiedi se lo rifaresti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar alguns dias após uma compra grande se você a faria novamente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Tage nach einem großen Kauf fragen, ob Sie ihn wieder kaufen würden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques jours après un gros achat, demander si vous le rachèteriez"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлкен сатып алудан бірнеше күн кейін оны қайта алар ма едіңіз деп сұрайды"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük bir satın almadan birkaç gün sonra tekrar alıp almayacağınızı sor"
