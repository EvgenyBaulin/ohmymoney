    "purchases.bought.none": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За апошнія 60 дзён прыдатных аперацый няма. Запішыце пакупку і вярніцеся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine passenden Vorgänge in den letzten 60 Tagen. Erfassen Sie den Kauf und kommen Sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No fitting operations in the last 60 days. Record the purchase and come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay operaciones que encajen en los últimos 60 días. Registre la compra y vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune opération correspondante sur les 60 derniers jours. Notez l'achat et revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna operazione corrispondente negli ultimi 60 giorni. Registra l'acquisto e torna qui."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 60 күнде сәйкес операция жоқ. Сатып алуды жазып, қайта келіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы 60 күндө ылайыктуу операциялар жок. Сатып алууну жазып, кайра келиңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pasujących operacji z ostatnich 60 dni. Zapisz zakup i wróć tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma transação correspondente nos últimos 60 dias. Registre a compra e volte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящих операций за 60 дней нет. Запишите покупку и вернитесь сюда."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар 60 рӯзи охир амалиёти мувофиқ нест. Харидро сабт кунед ва баргардед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 60 günde uygun işlem yok. Satın almayı kaydedip geri dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідних операцій за останні 60 днів немає. Запишіть покупку і поверніться."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi 60 kunda mos operatsiyalar yo‘q. Xaridni qayd etib, qaytib keling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 60 天沒有符合的交易。請記錄購買後再回來。"
          }
        }
      }
    },
