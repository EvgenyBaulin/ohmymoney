    "purchases.shopping.empty": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спіс пусты. Увядзіце, што трэба купіць падчас наступнага паходу ў краму."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste ist leer. Tippen Sie ein, was Sie beim nächsten Einkauf brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list is empty. Type what you need to buy on the next trip to the shop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista está vacía. Escriba lo que necesita comprar en la próxima visita a la tienda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste est vide. Tapez ce qu'il faut acheter à la prochaine course."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista è vuota. Scrivi cosa devi comprare la prossima volta che vai a fare la spesa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тізім бос. Келесі дүкенге барғанда не сатып алу керек екенін жазыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тизме бош. Дүкөнгө кийинки барганда эмне сатып алуу керектигин жазыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista jest pusta. Wpisz, co chcesz kupić podczas następnej wizyty w sklepie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista está vazia. Digite o que você precisa comprar na próxima ida à loja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список пуст. Впишите, что нужно купить в следующий поход в магазин."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рӯйхат холӣ аст. Нависед, ки дафъаи оянда аз мағоза чӣ харидан лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste boş. Bir sonraki alışverişte almanız gerekenleri yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список порожній. Запишіть, що треба купити під час наступного походу до магазину."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro‘yxat bo‘sh. Do‘konga keyingi safar borganda nima olish kerakligini yozing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清單是空的。輸入下次購物需要買的東西。"
          }
        }
      }
    },
