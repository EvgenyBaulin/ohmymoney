    "purchases.bought.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the operation among those of a similar amount in the last two months. The price of the wish is %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la operación entre las de importe parecido de los últimos dos meses. El precio del deseo es %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'opération parmi celles d'un montant proche des deux derniers mois. Le prix de l'envie est %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите операцию из похожих по сумме за последние два месяца. Цена желания — %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть операцію серед схожих за сумою за останні два місяці. Ціна бажання — %@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы екі айдағы ұқсас сомалы операциялардың арасынан таңдаңыз. Қалаған заттың бағасы — %@."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце аперацыю з падобнай сумай за апошнія два месяцы. Кошт жаданага — %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Vorgang unter denen mit ähnlichem Betrag aus den letzten zwei Monaten. Der Preis des Wunsches ist %@."
          }
        }
      }
    },
