    "purchases.afford.noPace": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма чаго адкладаць — дата невядомая"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts beiseitegelegt — ein Datum lässt sich nicht bestimmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to put aside yet — no date can be told"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada apartado — no se puede calcular una fecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à mettre de côté pour l'instant — aucune date ne peut être calculée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non metti ancora nulla da parte: impossibile stimare una data"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жинайтын ештеңе жоқ әлі — күнін айтуға болмайды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча акча топтоло элек — күнүн аныктоо мүмкүн эмес"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze czego odkładać — nie można podać daty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há valor para guardar — não é possível prever uma data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего откладывать — срок назвать нельзя"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло маблағе барои пасандоз нест — санаро муайян кардан намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz birikim yok — tarih belirlenemiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладати ще нічого — дату визначити не можна"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha jamg‘arishga pul yo‘q — sanani aytib bo‘lmaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有餘額可存，無法預估日期"
          }
        }
      }
    },
    "purchases.afford.noRate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма курсу для гэтай валюты — дата не разлічана"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kurs für diese Währung — kein Datum berechnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate for this currency — no date calculated"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tipo para esta divisa — no se calcula la fecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux pour cette devise — aucune date calculée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasso di cambio non disponibile: impossibile stimare una data"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл валюта үшін бағам жоқ — күні есептелмеді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул валютанын курсу жок — күн эсептелген жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu tej waluty — nie obliczono daty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cotação para esta moeda — data não calculada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса этой валюты — срок не посчитан"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби ин асъор нест — сана ҳисоб нашуд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu para birimi için kur yok — tarih hesaplanamadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї валюти немає курсу — дату не порахувати"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu valyuta kursi yo‘q — sana hisoblanmadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有此貨幣的匯率，無法預估日期"
          }
        }
      }
    },
