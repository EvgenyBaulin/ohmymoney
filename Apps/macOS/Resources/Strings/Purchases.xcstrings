    "purchases.settings.mileage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanacaq doldurarkən yürüşü soruş"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытацца пра прабег пры запраўцы"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při tankování se ptát na stav tachometru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Tanken den Kilometerstand fragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the mileage at a fill-up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar el kilometraje al repostar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander le kilométrage au plein"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցնել վազքը լիցքավորման ժամանակ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi il chilometraggio al rifornimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給油時に走行距離を確認"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გარბენის კითხვა საწვავის ჩასხმისას"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отын толтырғанда жүрген жолды сұрау"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주유 시 주행 거리 묻기"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күйүүчү май куйганда жүрүлгөн жолду суроо"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag de kilometerstand bij het tanken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytaj o przebieg przy tankowaniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar a quilometragem ao abastecer"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir quilometragem ao abastecer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивать пробег при заправке"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пурсидани масофаи тайшуда ҳангоми сӯзишворӣ гирифтан"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakıt alırken kilometreyi sor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Питати пробіг під час заправки"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoqilg‘i quyishda yurilgan masofani so‘rash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加油时询问里程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加油時詢問里程"
          }
        }
      }
    },
    "purchases.settings.mileageHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yürüş yanacaq sərfiyyatını və bir kilometrin xərcini hesablamağa imkan verir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прабег дапамагае разлічыць расход паліва і кошт кіламетра"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav tachometru umožňuje vypočítat spotřebu paliva a cenu za kilometr"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kilometerstand lässt die App den Kraftstoffverbrauch und die Kosten eines Kilometers berechnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mileage lets the app count the fuel use and the cost of a kilometre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El kilometraje permite a la app calcular el consumo de combustible y el coste del kilómetro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le kilométrage permet à l'app de calculer la consommation et le coût du kilomètre"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վազքի միջոցով հավելվածը հաշվում է վառելիքի ծախսը և մեկ կիլոմետրի արժեքը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il chilometraggio consente all'app di calcolare i consumi e il costo per chilometro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走行距離から燃費と1キロメートルあたりの費用を計算します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გარბენის მიხედვით აპი ითვლის საწვავის მოხმარებას და კილომეტრის ღირებულებას"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүрген жол қолданбаға отын шығынын және бір шақырымның құнын санауға мүмкіндік береді"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주행 거리를 입력하면 연비와 킬로미터당 비용을 계산할 수 있습니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүрүлгөн жол күйүүчү майдын сарпталышын жана бир километрдин баасын эсептөөгө жардам берет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de kilometerstand berekent de app het brandstofverbruik en de kosten per kilometer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przebieg pozwala obliczyć zużycie paliwa i koszt kilometra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A quilometragem permite calcular o consumo de combustível e o custo por quilômetro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A quilometragem permite calcular o consumo de combustível e o custo por quilómetro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробег нужен, чтобы считать расход топлива и стоимость километра"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Масофаи тайшуда барои ҳисоб кардани сарфи сӯзишворӣ ва арзиши як километр лозим аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilometre bilgisi, yakıt tüketimini ve kilometre başına maliyeti hesaplamayı sağlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробіг дозволяє застосунку рахувати витрату палива та ціну кілометра"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yurilgan masofa yoqilg‘i sarfi va bir kilometr narxini hisoblashga yordam beradi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "里程可用于计算油耗和每公里费用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "里程可用來計算油耗和每公里成本"
          }
        }
      }
    },
