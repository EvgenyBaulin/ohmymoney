    "purchases.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Almaq istədikləriniz, sahib olduğunuz əşyalar və onların xərcləri"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што вы хочаце купіць, чым валодаеце і колькі гэта каштуе"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co si chcete koupit, co vlastníte a kolik vás to stojí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Sie kaufen möchten, was Sie besitzen und was der Besitz kostet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you want to buy, what you own and what owning it costs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que quiere comprar, lo que tiene y cuánto le cuesta tenerlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous voulez acheter, ce que vous possédez et ce que coûte le fait de le posséder"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր ցանկալի գնումները, իրերը և դրանց ծախսերը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vuoi comprare, cosa possiedi e quanto ti costa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "欲しいもの、持っているもの、所有にかかる費用"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რისი ყიდვა გსურთ, რას ფლობთ და რა გიჯდებათ მისი ფლობა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сатып алғыңыз келеді, не бар және оны ұстау неге тұрады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매하고 싶은 물건, 보유한 물건 및 보유 비용"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алгыңыз келген жана колуңуздагы буюмдар, аларга кеткен чыгымдар"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je wilt kopen, wat je bezit en wat het kost"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co chcesz kupić, co masz i ile kosztuje Cię posiadanie tych rzeczy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você quer comprar, o que possui e quanto custa manter"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que quer comprar, o que tem e quanto custa mantê-lo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
