    "purchases.wishes.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. Add what you want to buy — the app tells how many months it takes to save up and when the price is right."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего. Добавьте то, что хочется купить: приложение скажет, через сколько месяцев хватит денег, и подскажет, когда пора брать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки порожньо. Додайте, що хочете купити, — застосунок скаже, скільки місяців треба на накопичення і коли ціна слушна."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль нічога няма. Дадайце тое, што хочаце купіць, — праграма пакажа, колькі месяцаў спатрэбіцца, каб назбіраць грошы, і калі кошт будзе выгадным."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun desiderio. Aggiungi ciò che vuoi acquistare: l’app ti dirà quanti mesi servono per risparmiare e quando il prezzo è giusto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada por enquanto. Adicione o que deseja comprar e o app mostrará quantos meses leva para juntar o dinheiro e quando o preço está bom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts. Tragen Sie ein, was Sie kaufen möchten — die App sagt, wie viele Monate das Sparen dauert und wann der Preis passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Ajoutez ce que vous voulez acheter — l'app indique combien de mois il faut pour l'épargner et quand le prix est bon."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге жоқ. Сатып алғыңыз келетінді қосыңыз — қолданба жинау неше айға созылатынын және бағаның қашан қолайлы болатынын айтады."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir şey yok. Satın almak istediklerinizi ekleyin; uygulama, para biriktirmenin kaç ay süreceğini ve fiyatın ne zaman uygun olduğunu gösterir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía nada. Añada lo que quiere comprar — la app le dice cuántos meses hacen falta para ahorrarlo y cuándo es buen momento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic tu nie ma. Dodaj to, co chcesz kupić — aplikacja pokaże, ile miesięcy zajmie oszczędzanie i kiedy cena będzie odpowiednia."
          }
        }
      }
    },
