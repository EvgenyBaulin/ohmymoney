    "purchases.settings.pauseFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The threshold is a share of the free sum of the month. It also decides which purchase gets the question “No regrets?”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El umbral es una parte de la suma libre del mes. También decide qué compra recibe la pregunta «¿Algún arrepentimiento?»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le seuil est une part de la somme libre du mois. Il décide aussi quel achat reçoit la question « Aucun regret ? »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порог — доля свободной суммы месяца. Он же решает, о какой покупке спросить «Не пожалели?»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поріг — це частка вільної суми за місяць. Він також визначає, для якої покупки ставиться питання «Без жалю?»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шек — айдың бос қаржысының үлесі. Сондай-ақ қандай сатып алуға «Өкініш жоқ па?» деген сұрақ қойылатынын анықтайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Парог вызначаецца доляй свабоднай сумы за месяц. Ён таксама вызначае, пра якія пакупкі задаваць пытанне “Не шкадуеце?”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schwelle ist ein Anteil am freien Betrag des Monats. Sie entscheidet auch, welcher Kauf die Frage „Keine Reue?“ bekommt."
          }
        }
      }
    },
    "purchases.settings.pauseHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A big purchase is offered to wait a night"
