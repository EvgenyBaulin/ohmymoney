          "stringUnit": {
            "state": "translated",
            "value": "Через кілька днів після великої покупки запитати, чи купили б ви її знову"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yirik xariddan bir necha kun o‘tib, uni yana xarid qilarmidingiz, deb so‘rash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大额购买几天后，询问你是否还会再买"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大額購買幾天後，詢問你是否會再次購買"
          }
        }
      }
    },
