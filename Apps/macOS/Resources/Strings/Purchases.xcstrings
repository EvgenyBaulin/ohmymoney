    "purchases.savings.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No discounts yet. Note a discount when you record a purchase — here you will see how much you saved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидок пока нет. Укажите скидку при записи покупки — здесь появится, сколько вы сэкономили."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знижок поки немає. Позначайте знижку, коли записуєте покупку, — тут ви побачите, скільки заощадили."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зніжак яшчэ няма. Запісвайце зніжкі разам з пакупкамі, і тут вы ўбачыце, колькі зэканомілі."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno sconto. Annota uno sconto quando registri un acquisto per vedere qui quanto hai risparmiato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum desconto ainda. Registre um desconto ao registrar uma compra para ver quanto você economizou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Rabatte. Notieren Sie einen Rabatt, wenn Sie einen Kauf erfassen — hier sehen Sie, wie viel Sie gespart haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de remise. Notez une remise quand vous notez un achat — ici vous verrez combien vous avez économisé."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жеңілдіктер әлі жоқ. Сатып алуды жазғанда жеңілдікті белгілеңіз — мұнда қанша үнемдегеніңізді көресіз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz indirim yok. Satın alma kaydederken indirimi belirtin; ne kadar tasarruf ettiğinizi burada görün."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay descuentos. Anote un descuento al registrar una compra — aquí verá cuánto ahorró."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak rabatów. Zapisz rabat przy dodawaniu zakupu, aby zobaczyć, ile oszczędzasz."
          }
        }
      }
    },
