    "purchases.sale.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Продаж запісваецца як даход у катэгорыі “Продаж рэчаў”, а рэч перамяшчаецца ў прададзеныя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verkauf wird als Einnahme in der Kategorie „Verkauf von Sachen“ erfasst, und die Sache wandert zu den verkauften."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sale is recorded as income in the category “Sale of things”, and the thing moves to the sold ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La venta se registra como ingreso en la categoría «Venta de cosas», y la cosa pasa a las vendidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vente est notée comme revenu dans la catégorie « Vente d'objets », et l'objet passe dans les objets vendus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vendita viene registrata come entrata nella categoria “Vendita di oggetti” e l'oggetto viene spostato tra quelli venduti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сату «Заттарды сату» санатында табыс ретінде жазылады, ал зат сатылғандарға көшеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатуу “Буюмдарды сатуу” категориясына киреше катары жазылып, буюм сатылгандарга өтөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprzedaż zostanie zapisana jako przychód w kategorii „Sprzedaż rzeczy”, a rzecz zostanie przeniesiona do sprzedanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A venda é registrada como receita na categoria “Venda de itens”, e o item passa para os vendidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продажа запишется доходом в категории «Продажа вещей», а вещь перейдёт в проданные."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фурӯш ҳамчун даромад дар гурӯҳи “Фурӯши ашё” сабт мешавад ва ашё ба фурӯхташудаҳо мегузарад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satış, “Eşya satışı” kategorisinde gelir olarak kaydedilir ve eşya satılanlara taşınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продаж записується як дохід у категорії «Продаж речей», а річ переходить до проданих."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotuv “Buyumlarni sotish” turkumida daromad sifatida qayd etiladi va buyum sotilganlar ro‘yxatiga o‘tadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出售款項會記為「物品出售」類別的收入，物品會移至已售出項目。"
          }
        }
      }
    },
