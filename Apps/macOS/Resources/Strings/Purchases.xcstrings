    "purchases.things.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier stehen die Sachen aus dem Kapital (ohne Geldanlagen) und die, die Sie separat notieren, jeweils mit den Kosten ihres Besitzes im Monat. Um die Ausgaben für eine Sache zu zählen, setzen Sie bei den Vorgängen ein Schlagwort mit ihrem Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here are the things of the capital (investments aside) and those you note separately, each with what it costs a month to own. To count what is spent on a thing, put a tag with its name on the operations."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда капиталдың заттары (инвестициясыз) және бөлек жазылғандар, әркімі айына ұстауға қанша тұратынымен бірге. Затқа жұмсалғанды санау үшін операцияларға оның атымен белгі қойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь вещи из «Капитала» (кроме вложений) и те, что вы запишете отдельно, — у каждой видно, сколько стоит владеть ею в месяц. Чтобы расходы на вещь считались, ставьте операциям тег с её названием."
          }
        }
      }
    },
