    "purchases.afford.noPace": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ kənara qoymağa pul yoxdur — tarix məlum deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма чаго адкладаць — дата невядомая"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není co odkládat — datum nelze určit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts beiseitegelegt — ein Datum lässt sich nicht bestimmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to put aside yet — no date can be told"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada apartado — no se puede calcular una fecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à mettre de côté pour l'instant — aucune date ne peut être calculée"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ մի կողմ դնելու գումար չկա․ ամսաթիվը հայտնի չէ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non metti ancora nulla da parte: impossibile stimare una data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "積立額がないため、日付を計算できません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ გადასადები თანხა არ არის — თარიღი უცნობია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жинайтын ештеңе жоқ әлі — күнін айтуға болмайды"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 모아 둘 금액이 없어 날짜를 예상할 수 없습니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча акча топтоло элек — күнүн аныктоо мүмкүн эмес"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets om opzij te zetten — geen datum beschikbaar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze czego odkładać — nie można podać daty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há valor para guardar — não é possível prever uma data"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dinheiro para pôr de lado — não é possível indicar uma data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего откладывать — срок назвать нельзя"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло маблағе барои пасандоз нест — санаро муайян кардан намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz birikim yok — tarih belirlenemiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладати ще нічого — дату визначити не можна"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha jamg‘arishga pul yo‘q — sanani aytib bo‘lmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有可存的钱，无法预计日期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有餘額可存，無法預估日期"
          }
        }
      }
    },
    "purchases.afford.noRate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu valyuta üçün məzənnə yoxdur — tarix hesablanmadı"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма курсу для гэтай валюты — дата не разлічана"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybí kurz měny — datum nelze určit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kurs für diese Währung — kein Datum berechnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate for this currency — no date calculated"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tipo para esta divisa — no se calcula la fecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux pour cette devise — aucune date calculée"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս արժույթի փոխարժեքը չկա․ ամսաթիվը չի հաշվարկվել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasso di cambio non disponibile: impossibile stimare una data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この通貨のレートがないため、日付を計算できません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ვალუტის კურსი არ არის — თარიღი ვერ გამოითვლება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл валюта үшін бағам жоқ — күні есептелмеді"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 통화의 환율이 없어 날짜를 계산할 수 없습니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул валютанын курсу жок — күн эсептелген жок"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen wisselkoers voor deze valuta — geen datum berekend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu tej waluty — nie obliczono daty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cotação para esta moeda — data não calculada"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem taxa de câmbio para esta moeda — não foi calculada uma data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса этой валюты — срок не посчитан"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби ин асъор нест — сана ҳисоб нашуд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu para birimi için kur yok — tarih hesaplanamadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї валюти немає курсу — дату не порахувати"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu valyuta kursi yo‘q — sana hisoblanmadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有此货币的汇率，无法计算日期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有此貨幣的匯率，無法預估日期"
          }
        }
      }
    },
