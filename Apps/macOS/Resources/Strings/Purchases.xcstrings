    "purchases.settings.regretHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праз некалькі дзён пасля вялікай пакупкі спытаць, ці купілі б вы гэта зноў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Tage nach einem großen Kauf fragen, ob Sie ihn wieder kaufen würden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few days after a big purchase ask whether you would buy it again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos días después de una compra grande, pregunte si la volvería a comprar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques jours après un gros achat, demander si vous le rachèteriez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualche giorno dopo un acquisto importante, chiedi se lo rifaresti"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлкен сатып алудан бірнеше күн кейін оны қайта алар ма едіңіз деп сұрайды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ири сатып алуудан бир нече күндөн кийин аны кайра сатып алат белеңиз деп суроо"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka dni po dużym zakupie zapytaj, czy kupić tę rzecz ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar alguns dias após uma compra grande se você a faria novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через несколько дней после крупной покупки спросить, купили бы вы её снова"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пас аз чанд рӯзи хариди калон пурсидан, ки оё онро боз мехаридед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük bir satın almadan birkaç gün sonra tekrar alıp almayacağınızı sor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через кілька днів після великої покупки запитати, чи купили б ви її знову"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yirik xariddan bir necha kun o‘tib, uni yana xarid qilarmidingiz, deb so‘rash"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大額購買幾天後，詢問你是否會再次購買"
          }
        }
      }
    },
