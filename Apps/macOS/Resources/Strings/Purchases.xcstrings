    "purchases.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што вы хочаце купіць, чым валодаеце і колькі гэта каштуе"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Sie kaufen möchten, was Sie besitzen und was der Besitz kostet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you want to buy, what you own and what owning it costs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que quiere comprar, lo que tiene y cuánto le cuesta tenerlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous voulez acheter, ce que vous possédez et ce que coûte le fait de le posséder"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vuoi comprare, cosa possiedi e quanto ti costa"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сатып алғыңыз келеді, не бар және оны ұстау неге тұрады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алгыңыз келген жана колуңуздагы буюмдар, аларга кеткен чыгымдар"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co chcesz kupić, co masz i ile kosztuje Cię posiadanie tych rzeczy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você quer comprar, o que possui e quanto custa manter"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что хочется купить, что уже есть и сколько стоит этим владеть"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чӣ харидан мехоҳед, чӣ доред ва нигоҳдории он чӣ қадар арзиш дорад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Almak istedikleriniz, sahip olduklarınız ve bunların maliyeti"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чого хочете, що маєте і скільки коштує володіння ними"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarid istaklaringiz, buyumlaringiz va ularga ketadigan xarajatlar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想買的物品、擁有的物品及持有成本"
          }
        }
      }
    },
