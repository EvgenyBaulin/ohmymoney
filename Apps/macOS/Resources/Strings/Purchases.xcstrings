    "purchases.wishes.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ heç nə yoxdur. Almaq istədiyinizi əlavə edin — tətbiq pul yığmaq üçün neçə ay lazım olduğunu və qiymətin nə vaxt uyğun olduğunu göstərəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль нічога няма. Дадайце тое, што хочаце купіць, — праграма пакажа, колькі месяцаў спатрэбіцца, каб назбіраць грошы, і калі кошт будзе выгадным."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím tu nic není. Přidejte, co si chcete koupit — aplikace vám ukáže, kolik měsíců budete spořit a kdy bude cena příznivá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts. Tragen Sie ein, was Sie kaufen möchten — die App sagt, wie viele Monate das Sparen dauert und wann der Preis passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. Add what you want to buy — the app tells how many months it takes to save up and when the price is right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía nada. Añada lo que quiere comprar — la app le dice cuántos meses hacen falta para ahorrarlo y cuándo es buen momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Ajoutez ce que vous voulez acheter — l'app indique combien de mois il faut pour l'épargner et quand le prix est bon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ ոչինչ չկա։ Ավելացրեք այն, ինչ ուզում եք գնել․ հավելվածը ցույց կտա, թե քանի ամսում կկուտակեք գումարը և երբ գինը հարմար կլինի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun desiderio. Aggiungi ciò che vuoi acquistare: l’app ti dirà quanti mesi servono per risparmiare e quando il prezzo è giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もありません。買いたいものを追加すると、購入資金が貯まるまでの月数と買い時がわかります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არაფერია. დაამატეთ ის, რისი ყიდვაც გსურთ — აპი გაჩვენებთ, რამდენი თვე დაგჭირდებათ თანხის შესაგროვებლად და როდის იქნება ფასი ხელსაყრელი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге жоқ. Сатып алғыңыз келетінді қосыңыз — қолданба жинау неше айға созылатынын және бағаның қашан қолайлы болатынын айтады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 항목이 없습니다. 구매하고 싶은 것을 추가하면 돈을 모으는 데 걸리는 개월 수와 적절한 구매 시기를 알려줍니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча эч нерсе жок. Сатып алгыңыз келген нерсени кошуңуз — колдонмо акча чогултууга канча ай керектелерин жана баасы качан ылайыктуу болорун көрсөтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets. Voeg toe wat je wilt kopen. De app laat zien hoeveel maanden je moet sparen en wanneer de prijs goed is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic tu nie ma. Dodaj to, co chcesz kupić — aplikacja pokaże, ile miesięcy zajmie oszczędzanie i kiedy cena będzie odpowiednia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada por enquanto. Adicione o que deseja comprar e o app mostrará quantos meses leva para juntar o dinheiro e quando o preço está bom."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há desejos. Adicione o que quer comprar — a aplicação indica quantos meses precisa de poupar e quando o preço é favorável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего. Добавьте то, что хочется купить: приложение скажет, через сколько месяцев хватит денег, и подскажет, когда пора брать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло чизе нест. Он чизеро, ки харидан мехоҳед, илова кунед — барнома мегӯяд, ки ҷамъ кардани маблағ чанд моҳ мегирад ва кай нарх мувофиқ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir şey yok. Satın almak istediklerinizi ekleyin; uygulama, para biriktirmenin kaç ay süreceğini ve fiyatın ne zaman uygun olduğunu gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки порожньо. Додайте, що хочете купити, — застосунок скаже, скільки місяців треба на накопичення і коли ціна слушна."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha hech narsa yo‘q. Xarid qilmoqchi bo‘lgan narsangizni qo‘shing — ilova unga necha oyda pul yig‘ishingizni va narx qachon qulay bo‘lishini ko‘rsatadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无心愿。添加想买的物品，App 会告诉你需要攒几个月的钱，以及何时价格合适。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無願望。加入想買的東西，App 會告訴你需要存幾個月，以及何時價格合適。"
          }
        }
      }
    },
