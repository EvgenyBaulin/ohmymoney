          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Денег хватает уже сейчас"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна собі дозволити вже зараз"
          }
        }
