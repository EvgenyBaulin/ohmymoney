    "purchases.bought.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце аперацыю з падобнай сумай за апошнія два месяцы. Кошт жаданага — %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Vorgang unter denen mit ähnlichem Betrag aus den letzten zwei Monaten. Der Preis des Wunsches ist %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the operation among those of a similar amount in the last two months. The price of the wish is %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la operación entre las de importe parecido de los últimos dos meses. El precio del deseo es %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'opération parmi celles d'un montant proche des deux derniers mois. Le prix de l'envie est %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un'operazione di importo simile degli ultimi due mesi. Il prezzo desiderato è %@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы екі айдағы ұқсас сомалы операциялардың арасынан таңдаңыз. Қалаған заттың бағасы — %@."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы эки айдагы окшош суммадагы операциялардан тандаңыз. Каалоонун баасы — %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz operację o podobnej kwocie z ostatnich dwóch miesięcy. Cena przedmiotu na liście życzeń to %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a transação entre as de valor semelhante nos últimos dois meses. O preço do item desejado é %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите операцию из похожих по сумме за последние два месяца. Цена желания — %@."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиётро аз байни маблағҳои монанд дар ду моҳи охир интихоб кунед. Нархи хоҳиш %@ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son iki aydaki benzer tutarlı işlemlerden birini seçin. İsteğin fiyatı %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть операцію серед схожих за сумою за останні два місяці. Ціна бажання — %@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi ikki oydagi o‘xshash summali operatsiyalardan birini tanlang. Istak narxi — %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從過去兩個月金額相近的交易中選擇。願望價格為 %@。"
          }
        }
      }
    },
