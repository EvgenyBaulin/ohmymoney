    "purchases.afford.noPace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to put aside yet — no date can be told"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего откладывать — срок назвать нельзя"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладати ще нічого — дату визначити не можна"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма чаго адкладаць — дата невядомая"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non metti ancora nulla da parte: impossibile stimare una data"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há valor para guardar — não é possível prever uma data"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts beiseitegelegt — ein Datum lässt sich nicht bestimmen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à mettre de côté pour l'instant — aucune date ne peut être calculée"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жинайтын ештеңе жоқ әлі — күнін айтуға болмайды"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz birikim yok — tarih belirlenemiyor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada apartado — no se puede calcular una fecha"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze czego odkładać — nie można podać daty"
          }
        }
      }
    },
    "purchases.afford.noRate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate for this currency — no date calculated"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса этой валюты — срок не посчитан"
