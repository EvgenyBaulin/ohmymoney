    "purchases.thing.noTag": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tag — spending on the thing is not counted. Put a tag with its name on the operations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin etiqueta — el gasto en la cosa no se cuenta. Ponga a las operaciones una etiqueta con su nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'étiquette — les dépenses sur l'objet ne sont pas comptées. Mettez sur les opérations une étiquette portant son nom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет тега — расходы на вещь не считаются. Ставьте операциям тег с названием вещи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначки немає — витрати на річ не враховуються. Поставте операціям позначку з її назвою."
