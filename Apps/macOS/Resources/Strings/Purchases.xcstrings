    "purchases.thing.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэч будзе выдалена са спіса, а аперацыі застануцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sache verlässt die Liste; die Vorgänge bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The thing leaves the list; the operations stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cosa sale de la lista; las operaciones se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'objet quitte la liste ; les opérations restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'oggetto viene rimosso dalla lista; le operazioni restano."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зат тізімнен шығады; операциялар қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Буюм тизмеден өчүрүлөт; операциялар сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzecz zostanie usunięta z listy, ale operacje pozostaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item será removido da lista; as transações serão mantidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вещь исчезнет из списка; операции останутся."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашё аз рӯйхат нест мешавад; амалиёт боқӣ мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşya listeden çıkarılır; işlemler kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Річ зникає зі списку; операції лишаються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Buyum ro‘yxatdan olib tashlanadi; operatsiyalar saqlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "物品會從清單移除，交易記錄仍會保留。"
          }
        }
      }
    },
