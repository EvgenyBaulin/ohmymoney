    "purchases.wish.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qiymət tarixçəsi də silinəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гісторыя коштаў таксама будзе выдалена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže se i historie cen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Preisverlauf geht mit ihm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its price history goes with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su historial de precios se va con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son historique de prix part avec lui."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գնի պատմությունը նույնպես կջնջվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche la cronologia dei prezzi verrà eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格履歴も削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მასთან ერთად წაიშლება ფასის ისტორიაც."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның баға тарихы да бірге кетеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격 기록도 함께 삭제됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Баалар таржымалы да өчүрүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prijsgeschiedenis wordt ook verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia cen również zostanie usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de preços também será apagado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de preços também será apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с желанием пропадёт история его цен."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таърихи нархи он низ нест мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyat geçmişi de silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Разом із ним зникає історія його цін."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Narxlar tarixi ham o‘chiriladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格历史记录也会一并删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "價格記錄也會一併刪除。"
          }
        }
      }
    },
