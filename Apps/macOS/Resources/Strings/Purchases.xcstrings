        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупную покупку предлагается отложить на ночь"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Велику покупку пропонують почекати ніч"
          }
        }
      }
    },
