    "purchases.bought.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 60 gündə uyğun əməliyyat yoxdur. Alışı qeyd edib yenidən qayıdın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За апошнія 60 дзён прыдатных аперацый няма. Запішыце пакупку і вярніцеся."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za posledních 60 dní žádné odpovídající transakce. Zaznamenejte nákup a vraťte se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine passenden Vorgänge in den letzten 60 Tagen. Erfassen Sie den Kauf und kommen Sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No fitting operations in the last 60 days. Record the purchase and come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay operaciones que encajen en los últimos 60 días. Registre la compra y vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune opération correspondante sur les 60 derniers jours. Notez l'achat et revenez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին 60 օրում համապատասխան գործարքներ չկան։ Գրանցեք գնումը և վերադարձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna operazione corrispondente negli ultimi 60 giorni. Registra l'acquisto e torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去60日間に該当する取引がありません。購入を記録してから戻ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო 60 დღეში შესაბამისი ოპერაციები არ არის. აღრიცხეთ შენაძენი და დაბრუნდით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 60 күнде сәйкес операция жоқ. Сатып алуды жазып, қайта келіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 60일 동안 일치하는 거래가 없습니다. 구매를 기록한 후 다시 확인하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы 60 күндө ылайыктуу операциялар жок. Сатып алууну жазып, кайра келиңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen passende transacties in de afgelopen 60 dagen. Registreer de aankoop en kom terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pasujących operacji z ostatnich 60 dni. Zapisz zakup i wróć tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma transação correspondente nos últimos 60 dias. Registre a compra e volte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há operações correspondentes nos últimos 60 dias. Registe a compra e volte aqui."
          }
