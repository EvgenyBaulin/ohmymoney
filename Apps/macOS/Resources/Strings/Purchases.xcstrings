          "stringUnit": {
            "state": "translated",
            "value": "Кошт пакупкі не пазначаны — улічваюцца толькі выдаткі на рэч"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kaufpreis — gezählt wird nur, was dafür ausgegeben wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No purchase price — only what is spent on it is counted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin precio de compra — solo se cuenta lo que se gasta en ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de prix d'achat — seul ce qui y est dépensé est compté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun prezzo d’acquisto: vengono conteggiate solo le spese sostenute"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алу бағасы жоқ — оған жұмсалғаны ғана есептеледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алуу баасы жок — буюмга кеткен чыгымдар гана эсептелет"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak ceny zakupu — liczone są tylko wydatki na tę rzecz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem preço de compra — só os gastos com o bem são contabilizados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена покупки не указана — считаются только расходы на вещь"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нархи харид нест — танҳо хароҷоти он ҳисоб мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alış fiyatı yok — yalnızca eşya için yapılan harcamalar sayılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни покупки немає — враховується лише те, що на неї витрачено"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarid narxi yo‘q — faqat unga sarflangan mablag‘ hisoblanadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定購買價格 — 僅計算相關支出"
          }
        }
      }
    },
    "purchases.thing.noTag": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма меткі — выдаткі на рэч не ўлічваюцца. Дадайце метку з яе назвай да аперацый."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Schlagwort — Ausgaben für die Sache werden nicht gezählt. Setzen Sie bei den Vorgängen ein Schlagwort mit ihrem Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tag — spending on the thing is not counted. Put a tag with its name on the operations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin etiqueta — el gasto en la cosa no se cuenta. Ponga a las operaciones una etiqueta con su nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'étiquette — les dépenses sur l'objet ne sont pas comptées. Mettez sur les opérations une étiquette portant son nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tag: le spese per il bene non vengono conteggiate. Aggiungi alle operazioni un tag con il suo nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгі жоқ — затқа жұмсалған шығын есептелмейді. Операцияларға атымен белгі қойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег жок — буюмга кеткен чыгымдар эсептелбейт. Операцияларга буюмдун аты жазылган тегди коюңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak tagu — wydatki na tę rzecz nie są liczone. Dodaj do operacji tag z jej nazwą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem etiqueta — os gastos com o bem não são contabilizados. Adicione uma etiqueta com o nome dele às operações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет тега — расходы на вещь не считаются. Ставьте операциям тег с названием вещи."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барчасп нест — хароҷоти ашё ҳисоб намешавад. Ба амалиёт барчаспи номи онро гузоред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket yok — eşya için yapılan harcamalar sayılmaz. İşlemlere eşyanın adını taşıyan bir etiket ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначки немає — витрати на річ не враховуються. Поставте операціям позначку з її назвою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Teg yo‘q — buyumga sarflangan mablag‘ hisoblanmaydi. Amallarga buyum nomi yozilgan teg qo‘ying."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無標籤 — 不會計算這項物品的支出。請在交易中加上以物品名稱命名的標籤。"
          }
        }
      }
    },
