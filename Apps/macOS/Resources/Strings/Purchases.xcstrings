    "purchases.waiting.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözlənilən geri ödəniş yoxdur. Hesaba hələ çatmamış geri ödənişlər xərclərə və balanslara təsir etmədən burada gözləyir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканых вяртанняў няма. Тут паказваюцца вяртанні, якія яшчэ не паступілі на рахунак і не ўплываюць на выдаткі і рэшткі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na žádné vrácené platby nečekáte. Platby, které ještě nedorazily na účet, tu čekají bez vlivu na výdaje a zůstatky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine Erstattungen erwartet. Eine Erstattung, die das Konto noch nicht erreicht hat, wartet hier, ohne Ausgaben oder Salden zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No refunds are awaited. A refund that has not reached the account yet waits here without changing spending or balances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se espera ninguna devolución. Una devolución que todavía no ha llegado a la cuenta espera aquí sin cambiar gastos ni saldos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun remboursement n'est attendu. Un remboursement qui n'est pas encore arrivé sur le compte attend ici, sans changer les dépenses ni les soldes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասվող վերադարձներ չկան։ Հաշվին դեռ չհասած վերադարձն այստեղ է՝ առանց ծախսերն ու մնացորդները փոխելու։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun rimborso in attesa. I rimborsi non ancora arrivati sul conto restano qui senza modificare spese o saldi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金待ちはありません。口座にまだ届いていない返金がここに表示されます。支出や残高には反映されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დასაბრუნებელი თანხა არ არის. თანხის დაბრუნება, რომელიც ანგარიშზე ჯერ არ ასახულა, აქ გამოჩნდება ხარჯებისა და ნაშთების შეცვლის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтарулар күтілмейді. Есеп-шотқа әлі жетпеген қайтару мұнда шығынды да, теңгерімді де өзгертпей күтеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다리는 환불이 없습니다. 계좌에 아직 입금되지 않은 환불은 지출이나 잔액을 변경하지 않고 여기에 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтүлгөн кайтарымдар жок. Эсепке түшө элек кайтарым чыгымдарды жана калдыктарды өзгөртпөстөн ушул жерде күтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verwacht geen terugbetalingen. Terugbetalingen die nog niet zijn bijgeschreven, staan hier zonder je uitgaven of saldi te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak oczekujących zwrotów. Zwrot, który jeszcze nie dotarł na konto, czeka tutaj bez zmiany wydatków i sald."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum reembolso pendente. Os reembolsos que ainda não chegaram à conta ficam aqui sem alterar os gastos ou saldos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há reembolsos pendentes. Os reembolsos que ainda não chegaram à conta aparecem aqui sem alterar as despesas ou os saldos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидающих возвратов нет. Возврат, который ещё не пришёл на счёт, ждёт здесь и не меняет ни траты, ни остатки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бозгашти маблағе интизор нест. Маблағи ҳанӯз ба ҳисоб нарасида дар ин ҷо мемонад ва хароҷоту бақияро тағйир намедиҳад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen iade yok. Henüz hesaba geçmeyen iadeler, harcamaları veya bakiyeleri değiştirmeden burada bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернень не очікується. Повернення, що ще не дійшло на рахунок, чекає тут і не змінює витрат чи залишків."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutilayotgan qaytimlar yo‘q. Hisobga hali tushmagan qaytim xarajat va qoldiqlarni o‘zgartirmay shu yerda kutadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待到账退款。尚未到账的退款会显示在这里，不影响支出或余额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有待入帳的退款。尚未入帳的退款會顯示在這裡，不影響支出或餘額。"
          }
        }
      }
    },
    "purchases.waiting.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul hesaba çatanadək geri ödəniş xərcləri azaltmır və balansları dəyişmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль грошы не паступяць, вяртанне не змяншае выдаткі і не змяняе рэшткі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud peníze nedorazí, vrácená platba nesníží výdaje ani nezmění zůstatky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis das Geld ankommt, senkt eine Erstattung weder die Ausgaben noch ändert sie die Salden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until the money arrives a refund neither lowers spending nor changes balances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que llegue el dinero, una devolución no baja el gasto ni cambia los saldos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que l'argent n'est pas arrivé, un remboursement ne baisse ni les dépenses ni ne change les soldes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչև գումարի մուտքը վերադարձը չի նվազեցնում ծախսերը և չի փոխում մնացորդները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché non arriva, un rimborso non riduce le spese né modifica i saldi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金が届くまで、支出や残高には反映されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხის ჩარიცხვამდე დაბრუნება არ ამცირებს ხარჯებს და არ ცვლის ნაშთებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша келгенше қайтару шығынды азайтпайды және теңгерімді өзгертпейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환불금이 입금되기 전까지 지출과 잔액은 변경되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча түшкөнгө чейин кайтарым чыгымдарды азайтпайт жана калдыктарды өзгөртпөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot het geld binnen is, heeft een terugbetaling geen invloed op je uitgaven of saldi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do czasu otrzymania pieniędzy zwrot nie zmniejsza wydatków ani nie zmienia sald."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até o dinheiro chegar, o reembolso não reduz os gastos nem altera os saldos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até o dinheiro chegar, o reembolso não reduz as despesas nem altera os saldos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока деньги не пришли, возврат не уменьшает траты и не меняет остатки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То расидани маблағ бозгашт хароҷот ва бақияро тағйир намедиҳад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gelene kadar iade, harcamaları azaltmaz veya bakiyeleri değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доки гроші не надійшли, повернення не зменшує витрат і не змінює залишків."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul kelguncha qaytim xarajatlarni kamaytirmaydi va qoldiqlarni o‘zgartirmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款到账前不会减少支出或改变余额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款入帳前不會減少支出或影響餘額。"
          }
        }
      }
    },
