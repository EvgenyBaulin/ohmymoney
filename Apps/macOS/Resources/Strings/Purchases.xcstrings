    "purchases.waiting.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine Erstattungen erwartet. Eine Erstattung, die das Konto noch nicht erreicht hat, wartet hier, ohne Ausgaben oder Salden zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No refunds are awaited. A refund that has not reached the account yet waits here without changing spending or balances."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтарулар күтілмейді. Есеп-шотқа әлі жетпеген қайтару мұнда шығынды да, теңгерімді де өзгертпей күтеді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидающих возвратов нет. Возврат, который ещё не пришёл на счёт, ждёт здесь и не меняет ни траты, ни остатки."
          }
        }
      }
    },
    "purchases.waiting.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis das Geld ankommt, senkt eine Erstattung weder die Ausgaben noch ändert sie die Salden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until the money arrives a refund neither lowers spending nor changes balances."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша келгенше қайтару шығынды азайтпайды және теңгерімді өзгертпейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока деньги не пришли, возврат не уменьшает траты и не меняет остатки."
          }
        }
      }
    },
