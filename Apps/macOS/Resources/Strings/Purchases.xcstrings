    "purchases.thing.editor.tagHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tag gathers the operations on the thing: repairs, insurance, fuel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег собирает операции на эту вещь: ремонт, страховку, топливо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка збирає операції з цією річчю: ремонт, страховка, пальне."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Метка аб’ядноўвае аперацыі, звязаныя з рэччу: рамонт, страхаванне, паліва."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tag raggruppa le operazioni relative al bene: riparazioni, assicurazione, carburante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta reúne as operações do bem: reparos, seguro, combustível."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schlagwort sammelt die Vorgänge zur Sache: Reparaturen, Versicherung, Kraftstoff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'étiquette regroupe les opérations sur l'objet : réparations, assurance, carburant."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгі затқа қатысты операцияларды жинайды: жөндеу, сақтандыру, отын."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket, eşyayla ilgili işlemleri bir araya getirir: onarım, sigorta, yakıt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta reúne las operaciones de la cosa: reparaciones, seguro, combustible."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag łączy operacje związane z rzeczą: naprawy, ubezpieczenie, paliwo."
          }
        }
      }
    },
