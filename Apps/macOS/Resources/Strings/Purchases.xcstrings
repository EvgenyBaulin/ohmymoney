    "purchases.settings.pauseFooter": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hədd ayın sərbəst məbləğinin bir hissəsidir. Həmçinin hansı alış üçün “Peşman deyilsiniz?” sualının veriləcəyini müəyyən edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Парог вызначаецца доляй свабоднай сумы за месяц. Ён таксама вызначае, пра якія пакупкі задаваць пытанне “Не шкадуеце?”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hranice se určuje jako podíl z volných peněz na měsíc. Určuje také, u kterých nákupů se zobrazí otázka “Nelitujete?”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schwelle ist ein Anteil am freien Betrag des Monats. Sie entscheidet auch, welcher Kauf die Frage „Keine Reue?“ bekommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The threshold is a share of the free sum of the month. It also decides which purchase gets the question “No regrets?”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El umbral es una parte de la suma libre del mes. También decide qué compra recibe la pregunta «¿Algún arrepentimiento?»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le seuil est une part de la somme libre du mois. Il décide aussi quel achat reçoit la question « Aucun regret ? »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Շեմը ամսվա ազատ գումարի մասն է։ Այն նաև որոշում է, թե որ գնումից հետո հարցնել՝ “Չե՞ք զղջում”։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La soglia è una percentuale dell'importo disponibile del mese. Determina anche per quali acquisti viene posta la domanda “Nessun rimpianto?”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準額は月の自由に使える金額に対する割合です。「後悔していませんか？」と確認する購入にも適用されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზღვარი თვის თავისუფალი თანხის წილია. ის ასევე განსაზღვრავს, რომელ შენაძენზე დაისმება კითხვა “არ ნანობთ?”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шек — айдың бос қаржысының үлесі. Сондай-ақ қандай сатып алуға «Өкініш жоқ па?» деген сұрақ қойылатынын анықтайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준은 이번 달에 자유롭게 쓸 수 있는 금액의 비율입니다. 이 기준에 따라 “후회 없나요?”라는 질문을 표시할 구매도 결정됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек айдагы бош сумманын үлүшү катары белгиленет. Ал ошондой эле кайсы сатып алуу үчүн “Өкүнбөйсүзбү?” деген суроо берилерин аныктайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grens is een deel van het vrije bedrag van de maand. Deze bepaalt ook bij welke aankoop de vraag “Geen spijt?” wordt gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próg określa udział w wolnych środkach na miesiąc. Decyduje też, przy których zakupach pojawi się pytanie „Bez żalu?”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite é uma porcentagem do valor disponível no mês. Ele também determina para quais compras será feita a pergunta “Sem arrependimentos?”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite é uma percentagem do valor disponível no mês. Também determina que compras dão origem à pergunta “Sem arrependimentos?”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порог — доля свободной суммы месяца. Он же решает, о какой покупке спросить «Не пожалели?»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳад ҳамчун ҳиссаи маблағи озоди моҳ муайян мешавад. Он ҳамчунин муайян мекунад, ки барои кадом харид саволи “Пушаймон нестед?” дода шавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşik, ayın serbest tutarının bir yüzdesidir. Hangi satın alma için “Pişman değil misiniz?” sorusunun sorulacağını da belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поріг — це частка вільної суми за місяць. Він також визначає, для якої покупки ставиться питання «Без жалю?»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezon oydagi bo‘sh mablag‘ning ulushi sifatida belgilanadi. U qaysi xarid haqida “Afsuslanmadingizmi?” deb so‘ralishini ham belgilaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门槛按当月可用金额的比例计算，也用于决定哪些购买需要询问“后悔了吗？”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "門檻以每月可自由運用金額的比例計算，也用來決定哪些購買會收到「不後悔嗎？」的提問。"
          }
        }
      }
    },
