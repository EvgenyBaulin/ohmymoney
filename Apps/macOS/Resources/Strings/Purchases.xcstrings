    "purchases.thing.noPrice": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alış qiyməti yoxdur — yalnız əşyaya çəkilən xərclər hesablanır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошт пакупкі не пазначаны — улічваюцца толькі выдаткі на рэч"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez pořizovací ceny — počítají se jen výdaje na věc"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kaufpreis — gezählt wird nur, was dafür ausgegeben wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No purchase price — only what is spent on it is counted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin precio de compra — solo se cuenta lo que se gasta en ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de prix d'achat — seul ce qui y est dépensé est compté"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գնման գինը նշված չէ․ հաշվվում են միայն դրա վրա արված ծախսերը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun prezzo d’acquisto: vengono conteggiate solo le spese sostenute"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入価格なし — この持ち物にかかった費用のみを集計します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეძენის ფასი არ არის — ითვლება მხოლოდ მასზე გაწეული ხარჯი"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алу бағасы жоқ — оған жұмсалғаны ғана есептеледі"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 가격 없음 — 사용 비용만 계산합니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алуу баасы жок — буюмга кеткен чыгымдар гана эсептелет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen aankoopprijs — alleen de uitgaven voor dit bezit worden meegerekend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak ceny zakupu — liczone są tylko wydatki na tę rzecz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem preço de compra — só os gastos com o bem são contabilizados"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem preço de compra — só são contabilizadas as despesas com o bem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена покупки не указана — считаются только расходы на вещь"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нархи харид нест — танҳо хароҷоти он ҳисоб мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alış fiyatı yok — yalnızca eşya için yapılan harcamalar sayılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни покупки немає — враховується лише те, що на неї витрачено"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarid narxi yo‘q — faqat unga sarflangan mablag‘ hisoblanadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未填写购买价格，仅计入使用支出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定購買價格 — 僅計算相關支出"
          }
        }
      }
    },
    "purchases.thing.noTag": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Teq yoxdur — əşyaya çəkilən xərclər hesablanmır. Əməliyyatlara əşyanın adı ilə teq əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма меткі — выдаткі на рэч не ўлічваюцца. Дадайце метку з яе назвай да аперацый."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez štítku — výdaje na věc se nepočítají. Označte transakce štítkem s jejím názvem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Schlagwort — Ausgaben für die Sache werden nicht gezählt. Setzen Sie bei den Vorgängen ein Schlagwort mit ihrem Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tag — spending on the thing is not counted. Put a tag with its name on the operations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin etiqueta — el gasto en la cosa no se cuenta. Ponga a las operaciones una etiqueta con su nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'étiquette — les dépenses sur l'objet ne sont pas comptées. Mettez sur les opérations une étiquette portant son nom."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պիտակ չկա․ իրի վրա արված ծախսերը չեն հաշվվում։ Գործարքներին ավելացրեք իրի անունով պիտակ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tag: le spese per il bene non vengono conteggiate. Aggiungi alle operazioni un tag con il suo nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグなし — この持ち物への支出は集計されません。取引に持ち物の名前のタグを付けてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჭდე არ არის — ნივთზე გაწეული ხარჯი არ ითვლება. დაამატეთ ოპერაციებს ნივთის სახელის ჭდე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгі жоқ — затқа жұмсалған шығын есептелмейді. Операцияларға атымен белгі қойыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그 없음 — 이 물건의 지출이 계산되지 않습니다. 거래에 물건 이름을 태그로 추가하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег жок — буюмга кеткен чыгымдар эсептелбейт. Операцияларга буюмдун аты жазылган тегди коюңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen tag — uitgaven voor dit bezit worden niet meegerekend. Voeg een tag met de naam toe aan de transacties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak tagu — wydatki na tę rzecz nie są liczone. Dodaj do operacji tag z jej nazwą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem etiqueta — os gastos com o bem não são contabilizados. Adicione uma etiqueta com o nome dele às operações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem etiqueta — as despesas com o bem não são contabilizadas. Atribua aos movimentos uma etiqueta com o nome do bem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет тега — расходы на вещь не считаются. Ставьте операциям тег с названием вещи."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барчасп нест — хароҷоти ашё ҳисоб намешавад. Ба амалиёт барчаспи номи онро гузоред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket yok — eşya için yapılan harcamalar sayılmaz. İşlemlere eşyanın adını taşıyan bir etiket ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначки немає — витрати на річ не враховуються. Поставте операціям позначку з її назвою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Teg yo‘q — buyumga sarflangan mablag‘ hisoblanmaydi. Amallarga buyum nomi yozilgan teg qo‘ying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无标签，不计入物品支出。请为相关交易添加以物品命名的标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無標籤 — 不會計算這項物品的支出。請在交易中加上以物品名稱命名的標籤。"
          }
        }
      }
    },
