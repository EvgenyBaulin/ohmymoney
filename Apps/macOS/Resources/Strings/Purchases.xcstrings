    "purchases.afford.noPace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to put aside yet — no date can be told"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada apartado — no se puede calcular una fecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à mettre de côté pour l'instant — aucune date ne peut être calculée"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего откладывать — срок назвать нельзя"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладати ще нічого — дату визначити не можна"
          }
        }
      }
    },
    "purchases.afford.noRate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate for this currency — no date calculated"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tipo para esta divisa — no se calcula la fecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux pour cette devise — aucune date calculée"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса этой валюты — срок не посчитан"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї валюти немає курсу — дату не порахувати"
          }
        }
      }
    },
    "purchases.afford.now": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can afford it right now"
