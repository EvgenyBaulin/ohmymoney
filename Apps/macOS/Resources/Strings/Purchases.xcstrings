    "purchases.thing.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əşya siyahıdan silinəcək, əməliyyatlar qalacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэч будзе выдалена са спіса, а аперацыі застануцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věc se odstraní ze seznamu; transakce zůstanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sache verlässt die Liste; die Vorgänge bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The thing leaves the list; the operations stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cosa sale de la lista; las operaciones se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'objet quitte la liste ; les opérations restent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Իրը կհեռացվի ցանկից, իսկ գործարքները կմնան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'oggetto viene rimosso dalla lista; le operazioni restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ちものはリストから削除されますが、取引は残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნივთი წაიშლება სიიდან; ოპერაციები დარჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зат тізімнен шығады; операциялар қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물건은 목록에서 삭제되지만 거래 내역은 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Буюм тизмеден өчүрүлөт; операциялар сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het voorwerp wordt uit de lijst verwijderd; de transacties blijven staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzecz zostanie usunięta z listy, ale operacje pozostaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item será removido da lista; as transações serão mantidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O artigo é removido da lista; as operações mantêm-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вещь исчезнет из списка; операции останутся."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашё аз рӯйхат нест мешавад; амалиёт боқӣ мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşya listeden çıkarılır; işlemler kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Річ зникає зі списку; операції лишаються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Buyum ro‘yxatdan olib tashlanadi; operatsiyalar saqlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物品将从列表中移除，交易记录会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "物品會從清單移除，交易記錄仍會保留。"
          }
        }
      }
    },
