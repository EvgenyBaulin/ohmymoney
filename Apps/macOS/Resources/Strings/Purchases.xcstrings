    "purchases.waiting.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No refunds are awaited. A refund that has not reached the account yet waits here without changing spending or balances."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидающих возвратов нет. Возврат, который ещё не пришёл на счёт, ждёт здесь и не меняет ни траты, ни остатки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернень не очікується. Повернення, що ще не дійшло на рахунок, чекає тут і не змінює витрат чи залишків."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканых вяртанняў няма. Тут паказваюцца вяртанні, якія яшчэ не паступілі на рахунак і не ўплываюць на выдаткі і рэшткі."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun rimborso in attesa. I rimborsi non ancora arrivati sul conto restano qui senza modificare spese o saldi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum reembolso pendente. Os reembolsos que ainda não chegaram à conta ficam aqui sem alterar os gastos ou saldos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine Erstattungen erwartet. Eine Erstattung, die das Konto noch nicht erreicht hat, wartet hier, ohne Ausgaben oder Salden zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun remboursement n'est attendu. Un remboursement qui n'est pas encore arrivé sur le compte attend ici, sans changer les dépenses ni les soldes."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтарулар күтілмейді. Есеп-шотқа әлі жетпеген қайтару мұнда шығынды да, теңгерімді де өзгертпей күтеді."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen iade yok. Henüz hesaba geçmeyen iadeler, harcamaları veya bakiyeleri değiştirmeden burada bekler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se espera ninguna devolución. Una devolución que todavía no ha llegado a la cuenta espera aquí sin cambiar gastos ni saldos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak oczekujących zwrotów. Zwrot, który jeszcze nie dotarł na konto, czeka tutaj bez zmiany wydatków i sald."
          }
        }
      }
    },
    "purchases.waiting.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until the money arrives a refund neither lowers spending nor changes balances."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока деньги не пришли, возврат не уменьшает траты и не меняет остатки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доки гроші не надійшли, повернення не зменшує витрат і не змінює залишків."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль грошы не паступяць, вяртанне не змяншае выдаткі і не змяняе рэшткі."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché non arriva, un rimborso non riduce le spese né modifica i saldi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até o dinheiro chegar, o reembolso não reduz os gastos nem altera os saldos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis das Geld ankommt, senkt eine Erstattung weder die Ausgaben noch ändert sie die Salden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que l'argent n'est pas arrivé, un remboursement ne baisse ni les dépenses ni ne change les soldes."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша келгенше қайтару шығынды азайтпайды және теңгерімді өзгертпейді."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gelene kadar iade, harcamaları azaltmaz veya bakiyeleri değiştirmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que llegue el dinero, una devolución no baja el gasto ni cambia los saldos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do czasu otrzymania pieniędzy zwrot nie zmniejsza wydatków ani nie zmienia sald."
          }
        }
      }
    },
