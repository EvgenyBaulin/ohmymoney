    "purchases.afford.noPace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to put aside yet — no date can be told"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada apartado — no se puede calcular una fecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à mettre de côté pour l'instant — aucune date ne peut être calculée"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего откладывать — срок назвать нельзя"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладати ще нічого — дату визначити не можна"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жинайтын ештеңе жоқ әлі — күнін айтуға болмайды"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма чаго адкладаць — дата невядомая"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts beiseitegelegt — ein Datum lässt sich nicht bestimmen"
          }
        }
      }
    },
    "purchases.afford.noRate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate for this currency — no date calculated"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tipo para esta divisa — no se calcula la fecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux pour cette devise — aucune date calculée"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса этой валюты — срок не посчитан"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї валюти немає курсу — дату не порахувати"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл валюта үшін бағам жоқ — күні есептелмеді"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма курсу для гэтай валюты — дата не разлічана"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kurs für diese Währung — kein Datum berechnet"
          }
        }
      }
    },
    "purchases.afford.now": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can afford it right now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede permitir ahora mismo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez vous le permettre dès maintenant"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Денег хватает уже сейчас"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна собі дозволити вже зараз"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір алуға болады"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можаце дазволіць сабе гэта ўжо зараз"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können es sich jetzt leisten"
          }
        }
      }
    },
    "purchases.afford.pace": {
