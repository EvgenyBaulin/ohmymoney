    "purchases.thing.editor.tagHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Teq əşya ilə bağlı əməliyyatları toplayır: təmir, sığorta, yanacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Метка аб’ядноўвае аперацыі, звязаныя з рэччу: рамонт, страхаванне, паліва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítek sdružuje transakce související s věcí: opravy, pojištění, palivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schlagwort sammelt die Vorgänge zur Sache: Reparaturen, Versicherung, Kraftstoff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tag gathers the operations on the thing: repairs, insurance, fuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta reúne las operaciones de la cosa: reparaciones, seguro, combustible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'étiquette regroupe les opérations sur l'objet : réparations, assurance, carburant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պիտակը միավորում է իրի հետ կապված գործարքները՝ վերանորոգում, ապահովագրություն, վառելիք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tag raggruppa le operazioni relative al bene: riparazioni, assicurazione, carburante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグで修理、保険、燃料など、この持ち物に関する取引をまとめます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჭდე აერთიანებს ნივთთან დაკავშირებულ ოპერაციებს: შეკეთებას, დაზღვევას, საწვავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгі затқа қатысты операцияларды жинайды: жөндеу, сақтандыру, отын."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그로 수리, 보험, 연료 등 이 물건에 관한 거래를 모읍니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег буюмга байланышкан операцияларды чогултат: оңдоо, камсыздандыруу, күйүүчү май."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tag groepeert de transacties voor dit bezit: reparaties, verzekering en brandstof."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag łączy operacje związane z rzeczą: naprawy, ubezpieczenie, paliwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta reúne as operações do bem: reparos, seguro, combustível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta agrupa os movimentos do bem: reparações, seguro, combustível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег собирает операции на эту вещь: ремонт, страховку, топливо."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барчасп амалиёти марбут ба ашёро ҷамъ мекунад: таъмир, суғурта, сӯзишворӣ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket, eşyayla ilgili işlemleri bir araya getirir: onarım, sigorta, yakıt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка збирає операції з цією річчю: ремонт, страховка, пальне."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Teg buyumga oid amallarni jamlaydi: ta’mir, sug‘urta, yoqilg‘i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用标签归集物品的相关交易，如维修、保险和燃油。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用標籤彙整這項物品的交易，例如維修、保險和燃料。"
          }
        }
      }
    },
