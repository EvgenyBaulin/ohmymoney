    "purchases.afford.noPace": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts beiseitegelegt — ein Datum lässt sich nicht bestimmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to put aside yet — no date can be told"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жинайтын ештеңе жоқ әлі — күнін айтуға болмайды"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего откладывать — срок назвать нельзя"
          }
        }
      }
    },
    "purchases.afford.noRate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kurs für diese Währung — kein Datum berechnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate for this currency — no date calculated"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл валюта үшін бағам жоқ — күні есептелмеді"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса этой валюты — срок не посчитан"
          }
        }
      }
    },
