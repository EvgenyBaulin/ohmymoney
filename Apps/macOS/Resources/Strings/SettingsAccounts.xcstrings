    "templates.hintAdded": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar daxil etdiklərinizdən avtomatik yaranır, özünüz də əlavə edə bilərsiniz. Bərkidilmiş şablonlar həmişə əvvəl görünür. Arxivdəki şablon seçimlərdən çıxarılır və «Geri qaytar» ilə qaytarılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны ствараюцца з вашых запісаў, але вы можаце дадаць іх і самі. Замацаваныя заўсёды застаюцца першымі. Шаблон у архіве знікае з падказак; яго можна вярнуць праз «Вярнуць»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šablony se vytvářejí z toho, co zadáváte, nebo si je můžete přidat sami. Připnuté šablony zůstávají vždy na začátku. Šablona v archivu zmizí z nabídky a vrátí se po volbě «Vrátit zpět»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen füllen sich aus dem, was Sie eingeben, und Sie können selbst eine hinzufügen. Angeheftete bleiben immer vorn. Eine Vorlage im Archiv verschwindet aus den Chips und kommt mit „Zurückholen“ wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates fill themselves from what you enter, and you can add one yourself. Pinned ones always stay first. A template in the archive leaves the chips and comes back with «Bring back»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas se rellenan solas con lo que introduce, y puede añadir una usted mismo. Las fijadas siempre van primero. Una plantilla en el archivo sale de los chips y vuelve con «Recuperar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles se remplissent d'eux-mêmes d'après ce que vous saisissez, et vous pouvez en ajouter un vous-même. Les épinglés restent toujours en premier. Un modèle aux archives quitte les pastilles et revient avec « Ramener »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձևանմուշները ստեղծվում են ձեր մուտքագրածից, և կարող եք նաև ինքներդ ավելացնել։ Ամրացվածները միշտ առաջինն են։ Արխիվացված ձևանմուշը հեռացվում է ցանկից և վերադառնում է «Վերադարձնել» հրամանով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli si creano automaticamente da ciò che inserisci, ma puoi anche aggiungerli. Quelli fissati restano sempre in cima. Un modello archiviato scompare dai suggerimenti e torna con «Ripristina»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートは入力内容から自動的に作成されます。自分で追加することもできます。ピン留めしたものは常に先頭に表示されます。アーカイブしたテンプレートは候補から消え、«Bring back»で戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შაბლონები ავტომატურად იქმნება თქვენ მიერ შეყვანილი მონაცემებით; ასევე შეგიძლიათ თავად დაამატოთ. მიმაგრებული შაბლონები ყოველთვის პირველია. დაარქივებული შაბლონი ქრება სიიდან და ბრუნდება ღილაკით «დაბრუნება»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлгілер енгізгендеріңізден өзі толтырылады, өзіңіз де қоса аласыз. Бекітілгендері әрдайым алда тұрады. Мұрағаттағы үлгі батырмалардан жоғалып, «Қайтару» арқылы оралады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблондор киргизген маалыматыңыздан түзүлөт, өзүңүз да кошо аласыз. Бекитилгендер дайыма биринчи турат. Архивдеги шаблон тандоодон алынып, «Кайтаруу» менен кайра кошулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjablonen worden automatisch gemaakt op basis van je invoer. Je kunt er ook zelf een toevoegen. Vastgemaakte sjablonen staan altijd bovenaan. Een gearchiveerd sjabloon verdwijnt uit de knoppen en komt terug met «Zet terug»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablony tworzą się automatycznie na podstawie wpisów. Możesz też dodać własny. Przypięte szablony są zawsze na początku. Szablon w archiwum znika z listy i wraca po wybraniu opcji «Przywróć»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos são criados automaticamente a partir do que você digita, mas você também pode adicioná-los. Os fixados aparecem sempre primeiro. Modelos arquivados saem das sugestões e voltam com «Trazer de volta»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos são criados a partir do que introduz, mas também pode adicioná-los. Os modelos fixados aparecem sempre primeiro. Um modelo arquivado deixa de aparecer nas sugestões e pode ser reposto com «Repor»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны сами набираются из того, что вы вводите, и добавляются вручную. Закреплённые всегда идут первыми. Шаблон в архиве уходит из чипов и возвращается кнопкой «Вернуть»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолабҳо аз маълумоти воридкардаатон худкор сохта мешаванд; шумо ҳам метавонед қолаб илова кунед. Қолабҳои пайвастшуда ҳамеша дар авваланд. Қолаби бойгонӣ аз рӯйхати интихобҳо хориҷ мешавад ва бо «Баргардондан» бармегардад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar girdiklerinizden otomatik oluşturulur; siz de ekleyebilirsiniz. Sabitlenenler her zaman üstte kalır. Arşivlenen şablon kısayollardan kaldırılır ve «Geri getir» ile geri alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони створюються з ваших записів, також їх можна додати вручну. Закріплені завжди перші. Шаблон в архіві зникає з підказок і повертається через «Повернути»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Andozalar kiritgan ma’lumotlaringizdan avtomatik yaratiladi, ularni o‘zingiz ham qo‘shishingiz mumkin. Qadalganlari doim birinchi turadi. Arxivdagi andoza ro‘yxatdan chiqadi va «Qaytarish» orqali qaytadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板会根据输入内容自动生成，你也可以自行添加。置顶的模板始终排在前面。归档的模板会从快捷选项中移除，选择«恢复»即可重新显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本會根據你的輸入自動建立，你也可以自行加入。釘選的範本會顯示在最前面。封存的範本會從快捷選項中移除，並可透過「移回」恢復。"
          }
        }
      }
    },
    "tree.add": {
