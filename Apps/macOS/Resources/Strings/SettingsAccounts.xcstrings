        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց խմբի հաշիվը միշտ ներառվում է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto senza gruppo viene sempre incluso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループに属さない口座は常に集計されます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯგუფის გარეშე ანგარიში ყოველთვის შედის შეჯამებაში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топсыз шот әрдайым есептеледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Топко кирбеген эсеп дайыма кошулат"
          }
        },
