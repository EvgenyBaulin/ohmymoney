    "settings.entry.firstPurchaseHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız yeni yerdə ilk alış üçün: sonrakı alışlar orada son istifadə edilən kartla aparılır. Əsas hesab və valyuta öz bölmələrində dəyişdirilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі для першай пакупкі ў новым месцы: пасля гэтага там выкарыстоўваецца картка апошняй пакупкі. Асноўны рахунак і валюта змяняюцца ў адпаведных раздзелах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze pro první nákup na novém místě. Další nákup na stejném místě použije kartu z posledního nákupu. Hlavní účet a měnu změníte v příslušných oddílech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der erste Kauf an einem neuen Ort: Danach wird ein Kauf dort mit der Karte des letzten gemacht. Das Hauptkonto und die Währung ändern Sie in ihren eigenen Abschnitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the first purchase at a new place: after it, a purchase there is made with the card of the last one. The main account and the currency are changed in their own sections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la primera compra en un lugar nuevo: después, una compra allí se hace con la tarjeta de la última. La cuenta principal y la divisa se cambian en sus propias secciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement le premier achat dans un nouveau lieu : ensuite, un achat là-bas se fait avec la carte du dernier. Le compte principal et la devise se modifient dans leurs propres sections."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն նոր վայրում առաջին գնման համար․ հաջորդ գնումների համար կընտրվի այդ վայրում վերջին անգամ օգտագործված քարտը։ Հիմնական հաշիվն ու արժույթը փոխվում են իրենց բաժիններում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per il primo acquisto in un nuovo posto: gli acquisti successivi useranno la carta dell'ultimo acquisto. Il conto principale e la valuta si modificano nelle rispettive sezioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいお店での最初の購入にのみ適用されます。以降は、そのお店で前回使用したカードが使われます。メイン口座と通貨はそれぞれの設定で変更できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ პირველ შენაძენზე ახალ ადგილას: შემდეგ იქ შენაძენი ბოლო გამოყენებული ბარათით შესრულდება. მთავარი ანგარიში და ვალუტა შესაბამის განყოფილებებში იცვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек жаңа орындағы алғашқы сатып алу үшін: одан кейін сол орындағы соңғы сатып алудың картасы қолданылады. Негізгі шот пен валюта өз бөлімдерінде өзгертіледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңы жердеги биринчи сатып алуу үчүн гана: андан кийинки сатып алууларда акыркы колдонулган карта тандалат. Негизги эсеп жана валюта өз бөлүмдөрүндө өзгөртүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen voor de eerste aankoop op een nieuwe plek. Daarna wordt de kaart van de laatste aankoop daar gebruikt. De hoofdrekening en valuta wijzig je in hun eigen onderdelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy tylko pierwszego zakupu w nowym miejscu. Kolejne zakupy w tym miejscu są przypisywane do karty użytej ostatnio. Główne konto i walutę zmienisz w osobnych sekcjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para a primeira compra em um novo lugar. Depois, as compras nesse lugar usam o cartão da última compra. A conta principal e a moeda são alteradas nas respectivas seções."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para a primeira compra num novo local. As compras seguintes nesse local usam o cartão da última compra. A conta principal e a moeda são alteradas nas respetivas secções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для первой траты в новом месте: дальше там берётся карта последней покупки. Основной счёт и валюта меняются в своих разделах."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо барои хариди аввал дар ҷои нав: харидҳои баъдӣ бо корти хариди охирин анҷом мешаванд. Суратҳисоби асосӣ ва асъор дар бахшҳои худ тағйир дода мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yeni bir yerdeki ilk harcama için geçerlidir. Sonraki harcamalarda son kullanılan kart seçilir. Ana hesap ve para birimi kendi bölümlerinden değiştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише перша покупка в новому місці: наступні покупки там оплачуються карткою останньої покупки. Основний рахунок і валюта змінюються у своїх розділах."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat yangi joydagi birinchi xarid uchun: keyingi xaridlar oxirgi xaridda ishlatilgan karta bilan amalga oshiriladi. Asosiy hisob va valyuta tegishli bo‘limlarda o‘zgartiriladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于在新地点的首次消费；之后在该地点消费时，将使用上次消费的卡片。主账户和货币可在各自的设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於新地點的第一筆消費；之後在該地點消費時，會使用上次的卡片。主要帳戶和貨幣可在各自的區段更改。"
          }
        }
      }
    },
