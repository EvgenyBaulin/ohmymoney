    "panel.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змены прымяняюцца адразу, ⌘Z адмяняе іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten sofort, ⌘Z macht sie rückgängig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply at once, ⌘Z undoes them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican al momento; ⌘Z los deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s'appliquent tout de suite, ⌘Z les annule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche sono immediate. Per annullarle, premi ⌘Z."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгерістер бірден қолданылады, ⌘Z болдырмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгөртүүлөр дароо колдонулат, ⌘Z аларды жокко чыгарат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany są stosowane od razu. Aby je cofnąć, naciśnij ⌘Z."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são aplicadas na hora. ⌘Z desfaz as alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка применяется сразу, ⌘Z отменяет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйирот фавран татбиқ мешаванд, ⌘Z онҳоро бекор мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler hemen uygulanır, ⌘Z ile geri alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни застосовуються одразу, ⌘Z скасовує їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarishlar darhol qo‘llanadi, ⌘Z ularni bekor qiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改會立即生效，可按 ⌘Z 還原。"
          }
        }
      }
    },
    "panel.note.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змены прымяняюцца адразу, іх можна адмяніць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten sofort und lassen sich rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply at once and can be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican al momento y se pueden deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s'appliquent tout de suite et peuvent être annulées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche sono immediate e possono essere annullate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгерістер бірден қолданылады, оларды болдырмауға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгөртүүлөр дароо колдонулат жана аларды жокко чыгарса болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany są stosowane od razu i można je cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são aplicadas na hora e podem ser desfeitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка применяется сразу и отменяется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйирот фавран татбиқ мешаванд ва онҳоро бекор кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler hemen uygulanır ve geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни застосовуються одразу, їх можна скасувати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarishlar darhol qo‘llanadi va ularni bekor qilish mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改會立即生效，並可還原。"
          }
        }
      }
    },
    "panel.start": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахункаў пакуль няма: пачніце з банка — разам з ім з’явяцца першы рахунак і картка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Konto: Beginnen Sie mit einer Bank — sie bringt ihr erstes Konto und ihre erste Karte mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account yet: start with a bank — it brings its first account and card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay cuentas: empiece con un banco — trae su primera cuenta y tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de compte : commencez par une banque — elle apporte son premier compte et sa carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conto: inizia da una banca, che include il primo conto e la prima carta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әлі шот жоқ: банктен бастаңыз — онымен бірге алғашқы шот пен карта қосылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептер жок: банктан баштаңыз — аны менен биринчи эсеп жана карта кошулат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze konta? Zacznij od banku — wraz z nim dodasz pierwsze konto i kartę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta ainda: comece com um banco para criar a primeira conta e o primeiro cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счетов пока нет: начните с банка — он появится сразу с первым счётом и картой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз суратҳисоб нест: аз бонк оғоз кунед — он суратҳисоб ва корти аввалро меорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hesap yok: Bir bankayla başlayın. İlk hesap ve kart da eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунків ще немає: почніть із банку — він додасть перший рахунок і картку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali hisob yo‘q: bankdan boshlang — uning birinchi hisobi va kartasi qo‘shiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無帳戶：先加入銀行，即可建立第一個帳戶和卡片。"
          }
        }
      }
    },
