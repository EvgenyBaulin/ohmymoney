        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s'appliquent tout de suite, ⌘Z les annule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка применяется сразу, ⌘Z отменяет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни застосовуються одразу, ⌘Z скасовує їх."
          }
        }
      }
    },
