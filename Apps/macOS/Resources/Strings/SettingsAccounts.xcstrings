      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlər və məbləğ, məsələn, qəhvə 250"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Словы і сума, напрыклад кава 250"
          }
        },
        "cs": {
          "stringUnit": {
