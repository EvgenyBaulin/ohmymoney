    "panel.inSummary.noGroup": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qrupa aid olmayan hesab həmişə nəzərə alınır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак без групы заўсёды ўлічваецца"
