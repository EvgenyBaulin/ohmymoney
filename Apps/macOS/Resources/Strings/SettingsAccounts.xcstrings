    "templates.hintAdded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates fill themselves from what you enter, and you can add one yourself. Pinned ones always stay first. A template in the archive leaves the chips and comes back with «Bring back»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны сами набираются из того, что вы вводите, и добавляются вручную. Закреплённые всегда идут первыми. Шаблон в архиве уходит из чипов и возвращается кнопкой «Вернуть»."
          }
        }
      }
    },
