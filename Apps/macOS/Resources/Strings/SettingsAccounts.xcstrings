    "panel.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişikliklər dərhal tətbiq olunur, ⌘Z ilə geri alınır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змены прымяняюцца адразу, ⌘Z адмяняе іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny se projeví ihned, ⌘Z je vrátí zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten sofort, ⌘Z macht sie rückgängig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply at once, ⌘Z undoes them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican al momento; ⌘Z los deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s'appliquent tout de suite, ⌘Z les annule."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոփոխությունները կիրառվում են անմիջապես, ⌘Z-ը հետարկում է դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche sono immediate. Per annullarle, premi ⌘Z."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はすぐに適用されます。⌘Zで取り消せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცვლილებები მაშინვე აისახება, ⌘Z აუქმებს მათ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгерістер бірден қолданылады, ⌘Z болдырмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгөртүүлөр дароо колдонулат, ⌘Z аларды жокко чыгарат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen worden direct toegepast. Met ⌘Z maak je ze ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany są stosowane od razu. Aby je cofnąć, naciśnij ⌘Z."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são aplicadas na hora. ⌘Z desfaz as alterações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são aplicadas de imediato. Prima ⌘Z para as anular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка применяется сразу, ⌘Z отменяет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйирот фавран татбиқ мешаванд, ⌘Z онҳоро бекор мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler hemen uygulanır, ⌘Z ile geri alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни застосовуються одразу, ⌘Z скасовує їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarishlar darhol qo‘llanadi, ⌘Z ularni bekor qiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改立即生效，按 ⌘Z 可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改會立即生效，可按 ⌘Z 還原。"
          }
        }
      }
    },
    "panel.note.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişikliklər dərhal tətbiq olunur və geri alına bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змены прымяняюцца адразу, іх можна адмяніць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny se projeví ihned a lze je vrátit zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten sofort und lassen sich rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply at once and can be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican al momento y se pueden deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s'appliquent tout de suite et peuvent être annulées."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոփոխությունները կիրառվում են անմիջապես և կարող են հետարկվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche sono immediate e possono essere annullate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はすぐに適用され、取り消すことができます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცვლილებები მაშინვე აისახება და მათი გაუქმება შესაძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгерістер бірден қолданылады, оларды болдырмауға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгөртүүлөр дароо колдонулат жана аларды жокко чыгарса болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen worden direct toegepast en kunnen ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany są stosowane od razu i można je cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são aplicadas na hora e podem ser desfeitas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são aplicadas de imediato e podem ser anuladas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка применяется сразу и отменяется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйирот фавран татбиқ мешаванд ва онҳоро бекор кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler hemen uygulanır ve geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни застосовуються одразу, їх можна скасувати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarishlar darhol qo‘llanadi va ularni bekor qilish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改立即生效，且可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改會立即生效，並可還原。"
          }
        }
      }
    },
    "panel.start": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ hesab yoxdur: bankla başlayın — ilk hesab və kart da əlavə olunacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахункаў пакуль няма: пачніце з банка — разам з ім з’явяцца першы рахунак і картка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nemáte žádný účet. Začněte přidáním banky — s ní přibude první účet a karta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Konto: Beginnen Sie mit einer Bank — sie bringt ihr erstes Konto und ihre erste Karte mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account yet: start with a bank — it brings its first account and card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay cuentas: empiece con un banco — trae su primera cuenta y tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de compte : commencez par une banque — elle apporte son premier compte et sa carte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ հաշիվ չկա․ սկսեք բանկից՝ առաջին հաշիվն ու քարտը կավելացվեն ինքնաբերաբար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conto: inizia da una banca, che include il primo conto e la prima carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座がありません。まず銀行を追加すると、口座とカードも作成されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიში ჯერ არ არის: დაიწყეთ ბანკით — მასთან ერთად პირველი ანგარიში და ბარათიც დაემატება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әлі шот жоқ: банктен бастаңыз — онымен бірге алғашқы шот пен карта қосылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептер жок: банктан баштаңыз — аны менен биринчи эсеп жана карта кошулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen rekening: begin met een bank. De eerste rekening en kaart worden automatisch toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze konta? Zacznij od banku — wraz z nim dodasz pierwsze konto i kartę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta ainda: comece com um banco para criar a primeira conta e o primeiro cartão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há contas: comece por adicionar um banco, que inclui a primeira conta e o primeiro cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счетов пока нет: начните с банка — он появится сразу с первым счётом и картой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз суратҳисоб нест: аз бонк оғоз кунед — он суратҳисоб ва корти аввалро меорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hesap yok: Bir bankayla başlayın. İlk hesap ve kart da eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунків ще немає: почніть із банку — він додасть перший рахунок і картку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali hisob yo‘q: bankdan boshlang — uning birinchi hisobi va kartasi qo‘shiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无账户：先添加银行，系统会同时添加第一个账户和卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無帳戶：先加入銀行，即可建立第一個帳戶和卡片。"
          }
        }
      }
    },
