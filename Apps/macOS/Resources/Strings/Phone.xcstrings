    "phone.folder.demo": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дэма нічога не запісвае па-за праграмай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Demo schreibt nichts außerhalb der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The demo writes nothing outside the app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La demo non salva nulla fuori dall’app."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо қолданбадан тыс ештеңе жазбайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо ничего не пишет за пределы приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрація нічого не записує поза застосунком."
          }
        }
      }
    },
    "phone.folder.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сюды штодня запісваюцца копіі вашых даных. Сама база даных застаецца ў праграме."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorthin werden tägliche Kopien Ihrer Bücher geschrieben. Die Datenbank selbst verlässt die App nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily copies of your books are written there. The database itself never leaves the app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vengono salvate copie giornaliere dei tuoi dati. Il database rimane sempre nell’app."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кітаптарыңыздың күнделікті көшірмелері сонда жазылады. Дерекқордың өзі қолданбадан ешқашан шықпайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туда пишутся ежедневные копии ваших данных. Сама база никогда не покидает приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Туди записуються щоденні копії вашого обліку. Сама база даних ніколи не залишає застосунок."
          }
        }
      }
    },
    "phone.folder.lost": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку больш нельга адкрыць. Магчыма, яна была перайменавана, перамешчана або выдалена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner lässt sich nicht mehr öffnen. Er wurde vielleicht umbenannt, verschoben oder entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder can no longer be opened. It may have been renamed, moved or removed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la cartella. Potrebbe essere stata rinominata, spostata o rimossa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалтаны енді ашу мүмкін емес. Оның атауы өзгерген, жылжытылған немесе жойылған болуы мүмкін."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку больше не удаётся открыть. Возможно, её переименовали, перенесли или удалили."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка більше не відкривається. Можливо, її перейменовано, переміщено або видалено."
          }
        }
      }
    },
    "phone.folder.none": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
