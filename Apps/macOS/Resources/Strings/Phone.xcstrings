    "phone.data.realNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашы даныя захоўваюцца на гэтым тэлефоне. Дэма застаецца без змен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigenen Bücher, auf diesem iPhone gespeichert. Die Demo bleibt, wie sie war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own books, kept on this phone. The demo is left as it was."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati, conservati su questo telefono. La demo rimane invariata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз кітаптарыңыз, осы телефонда сақталады. Демо өз күйінде қалады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши настоящие данные, они хранятся на этом телефоне. Демо остаётся как было."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш облік, що зберігається на цьому телефоні. Демонстраційні дані залишаться без змін."
          }
        }
      }
    },
