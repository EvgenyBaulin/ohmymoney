  "strings": {
    "phone.data.demo": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрація"
          }
        }
      }
    },
    "phone.data.demoNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfundener Verlauf zum Ansehen. Was Sie hier tun, berührt Ihre echten Bücher nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made-up history to look around. Nothing you do here touches your real books."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдуманная история, чтобы осмотреться. Ничто здесь не затрагивает ваши настоящие данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вигадана історія для ознайомлення. Дії тут не впливають на ваш справжній облік."
          }
        }
      }
    },
    "phone.data.real": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Daten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои данные"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої дані"
          }
        }
      }
    },
    "phone.data.realNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigenen Bücher, auf diesem iPhone gespeichert. Die Demo bleibt, wie sie war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own books, kept on this phone. The demo is left as it was."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши настоящие данные, они хранятся на этом телефоне. Демо остаётся как было."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш облік, що зберігається на цьому телефоні. Демонстраційні дані залишаться без змін."
          }
        }
      }
    },
