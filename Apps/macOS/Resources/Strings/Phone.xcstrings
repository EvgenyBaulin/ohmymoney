    "phone.folder.demo": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дэма нічога не запісвае па-за праграмай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Demo schreibt nichts außerhalb der App."
          }
        },
        "en": {
