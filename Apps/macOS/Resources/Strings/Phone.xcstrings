    "phone.data.demoNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прыдуманая гісторыя для азнаямлення. Вашы дзеянні тут не закранаюць вашы сапраўдныя даныя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfundener Verlauf zum Ansehen. Was Sie hier tun, berührt Ihre echten Bücher nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made-up history to look around. Nothing you do here touches your real books."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati fittizi da esplorare. Le modifiche non riguardano i tuoi dati reali."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айналып көру үшін ойдан шығарылған тарих. Мұнда не жасасаңыз да, нақты кітапқа тимейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдуманная история, чтобы осмотреться. Ничто здесь не затрагивает ваши настоящие данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вигадана історія для ознайомлення. Дії тут не впливають на ваш справжній облік."
          }
        }
      }
    },
    "phone.data.real": {
