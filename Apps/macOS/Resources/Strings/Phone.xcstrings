    "phone.lock.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На гэтым тэлефоне няма Face ID і код-пароля для разблакіравання."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone hat weder Face ID noch einen Code zum Entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no Face ID and no passcode to unlock with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no tiene Face ID ni código con el que desbloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'a ni Face ID ni code pour déverrouiller."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսում Face ID կամ գաղտնագիր կարգավորված չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non dispone di Face ID o di un codice per lo sblocco."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл телефонда ашу үшін Face ID де, құписөз де жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул телефондо кулпуну ачуу үчүн Face ID да, код да жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie ma Face ID ani kodu umożliwiającego odblokowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este celular não tem Face ID nem código para desbloqueio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телефоне нет ни Face ID, ни код-пароля для разблокировки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин телефон Face ID ва рамз барои кушодани қулф мавҷуд нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda kilidi açmak için Face ID veya parola yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому телефоні немає ні Face ID, ні коду допуску для розблокування."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda qulfni ochish uchun Face ID ham, parol ham yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
