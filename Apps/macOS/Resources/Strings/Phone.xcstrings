    "phone.data.demoNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made-up history to look around. Nothing you do here touches your real books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial inventado para mirar. Nada de lo que haga aquí toca sus cuentas reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un historique fictif pour découvrir l'app. Rien de ce que vous faites ici ne touche à vos vrais comptes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдуманная история, чтобы осмотреться. Ничто здесь не затрагивает ваши настоящие данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вигадана історія для ознайомлення. Дії тут не впливають на ваш справжній облік."
          }
        }
      }
    },
