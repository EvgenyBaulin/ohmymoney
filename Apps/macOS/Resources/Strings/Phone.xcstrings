    "phone.lock.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda kilidi açmaq üçün Face ID və ya parol yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На гэтым тэлефоне няма Face ID і код-пароля для разблакіравання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefon nemá Face ID ani kód pro odemknutí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone hat weder Face ID noch einen Code zum Entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no Face ID and no passcode to unlock with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no tiene Face ID ni código con el que desbloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'a ni Face ID ni code pour déverrouiller."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսում Face ID կամ գաղտնագիր կարգավորված չէ։"
          }
        },
        "it": {
