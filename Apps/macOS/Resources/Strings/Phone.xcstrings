          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалта таңдалмаған. Көшірмелер қолданба ішінде қалады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
