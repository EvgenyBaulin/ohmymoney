    "phone.data.demoNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanış olmaq üçün uydurma tarixçə. Burada etdikləriniz öz maliyyə qeydlərinizə təsir etmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прыдуманая гісторыя для азнаямлення. Вашы дзеянні тут не закранаюць вашы сапраўдныя даныя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymyšlená historie k prohlédnutí. Nic z toho, co zde uděláte, neovlivní vaše skutečné údaje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfundener Verlauf zum Ansehen. Was Sie hier tun, berührt Ihre echten Bücher nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made-up history to look around. Nothing you do here touches your real books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial inventado para mirar. Nada de lo que haga aquí toca sus cuentas reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un historique fictif pour découvrir l'app. Rien de ce que vous faites ici ne touche à vos vrais comptes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հորինված պատմություն՝ հավելվածին ծանոթանալու համար։ Այստեղ կատարված գործողությունները չեն ազդում ձեր իրական հաշվառման վրա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati fittizi da esplorare. Le modifiche non riguardano i tuoi dati reali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お試し用の架空の履歴です。ここでの操作は実際の帳簿に影響しません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოგონილი ისტორია გასაცნობად. აქ შესრულებული მოქმედებები თქვენს რეალურ მონაცემებზე არ აისახება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айналып көру үшін ойдан шығарылған тарих. Мұнда не жасасаңыз да, нақты кітапқа тимейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘러보기를 위한 가상 기록입니다. 여기서 하는 작업은 실제 장부에 영향을 주지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Таанышуу үчүн ойдон чыгарылган тарых. Бул жердеги аракеттериңиз чыныгы эсептериңизге таасир этпейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fictieve gegevens om rond te kijken. Wat je hier doet, heeft geen invloed op je echte administratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przykładowa historia do przeglądania. Żadne działania tutaj nie zmienią Twoich danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico fictício para explorar. Nada do que você fizer aqui afetará seus dados reais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados fictícios para explorar a app. O que fizer aqui não afeta as suas contas reais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдуманная история, чтобы осмотреться. Ничто здесь не затрагивает ваши настоящие данные."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таърихи намунавӣ барои шиносоӣ. Амалҳои шумо ба маълумоти воқеӣ таъсир намерасонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı keşfetmeniz için oluşturulmuş örnek kayıtlar. Burada yaptıklarınız gerçek kayıtlarınızı etkilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вигадана історія для ознайомлення. Дії тут не впливають на ваш справжній облік."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanishish uchun namuna ma’lumotlar. Bu yerda qilgan ishlaringiz haqiqiy hisoblaringizga ta’sir qilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用虚构记录供你体验。在此进行的操作不会影响你的真实账本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用虛構紀錄探索功能。此處的操作不會影響你的真實帳本。"
          }
        }
      }
    },
