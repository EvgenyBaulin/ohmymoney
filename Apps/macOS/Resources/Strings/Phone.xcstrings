    "phone.data.realNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Öz maliyyə qeydləriniz bu telefonda saxlanılır. Demo olduğu kimi qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашы даныя захоўваюцца на гэтым тэлефоне. Дэма застаецца без змен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše vlastní údaje uložené v tomto telefonu. Ukázka zůstane beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigenen Bücher, auf diesem iPhone gespeichert. Die Demo bleibt, wie sie war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own books, kept on this phone. The demo is left as it was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus propias cuentas, guardadas en este teléfono. La demo se queda como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos propres comptes, gardés sur ce téléphone. La démo reste telle quelle."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր հաշվառումը պահվում է այս հեռախոսում։ Դեմոն մնում է անփոփոխ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati, conservati su questo telefono. La demo rimane invariata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneに保存された自分の帳簿です。デモはそのまま残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი მონაცემები ინახება ამ ტელეფონზე. დემო უცვლელი რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз кітаптарыңыз, осы телефонда сақталады. Демо өз күйінде қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 보관된 내 장부입니다. 데모는 그대로 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептериңиз ушул телефондо сакталат. Демо өзгөрүүсүз калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen administratie, bewaard op deze telefoon. De demo blijft zoals die was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane przechowywane na tym telefonie. Dane demo pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados, mantidos neste celular. A demonstração permanece como estava."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas contas, guardadas neste iPhone. A demonstração permanece inalterada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши настоящие данные, они хранятся на этом телефоне. Демо остаётся как было."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумоти шахсии шумо дар ин телефон нигоҳ дошта мешавад. Маълумоти намоишӣ бетағйир мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda tutulan kendi kayıtlarınız. Demo olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш облік, що зберігається на цьому телефоні. Демонстраційні дані залишаться без змін."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblaringiz shu telefonda saqlanadi. Namuna ma’lumotlar o‘zgarishsiz qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账本保存在此手机上。演示数据保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳本儲存在此手機上。示範資料會保持原樣。"
          }
        }
      }
    },
