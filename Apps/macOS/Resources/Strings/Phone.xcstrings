    "phone.data.realNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашы даныя захоўваюцца на гэтым тэлефоне. Дэма застаецца без змен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigenen Bücher, auf diesem iPhone gespeichert. Die Demo bleibt, wie sie war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own books, kept on this phone. The demo is left as it was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus propias cuentas, guardadas en este teléfono. La demo se queda como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos propres comptes, gardés sur ce téléphone. La démo reste telle quelle."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր հաշվառումը պահվում է այս հեռախոսում։ Դեմոն մնում է անփոփոխ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati, conservati su questo telefono. La demo rimane invariata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз кітаптарыңыз, осы телефонда сақталады. Демо өз күйінде қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептериңиз ушул телефондо сакталат. Демо өзгөрүүсүз калат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane przechowywane na tym telefonie. Dane demo pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados, mantidos neste celular. A demonstração permanece como estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши настоящие данные, они хранятся на этом телефоне. Демо остаётся как было."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумоти шахсии шумо дар ин телефон нигоҳ дошта мешавад. Маълумоти намоишӣ бетағйир мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda tutulan kendi kayıtlarınız. Demo olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш облік, що зберігається на цьому телефоні. Демонстраційні дані залишаться без змін."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblaringiz shu telefonda saqlanadi. Namuna ma’lumotlar o‘zgarishsiz qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳本儲存在此手機上。示範資料會保持原樣。"
          }
        }
      }
    },
