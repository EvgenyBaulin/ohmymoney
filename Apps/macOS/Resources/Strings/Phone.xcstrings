    "phone.folder.demo": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo tətbiqdən kənarda heç nə yazmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дэма нічога не запісвае па-за праграмай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázka neukládá nic mimo aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Demo schreibt nichts außerhalb der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The demo writes nothing outside the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La demo no escribe nada fuera de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La démo n'écrit rien en dehors de l'app."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեմոն հավելվածից դուրս ոչինչ չի պահում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La demo non salva nulla fuori dall’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモではアプリの外に何も書き込まれません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დემო აპის გარეთ არაფერს ინახავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо қолданбадан тыс ештеңе жазбайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데모는 앱 외부에 아무것도 저장하지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо колдонмодон тышкары эч нерсе жазбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De demo schrijft niets buiten de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo nie zapisuje nic poza aplikacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A demonstração não grava nada fora do app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A demonstração não guarda nada fora da app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо ничего не пишет за пределы приложения."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳолати намоишӣ берун аз барнома чизе наменависад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo, uygulama dışına hiçbir şey yazmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демонстрація нічого не записує поза застосунком."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Namuna ma’lumotlar ilovadan tashqariga yozilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示数据不会写入 App 以外的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "示範資料不會寫入 App 以外的位置。"
          }
