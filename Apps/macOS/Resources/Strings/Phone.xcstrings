    "phone.folder.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Maliyyə qeydlərinizin gündəlik nüsxələri orada saxlanılır. Verilənlər bazası isə tətbiqdən kənara çıxmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сюды штодня запісваюцца копіі вашых даных. Сама база даных застаецца ў праграме."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý den se sem ukládají kopie vašich údajů. Samotná databáze nikdy neopustí aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorthin werden tägliche Kopien Ihrer Bücher geschrieben. Die Datenbank selbst verlässt die App nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily copies of your books are written there. The database itself never leaves the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahí se guardan las copias diarias de sus cuentas. La base de datos en sí nunca sale de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies quotidiennes de vos comptes y sont écrites. La base elle-même ne quitte jamais l'app."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այստեղ ամեն օր պահվում են ձեր հաշվառման պատճենները։ Տվյալների բազան մնում է հավելվածում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vengono salvate copie giornaliere dei tuoi dati. Il database rimane sempre nell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "帳簿のコピーが毎日ここに保存されます。データベース自体はアプリ内に残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემების ასლები აქ ყოველდღე ინახება. მონაცემთა ბაზა ყოველთვის აპში რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кітаптарыңыздың күнделікті көшірмелері сонда жазылады. Дерекқордың өзі қолданбадан ешқашан шықпайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 장부 사본이 여기에 저장됩니다. 데이터베이스 자체는 앱 밖으로 나가지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептериңиздин күнүмдүк көчүрмөлөрү ошол жерге сакталат. Маалымат базасы колдонмодон чыкпайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier worden dagelijks kopieën van je administratie bewaard. De database zelf blijft in de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codziennie zapisywane są tam kopie Twoich danych. Sama baza danych pozostaje w aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias diárias dos seus dados são salvas nessa pasta. O banco de dados nunca sai do app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São guardadas cópias diárias das suas contas nesta pasta. A base de dados nunca sai da app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туда пишутся ежедневные копии ваших данных. Сама база никогда не покидает приложение."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нусхаҳои ҳаррӯзаи маълумот дар он ҷо нигоҳ дошта мешаванд. Худи пойгоҳи додаҳо аз барнома берун намеравад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlarınızın günlük kopyaları buraya yazılır. Veritabanının kendisi uygulamadan ayrılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Туди записуються щоденні копії вашого обліку. Сама база даних ніколи не залишає застосунок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblaringizning kundalik nusxalari shu yerga yoziladi. Ma’lumotlar bazasi ilovadan tashqariga chiqarilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账本副本每天都会存入此文件夹。数据库始终保留在 App 内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天會將帳本副本儲存至此處。資料庫本身不會離開 App。"
          }
        }
      }
    },
    "phone.folder.lost": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qovluğu artıq açmaq olmur. Adı dəyişdirilmiş, köçürülmüş və ya silinmiş ola bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку больш нельга адкрыць. Магчыма, яна была перайменавана, перамешчана або выдалена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složku už nelze otevřít. Možná byla přejmenována, přesunuta nebo odstraněna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner lässt sich nicht mehr öffnen. Er wurde vielleicht umbenannt, verschoben oder entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder can no longer be opened. It may have been renamed, moved or removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta ya no se puede abrir. Puede que se haya renombrado, movido o eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier ne peut plus être ouvert. Il a peut-être été renommé, déplacé ou supprimé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պանակն այլևս հնարավոր չէ բացել։ Հնարավոր է՝ այն վերանվանվել, տեղափոխվել կամ հեռացվել է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la cartella. Potrebbe essere stata rinominata, spostata o rimossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを開けなくなりました。名前が変更されたか、移動または削除された可能性があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საქაღალდის გახსნა ვეღარ ხერხდება. შესაძლოა, მას სახელი შეეცვალა, გადაიტანეს ან წაშალეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалтаны енді ашу мүмкін емес. Оның атауы өзгерген, жылжытылған немесе жойылған болуы мүмкін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 폴더를 열 수 없습니다. 이름이 변경되었거나 이동 또는 삭제되었을 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Папканы ачуу мүмкүн болбой калды. Анын аты өзгөртүлгөн, жылдырылган же өчүрүлгөн болушу мүмкүн."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De map kan niet meer worden geopend. Mogelijk is de naam gewijzigd of is de map verplaatst of verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można już otworzyć folderu. Jego nazwa lub położenie mogły się zmienić albo folder został usunięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é mais possível abrir a pasta. Ela pode ter sido renomeada, movida ou removida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não é possível abrir a pasta. Pode ter sido renomeada, movida ou removida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку больше не удаётся открыть. Возможно, её переименовали, перенесли или удалили."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷузвдон дигар кушода намешавад. Шояд номаш иваз, кӯчонда ё нест карда шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör artık açılamıyor. Adı değiştirilmiş, taşınmış veya silinmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка більше не відкривається. Можливо, її перейменовано, переміщено або видалено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jildni ochib bo‘lmaydi. U qayta nomlangan, ko‘chirilgan yoki o‘chirilgan bo‘lishi mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法再打开此文件夹。它可能已被重命名、移动或移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法再開啟此檔案夾。它可能已重新命名、移動或移除。"
          }
        }
      }
    },
