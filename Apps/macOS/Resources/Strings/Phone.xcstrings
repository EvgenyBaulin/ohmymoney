{
  "sourceLanguage": "en",
  "strings": {
    "phone.data.demo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо"
          }
        }
      }
    },
    "phone.data.demoNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made-up history to look around. Nothing you do here touches your real books."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдуманная история, чтобы осмотреться. Ничто здесь не затрагивает ваши настоящие данные."
          }
        }
      }
    },
    "phone.data.real": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои данные"
          }
        }
      }
    },
    "phone.data.realNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own books, kept on this phone. The demo is left as it was."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши настоящие данные, они хранятся на этом телефоне. Демо остаётся как было."
          }
        }
      }
    },
    "phone.data.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные"
          }
        }
      }
    },
    "phone.folder.change": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another folder…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать другую папку…"
          }
        }
      }
    },
    "phone.folder.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose folder…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать папку…"
          }
        }
      }
    },
    "phone.folder.chooseAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder again…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать папку заново…"
          }
        }
      }
    },
    "phone.folder.demo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The demo writes nothing outside the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо ничего не пишет за пределы приложения."
          }
        }
      }
    },
    "phone.folder.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily copies of your books are written there. The database itself never leaves the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туда пишутся ежедневные копии ваших данных. Сама база никогда не покидает приложение."
          }
        }
      }
    },
    "phone.folder.lost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder can no longer be opened. It may have been renamed, moved or removed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку больше не удаётся открыть. Возможно, её переименовали, перенесли или удалили."
          }
        }
      }
    },
    "phone.folder.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No folder chosen. Copies stay inside the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка не выбрана. Копии остаются внутри приложения."
          }
        }
      }
    },
    "phone.folder.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder for copies"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка для копий"
          }
        }
      }
    },
    "phone.lock.after": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock after leaving the app for"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировать после ухода из приложения на"
          }
        }
      }
    },
    "phone.lock.enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock with Face ID or passcode"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировать по Face ID или код-паролю"
          }
        }
      }
    },
    "phone.lock.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was not accepted. Try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не подошло. Попробуйте ещё раз."
          }
        }
      }
    },
    "phone.lock.minutes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minutes"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld минуты"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld минут"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld минуту"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld минуты"
                }
              }
            }
          }
        }
      }
    },
    "phone.lock.reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "unlock your books"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "открыть ваши данные"
          }
        }
      }
    },
    "phone.lock.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no Face ID and no passcode to unlock with."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телефоне нет ни Face ID, ни код-пароля для разблокировки."
          }
        }
      }
    },
    "phone.lock.unlock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать"
          }
        }
      }
    },
    "phone.tab.more": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё"
          }
        }
      }
    }
  },
  "version": "1.0"
}
