    "privacy.copy.originalStays": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy — the original stays with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia — el original se queda con usted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie — l'original reste chez vous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия — оригинал остаётся у вас."
          }
        },
        "uk": {
