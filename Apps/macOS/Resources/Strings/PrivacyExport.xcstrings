    "privacy.journal.footer": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал захоўваецца толькі на гэтым Mac. У ім запісваюцца час і тыпы падзей — без сум, імёнаў і назваў. Ён не трапляе ў копію або архіў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Journal lebt nur auf diesem Mac. Es enthält Zeitpunkte und Arten von Ereignissen — keine Beträge, Namen oder Titel — und es geht weder in eine Kopie noch in ein Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal lives only on this Mac. It holds moments and kinds of events — no amounts, names or titles — and it does not go into a copy or an archive."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал тек осы Mac-та сақталады. Ол уақыт пен оқиға түрлерін сақтайды — сомаларды, аттарды және атауларды емес — және көшірмеге не мұрағатқа кірмейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал лежит только на этом Mac. В нём моменты и виды событий: ни сумм, ни имён, ни названий. В копию и в архив он не попадает."
          }
        }
      }
    },
