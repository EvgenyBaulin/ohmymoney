{
  "sourceLanguage": "en",
  "strings": {
    "privacy.copy.anonymize": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ананімізаваць"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymize"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасыру"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обезличить"
          }
        }
      }
    },
    "privacy.copy.anonymize.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апісанні, каментарыі, месцы і назвы выдаляюцца з копіі. Сумы, даты і катэгорыі застаюцца. Арыгінал не змяняецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibungen, Kommentare, Orte und Namen werden in der Kopie gelöscht. Beträge, Daten und Kategorien bleiben. Das Original ändert sich nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descriptions, comments, places and names are erased in the copy. Amounts, dates and categories stay. The original does not change."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірмеде сипаттамалар, пікірлер, орындар және аттар өшіріледі. Сомалар, күндер және санаттар қалады. Түпнұсқа өзгермейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В копии стираются описания, комментарии, места и имена. Суммы, даты и категории остаются. Оригинал не меняется."
          }
        }
      }
    },
    "privacy.copy.attachments": {
      "extractionState": "manual",
      "localizations": {
