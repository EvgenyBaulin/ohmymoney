    "privacy.copy.anonymize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymize"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimizar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymiser"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обезличить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знеособити"
          }
        }
      }
    },
    "privacy.copy.anonymize.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descriptions, comments, places and names are erased in the copy. Amounts, dates and categories stay. The original does not change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la copia se borran descripciones, comentarios, lugares y nombres. Los importes, las fechas y las categorías se quedan. El original no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les descriptions, commentaires, lieux et noms sont effacés dans la copie. Les montants, dates et catégories restent. L'original ne change pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В копии стираются описания, комментарии, места и имена. Суммы, даты и категории остаются. Оригинал не меняется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Описи, коментарі, місця й імена в копії стираються. Суми, дати й категорії лишаються. Оригінал не змінюється."
          }
        }
      }
    },
