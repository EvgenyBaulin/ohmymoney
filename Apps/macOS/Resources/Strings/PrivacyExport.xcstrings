    "privacy.copy.anonymize": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymize"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обезличить"
          }
        }
      }
    },
    "privacy.copy.anonymize.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibungen, Kommentare, Orte und Namen werden in der Kopie gelöscht. Beträge, Daten und Kategorien bleiben. Das Original ändert sich nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descriptions, comments, places and names are erased in the copy. Amounts, dates and categories stay. The original does not change."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В копии стираются описания, комментарии, места и имена. Суммы, даты и категории остаются. Оригинал не меняется."
          }
        }
      }
    },
    "privacy.copy.attachments": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge einschließen (%@)"
