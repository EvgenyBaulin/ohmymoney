    "privacy.copy.passwordHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy is locked with this password. Nobody can open it without it, and it cannot be recovered. The original stays with you, unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia se bloquea con esta contraseña. Nadie puede abrirla sin ella, y no se puede recuperar. El original se queda con usted, sin cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie est verrouillée par ce mot de passe. Personne ne peut l'ouvrir sans lui, et il ne peut pas être récupéré. L'original reste chez vous, inchangé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия закрыта этим паролем. Без него её не откроет никто, и восстановить пароль нельзя. Оригинал остаётся у вас без изменений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію заблоковано цим паролем. Без нього її не відкриє ніхто, і відновити його неможливо. Оригінал лишається у вас, без змін."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірме осы құписөзбен құлыпталады. Онсыз ешкім аша алмайды, және оны қалпына келтіру мүмкін емес. Түпнұсқа өзгеріссіз сізде қалады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія абаронена гэтым паролем. Без яго ніхто не зможа яе адкрыць, а аднавіць пароль немагчыма. Арыгінал застаецца ў вас без змен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie ist mit diesem Passwort gesperrt. Ohne es kann sie niemand öffnen, und sie lässt sich nicht wiederherstellen. Das Original bleibt bei Ihnen, unverändert."
          }
        }
      }
    },
