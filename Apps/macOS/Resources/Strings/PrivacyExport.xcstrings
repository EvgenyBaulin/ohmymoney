    "privacy.copy.error.anonymizerMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymizing is not available in this build, so the copy was not made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La anonimización no está disponible en esta compilación, así que la copia no se hizo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anonymisation n'est pas disponible dans cette version, donc la copie n'a pas été faite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обезличивание в этой сборке недоступно, поэтому копия не сделана."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знеособлення в цій збірці недоступне, тож копію не створено."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл құрастырымда жасыру жоқ, сондықтан көшірме жасалмады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ананімізацыя недаступная ў гэтай версіі, таму копія не створана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymisieren ist in diesem Build nicht verfügbar, daher wurde die Kopie nicht erstellt."
          }
        }
      }
    },
    "privacy.copy.error.hiddenInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden account is still used by something the copy keeps, so it cannot be left out. Include hidden accounts, or show the account again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta oculta todavía la usa algo que la copia conserva, así que no se puede dejar fuera. Incluya las cuentas ocultas, o vuelva a mostrar la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte masqué est encore utilisé par quelque chose que la copie garde, donc il ne peut pas être laissé de côté. Incluez les comptes masqués, ou réaffichez le compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытый счёт нужен тому, что остаётся в копии, и его нельзя убрать. Включите скрытые или верните счёт на экран."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прихований рахунок ще використовується тим, що копія зберігає, тож його не можна пропустити. Включіть приховані рахунки або зробіть рахунок знову видимим."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасырын есеп-шотты көшірме сақтайтын бір нәрсе әлі пайдаланады, сондықтан оны шығаруға болмайды. Жасырын есеп-шоттарды қосыңыз немесе есеп-шотты қайта көрсетіңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Схаваны рахунак усё яшчэ выкарыстоўваецца ў даных, якія застаюцца ў копіі, таму яго нельга выключыць. Уключыце схаваныя рахункі або зноў пакажыце гэты рахунак."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgeblendetes Konto wird noch von etwas genutzt, das die Kopie behält, daher kann es nicht weggelassen werden. Schließen Sie ausgeblendete Konten ein oder zeigen Sie das Konto wieder an."
          }
        }
      }
    },
    "privacy.copy.error.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy was not made. Nothing was changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia no se hizo. No se cambió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie n'a pas été faite. Rien n'a été modifié."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия не сделана. Ничего не изменилось."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію не створено. Нічого не змінено."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірме жасалмады. Ештеңе өзгерген жоқ."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія не створана. Нічога не змянілася."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie wurde nicht erstellt. Nichts wurde verändert."
          }
        }
      }
    },
    "privacy.copy.error.passwordMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a password: a copy without one is not made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba una contraseña: no se hace una copia sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un mot de passe : une copie sans mot de passe n'est pas faite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль: копия без пароля не делается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть пароль: копію без пароля не створюємо."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құписөз енгізіңіз: құписөзсіз көшірме жасалмайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце пароль: без яго копія не ствараецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie ein Passwort ein: Eine Kopie ohne Passwort wird nicht erstellt."
          }
        }
      }
    },
    "privacy.copy.error.periodEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The period is empty: the end is before the start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El periodo está vacío: el final es anterior al inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La période est vide : la fin est avant le début."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Период пуст: конец раньше начала."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Період порожній: кінець раніше за початок."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кезең бос: аяқталуы басталуынан бұрын."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перыяд пусты: канец ранейшы за пачатак."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeitraum ist leer: Das Ende liegt vor dem Anfang."
          }
        }
      }
    },
