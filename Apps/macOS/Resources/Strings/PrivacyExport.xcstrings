    "privacy.storage.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only counts and sizes are shown here. Nothing is sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo se muestran recuentos y tamaños. Nada se envía a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les compteurs et les tailles sont affichés ici. Rien n'est envoyé nulle part."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь только числа и размеры. Ничего никуда не отправляется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут показано лише лічильники та розміри. Нікуди нічого не надсилається."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда тек санаулар мен өлшемдер көрсетіледі. Ештеңе ешқайда жіберілмейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут паказаны толькі колькасць і памеры. Нічога нікуды не адпраўляецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden nur Anzahlen und Größen gezeigt. Nichts wird irgendwohin gesendet."
          }
        }
      }
    },
