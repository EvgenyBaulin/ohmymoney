        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожнаму, хто адкрывае файл, спатрэбіцца гэты пароль. Аднавіць яго немагчыма."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer die Datei öffnet, braucht dieses Passwort. Es lässt sich nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever opens the file needs this password. It cannot be recovered."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлды ашатын адамға осы құписөз керек. Оны қалпына келтіру мүмкін емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы открыть файл, нужен этот пароль. Восстановить его нельзя."
          }
        }
      }
    },
