    "privacy.lockedFile.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever opens the file needs this password. It cannot be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien abra el archivo necesita esta contraseña. No se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiconque ouvre le fichier a besoin de ce mot de passe. Il ne peut pas être récupéré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы открыть файл, нужен этот пароль. Восстановить его нельзя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для відкриття файлу потрібен цей пароль. Відновити його неможливо."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлды ашатын адамға осы құписөз керек. Оны қалпына келтіру мүмкін емес."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожнаму, хто адкрывае файл, спатрэбіцца гэты пароль. Аднавіць яго немагчыма."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer die Datei öffnet, braucht dieses Passwort. Es lässt sich nicht wiederherstellen."
          }
        }
      }
    },
