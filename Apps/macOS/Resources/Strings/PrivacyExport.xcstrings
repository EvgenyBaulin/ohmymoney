    "privacy.demo.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app restarts on made-up data. Your own database is not touched, and one button brings you back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se reinicia con datos inventados. Su base de datos propia no se toca, y un botón le devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app redémarre sur des données fictives. Votre propre base n'est pas touchée, et un bouton vous ramène."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение перезапустится на выдуманных данных. Ваша база не трогается, вернуться можно одной кнопкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок перезапуститься на вигаданих даних. Вашу базу не зачіпає, а одна кнопка поверне вас назад."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба ойдан шығарылған деректермен қайта іске қосылады. Сіздің дерекқорыңызға тиілмейді, ал бір түйме сізді қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма перазапусціцца з выдуманымі данымі. Ваша база даных застанецца некранутай, і вы зможаце вярнуцца адной кнопкай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App startet mit erfundenen Daten neu. Ihre eigene Datenbank wird nicht angerührt, und ein Knopf bringt Sie zurück."
          }
        }
      }
    },
