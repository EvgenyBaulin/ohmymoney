    "privacy.settings.autoHide.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also while the screen is mirrored or shared in a call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También mientras la pantalla se duplica o se comparte en una llamada."
          }
        },
        "fr": {
          "stringUnit": {
