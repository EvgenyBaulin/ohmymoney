    "privacy.journal.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal lives only on this Mac. It holds moments and kinds of events — no amounts, names or titles — and it does not go into a copy or an archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diario vive solo en este Mac. Guarda momentos y tipos de eventos — sin importes, nombres ni títulos — y no entra en ninguna copia ni archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal ne vit que sur ce Mac. Il contient des moments et des types d'événements — ni montants, ni noms, ni titres — et il n'entre ni dans une copie ni dans une archive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал лежит только на этом Mac. В нём моменты и виды событий: ни сумм, ни имён, ни названий. В копию и в архив он не попадает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал зберігається лише на цьому Mac. Він містить моменти й види подій — без сум, імен і назв — і не потрапляє до копії чи архіву."
          }
        }
      }
    },
