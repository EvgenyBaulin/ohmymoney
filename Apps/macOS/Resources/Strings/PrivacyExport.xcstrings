    "privacy.settings.knows.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal and the counts are shown here only; they are not sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diario y los recuentos solo se muestran aquí; no se envían a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal et les compteurs ne sont affichés qu'ici ; ils ne sont envoyés nulle part."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал и числа только показаны здесь и никуда не отправляются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал і лічильники показано тут лише для перегляду; нікуди не надсилаються."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал мен санаулар тек осында көрсетіледі; оларды ешқайда жібермейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал і лічбы паказваюцца толькі тут і нікуды не адпраўляюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Journal und die Zählungen werden hier nur angezeigt; sie werden nirgendwohin gesendet."
          }
        }
      }
