    "privacy.copy.hidden.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Інакш у копіі не будзе схаваных рахункаў, іх аперацый і пераводаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne dies hat die Kopie keine ausgeblendeten Konten und keinen ihrer Vorgänge oder Überweisungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it the copy has no hidden accounts, and none of their operations or transfers."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол болмаса, көшірмеде жасырын есеп-шоттар және олардың операциялары мен аударымдары болмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без галочки в копии нет скрытых счетов, их операций и переводов."
          }
        }
      }
    },
    "privacy.copy.hidden.warning": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія будзе змяшчаць схаваныя рахункі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie enthält ausgeblendete Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy will include hidden accounts."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірмеге жасырын есеп-шоттар кіреді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В копию войдут скрытые счета."
          }
        }
      }
    },
    "privacy.copy.leftOut": {
      "extractionState": "manual",
      "localizations": {
