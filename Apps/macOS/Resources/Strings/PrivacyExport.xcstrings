          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія включатиме приховані рахунки."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірмеге жасырын есеп-шоттар кіреді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія будзе змяшчаць схаваныя рахункі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie enthält ausgeblendete Konten."
          }
        }
      }
    },
