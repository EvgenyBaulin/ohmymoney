    "privacy.settings.hand.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy is locked with a password; the original stays unchanged. Training data are made-up numbers, and your own database is not opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia se bloquea con contraseña; el original no cambia. Los datos de entrenamiento son cifras inventadas, y su base de datos propia no se abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie est verrouillée par un mot de passe ; l'original reste inchangé. Les données d'entraînement sont des chiffres inventés, et votre propre base n'est pas ouverte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия закрыта паролем, оригинал не меняется. Учебные данные — выдуманные цифры, ваша база не открывается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія заблокована паролем; оригінал лишається без змін. Навчальні дані — вигадані цифри, а ваша власна база не відкривається."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірме құписөзбен құлыпталады; түпнұсқа өзгеріссіз қалады. Оқу деректері — ойдан шығарылған сандар, сіздің дерекқорыңыз ашылмайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія абаронена паролем; арыгінал застаецца без змен. Навучальныя даныя выдуманыя, а ваша база даных не адкрываецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie wird mit einem Passwort gesperrt; das Original bleibt unverändert. Übungsdaten sind erfundene Zahlen, und Ihre eigene Datenbank wird nicht geöffnet."
          }
        }
      }
    },
