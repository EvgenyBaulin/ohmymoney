    "privacy.copy.error.anonymizerMissing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymisieren ist in diesem Build nicht verfügbar, daher wurde die Kopie nicht erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymizing is not available in this build, so the copy was not made."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обезличивание в этой сборке недоступно, поэтому копия не сделана."
          }
        }
      }
    },
    "privacy.copy.error.hiddenInUse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgeblendetes Konto wird noch von etwas genutzt, das die Kopie behält, daher kann es nicht weggelassen werden. Schließen Sie ausgeblendete Konten ein oder zeigen Sie das Konto wieder an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden account is still used by something the copy keeps, so it cannot be left out. Include hidden accounts, or show the account again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытый счёт нужен тому, что остаётся в копии, и его нельзя убрать. Включите скрытые или верните счёт на экран."
          }
        }
      }
    },
    "privacy.copy.error.other": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie wurde nicht erstellt. Nichts wurde verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy was not made. Nothing was changed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия не сделана. Ничего не изменилось."
          }
        }
      }
    },
