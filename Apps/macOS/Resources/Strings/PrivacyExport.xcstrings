    "privacy.copy.hidden.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it the copy has no hidden accounts, and none of their operations or transfers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ello, la copia no tiene cuentas ocultas, ni sus operaciones ni transferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cela, la copie n'a aucun compte masqué, ni aucune de leurs opérations ou virements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без галочки в копии нет скрытых счетов, их операций и переводов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без них у копії немає прихованих рахунків і жодної їхньої операції чи переказу."
          }
        }
      }
    },
