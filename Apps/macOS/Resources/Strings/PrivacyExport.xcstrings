    "privacy.copy.anonymize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymize"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обезличить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знеособити"
          }
        }
      }
    },
    "privacy.copy.anonymize.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descriptions, comments, places and names are erased in the copy. Amounts, dates and categories stay. The original does not change."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В копии стираются описания, комментарии, места и имена. Суммы, даты и категории остаются. Оригинал не меняется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Описи, коментарі, місця й імена в копії стираються. Суми, дати й категорії лишаються. Оригінал не змінюється."
          }
        }
      }
    },
    "privacy.copy.attachments": {
