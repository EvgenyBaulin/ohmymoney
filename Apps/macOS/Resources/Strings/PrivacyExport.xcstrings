    "privacy.copy.hidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include hidden accounts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir cuentas ocultas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure les comptes masqués"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включая скрытые"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Включити приховані рахунки"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасырын есеп-шоттарды қосу"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыць схаваныя рахункі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Konten einschließen"
          }
        }
      }
    },
    "privacy.copy.hidden.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it the copy has no hidden accounts, and none of their operations or transfers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ello, la copia no tiene cuentas ocultas, ni sus operaciones ni transferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cela, la copie n'a aucun compte masqué, ni aucune de leurs opérations ou virements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без галочки в копии нет скрытых счетов, их операций и переводов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без них у копії немає прихованих рахунків і жодної їхньої операції чи переказу."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол болмаса, көшірмеде жасырын есеп-шоттар және олардың операциялары мен аударымдары болмайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Інакш у копіі не будзе схаваных рахункаў, іх аперацый і пераводаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne dies hat die Kopie keine ausgeblendeten Konten und keinen ihrer Vorgänge oder Überweisungen."
          }
        }
      }
    },
    "privacy.copy.hidden.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy will include hidden accounts."
          }
        },
        "es": {
