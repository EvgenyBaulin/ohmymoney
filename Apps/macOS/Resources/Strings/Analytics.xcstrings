    "analytics.anomaly.writeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save this. The list stays as it was — try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar. La lista sigue igual: inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer. La liste reste telle quelle — réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить. Список остался прежним — попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти. Список лишився як був — спробуйте ще раз."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare. L’elenco non è cambiato. Riprova."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұны сақтау мүмкін болмады. Тізім бұрынғыдай қалады — қайталап көріңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося захаваць. Спіс не змяніўся — паспрабуйце зноў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte nicht gespeichert werden. Die Liste bleibt, wie sie war — versuchen Sie es erneut."
          }
        }
      }
    },
