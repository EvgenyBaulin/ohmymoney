        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U výdajů v tomto období není uvedena žádná osoba — všechny jsou vaše"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Zeitraum nennt keine Ausgabe eine Person — alles sind Ihre eigenen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No spending in this period names a person — it is all your own"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún gasto de este periodo menciona a una persona: todo es suyo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune dépense de cette période ne concerne une personne — tout est pour vous"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ժամանակահատվածի ծախսերում անձ նշված չէ․ բոլորը ձեր ծախսերն են"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna spesa di questo periodo è associata a una persona: sono tutte tue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間の支出に相手の指定はありません。すべて自分の支出です"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ პერიოდის ხარჯებში პირი არ არის მითითებული — ყველა ხარჯი თქვენია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кезеңдегі шығыста адам аталмаған — бәрі өз шығысыңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간에 다른 사람을 위해 지출한 금액이 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул мезгилдеги чыгымдарда башка адам көрсөтүлгөн эмес — баары өзүңүз үчүн"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen personen vermeld bij uitgaven in deze periode. Alles is voor jezelf"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do wydatków w tym okresie nie przypisano osób — wszystkie są Twoje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum gasto neste período está associado a outra pessoa — todos são seus"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum gasto neste período tem uma pessoa associada — são todos seus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом периоде нет трат с человеком — все траты ваши"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар хароҷоти ин давра шахсе зикр нашудааст — ҳамааш барои худатон аст"
