    "analytics.cashback.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected cashback is not income, received cashback is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cashback previsto no es ingreso; el cashback recibido sí lo es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback attendu n'est pas un revenu, le cashback reçu en est un."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемый кэшбэк — не доход, полученный — доход."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний кешбек — це не дохід, отриманий кешбек — дохід."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cashback previsto non è un’entrata; quello ricevuto sì."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтілетін кешбэк — табыс емес, алынған кешбэк — табыс."
