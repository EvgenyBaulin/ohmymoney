    "analytics.cashback.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözlənilən keşbek gəlir sayılmır, alınan keşbek isə sayılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканы кэшбэк не з'яўляецца даходам, атрыманы — з'яўляецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Očekávaný cashback není příjmem, přijatý cashback ano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwarteter Cashback ist keine Einnahme, erhaltener Cashback schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected cashback is not income, received cashback is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cashback previsto no es ingreso; el cashback recibido sí lo es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback attendu n'est pas un revenu, le cashback reçu en est un."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասվող քեշբեքը եկամուտ չէ, ստացվածը՝ եկամուտ է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cashback previsto non è un’entrata; quello ricevuto sì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュバックは、受取予定額ではなく受取額が収入に含まれます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოსალოდნელი ქეშბექი შემოსავალი არ არის, მიღებული კი — არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтілетін кешбэк — табыс емес, алынған кешбэк — табыс."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 캐시백은 수입에 포함되지 않으며, 받은 캐시백은 포함됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтүлгөн кэшбэк кирешеге кирбейт, алынган кэшбэк кирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwachte cashback is geen inkomen, ontvangen cashback wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwany zwrot nie jest przychodem, otrzymany — jest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback previsto não é receita. O recebido é."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback previsto não é rendimento; o cashback recebido é."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемый кэшбэк — не доход, полученный — доход."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбеки интизорӣ даромад нест, кэшбеки гирифташуда даромад аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenen para iadesi gelir sayılmaz, alınan para iadesi sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний кешбек — це не дохід, отриманий кешбек — дохід."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutilayotgan keshbek daromad emas, olingan keshbek esa daromad hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计返现不计入收入，已到账返现计入收入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預計回饋不計入收入，已收回饋則計入收入。"
          }
        }
      }
    },
