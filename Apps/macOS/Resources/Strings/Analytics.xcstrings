    "analytics.basis.modelQuality": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Öz tarixçəniz əsasında ölçülür: model öyrənməzdən əvvəl yoxlanılır və proqnoz yalnız keçmiş bir günün məlumatlarına əsaslanır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вымерана на вашай гісторыі: мадэль спачатку адказвае, потым вучыцца, а прагноз будуецца толькі з мінулага дня"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měřeno na vaší historii: model odpovídá před učením a prognóza vychází pouze z údajů dostupných k danému dni"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemessen an Ihrem eigenen Verlauf: Das Modell wird vor dem Lernen befragt, und die Prognose entsteht nur aus einem vergangenen Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured on your own history: the model is asked before it learns, and the forecast is made from a past day only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido sobre su propio historial: el modelo se consulta antes de aprender, y la previsión se hace solo desde un día pasado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré sur votre propre historique : le modèle est interrogé avant d'apprendre, et la prévision n'est faite qu'à partir d'un jour passé"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չափված է ձեր պատմության հիման վրա․ մոդելը հարցվում է սովորելուց առաջ, իսկ կանխատեսումը կազմվում է միայն անցյալ օրվա տվյալներից"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurata sulla tua cronologia: il modello viene interrogato prima di apprendere e la previsione usa solo i dati disponibili a una data passata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の履歴で測定: モデルは学習前に評価し、予測は過去のある時点の情報のみで作成"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეფასებულია თქვენი ისტორიით: მოდელი ფასდება სწავლებამდე, პროგნოზი კი მხოლოდ წარსული დღის მონაცემებით კეთდება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз тарихыңызда өлшенген: модель үйренбестен бұрын сұралады, болжам тек өткен күннен жасалады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 내역으로 측정: 모델이 학습하기 전에 결과를 확인하고, 과거 시점의 정보만으로 예측합니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз тарыхыңыз боюнча өлчөнөт: модель үйрөнө электе текшерилет, божомол өткөн күндүн маалыматы боюнча гана түзүлөт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeten op basis van je eigen geschiedenis: het model wordt getest voordat het leert en de prognose gebruikt alleen gegevens tot een dag in het verleden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie Twojej historii: model jest sprawdzany przed uczeniem, a prognoza powstaje wyłącznie na podstawie danych dostępnych w wybranym dniu z przeszłości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido no seu histórico: o modelo é consultado antes de aprender, e a previsão usa apenas dados disponíveis até uma data passada"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido com base no seu histórico: o modelo é testado antes de aprender e a previsão é feita a partir de um dia passado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерено на вашей истории: модель спрашивают до того, как она выучит, а прогноз делают только по прошлому дню"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз рӯйи таърихи худи шумо санҷида шудааст: модел пеш аз омӯзиш санҷида мешавад ва пешгӯӣ танҳо аз маълумоти то рӯзи гузашта тартиб дода мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi geçmişinizle ölçülür: modele öğrenmeden önce sorulur ve tahmin yalnızca geçmiş bir günden yapılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виміряно за вашою власною історією: модель запитується до навчання, а прогноз робиться лише з минулого дня"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaxsiy tarixingiz asosida o‘lchanadi: modeldan o‘rganishidan oldin so‘raladi, prognoz esa faqat o‘tgan kundagi ma’lumotlardan tuziladi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的历史记录评估：模型在学习前接受测试，预测仅使用过去某一天之前的数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依你的歷史紀錄評估：在模型學習前測試，並僅使用過去某一天的資料進行預測"
          }
        }
      }
    },
