        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканы кэшбэк не з'яўляецца даходам, атрыманы — з'яўляецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwarteter Cashback ist keine Einnahme, erhaltener Cashback schon."
          }
        }
      }
    },
