    "analytics.forWhom.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kimin üçün” yalnız analitikanın bir bölgüsüdür: xərclərimi azaltmır. Adları Parametrlərdə dəyişə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "“Для каго” — толькі разрэз аналітыкі: мае выдаткі не памяншаюцца. Назвы змяняюцца ў Наладах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Pro koho“ je pouze pohled na analytiku: nesnižuje moje výdaje. Štítky můžete přejmenovat v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Für wen“ ist nur ein Schnitt der Auswertung: Es verringert meine Ausgaben nicht. Die Bezeichnungen benennen Sie in den Einstellungen um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“For whom” is only a cut of the analytics: it does not reduce my spending. The labels are renamed in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Para quién» es solo un corte de la analítica: no reduce mi gasto. Las etiquetas se renombran en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Pour qui » n'est qu'un découpage de l'analyse : cela ne réduit pas mes dépenses. Les libellés se renomment dans Réglages."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ում համար” դաշտը վերլուծության բաժանում է և չի նվազեցնում իմ ծախսերը։ Անվանումները փոխվում են Կարգավորումներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Per chi” è solo un criterio di analisi: non riduce le mie spese. Puoi rinominare le etichette in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「誰のため」は分析用の分類で、自分の支出は減りません。ラベルは「設定」で変更できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "„ვისთვის“ მხოლოდ ანალიტიკის ჭრილია: ის ჩემს ხარჯებს არ ამცირებს. სახელები იცვლება პარამეტრებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“Кім үшін” — тек аналитиканың бір кесіндісі: ол менің шығысымды азайтпайды. Белгілерді «Параметрлерде» атын өзгертуге болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“누구를 위해”는 분석을 위한 분류일 뿐 내 지출을 줄이지 않습니다. 설정에서 이름을 변경할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ким үчүн» — аналитикадагы бөлүштүрүү гана: ал менин чыгымдарымды азайтпайт. Аталыштарды Жөндөөлөрдөн өзгөртсө болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Voor wie’ is alleen een uitsplitsing van de analyse en verlaagt je uitgaven niet. Je kunt de labels wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dla kogo” to tylko podział w analizie — nie zmniejsza moich wydatków. Nazwy można zmienić w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Para quem” é apenas um recorte da análise: não reduz meus gastos. Altere os nomes em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Para quem» é apenas uma forma de analisar os dados: não reduz as minhas despesas. Os nomes podem ser alterados nas Definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Для кого» — только разрез аналитики: мой расход он не уменьшает. Подписи переименовываются в настройках."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«Барои кӣ» танҳо як намуди таҳлил аст: он хароҷоти маро кам намекунад. Номи барчаспҳоро дар Танзимот иваз кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kimin için” yalnızca analizlerde kullanılan bir kırılımdır; harcamalarımı azaltmaz. Etiketlerin adları Ayarlar'dan değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Для кого» — лише розріз аналітики: воно не зменшує моїх витрат. Назви змінюються в «Налаштуваннях»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kim uchun” faqat tahlil kesimi bo‘lib, xarajatlaringizni kamaytirmaydi. Nomlarni Sozlamalarda o‘zgartirish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“为谁”仅用于分析，不会减少我的支出。可在“设置”中重命名标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「為誰支付」僅用於分析，不會減少我的支出。可在「設定」中重新命名標籤。"
          }
        }
      }
    },
