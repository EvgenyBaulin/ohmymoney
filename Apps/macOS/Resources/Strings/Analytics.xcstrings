    "analytics.reason.noPeople": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dövrdə xərclərdə heç bir şəxs göstərilməyib — hamısı sizə aiddir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У выдатках гэтага перыяду не пазначаны людзі — усе яны вашы"
