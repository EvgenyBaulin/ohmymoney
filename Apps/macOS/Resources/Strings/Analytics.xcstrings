    "analytics.reason.modelNotReady": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Model hələ nəticə vermir: 50 etiketlənmiş əməliyyat və hər kateqoriyada 5 əməliyyat lazımdır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мадэль яшчэ не дае парад: патрэбныя пяцьдзясят размечаных аперацый і пяць у катэгорыі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model zatím nemá dost dat: potřebuje padesát označených operací a pět v jedné kategorii"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell sagt noch nichts: Es braucht fünfzig beschriftete Vorgänge und fünf in einer Kategorie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model is not saying anything yet: it needs fifty labelled operations and five in a category"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo todavía no dice nada: necesita cincuenta operaciones etiquetadas y cinco en una categoría"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle ne dit encore rien : il lui faut cinquante opérations étiquetées et cinq dans une catégorie"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մոդելը դեռ առաջարկներ չունի․ անհրաժեշտ է 50 նշված գործառնություն և 5-ը՝ մեկ կատեգորիայում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non ha ancora suggerimenti: servono 50 operazioni etichettate e 5 in una categoria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを利用するには、ラベル付きの取引が50件、各カテゴリに5件必要です"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოდელს ჯერ პასუხი არ აქვს: საჭიროა ორმოცდაათი მონიშნული ოპერაცია და ხუთი თითო კატეგორიაში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель әлі ештеңе айтпайды: оған елу белгіленген операция және санатта бесеу керек"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 모델을 사용할 수 없습니다. 레이블이 지정된 거래 50건과 카테고리당 5건이 필요합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель азырынча жооп бере албайт: 50 белгиленген операция жана бир категорияда бешөө керек"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model kan nog niets voorspellen: het heeft vijftig gelabelde transacties nodig, waarvan vijf in één categorie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model nie ma jeszcze sugestii: potrzebuje 50 oznaczonych operacji i 5 w kategorii"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo ainda não tem resultados: são necessárias 50 operações classificadas e 5 em uma categoria"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo ainda não tem resultados: precisa de 50 operações classificadas e cinco numa categoria"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель пока молчит: нужно пятьдесят размеченных операций и пять в категории"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Модел ҳоло чизе намегӯяд: 50 амалиёти нишонадор ва 5 амалиёт дар як категория лозим аст"
          }
        },
        "tr": {
          "stringUnit": {
