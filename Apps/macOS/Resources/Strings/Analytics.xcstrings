    "analytics.forWhom.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“For whom” is only a cut of the analytics: it does not reduce my spending. The labels are renamed in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Para quién» es solo un corte de la analítica: no reduce mi gasto. Las etiquetas se renombran en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Pour qui » n'est qu'un découpage de l'analyse : cela ne réduit pas mes dépenses. Les libellés se renomment dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Для кого» — только разрез аналитики: мой расход он не уменьшает. Подписи переименовываются в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Для кого» — лише розріз аналітики: воно не зменшує моїх витрат. Назви змінюються в «Налаштуваннях»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Per chi” è solo un criterio di analisi: non riduce le mie spese. Puoi rinominare le etichette in Impostazioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“Кім үшін” — тек аналитиканың бір кесіндісі: ол менің шығысымды азайтпайды. Белгілерді «Параметрлерде» атын өзгертуге болады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "“Для каго” — толькі разрэз аналітыкі: мае выдаткі не памяншаюцца. Назвы змяняюцца ў Наладах."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Für wen“ ist nur ein Schnitt der Auswertung: Es verringert meine Ausgaben nicht. Die Bezeichnungen benennen Sie in den Einstellungen um."
          }
        }
      }
    },
