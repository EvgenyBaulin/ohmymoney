    "analytics.basis.turnover": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "dövriyyə: çeklərin tam məbləği − geri qaytarmalar, alış gününə görə; gözlənilən keşbek hesabların qaydalarına, alınan keşbek aid olduğu aya görə"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "абарот: поўныя чэкі мінус вяртанні, па дні пакупкі; чаканы кэшбэк па правілах рахункаў, атрыманы па месяцы прызначэння"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "obrat: celé účtenky po odečtení vratek podle dne nákupu; očekávaný cashback podle pravidel účtů, přijatý podle měsíce, ke kterému patří"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umsatz: ganze Belege abzüglich Rückgaben, nach dem Tag des Kaufs; erwarteter Cashback nach den Regeln der Konten, erhalten nach dem Monat, für den er ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "turnover: whole receipts minus refunds, by the day of purchase; expected cashback by the rules of the accounts, received by the month it is for"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "facturación: tickets completos menos devoluciones, por el día de compra; cashback previsto según las reglas de las cuentas, recibido por el mes al que corresponde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "chiffre d'affaires : tickets complets moins remboursements, par jour d'achat ; cashback attendu selon les règles des comptes, reçu par mois auquel il se rapporte"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "շրջանառություն՝ ամբողջական կտրոնները՝ հանած վերադարձները, ըստ գնման օրվա․ սպասվող քեշբեքը՝ ըստ հաշիվների կանոնների, ստացվածը՝ ըստ վերաբերող ամսվա"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "transato: importo totale degli acquisti meno i rimborsi, per data di acquisto; cashback previsto secondo le regole dei conti, ricevuto per mese di competenza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引額: 購入総額から返金を差し引いた額、購入日別。予定キャッシュバックは口座のルールに基づき、受取額は対象月別"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბრუნვა: ქვითრების სრული თანხა დაბრუნებების გამოკლებით, შესყიდვის დღის მიხედვით; მოსალოდნელი ქეშბექი ანგარიშების წესებით, მიღებული — კუთვნილი თვის მიხედვით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "айналым: сатып алу күні бойынша толық чектер минус қайтарулар; күтілетін кешбэк — есеп-шоттың ережелері бойынша, алынғаны — ол арналған ай бойынша"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래액: 구매일 기준 영수증 전체 금액에서 환불액을 뺀 금액; 예상 캐시백은 계좌별 규칙 기준, 받은 캐시백은 해당 월 기준"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "жүгүртүү: чектердин толук суммасынан кайтарууларды алып салгандан кийин, сатып алуу күнү боюнча; күтүлгөн кэшбэк эсептердин эрежелери боюнча, алынганы тиешелүү ай боюнча"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "omzet: volledige bonbedragen min terugbetalingen, op aankoopdatum; verwachte cashback volgens de regels van de rekeningen, ontvangen per maand waarop de cashback betrekking heeft"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "obrót: pełne kwoty paragonów minus zwroty, według daty zakupu; oczekiwany cashback według zasad kont, otrzymany według miesiąca, którego dotyczy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "movimentação: compras integrais menos reembolsos, pelo dia da compra; cashback esperado pelas regras das contas, recebido pelo mês a que se refere"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "volume: total dos recibos menos reembolsos, pelo dia da compra; cashback previsto pelas regras das contas, recebido pelo mês a que se refere"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "оборот: чеки целиком минус возвраты, по дню покупки; ожидаемый кэшбэк — по правилам счетов, полученный — по месяцу отнесения"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "гардиш: маблағи пурраи чекҳо бо тарҳи баргардонҳо, аз рӯйи рӯзи харид; кешбэки интизоршуда аз рӯйи қоидаҳои ҳисобҳо, гирифташуда аз рӯйи моҳе, ки ба он тааллуқ дорад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "işlem hacmi: satın alma gününe göre fiş toplamlarından iadeler çıkarılır; beklenen para iadesi hesap kurallarına, alınan para iadesi ilgili olduğu aya göre"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "оборот: цілі чеки без повернень за днем покупки; очікуваний кешбек за правилами рахунків, отриманий — за місяцем, для якого він"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "aylanma: to‘liq cheklar minus qaytarilgan summalar, xarid kuni bo‘yicha; kutilgan keshbek hisoblar qoidalari bo‘yicha, olingani tegishli oy bo‘yicha"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易额：小票总额减去退款，按购买日期计算；预计返现按账户规则计算，已收返现按所属月份计算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "消費總額：購物總額減去退款，依購買日期計算；預計回饋依帳戶規則計算，已收回饋依所屬月份計算"
          }
        }
      }
    },
