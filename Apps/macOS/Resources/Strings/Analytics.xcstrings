            "value": "Dönem şu ana kadar yalnızca bir gün içeriyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У періоді поки лише один день"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Davr hozircha bir kundan iborat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此时段目前仅有一天"
          }
