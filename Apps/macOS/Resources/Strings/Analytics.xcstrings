    "analytics.reason.oneMonth": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Meyil üçün ən azı iki ay lazımdır: il və ya 12 ay seçin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для тэндэнцыі патрэбны хаця б два месяцы: выберыце год ці 12 месяцаў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro trend jsou potřeba alespoň dva měsíce: vyberte rok nebo 12 měsíců"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Trend braucht mindestens zwei Monate: Wählen Sie ein Jahr oder 12 Monate"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trend needs two months at least: choose a year or 12 months"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendencia necesita al menos dos meses: elija un año o 12 meses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tendance demande deux mois au moins : choisissez une année ou 12 mois"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միտումը տեսնելու համար անհրաժեշտ է առնվազն երկու ամիս․ ընտրեք տարի կամ 12 ամիս"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mostrare un andamento servono almeno due mesi: scegli un anno o 12 mesi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傾向を表示するには2か月以上必要です。1年または12か月を選択してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტენდენციისთვის სულ მცირე ორი თვეა საჭირო: აირჩიეთ წელი ან 12 თვე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренд үшін кем дегенде екі ай керек: жыл немесе 12 ай таңдаңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추세를 보려면 최소 2개월이 필요합니다. 1년 또는 12개월을 선택하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тенденция үчүн кеминде эки ай керек: жылды же 12 айды тандаңыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een trend zijn minstens twee maanden nodig. Kies een jaar of 12 maanden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do pokazania trendu potrzeba co najmniej dwóch miesięcy: wybierz rok lub 12 miesięcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tendência requer pelo menos dois meses: escolha um ano ou 12 meses"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tendência requer pelo menos dois meses: escolha um ano ou 12 meses"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для динамики нужно хотя бы два месяца: выберите год или 12 мес."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои тамоюл ҳадди ақал ду моҳ лозим аст: як сол ё 12 моҳро интихоб кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğilim için en az iki ay gerekir: Bir yıl veya 12 ay seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренду потрібно щонайменше два місяці: оберіть рік або 12 місяців"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendensiya uchun kamida 2 oy kerak: yil yoki 12 oyni tanlang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看趋势至少需要两个月：请选择一年或 12 个月"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "趨勢至少需要兩個月的資料，請選擇一年或 12 個月"
          }
        }
      }
    },
