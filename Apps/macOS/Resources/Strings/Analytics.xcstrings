    "analytics.others.legend": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "— yalnız rənglə deyil, həmişə etiketlə"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "— заўсёды з подпісам, а не толькі колерам"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "— vždy s popiskem, nejen barvou"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "— immer mit Beschriftung, nicht nur über die Farbe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "— always with a label, not only by colour"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "— siempre con etiqueta, no solo por color"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "— toujours avec un libellé, pas seulement par la couleur"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "— միշտ նշումով, ոչ միայն գույնով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "— sempre con un'etichetta, non solo con il colore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "— 色だけでなくラベルでも表示"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "— ყოველთვის აღნიშვნით და არა მხოლოდ ფერით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "— әрқашан белгісімен, тек түсі бойынша емес"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "— 색상뿐 아니라 레이블도 항상 표시"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "— түс менен гана эмес, дайыма белги менен"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "— altijd met een label, niet alleen met kleur"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "— zawsze z etykietą, nie tylko kolorem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "— sempre com um rótulo, não apenas por cor"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "— sempre com etiqueta, não apenas por cor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "— всегда с подписью, не только цветом"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "— ҳамеша бо нишона, на танҳо бо ранг"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "— yalnızca renkle değil, her zaman etiketle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " — завжди з підписом, а не лише кольором"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "— har doim yorliq bilan, faqat rang bilan emas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "— 始终显示标签，不仅依靠颜色区分"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "— 一律附有標籤，不僅以顏色區分"
          }
        }
      }
    },
