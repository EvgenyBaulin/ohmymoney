    "analytics.basis.accountBalances": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "cari qalıq, planlaşdırılmış gəlir və ödənişlər, hər hesabın payına görə gündəlik xərclər"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "цяперашні баланс, планавыя даходы і плацяжы, штодзённыя выдаткі паводле долі кожнага рахунку"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "současný zůstatek, plánované příjmy a platby, běžné výdaje podle podílu jednotlivých účtů"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo jetzt, geplante Einnahmen und Zahlungen, Alltagsausgaben nach dem Anteil jedes Kontos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "balance now, planned income and payments, day-to-day spending by each account's share"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "saldo actual, ingresos y pagos previstos, gasto del día a día según la parte de cada cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "solde actuel, revenus et paiements prévus, dépenses courantes au prorata de chaque compte"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "ընթացիկ մնացորդը, պլանավորված մուտքերն ու վճարումները, ամենօրյա ծախսերը՝ ըստ յուրաքանչյուր հաշվի բաժնի"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "saldo attuale, entrate e pagamenti previsti, spese quotidiane in base alla quota di ogni conto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の残高、予定収入と支払い、各口座の割合に応じた日々の支出"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიმდინარე ნაშთი, დაგეგმილი შემოსავალი და გადახდები, ყოველდღიური ხარჯები თითოეული ანგარიშის წილის მიხედვით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "қазіргі теңгерім, жоспарланған табыс пен төлемдер, күнделікті шығыс әр есеп-шоттың үлесі бойынша"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 잔액, 예정된 수입과 결제, 계좌별 비중에 따른 일상 지출"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "учурдагы калдык, пландалган киреше жана төлөмдөр, ар бир эсептин үлүшү боюнча күнүмдүк чыгымдар"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "huidig saldo, geplande inkomsten en betalingen, dagelijkse uitgaven naar aandeel per rekening"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "obecne saldo, planowane przychody i płatności oraz codzienne wydatki według udziału każdego konta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "saldo atual, receitas e pagamentos planejados, gastos diários pela participação de cada conta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "saldo atual, receitas e pagamentos previstos, gastos diários distribuídos por cada conta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "остаток сейчас, поступления и платежи по плану, повседневные траты по доле счёта"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "бақияи ҷорӣ, даромад ва пардохтҳои ба нақша гирифташуда, хароҷоти ҳаррӯза аз рӯйи ҳиссаи ҳар ҳисоб"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "mevcut bakiye, planlanan gelir ve ödemeler, her hesabın payına göre günlük harcamalar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "залишок зараз, заплановані доходи й платежі, повсякденні витрати за часткою кожного рахунку"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "joriy qoldiq, rejalashtirilgan daromad va to‘lovlar, har bir hisob ulushi bo‘yicha kundalik xarajatlar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前余额、计划收入和支出，以及按各账户占比分配的日常支出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前餘額、預計收入與付款，以及依各帳戶比例分配的日常支出"
          }
        }
      }
    },
