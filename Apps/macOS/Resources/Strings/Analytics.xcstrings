    "analytics.basis.turnover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "turnover: whole receipts minus refunds, by the day of purchase; expected cashback by the rules of the accounts, received by the month it is for"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "facturación: tickets completos menos devoluciones, por el día de compra; cashback previsto según las reglas de las cuentas, recibido por el mes al que corresponde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "chiffre d'affaires : tickets complets moins remboursements, par jour d'achat ; cashback attendu selon les règles des comptes, reçu par mois auquel il se rapporte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "оборот: чеки целиком минус возвраты, по дню покупки; ожидаемый кэшбэк — по правилам счетов, полученный — по месяцу отнесения"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "оборот: цілі чеки без повернень за днем покупки; очікуваний кешбек за правилами рахунків, отриманий — за місяцем, для якого він"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "transato: importo totale degli acquisti meno i rimborsi, per data di acquisto; cashback previsto secondo le regole dei conti, ricevuto per mese di competenza"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "айналым: сатып алу күні бойынша толық чектер минус қайтарулар; күтілетін кешбэк — есеп-шоттың ережелері бойынша, алынғаны — ол арналған ай бойынша"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "абарот: поўныя чэкі мінус вяртанні, па дні пакупкі; чаканы кэшбэк па правілах рахункаў, атрыманы па месяцы прызначэння"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umsatz: ganze Belege abzüglich Rückgaben, nach dem Tag des Kaufs; erwarteter Cashback nach den Regeln der Konten, erhalten nach dem Monat, für den er ist"
          }
        }
      }
    },
