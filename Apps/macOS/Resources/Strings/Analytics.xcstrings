    "analytics.basis.cashbackMonths": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "gözlənilən keşbek alış ayına, alınan keşbek aid olduğu aya görə; fərq = alınan − gözlənilən"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "чаканы па месяцы пакупкі, атрыманы па месяцы прызначэння; розніца = атрыманы − чаканы"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "očekávaný podle měsíce nákupu, přijatý podle měsíce, ke kterému patří; rozdíl = přijatý − očekávaný"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "erwartet nach dem Monat des Kaufs, erhalten nach dem Monat, für den er ist; Differenz = erhalten − erwartet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "expected by the month of purchase, received by the month it is for; difference = received − expected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "previsto por el mes de la compra, recibido por el mes al que corresponde; diferencia = recibido − previsto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "attendu par mois d'achat, reçu par mois auquel il se rapporte ; écart = reçu − attendu"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "սպասվողը՝ ըստ գնման ամսվա, ստացվածը՝ ըստ վերաբերող ամսվա․ տարբերություն = ստացված − սպասվող"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "previsto per mese di acquisto, ricevuto per mese di competenza; differenza = ricevuto − previsto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定額は購入月別、受取額は対象月別。差額 = 受取額 − 予定額"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოსალოდნელი — შესყიდვის თვის მიხედვით, მიღებული — კუთვნილი თვის მიხედვით; სხვაობა = მიღებული − მოსალოდნელი"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "сатып алу айы бойынша күтілген, ол арналған ай бойынша алынған; айырма = алынған − күтілген"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 금액은 구매 월 기준, 받은 금액은 해당 월 기준; 차이 = 받은 금액 − 예상 금액"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "күтүлгөнү сатып алуу айы боюнча, алынганы тиешелүү ай боюнча; айырма = алынган − күтүлгөн"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "verwacht per aankoopmaand, ontvangen per maand waarop de cashback betrekking heeft; verschil = ontvangen − verwacht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "oczekiwany według miesiąca zakupu, otrzymany według miesiąca, którego dotyczy; różnica = otrzymany − oczekiwany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "esperado pelo mês da compra, recebido pelo mês a que se refere; diferença = recebido − esperado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "previsto pelo mês da compra, recebido pelo mês a que se refere; diferença = recebido − previsto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ожидаемый — по месяцу покупки, полученный — по месяцу отнесения; разница = получено − ожидалось"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "интизоршуда аз рӯйи моҳи харид, гирифташуда аз рӯйи моҳе, ки ба он тааллуқ дорад; фарқ = гирифташуда − интизоршуда"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "beklenen para iadesi satın alma ayına, alınan para iadesi ilgili olduğu aya göre; fark = alınan − beklenen"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "очікуваний — за місяцем покупки, отриманий — за місяцем, для якого він; різниця = отримано − очікувано"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "kutilgan keshbek xarid oyi bo‘yicha, olingani tegishli oy bo‘yicha; farq = olingan − kutilgan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计返现按购买月份，已收返现按所属月份；差额 = 已收 − 预计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預計回饋依購買月份，已收回饋依所屬月份；差額 = 已收 − 預計"
          }
        }
      }
    },
