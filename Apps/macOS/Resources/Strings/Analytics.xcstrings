    "analytics.reason.modelNotReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model is not saying anything yet: it needs fifty labelled operations and five in a category"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo todavía no dice nada: necesita cincuenta operaciones etiquetadas y cinco en una categoría"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle ne dit encore rien : il lui faut cinquante opérations étiquetées et cinq dans une catégorie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель пока молчит: нужно пятьдесят размеченных операций и пять в категории"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель поки не підказує: їй потрібно п'ятдесят розмічених операцій і п'ять у категорії"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non ha ancora suggerimenti: servono 50 operazioni etichettate e 5 in una categoria"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель әлі ештеңе айтпайды: оған елу белгіленген операция және санатта бесеу керек"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мадэль яшчэ не дае парад: патрэбныя пяцьдзясят размечаных аперацый і пяць у катэгорыі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell sagt noch nichts: Es braucht fünfzig beschriftete Vorgänge und fünf in einer Kategorie"
          }
        }
      }
    },
