    "analytics.basis.modelQuality": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured on your own history: the model is asked before it learns, and the forecast is made from a past day only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido sobre su propio historial: el modelo se consulta antes de aprender, y la previsión se hace solo desde un día pasado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré sur votre propre historique : le modèle est interrogé avant d'apprendre, et la prévision n'est faite qu'à partir d'un jour passé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерено на вашей истории: модель спрашивают до того, как она выучит, а прогноз делают только по прошлому дню"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виміряно за вашою власною історією: модель запитується до навчання, а прогноз робиться лише з минулого дня"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurata sulla tua cronologia: il modello viene interrogato prima di apprendere e la previsione usa solo i dati disponibili a una data passata"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз тарихыңызда өлшенген: модель үйренбестен бұрын сұралады, болжам тек өткен күннен жасалады"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вымерана на вашай гісторыі: мадэль спачатку адказвае, потым вучыцца, а прагноз будуецца толькі з мінулага дня"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemessen an Ihrem eigenen Verlauf: Das Modell wird vor dem Lernen befragt, und die Prognose entsteht nur aus einem vergangenen Tag"
          }
        }
      }
    },
