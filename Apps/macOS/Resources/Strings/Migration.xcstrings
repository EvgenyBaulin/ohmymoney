    "migration.done.undo": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzəliş → Geri al (⌘Z) bütün köçürməni geri qaytarır. Əvvəlcədən yaradılmış verilənlər bazası nüsxəsi ehtiyat nüsxələr arasındadır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праўка → Адмяніць (⌘Z) скасоўвае ўвесь перанос. Копія базы даных, створаная перад пераносам, знаходзіцца сярод рэзервовых копій."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volba Úpravy → Zpět (⌘Z) vrátí celý převod. Kopii databáze vytvořenou před převodem najdete v zálohách."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten → Widerrufen (⌘Z) nimmt die ganze Übernahme zurück. Die Kopie der Datenbank, die davor angelegt wurde, ist unter den Sicherungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit → Undo (⌘Z) takes the whole move back. The copy of the database made before it is among the backups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar → Deshacer (⌘Z) deshace todo el traslado. La copia de la base de datos hecha antes está entre las copias de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier → Annuler (⌘Z) reprend tout l'import. La copie de la base faite avant figure parmi les sauvegardes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խմբագրել → Հետարկել (⌘Z) հրամանով կարող եք հետարկել ամբողջ տեղափոխումը։ Մինչ տեղափոխումը ստեղծված տվյալների շտեմարանի պատճենը պահուստային պատճենների թվում է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica → Annulla (⌘Z) annulla l'intero trasferimento. La copia del database creata prima del trasferimento è tra i backup."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რედაქტირება → გაუქმება (⌘Z) მთელ გადმოტანას გააუქმებს. მანამდე შექმნილი მონაცემთა ბაზის ასლი სარეზერვო ასლებს შორისაა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өңдеу → Болдырмау (⌘Z) бүкіл көшіруді қайтарады. Оның алдында жасалған дерекқор көшірмесі резервтік көшірмелердің ішінде."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Түзөтүү → Артка кайтаруу (⌘Z) көчүрүүнү толугу менен жокко чыгарат. Ага чейин түзүлгөн маалымат базасынын көчүрмөсү камдык көчүрмөлөрдө сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz Edycja → Cofnij (⌘Z), aby cofnąć całe przeniesienie. Kopia bazy danych utworzona przed przeniesieniem znajduje się wśród kopii zapasowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar → Desfazer (⌘Z) reverte toda a importação. A cópia do banco de dados feita antes dela está entre os backups."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Edição → Desfazer (⌘Z) reverte toda a importação. A cópia da base de dados criada antes da importação está nas cópias de segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Правка» → «Отменить» (⌘Z) отменяет перенос целиком. Копия базы, сделанная перед ним, лежит среди бэкапов."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таҳрир → Бекор кардан (⌘Z) тамоми воридкуниро бекор мекунад. Нусхаи пойгоҳи додаҳо, ки пеш аз воридкунӣ сохта шудааст, дар нусхаҳои эҳтиётӣ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzen → Geri Al (⌘Z), içe aktarmanın tümünü geri alır. Öncesinde oluşturulan veri tabanı kopyası yedekler arasındadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагування → Скасувати дію (⌘Z) скасовує все перенесення. Копія бази даних перед ним є серед резервних копій."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahrirlash → Bekor qilish (⌘Z) orqali ko‘chirishni butunlay bekor qilish mumkin. Ko‘chirishdan oldingi ma’lumotlar bazasi nusxasi zaxira nusxalar orasida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「編輯」→「復原」（⌘Z）可還原整個移入作業。移入前建立的資料庫副本可在備份中找到。"
          }
        }
      }
    },
