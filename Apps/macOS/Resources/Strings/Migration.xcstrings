    "migration.subtitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A table exported from CoinKeeper, Zenmoney, Money Manager, Excel or Numbers. Nothing is written before «Move In»; a copy of the database is made first, and ⌘Z takes the whole move back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tabla exportada de CoinKeeper, Zenmoney, Money Manager, Excel o Numbers. Nada se escribe antes de «Traer»; primero se hace una copia de la base de datos, y ⌘Z deshace todo el traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tableau exporté de CoinKeeper, Zenmoney, Money Manager, Excel ou Numbers. Rien n'est écrit avant « Importer » ; une copie de la base est faite d'abord, et ⌘Z reprend tout l'import."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблица, выгруженная из CoinKeeper, Дзен-мани, Money Manager, Excel или Numbers. До «Перенести» ничего не записывается; перед записью делается копия базы, а ⌘Z отменяет перенос целиком."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблиця, експортована з CoinKeeper, Zenmoney, Money Manager, Excel або Numbers. Нічого не записується до «Перенести»; спочатку створюється копія бази, а ⌘Z скасовує все перенесення."
          }
        }
      }
    },
