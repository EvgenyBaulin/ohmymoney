    "migration.preview.fetchingRates": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmin günlərin məzənnələri Rusiya Bankından alınır…"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запыт курсаў Банка Расіі за адпаведныя дні…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítání kurzů pro dané dny z Bank of Russia…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank of Russia wird nach den Kursen dieser Tage gefragt…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asking the Bank of Russia for the rates of those days…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidiendo al Banco de Rusia los tipos de esos días…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à la Banque de Russie les taux de ces jours…"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստացվում են այդ օրերի փոխարժեքները Ռուսաստանի Բանկից…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesta dei tassi di quei giorni alla Banca di Russia…"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიმდინარეობს რუსეთის ბანკიდან შესაბამისი დღეების კურსების მიღება…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сол күндердің бағамдарын Ресей Банкінен сұрап жатыр…"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Россия Банкынын ошол күндөрдөгү курстары алынууда…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie kursów z tych dni z Banku Rosji…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultando as cotações dessas datas no Banco da Rússia…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A obter as taxas desses dias junto do Banco da Rússia…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашиваю у Банка России курсы этих дней…"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гирифтани қурбҳои он рӯзҳо аз Бонки Русия…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O günlerin kurları Rusya Merkez Bankası’ndan alınıyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит курсів за ці дні в Банку Росії…"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rossiya Bankidan o‘sha kunlar kurslari olinmoqda…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在向 Bank of Russia 查詢當日匯率⋯"
          }
        }
      }
    },
