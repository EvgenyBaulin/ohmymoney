    "migration.accounts.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the operations of each account of the other app go. «Don't move» leaves them out. Hidden accounts are offered only while they are shown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда идут операции каждого счёта другого приложения. «Не переносить» оставляет их в стороне. Скрытые счета предлагаются, только пока они показаны."
          }
        }
      }
    },
    "migration.another": {
      "extractionState": "manual",
      "localizations": {
