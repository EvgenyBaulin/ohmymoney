        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei lässt sich nicht als Tabelle mit Spaltennamen lesen. Exportieren Sie sie als CSV oder .xlsx."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file does not read as a table with column names. Export it as CSV or .xlsx."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no se lee como tabla con nombres de columna. Expórtelo como CSV o .xlsx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier ne se lit pas comme un tableau avec des noms de colonnes. Exportez-le en CSV ou .xlsx."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլը չի կարդացվում որպես սյունակների անուններով աղյուսակ։ Արտահանեք այն CSV կամ .xlsx ձևաչափով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non può essere letto come tabella con nomi di colonna. Esportalo in CSV o .xlsx."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილი სვეტების სახელების მქონე ცხრილად ვერ იკითხება. გაიტანეთ ის CSV ან .xlsx ფორმატში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл бағандар аттары бар кесте ретінде оқылмайды. CSV немесе .xlsx ретінде экспорттаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл мамыча аттары бар таблица катары окулган жок. Аны CSV же .xlsx форматына экспорттоңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać pliku jako tabeli z nazwami kolumn. Wyeksportuj go do CSV lub .xlsx."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o arquivo como uma tabela com nomes de colunas. Exporte-o como CSV ou .xlsx."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o ficheiro como uma tabela com nomes de colunas. Exporte-o como CSV ou .xlsx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не читается как таблица с названиями столбцов. Выгрузите его в CSV или .xlsx."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл ҳамчун ҷадвал бо номҳои сутунҳо хонда намешавад. Онро ба CSV ё .xlsx содир кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya, sütun adları içeren bir tablo olarak okunamıyor. CSV veya .xlsx olarak dışa aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не читається як таблиця з назвами стовпців. Експортуйте в CSV або .xlsx."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylni ustun nomlari bor jadval sifatida o‘qib bo‘lmadi. Uni CSV yoki .xlsx formatida eksport qiling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
