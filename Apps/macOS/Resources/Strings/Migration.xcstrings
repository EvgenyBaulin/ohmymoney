    "migration.categories.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad və mənaya görə uyğunlaşdırılır («Çöldə yemək» → «Kafelər»). Yeni kateqoriya yalnız «Yarat» seçildikdə yaradılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Супастаўлены паводле назвы і значэння («Харчаванне па-за домам» → «Кафэ»). Новая катэгорыя ствараецца, толькі калі вы выбралі «Стварыць»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spárováno podle názvu a významu («Stravování venku» → «Kavárny»). Nová kategorie vznikne jen tam, kde zvolíte «Vytvořit»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugeordnet nach Name und Bedeutung („Essen gehen“ → „Cafés“). Eine neue Kategorie entsteht nur dort, wo Sie „Anlegen“ wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired by name and meaning («Eating out» → «Cafes»). A new category is made only where you choose «Create»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se emparejan por nombre y significado («Restaurantes» → «Cafeterías»). Una categoría nueva se crea solo donde elija «Crear»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appariées par nom et sens (« Restaurants » → « Cafés »). Une nouvelle catégorie n'est créée que là où vous choisissez « Créer »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համադրվում են ըստ անվան և իմաստի («Սնունդ դրսում» → «Սրճարաններ»)։ Նոր կատեգորիա ստեղծվում է միայն «Ստեղծել» ընտրելու դեպքում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbinate per nome e significato («Mangiare fuori» → «Caffè»). Una nuova categoria viene creata solo se scegli «Crea»."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაწყვილებულია სახელითა და მნიშვნელობით («კვება გარეთ» → «კაფეები»). ახალი კატეგორია იქმნება მხოლოდ იქ, სადაც აირჩევთ «შექმნას»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атауы мен мағынасы бойынша сәйкестендіріледі («Кафеде тамақтану» → «Кафелер»). Жаңа санат тек «Жасау» таңдалған жерде жасалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аты жана мааниси боюнча дал келтирилет («Тышта тамактануу» → «Кафелер»). Жаңы категория «Түзүү» тандалганда гана түзүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasowane według nazwy i znaczenia («Jedzenie na mieście» → «Kawiarnie»). Nowa kategoria powstanie tylko po wybraniu opcji «Utwórz»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Associadas por nome e significado («Comer fora» → «Cafés»). Uma categoria só é criada onde você escolher «Criar»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Associadas por nome e significado («Comer fora» → «Cafés»). Só é criada uma categoria quando escolhe «Criar»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подобраны по названию и смыслу («Еда вне дома» → «Кафе»). Новая категория создаётся, только если выбрать «Создать»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз рӯи ном ва маъно мувофиқ карда шудаанд («Хӯрок берун аз хона» → «Қаҳвахонаҳо»). Категорияи нав танҳо дар ҷое сохта мешавад, ки «Эҷод кардан»-ро интихоб мекунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada ve anlama göre eşleştirilir («Dışarıda yemek» → «Kafeler»). Yeni kategori yalnızca «Oluştur» seçildiğinde oluşturulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зіставлено за назвою й змістом («Харчування поза домом» → «Кафе»). Нова категорія створюється лише там, де ви виберете «Створити»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom va ma’no bo‘yicha moslanadi («Tashqarida ovqatlanish» → «Kafelar»). Yangi turkum faqat «Yaratish» tanlangan joyda yaratiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依名稱和意義配對（「外食」→「咖啡廳」）。只有選擇「建立」時才會建立新類別。"
          }
        }
      }
    },
    "migration.categories.none": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylda kateqoriya yoxdur: hər şey «Çeşidlənməmiş» bölməsinə köçürüləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У файле няма катэгорый: усё трапіць у «Неразмеркаванае»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor neobsahuje kategorie: vše přejde do «Nezařazeno»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat keine Kategorien: Alles geht in „Unsortiert“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file has no categories: everything goes to «Unsorted»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no tiene categorías: todo va a «Sin clasificar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas de catégories : tout va dans « Non classées »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլում կատեգորիաներ չկան․ ամեն ինչ կտեղափոխվի «Չդասակարգված»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non contiene categorie: tutto viene assegnato a «Da classificare»."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილში კატეგორიები არ არის: ყველაფერი გადავა «დაუხარისხებელში»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлда санаттар жоқ: бәрі «Сұрыпталмағанға» түседі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлда категориялар жок: баары «Сорттолбогон» бөлүмүнө өтөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik nie zawiera kategorii: wszystko trafi do «Nieprzypisane»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não tem categorias: tudo vai para «Sem categoria»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro não tem categorias: tudo passa para «Por classificar»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле нет категорий: всё попадёт в «Не разобрано»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар файл категория нест: ҳамааш ба «Бе категория» мегузарад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyada kategori yok: Her şey «Sınıflandırılmamış» kategorisine aktarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У файлі немає категорій: усе потрапить у «Нерозібране»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylda turkumlar yo‘q: hammasi «Saralanmagan» turkumiga o‘tkaziladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案中沒有類別：所有交易都會移至「未分類」。"
          }
        }
      }
    },
