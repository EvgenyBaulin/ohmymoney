    "migration.subtitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager, Excel və ya Numbers-dan ixrac edilmiş cədvəl. «Köçür» seçilənədək heç nə yazılmır; əvvəlcə verilənlər bazasının nüsxəsi yaradılır və ⌘Z bütün köçürməni geri qaytarır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Табліца, экспартаваная з CoinKeeper, Zenmoney, Money Manager, Excel або Numbers. Да націскання «Перанесці» нічога не запісваецца; спачатку ствараецца копія базы даных, а ⌘Z скасоўвае ўвесь перанос."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabulka exportovaná z CoinKeeper, Zenmoney, Money Manager, Excelu nebo Numbers. Před volbou «Převést» se nic nezapíše; nejprve se vytvoří kopie databáze a pomocí ⌘Z lze celý převod vrátit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tabelle aus CoinKeeper, Zenmoney, Money Manager, Excel oder Numbers. Vor „Übernehmen“ wird nichts geschrieben; vorher wird eine Kopie der Datenbank angelegt, und ⌘Z nimmt die ganze Übernahme zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A table exported from CoinKeeper, Zenmoney, Money Manager, Excel or Numbers. Nothing is written before «Move In»; a copy of the database is made first, and ⌘Z takes the whole move back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tabla exportada de CoinKeeper, Zenmoney, Money Manager, Excel o Numbers. Nada se escribe antes de «Traer»; primero se hace una copia de la base de datos, y ⌘Z deshace todo el traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tableau exporté de CoinKeeper, Zenmoney, Money Manager, Excel ou Numbers. Rien n'est écrit avant « Importer » ; une copie de la base est faite d'abord, et ⌘Z reprend tout l'import."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper-ից, Zenmoney-ից, Money Manager-ից, Excel-ից կամ Numbers-ից արտահանված աղյուսակ։ Մինչ «Տեղափոխել» ընտրելը ոչինչ չի գրվում․ նախ ստեղծվում է տվյալների շտեմարանի պատճենը, իսկ ⌘Z-ը հետարկում է ամբողջ տեղափոխումը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tabella esportata da CoinKeeper, Zenmoney, Money Manager, Excel o Numbers. Nessun dato viene scritto prima di scegliere «Trasferisci»; viene prima creata una copia del database e ⌘Z annulla l'intero trasferimento."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper-იდან, Zenmoney-იდან, Money Manager-იდან, Excel-იდან ან Numbers-იდან ექსპორტირებული ცხრილი. «გადმოტანამდე» არაფერი ჩაიწერება; ჯერ მონაცემთა ბაზის ასლი შეიქმნება, ხოლო ⌘Z მთელ გადმოტანას გააუქმებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager, Excel немесе Numbers-тен экспортталған кесте. «Көшіріп алу» басылғанға дейін ештеңе жазылмайды; алдымен дерекқордың көшірмесі жасалады, ал ⌘Z бүкіл көшіруді қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager, Excel же Numbers колдонмосунан экспорттолгон таблица. «Көчүрүү» басылганга чейин эч нерсе жазылбайт; адегенде маалымат базасынын көчүрмөсү түзүлөт, ал эми ⌘Z көчүрүүнү толугу менен жокко чыгарат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela wyeksportowana z CoinKeeper, Zenmoney, Money Manager, Excel lub Numbers. Dane zostaną zapisane dopiero po wybraniu opcji «Przenieś». Najpierw powstanie kopia bazy danych, a ⌘Z cofnie całe przeniesienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tabela exportada do CoinKeeper, Zenmoney, Money Manager, Excel ou Numbers. Nada é gravado antes de «Importar»; uma cópia do banco de dados é criada primeiro, e ⌘Z reverte toda a importação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tabela exportada do CoinKeeper, Zenmoney, Money Manager, Excel ou Numbers. Nada é guardado antes de escolher «Importar»; é criada uma cópia da base de dados e ⌘Z reverte toda a importação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблица, выгруженная из CoinKeeper, Дзен-мани, Money Manager, Excel или Numbers. До «Перенести» ничего не записывается; перед записью делается копия базы, а ⌘Z отменяет перенос целиком."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷадвали аз CoinKeeper, Zenmoney, Money Manager, Excel ё Numbers содиршуда. То пахши «Ворид кардан» чизе сабт намешавад; аввал нусхаи пойгоҳи додаҳо сохта мешавад ва ⌘Z тамоми воридкуниро бекор мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager, Excel veya Numbers’dan dışa aktarılmış bir tablo. «İçe Aktar» seçilene kadar hiçbir şey kaydedilmez; önce veri tabanının bir kopyası oluşturulur ve ⌘Z içe aktarmanın tümünü geri alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблиця, експортована з CoinKeeper, Zenmoney, Money Manager, Excel або Numbers. Нічого не записується до «Перенести»; спочатку створюється копія бази, а ⌘Z скасовує все перенесення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager, Excel yoki Numbers’dan eksport qilingan jadval. «Ko‘chirish» tanlanmaguncha hech narsa yozilmaydi; avval ma’lumotlar bazasi nusxasi yaratiladi, ⌘Z esa ko‘chirishni butunlay bekor qiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 CoinKeeper、Zenmoney、Money Manager、Excel 或 Numbers 匯出的表格。選擇「移入」前不會寫入任何資料；系統會先建立資料庫副本，按下 ⌘Z 可還原整個移入作業。"
          }
        }
      }
    },
