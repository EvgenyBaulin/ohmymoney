    "migration.done.undo": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit → Undo (⌘Z) takes the whole move back. The copy of the database made before it is among the backups."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Правка» → «Отменить» (⌘Z) отменяет перенос целиком. Копия базы, сделанная перед ним, лежит среди бэкапов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагування → Скасувати дію (⌘Z) скасовує все перенесення. Копія бази даних перед ним є серед резервних копій."
          }
        }
      }
    },
    "migration.done.undo.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Undo” takes the whole move back. The copy of the database made before it is among the backups."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отменить» отменяет перенос целиком. Копия базы, сделанная перед ним, лежит среди бэкапов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скасувати дію» скасовує все перенесення. Копія бази даних перед ним є серед резервних копій."
          }
        }
      }
    },
