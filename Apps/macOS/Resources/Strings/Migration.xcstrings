    "migration.subtitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A table exported from CoinKeeper, Zenmoney, Money Manager, Excel or Numbers. Nothing is written before «Move In»; a copy of the database is made first, and ⌘Z takes the whole move back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tabla exportada de CoinKeeper, Zenmoney, Money Manager, Excel o Numbers. Nada se escribe antes de «Traer»; primero se hace una copia de la base de datos, y ⌘Z deshace todo el traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tableau exporté de CoinKeeper, Zenmoney, Money Manager, Excel ou Numbers. Rien n'est écrit avant « Importer » ; une copie de la base est faite d'abord, et ⌘Z reprend tout l'import."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблица, выгруженная из CoinKeeper, Дзен-мани, Money Manager, Excel или Numbers. До «Перенести» ничего не записывается; перед записью делается копия базы, а ⌘Z отменяет перенос целиком."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблиця, експортована з CoinKeeper, Zenmoney, Money Manager, Excel або Numbers. Нічого не записується до «Перенести»; спочатку створюється копія бази, а ⌘Z скасовує все перенесення."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager, Excel немесе Numbers-тен экспортталған кесте. «Көшіріп алу» басылғанға дейін ештеңе жазылмайды; алдымен дерекқордың көшірмесі жасалады, ал ⌘Z бүкіл көшіруді қайтарады."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tabella esportata da CoinKeeper, Zenmoney, Money Manager, Excel o Numbers. Nessun dato viene scritto prima di scegliere «Trasferisci»; viene prima creata una copia del database e ⌘Z annulla l'intero trasferimento."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Табліца, экспартаваная з CoinKeeper, Zenmoney, Money Manager, Excel або Numbers. Да націскання «Перанесці» нічога не запісваецца; спачатку ствараецца копія базы даных, а ⌘Z скасоўвае ўвесь перанос."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tabelle aus CoinKeeper, Zenmoney, Money Manager, Excel oder Numbers. Vor „Übernehmen“ wird nichts geschrieben; vorher wird eine Kopie der Datenbank angelegt, und ⌘Z nimmt die ganze Übernahme zurück."
          }
        }
      }
    },
    "migration.subtitle.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A table exported from CoinKeeper, Zenmoney, Money Manager, Excel or Numbers. Nothing is written before «Move In»; a copy of the database is made first, and “Undo” takes the whole move back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tabla exportada de CoinKeeper, Zenmoney, Money Manager, Excel o Numbers. Nada se escribe antes de «Traer»; primero se hace una copia de la base de datos, y «Deshacer» deshace todo el traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tableau exporté de CoinKeeper, Zenmoney, Money Manager, Excel ou Numbers. Rien n'est écrit avant « Importer » ; une copie de la base est faite d'abord, et « Annuler » reprend tout l'import."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблица, выгруженная из CoinKeeper, Дзен-мани, Money Manager, Excel или Numbers. До «Перенести» ничего не записывается; перед записью делается копия базы, а «Отменить» отменяет перенос целиком."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблиця, експортована з CoinKeeper, Zenmoney, Money Manager, Excel або Numbers. Нічого не записується до «Перенести»; спочатку створюється копія бази, а «Скасувати дію» скасовує все перенесення."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager, Excel немесе Numbers-тен экспортталған кесте. «Көшіріп алу» басылғанға дейін ештеңе жазылмайды; алдымен дерекқордың көшірмесі жасалады, ал «Болдырмау» бүкіл көшіруді қайтарады."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tabella esportata da CoinKeeper, Zenmoney, Money Manager, Excel o Numbers. Nessun dato viene scritto prima di scegliere «Trasferisci»; viene prima creata una copia del database e “Annulla” annulla l'intero trasferimento."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Табліца, экспартаваная з CoinKeeper, Zenmoney, Money Manager, Excel або Numbers. Да націскання «Перанесці» нічога не запісваецца; спачатку ствараецца копія базы даных, а «Адмяніць» скасоўвае ўвесь перанос."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tabelle aus CoinKeeper, Zenmoney, Money Manager, Excel oder Numbers. Vor „Übernehmen“ wird nichts geschrieben; vorher wird eine Kopie der Datenbank angelegt, und „Widerrufen“ nimmt die ganze Übernahme zurück."
          }
        }
      }
    },
