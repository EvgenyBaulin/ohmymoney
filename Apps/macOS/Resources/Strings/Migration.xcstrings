    "migration.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Köçürülmədi, heç nə yazılmadı. Səbəb jurnalda göstərilib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перанос не выкананы, нічога не запісана. Прычына пазначана ў журнале."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Převod se nezdařil, nic nebylo zapsáno. Důvod najdete v protokolu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht übernommen, nichts wurde geschrieben. Das Journal sagt, warum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not moved in, nothing was written. The journal says why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se trajo nada, no se escribió nada. El diario indica el motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été importé, rien n'a été écrit. Le journal indique pourquoi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեղափոխումը չկատարվեց, ոչինչ չգրվեց։ Պատճառը նշված է մատյանում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasferimento non riuscito, nessun dato è stato scritto. Il registro ne indica il motivo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადმოტანა ვერ მოხერხდა, არაფერი ჩაწერილა. მიზეზი ჟურნალშია მითითებული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшіріп алынбады, ештеңе жазылмады. Себебі журналда."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көчүрүлгөн жок, эч нерсе жазылган жок. Себеби журналда көрсөтүлгөн."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przeniesiono ani nie zapisano danych. Przyczynę znajdziesz w dzienniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação falhou e nada foi gravado. Consulte o registro para saber o motivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação falhou e nada foi guardado. Consulte o registo para saber porquê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не перенесено, ничего не записано. Причина — в журнале."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ворид нашуд, чизе сабт нашуд. Сабаб дар гузориш аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılamadı, hiçbir şey kaydedilmedi. Nedeni günlükte bulabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не перенесено, нічого не записано. Причина в журналі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘chirilmadi, hech narsa yozilmadi. Sababi jurnalda ko‘rsatilgan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法移入，未寫入任何資料。請查看日誌瞭解原因。"
          }
        }
      }
    },
    "migration.file.numbers": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, Numbers sənədidir və formatı qapalıdır. Numbers-da Fayl → İxrac et → CSV və ya Excel seçin, sonra həmin faylı burada seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта дакумент Numbers з закрытым фарматам. У Numbers выберыце Файл → Экспартаваць у → CSV або Excel, а затым выберыце гэты файл тут."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je dokument Numbers s uzavřeným formátem. V Numbers vyberte Soubor → Exportovat do → CSV nebo Excel a pak zde vyberte exportovaný soubor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Numbers-Dokument, und sein Format ist geschlossen. Wählen Sie in Numbers Ablage → Exportieren nach → CSV oder Excel und dann hier diese Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a Numbers document, and its format is closed. In Numbers choose File → Export To → CSV or Excel, then choose that file here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un documento de Numbers, y su formato está cerrado. En Numbers elija Archivo → Exportar a → CSV o Excel, y después elija ese archivo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un document Numbers, dont le format est fermé. Dans Numbers, choisissez Fichier → Exporter vers → CSV ou Excel, puis choisissez ce fichier ici."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա Numbers փաստաթուղթ է, որի ձևաչափը փակ է։ Numbers-ում ընտրեք Ֆայլ → Արտահանել որպես → CSV կամ Excel, ապա ընտրեք այդ ֆայլն այստեղ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è un documento Numbers, il cui formato è chiuso. In Numbers, scegli File → Esporta come → CSV o Excel, quindi seleziona il file qui."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს Numbers-ის დოკუმენტია და მისი ფორმატი დახურულია. Numbers-ში აირჩიეთ File → Export To → CSV ან Excel, შემდეგ კი აქ აირჩიეთ მიღებული ფაილი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл Numbers құжаты, оның пішімі жабық. Numbers-те «Файл → Экспорттау → CSV немесе Excel» таңдап, сол файлды осы жерде таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул Numbers документинин форматы жабык. Numbers колдонмосунда Файл → Экспорттоо → CSV же Excel тандап, анан ошол файлды бул жерден тандаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dokument Numbers o zamkniętym formacie. W Numbers wybierz Plik → Eksportuj do → CSV lub Excel, a następnie wybierz ten plik tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um documento do Numbers, cujo formato é fechado. No Numbers, escolha Arquivo → Exportar Para → CSV ou Excel e selecione o arquivo aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um documento do Numbers, cujo formato é fechado. No Numbers, escolha Ficheiro → Exportar para → CSV ou Excel e, em seguida, escolha esse ficheiro aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это документ Numbers, его формат закрыт. В Numbers выберите «Файл» → «Экспортировать в» → CSV или Excel и выберите здесь получившийся файл."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ҳуҷҷати Numbers аст ва формати он пӯшида аст. Дар Numbers Файл → Содирот ба → CSV ё Excel-ро интихоб кунед, сипас он файлро дар ин ҷо интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir Numbers belgesi ve biçimi kapalıdır. Numbers’da Dosya → Şuraya Aktar → CSV veya Excel’i seçin, ardından dosyayı burada seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це документ Numbers із закритим форматом. У Numbers виберіть «Файл → Експортувати до → CSV або Excel», а потім виберіть той файл тут."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Numbers hujjati, uning formati yopiq. Numbers’da File → Export To → CSV yoki Excel’ni tanlang, so‘ng hosil bo‘lgan faylni shu yerda tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是 Numbers 文件，其格式不公開。請在 Numbers 中選擇「檔案」→「輸出至」→「CSV」或「Excel」，然後在此選擇匯出的檔案。"
          }
        }
      }
    },
    "migration.file.unreadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayl sütun adları olan cədvəl kimi oxunmur. Onu CSV və ya .xlsx kimi ixrac edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося прачытаць файл як табліцу з назвамі слупкоў. Экспартуйце яго ў CSV або .xlsx."
          }
