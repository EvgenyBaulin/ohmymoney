    "migration.columns.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər sütunun məzmunu. Seçiminiz eyni sütunlu növbəti fayl üçün yadda saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што змяшчае кожны слупок. Ваш выбар захаваецца для наступнага файла з такімі ж слупкамі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co obsahují jednotlivé sloupce. Volba se uloží pro další soubor se stejnými sloupci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jede Spalte enthält. Ihre Wahl wird für die nächste Datei mit denselben Spalten gemerkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What each column holds. Your choice is remembered for the next file with the same columns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué contiene cada columna. Su elección se recuerda para el siguiente archivo con las mismas columnas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que contient chaque colonne. Votre choix est retenu pour le prochain fichier aux mêmes colonnes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչ տվյալներ է պարունակում յուրաքանչյուր սյունակ։ Ընտրությունը կհիշվի նույն սյունակներով հաջորդ ֆայլի համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica il contenuto di ogni colonna. La scelta verrà ricordata per il prossimo file con le stesse colonne."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიუთითეთ, რას შეიცავს თითოეული სვეტი. არჩევანი დამახსოვრდება იმავე სვეტების მქონე შემდეგი ფაილისთვის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр бағанда не бар. Таңдауыңыз бірдей бағандары бар келесі файлға есте қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир мамычанын мазмунун тандаңыз. Тандооңуз мамычалары бирдей кийинки файл үчүн сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określ zawartość każdej kolumny. Wybór zostanie zapamiętany dla następnego pliku z tymi samymi kolumnami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo de cada coluna. Sua escolha será lembrada para o próximo arquivo com as mesmas colunas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo de cada coluna. A escolha é guardada para o próximo ficheiro com as mesmas colunas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что в каждом столбце. Выбор запоминается для следующего файла с такими же столбцами."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мазмуни ҳар сутун. Интихоби шумо барои файли навбатӣ бо ҳамин сутунҳо нигоҳ дошта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sütunun içeriği. Seçiminiz, aynı sütunlara sahip sonraki dosya için hatırlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що містить кожен стовпець. Вибір запам'ятовується для наступного файлу з такими самими стовпцями."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir ustunda qanday ma’lumot borligi. Tanlovingiz bir xil ustunli keyingi fayl uchun eslab qolinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇各欄的內容。下次使用欄位相同的檔案時會沿用此選擇。"
          }
        }
      }
    },
    "migration.columns.incomplete": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarix və məbləğ sütunlarını (və ya gəlir və xərc sütunlarını) seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце слупок з датай і сумай (або слупкі з даходамі і выдаткамі)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte sloupec s datem a částkou (nebo sloupce s příjmy a výdaji)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Datumsspalte und den Betrag (oder die Spalten für Einnahmen und Ausgaben)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the date column and the amount (or the income and expense columns)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la columna de fecha y el importe (o las columnas de ingreso y gasto)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la colonne de date et le montant (ou les colonnes revenus et dépenses)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք ամսաթվի և գումարի սյունակները կամ եկամտի և ծախսի սյունակները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la colonna della data e quella dell'importo, oppure le colonne delle entrate e delle uscite."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ თარიღისა და თანხის სვეტები ან შემოსავლისა და ხარჯის სვეტები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күн бағанын және соманы (немесе табыс пен шығыс бағандарын) таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күн жана сумма мамычаларын же киреше жана чыгаша мамычаларын тандаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kolumnę daty i kwoty albo kolumny przychodów i wydatków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a coluna de data e a de valor, ou as colunas de receita e despesa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a coluna da data e do valor (ou as colunas de receitas e despesas)."
          }
        },
        "ru": {
          "stringUnit": {
