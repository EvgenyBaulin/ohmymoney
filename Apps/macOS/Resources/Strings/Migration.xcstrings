    "migration.accounts.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the operations of each account of the other app go. «Don't move» leaves them out. Hidden accounts are offered only while they are shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adónde van las operaciones de cada cuenta de la otra app. «No mover» las deja fuera. Las cuentas ocultas se ofrecen solo mientras se muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où vont les opérations de chaque compte de l'autre app. « Ne pas déplacer » les laisse de côté. Les comptes masqués ne sont proposés que lorsqu'ils sont affichés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда идут операции каждого счёта другого приложения. «Не переносить» оставляет их в стороне. Скрытые счета предлагаются, только пока они показаны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Куди перенести операції кожного рахунку іншого застосунку. «Не переносити» виключає їх. Приховані рахунки пропонуються лише поки їх показано."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа қолданбаның әр есеп-шотының операциялары қайда барады. «Жылжытпау» оларды шығарып тастайды. Жасырын есеп-шоттар тек көрсетіліп тұрғанда ғана ұсынылады."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica dove trasferire le operazioni di ogni conto dell'altra app. «Non trasferire» le esclude. I conti nascosti sono disponibili solo quando sono visibili."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Куды перанесці аперацыі кожнага рахунку з іншай праграмы. «Не пераносіць» выключае іх. Схаваныя рахункі прапануюцца, толькі калі яны паказаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin die Vorgänge jedes Kontos der anderen App wandern. „Nicht verschieben“ lässt sie weg. Ausgeblendete Konten werden nur angeboten, solange sie angezeigt werden."
          }
        }
      }
    },
