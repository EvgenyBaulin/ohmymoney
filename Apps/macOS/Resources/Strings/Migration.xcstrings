    "migration.accounts.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Digər tətbiqdəki hər hesabın əməliyyatlarının köçürüləcəyi hesab. «Köçürmə» seçildikdə əməliyyatlar buraxılır. Gizli hesablar yalnız göstərildikdə təklif olunur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Куды перанесці аперацыі кожнага рахунку з іншай праграмы. «Не пераносіць» выключае іх. Схаваныя рахункі прапануюцца, толькі калі яны паказаны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kam převést operace jednotlivých účtů z druhé aplikace. Volba «Nepřevádět» je vynechá. Skryté účty se nabízejí jen tehdy, když jsou zobrazené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin die Vorgänge jedes Kontos der anderen App wandern. „Nicht verschieben“ lässt sie weg. Ausgeblendete Konten werden nur angeboten, solange sie angezeigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the operations of each account of the other app go. «Don't move» leaves them out. Hidden accounts are offered only while they are shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adónde van las operaciones de cada cuenta de la otra app. «No mover» las deja fuera. Las cuentas ocultas se ofrecen solo mientras se muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où vont les opérations de chaque compte de l'autre app. « Ne pas déplacer » les laisse de côté. Les comptes masqués ne sont proposés que lorsqu'ils sont affichés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որ հաշիվ տեղափոխել մյուս հավելվածի յուրաքանչյուր հաշվի գործարքները։ «Չտեղափոխել» ընտրելու դեպքում դրանք բաց կթողնվեն։ Թաքցված հաշիվներն առաջարկվում են միայն ցուցադրման ժամանակ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica dove trasferire le operazioni di ogni conto dell'altra app. «Non trasferire» le esclude. I conti nascosti sono disponibili solo quando sono visibili."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ, სად გადავიდეს სხვა აპის თითოეული ანგარიშის ოპერაციები. «არ გადმოიტანო» მათ გამოტოვებს. დამალული ანგარიშები ხელმისაწვდომია მხოლოდ მათი გამოჩენისას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа қолданбаның әр есеп-шотының операциялары қайда барады. «Жылжытпау» оларды шығарып тастайды. Жасырын есеп-шоттар тек көрсетіліп тұрғанда ғана ұсынылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Башка колдонмодогу ар бир эсептин операциялары кайда көчүрүлөт. «Көчүрбөө» тандалса, алар өткөрүлүп жиберилет. Жашыруун эсептер көрсөтүлүп турганда гана сунушталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, dokąd trafią operacje z każdego konta drugiej aplikacji. «Nie przenoś» pomija operacje. Ukryte konta są dostępne tylko wtedy, gdy są widoczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha para onde vão as operações de cada conta do outro app. «Não importar» as deixa de fora. Contas ocultas só aparecem quando estão visíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino dos movimentos de cada conta da outra app. «Não importar» exclui-os. As contas ocultas só são apresentadas quando estão visíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда идут операции каждого счёта другого приложения. «Не переносить» оставляет их в стороне. Скрытые счета предлагаются, только пока они показаны."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёти ҳар ҳисоби барномаи дигар ба куҷо мегузарад. «Интиқол надиҳед» онҳоро сарфи назар мекунад. Ҳисобҳои пинҳон танҳо ҳангоми намоён буданашон пешниҳод мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamadaki her hesabın işlemlerinin aktarılacağı yer. «Aktarma» seçilen hesaplar dışarıda bırakılır. Gizli hesaplar yalnızca gösterildiklerinde sunulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Куди перенести операції кожного рахунку іншого застосунку. «Не переносити» виключає їх. Приховані рахунки пропонуються лише поки їх показано."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa ilovadagi har bir hisob amallari qayerga ko‘chirilishi. «Ko‘chirilmasin» tanlansa, ular o‘tkazib yuboriladi. Yashirilgan hisoblar faqat ko‘rsatilganda taklif qilinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇另一個 App 中各帳戶交易的移入位置。選擇「不要移入」會略過該帳戶。隱藏的帳戶只有在顯示時才能選取。"
          }
        }
      }
    },
