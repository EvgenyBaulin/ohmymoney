    "migration.columns.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What each column holds. Your choice is remembered for the next file with the same columns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué contiene cada columna. Su elección se recuerda para el siguiente archivo con las mismas columnas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que contient chaque colonne. Votre choix est retenu pour le prochain fichier aux mêmes colonnes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что в каждом столбце. Выбор запоминается для следующего файла с такими же столбцами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що містить кожен стовпець. Вибір запам'ятовується для наступного файлу з такими самими стовпцями."
          }
        }
      }
    },
