    "migration.empty.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager tətbiqlərindən CSV və ya Excel (.xlsx) faylı, yaxud tarix və məbləğ olan istənilən cədvəl. Numbers cədvəlini əvvəlcə CSV və ya Excel kimi ixrac edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл CSV або Excel (.xlsx) з CoinKeeper, Zenmoney, Money Manager або любая табліца з датай і сумай. Табліцу Numbers спачатку экспартуйце ў CSV або Excel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV nebo Excel (.xlsx) z CoinKeeper, Zenmoney, Money Manager nebo jakákoli tabulka s datem a částkou. Tabulku Numbers nejprve exportujte do CSV nebo Excelu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV oder Excel (.xlsx) aus CoinKeeper, Zenmoney, Money Manager oder jeder Tabelle mit einem Datum und einem Betrag. Eine Numbers-Tabelle: Exportieren Sie sie zuerst als CSV oder Excel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV or Excel (.xlsx) from CoinKeeper, Zenmoney, Money Manager, or any table with a date and an amount. A Numbers table: export it to CSV or Excel first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV o Excel (.xlsx) de CoinKeeper, Zenmoney, Money Manager, o cualquier tabla con fecha e importe. Una tabla de Numbers: primero expórtela a CSV o Excel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV ou Excel (.xlsx) de CoinKeeper, Zenmoney, Money Manager, ou tout tableau avec une date et un montant. Un tableau Numbers : exportez-le d'abord en CSV ou Excel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV կամ Excel (.xlsx) ֆայլ CoinKeeper-ից, Zenmoney-ից, Money Manager-ից կամ ամսաթիվ և գումար պարունակող ցանկացած աղյուսակ։ Numbers աղյուսակը նախ արտահանեք CSV կամ Excel ձևաչափով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file CSV o Excel (.xlsx) da CoinKeeper, Zenmoney o Money Manager, oppure una tabella con una data e un importo. Per una tabella Numbers, esportala prima in CSV o Excel."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV ან Excel (.xlsx) ფაილი CoinKeeper-იდან, Zenmoney-იდან, Money Manager-იდან ან ნებისმიერი ცხრილი თარიღითა და თანხით. Numbers-ის ცხრილი ჯერ CSV ან Excel ფორმატში გაიტანეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager немесе күні мен сомасы бар кез келген кестеден CSV немесе Excel (.xlsx). Numbers кестесі болса: алдымен оны CSV немесе Excel ретінде экспорттаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager колдонмолорунан алынган CSV же Excel (.xlsx) файлы же күн менен сумма көрсөтүлгөн каалаган таблица. Numbers таблицасын адегенде CSV же Excel форматына экспорттоңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik CSV lub Excel (.xlsx) z CoinKeeper, Zenmoney, Money Manager albo dowolna tabela z datą i kwotą. Tabelę Numbers najpierw wyeksportuj do CSV lub Excel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV ou Excel (.xlsx) do CoinKeeper, Zenmoney ou Money Manager, ou qualquer tabela com data e valor. Para uma tabela do Numbers, exporte-a primeiro para CSV ou Excel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ficheiro CSV ou Excel (.xlsx) do CoinKeeper, Zenmoney ou Money Manager, ou uma tabela com uma data e um valor. Para uma tabela do Numbers, exporte-a primeiro para CSV ou Excel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV или Excel (.xlsx) из CoinKeeper, Дзен-мани, Money Manager или любая таблица с датой и суммой. Таблицу Numbers сначала экспортируйте в CSV или Excel."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV ё Excel (.xlsx) аз CoinKeeper, Zenmoney, Money Manager ё ҳар ҷадвале бо сана ва маблағ. Ҷадвали Numbers-ро аввал ба CSV ё Excel содир кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney veya Money Manager’dan alınmış bir CSV ya da Excel (.xlsx) dosyası veya tarih ve tutar içeren herhangi bir tablo seçin. Numbers tablosunu önce CSV ya da Excel olarak dışa aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV або Excel (.xlsx) із CoinKeeper, Zenmoney, Money Manager чи будь-яка таблиця з датою та сумою. Таблицю Numbers спочатку експортуйте в CSV або Excel."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager dasturlaridan CSV yoki Excel (.xlsx) fayli yoxud sana va summa ko‘rsatilgan istalgan jadval. Numbers jadvalini avval CSV yoki Excel formatiga eksport qiling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇從 CoinKeeper、Zenmoney、Money Manager 匯出的 CSV 或 Excel（.xlsx）檔案，或任何包含日期和金額的表格。Numbers 表格請先匯出為 CSV 或 Excel。"
          }
        }
      }
    },
