    "migration.columns.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што змяшчае кожны слупок. Ваш выбар захаваецца для наступнага файла з такімі ж слупкамі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jede Spalte enthält. Ihre Wahl wird für die nächste Datei mit denselben Spalten gemerkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What each column holds. Your choice is remembered for the next file with the same columns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué contiene cada columna. Su elección se recuerda para el siguiente archivo con las mismas columnas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que contient chaque colonne. Votre choix est retenu pour le prochain fichier aux mêmes colonnes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica il contenuto di ogni colonna. La scelta verrà ricordata per il prossimo file con le stesse colonne."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр бағанда не бар. Таңдауыңыз бірдей бағандары бар келесі файлға есте қалады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określ zawartość każdej kolumny. Wybór zostanie zapamiętany dla następnego pliku z tymi samymi kolumnami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo de cada coluna. Sua escolha será lembrada para o próximo arquivo com as mesmas colunas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что в каждом столбце. Выбор запоминается для следующего файла с такими же столбцами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sütunun içeriği. Seçiminiz, aynı sütunlara sahip sonraki dosya için hatırlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що містить кожен стовпець. Вибір запам'ятовується для наступного файлу з такими самими стовпцями."
          }
        }
      }
    },
