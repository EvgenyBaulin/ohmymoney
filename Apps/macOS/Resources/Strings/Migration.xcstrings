    "migration.done.undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit → Undo (⌘Z) takes the whole move back. The copy of the database made before it is among the backups."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Правка» → «Отменить» (⌘Z) отменяет перенос целиком. Копия базы, сделанная перед ним, лежит среди бэкапов."
          }
        }
      }
    },
    "migration.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV or Excel (.xlsx) from CoinKeeper, Zenmoney, Money Manager, or any table with a date and an amount. A Numbers table: export it to CSV or Excel first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV или Excel (.xlsx) из CoinKeeper, Дзен-мани, Money Manager или любая таблица с датой и суммой. Таблицу Numbers сначала экспортируйте в CSV или Excel."
          }
        }
      }
    },
