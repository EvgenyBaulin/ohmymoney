    "migration.empty.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл CSV або Excel (.xlsx) з CoinKeeper, Zenmoney, Money Manager або любая табліца з датай і сумай. Табліцу Numbers спачатку экспартуйце ў CSV або Excel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV oder Excel (.xlsx) aus CoinKeeper, Zenmoney, Money Manager oder jeder Tabelle mit einem Datum und einem Betrag. Eine Numbers-Tabelle: Exportieren Sie sie zuerst als CSV oder Excel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV or Excel (.xlsx) from CoinKeeper, Zenmoney, Money Manager, or any table with a date and an amount. A Numbers table: export it to CSV or Excel first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV o Excel (.xlsx) de CoinKeeper, Zenmoney, Money Manager, o cualquier tabla con fecha e importe. Una tabla de Numbers: primero expórtela a CSV o Excel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV ou Excel (.xlsx) de CoinKeeper, Zenmoney, Money Manager, ou tout tableau avec une date et un montant. Un tableau Numbers : exportez-le d'abord en CSV ou Excel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file CSV o Excel (.xlsx) da CoinKeeper, Zenmoney o Money Manager, oppure una tabella con una data e un importo. Per una tabella Numbers, esportala prima in CSV o Excel."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney, Money Manager немесе күні мен сомасы бар кез келген кестеден CSV немесе Excel (.xlsx). Numbers кестесі болса: алдымен оны CSV немесе Excel ретінде экспорттаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik CSV lub Excel (.xlsx) z CoinKeeper, Zenmoney, Money Manager albo dowolna tabela z datą i kwotą. Tabelę Numbers najpierw wyeksportuj do CSV lub Excel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV ou Excel (.xlsx) do CoinKeeper, Zenmoney ou Money Manager, ou qualquer tabela com data e valor. Para uma tabela do Numbers, exporte-a primeiro para CSV ou Excel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV или Excel (.xlsx) из CoinKeeper, Дзен-мани, Money Manager или любая таблица с датой и суммой. Таблицу Numbers сначала экспортируйте в CSV или Excel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinKeeper, Zenmoney veya Money Manager’dan alınmış bir CSV ya da Excel (.xlsx) dosyası veya tarih ve tutar içeren herhangi bir tablo seçin. Numbers tablosunu önce CSV ya da Excel olarak dışa aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV або Excel (.xlsx) із CoinKeeper, Zenmoney, Money Manager чи будь-яка таблиця з датою та сумою. Таблицю Numbers спочатку експортуйте в CSV або Excel."
          }
        }
      }
    },
