    "migration.preview.backup": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Köçürmədən əvvəl verilənlər bazasının nüsxəsi yaradılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перад пераносам будзе створана копія базы даных."
          }
