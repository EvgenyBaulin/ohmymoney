    "migration.categories.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired by name and meaning («Eating out» → «Cafes»). A new category is made only where you choose «Create»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se emparejan por nombre y significado («Restaurantes» → «Cafeterías»). Una categoría nueva se crea solo donde elija «Crear»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appariées par nom et sens (« Restaurants » → « Cafés »). Une nouvelle catégorie n'est créée que là où vous choisissez « Créer »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подобраны по названию и смыслу («Еда вне дома» → «Кафе»). Новая категория создаётся, только если выбрать «Создать»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зіставлено за назвою й змістом («Харчування поза домом» → «Кафе»). Нова категорія створюється лише там, де ви виберете «Створити»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атауы мен мағынасы бойынша сәйкестендіріледі («Кафеде тамақтану» → «Кафелер»). Жаңа санат тек «Жасау» таңдалған жерде жасалады."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbinate per nome e significato («Mangiare fuori» → «Caffè»). Una nuova categoria viene creata solo se scegli «Crea»."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Супастаўлены паводле назвы і значэння («Харчаванне па-за домам» → «Кафэ»). Новая катэгорыя ствараецца, толькі калі вы выбралі «Стварыць»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugeordnet nach Name und Bedeutung („Essen gehen“ → „Cafés“). Eine neue Kategorie entsteht nur dort, wo Sie „Anlegen“ wählen."
          }
        }
      }
    },
    "migration.categories.none": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file has no categories: everything goes to «Unsorted»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no tiene categorías: todo va a «Sin clasificar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas de catégories : tout va dans « Non classées »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле нет категорий: всё попадёт в «Не разобрано»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У файлі немає категорій: усе потрапить у «Нерозібране»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлда санаттар жоқ: бәрі «Сұрыпталмағанға» түседі."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non contiene categorie: tutto viene assegnato a «Da classificare»."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У файле няма катэгорый: усё трапіць у «Неразмеркаванае»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat keine Kategorien: Alles geht in „Unsortiert“."
          }
        }
      }
    },
