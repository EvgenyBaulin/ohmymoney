    "settings.general.lockHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль захоўваецца ў Звязцы ключоў, а не ў базе даных"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort wird im Schlüsselbund gespeichert, nicht in der Datenbank"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password is kept in the Keychain, not in the database"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña se guarda en el Llavero, no en la base de datos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe est gardé dans le Trousseau, pas dans la base"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գաղտնաբառը պահվում է Keychain-ում, ոչ թե տվյալների բազայում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password è salvata nel portachiavi, non nel database"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პაროლი ინახება Keychain-ში და არა მონაცემთა ბაზაში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құпиясөз дерекқорда емес, Кілттер жиынтығында сақталады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сырсөз маалымат базасында эмес, Ачкычтар тутамында сакталат"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło jest przechowywane w pęku kluczy, nie w bazie danych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha é armazenada nas Chaves, não no banco de dados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль хранится в связке ключей, не в базе"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Парол дар Keychain нигоҳ дошта мешавад, на дар пойгоҳи додаҳо"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola, veritabanında değil, Anahtar Zinciri'nde saklanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль зберігається у В'язці ключів, а не в базі даних"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Parol ma’lumotlar bazasida emas, Keychain’da saqlanadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼儲存在鑰匙圈中，不會存入資料庫"
          }
        }
      }
    },
