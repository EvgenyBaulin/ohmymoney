    "mac.command.instalmentReturn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A return of something bought in instalments is recorded in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La devolución de algo comprado a plazos se registra en OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un retour d'un article acheté à crédit se note dans OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат покупки в рассрочку записывается в OhMyMoney."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення речі, купленої в розстрочку, записується в OhMyMoney."
          }
        }
      }
    },
    "mac.command.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney is locked. Open the app and unlock it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney está bloqueada. Abra la app y desbloquéela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney est verrouillée. Ouvrez l'app et déverrouillez-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney заблокирован. Откройте приложение и разблокируйте его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney заблоковано. Відкрийте застосунок і розблокуйте його."
          }
        }
      }
    },
    "mac.command.mileage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mileage since the last fill-up will not be recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El kilometraje desde el último repostaje no se registrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le kilométrage depuis le dernier plein ne sera pas noté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробег с прошлой заправки не будет записан."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробіг від останньої заправки не записується."
          }
        }
      }
    },
    "mac.command.moneyBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money given back by a person is recorded in OhMyMoney: there you choose what it closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero devuelto por una persona se registra en OhMyMoney: allí elige qué cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent rendu par une personne se note dans OhMyMoney : là-bas vous choisissez ce qu'il clôt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат денег от человека записывается в OhMyMoney: там выбирается, что он закрывает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші, повернуті людиною, записуються в OhMyMoney: там ви обираєте, що вони закривають."
          }
        }
      }
    },
    "mac.command.notFound": {
      "extractionState": "manual",
      "localizations": {
