{
  "sourceLanguage": "en",
  "strings": {
    "intent.add.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt einen Vorgang oder eine Überweisung hinzu, so geschrieben wie in der Eingabezeile, zum Beispiel „Kaffee 250“ oder „Überweisung 5000 von Sber auf T-Bank“. Er wird so geprüft, wie die Eingabezeile ihn prüft, und ⌘Z in OhMyMoney nimmt ihn zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds an operation or a transfer written as in the entry line, for example “coffee 250” or “transfer 5000 from Sber to T-Bank”. It is checked as the entry line checks it, and ⌘Z in OhMyMoney takes it back."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енгізу жолындағыдай жазылған операция немесе аударым қосады, мысалы «coffee 250» немесе «transfer 5000 from Sber to T-Bank». Ол енгізу жолындай тексеріледі, ал OhMyMoney-дегі ⌘Z оны қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет операцию или перевод, записанные как в строке ввода, например «кофе 250» или «перевод 5000 сбер т-банк». Проверки — как у строки ввода, отменить — ⌘Z в OhMyMoney."
          }
        }
      }
    },
    "intent.add.description.touch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt einen Vorgang oder eine Überweisung hinzu, so geschrieben wie in der Eingabezeile, zum Beispiel „Kaffee 250“ oder „Überweisung 5000 von Sber auf T-Bank“. Er wird so geprüft, wie die Eingabezeile ihn prüft, und die Schaltfläche „Rückgängig“ in OhMyMoney nimmt ihn zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds an operation or a transfer written as in the entry line, for example “coffee 250” or “transfer 5000 from Sber to T-Bank”. It is checked as the entry line checks it, and the “Undo” button in OhMyMoney takes it back."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енгізу жолындағыдай жазылған операция немесе аударым қосады, мысалы «coffee 250» немесе «transfer 5000 from Sber to T-Bank». Ол енгізу жолындай тексеріледі, ал OhMyMoney-дегі «Болдырмау» түймесі оны қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет операцию или перевод, записанные как в строке ввода, например «кофе 250» или «перевод 5000 сбер т-банк». Проверки — как у строки ввода, отменить можно кнопкой «Отменить» в OhMyMoney."
          }
        }
      }
    },
