    "intent.find.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds operations by a word of the description, the place or the category. Operations of hidden accounts are never found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra operaciones por una palabra de la descripción, el lugar o la categoría. Las operaciones de cuentas ocultas nunca se encuentran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve des opérations par un mot de la description, du lieu ou de la catégorie. Les opérations des comptes masqués ne sont jamais trouvées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет операции по слову из описания, места или категории. Операции скрытых счетов не находятся никогда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходить операції за словом з опису, місця або категорії. Операції прихованих рахунків ніколи не знаходяться."
          }
        }
      }
    },
