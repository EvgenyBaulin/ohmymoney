    "mac.notify.evening.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Və ya bu gün xərc olmadığını OhMyMoney-də bildirin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Або пазначце ў OhMyMoney, што сёння выдаткаў не было."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder sagen Sie in OhMyMoney, dass es heute keine gab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or say in OhMyMoney that there was none today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O diga en OhMyMoney que hoy no hubo ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou dites dans OhMyMoney qu'il n'y en a eu aucune aujourd'hui."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կամ նշեք OhMyMoney-ում, որ այսօր ծախս չի եղել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure indica in OhMyMoney che oggi non hai avuto spese."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ან მიუთითეთ OhMyMoney-ში, რომ დღეს ხარჯი არ ყოფილა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немесе OhMyMoney-де бүгін шығын болмағанын айтыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Же бүгүн чыгаша болбогонун OhMyMoney'де белгилеңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz też zaznaczyć w OhMyMoney, że dziś nie było wydatków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou informe no OhMyMoney que não houve gastos hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или отметьте в OhMyMoney, что сегодня трат не было."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ё дар OhMyMoney нишон диҳед, ки имрӯз хароҷот надоштед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veya bugün harcama yapmadığınızı OhMyMoney'de belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Або скажіть в OhMyMoney, що сьогодні їх не було."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoki bugun xarajat bo'lmaganini OhMyMoney’da belgilang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或在 OhMyMoney 中標記今天沒有支出。"
          }
        }
      }
    },
