    "mac.command.countQuestion": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэты дзень баланс быў зверены. Пазначце ў OhMyMoney, ці адбылася аперацыя да падліку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo wurde an diesem Tag abgeglichen: Sagen Sie in OhMyMoney, ob der Vorgang vor der Zählung lag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance was reconciled that day: say in OhMyMoney whether the operation was before the count."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo è stato verificato quel giorno. Indica in OhMyMoney se l’operazione è avvenuta prima della verifica."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теңгерім сол күні салыстырылған: OhMyMoney-де операция санаудан бұрын болғанын айтыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день была сверка: ответьте в OhMyMoney, была ли операция до неё."
          }
        }
      }
    },
    "mac.command.deleteRefused": {
      "extractionState": "manual",
      "localizations": {
