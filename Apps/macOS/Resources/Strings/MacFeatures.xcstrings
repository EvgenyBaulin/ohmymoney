{
  "sourceLanguage": "en",
  "strings": {
    "intent.add.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds an operation or a transfer written as in the entry line, for example “coffee 250” or “transfer 5000 from Sber to T-Bank”. It is checked as the entry line checks it, and ⌘Z in OhMyMoney takes it back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет операцию или перевод, записанные как в строке ввода, например «кофе 250» или «перевод 5000 сбер т-банк». Проверки — как у строки ввода, отменить — ⌘Z в OhMyMoney."
          }
        }
      }
    },
    "intent.add.line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка"
          }
        }
      }
    },
    "intent.add.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Operation"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить операцию"
          }
        }
      }
    },
    "intent.delete.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes an operation, as “Delete” in the list does. ⌘Z in OhMyMoney brings it back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет операцию, как «Удалить» в списке. Вернуть — ⌘Z в OhMyMoney."
          }
        }
      }
    },
    "intent.delete.title": {
      "extractionState": "manual",
      "localizations": {
