    "intent.summary.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summary of a month as text: income, spending, categories, places. Without a month — the last finished one. With “Hide Amounts” on, without amounts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводка месяца текстом: доходы, расходы, категории, места. Без месяца — последний закончившийся. При «Скрыть суммы» — без сумм."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумок місяця текстом: доходи, витрати, категорії, місця. Без місяця — останній завершений. Коли ввімкнено «Приховати суми», — без сум."
          }
        }
      }
    },
    "intent.summary.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Month Summary"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводка месяца"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумок місяця"
          }
        }
      }
    },
    "mac.command.archivedLeftovers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change would leave money on an archived account: finish it in OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка оставит деньги на счёте в архиве: закончите её в OhMyMoney."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна залишила б гроші на архівному рахунку: завершіть її в OhMyMoney."
          }
        }
      }
    },
    "mac.command.badDate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date or the time of the line cannot be read."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не понял дату или время в строке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дату або час рядка не вдалося прочитати."
          }
        }
      }
    },
    "mac.command.badMonth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month is written as YYYY-MM, for example 2026-10."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц пишется как ГГГГ-ММ, например 2026-10."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць записується як РРРР-ММ, наприклад 2026-10."
          }
        }
      }
    },
    "mac.command.categoryMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line names no category: add it to the line, for example “coffee 250 cafe”, or choose it in OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В строке нет категории: допишите её, например «кофе 250 кафе», или выберите в OhMyMoney."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У рядку не названо категорії: додайте її в рядок, наприклад «кава 250 кафе», або оберіть в OhMyMoney."
          }
        }
      }
    },
    "mac.command.categoryUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no category “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории «%@» нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорії «%@» немає."
          }
        }
      }
    },
    "mac.command.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Record it anyway?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Всё равно записать?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Записати все одно?"
          }
        }
      }
    },
    "mac.command.countQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance was reconciled that day: say in OhMyMoney whether the operation was before the count."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день была сверка: ответьте в OhMyMoney, была ли операция до неё."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок того дня було звірено: скажіть в OhMyMoney, чи операція була до звірки."
          }
        }
      }
    },
    "mac.command.deleteRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation cannot be deleted from here: open it in OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту операцию отсюда удалить нельзя: откройте её в OhMyMoney."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю операцію звідси видалити не можна: відкрийте її в OhMyMoney."
          }
        }
      }
    },
    "mac.command.deleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
