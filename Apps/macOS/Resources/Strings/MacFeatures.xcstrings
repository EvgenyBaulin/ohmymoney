    "mac.command.splitAmount": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyat bir neçə hissədən ibarətdir. Məbləği OhMyMoney-də dəyişin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыя складаецца з некалькіх частак. Змяніце яе суму ў OhMyMoney."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace má více částí. Její částku změňte v OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang hat mehrere Teile: Ändern Sie seinen Betrag in OhMyMoney."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation has several parts: change its amount in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación tiene varias partes: cambie su importe en OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération a plusieurs parts : modifiez son montant dans OhMyMoney."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործողությունը մի քանի մաս ունի։ Փոխեք դրա գումարը OhMyMoney-ում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’operazione ha più parti. Modifica l’importo in OhMyMoney."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取引は複数の明細に分かれています。金額はOhMyMoneyで変更してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაცია რამდენიმე ნაწილისგან შედგება. შეცვალეთ მისი თანხა OhMyMoney-ში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцияның бірнеше бөлігі бар: сомасын OhMyMoney-де өзгертіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 여러 항목으로 나뉘어 있습니다. OhMyMoney에서 금액을 변경하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция бир нече бөлүктөн турат: анын суммасын OhMyMoney'де өзгөртүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactie bestaat uit meerdere delen. Wijzig het bedrag in OhMyMoney."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja składa się z kilku części. Zmień jej kwotę w OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação tem várias partes. Altere o valor no OhMyMoney."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação tem várias partes. Altere o montante no OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У операции несколько частей: сумму меняйте в OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёт чанд қисм дорад: маблағашро дар OhMyMoney тағйир диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem birden fazla bölümden oluşuyor. Tutarını OhMyMoney'de değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція має кілька частин: змініть її суму в OhMyMoney."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiya bir necha qismdan iborat. Uning summasini OhMyMoney’da o'zgartiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此交易包含多个部分，请在 OhMyMoney 中更改金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此交易包含多個部分。請在 OhMyMoney 中更改金額。"
          }
        }
      }
    },
    "mac.command.transferIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Köçürmə: eyni valyutada olan hər iki hesabı göstərin, məsələn, “köçürmə 5000 Sber T-Bank”."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перавод: пазначце абодва рахункі ў адной валюце, напрыклад “перавод 5000 Sber T-Bank”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Převod: uveďte oba účty ve stejné měně, například „převod 5000 Sber T-Bank“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Überweisung: Nennen Sie beide Konten in einer Währung, zum Beispiel „Überweisung 5000 Sber T-Bank“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer: name both accounts in one currency, for example “transfer 5000 Sber T-Bank”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transferencia: indique las dos cuentas en una misma divisa, por ejemplo «transferencia 5000 Sber T-Bank»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un virement : nommez les deux comptes dans une même devise, par exemple « virement 5000 Sber T-Bank »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխանցում. նշեք նույն արժույթով երկու հաշիվները, օրինակ՝ “փոխանցում 5000 Sber T-Bank”։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trasferimento: indica entrambi i conti nella stessa valuta, ad esempio “trasferimento 5000 Sber T-Bank”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振替には、同じ通貨の振替元と振替先を指定してください。例：「transfer 5000 Sber T-Bank」。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადარიცხვა: მიუთითეთ ერთი ვალუტის ორივე ანგარიში, მაგალითად “transfer 5000 Sber T-Bank”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аударым: бір валютадағы екі есеп-шотты атаңыз, мысалы «transfer 5000 Sber T-Bank»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이체할 같은 통화의 두 계좌를 입력하세요. 예: “transfer 5000 Sber T-Bank”."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Которуу: бир валютадагы эки эсепти тең көрсөтүңүз, мисалы “которуу 5000 Sber T-Bank”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overboeking: geef beide rekeningen in dezelfde valuta op, bijvoorbeeld “transfer 5000 Sber T-Bank”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelew: podaj oba konta w tej samej walucie, np. „transfer 5000 Sber T-Bank”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para uma transferência, informe as duas contas na mesma moeda, por exemplo, “transferir 5000 Sber T-Bank”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferência: indique ambas as contas na mesma moeda, por exemplo “transferência 5000 Sber T-Bank”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод: назовите оба счёта в одной валюте, например «перевод 5000 сбер т-банк»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Интиқол: ҳар ду ҳисобро бо як асъор нависед, масалан “интиқол 5000 Sber T-Bank”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer için aynı para birimindeki iki hesabı da belirtin, örneğin “transfer 5000 Sber T-Bank”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переказ: назвіть обидва рахунки в одній валюті, наприклад «переказ 5000 Ощад Т-Банк»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O'tkazma uchun bir xil valyutadagi ikkala hisobni ko'rsating, masalan, “transfer 5000 Sber T-Bank”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转账：请指定两个币种相同的账户，例如“转账 5000 Sber T-Bank”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉帳：請指定同一貨幣的兩個帳戶，例如「transfer 5000 Sber T-Bank」。"
          }
        }
      }
    },
