        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне грошай ад чалавека запісваецца ў OhMyMoney: там можна выбраць, якую запазычанасць яно пагашае."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrácení peněz od osoby zaznamenejte v OhMyMoney, kde vyberete, co se tím vyrovnává."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
