          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անձի վերադարձրած գումարը գրանցվում է OhMyMoney-ում։ Այնտեղ ընտրեք, թե ինչն է այն մարում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro restituito da una persona si registra in OhMyMoney, dove puoi scegliere cosa salda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人からの返金はOhMyMoneyで記録してください。そこで、どの取引を精算するか選択できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ადამიანის მიერ დაბრუნებული თანხა იწერება OhMyMoney-ში. იქ აირჩიეთ, რომელ ვალს ფარავს ის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адам қайтарған ақша OhMyMoney-де жазылады: онда нені жабатынын таңдайсыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 돌려준 돈은 OhMyMoney에서 기록하세요. 앱에서 정산할 항목을 선택할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адам кайтарган акча OhMyMoney'де жазылат: ал жерде анын кайсы карызды жабарын тандайсыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld dat iemand terugbetaalt, registreer je in OhMyMoney. Daar kies je wat ermee wordt vereffend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot pieniędzy od osoby zapisuje się w OhMyMoney, gdzie można wybrać, co zostaje rozliczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro devolvido por uma pessoa é registrado no OhMyMoney. Lá você escolhe o que ele quita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro devolvido por uma pessoa é registado no OhMyMoney, onde pode escolher a que se refere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат денег от человека записывается в OhMyMoney: там выбирается, что он закрывает."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули аз шахс баргардонидашуда дар OhMyMoney сабт мешавад: дар он ҷо интихоб кунед, ки он кадом қарзро мепӯшонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kişinin geri ödediği para OhMyMoney'de kaydedilir. Hangi borcu kapattığını orada seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші, повернуті людиною, записуються в OhMyMoney: там ви обираєте, що вони закривають."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kishi qaytargan pulni OhMyMoney’da qayd eting. U yerda qaysi qarz yopilishini tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 OhMyMoney 中记录他人归还的款项，并选择要结清的款项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他人還款請在 OhMyMoney 中記錄，並在其中選擇要抵銷的款項。"
          }
        }
      }
    },
