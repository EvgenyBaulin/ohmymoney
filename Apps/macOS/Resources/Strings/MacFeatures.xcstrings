    "mac.command.notReady": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney hat seine Daten noch nicht geöffnet. Öffnen Sie die App und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney has not opened its data yet. Open the app and try again."
          }
