          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытые — «Платёж завтра» без имени и суммы"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобҳои пинҳон: «Пардохт пагоҳ» бе ном ва маблағ"
