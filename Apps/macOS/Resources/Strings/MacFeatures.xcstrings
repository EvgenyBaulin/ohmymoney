    "intent.summary.description": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Агляд месяца ў выглядзе тэксту: даходы, выдаткі, катэгорыі, месцы. Калі месяц не пазначаны — апошні завершаны. Калі ўключана “Схаваць сумы”, сумы не паказваюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zusammenfassung eines Monats als Text: Einnahmen, Ausgaben, Kategorien, Orte. Ohne Monat — der letzte abgeschlossene. Mit eingeschaltetem „Beträge ausblenden“ ohne Beträge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summary of a month as text: income, spending, categories, places. Without a month — the last finished one. With “Hide Amounts” on, without amounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen de un mes como texto: ingresos, gastos, categorías, lugares. Sin mes — el último terminado. Con «Ocultar importes» activado, sin importes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le récapitulatif d'un mois sous forme de texte : revenus, dépenses, catégories, lieux. Sans mois — le dernier terminé. Avec « Masquer les montants » activé, sans montants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riepilogo di un mese come testo: entrate, spese, categorie e luoghi. Se non specifichi un mese, viene usato l’ultimo mese concluso. Se “Nascondi importi” è attivo, gli importi non vengono mostrati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың қорытындысы мәтін ретінде: табыс, шығыс, санаттар, орындар. Ай көрсетілмесе — соңғы аяқталған ай. «Сомаларды жасыру» қосулы болса — сомасыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstowe podsumowanie miesiąca: przychody, wydatki, kategorie i miejsca. Bez wskazania miesiąca używany jest ostatni zakończony miesiąc. Gdy opcja „Ukryj kwoty” jest włączona, podsumowanie nie zawiera kwot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводка месяца текстом: доходы, расходы, категории, места. Без месяца — последний закончившийся. При «Скрыть суммы» — без сумм."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayın metin olarak özeti: gelir, gider, kategoriler ve yerler. Ay belirtilmezse son tamamlanan ay kullanılır. “Tutarları Gizle” açıkken tutarlar gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумок місяця текстом: доходи, витрати, категорії, місця. Без місяця — останній завершений. Коли ввімкнено «Приховати суми», — без сум."
          }
        }
      }
    },
