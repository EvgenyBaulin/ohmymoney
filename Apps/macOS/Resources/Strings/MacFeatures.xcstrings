          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул операцияны бул жерден өчүрүү мүмкүн эмес: аны OhMyMoney'де ачыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze transactie kan hier niet worden verwijderd. Open de transactie in OhMyMoney."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można stąd usunąć tej operacji. Otwórz ją w OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
