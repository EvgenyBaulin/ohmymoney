    "intent.find.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet Vorgänge über ein Wort der Beschreibung, den Ort oder die Kategorie. Vorgänge ausgeblendeter Konten werden nie gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds operations by a word of the description, the place or the category. Operations of hidden accounts are never found."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцияларды сипаттаманың, орынның немесе санаттың сөзі бойынша табады. Жасырын есеп-шоттардың операциялары ешқашан табылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет операции по слову из описания, места или категории. Операции скрытых счетов не находятся никогда."
          }
        }
      }
    },
