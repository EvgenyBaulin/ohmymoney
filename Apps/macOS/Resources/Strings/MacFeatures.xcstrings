    "intent.summary.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summary of a month as text: income, spending, categories, places. Without a month — the last finished one. With “Hide Amounts” on, without amounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen de un mes como texto: ingresos, gastos, categorías, lugares. Sin mes — el último terminado. Con «Ocultar importes» activado, sin importes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le récapitulatif d'un mois sous forme de texte : revenus, dépenses, catégories, lieux. Sans mois — le dernier terminé. Avec « Masquer les montants » activé, sans montants."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводка месяца текстом: доходы, расходы, категории, места. Без месяца — последний закончившийся. При «Скрыть суммы» — без сумм."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумок місяця текстом: доходи, витрати, категорії, місця. Без місяця — останній завершений. Коли ввімкнено «Приховати суми», — без сум."
          }
        }
      }
    },
    "intent.summary.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Month Summary"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen del mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récapitulatif du mois"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводка месяца"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумок місяця"
          }
        }
      }
    },
    "mac.command.archivedLeftovers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change would leave money on an archived account: finish it in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio dejaría dinero en una cuenta archivada: termínelo en OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification laisserait de l'argent sur un compte archivé : terminez-la dans OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка оставит деньги на счёте в архиве: закончите её в OhMyMoney."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна залишила б гроші на архівному рахунку: завершіть її в OhMyMoney."
          }
        }
      }
    },
    "mac.command.badDate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date or the time of the line cannot be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer la fecha o la hora de la línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date ou l'heure de la ligne ne se lit pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не понял дату или время в строке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дату або час рядка не вдалося прочитати."
          }
        }
      }
    },
    "mac.command.badMonth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month is written as YYYY-MM, for example 2026-10."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes se escribe como AAAA-MM, por ejemplo 2026-10."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mois s'écrit AAAA-MM, par exemple 2026-10."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц пишется как ГГГГ-ММ, например 2026-10."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць записується як РРРР-ММ, наприклад 2026-10."
          }
        }
      }
    },
    "mac.command.categoryMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line names no category: add it to the line, for example “coffee 250 cafe”, or choose it in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea no nombra ninguna categoría: añádala a la línea, por ejemplo «café 250 cafetería», o elíjala en OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne ne nomme aucune catégorie : ajoutez-la à la ligne, par exemple « café 250 restaurant », ou choisissez-la dans OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В строке нет категории: допишите её, например «кофе 250 кафе», или выберите в OhMyMoney."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У рядку не названо категорії: додайте її в рядок, наприклад «кава 250 кафе», або оберіть в OhMyMoney."
          }
        }
      }
    },
    "mac.command.categoryUnknown": {
      "extractionState": "manual",
      "localizations": {
