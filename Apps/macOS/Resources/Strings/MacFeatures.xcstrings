    "mac.quicklook.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu faylı OhMyMoney arxivi kimi oxumaq mümkün deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Немагчыма прачытаць гэты файл як архіў OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei lässt sich nicht als Archiv von OhMyMoney lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file cannot be read as an archive of OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se puede leer como archivo de OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne se lit pas comme une archive d'OhMyMoney."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ֆայլը չի ճանաչվում որպես OhMyMoney-ի արխիվ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere questo file come archivio OhMyMoney."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილის OhMyMoney-ის არქივად წაკითხვა შეუძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл файлды OhMyMoney мұрағаты ретінде оқу мүмкін емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул файлды OhMyMoney архиви катары окуу мүмкүн эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać tego pliku jako archiwum OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não pode ser lido como um arquivo do OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл не читается как архив OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин файлро ҳамчун бойгонии OhMyMoney хондан мумкин нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya bir OhMyMoney arşivi olarak okunamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
