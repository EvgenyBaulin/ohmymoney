    "mac.quicklook.encryptedHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məzmunu yalnız OhMyMoney-də parolla görmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змесціва можна праглядзець толькі ў OhMyMoney з паролем."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt ist nur in OhMyMoney zu sehen, mit dem Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contents can be seen only in OhMyMoney, with the password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido solo se puede ver en OhMyMoney, con la contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu ne se voit que dans OhMyMoney, avec le mot de passe."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բովանդակությունը հասանելի է միայն OhMyMoney-ում՝ գաղտնաբառով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto è visibile solo in OhMyMoney con la password."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შიგთავსის ნახვა შესაძლებელია მხოლოდ OhMyMoney-ში, პაროლით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мазмұнын тек құписөзбен OhMyMoney-де ғана көруге болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мазмунун OhMyMoney колдонмосунда сырсөз менен гана көрүүгө болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawartość można wyświetlić tylko w OhMyMoney, po podaniu hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo só pode ser visto no OhMyMoney, com a senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое видно только в OhMyMoney, после пароля."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муҳтаворо танҳо дар OhMyMoney бо гузарвожа дидан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik yalnızca OhMyMoney’de parolayla görüntülenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вміст видно лише в OhMyMoney, за паролем."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkibni faqat OhMyMoney’da parol bilan ko‘rish mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能在 OhMyMoney 中使用密碼檢視內容。"
          }
        }
      }
    },
