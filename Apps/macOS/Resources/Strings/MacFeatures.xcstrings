    "mac.command.instalmentReturn": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taksitlə alınmış malın qaytarılması OhMyMoney-də qeyd edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне пакупкі ў растэрміноўку запісваецца ў OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Rückgabe von auf Raten Gekauftem wird in OhMyMoney erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A return of something bought in instalments is recorded in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La devolución de algo comprado a plazos se registra en OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un retour d'un article acheté à crédit se note dans OhMyMoney."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ապառիկ գնված ապրանքի վերադարձը գրանցվում է OhMyMoney-ում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reso di un acquisto a rate si registra in OhMyMoney."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განვადებით შეძენილი ნივთის დაბრუნება იწერება OhMyMoney-ში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөліп алынған нәрсенің қайтарымы OhMyMoney-де жазылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүп төлөөгө алынган товарды кайтаруу OhMyMoney'де жазылат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot zakupu na raty zapisuje się w OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A devolução de uma compra parcelada é registrada no OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат покупки в рассрочку записывается в OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бозгашти моли қисм-қисм харидашуда дар OhMyMoney сабт мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taksitle alınan bir ürünün iadesi OhMyMoney'de kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення речі, купленої в розстрочку, записується в OhMyMoney."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo'lib to'lashga olingan xarid qaytarilishini OhMyMoney’da qayd eting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分期購買商品的退貨請在 OhMyMoney 中記錄。"
          }
        }
      }
    },
    "mac.command.locked": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney kilidlidir. Tətbiqi açıb kilidini açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney заблакіравана. Адкрыйце праграму і разблакіруйце яе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ist gesperrt. Öffnen Sie die App und entsperren Sie sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney is locked. Open the app and unlock it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney está bloqueada. Abra la app y desbloquéela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney est verrouillée. Ouvrez l'app et déverrouillez-la."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն կողպված է։ Բացեք հավելվածը և ապակողպեք այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney è bloccato. Apri l’app e sbloccala."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney დაბლოკილია. გახსენით და განბლოკეთ აპი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney құлыптаулы. Қолданбаны ашып, құлыпты ашыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney кулпуланган. Колдонмону ачып, кулпусун ачыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney jest zablokowana. Otwórz aplikację i odblokuj ją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney está bloqueado. Abra o app e desbloqueie-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney заблокирован. Откройте приложение и разблокируйте его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney қулф аст. Барномаро кушоед ва қулфро бардоред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney kilitli. Uygulamayı açıp kilidini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney заблоковано. Відкрийте застосунок і розблокуйте його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney qulflangan. Ilovani ochib, qulfdan chiqaring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 已鎖定。請開啟 App 並解鎖。"
          }
        }
      }
    },
    "mac.command.mileage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son yanacaq doldurulmasından bəri qət edilən məsafə qeyd edilməyəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прабег з апошняй запраўкі не будзе запісаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kilometerstand seit dem letzten Tanken wird nicht erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mileage since the last fill-up will not be recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El kilometraje desde el último repostaje no se registrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le kilométrage depuis le dernier plein ne sera pas noté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին լիցքավորումից հետո անցած ճանապարհը չի գրանցվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza percorsa dall’ultimo rifornimento non verrà registrata."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო საწვავის ჩასხმის შემდეგ გავლილი მანძილი არ ჩაიწერება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы толтырудан бері жүрген жол жазылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы май куюудан берки жүргөн жол жазылбайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przebieg od ostatniego tankowania nie zostanie zapisany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A quilometragem desde o último abastecimento não será registrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробег с прошлой заправки не будет записан."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Масофаи тайшуда аз сӯзишворигирии охирин сабт намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son yakıt alımından bu yana yapılan kilometre kaydedilmeyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробіг від останньої заправки не записується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi yoqilg'i quyishdan beri bosib o'tilgan masofa qayd etilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會記錄上次加油後的里程。"
          }
        }
      }
    },
    "mac.command.moneyBack": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şəxsin qaytardığı pul OhMyMoney-də qeyd edilir. Orada hansı borcun bağlanacağını seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне грошай ад чалавека запісваецца ў OhMyMoney: там можна выбраць, якую запазычанасць яно пагашае."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld, das eine Person zurückgegeben hat, wird in OhMyMoney erfasst: Dort wählen Sie, was es beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money given back by a person is recorded in OhMyMoney: there you choose what it closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero devuelto por una persona se registra en OhMyMoney: allí elige qué cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent rendu par une personne se note dans OhMyMoney : là-bas vous choisissez ce qu'il clôt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անձի վերադարձրած գումարը գրանցվում է OhMyMoney-ում։ Այնտեղ ընտրեք, թե ինչն է այն մարում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro restituito da una persona si registra in OhMyMoney, dove puoi scegliere cosa salda."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ადამიანის მიერ დაბრუნებული თანხა იწერება OhMyMoney-ში. იქ აირჩიეთ, რომელ ვალს ფარავს ის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адам қайтарған ақша OhMyMoney-де жазылады: онда нені жабатынын таңдайсыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адам кайтарган акча OhMyMoney'де жазылат: ал жерде анын кайсы карызды жабарын тандайсыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot pieniędzy od osoby zapisuje się w OhMyMoney, gdzie można wybrać, co zostaje rozliczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro devolvido por uma pessoa é registrado no OhMyMoney. Lá você escolhe o que ele quita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат денег от человека записывается в OhMyMoney: там выбирается, что он закрывает."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули аз шахс баргардонидашуда дар OhMyMoney сабт мешавад: дар он ҷо интихоб кунед, ки он кадом қарзро мепӯшонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kişinin geri ödediği para OhMyMoney'de kaydedilir. Hangi borcu kapattığını orada seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші, повернуті людиною, записуються в OhMyMoney: там ви обираєте, що вони закривають."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kishi qaytargan pulni OhMyMoney’da qayd eting. U yerda qaysi qarz yopilishini tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他人還款請在 OhMyMoney 中記錄，並在其中選擇要抵銷的款項。"
          }
        }
      }
    },
