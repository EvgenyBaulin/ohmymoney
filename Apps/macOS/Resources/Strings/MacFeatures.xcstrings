    "mac.command.notReady": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney məlumatlarını hələ açmayıb. Tətbiqi açıb yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney яшчэ не адкрыла даныя. Адкрыйце праграму і паспрабуйце зноў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ještě nenačetla data. Otevřete aplikaci a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney hat seine Daten noch nicht geöffnet. Öffnen Sie die App und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney has not opened its data yet. Open the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney todavía no ha abierto sus datos. Abra la app e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney n'a pas encore ouvert ses données. Ouvrez l'app et réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն դեռ չի բացել իր տվյալները։ Բացեք հավելվածը և կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney non ha ancora aperto i suoi dati. Apri l’app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoneyのデータはまだ読み込まれていません。アプリを開いてからもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ს მონაცემები ჯერ არ გაუხსნია. გახსენით აპი და სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney деректерін әлі ашпады. Қолданбаны ашып, қайталап көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney에서 아직 데이터를 열지 않았습니다. 앱을 열고 다시 시도하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney дайындарын ача элек. Колдонмону ачып, кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney heeft de gegevens nog niet geopend. Open de app en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney nie otworzyła jeszcze danych. Otwórz aplikację i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney ainda não abriu seus dados. Abra o app e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney ainda não abriu os dados. Abra a aplicação e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ещё не открыл данные. Откройте приложение и повторите."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ҳанӯз маълумоташро накушодааст. Барномаро кушоед ва дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney verilerini henüz açmadı. Uygulamayı açıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ще не відкрив свої дані. Відкрийте застосунок і спробуйте знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ma'lumotlarni hali ochmadi. Ilovani ochib, qayta urining."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 尚未打开数据。请打开 App 并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 尚未開啟資料。請開啟 App 並再試一次。"
          }
        }
      }
    },
    "mac.command.prepayQuestion": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödəniş tələb olunan məbləğdən çoxdur. Müddətin qısaldılacağını, ödənişin azalacağını və ya qabaqcadan ödəniləcəyini OhMyMoney-də seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж большы за належны. Выберыце ў OhMyMoney, ці скарачае ён тэрмін, памяншае плацёж або аплачвае наперад."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba převyšuje splatnou částku. V OhMyMoney vyberte, zda zkrátí dobu splácení, sníží splátku nebo uhradí splátky předem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung liegt über der Fälligkeit: Wählen Sie in OhMyMoney, ob sie die Laufzeit verkürzt, die Rate senkt oder vorausbezahlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment is above its due: choose in OhMyMoney whether it shortens the term, lowers the payment or pays ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago supera su vencimiento: elija en OhMyMoney si acorta el plazo, baja el pago o paga por adelantado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement dépasse son échéance : choisissez dans OhMyMoney s'il réduit la durée, la mensualité ou paie d'avance."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարումը գերազանցում է վճարման ենթակա գումարը։ OhMyMoney-ում ընտրեք՝ այն կրճատում է ժամկետը, նվազեցնում վճարումը, թե վճարում է նախապես։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento supera l’importo dovuto. Scegli in OhMyMoney se riduce la durata, abbassa la rata o paga in anticipo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払額が予定額を超えています。期間を短縮するか、支払額を減らすか、前払いするかをOhMyMoneyで選択してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა გადასახდელზე მეტია. აირჩიეთ OhMyMoney-ში, შემცირდეს ვადა, შემცირდეს გადასახადი თუ წინასწარ დაიფაროს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлем міндеттемеден асады: OhMyMoney-де ол мерзімді қысқарта ма, төлемді азайта ма, әлде алдын ала төлей ме — таңдаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "납부액이 청구액보다 많습니다. 기간 단축, 납부액 감소 또는 선납 중에서 OhMyMoney에서 선택하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлөм белгиленген суммадан көп: мөөнөт кыскартылабы, төлөм азайтылабы же алдын ала төлөнөбү — OhMyMoney'де тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaling is hoger dan het verschuldigde bedrag. Kies in OhMyMoney of je de looptijd wilt verkorten, de betaling wilt verlagen of vooruit wilt betalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłata przekracza należną kwotę. Wybierz w OhMyMoney, czy skraca okres, zmniejsza ratę czy opłaca kolejne raty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é maior que o valor devido. Escolha no OhMyMoney se ele reduz o prazo, diminui a parcela ou antecipa pagamentos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento excede o montante em dívida. Escolha no OhMyMoney se reduz o prazo, baixa a prestação ou antecipa o pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёж больше срочного: выберите в OhMyMoney, уменьшить срок, платёж или это платёж вперёд."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пардохт аз маблағи муқарраршуда зиёд аст: дар OhMyMoney интихоб кунед, ки он муҳлатро кӯтоҳ мекунад, пардохтро кам мекунад ё пешпардохт мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme, ödenmesi gereken tutardan fazla. Vadenin kısaltılacağını, ödemenin düşürüleceğini veya ileriye dönük ödeme yapılacağını OhMyMoney'de seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж перевищує свій належний: оберіть в OhMyMoney, чи він скорочує строк, знижує платіж або йде наперед."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To'lov belgilangan summadan oshgan. Muddatni qisqartirish, to'lovni kamaytirish yoki oldindan to'lashni OhMyMoney’da tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款金额超过应付金额，请在 OhMyMoney 中选择缩短期限、降低付款额或提前支付。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款金額超過應付金額。請在 OhMyMoney 中選擇縮短期限、降低付款金額或提前付款。"
          }
        }
      }
    },
    "mac.command.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yalnız oxumaq” aktivdir: əlavə etmək, dəyişmək və ya silmək mümkün deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключаны рэжым “Толькі чытанне”: дадаваць, змяняць і выдаляць нельга."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zapnutý režim „Pouze čtení“. Nelze nic přidat, změnit ani smazat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur ansehen“ ist eingeschaltet: Nichts kann hinzugefügt, geändert oder gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Read Only” is on: nothing can be added, changed or deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo lectura» está activado: no se puede añadir, cambiar ni eliminar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Lecture seule » est activé : rien ne peut être ajouté, modifié ni supprimé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "“Միայն կարդալու” ռեժիմը միացված է։ Ավելացնել, փոխել կամ ջնջել հնարավոր չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sola lettura” è attivo: non puoi aggiungere, modificare o eliminare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「読み取り専用」がオンのため、追加、変更、削除はできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართულია “მხოლოდ წაკითხვა”. დამატება, შეცვლა და წაშლა შეუძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Тек оқу» қосулы: ештеңе қосуға, өзгертуге немесе жоюға болмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“읽기 전용”이 켜져 있어 추가, 변경 또는 삭제할 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“Окуу үчүн гана” күйүп турат: кошууга, өзгөртүүгө же өчүрүүгө болбойт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Alleen lezen’ staat aan. Er kan niets worden toegevoegd, gewijzigd of verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączono tryb „Tylko do odczytu”. Nie można nic dodawać, zmieniać ani usuwać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Somente Leitura” está ativado. Não é possível adicionar, alterar ou apagar nada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Só de leitura” está ativo. Não é possível adicionar, alterar ou apagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим «Только просмотр»: ничего нельзя добавить, изменить или удалить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "“Танҳо хондан” фаъол аст: илова, тағйир ё нест кардан мумкин нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Salt Okunur” açık. Ekleme, değiştirme veya silme yapılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено «Лише читання»: нічого не можна додати, змінити або видалити."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Faqat o'qish” yoqilgan. Qo'shish, o'zgartirish yoki o'chirish mumkin emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“只读”已开启，无法添加、更改或删除内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「唯讀」已開啟，無法加入、更改或刪除任何內容。"
          }
        }
      }
    },
    "mac.command.refundPurchase": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulun qaytarılması: aid olduğu alışı OhMyMoney-də seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне грошай: выберыце ў OhMyMoney пакупку, за якую вяртаюцца грошы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrácení peněz: v OhMyMoney vyberte nákup, ke kterému se vztahuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erstattung: Wählen Sie in OhMyMoney den Kauf, von dem sie Geld zurücknimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund: choose the purchase it takes money back from in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución: elija en OhMyMoney la compra de la que se devuelve el dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement : choisissez dans OhMyMoney l'achat dont il reprend l'argent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարի վերադարձ. OhMyMoney-ում ընտրեք այն գնումը, որի գումարը վերադարձվում է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rimborso: scegli in OhMyMoney l’acquisto a cui si riferisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金を受ける購入をOhMyMoneyで選択してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხის დაბრუნება: აირჩიეთ შესყიდვა OhMyMoney-ში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтару: OhMyMoney-де ақшаны қай сатып алудан қайтаратынын таңдаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환불할 구매 항목을 OhMyMoney에서 선택하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча кайтаруу: кайсы сатып алуу үчүн кайтарылганын OhMyMoney'де тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugbetaling: kies in OhMyMoney de aankoop waarvoor je geld terugkrijgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot: wybierz w OhMyMoney zakup, którego dotyczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para registrar um reembolso, escolha a compra correspondente no OhMyMoney."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reembolso: escolha no OhMyMoney a compra a que se refere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат: выберите в OhMyMoney покупку, за которую вернули деньги."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баргардонидани маблағ: дар OhMyMoney харидеро интихоб кунед, ки маблағаш баргардонида мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iadesi: İadenin hangi alışverişe ait olduğunu OhMyMoney'de seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення: оберіть в OhMyMoney покупку, з якої повертаються гроші."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulni qaytarish uchun tegishli xaridni OhMyMoney’da tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款：请在 OhMyMoney 中选择退款对应的购买记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款：請在 OhMyMoney 中選擇要退款的購買項目。"
          }
        }
      }
    },
