    "mac.print.ask": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğlərlə çap edilsin?"
          }
        },
        "be": {
          "stringUnit": {
