    "intent.markdown.description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın xülasəsini Markdown faylı kimi təqdim edir. Qovluqda saxlamaq üçün ardınca “Faylı saxla” əlavə edin və qısayolu cədvəl üzrə başladın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Агляд месяца ў файле Markdown. Дадайце пасля яго “Захаваць файл”, каб змясціць файл у папку, і запускайце каманду паводле раскладу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zusammenfassung eines Monats als Markdown-Datei — hängen Sie danach „Datei sichern“ an, um sie in einen Ordner zu legen, und lassen Sie den Kurzbefehl nach Zeitplan laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summary of a month as a Markdown file — add “Save File” after it to put it into a folder, and run the shortcut on a schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen de un mes como archivo Markdown — añada «Guardar archivo» después para dejarlo en una carpeta, y ejecute el atajo según un horario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le récapitulatif d'un mois sous forme de fichier Markdown — ajoutez « Enregistrer le fichier » après pour le placer dans un dossier, et lancez le raccourci selon un calendrier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա ամփոփումը՝ որպես Markdown ֆայլ։ Թղթապանակում պահելու համար ավելացրեք “Պահել ֆայլը” գործողությունը և գործարկեք դյուրանցումն ըստ ժամանակացույցի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riepilogo di un mese come file Markdown. Aggiungi “Salva file” per salvarlo in una cartella ed esegui il comando rapido secondo una pianificazione."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვის შეჯამება Markdown ფაილად — საქაღალდეში შესანახად დაამატეთ “ფაილის შენახვა” და გაუშვით სწრაფი ბრძანება განრიგით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың қорытындысы Markdown файлы ретінде — кейін «Файлды сақтау» қосыңыз, сонда ол қалтаға түседі, ал жылдамдық командасын кестемен іске қосуға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдын жыйынтыгы Markdown файлы түрүндө — папкага сактоо үчүн андан кийин “Файлды сактоо” аракетин кошуп, буйрукту график боюнча иштетиңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowanie miesiąca jako plik Markdown. Dodaj po nim czynność „Zachowaj plik”, aby umieścić go w folderze, i uruchamiaj skrót zgodnie z harmonogramem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resumo de um mês como arquivo Markdown. Adicione “Salvar Arquivo” em seguida para salvá-lo em uma pasta e programe a execução do atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводка месяца файлом Markdown — добавьте после неё «Сохранить файл», чтобы положить его в папку, и запускайте команду по расписанию."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хулосаи моҳ ҳамчун файли Markdown — барои нигоҳ доштан дар ҷузвдон пас аз он “Нигоҳ доштани файл”-ро илова кунед ва миёнбурро аз рӯи ҷадвал иҷро кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayın özetini Markdown dosyası olarak sunar. Bir klasöre kaydetmek için ardından “Dosyayı Kaydet” ekleyin ve kestirmeyi bir zamanlamaya göre çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумок місяця як файл Markdown — додайте після нього «Зберегти файл», щоб покласти його в теку, і запускайте команду за розкладом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oy hisoboti Markdown fayli sifatida. Uni jildga saqlash uchun keyin “Faylni saqlash” amalini qo'shing va tezkor buyruqni jadval bo'yicha ishga tushiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將月份摘要輸出為 Markdown 檔案。接著加入「儲存檔案」以存入資料夾，並排程執行捷徑。"
          }
        }
      }
    },
