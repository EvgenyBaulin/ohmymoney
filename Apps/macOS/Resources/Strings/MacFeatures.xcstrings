    "mac.print.askMessage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğlər ekranda gizlədilib. Çap edilmiş səhifəni hər kəs görə bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумы схаваныя на экране. Раздрукаваную старонку можа ўбачыць кожны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částky jsou na obrazovce skryté. Vytištěnou stránku může vidět kdokoli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beträge sind auf dem Bildschirm ausgeblendet. Eine gedruckte Seite kann jeder sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amounts are hidden on the screen. A printed page can be seen by anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los importes están ocultos en la pantalla. Cualquiera puede ver una página impresa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les montants sont masqués à l'écran. Une page imprimée peut être vue par n'importe qui."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարները թաքցված են էկրանին։ Տպված էջը կարող է տեսնել ցանկացած մարդ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli importi sono nascosti sullo schermo. Una pagina stampata può essere vista da chiunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上では金額が非表示になっています。プリントしたページは誰でも見ることができます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხები ეკრანზე დამალულია. დაბეჭდილ გვერდს ნებისმიერ მსურველს შეუძლია შეხედოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Экранда сомалар жасырылған. Басып шығарылған бетті кез келген адам көре алады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에서 금액이 가려져 있습니다. 프린트한 내용은 누구나 볼 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммалар экранда жашырылган. Басып чыгарылган баракты каалаган адам көрө алат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bedragen zijn verborgen op het scherm. Een afgedrukte pagina kan door iedereen worden bekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwoty są ukryte na ekranie. Wydrukowaną stronę może zobaczyć każdy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores estão ocultos na tela. Uma página impressa pode ser vista por qualquer pessoa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os montantes estão ocultos no ecrã. Uma página impressa pode ser vista por qualquer pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране суммы скрыты. Напечатанную страницу может увидеть кто угодно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағҳо дар экран пинҳонанд. Саҳифаи чопшударо ҳар кас дида метавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlar ekranda gizli. Yazdırılan sayfa herkes tarafından görülebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На екрані суми приховано. Надрукований аркуш може побачити будь-хто."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
