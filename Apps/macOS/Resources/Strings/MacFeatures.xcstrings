    "mac.settings.spotlight.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the description and the place go into the index of this Mac — no amounts. Operations of hidden accounts are never indexed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la descripción y el lugar entran en el índice de este Mac — sin importes. Las operaciones de cuentas ocultas nunca se indexan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls la description et le lieu entrent dans l'index de ce Mac — aucun montant. Les opérations des comptes masqués ne sont jamais indexées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В индекс этого Mac попадают только описание и место — без сумм. Операции скрытых счетов не индексируются никогда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В індекс цього Mac потрапляють лише опис і місце — без сум. Операції прихованих рахунків ніколи не індексуються."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la descrizione e il luogo vengono indicizzati su questo Mac, senza importi. Le operazioni dei conti nascosti non vengono mai indicizzate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл Mac индексіне тек сипаттама мен орын түседі — сомасыз. Жасырын есеп-шоттардың операциялары ешқашан индекстелмейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У індэкс гэтага Mac трапляюць толькі апісанне і месца, без сум. Аперацыі схаваных рахункаў ніколі не індэксуюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Beschreibung und Ort kommen in den Index dieses Mac — keine Beträge. Vorgänge ausgeblendeter Konten werden nie indexiert."
          }
        }
      }
    },
