    "intent.edit.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the description, the amount or the category of an operation. Fields left empty stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la descripción, el importe o la categoría de una operación. Los campos que queden vacíos se mantienen como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie la description, le montant ou la catégorie d'une opération. Les champs laissés vides restent tels quels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет описание, сумму или категорию операции. Пустые поля остаются как были."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює опис, суму або категорію операції. Поля, що лишилися порожніми, не змінюються."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica la descrizione, l’importo o la categoria di un’operazione. I campi lasciati vuoti restano invariati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцияның сипаттамасын, сомасын немесе санатын өзгертеді. Бос қалдырылған өрістер өзгеріссіз қалады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змяняе апісанне, суму або катэгорыю аперацыі. Пустыя палі застаюцца без змен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Beschreibung, den Betrag oder die Kategorie eines Vorgangs. Leer gelassene Felder bleiben, wie sie sind."
          }
        }
      }
    },
