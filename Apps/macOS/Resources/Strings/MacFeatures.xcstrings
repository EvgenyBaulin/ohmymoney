    "mac.command.confirm": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Yenə də qeyd edilsin?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Усё роўна запісаць?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Přesto zaznamenat?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Trotzdem erfassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Record it anyway?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ¿Registrarla igualmente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La noter quand même ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Այնուամենայնիվ գրանցե՞լ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Registrare comunque?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ それでも記録しますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ მაინც ჩაიწეროს?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Бәрібір жазайық па?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 그래도 기록할까요?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Баары бир жазылсынбы?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Toch registreren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mimo to zapisać?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Registrar mesmo assim?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Registar na mesma?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Всё равно записать?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ба ҳар ҳол сабт шавад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Yine de kaydedilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Записати все одно?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Baribir qayd etilsinmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍要记录吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍要記錄嗎？"
          }
        }
      }
    },
    "mac.command.countQuestion": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmin gün balans yoxlanılıb. Əməliyyatın sayımdan əvvəl olub-olmadığını OhMyMoney-də göstərin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэты дзень баланс быў зверены. Пазначце ў OhMyMoney, ці адбылася аперацыя да падліку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tento den byl ověřen zůstatek. V OhMyMoney určete, zda operace proběhla před ověřením."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo wurde an diesem Tag abgeglichen: Sagen Sie in OhMyMoney, ob der Vorgang vor der Zählung lag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance was reconciled that day: say in OhMyMoney whether the operation was before the count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo se concilió ese día: diga en OhMyMoney si la operación fue antes del recuento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde a été rapproché ce jour-là : indiquez dans OhMyMoney si l'opération a eu lieu avant le comptage."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ օրը մնացորդը ճշտվել է։ OhMyMoney-ում նշեք՝ գործողությունը հաշվարկից առաջ է եղել, թե ոչ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo è stato verificato quel giorno. Indica in OhMyMoney se l’operazione è avvenuta prima della verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日は残高を照合しています。取引が照合前だったかどうかをOhMyMoneyで指定してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იმ დღეს ბალანსი შეჯერებული იყო. მიუთითეთ OhMyMoney-ში, ოპერაცია დათვლამდე მოხდა თუ არა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теңгерім сол күні салыстырылған: OhMyMoney-де операция санаудан бұрын болғанын айтыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 날짜에 잔액을 확인했습니다. 거래가 잔액 확인 전이었는지 OhMyMoney에서 선택하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ал күнү баланс такталган: операция эсептөөгө чейин болгонун OhMyMoney'де көрсөтүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo is op die dag gecontroleerd. Geef in OhMyMoney aan of de transactie vóór de telling plaatsvond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego dnia uzgodniono saldo. Wskaż w OhMyMoney, czy operacja miała miejsce przed uzgodnieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo foi conferido nesse dia. Informe no OhMyMoney se a operação ocorreu antes da conferência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo foi reconciliado nesse dia. Indique no OhMyMoney se a operação ocorreu antes da contagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день была сверка: ответьте в OhMyMoney, была ли операция до неё."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар он рӯз бақия санҷида шудааст: дар OhMyMoney нишон диҳед, ки амалиёт пеш аз ҳисоб буд ё не."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiye o gün mutabık kılınmış. İşlemin sayımdan önce olup olmadığını OhMyMoney'de belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок того дня було звірено: скажіть в OhMyMoney, чи операція була до звірки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O'sha kuni qoldiq tekshirilgan. Operatsiya sanashdan oldin bo'lgan-bo'lmaganini OhMyMoney’da ko'rsating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当天已核对余额，请在 OhMyMoney 中说明交易是否发生在核对之前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天已核對餘額。請在 OhMyMoney 中指定此交易是否發生於核對前。"
          }
        }
      }
    },
    "mac.command.deleteRefused": {
      "extractionState": "manual",
      "localizations": {
