    "intent.focus.description": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Хавае сумы ў OhMyMoney, пакуль гэты рэжым факусавання ўключаны, і паказвае іх пасля яго заканчэння. Сумы, схаваныя вамі, застаюцца схаванымі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Beträge in OhMyMoney aus, solange dieser Fokus eingeschaltet ist, und zeigt sie wieder, wenn er endet. Beträge, die Sie selbst ausgeblendet haben, bleiben ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the amounts in OhMyMoney while this Focus is on and shows them again when it ends. Amounts you hid yourself stay hidden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde gli importi in OhMyMoney mentre questa modalità Full immersion è attiva e li mostra di nuovo al termine. Gli importi nascosti manualmente rimangono nascosti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы Focus қосулы кезде OhMyMoney-де сомаларды жасырады, ол аяқталғанда қайта көрсетеді. Өзіңіз жасырған сомалар жасырын қалады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает суммы в OhMyMoney, пока включён этот фокус, и показывает снова, когда он закончится. Суммы, скрытые вами вручную, останутся скрытыми."
          }
        }
      }
    },
