    "mac.command.archivedLeftovers": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dəyişiklik arxivləşdirilmiş hesabda pul saxlayacaq. Əməliyyatı OhMyMoney-də tamamlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасля змены на архіўным рахунку застануцца грошы. Завяршыце дзеянне ў OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung würde Geld auf einem archivierten Konto lassen: Schließen Sie sie in OhMyMoney ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change would leave money on an archived account: finish it in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio dejaría dinero en una cuenta archivada: termínelo en OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification laisserait de l'argent sur un compte archivé : terminez-la dans OhMyMoney."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոփոխության հետևանքով գումար կմնա արխիվացված հաշվում։ Ավարտեք այն OhMyMoney-ում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica lascerebbe denaro su un conto archiviato. Completa l’operazione in OhMyMoney."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ცვლილების შემდეგ დაარქივებულ ანგარიშზე თანხა დარჩება. დაასრულეთ მოქმედება OhMyMoney-ში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгерту мұрағатталған есеп-шотта ақша қалдырар еді: оны OhMyMoney-де аяқтаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгөртүүдөн кийин архивделген эсепте акча калат: аны OhMyMoney'де бүтүрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tej zmianie na zarchiwizowanym koncie pozostałyby środki. Dokończ ją w OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração deixaria dinheiro em uma conta arquivada. Conclua-a no OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка оставит деньги на счёте в архиве: закончите её в OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пас аз тағйирот дар ҳисоби бойгонӣ пул мемонад: онро дар OhMyMoney анҷом диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu değişiklik arşivlenmiş bir hesapta para bırakır. İşlemi OhMyMoney'de tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна залишила б гроші на архівному рахунку: завершіть її в OhMyMoney."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O'zgarishdan so'ng arxivlangan hisobda pul qoladi. Amalni OhMyMoney’da yakunlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此更改會在已封存的帳戶中留下金額。請在 OhMyMoney 中完成。"
          }
        }
      }
    },
    "mac.command.badDate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sətirdəki tarix və ya saat oxunmur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося распазнаць дату або час у радку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum oder die Uhrzeit der Zeile ist nicht lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date or the time of the line cannot be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer la fecha o la hora de la línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date ou l'heure de la ligne ne se lit pas."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց կարդալ տողի ամսաթիվը կամ ժամը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la data o l’ora nella riga."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სტრიქონში თარიღის ან დროის წაკითხვა ვერ მოხერხდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жолдың күні не уақыты оқылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Саптагы күндү же убакытты окуу мүмкүн эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać daty lub godziny z wiersza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a data ou a hora da linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не понял дату или время в строке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сана ё вақти сатр хонда намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırdaki tarih veya saat okunamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дату або час рядка не вдалося прочитати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qatordagi sana yoki vaqtni o'qib bo'lmadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取輸入內容中的日期或時間。"
          }
        }
      }
    },
    "mac.command.badMonth": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay YYYY-MM formatında yazılır, məsələn, 2026-10."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запішыце месяц як YYYY-MM, напрыклад 2026-10."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monat wird als JJJJ-MM geschrieben, zum Beispiel 2026-10."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month is written as YYYY-MM, for example 2026-10."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes se escribe como AAAA-MM, por ejemplo 2026-10."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mois s'écrit AAAA-MM, par exemple 2026-10."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամիսը գրվում է YYYY-MM ձևաչափով, օրինակ՝ 2026-10։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mese va scritto come AAAA-MM, ad esempio 2026-10."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვე იწერება ფორმატით YYYY-MM, მაგალითად 2026-10."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай YYYY-MM түрінде жазылады, мысалы 2026-10."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай YYYY-MM түрүндө жазылат, мисалы 2026-10."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj miesiąc w formacie RRRR-MM, np. 2026-10."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o formato AAAA-MM para o mês, por exemplo, 2026-10."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц пишется как ГГГГ-ММ, например 2026-10."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моҳро ҳамчун YYYY-MM нависед, масалан 2026-10."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayı YYYY-AA biçiminde yazın, örneğin 2026-10."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць записується як РРРР-ММ, наприклад 2026-10."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyni YYYY-MM shaklida yozing, masalan, 2026-10."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請以 YYYY-MM 格式輸入月份，例如 2026-10。"
          }
        }
      }
    },
    "mac.command.categoryMissing": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sətirdə kateqoriya yoxdur. Onu əlavə edin, məsələn, “qəhvə 250 kafe”, və ya OhMyMoney-də seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У радку няма катэгорыі. Дадайце яе, напрыклад “кава 250 кавярня”, або выберыце ў OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeile nennt keine Kategorie: Fügen Sie sie der Zeile hinzu, zum Beispiel „Kaffee 250 Café“, oder wählen Sie sie in OhMyMoney."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line names no category: add it to the line, for example “coffee 250 cafe”, or choose it in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea no nombra ninguna categoría: añádala a la línea, por ejemplo «café 250 cafetería», o elíjala en OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne ne nomme aucune catégorie : ajoutez-la à la ligne, par exemple « café 250 restaurant », ou choisissez-la dans OhMyMoney."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տողում կատեգորիա նշված չէ։ Ավելացրեք այն տողում, օրինակ՝ “սուրճ 250 սրճարան”, կամ ընտրեք OhMyMoney-ում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga non indica una categoria. Aggiungila, ad esempio “caffè 250 bar”, oppure sceglila in OhMyMoney."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სტრიქონში კატეგორია არ არის მითითებული. დაამატეთ ის, მაგალითად “coffee 250 cafe”, ან აირჩიეთ OhMyMoney-ში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жолда санат аталмаған: оны жолға қосыңыз, мысалы «coffee 250 cafe», не OhMyMoney-де таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сапта категория жок: аны кошуңуз, мисалы “кофе 250 кафе”, же OhMyMoney'де тандаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W wierszu nie podano kategorii. Dodaj ją, np. „coffee 250 cafe”, lub wybierz w OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha não informa uma categoria. Adicione uma, por exemplo, “café 250 cafeteria”, ou escolha-a no OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В строке нет категории: допишите её, например «кофе 250 кафе», или выберите в OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар сатр категория нест: онро илова кунед, масалан “қаҳва 250 қаҳвахона”, ё дар OhMyMoney интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırda kategori belirtilmemiş. Satıra ekleyin, örneğin “kahve 250 kafe”, veya OhMyMoney'de seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У рядку не названо категорії: додайте її в рядок, наприклад «кава 250 кафе», або оберіть в OhMyMoney."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qatorda turkum ko'rsatilmagan. Uni qatorga qo'shing, masalan, “coffee 250 cafe”, yoki OhMyMoney’da tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入內容未指定類別。請加入類別，例如「coffee 250 cafe」，或在 OhMyMoney 中選擇。"
          }
        }
      }
    },
