    "mac.settings.privacy.quiet": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlədildikdə məbləğlər və gizli hesablar göstərilmir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Без сум, калі яны схаваны, без згадак схаваных рахункаў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Beträge bei ausgeblendeten, nichts über ausgeblendete Konten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No amounts while hidden, nothing about hidden accounts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin importes mientras están ocultos, nada de cuentas ocultas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun montant quand masqué, rien sur les comptes masqués"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թաքցված գումարները և հաշիվները չեն ցուցադրվում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun importo quando è nascosto, nessuna notifica sui conti nascosti"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დამალვისას თანხების გარეშე, დამალული ანგარიშების ხსენების გარეშე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасырылған кезде сомасыз, жасырын есеп-шоттар туралы ештеңесіз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммалар жашырылганда көрсөтүлбөйт, жашыруун эсептер айтылбайт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ukrytych kwot i informacji o ukrytych kontach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem valores quando ocultos, sem menção a contas ocultas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без сумм, о скрытых не уведомлять"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бе маблағ ҳангоми пинҳон будан, бе зикри ҳисобҳои пинҳон"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizliyken tutar gösterme, gizli hesaplardan söz etme"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без сум, коли приховано, і нічого про приховані рахунки"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yashirilganda summalar va yashirin hisoblar ko‘rsatilmaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏金額時不顯示金額，也不提及隱藏帳戶"
          }
