    "mac.notify.evening.body": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Або пазначце ў OhMyMoney, што сёння выдаткаў не было."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder sagen Sie in OhMyMoney, dass es heute keine gab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or say in OhMyMoney that there was none today."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure indica in OhMyMoney che oggi non hai avuto spese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немесе OhMyMoney-де бүгін шығын болмағанын айтыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или отметьте в OhMyMoney, что сегодня трат не было."
          }
        }
      }
    },
    "mac.notify.evening.streak": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Працягвайце серыю: ужо %lld дні."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Працягвайце серыю: ужо %lld дзён."
                }
              },
              "one": {
