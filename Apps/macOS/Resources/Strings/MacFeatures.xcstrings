            "value": "Не понял дату или время в строке."
          }
        }
      }
    },
    "mac.command.badMonth": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monat wird als JJJJ-MM geschrieben, zum Beispiel 2026-10."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month is written as YYYY-MM, for example 2026-10."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц пишется как ГГГГ-ММ, например 2026-10."
          }
        }
      }
    },
    "mac.command.categoryMissing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeile nennt keine Kategorie: Fügen Sie sie der Zeile hinzu, zum Beispiel „Kaffee 250 Café“, oder wählen Sie sie in OhMyMoney."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line names no category: add it to the line, for example “coffee 250 cafe”, or choose it in OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В строке нет категории: допишите её, например «кофе 250 кафе», или выберите в OhMyMoney."
          }
        }
      }
    },
    "mac.command.categoryUnknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Kategorie „%@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no category “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории «%@» нет."
          }
        }
      }
    },
    "mac.command.confirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Trotzdem erfassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Record it anyway?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Всё равно записать?"
          }
        }
      }
    },
    "mac.command.countQuestion": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo wurde an diesem Tag abgeglichen: Sagen Sie in OhMyMoney, ob der Vorgang vor der Zählung lag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance was reconciled that day: say in OhMyMoney whether the operation was before the count."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день была сверка: ответьте в OhMyMoney, была ли операция до неё."
          }
        }
      }
    },
    "mac.command.deleteRefused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Vorgang kann von hier nicht gelöscht werden: Öffnen Sie ihn in OhMyMoney."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation cannot be deleted from here: open it in OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту операцию отсюда удалить нельзя: откройте её в OhMyMoney."
          }
        }
      }
    },
    "mac.command.deleted": {
