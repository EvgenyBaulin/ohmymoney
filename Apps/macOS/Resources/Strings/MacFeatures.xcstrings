    "mac.notify.limit.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay %2$@ limitindən %1$@ xərclənib"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэты месяц выдаткавана %1$@ з %2$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento měsíc utraceno %1$@ z %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat %1$@ von %2$@ ausgegeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spent %1$@ of %2$@ this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastado %1$@ de %2$@ este mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépensé %1$@ sur %2$@ ce mois-ci"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս ծախսվել է %1$@՝ %2$@-ից"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesi %1$@ di %2$@ questo mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の支出：%1$@／%2$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში დაიხარჯა %1$@ / %2$@"
