    "mac.command.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur ansehen“ ist eingeschaltet: Nichts kann hinzugefügt, geändert oder gelöscht werden."
