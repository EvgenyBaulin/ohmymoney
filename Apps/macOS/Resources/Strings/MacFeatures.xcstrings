        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գործողությունն այստեղից ջնջել հնարավոր չէ։ Բացեք այն OhMyMoney-ում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare questa operazione da qui. Aprila in OhMyMoney."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ოპერაციის აქედან წაშლა შეუძლებელია. გახსენით ის OhMyMoney-ში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл операцияны осы жерден жоюға болмайды: оны OhMyMoney-де ашыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул операцияны бул жерден өчүрүү мүмкүн эмес: аны OhMyMoney'де ачыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można stąd usunąć tej operacji. Otwórz ją w OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operação não pode ser apagada aqui. Abra-a no OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту операцию отсюда удалить нельзя: откройте её в OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин амалиётро аз ин ҷо нест кардан мумкин нест: онро дар OhMyMoney кушоед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem buradan silinemez. OhMyMoney'de açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю операцію звідси видалити не можна: відкрийте її в OhMyMoney."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu operatsiyani bu yerdan o'chirib bo'lmaydi. Uni OhMyMoney’da oching."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在此刪除此交易。請在 OhMyMoney 中開啟。"
          }
        }
      }
    },
