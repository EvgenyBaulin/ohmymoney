    "intent.delete.description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siyahıdakı “Sil” əmri kimi əməliyyatı silir. OhMyMoney-də ⌘Z ilə geri qaytarıla bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаляе аперацыю, як кнопка “Выдаліць” у спісе. ⌘Z у OhMyMoney аднаўляе яе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht einen Vorgang, wie „Löschen“ in der Liste. ⌘Z in OhMyMoney holt ihn zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes an operation, as “Delete” in the list does. ⌘Z in OhMyMoney brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina una operación, como lo hace «Eliminar» en la lista. ⌘Z en OhMyMoney la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime une opération, comme le fait « Supprimer » dans la liste. ⌘Z dans OhMyMoney la rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջում է գործողությունը՝ ցանկի “Ջնջել” հրամանի պես։ OhMyMoney-ում ⌘Z-ը վերականգնում է այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina un’operazione, come il comando “Elimina” nell’elenco. Puoi ripristinarla con ⌘Z in OhMyMoney."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შლის ოპერაციას, როგორც სიაში ღილაკით “წაშლა”. აღსადგენად დააჭირეთ ⌘Z-ს OhMyMoney-ში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тізімдегі «Жою» сияқты операцияны жояды. OhMyMoney-дегі ⌘Z оны қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тизмедеги “Өчүрүү” сыяктуу операцияны өчүрөт. OhMyMoney'де ⌘Z менен калыбына келтирилет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa operację tak jak polecenie „Usuń” na liście. Aby ją przywrócić, naciśnij ⌘Z w OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga uma operação, como a opção “Apagar” na lista. ⌘Z no OhMyMoney a restaura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет операцию, как «Удалить» в списке. Вернуть — ⌘Z в OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиётро мисли “Нест кардан” дар рӯйхат нест мекунад. ⌘Z дар OhMyMoney онро барқарор мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listedeki “Sil” gibi bir işlemi siler. OhMyMoney'de ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє операцію, так само як «Видалити» у списку. ⌘Z в OhMyMoney її повертає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiyani ro'yxatdagi “O'chirish” kabi o'chiradi. OhMyMoney’da ⌘Z bilan uni tiklash mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除交易，與列表中的「刪除」相同。可在 OhMyMoney 中按 ⌘Z 復原。"
          }
        }
      }
    },
    "intent.delete.description.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siyahıdakı “Sil” əmri kimi əməliyyatı silir. OhMyMoney-də “Geri al” düyməsi ilə geri qaytarıla bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаляе аперацыю, як кнопка “Выдаліць” у спісе. Кнопка “Адмяніць” у OhMyMoney аднаўляе яе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht einen Vorgang, wie „Löschen“ in der Liste. Die Schaltfläche „Rückgängig“ in OhMyMoney holt ihn zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes an operation, as “Delete” in the list does. the “Undo” button in OhMyMoney brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina una operación, como lo hace «Eliminar» en la lista. El botón «Deshacer» en OhMyMoney la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime une opération, comme le fait « Supprimer » dans la liste. Le bouton « Annuler » dans OhMyMoney la rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջում է գործողությունը՝ ցանկի “Ջնջել” հրամանի պես։ OhMyMoney-ի “Հետարկել” կոճակը վերականգնում է այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina un’operazione, come il comando “Elimina” nell’elenco. Puoi ripristinarla con il pulsante “Annulla” in OhMyMoney."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შლის ოპერაციას, როგორც სიაში ღილაკით “წაშლა”. აღსადგენად დააჭირეთ ღილაკს “გაუქმება” OhMyMoney-ში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тізімдегі «Жою» сияқты операцияны жояды. OhMyMoney-дегі «Болдырмау» түймесі оны қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тизмедеги “Өчүрүү” сыяктуу операцияны өчүрөт. OhMyMoney'деги “Артка кайтаруу” баскычы менен калыбына келтирилет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa operację tak jak polecenie „Usuń” na liście. Aby ją przywrócić, stuknij „Cofnij” w OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga uma operação, como a opção “Apagar” na lista. O botão “Desfazer” no OhMyMoney a restaura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет операцию, как «Удалить» в списке. Кнопка «Отменить» в OhMyMoney вернёт её."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиётро мисли “Нест кардан” дар рӯйхат нест мекунад. Тугмаи “Бекор кардан” дар OhMyMoney онро барқарор мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listedeki “Sil” gibi bir işlemi siler. OhMyMoney'deki “Geri Al” düğmesiyle geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє операцію, так само як «Видалити» у списку. Кнопка «Скасувати» в OhMyMoney її повертає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiyani ro'yxatdagi “O'chirish” kabi o'chiradi. OhMyMoney’dagi “Bekor qilish” tugmasi bilan uni tiklash mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除交易，與列表中的「刪除」相同。可在 OhMyMoney 中點一下「復原」來還原。"
          }
        }
      }
    },
