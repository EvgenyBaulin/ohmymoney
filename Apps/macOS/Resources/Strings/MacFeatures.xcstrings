    "intent.focus.description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Fokus aktiv olarkən OhMyMoney-də məbləğləri gizlədir və bitdikdə yenidən göstərir. Özünüz gizlətdiyiniz məbləğlər gizli qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Хавае сумы ў OhMyMoney, пакуль гэты рэжым факусавання ўключаны, і паказвае іх пасля яго заканчэння. Сумы, схаваныя вамі, застаюцца схаванымі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dobu zapnutí tohoto soustředění skryje částky v OhMyMoney a po jeho skončení je znovu zobrazí. Částky, které jste skryli sami, zůstanou skryté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Beträge in OhMyMoney aus, solange dieser Fokus eingeschaltet ist, und zeigt sie wieder, wenn er endet. Beträge, die Sie selbst ausgeblendet haben, bleiben ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the amounts in OhMyMoney while this Focus is on and shows them again when it ends. Amounts you hid yourself stay hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los importes en OhMyMoney mientras este Enfoque está activo y los vuelve a mostrar cuando termina. Los importes que usted ocultó a mano siguen ocultos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les montants dans OhMyMoney tant que cette Concentration est active, et les affiche à nouveau à sa fin. Les montants que vous avez masqués vous-même restent masqués."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թաքցնում է գումարները OhMyMoney-ում, քանի դեռ այս կենտրոնացումը միացված է, և ավարտվելուց հետո կրկին ցուցադրում է դրանք։ Ձեր թաքցրած գումարները մնում են թաքցված։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde gli importi in OhMyMoney mentre questa modalità Full immersion è attiva e li mostra di nuovo al termine. Gli importi nascosti manualmente rimangono nascosti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この集中モードがオンの間、OhMyMoneyの金額を非表示にし、終了すると再表示します。自分で非表示にした金額はそのままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ფოკუსის ჩართვისას მალავს თანხებს OhMyMoney-ში და დასრულებისას კვლავ აჩვენებს. თქვენ მიერ დამალული თანხები დამალული დარჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы Focus қосулы кезде OhMyMoney-де сомаларды жасырады, ол аяқталғанда қайта көрсетеді. Өзіңіз жасырған сомалар жасырын қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 집중 모드가 켜져 있는 동안 OhMyMoney의 금액을 가리고, 종료되면 다시 표시합니다. 직접 가린 금액은 계속 가려집니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул Фокус күйүп турганда OhMyMoney'деги суммаларды жашырып, аяктаганда кайра көрсөтөт. Өзүңүз жашырган суммалар жашыруун бойдон калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbergt bedragen in OhMyMoney zolang deze focus actief is en toont ze weer zodra de focus eindigt. Bedragen die je zelf hebt verborgen, blijven verborgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrywa kwoty w OhMyMoney na czas włączenia tego trybu skupienia, a po jego zakończeniu pokazuje je ponownie. Kwoty ukryte ręcznie pozostają ukryte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os valores no OhMyMoney enquanto este Foco estiver ativo e os mostra novamente quando terminar. Os valores ocultados por você permanecem ocultos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os montantes no OhMyMoney enquanto este modo de concentração está ativo e volta a mostrá-los quando termina. Os montantes que ocultou mantêm-se ocultos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает суммы в OhMyMoney, пока включён этот фокус, и показывает снова, когда он закончится. Суммы, скрытые вами вручную, останутся скрытыми."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми фаъол будани ин Фокус маблағҳоро дар OhMyMoney пинҳон мекунад ва пас аз анҷомаш боз нишон медиҳад. Маблағҳое, ки худатон пинҳон кардед, пинҳон мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Odak açıkken OhMyMoney'deki tutarları gizler ve sona erdiğinde yeniden gösterir. Kendiniz gizlediğiniz tutarlar gizli kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховує суми в OhMyMoney, поки ввімкнено цей Фокус, і показує їх знову, коли він завершується. Суми, які ви приховали самі, лишаються прихованими."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushbu Fokus yoqilganda OhMyMoney’da summalarni yashiradi va o'chirilganda yana ko'rsatadi. O'zingiz yashirgan summalar yashirin qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此专注模式开启时隐藏 OhMyMoney 中的金额，结束后再次显示。你自行隐藏的金额仍会保持隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此專注模式開啟時隱藏 OhMyMoney 中的金額，結束時再次顯示。自行隱藏的金額會保持隱藏。"
          }
        }
      }
    },
