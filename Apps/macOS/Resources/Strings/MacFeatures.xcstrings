    "intent.find.description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsvir, məkan və ya kateqoriyadakı sözə görə əməliyyatları tapır. Gizli hesablardakı əməliyyatlar göstərilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходзіць аперацыі па слове з апісання, месцы або катэгорыі. Аперацыі схаваных рахункаў не паказваюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet Vorgänge über ein Wort der Beschreibung, den Ort oder die Kategorie. Vorgänge ausgeblendeter Konten werden nie gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds operations by a word of the description, the place or the category. Operations of hidden accounts are never found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra operaciones por una palabra de la descripción, el lugar o la categoría. Las operaciones de cuentas ocultas nunca se encuentran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve des opérations par un mot de la description, du lieu ou de la catégorie. Les opérations des comptes masqués ne sont jamais trouvées."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գտնում է գործողություններն ըստ նկարագրության բառի, վայրի կամ կատեգորիայի։ Թաքցված հաշիվների գործողությունները չեն ցուցադրվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova le operazioni in base a una parola della descrizione, del luogo o della categoria. Le operazioni dei conti nascosti non vengono mai trovate."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პოულობს ოპერაციებს აღწერის, ადგილის ან კატეგორიის სიტყვის მიხედვით. დამალული ანგარიშების ოპერაციები არ იძებნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцияларды сипаттаманың, орынның немесе санаттың сөзі бойынша табады. Жасырын есеп-шоттардың операциялары ешқашан табылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцияларды сүрөттөмөсүндөгү сөз, жер же категория боюнча табат. Жашырылган эсептердин операциялары табылбайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajduje operacje według słowa z opisu, miejsca lub kategorii. Operacje ukrytych kont nie są wyszukiwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca operações por uma palavra da descrição, do local ou da categoria. Operações de contas ocultas nunca são encontradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет операции по слову из описания, места или категории. Операции скрытых счетов не находятся никогда."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиётҳоро аз рӯи калимаи тавсиф, ҷой ё категория меёбад. Амалиёти ҳисобҳои пинҳон ёфт намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemleri açıklama, yer veya kategorideki bir sözcüğe göre bulur. Gizli hesapların işlemleri bulunmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходить операції за словом з опису, місця або категорії. Операції прихованих рахунків ніколи не знаходяться."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiyalarni tavsif, joy yoki turkumdagi so'z bo'yicha topadi. Yashirilgan hisoblar operatsiyalari topilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依描述、地點或類別中的字詞尋找交易。不會搜尋隱藏帳戶的交易。"
          }
        }
      }
    },
