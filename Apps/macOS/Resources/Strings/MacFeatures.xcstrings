    "mac.settings.privacy.anonymous": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli hesablar: ad və məbləğ olmadan “Ödəniş sabahdır”"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Схаваныя рахункі: «Заўтра тэрмін плацяжу» без назвы і сумы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Konten: „Zahlung morgen fällig“ ohne Name oder Betrag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden accounts: “Payment due tomorrow” without name or amount"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentas ocultas: «Pago que vence mañana» sin nombre ni importe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptes masqués : « Paiement échu demain » sans nom ni montant"
