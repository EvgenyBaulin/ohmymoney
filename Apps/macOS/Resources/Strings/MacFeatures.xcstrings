    "mac.settings.spotlight.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac-da yalnız təsvir və məkan indekslənir, məbləğlər yox. Gizli hesabların əməliyyatları heç vaxt indekslənmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У індэкс гэтага Mac трапляюць толькі апісанне і месца, без сум. Аперацыі схаваных рахункаў ніколі не індэксуюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Beschreibung und Ort kommen in den Index dieses Mac — keine Beträge. Vorgänge ausgeblendeter Konten werden nie indexiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the description and the place go into the index of this Mac — no amounts. Operations of hidden accounts are never indexed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la descripción y el lugar entran en el índice de este Mac — sin importes. Las operaciones de cuentas ocultas nunca se indexan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls la description et le lieu entrent dans l'index de ce Mac — aucun montant. Les opérations des comptes masqués ne sont jamais indexées."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս Mac-ում ինդեքսավորվում են միայն նկարագրությունն ու վայրը՝ առանց գումարների։ Թաքցված հաշիվների գործարքները չեն ինդեքսավորվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la descrizione e il luogo vengono indicizzati su questo Mac, senza importi. Le operazioni dei conti nascosti non vengono mai indicizzate."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ Mac-ის ინდექსში მხოლოდ აღწერა და ადგილი ხვდება — თანხების გარეშე. დამალული ანგარიშების ოპერაციები არ ინდექსდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл Mac индексіне тек сипаттама мен орын түседі — сомасыз. Жасырын есеп-шоттардың операциялары ешқашан индекстелмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул Mac'тин индексине сүрөттөмө жана жер гана кошулат — суммалар кошулбайт. Жашыруун эсептердин операциялары индекстелбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks tego Maca zawiera tylko opis i miejsce, bez kwot. Operacje na ukrytych kontach nigdy nie są indeksowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas a descrição e o local são indexados neste Mac, sem valores. Operações de contas ocultas nunca são indexadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В индекс этого Mac попадают только описание и место — без сумм. Операции скрытых счетов не индексируются никогда."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо тавсиф ва ҷой дар ин Mac индексатсия мешаванд — бе маблағ. Амалиёти ҳисобҳои пинҳон индексатсия намешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’in dizinine yalnızca açıklama ve yer eklenir; tutarlar eklenmez. Gizli hesapların işlemleri hiçbir zaman dizine eklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В індекс цього Mac потрапляють лише опис і місце — без сум. Операції прихованих рахунків ніколи не індексуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac indeksiga faqat tavsif va joy kiritiladi, summalar kiritilmaydi. Yashirin hisoblar amallari indekslanmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 的索引僅包含描述和地點，不含金額。隱藏帳戶的交易一律不會編入索引。"
          }
        }
      }
    },
