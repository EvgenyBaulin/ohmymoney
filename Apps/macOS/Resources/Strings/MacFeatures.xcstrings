    "mac.notify.limit.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay %2$@ limitindən %1$@ xərclənib"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэты месяц выдаткавана %1$@ з %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat %1$@ von %2$@ ausgegeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spent %1$@ of %2$@ this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastado %1$@ de %2$@ este mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépensé %1$@ sur %2$@ ce mois-ci"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս ծախսվել է %1$@՝ %2$@-ից"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesi %1$@ di %2$@ questo mese"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში დაიხარჯა %1$@ / %2$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда %1$@ / %2$@ жұмсалды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда %2$@ ичинен %1$@ сарпталды"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu wydano %1$@ z %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ gastos neste mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрачено %1$@ из %2$@ за месяц"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин моҳ %1$@ аз %2$@ сарф шуд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay %2$@ limitinin %1$@ kadarı harcandı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього місяця витрачено %1$@ з %2$@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy %2$@ dan %1$@ sarflandi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月已花費 %1$@，額度為 %2$@"
          }
        }
      }
    },
    "mac.notify.limit.bodyHidden": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiti görmək üçün Planlaşdırmanı açın"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрыйце Планаванне, каб убачыць ліміт"
          }
        },
