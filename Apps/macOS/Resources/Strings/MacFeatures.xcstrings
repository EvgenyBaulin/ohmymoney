    "intent.summary.description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın mətn xülasəsi: gəlir, xərclər, kateqoriyalar, məkanlar. Ay seçilmədikdə son başa çatmış ay göstərilir. “Məbləğləri gizlət” aktivdirsə, məbləğlər göstərilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Агляд месяца ў выглядзе тэксту: даходы, выдаткі, катэгорыі, месцы. Калі месяц не пазначаны — апошні завершаны. Калі ўключана “Схаваць сумы”, сумы не паказваюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehled měsíce jako text: příjmy, výdaje, kategorie a místa. Bez zadaného měsíce zobrazí poslední dokončený měsíc. Při zapnuté volbě „Skrýt částky“ nezobrazí částky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zusammenfassung eines Monats als Text: Einnahmen, Ausgaben, Kategorien, Orte. Ohne Monat — der letzte abgeschlossene. Mit eingeschaltetem „Beträge ausblenden“ ohne Beträge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summary of a month as text: income, spending, categories, places. Without a month — the last finished one. With “Hide Amounts” on, without amounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen de un mes como texto: ingresos, gastos, categorías, lugares. Sin mes — el último terminado. Con «Ocultar importes» activado, sin importes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le récapitulatif d'un mois sous forme de texte : revenus, dépenses, catégories, lieux. Sans mois — le dernier terminé. Avec « Masquer les montants » activé, sans montants."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա տեքստային ամփոփում՝ եկամուտներ, ծախսեր, կատեգորիաներ, վայրեր։ Եթե ամիսը նշված չէ՝ վերջին ավարտված ամիսը։ “Թաքցնել գումարները” միացված լինելու դեպքում՝ առանց գումարների։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riepilogo di un mese come testo: entrate, spese, categorie e luoghi. Se non specifichi un mese, viene usato l’ultimo mese concluso. Se “Nascondi importi” è attivo, gli importi non vengono mostrati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の概要をテキストで表示します。収入、支出、カテゴリ、場所が含まれます。月を指定しない場合は、直近の終了した月が対象です。「金額を非表示」がオンの場合、金額は表示されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვის შეჯამება ტექსტად: შემოსავალი, ხარჯები, კატეგორიები, ადგილები. თვის მითითების გარეშე — ბოლო დასრულებული თვე. “თანხების დამალვის” ჩართვისას — თანხების გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың қорытындысы мәтін ретінде: табыс, шығыс, санаттар, орындар. Ай көрсетілмесе — соңғы аяқталған ай. «Сомаларды жасыру» қосулы болса — сомасыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수입, 지출, 카테고리, 장소를 텍스트로 요약합니다. 월을 지정하지 않으면 지난달을 표시합니다. “금액 가리기”가 켜져 있으면 금액을 표시하지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдын жыйынтыгы текст түрүндө: киреше, чыгаша, категориялар, жерлер. Ай көрсөтүлбөсө, акыркы аяктаган ай алынат. “Суммаларды жашыруу” күйүп турса, суммалар көрсөтүлбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maandoverzicht als tekst: inkomsten, uitgaven, categorieën en plaatsen. Zonder opgegeven maand wordt de laatst afgesloten maand gebruikt. Als ‘Verberg bedragen’ aanstaat, worden bedragen weggelaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstowe podsumowanie miesiąca: przychody, wydatki, kategorie i miejsca. Bez wskazania miesiąca używany jest ostatni zakończony miesiąc. Gdy opcja „Ukryj kwoty” jest włączona, podsumowanie nie zawiera kwot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resumo de um mês em texto: receitas, despesas, categorias e locais. Sem um mês, usa o último concluído. Com “Ocultar Valores” ativado, não mostra valores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O resumo de um mês em texto: receitas, despesas, categorias e locais. Sem indicar um mês, usa o último mês completo. Com “Ocultar montantes” ativo, não mostra montantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводка месяца текстом: доходы, расходы, категории, места. Без месяца — последний закончившийся. При «Скрыть суммы» — без сумм."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хулосаи моҳ ҳамчун матн: даромад, хароҷот, категорияҳо, ҷойҳо. Бе интихоби моҳ — моҳи охирини анҷомёфта. Ҳангоми фаъол будани “Пинҳон кардани маблағҳо” — бе маблағҳо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayın metin olarak özeti: gelir, gider, kategoriler ve yerler. Ay belirtilmezse son tamamlanan ay kullanılır. “Tutarları Gizle” açıkken tutarlar gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумок місяця текстом: доходи, витрати, категорії, місця. Без місяця — останній завершений. Коли ввімкнено «Приховати суми», — без сум."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oy hisoboti matn shaklida: daromad, xarajatlar, turkumlar va joylar. Oy ko'rsatilmasa, oxirgi tugagan oy olinadi. “Summalarni yashirish” yoqilganda summalar ko'rsatilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以文本显示月度摘要，包括收入、支出、类别和地点。未指定月份时显示上一个完整月份。开启“隐藏金额”时不显示金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以文字顯示月份摘要：收入、支出、類別和地點。未指定月份時，顯示上一個完整月份。「隱藏金額」開啟時不顯示金額。"
          }
        }
      }
    },
