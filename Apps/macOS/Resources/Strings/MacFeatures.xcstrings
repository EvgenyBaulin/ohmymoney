    "mac.print.ask": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğlərlə çap edilsin?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Друкаваць з сумамі?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tisknout s částkami?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Beträgen drucken?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Print with amounts?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Imprimir con importes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprimer avec les montants ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տպե՞լ գումարներով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stampare con gli importi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額を表示してプリントしますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაიბეჭდოს თანხებით?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сомалармен басып шығарылсын ба?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액을 포함하여 프린트할까요?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммалар менен басып чыгарылсынбы?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afdrukken met bedragen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukować z kwotami?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprimir com valores?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprimir com montantes?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатать с суммами?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо маблағҳо чоп шавад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlarla yazdırılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Друкувати із сумами?"
