    "intent.delete.description": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаляе аперацыю, як кнопка “Выдаліць” у спісе. ⌘Z у OhMyMoney аднаўляе яе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht einen Vorgang, wie „Löschen“ in der Liste. ⌘Z in OhMyMoney holt ihn zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes an operation, as “Delete” in the list does. ⌘Z in OhMyMoney brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina una operación, como lo hace «Eliminar» en la lista. ⌘Z en OhMyMoney la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime une opération, comme le fait « Supprimer » dans la liste. ⌘Z dans OhMyMoney la rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina un’operazione, come il comando “Elimina” nell’elenco. Puoi ripristinarla con ⌘Z in OhMyMoney."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тізімдегі «Жою» сияқты операцияны жояды. OhMyMoney-дегі ⌘Z оны қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa operację tak jak polecenie „Usuń” na liście. Aby ją przywrócić, naciśnij ⌘Z w OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет операцию, как «Удалить» в списке. Вернуть — ⌘Z в OhMyMoney."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listedeki “Sil” gibi bir işlemi siler. OhMyMoney'de ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє операцію, так само як «Видалити» у списку. ⌘Z в OhMyMoney її повертає."
          }
        }
      }
    },
