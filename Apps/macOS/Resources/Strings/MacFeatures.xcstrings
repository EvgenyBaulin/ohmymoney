    "mac.settings.evening": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xərcləri qeyd etmək üçün axşam xatırlatması"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вячэрні напамін пра запіс выдаткаў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Večerní připomínka záznamu výdajů"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abendliche Erinnerung, Ausgaben zu erfassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening reminder to record spending"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorio nocturno para anotar los gastos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappel du soir pour noter les dépenses"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծախսերը գրանցելու երեկոյան հիշեցում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria serale per registrare le spese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出の記録を夜に通知"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საღამოს შეხსენება ხარჯების ჩასაწერად"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығынды жазуға кешкі еске салу"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁 지출 기록 미리 알림"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чыгымдарды жазуу үчүн кечки эскертме"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Avondherinnering om uitgaven vast te leggen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczorne przypomnienie o zapisaniu wydatków"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete noturno para registrar gastos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete à noite para registar despesas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечером — напомнить записать траты"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ёдраскунии бегоҳӣ барои сабти хароҷот"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam harcama kaydetme anımsatıcısı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечірнє нагадування записати витрати"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajatlarni kiritish uchun kechki eslatma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚间记账提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上提醒記錄支出"
          }
        }
      }
    },
    "mac.settings.footer.always": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlərdə gizli hesablar daxil olmaqla həmişə ad və məbləğ göstərilir. Mac-ın yaxınlığındakı hər kəs onları ekranda görə bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апавяшчэнні заўсёды паказваюць назву і суму, у тым ліку для схаваных рахункаў. Іх можа ўбачыць на экране кожны, хто побач з Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení vždy zobrazují název a částku, a to i u skrytých účtů. Na obrazovce je může vidět kdokoli v blízkosti Macu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen zeigen immer Name und Betrag, auch bei ausgeblendeten Konten. Sie können von jedem in der Nähe des Mac auf dem Bildschirm gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications always show the name and the amount, hidden accounts included. They can be seen on the screen by anyone near the Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones muestran siempre el nombre y el importe, también de las cuentas ocultas. Cualquiera cerca del Mac puede verlas en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications affichent toujours le nom et le montant, comptes masqués compris. Chacun près du Mac peut les voir à l'écran."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծանուցումները միշտ ցույց են տալիս անվանումը և գումարը՝ ներառյալ թաքցված հաշիվներինը։ Դրանք կարող են տեսնել Mac-ի մոտ գտնվող բոլորը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche mostrano sempre il nome e l’importo, anche per i conti nascosti. Sono visibili sullo schermo a chiunque si trovi vicino al Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知には、非表示の口座を含め、名前と金額が常に表示されます。Macの近くにいる人にも画面上で見えることがあります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეტყობინებებში ყოველთვის ჩანს სახელი და თანხა, მათ შორის დამალული ანგარიშებისთვისაც. მათი დანახვა შეუძლია ნებისმიერს, ვინც Mac-თან ახლოსაა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабарландырулар әрқашан атауы мен сомасын көрсетеді, жасырын есеп-шоттарды қоса. Mac-қа жақын адам экранда көре алады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에 가려진 계좌를 포함한 모든 계좌의 이름과 금액이 항상 표시됩니다. Mac 주변의 누구나 화면에서 볼 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Билдирмелерде жашыруун эсептердин да аталышы жана суммасы дайыма көрсөтүлөт. Аларды Mac жанындагы ар ким экрандан көрө алат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen tonen altijd de naam en het bedrag, ook voor verborgen rekeningen. Iedereen in de buurt van de Mac kan ze op het scherm zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia zawsze pokazują nazwę i kwotę, także dla ukrytych kont. Może je zobaczyć każda osoba w pobliżu Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações sempre mostram o nome e o valor, incluindo os de contas ocultas. Qualquer pessoa perto do Mac pode vê-los na tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações mostram sempre o nome e o montante, mesmo para contas ocultas. Qualquer pessoa perto do Mac pode vê-las no ecrã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления всегда показывают название и сумму, в том числе скрытых счетов. Их увидит любой, кто рядом с Mac."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Огоҳиҳо ҳамеша ном ва маблағро нишон медиҳанд, аз ҷумла барои ҳисобҳои пинҳон. Онҳоро ҳар касе, ки дар назди Mac аст, дар экран дида метавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimlerde gizli hesaplar dahil her zaman ad ve tutar gösterilir. Bunlar Mac’in yakınındaki herkes tarafından görülebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення завжди показують назву й суму, у тому числі для прихованих рахунків. Їх може побачити на екрані будь-хто поруч із Mac."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirishnomalarda har doim nom va summa, jumladan yashirin hisoblar ham ko‘rsatiladi. Ularni Mac yaqinidagi har kim ekranda ko‘rishi mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知始终显示名称和金额，包括隐藏账户的信息。Mac 附近的任何人都可能看到屏幕上的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知一律顯示名稱和金額，包括隱藏的帳戶。Mac 附近的任何人都可能在螢幕上看到。"
          }
        }
      }
    },
    "mac.settings.footer.anonymous": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğlər gizlədilərkən bildirişlərdə göstərilmir; gizli hesabın ödənişi adı və məbləği olmadan “Ödəniş sabahdır” kimi bildirilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі сумы схаваны, апавяшчэнні іх не паказваюць. Пра плацёж па схаваным рахунку паведамляецца як «Заўтра тэрмін плацяжу», без назвы і сумы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když jsou částky skryté, oznámení je nezobrazují. Platba ze skrytého účtu se oznámí jako „Zítra splatná platba“ bez názvu a částky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange die Beträge ausgeblendet sind, zeigen Mitteilungen keine; eine Zahlung eines ausgeblendeten Kontos wird als „Zahlung morgen fällig“ angekündigt, ohne Name und Betrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the amounts are hidden, notifications show none; a payment of a hidden account is announced as “Payment due tomorrow”, without its name and amount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras los importes están ocultos, las notificaciones no muestran ninguno; un pago de una cuenta oculta se anuncia como «Pago que vence mañana», sin su nombre ni su importe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que les montants sont masqués, les notifications n'en affichent aucun ; un paiement d'un compte masqué est annoncé « Paiement échu demain », sans son nom ni son montant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբ գումարները թաքցված են, ծանուցումները դրանք չեն ցուցադրում։ Թաքցված հաշվի վճարման մասին ծանուցումը ցույց է տալիս «Վճարումը՝ վաղը»՝ առանց անվանման և գումարի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando gli importi sono nascosti, le notifiche non li mostrano; un pagamento di un conto nascosto è annunciato come “Pagamento in scadenza domani”, senza nome né importo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額を非表示にしている間、通知に金額は表示されません。非表示の口座の支払いは、名前と金額を伏せて「明日が支払期限です」と通知されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როცა თანხები დამალულია, ისინი შეტყობინებებშიც არ ჩანს; დამალული ანგარიშის გადახდა ცხადდება როგორც „გადახდა ხვალაა“, სახელისა და თანხის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сомалар жасырылған кезде хабарландыруда ештеңе көрсетілмейді; жасырын есеп-шоттың төлемі атаусыз және сомасыз, «Ертең мерзімі» деп хабарланады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액이 가려진 동안에는 알림에 금액이 표시되지 않습니다. 가려진 계좌의 결제는 이름과 금액 없이 “내일 결제 예정”으로 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммалар жашырылганда билдирмелерде көрсөтүлбөйт; жашыруун эсептин төлөмү аталышы жана суммасы жок «Төлөм эртең» деп билдирилет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer bedragen verborgen zijn, tonen meldingen geen bedragen. Een betaling van een verborgen rekening wordt zonder naam en bedrag aangekondigd als ‘Betaling morgen verschuldigd’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy kwoty są ukryte, powiadomienia ich nie pokazują. Płatność z ukrytego konta jest zapowiadana jako „Płatność jutro”, bez nazwy i kwoty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando os valores estão ocultos, as notificações não os mostram. O pagamento de uma conta oculta é anunciado como “Pagamento vence amanhã”, sem nome nem valor."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando os montantes estão ocultos, as notificações não os mostram; um pagamento de uma conta oculta é anunciado como “Pagamento amanhã”, sem nome nem montante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока суммы скрыты, уведомления их не показывают; платёж скрытого счёта приходит как «Платёж завтра» — без имени и суммы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вақте ки маблағҳо пинҳонанд, онҳо дар огоҳиҳо нишон дода намешаванд; пардохти ҳисоби пинҳон ҳамчун «Пардохт пагоҳ» бе ном ва маблағ эълон мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlar gizliyken bildirimlerde tutar gösterilmez; gizli bir hesabın ödemesi, adı ve tutarı olmadan “Yarın ödeme var” olarak bildirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки суми приховано, сповіщення їх не показують; платіж прихованого рахунку оголошується як «Завтра платіж» — без його назви й суми."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Summalar yashirilganda bildirishnomalarda ko‘rsatilmaydi; yashirin hisob to‘lovi nomi va summasisiz “To‘lov ertaga” deb bildiriladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏金额时，通知不会显示金额；隐藏账户的付款会显示为“明日到期付款”，不显示名称和金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏金額時，通知不會顯示金額；隱藏帳戶的付款會顯示為「明天到期的付款」，不顯示名稱和金額。"
          }
        }
      }
    },
    "mac.settings.footer.quiet": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğlər gizlədilərkən bildirişlərdə göstərilmir və gizli hesablar barədə məlumat verilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі сумы схаваны, апавяшчэнні іх не паказваюць і ніколі не згадваюць схаваныя рахункі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když jsou částky skryté, oznámení je nezobrazují a skryté účty vůbec nezmiňují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange die Beträge ausgeblendet sind, zeigen Mitteilungen keine, und ein ausgeblendetes Konto wird nie erwähnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the amounts are hidden, notifications show none, and a hidden account is never mentioned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras los importes están ocultos, las notificaciones no muestran ninguno, y una cuenta oculta nunca se menciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que les montants sont masqués, les notifications n'en affichent aucun, et un compte masqué n'est jamais mentionné."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբ գումարները թաքցված են, ծանուցումները դրանք չեն ցուցադրում և չեն հիշատակում թաքցված հաշիվները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando gli importi sono nascosti, le notifiche non li mostrano e non menzionano mai i conti nascosti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額を非表示にしている間、通知に金額は表示されず、非表示の口座についても通知されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როცა თანხები დამალულია, ისინი შეტყობინებებშიც არ ჩანს, დამალული ანგარიშები კი საერთოდ არ იხსენიება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сомалар жасырылған кезде хабарландыруда ештеңе көрсетілмейді, жасырын есеп-шот ешқашан аталмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액이 가려진 동안에는 알림에 금액이 표시되지 않으며, 가려진 계좌는 표시되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммалар жашырылганда билдирмелерде көрсөтүлбөйт, ал эми жашыруун эсептер такыр айтылбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer bedragen verborgen zijn, tonen meldingen geen bedragen en worden verborgen rekeningen nooit vermeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy kwoty są ukryte, powiadomienia ich nie pokazują i nie wspominają o ukrytych kontach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando os valores estão ocultos, as notificações não os mostram e nunca mencionam contas ocultas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando os montantes estão ocultos, as notificações não os mostram nem mencionam contas ocultas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока суммы скрыты, уведомления их не показывают; о скрытых счетах уведомлений нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вақте ки маблағҳо пинҳонанд, онҳо дар огоҳиҳо нишон дода намешаванд ва ҳисобҳои пинҳон зикр намешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlar gizliyken bildirimlerde tutar gösterilmez ve gizli hesaplardan hiç söz edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки суми приховано, сповіщення їх не показують, а прихований рахунок ніколи не згадується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Summalar yashirilganda bildirishnomalarda ko‘rsatilmaydi va yashirin hisoblar tilga olinmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏金额时，通知不会显示金额，也不会提及隐藏账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏金額時，通知不會顯示金額，也不會提及隱藏的帳戶。"
          }
        }
      }
    },
