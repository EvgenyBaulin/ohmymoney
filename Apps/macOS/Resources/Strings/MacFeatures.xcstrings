    "mac.notify.explain.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney можа нагадваць за дзень да тэрміну плацяжу — з кнопкай “Запісаць плацёж” проста ў апавяшчэнні, паведамляць пра амаль вычарпаны ліміт і пра гатовы агляд тыдня або месяца. Калі ўключана “Схаваць сумы”, апавяшчэнні не паказваюць сумы і не называюць схаваныя рахункі. Кожны тып апавяшчэнняў можна выключыць у меню Налады → Прыватнасць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney kann Sie einen Tag vor einer fälligen Zahlung erinnern — mit „Zahlung erfassen“ direkt in der Mitteilung — ebenso, wenn ein Limit fast aufgebraucht ist, und wenn die Zusammenfassung einer Woche oder eines Monats fertig ist. Mit eingeschaltetem „Beträge ausblenden“ zeigen Mitteilungen keine Beträge, und ausgeblendete Konten werden nie genannt. Jede Art schalten Sie unter Einstellungen → Datenschutz aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney can tell you the day before a payment is due — with “Record Payment” right in the notification — when a limit is nearly spent, and when the summary of a week or a month is ready. With “Hide Amounts” on, notifications show no amounts, and hidden accounts are never named. You can turn each kind off in Settings → Privacy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney può avvisarti il giorno prima della scadenza di un pagamento, con “Registra pagamento” direttamente nella notifica, quando un limite è quasi raggiunto e quando il riepilogo di una settimana o di un mese è pronto. Se “Nascondi importi” è attivo, le notifiche non mostrano gli importi e non indicano mai i conti nascosti. Puoi disattivare ogni tipo di notifica in Impostazioni → Privacy."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney төлемге бір күн қалғанда — хабарландыруда тікелей «Төлемді жазу» түймесімен — лимит таусыла жаққанда және апта не ай қорытындысы дайын болғанда хабарлайды. «Сомаларды жасыру» қосулы болса, хабарландыруда сомалар көрсетілмейді, жасырын есеп-шоттар аталмайды. Әр түрін «Параметрлер → Құпиялылық» ішінде өшіруге болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney может напомнить накануне платежа — с кнопкой «Записать оплату» прямо в уведомлении, — сказать, что лимит почти исчерпан, и что готовы итоги недели или месяца. При «Скрыть суммы» уведомления без сумм, скрытые счета не называются никогда. Каждый вид можно выключить в Настройках → Приватность."
          }
        }
      }
    },
    "mac.notify.explain.title": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апавяшчэнні ад OhMyMoney?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
