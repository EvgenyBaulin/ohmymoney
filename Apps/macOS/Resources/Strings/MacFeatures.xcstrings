    "intent.edit.description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyatın təsvirini, məbləğini və ya kateqoriyasını dəyişir. Boş qalan sahələr dəyişmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змяняе апісанне, суму або катэгорыю аперацыі. Пустыя палі застаюцца без змен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změní popis, částku nebo kategorii operace. Prázdná pole zůstanou beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Beschreibung, den Betrag oder die Kategorie eines Vorgangs. Leer gelassene Felder bleiben, wie sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the description, the amount or the category of an operation. Fields left empty stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la descripción, el importe o la categoría de una operación. Los campos que queden vacíos se mantienen como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie la description, le montant ou la catégorie d'une opération. Les champs laissés vides restent tels quels."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխում է գործողության նկարագրությունը, գումարը կամ կատեգորիան։ Դատարկ դաշտերը մնում են անփոփոխ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica la descrizione, l’importo o la categoria di un’operazione. I campi lasciati vuoti restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引の内容、金額、カテゴリを変更します。空欄の項目は変更されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცვლის ოპერაციის აღწერას, თანხას ან კატეგორიას. ცარიელი ველები უცვლელი რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцияның сипаттамасын, сомасын немесе санатын өзгертеді. Бос қалдырылған өрістер өзгеріссіз қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래의 설명, 금액 또는 카테고리를 변경합니다. 비워 둔 항목은 그대로 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциянын сүрөттөмөсүн, суммасын же категориясын өзгөртөт. Бош калтырылган талаалар өзгөрбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigt de omschrijving, het bedrag of de categorie van een transactie. Lege velden blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia opis, kwotę lub kategorię operacji. Puste pola pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera a descrição, o valor ou a categoria de uma operação. Os campos deixados em branco permanecem como estão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera a descrição, o montante ou a categoria de uma operação. Os campos vazios mantêm-se inalterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет описание, сумму или категорию операции. Пустые поля остаются как были."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тавсиф, маблағ ё категорияи амалиётро тағйир медиҳад. Майдонҳои холӣ бетағйир мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir işlemin açıklamasını, tutarını veya kategorisini değiştirir. Boş bırakılan alanlar değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює опис, суму або категорію операції. Поля, що лишилися порожніми, не змінюються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiya tavsifi, summasi yoki turkumini o'zgartiradi. Bo'sh qoldirilgan maydonlar o'zgarmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改交易的描述、金额或类别。留空的字段保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改交易的描述、金額或類別。留空的欄位會保持不變。"
          }
        }
      }
    },
