          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível apagar esta operação aqui. Abra-a no OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту операцию отсюда удалить нельзя: откройте её в OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин амалиётро аз ин ҷо нест кардан мумкин нест: онро дар OhMyMoney кушоед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem buradan silinemez. OhMyMoney'de açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю операцію звідси видалити не можна: відкрийте її в OhMyMoney."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu operatsiyani bu yerdan o'chirib bo'lmaydi. Uni OhMyMoney’da oching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此删除此交易，请在 OhMyMoney 中打开。"
          }
