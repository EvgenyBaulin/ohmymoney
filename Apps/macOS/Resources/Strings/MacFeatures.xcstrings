    "mac.command.confirm": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Усё роўна запісаць?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Trotzdem erfassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Record it anyway?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ¿Registrarla igualmente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La noter quand même ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Registrare comunque?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Бәрібір жазайық па?"
