    "mac.command.notReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney has not opened its data yet. Open the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney todavía no ha abierto sus datos. Abra la app e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney n'a pas encore ouvert ses données. Ouvrez l'app et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ещё не открыл данные. Откройте приложение и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ще не відкрив свої дані. Відкрийте застосунок і спробуйте знову."
          }
        }
      }
    },
    "mac.command.prepayQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment is above its due: choose in OhMyMoney whether it shortens the term, lowers the payment or pays ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago supera su vencimiento: elija en OhMyMoney si acorta el plazo, baja el pago o paga por adelantado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement dépasse son échéance : choisissez dans OhMyMoney s'il réduit la durée, la mensualité ou paie d'avance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёж больше срочного: выберите в OhMyMoney, уменьшить срок, платёж или это платёж вперёд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж перевищує свій належний: оберіть в OhMyMoney, чи він скорочує строк, знижує платіж або йде наперед."
          }
        }
      }
    },
    "mac.command.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Read Only” is on: nothing can be added, changed or deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo lectura» está activado: no se puede añadir, cambiar ni eliminar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Lecture seule » est activé : rien ne peut être ajouté, modifié ni supprimé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим «Только просмотр»: ничего нельзя добавить, изменить или удалить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено «Лише читання»: нічого не можна додати, змінити або видалити."
          }
        }
      }
    },
    "mac.command.refundPurchase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund: choose the purchase it takes money back from in OhMyMoney."
          }
        },
        "es": {
