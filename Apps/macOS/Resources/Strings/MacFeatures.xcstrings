      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне пакупкі ў растэрміноўку запісваецца ў OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
