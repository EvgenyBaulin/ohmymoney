          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сомалармен басып шығарылсын ба?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммалар менен басып чыгарылсынбы?"
          }
        },
        "pl": {
          "stringUnit": {
