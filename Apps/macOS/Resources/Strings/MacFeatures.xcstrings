    "mac.command.moneyBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money given back by a person is recorded in OhMyMoney: there you choose what it closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero devuelto por una persona se registra en OhMyMoney: allí elige qué cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent rendu par une personne se note dans OhMyMoney : là-bas vous choisissez ce qu'il clôt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат денег от человека записывается в OhMyMoney: там выбирается, что он закрывает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші, повернуті людиною, записуються в OhMyMoney: там ви обираєте, що вони закривають."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro restituito da una persona si registra in OhMyMoney, dove puoi scegliere cosa salda."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адам қайтарған ақша OhMyMoney-де жазылады: онда нені жабатынын таңдайсыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне грошай ад чалавека запісваецца ў OhMyMoney: там можна выбраць, якую запазычанасць яно пагашае."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld, das eine Person zurückgegeben hat, wird in OhMyMoney erfasst: Dort wählen Sie, was es beendet."
          }
        }
      }
    },
