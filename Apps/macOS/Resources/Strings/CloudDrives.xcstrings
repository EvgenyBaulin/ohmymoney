    "cloud.connect.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu diski hələ qoşmaq mümkün deyil: bu versiyada tətbiq açarı təyin edilməyib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль не ўдаецца падключыць гэты дыск: у гэтай зборцы не зададзены ключ праграмы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto úložiště zatím nelze připojit: v této verzi aplikace není nastaven klíč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Cloud-Speicher kann noch nicht verbunden werden: Der App-Schlüssel ist in dieser Version nicht hinterlegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This drive cannot be connected yet: the application key is not set in this build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se puede conectar esta unidad: la clave de la aplicación no está configurada en esta versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce stockage ne peut pas encore être connecté : la clé de l’application n’est pas définie dans cette version."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս պահոցը դեռ հնարավոր չէ միացնել․ հավելվածի բանալին այս տարբերակում սահմանված չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile connettere questo servizio: la chiave dell'app non è impostata in questa versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはアプリケーションキーが設定されていないため、このドライブにはまだ接続できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ საცავის დაკავშირება ჯერ შეუძლებელია: აპის გასაღები ამ ვერსიაში არ არის მითითებული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл дискіге әзірге қосылу мүмкін емес: қолданба кілті осы нұсқада орнатылмаған."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에 앱 키가 설정되어 있지 않아 아직 이 드라이브를 연결할 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул дискти азырынча туташтыруу мүмкүн эмес: колдонмонун ачкычы бул версияда коюлган эмес."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze schijf kan nog niet worden verbonden: de app-sleutel ontbreekt in deze versie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można jeszcze połączyć tego dysku: w tej wersji aplikacji nie ustawiono klucza aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível conectar este serviço ainda: a chave do app não está configurada nesta versão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não é possível ligar este serviço: a chave da aplicação não está definida nesta versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот диск пока нельзя подключить: в этой сборке не задан ключ приложения."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин дискро ҳоло пайваст кардан мумкин нест: калиди барнома дар ин версия танзим нашудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürücüye henüz bağlanılamıyor: Bu derlemede uygulama anahtarı ayarlanmamış."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що не вдається під’єднати цей диск: у цій збірці не задано ключ програми."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu diskni hozircha ulab bo‘lmaydi: ilova kaliti ushbu versiyada sozlanmagan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể kết nối ổ đĩa này: khóa ứng dụng chưa được đặt trong bản dựng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот диск пока нельзя подключить: в этой сборке не задан ключ приложения."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法連接此雲端硬碟：此版本未設定應用程式金鑰。"
          }
        }
      }
    },
