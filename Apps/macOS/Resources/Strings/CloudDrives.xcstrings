    "cloud.encrypted.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayllar yüklənməzdən əvvəl bu cihazda şifrələnir; xidmət yalnız oxunmayan faylları görür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы шыфруюцца на гэтай прыладзе перад загрузкай; сэрвіс бачыць толькі нечытэльныя файлы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory se před odesláním zašifrují v tomto zařízení. Služba je nemůže přečíst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden vor dem Hochladen auf diesem Gerät verschlüsselt. Der Dienst sieht nur unlesbare Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are encrypted on this device before they are uploaded; the service only sees unreadable files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se cifran en este dispositivo antes de subirse; el servicio solo ve archivos ilegibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont chiffrés sur cet appareil avant leur transfert ; le service ne voit que des fichiers illisibles."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլերը գաղտնագրվում են այս սարքում՝ վերբեռնելուց առաջ․ ծառայությունը տեսնում է միայն անընթեռնելի ֆայլեր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono criptati su questo dispositivo prima del caricamento; il servizio riceve solo file illeggibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはアップロード前にこのデバイスで暗号化されます。サービス側では内容を読み取れません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილები ატვირთვამდე ამ მოწყობილობაზე იშიფრება; სერვისი მხოლოდ წაუკითხავ ფაილებს ხედავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлдар жүктелмес бұрын осы құрылғыда шифрланады; сервиске олар оқылмайтын түрде көрінеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 업로드되기 전에 이 기기에서 암호화됩니다. 서비스에서는 파일을 읽을 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлдар жүктөлөрдөн мурун ушул түзмөктө шифрленет; кызмат аларды окуй албайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden worden op dit apparaat versleuteld voordat ze worden geüpload. De dienst ziet alleen onleesbare bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki są szyfrowane na tym urządzeniu przed wysłaniem. Usługa widzi tylko nieczytelne pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos são criptografados neste dispositivo antes do envio; o serviço vê apenas arquivos ilegíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros são cifrados neste dispositivo antes de serem carregados; o serviço só vê ficheiros ilegíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы шифруются на этом устройстве до загрузки; сервис видит только нечитаемые файлы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлҳо пеш аз боргузорӣ дар ин дастгоҳ рамзгузорӣ мешаванд; хидмат танҳо файлҳои хонданашавандаро мебинад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar yüklenmeden önce bu aygıtta şifrelenir; servis yalnızca okunamayan dosyaları görür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли шифруються на цьому пристрої перед вивантаженням; сервіс бачить лише зашифровані файли."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayllar yuklanishdan oldin shu qurilmada shifrlanadi; xizmat ularni o‘qiy olmaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp được mã hóa trên thiết bị này trước khi tải lên; dịch vụ chỉ thấy các tệp không đọc được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы шифруются на этом устройстве перед загрузкой; сервис видит только нечитаемые файлы."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會在上傳前於此裝置上加密；服務端只會看到無法讀取的檔案。"
          }
        }
      }
    },
    "cloud.input.invalid": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daxil edilmiş məlumatları yoxlayın: ünvan https:// ilə başlamalı, giriş isə e-poçt olmalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праверце ўведзеныя даныя: адрас павінен пачынацца з https://, лагін — гэта электронная пошта."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte zadané údaje: adresa musí začínat https://, přihlašovacím jménem je e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe die Eingaben: Eine Adresse muss mit https:// beginnen, der Benutzername ist eine E-Mail-Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the entered data: an address must start with https://, a login is an e-mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba los datos introducidos: la dirección debe comenzar por https:// y el usuario debe ser un correo electrónico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les données saisies : l’adresse doit commencer par https:// et l’identifiant doit être une adresse e-mail."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստուգեք մուտքագրված տվյալները․ հասցեն պետք է սկսվի https://-ով, իսկ մուտքանունը պետք է լինի էլ. հասցե։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i dati inseriti: l'indirizzo deve iniziare con https:// e il login deve essere un'e-mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容を確認してください。アドレスはhttps://で始め、ログインにはメールアドレスを入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეამოწმეთ შეყვანილი მონაცემები: მისამართი უნდა იწყებოდეს https://-ით, შესასვლელი სახელი კი ელფოსტა უნდა იყოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енгізілген деректерді тексеріңіз: мекенжай https:// деп басталуы, ал логин эл. пошта болуы керек."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 정보를 확인하세요. 주소는 https://로 시작해야 하며, 로그인에는 이메일 주소를 사용해야 합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Киргизилген маалыматтарды текшериңиз: дарек https:// менен башталышы керек, логин — электрондук почта."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de ingevoerde gegevens: een adres moet beginnen met https:// en de gebruikersnaam is een e-mailadres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź dane: adres musi zaczynać się od https://, a login musi być adresem e-mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira os dados informados: o endereço deve começar com https:// e o login deve ser um e-mail."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique os dados introduzidos: o endereço tem de começar por https:// e o início de sessão tem de ser um e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте введённое: адрес начинается с https://, логин — это почта."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумоти воридшударо санҷед: суроға бояд бо https:// оғоз шавад, логин бояд почтаи электронӣ бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girilen bilgileri kontrol edin: Adres https:// ile başlamalı, giriş bir e-posta adresi olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте введені дані: адреса має починатися з https://, а логіном має бути адреса електронної пошти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiritilgan ma’lumotlarni tekshiring: manzil https:// bilan boshlanishi, login esa e-mail bo‘lishi kerak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
