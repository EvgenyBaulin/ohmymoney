    "warranty.empty.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a warranty or a return term in the panel of an operation, or type it in the line: «warranty 2y», «return 14d»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada una garantía o un plazo de devolución en el panel de una operación, o escríbalo en la línea: «garantía 2a», «devolución 14d»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une garantie ou un délai de retour dans le panneau d'une opération, ou tapez-le dans la ligne : « garantie 2a », « retour 14j »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте гарантию или срок возврата в панели операции или напишите в строке: «гарантия 2г», «возврат 14д»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте гарантію або строк повернення на панелі операції чи введіть у рядку: «warranty 2y», «return 14d»."
          }
        }
      }
    },
