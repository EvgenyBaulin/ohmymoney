    "warranty.empty.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадайце гарантыю або тэрмін вяртання ў панэлі аперацыі ці ўвядзіце ў радку: «warranty 2y», «return 14d»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie eine Garantie oder eine Rückgabefrist im Bedienfeld eines Vorgangs hinzu oder tippen Sie sie in die Zeile: „Garantie 2y“, „Rückgabe 14d“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a warranty or a return term in the panel of an operation, or type it in the line: «warranty 2y», «return 14d»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada una garantía o un plazo de devolución en el panel de una operación, o escríbalo en la línea: «garantía 2a», «devolución 14d»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une garantie ou un délai de retour dans le panneau d'une opération, ou tapez-le dans la ligne : « garantie 2a », « retour 14j »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una garanzia o un termine di reso nel pannello di un'operazione, oppure scrivilo nella riga: «warranty 2y», «return 14d»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция панелінде кепілдік не қайтару мерзімін қосыңыз немесе жолға жазыңыз: «кепілдік 2ж», «қайтару 14к»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj gwarancję lub termin zwrotu w panelu operacji albo wpisz w wierszu: «warranty 2y», «return 14d»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте гарантию или срок возврата в панели операции или напишите в строке: «гарантия 2г», «возврат 14д»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem panelinde bir garanti veya iade süresi ekleyin ya da satıra yazın: «warranty 2y», «return 14d»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте гарантію або строк повернення на панелі операції чи введіть у рядку: «warranty 2y», «return 14d»."
          }
        }
      }
    },
