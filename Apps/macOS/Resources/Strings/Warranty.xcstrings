    "warranty.empty.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyat panelində zəmanət və ya qaytarma müddəti əlavə edin və ya sətrə yazın: «warranty 2y», «return 14d»."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадайце гарантыю або тэрмін вяртання ў панэлі аперацыі ці ўвядзіце ў радку: «warranty 2y», «return 14d»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte záruku nebo lhůtu pro vrácení v detailu transakce nebo ji zadejte do řádku: «warranty 2y», «return 14d»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie eine Garantie oder eine Rückgabefrist im Bedienfeld eines Vorgangs hinzu oder tippen Sie sie in die Zeile: „Garantie 2y“, „Rückgabe 14d“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a warranty or a return term in the panel of an operation, or type it in the line: «warranty 2y», «return 14d»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada una garantía o un plazo de devolución en el panel de una operación, o escríbalo en la línea: «garantía 2a», «devolución 14d»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une garantie ou un délai de retour dans le panneau d'une opération, ou tapez-le dans la ligne : « garantie 2a », « retour 14j »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացրեք երաշխիք կամ վերադարձի ժամկետ գործարքի վահանակում կամ մուտքագրեք տողում՝ «warranty 2y», «return 14d»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una garanzia o un termine di reso nel pannello di un'operazione, oppure scrivilo nella riga: «warranty 2y», «return 14d»."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაამატეთ გარანტია ან დაბრუნების ვადა ოპერაციის პანელში, ან ჩაწერეთ სტრიქონში: «warranty 2y», «return 14d»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция панелінде кепілдік не қайтару мерзімін қосыңыз немесе жолға жазыңыз: «кепілдік 2ж», «қайтару 14к»."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциянын панелине кепилдикти же кайтаруу мөөнөтүн кошуңуз, же сапка жазыңыз: «warranty 2y», «return 14d»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj gwarancję lub termin zwrotu w panelu operacji albo wpisz w wierszu: «warranty 2y», «return 14d»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma garantia ou prazo de devolução no painel de uma operação ou digite na linha: «warranty 2y», «return 14d»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma garantia ou um prazo de devolução no painel de uma operação, ou escreva na linha: «warranty 2y», «return 14d»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте гарантию или срок возврата в панели операции или напишите в строке: «гарантия 2г», «возврат 14д»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар панели амалиёт кафолат ё муҳлати баргардониро илова кунед ё дар сатр нависед: «warranty 2y», «return 14d»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem panelinde bir garanti veya iade süresi ekleyin ya da satıra yazın: «warranty 2y», «return 14d»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте гарантію або строк повернення на панелі операції чи введіть у рядку: «warranty 2y», «return 14d»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiya panelida kafolat yoki qaytarish muddatini qo‘shing yoki satrga yozing: «warranty 2y», «return 14d»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在交易面板中加入保固或退貨期限，或在輸入列中輸入：「warranty 2y」、「return 14d」。"
          }
        }
      }
    },
