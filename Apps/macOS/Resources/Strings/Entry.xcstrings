            "state": "translated",
            "value": "Hissəni silmək mümkün olmadı. Ödəniş hələ gözlənilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося спісаць долю. Яна ўсё яшчэ чакае вяртання грошай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Část se nepodařilo odepsat. Stále čeká na vrácení peněz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anteil konnte nicht abgeschrieben werden. Er wartet weiter auf sein Geld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The part could not be written off. It is still waiting for its money."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte no se pudo dar de baja. Sigue pendiente de su dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part n'a pas pu être passée en pertes. Elle attend toujours son argent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց դուրս գրել մասը։ Այն դեռ սպասում է վերադարձին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile stornare la quota. È ancora in attesa di rimborso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この分を帳消しにできませんでした。未精算のままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაწილის ჩამოწერა ვერ მოხერხდა. ის კვლავ თანხის დაბრუნებას ელოდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлікті есептен шығару мүмкін болмады. Ол әлі ақшасын күтуде."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받을 돈을 포기 처리하지 못했습니다. 아직 정산 대기 중입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүктү кечүү мүмкүн болгон жок. Ал дагы эле төлөмдү күтүп жатат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het deel kon niet worden kwijtgescholden. Het staat nog open."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się umorzyć tej części. Nadal oczekuje na zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível dar baixa na parte. Ela ainda aguarda pagamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível dar a parte como perdida. Continua à espera de reembolso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось списать часть — она по-прежнему ждёт возврата."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қисмро аз ҳисоб бароварда нашуд. Он ҳанӯз мунтазири пардохт аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutar alacaktan düşülemedi. Ödeme beklemeye devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося списати частину. Вона все ще очікує повернення грошей."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qismni hisobdan chiqarib bo‘lmadi. Uning qaytimi hali kutilmoqda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法核销此笔款项，仍在等待收回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法核銷此分攤，款項仍待收回。"
          }
        }
      }
    },
