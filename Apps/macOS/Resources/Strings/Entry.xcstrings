    "entry.beforeCount.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, saat %@ üzləşdirməsindən əvvəl idi?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта было да зверкі ў %@?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bylo to před odsouhlasením v %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag dieser Vorgang vor dem Abgleich am %@?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Was this before the reconciliation at %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Fue esto antes de la conciliación del %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Était-ce avant le rapprochement du %@ ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա տեղի է ունեցե՞լ մինչև %@ կատարված համադրումը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È avvenuta prima della riconciliazione delle %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは%@の残高照合より前ですか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოხდა %@-ზე შეჯერებამდე?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл %@ салыстырудан бұрын болды ма?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 잔액 확인 전에 발생했습니까?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул %@ учурундагы салыштырууга чейин беле?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dit vóór de afstemming om %@?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy operacja miała miejsce przed uzgodnieniem o %@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi antes da reconciliação às %@?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi antes da reconciliação às %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это было до сверки в %@?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин пеш аз санҷиш дар %@ буд?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem %@ tarihindeki mutabakattan önce miydi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це було до звірки о %@?"
          }
        },
        "uz": {
