    "entry.closesTerm.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж па гэтым доўгу лічыцца ўнесеным, хоць ён меншы за штомесячны"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fälligkeit dieser Schuld gilt als bezahlt, auch wenn die Zahlung kleiner ist als die monatliche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The due of this debt counts as paid although the payment is smaller than the monthly one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vencimiento de esta deuda cuenta como pagado aunque el pago sea menor que el mensual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'échéance de cette dette compte comme payée, bien que le paiement soit plus petit que la mensualité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rata di questo debito viene considerata pagata anche se il pagamento è inferiore all’importo mensile"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл берешектің міндеттемесі төленген деп саналады, төлем айлықтан кіші болса да"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rata długu zostanie uznana za zapłaconą, choć płatność jest niższa od miesięcznej raty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parcela desta dívida é considerada paga, mesmo que o pagamento seja menor que o valor mensal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок по этому долгу будет считаться оплаченным, хотя платёж меньше ежемесячного"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme aylık tutardan az olsa da bu borcun taksiti ödenmiş sayılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж за цим боргом вважається внесеним, хоча сума менша за щомісячний платіж"
          }
        }
      }
    },
