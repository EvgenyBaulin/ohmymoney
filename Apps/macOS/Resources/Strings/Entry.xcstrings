            "value": "Бұл бөлік үшін ақша қайтарылған — оның сомасын өзгерту үшін алдымен қайтаруды жойыңыз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За эту часть деньги вернули — чтобы изменить сумму, сначала удалите возврат"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цю частину вже повернули гроші — щоб змінити суму, спочатку видаліть повернення грошей"
          }
        }
      }
    },
    "entry.closesTerm": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш плацяжоў у гэтым месяцы не будзе"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine weiteren Zahlungen in diesem Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more payments this month"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro pagamento questo mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда басқа төлем жоқ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце больше платежей не будет"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього місяця більше платежів немає"
          }
        }
      }
    },
    "entry.closesTerm.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж па гэтым доўгу лічыцца ўнесеным, хоць ён меншы за штомесячны"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fälligkeit dieser Schuld gilt als bezahlt, auch wenn die Zahlung kleiner ist als die monatliche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The due of this debt counts as paid although the payment is smaller than the monthly one"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rata di questo debito viene considerata pagata anche se il pagamento è inferiore all’importo mensile"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл берешектің міндеттемесі төленген деп саналады, төлем айлықтан кіші болса да"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок по этому долгу будет считаться оплаченным, хотя платёж меньше ежемесячного"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж за цим боргом вважається внесеним, хоча сума менша за щомісячний платіж"
          }
        }
      }
    },
