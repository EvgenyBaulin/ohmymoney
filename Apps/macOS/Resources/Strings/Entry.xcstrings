    "entry.transfer.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перавод з рахунку на рахунак: сума, рахунак і дата з гэтай формы перанясуцца ў яго"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Überweisung von Konto zu Konto, hier erfasst: Betrag, Konto und Datum dieses Formulars werden in sie übernommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer from account to account, written right here: the amount, the account and the date of this form carry over to it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transferencia de cuenta a cuenta, anotada aquí mismo: el importe, la cuenta y la fecha de este formulario pasan a ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un virement d'un compte à un autre, noté ici : le montant, le compte et la date de ce formulaire lui sont repris"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trasferimento tra conti, registrato qui: importo, conto e data di questo modulo verranno riportati nel trasferimento"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттан есеп-шотқа аударым, осы жерде жазылады: осы форманың сомасы, есеп-шоты және күні соған көшеді"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelew między kontami zapisany tutaj: kwota, konto i data z tego formularza zostaną przeniesione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma transferência entre contas, lançada aqui: o valor, a conta e a data deste formulário serão usados nela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
