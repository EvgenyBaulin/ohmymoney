    "entry.closedPart": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэтую частку ўжо вярнулі грошы — каб змяніць суму, спачатку выдаліце кампенсацыю"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Teil wurde Geld zurückgegeben — um seinen Betrag zu ändern, löschen Sie zuerst die Rückzahlung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money came back for this part — to change its amount, delete the reimbursement first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por esta parte se devolvió dinero — para cambiar su importe, elimine antes la devolución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l'argent est revenu pour cette part — pour changer son montant, supprimez d'abord le remboursement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa parte è già stata rimborsata: per modificarne l’importo, elimina prima il rimborso"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл бөлік үшін ақша қайтарылған — оның сомасын өзгерту үшін алдымен қайтаруды жойыңыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrócono pieniądze za tę część — aby zmienić jej kwotę, najpierw usuń zwrot"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor desta parte foi reembolsado — para alterá-lo, apague o reembolso primeiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За эту часть деньги вернули — чтобы изменить сумму, сначала удалите возврат"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parça için para iade edildi — tutarını değiştirmek için önce geri ödemeyi silin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цю частину вже повернули гроші — щоб змінити суму, спочатку видаліть повернення грошей"
          }
        }
      }
    },
    "entry.closesTerm": {
      "comment": "Translation not verified by a native speaker.",
