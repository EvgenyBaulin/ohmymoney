        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაცია წაიშალა, ამიტომ ცვლილებები არ შენახულა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция жойылған, сондықтан өзгерістер сақталмады"
