    "entry.error.amountNegative": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğ sıfırdan kiçikdir: onun işarəsini əməliyyat növü müəyyən edir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Атрыманая сума меншая за нуль: яе знак вызначаецца тыпам аперацыі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledná částka je záporná: její znaménko určuje typ transakce"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrag ergibt sich unter null: Die Art des Vorgangs bestimmt sein Vorzeichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amount comes out below zero: the kind of the operation sets its sign"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe sale menor que cero: el tipo de la operación fija su signo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant sort inférieur à zéro : c'est le type de l'opération qui fixe son signe"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը զրոյից փոքր է․ դրա նշանը որոշվում է գործարքի տեսակով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importo è inferiore a zero: il segno dipende dal tipo di operazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額がマイナスになります。符号は取引の種類で決まります"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა ნულზე ნაკლებია: მის ნიშანს ოპერაციის სახე განსაზღვრავს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сома нөлден төмен шығады: операцияның түрі таңбасын береді"
