    "moneyBack.unnamedParts": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пад гэтым імем нічога не вінны, але ў некаторых частках, аплачаных за іншых, ніхто не пазначаны — магчыма, яны належаць гэтаму чалавеку. Разлічыцеся праз «Уручную…»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter diesem Namen wird nichts geschuldet, aber einige für andere bezahlte Teile nennen niemanden — sie könnten dieser Person gehören. Begleichen Sie sie mit „Von Hand…“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is owed under this name, but some parts paid for others name nobody — they may be this person's. Settle them with Manually…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se debe con este nombre, pero algunas partes pagadas por otros no nombran a nadie — podrían ser de esta persona. Salde esas partes con «A mano…»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est dû sous ce nom, mais certaines parts payées pour d'autres ne nomment personne — elles sont peut-être à cette personne. Réglez-les avec « À la main… »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non risultano importi dovuti a questo nome, ma alcune parti pagate per altri non hanno un nome e potrebbero appartenere a questa persona. Saldale con Manualmente…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл атпен қарыз жоқ, бірақ біреу үшін төленген кейбір бөліктерде ешкім аталмаған — олар осы адамдікі болуы мүмкін. Оларды «Қолмен…» арқылы реттеңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma należności przypisanych do tej osoby, ale niektóre wydatki za innych nie mają przypisanej osoby — mogą należeć do niej. Rozlicz je przez „Ręcznie…”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há valores devidos neste nome, mas algumas partes pagas por outras pessoas não têm nome — elas podem ser desta pessoa. Quite-as em Manualmente…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На это имя долгов нет, но есть части «за другого» без должника — возможно, это они. Отметьте их через «Вручную…»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad altında borç yok, ancak başkaları için ödenen bazı tutarlarda kişi belirtilmemiş; bunlar bu kişiye ait olabilir. Elle… ile kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під цим ім'ям боргів немає, але є частини без імені — можливо, вони цієї людини. Розподіліть їх через «Вручну…»"
          }
        }
      }
    },
