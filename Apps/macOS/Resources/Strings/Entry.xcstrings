    "entry.error.gone": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyat silindiyi üçün dəyişikliklər yadda saxlanılmadı"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыю выдалена, таму змены не захаваны"
          }
