    "moneyBack.unnamedParts": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adla borc yoxdur, lakin başqaları üçün ödənilmiş bəzi hissələrdə ad göstərilməyib — onlar bu şəxsə aid ola bilər. Onları «Əl ilə…» vasitəsilə bağlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пад гэтым імем нічога не вінны, але ў некаторых частках, аплачаных за іншых, ніхто не пазначаны — магчыма, яны належаць гэтаму чалавеку. Разлічыцеся праз «Уручную…»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod tímto jménem není evidován žádný dluh, ale některé části zaplacené za druhé nemají přiřazenou osobu — mohou patřit této osobě. Vyrovnejte je volbou Ručně…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter diesem Namen wird nichts geschuldet, aber einige für andere bezahlte Teile nennen niemanden — sie könnten dieser Person gehören. Begleichen Sie sie mit „Von Hand…“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is owed under this name, but some parts paid for others name nobody — they may be this person's. Settle them with Manually…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se debe con este nombre, pero algunas partes pagadas por otros no nombran a nadie — podrían ser de esta persona. Salde esas partes con «A mano…»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est dû sous ce nom, mais certaines parts payées pour d'autres ne nomment personne — elles sont peut-être à cette personne. Réglez-les avec « À la main… »"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անունով պարտք չկա, բայց ուրիշների համար վճարված որոշ մասեր անուն չունեն․ դրանք կարող են այս անձին պատկանել։ Մարեք դրանք «Ձեռքով…» միջոցով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non risultano importi dovuti a questo nome, ma alcune parti pagate per altri non hanno un nome e potrebbero appartenere a questa persona. Saldale con Manualmente…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前の未精算分はありませんが、相手が未設定の立て替え分があります。この相手の分であれば、「手動で入力…」から精算できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ სახელზე ვალი არ არის, მაგრამ სხვების ნაცვლად გადახდილ ზოგიერთ ნაწილს სახელი არ აქვს მითითებული — შესაძლოა, ისინი ამ ადამიანს ეკუთვნოდეს. დაფარეთ ისინი ოფციით „ხელით…“"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл атпен қарыз жоқ, бірақ біреу үшін төленген кейбір бөліктерде ешкім аталмаған — олар осы адамдікі болуы мүмкін. Оларды «Қолмен…» арқылы реттеңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름으로 받을 돈은 없지만, 다른 사람을 대신해 결제한 항목 중 이름이 지정되지 않은 항목이 있습니다. 이 사람의 항목일 수 있습니다. ‘수동으로…’에서 정산하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул ат менен карыз жок, бирок башкалар үчүн төлөнгөн айрым бөлүктөрдө эч ким көрсөтүлгөн эмес — алар ушул адамга таандык болушу мүмкүн. Аларды «Кол менен…» аркылуу жабыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onder deze naam staat niets open, maar bij sommige delen die voor anderen zijn betaald, staat geen naam. Mogelijk zijn ze van deze persoon. Verreken ze via Handmatig…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma należności przypisanych do tej osoby, ale niektóre wydatki za innych nie mają przypisanej osoby — mogą należeć do niej. Rozlicz je przez „Ręcznie…”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há valores devidos neste nome, mas algumas partes pagas por outras pessoas não têm nome — elas podem ser desta pessoa. Quite-as em Manualmente…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada em dívida neste nome, mas algumas partes pagas por outras pessoas não têm nome — podem ser desta pessoa. Liquide-as em Manualmente…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На это имя долгов нет, но есть части «за другого» без должника — возможно, это они. Отметьте их через «Вручную…»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба ин ном қарзе нест, аммо баъзе қисмҳои барои дигарон пардохташуда ном надоранд — шояд ба ин шахс тааллуқ доранд. Онҳоро бо «Дастӣ…» ҳисоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad altında borç yok, ancak başkaları için ödenen bazı tutarlarda kişi belirtilmemiş; bunlar bu kişiye ait olabilir. Elle… ile kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під цим ім'ям боргів немає, але є частини без імені — можливо, вони цієї людини. Розподіліть їх через «Вручну…»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nomga qarz yo‘q, ammo boshqalar uchun to‘langan ayrim qismlarda ism ko‘rsatilmagan — ular shu odamga tegishli bo‘lishi mumkin. Ularni «Qo‘lda…» orqali yoping."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此人名下没有欠款，但有些代付款未指定人员，可能属于此人。请通过“手动…”结清。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此人名下沒有欠款，但有些代付款未指定對象，可能屬於此人。請使用「手動⋯」結清。"
          }
        }
      }
    },
