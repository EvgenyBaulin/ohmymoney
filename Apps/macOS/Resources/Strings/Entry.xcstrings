    "moneyBack.unnamedParts": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пад гэтым імем нічога не вінны, але ў некаторых частках, аплачаных за іншых, ніхто не пазначаны — магчыма, яны належаць гэтаму чалавеку. Разлічыцеся праз «Уручную…»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter diesem Namen wird nichts geschuldet, aber einige für andere bezahlte Teile nennen niemanden — sie könnten dieser Person gehören. Begleichen Sie sie mit „Von Hand…“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is owed under this name, but some parts paid for others name nobody — they may be this person's. Settle them with Manually…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non risultano importi dovuti a questo nome, ma alcune parti pagate per altri non hanno un nome e potrebbero appartenere a questa persona. Saldale con Manualmente…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл атпен қарыз жоқ, бірақ біреу үшін төленген кейбір бөліктерде ешкім аталмаған — олар осы адамдікі болуы мүмкін. Оларды «Қолмен…» арқылы реттеңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На это имя долгов нет, но есть части «за другого» без должника — возможно, это они. Отметьте их через «Вручную…»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під цим ім'ям боргів немає, але є частини без імені — можливо, вони цієї людини. Розподіліть їх через «Вручну…»"
          }
        }
      }
    },
