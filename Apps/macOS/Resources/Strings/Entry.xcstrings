    "entry.payWith.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart: alış sətirdə göstərilən, bu məkanda istifadə olunan və ya hesabın əsas kartı ilə edilir. Hesab: vəsait kartsız, birbaşa hesabdan çıxır — sətirdə «hesabdan» kimi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта: пакупка аплачана картай, названай у радку, картай, якой карыстаюцца ў гэтым месцы, або асноўнай картай рахунку. Рахунак: грошы спісваюцца з самога рахунку, без карты — як «з рахунку» ў радку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta: nákup je zaplacen kartou uvedenou v řádku, kartou používanou na tomto místě nebo hlavní kartou účtu. Účet: peníze odejdou přímo z účtu bez použití karty — jako při zadání «from account» v řádku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karte: Der Kauf wird mit der Karte getätigt, die die Zeile nennt, mit der an diesem Ort genutzten oder mit der Hauptkarte des Kontos. Konto: Das Geld geht direkt vom Konto ab, ohne Karte — wie „von Konto“ in der Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card: the purchase is made with the card the line named, the one used at this place, or the main card of the account. Account: the money leaves the account itself, with no card — as «from account» in the line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjeta: la compra se hace con la tarjeta que indicó la línea, la que se usa en ese lugar o la tarjeta principal de la cuenta. Cuenta: el dinero sale de la propia cuenta, sin tarjeta — como «desde la cuenta» en la línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte : l'achat se fait avec la carte nommée dans la ligne, celle utilisée à cet endroit, ou la carte principale du compte. Compte : l'argent sort du compte lui-même, sans carte — comme « depuis le compte » dans la ligne."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քարտ․ գնումը կատարվում է տողում նշված, այս վայրում օգտագործված կամ հաշվի հիմնական քարտով։ Հաշիվ․ գումարը դուրս է գալիս անմիջապես հաշվից՝ առանց քարտի, ինչպես տողում նշված «հաշվից» դեպքում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carta: l'acquisto viene effettuato con la carta indicata nella riga, quella usata in questo luogo o la carta principale del conto. Conto: il denaro viene prelevato direttamente dal conto, senza carta, come «dal conto» nella riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード：明細に記載されたカード、この場所で使ったカード、または口座のメインカードで支払います。口座：明細の「口座から」のように、カードを使わず口座から直接支払います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარათი: შესყიდვა ხდება სტრიქონში მითითებული, ამ ადგილას გამოყენებული ან ანგარიშის მთავარი ბარათით. ანგარიში: თანხა პირდაპირ ანგარიშიდან გადის, ბარათის გარეშე — როგორც «ანგარიშიდან» სტრიქონში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта: сатып алу енгізу жолында аталған картамен, осы орында қолданылған картамен немесе есеп-шоттың негізгі картасымен жасалады. Есеп-шот: ақша картасыз, есеп-шоттың өзінен кетеді — жолдағы «есеп-шоттан» сияқты."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드: 항목에 지정된 카드, 이 장소에서 사용한 카드 또는 계좌의 기본 카드로 구매합니다. 계좌: 카드 없이 계좌에서 직접 출금합니다. 항목의 «from account»에 해당합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта: сатып алуу сапта көрсөтүлгөн, бул жерде колдонулган же эсептин негизги картасы менен төлөнөт. Эсеп: акча картасыз, түз эсептен алынат — саптагы «эсептен» дегендей."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaart: de aankoop wordt gedaan met de kaart in de regel, de kaart die bij deze plaats wordt gebruikt of de hoofdkaart van de rekening. Rekening: het geld gaat rechtstreeks van de rekening, zonder kaart — zoals «from account» in de regel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta: zakup jest opłacany kartą wskazaną w wierszu, używaną w tym miejscu lub główną kartą konta. Konto: pieniądze są pobierane bezpośrednio z konta, bez karty — jak przy „z konta” w wierszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartão: a compra é feita com o cartão indicado na linha, o usado neste lugar ou o cartão principal da conta. Conta: o dinheiro sai da própria conta, sem cartão — como «da conta» na linha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartão: a compra é feita com o cartão indicado na linha, o usado neste local ou o cartão principal da conta. Conta: o dinheiro sai da própria conta, sem cartão — como «da conta» na linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта — трата с карты, названной в строке, с той, что платили здесь в прошлый раз, или с основной карты счёта. Счёт — деньги уходят со счёта без карты, как «со счёта» в строке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Корт: харид бо корти дар сатр зикршуда, корти дар ин ҷой истифодашуда ё корти асосии ҳисоб анҷом мешавад. Ҳисоб: пул бевосита аз ҳисоб, бе корт гирифта мешавад — мисли «аз ҳисоб» дар сатр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart: Satın alım, satırda belirtilen kartla, bu yerde kullanılan kartla veya hesabın ana kartıyla yapılır. Hesap: Para, kart kullanılmadan doğrudan hesaptan çıkar — satırdaki «hesaptan» gibi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка: покупку оплачено карткою, названою в рядку, використаною в цьому місці або основною карткою рахунку. Рахунок: гроші списуються з самого рахунку без картки — як «з рахунку» в рядку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta: xarid satrda ko‘rsatilgan, bu joyda ishlatilgan yoki hisobning asosiy kartasi bilan to‘lanadi. Hisob: pul kartasiz hisobning o‘zidan yechiladi — satrdagi «hisobdan» kabi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡：使用记录中指定的卡、在此地点使用过的卡或账户的主卡购买。账户：款项直接从账户支出，不使用卡，对应记录中的“从账户”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片：使用記錄中指定的卡片、在此地點使用的卡片，或帳戶的主要卡片付款。帳戶：款項直接從帳戶扣除，不使用卡片，如記錄中的 «from account»。"
          }
        }
      }
    },
