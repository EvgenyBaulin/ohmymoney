    "entry.minBalance.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank verlangt, dass auf dem Konto mindestens so viel bleibt. Verboten ist nichts: Sie können es trotzdem erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank asks to keep this much on the account. Nothing is forbidden: you can record it all the same."
