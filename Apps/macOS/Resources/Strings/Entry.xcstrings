    "entry.error.refundOneAmount": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне пакупкі мае адну суму: яе нельга падзяліць або аплаціць за кагосьці"
