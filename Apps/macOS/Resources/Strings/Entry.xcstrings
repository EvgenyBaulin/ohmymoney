    "entry.payingFor.gift": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ üçün hədiyyə: %1$@ ödədiniz, heç kim sizə borclu deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падарунак для %2$@: вы заплацілі %1$@, ніхто вам не вінны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dárek pro %2$@: zaplatili jste %1$@, nikdo vám nic nedluží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Geschenk für %2$@: Sie haben %1$@ bezahlt, niemand schuldet Ihnen etwas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gift for %2$@: you paid %1$@, nobody owes you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un regalo para %2$@: usted pagó %1$@, nadie le debe nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cadeau pour %2$@ : vous avez payé %1$@, personne ne vous doit rien."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նվեր %2$@-ի համար․ վճարել եք %1$@, ձեզ ոչ ոք պարտք չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un regalo per %2$@: hai pagato %1$@, nessuno ti deve nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@への贈り物：%1$@を支払いました。返済はありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საჩუქარი %2$@: გადაიხადეთ %1$@, არავის თქვენი ვალი არ აქვს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ үшін сыйлық: сіз %1$@ төледіңіз, ешкім сізге қарызды емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@님을 위한 선물: %1$@을(를) 지불했으며, 돌려받을 금액은 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ үчүн белек: сиз %1$@ төлөдүңүз, эч ким сизге карыз эмес."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een cadeau voor %2$@: je betaalde %1$@, niemand hoeft je terug te betalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezent dla %2$@: zapłacono %1$@, nikt nie jest Ci winien pieniędzy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um presente para %2$@: você pagou %1$@ e ninguém deve a você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma prenda para %2$@: pagou %1$@ e ninguém lhe deve nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарок (%2$@): вы заплатили %1$@, никто не должен."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тӯҳфа барои %2$@: шумо %1$@ пардохт кардед, касе аз шумо қарздор нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ için hediye: %1$@ ödediniz, kimsenin size borcu yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарунок для %2$@: ви сплатили %1$@, вам ніхто не винен."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ uchun sovg‘a: siz %1$@ to‘ladingiz, hech kim sizdan qarzdor emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "送给 %2$@ 的礼物：你支付了 %1$@，无需偿还。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "送給 %2$@ 的禮物：你支付了 %1$@，無人欠你款項。"
          }
        }
      }
    },
