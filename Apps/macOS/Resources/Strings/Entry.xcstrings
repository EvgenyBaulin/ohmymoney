    "entry.gap.subcategory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sətirdə alt kateqoriya göstərilməyib — paneldə və ya burada ↓ ↑ ilə seçin, yaxud “—” saxlayın və Return düyməsini basın"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У радку не пазначана падкатэгорыя — выберыце яе на панэлі ці тут клавішамі ↓ ↑ або пакіньце «—» і націсніце Return"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádek neuvádí podkategorii. Vyberte ji na panelu či zde pomocí ↓ ↑ nebo ponechte „—“ a stiskněte Return"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeile nennt die Unterkategorie nicht — wählen Sie sie im Bedienfeld oder hier mit ↓ ↑ oder lassen Sie „—“ stehen, und drücken Sie Return"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line does not say the subcategory — choose it in the panel, or with ↓ ↑ here, or leave “—”, and press Return"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea no indica la subcategoría — elíjala en el panel, o con ↓ ↑ aquí, o deje «—», y pulse Intro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne ne précise pas la sous-catégorie — choisissez-la dans le panneau, ou avec ↓ ↑ ici, ou laissez « — », puis appuyez sur Retour"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տողում ենթակատեգորիան նշված չէ․ ընտրեք այն վահանակում կամ այստեղ՝ ↓ ↑ ստեղներով, կամ թողեք «—» և սեղմեք Return"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga non indica la sottocategoria: sceglila nel pannello o con ↓ ↑ qui, oppure lascia “—”, poi premi Invio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブカテゴリが記載されていません。パネルまたはここで↓ ↑を使って選択するか、「—」のままにしてReturnキーを押してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სტრიქონში ქვეკატეგორია მითითებული არ არის — აირჩიეთ პანელში ან აქ ↓ ↑ ღილაკებით, ან დატოვეთ “—” და დააჭირეთ Return-ს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жолда ішкі санат айтылмаған — оны панельде, не мұнда ↓ ↑ арқылы таңдаңыз, не «—» қалдырып, Return басыңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목에 하위 카테고리가 없습니다. 패널이나 여기에서 ↓ ↑로 선택하거나 “—”로 두고 Return을 누르십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сапта кошумча категория көрсөтүлгөн эмес — аны панелден же бул жерде ↓ ↑ менен тандаңыз же «—» калтырып, Return басыңыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De regel vermeldt geen subcategorie. Kies er een in het paneel of hier met ↓ ↑, of laat ‘—’ staan en druk op Return"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiersz nie określa podkategorii. Wybierz ją w panelu albo za pomocą ↓ ↑ lub zostaw „—” i naciśnij Return"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha não informa a subcategoria — escolha uma no painel ou com ↓ ↑ aqui, ou mantenha “—” e pressione Return"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha não indica a subcategoria — escolha-a no painel ou com ↓ ↑ aqui, ou deixe “—”, e prima Return"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкатегорию по строке не определить — выберите её в панели или стрелками ↓ ↑ здесь, или оставьте «—», и нажмите Return"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар сатр зеркатегория зикр нашудааст — онро дар панел ё бо ↓ ↑ дар ин ҷо интихоб кунед ё «—»-ро монед ва Return-ро пахш кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırda alt kategori belirtilmemiş — panelden veya burada ↓ ↑ ile seçin ya da “—” bırakın ve Return’e basın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У рядку не вказано підкатегорію — виберіть її на панелі або тут за допомогою ↓ ↑ чи залиште «—» і натисніть Return"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Satрda quyi turkum ko‘rsatilmagan — uni panelda yoki shu yerda ↓ ↑ bilan tanlang yoki “—”ni qoldiring va Return tugmasini bosing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此行未注明子类别。在面板中或使用 ↓ ↑ 选择，也可保留“—”，然后按 Return"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此行未指定子類別。請在面板中或使用 ↓ ↑ 選擇，或保留「—」，然後按 Return"
          }
        }
      }
    },
