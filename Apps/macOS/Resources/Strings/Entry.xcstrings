    "entry.accountCharge.provisionalHelp": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс на гэты дзень яшчэ ўдакладняецца: праверце суму паводле выпіскі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurs dieses Tages wird noch verfeinert: Prüfen Sie den Betrag anhand der Abrechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate of this day is still being refined: check the figure against the statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de este día todavía se está ajustando: compruebe la cifra con el extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de ce jour est encore en cours de précision : vérifiez le montant sur le relevé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso di quel giorno è ancora in fase di aggiornamento: verifica l’importo sull’estratto conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күннің бағамы әлі нақтылануда: санды үзіндімен тексеріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs z tego dnia jest jeszcze ustalany. Sprawdź kwotę na wyciągu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cotação deste dia ainda está sendo ajustada: confira o valor no extrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс этого дня ещё уточняется: сверьте сумму с выпиской."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günün kuru henüz kesinleşmedi: tutarı hesap özetiyle karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс за цей день ще уточнюється: звірте суму з випискою."
          }
        }
      }
    },
