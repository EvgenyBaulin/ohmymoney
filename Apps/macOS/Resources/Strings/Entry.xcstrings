          "stringUnit": {
            "state": "translated",
            "value": "%1$@ corrisponde a %2$@ del debito. Il tasso vale solo per questo rimborso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は借金の%2$@に相当します。このレートは今回の返済にのみ適用されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ უდრის ვალის %2$@-ს. კურსი მხოლოდ ამ გადახდას ეხება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — берешектің %2$@. Мөлшерлеме тек осы қайтаруға арналған."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 채무의 %2$@입니다. 이 환율은 이번 상환에만 적용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — карыздын %2$@ бөлүгү. Курс ушул төлөмгө гана тиешелүү."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is %2$@ van de schuld. De koers geldt alleen voor deze terugbetaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to %2$@ długu. Kurs dotyczy tylko tej spłaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ equivale a %2$@ da dívida. A cotação vale apenas para este pagamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ corresponde a %2$@ da dívida. A taxa aplica-se apenas a este pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — это %2$@ долга. Курс — только для этого возврата."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ баробари %2$@ аз қарз аст. Қурб танҳо барои ин пардохт аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, borcun %2$@ tutarına karşılık gelir. Kur yalnızca bu ödeme içindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — це %2$@ боргу. Курс лише для цього погашення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — qarzning %2$@ qismi. Kurs faqat shu qaytim uchun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 相当于债务的 %2$@。此汇率仅用于本次还款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 相當於債務中的 %2$@。此匯率僅適用於本次還款。"
          }
        }
      }
    },
