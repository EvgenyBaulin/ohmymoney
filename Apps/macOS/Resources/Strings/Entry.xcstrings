    "entry.detailsCarried": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təfərrüatlar — burada seçilənlər növbəti əməliyyata keçirilir"
