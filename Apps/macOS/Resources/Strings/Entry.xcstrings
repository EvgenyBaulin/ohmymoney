    "entry.prepay.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк скароціць тэрмін крэдыту, паменшыць штомесячны плацёж ці грошы пойдуць на наступныя плацяжы?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkürzt die Bank die Laufzeit des Kredits oder senkt sie die monatliche Rate — oder bezahlt das Geld die nächsten Raten im Voraus?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will the bank shorten the term of the loan or lower its monthly payment — or does the money pay the next payments ahead?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca ridurrà la durata del prestito o la rata mensile? Oppure il denaro coprirà le prossime rate?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк несиенің мерзімін қысқарта ма, әлде айлық төлемін азайта ма — әлде ақша алдағы төлемдерді жабады ма?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк уменьшит срок кредита или ежемесячный платёж — или деньги закроют следующие платежи вперёд?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк скоротить строк кредиту чи зменшить щомісячний платіж — або гроші підуть на наступні платежі наперед?"
          }
        }
      }
    },
