    "entry.dictation.denied": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem məxfilik parametrlərində OhMyMoney üçün mikrofona və nitqin tanınmasına icazə verin. Yazmağa davam edə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дазвольце OhMyMoney доступ да мікрафона і распазнавання маўлення ў сістэмных наладах прыватнасці. Вы можаце працягваць уводзіць тэкст."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V nastavení soukromí systému povolte aplikaci OhMyMoney přístup k mikrofonu a rozpoznávání řeči. Můžete dál psát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie OhMyMoney in den Datenschutzeinstellungen des Systems den Zugriff auf Mikrofon und Spracherkennung. Sie können weiter tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone and speech recognition access for OhMyMoney in system privacy settings. You can keep typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a OhMyMoney el acceso al micrófono y al reconocimiento de voz en los ajustes de privacidad del sistema. Puede seguir escribiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès au micro et à la reconnaissance vocale pour OhMyMoney dans les réglages de confidentialité du système. Vous pouvez continuer à taper."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համակարգի գաղտնիության կարգավորումներում OhMyMoney-ին թույլ տվեք օգտվել խոսափողից և խոսքի ճանաչումից։ Կարող եք շարունակել մուտքագրել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a OhMyMoney di accedere al microfono e al riconoscimento vocale nelle impostazioni di privacy del sistema. Puoi continuare a scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのプライバシー設定で、OhMyMoneyにマイクと音声認識へのアクセスを許可してください。引き続き文字入力もできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სისტემის კონფიდენციალურობის პარამეტრებში მიეცით OhMyMoney-ს მიკროფონზე და მეტყველების ამოცნობაზე წვდომა. შეგიძლიათ აკრეფა განაგრძოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүйенің құпиялылық баптауларында OhMyMoney үшін микрофон мен сөйлеуді тану рұқсатын беріңіз. Теруді жалғастыра аласыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 개인정보 보호 설정에서 OhMyMoney의 마이크 및 음성 인식 접근을 허용하세요. 계속 직접 입력할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тутумдун купуялык жөндөөлөрүнөн OhMyMoney үчүн микрофонго жана кепти таанууга уруксат бериңиз. Терүүнү уланта аласыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef OhMyMoney toegang tot de microfoon en spraakherkenning in de privacy-instellingen van het systeem. Je kunt ook blijven typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól OhMyMoney na dostęp do mikrofonu i rozpoznawania mowy w ustawieniach prywatności systemu. Nadal możesz pisać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao microfone e ao reconhecimento de fala para o OhMyMoney nos ajustes de privacidade do sistema. Você pode continuar digitando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao microfone e ao reconhecimento de voz para o OhMyMoney nas definições de privacidade do sistema. Pode continuar a escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите OhMyMoney доступ к микрофону и распознаванию речи в настройках конфиденциальности системы. Можно продолжать вводить текст вручную."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар танзимоти махфияти система ба OhMyMoney дастрасӣ ба микрофон ва шинохти нутқро иҷозат диҳед. Метавонед навиштанро идома диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem gizlilik ayarlarında OhMyMoney için mikrofon ve konuşma tanıma erişimine izin verin. Yazmaya devam edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте OhMyMoney доступ до мікрофона та розпізнавання мовлення в системних налаштуваннях приватності. Можна продовжувати вводити текст."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tizimning maxfiylik sozlamalarida OhMyMoney uchun mikrofon va nutqni tanishga ruxsat bering. Matnni kiritishda davom etishingiz mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统隐私设置中允许 OhMyMoney 访问麦克风和语音识别。你仍可继续输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統隱私權設定中允許 OhMyMoney 使用麥克風和語音辨識。你仍可繼續輸入。"
          }
        }
      }
    },
    "entry.dictation.listening": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlənilir… Bitirmək üçün dayandırın və ya fasilə verin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухаю… Націсніце «Спыніць» або зрабіце паўзу, каб скончыць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslouchám… Klepnutím na Zastavit nebo pozastavením skončíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird zugehört… Tippen Sie auf Stopp oder Pause, um abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening… Tap stop or pause to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando… Pulse parar o pausa para terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute en cours… Appuyez sur stop ou pause pour terminer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լսում է… Ավարտելու համար հպեք կանգառին կամ դադար տվեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ascolto… Tocca Interrompi o fai una pausa per terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞き取り中…停止または一時停止をタップして終了します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გისმენთ… დასასრულებლად შეეხეთ გაჩერებას ან შეჩერებას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тыңдап жатыр… Аяқтау үшін тоқтатыңыз немесе үзіліс жасаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣는 중… 중단을 탭하거나 잠시 멈추면 완료됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Угулууда… Бүтүрүү үчүн токтотууну басыңыз же тыным жасаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Luistert… Tik op stop of pauzeer om te voltooien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasłuchiwanie… Stuknij przycisk zatrzymania lub zrób pauzę, aby zakończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvindo… Toque em parar ou pause para concluir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ouvir… Toque em Parar ou faça uma pausa para terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушаю… Нажмите стоп или сделайте паузу."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гӯш карда истодааст… Барои анҷом додан таваққуф кунед ё қатъро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinleniyor… Bitirmek için durdurun veya duraklatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухаємо… Натисніть «Зупинити» або зробіть паузу, щоб завершити."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinglanmoqda… Tugatish uchun to‘xtatish yoki pauzani bosing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在聆听…轻点停止或暂停以完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在聆聽…點一下停止或暫停即可結束。"
          }
        }
      }
    },
