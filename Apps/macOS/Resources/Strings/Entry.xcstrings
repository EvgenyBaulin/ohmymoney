    "entry.payWith.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта: пакупка аплачана картай, названай у радку, картай, якой карыстаюцца ў гэтым месцы, або асноўнай картай рахунку. Рахунак: грошы спісваюцца з самога рахунку, без карты — як «з рахунку» ў радку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karte: Der Kauf wird mit der Karte getätigt, die die Zeile nennt, mit der an diesem Ort genutzten oder mit der Hauptkarte des Kontos. Konto: Das Geld geht direkt vom Konto ab, ohne Karte — wie „von Konto“ in der Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card: the purchase is made with the card the line named, the one used at this place, or the main card of the account. Account: the money leaves the account itself, with no card — as «from account» in the line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjeta: la compra se hace con la tarjeta que indicó la línea, la que se usa en ese lugar o la tarjeta principal de la cuenta. Cuenta: el dinero sale de la propia cuenta, sin tarjeta — como «desde la cuenta» en la línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte : l'achat se fait avec la carte nommée dans la ligne, celle utilisée à cet endroit, ou la carte principale du compte. Compte : l'argent sort du compte lui-même, sans carte — comme « depuis le compte » dans la ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carta: l'acquisto viene effettuato con la carta indicata nella riga, quella usata in questo luogo o la carta principale del conto. Conto: il denaro viene prelevato direttamente dal conto, senza carta, come «dal conto» nella riga."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта: сатып алу енгізу жолында аталған картамен, осы орында қолданылған картамен немесе есеп-шоттың негізгі картасымен жасалады. Есеп-шот: ақша картасыз, есеп-шоттың өзінен кетеді — жолдағы «есеп-шоттан» сияқты."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta: zakup jest opłacany kartą wskazaną w wierszu, używaną w tym miejscu lub główną kartą konta. Konto: pieniądze są pobierane bezpośrednio z konta, bez karty — jak przy „z konta” w wierszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartão: a compra é feita com o cartão indicado na linha, o usado neste lugar ou o cartão principal da conta. Conta: o dinheiro sai da própria conta, sem cartão — como «da conta» na linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта — трата с карты, названной в строке, с той, что платили здесь в прошлый раз, или с основной карты счёта. Счёт — деньги уходят со счёта без карты, как «со счёта» в строке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart: Satın alım, satırda belirtilen kartla, bu yerde kullanılan kartla veya hesabın ana kartıyla yapılır. Hesap: Para, kart kullanılmadan doğrudan hesaptan çıkar — satırdaki «hesaptan» gibi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка: покупку оплачено карткою, названою в рядку, використаною в цьому місці або основною карткою рахунку. Рахунок: гроші списуються з самого рахунку без картки — як «з рахунку» в рядку."
          }
        }
      }
    },
