    "entry.payingFor.gift": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падарунак для %2$@: вы заплацілі %1$@, ніхто вам не вінны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Geschenk für %2$@: Sie haben %1$@ bezahlt, niemand schuldet Ihnen etwas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gift for %2$@: you paid %1$@, nobody owes you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un regalo para %2$@: usted pagó %1$@, nadie le debe nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cadeau pour %2$@ : vous avez payé %1$@, personne ne vous doit rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un regalo per %2$@: hai pagato %1$@, nessuno ti deve nulla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ үшін сыйлық: сіз %1$@ төледіңіз, ешкім сізге қарызды емес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prezent dla %2$@: zapłacono %1$@, nikt nie jest Ci winien pieniędzy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um presente para %2$@: você pagou %1$@ e ninguém deve a você."
          }
