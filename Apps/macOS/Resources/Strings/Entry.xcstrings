    "entry.cashback.rememberSplit": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Часткі маюць розныя катэгорыі — задайце правіла ў правілах кэшбэку рахунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Teile haben verschiedene Kategorien — legen Sie die Regel unter „Cashback-Regeln“ des Kontos fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parts have different categories — set the rule in the account’s Cashback Rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes tienen categorías distintas — fije la regla en las Reglas de cashback de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parts ont des catégories différentes — réglez la règle dans les « Règles de cashback » du compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parti hanno categorie diverse: imposta la regola nelle regole di cashback del conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөліктердің санаттары әртүрлі — ережені есеп-шоттың «Кешбэк ережелерінде» белгілеңіз."
