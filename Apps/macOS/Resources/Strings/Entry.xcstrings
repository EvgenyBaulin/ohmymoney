    "moneyBack.provisionalPartsOwed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошай больш, чым трэба для закрыцця даступных частак, а іншыя часткі чакаюць канчатковага курсу. Запішыце грошы пазней або ўручную."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld ist mehr, als die Teile decken können, während andere Teile auf ihren endgültigen Kurs warten. Erfassen Sie es später oder von Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money is more than the parts it can close while other parts wait for their final rate. Record it later, or manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero supera lo que pueden cerrar las partes mientras otras esperan su tipo definitivo. Regístrelo más tarde, o a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent dépasse les parts qu'il peut clôturer, car d'autres parts attendent leur taux définitif. Notez-le plus tard, ou à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro supera le parti che può saldare, mentre altre attendono il tasso definitivo. Registralo più tardi oppure manualmente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша басқа бөліктер соңғы бағамын күтіп тұрғанда жабатын бөліктерден көп. Оны кейін жазыңыз, не қолмен."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota przekracza wartość części, które można rozliczyć, a pozostałe czekają na ostateczny kurs. Zapisz zwrot później lub ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor é maior que o das partes que podem ser quitadas, enquanto outras aguardam a cotação definitiva. Lance-o depois ou manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Денег больше, чем закрывают части, а другие части ждут окончательного курса. Запишите позже или вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelen para, kapatılabilecek tutarlardan fazla; diğer tutarlar kesin kuru bekliyor. Daha sonra veya elle kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошей більше, ніж частин, які зараз можна закрити; інші частини ще чекають остаточного курсу. Запишіть пізніше або вручну."
          }
        }
      }
    },
    "moneyBack.provisionalRate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс гэтых грошай яшчэ папярэдні. Увядзіце курс на панэлі ↓ або запішыце грошы пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurs dieses Geldes ist noch vorläufig. Tragen Sie den Kurs im Bedienfeld ↓ ein oder erfassen Sie das Geld später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate of this money is still provisional. Type the rate in the ↓ panel, or record the money later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de este dinero todavía es provisional. Escriba el tipo en el panel ↓, o registre el dinero más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de cet argent est encore provisoire. Saisissez le taux dans le panneau ↓, ou notez l'argent plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso di questo denaro è ancora provvisorio. Inserisci il tasso nel pannello ↓ oppure registra il denaro più tardi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ақшаның бағамы әлі уақытша. Бағамды ↓ панельде теріңіз, не ақшаны кейін жазыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs tych pieniędzy jest jeszcze tymczasowy. Wpisz kurs w panelu ↓ lub zapisz zwrot później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cotação deste dinheiro ainda é provisória. Informe a cotação no painel ↓ ou lance o dinheiro depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс этих денег ещё предварительный. Введите курс в панели ↓ или запишите позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu paranın kuru hâlâ geçici. ↓ paneline kuru girin veya parayı daha sonra kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс цих грошей ще попередній. Введіть курс на панелі ↓ або запишіть гроші пізніше."
          }
        }
      }
    },
