    "entry.payWith.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card: the purchase is made with the card the line named, the one used at this place, or the main card of the account. Account: the money leaves the account itself, with no card — as «from account» in the line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjeta: la compra se hace con la tarjeta que indicó la línea, la que se usa en ese lugar o la tarjeta principal de la cuenta. Cuenta: el dinero sale de la propia cuenta, sin tarjeta — como «desde la cuenta» en la línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte : l'achat se fait avec la carte nommée dans la ligne, celle utilisée à cet endroit, ou la carte principale du compte. Compte : l'argent sort du compte lui-même, sans carte — comme « depuis le compte » dans la ligne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта — трата с карты, названной в строке, с той, что платили здесь в прошлый раз, или с основной карты счёта. Счёт — деньги уходят со счёта без карты, как «со счёта» в строке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка: покупку оплачено карткою, названою в рядку, використаною в цьому місці або основною карткою рахунку. Рахунок: гроші списуються з самого рахунку без картки — як «з рахунку» в рядку."
          }
        }
      }
    },
