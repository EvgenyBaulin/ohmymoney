    "entry.accountCharge.check": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума спісання не пералічана — праверце яе"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Belastet auf Konto“ wurde nicht neu berechnet — prüfen Sie es"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charged to account was not recalculated — check it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cargo en la cuenta no se recalculó: compruébelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le débit du compte n'a pas été recalculé — vérifiez-le"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’addebito sul conto non è stato ricalcolato: verifica l’importo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттан шегерілгені қайта есептелмеді — тексеріңіз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obciążzenie konta nie zostało przeliczone — sprawdź je"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor debitado da conta não foi recalculado — confira"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списано со счёта не пересчитано — проверьте"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaptan çekilen tutar yeniden hesaplanmadı — kontrol edin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списання з рахунку не перераховано — перевірте"
          }
        }
      }
    },
