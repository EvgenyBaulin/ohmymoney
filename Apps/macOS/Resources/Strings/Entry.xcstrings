    "entry.debt.moneyBack": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizə olan borca qaytarılan pul borcun ödənişidir: qalan məbləğ ödənilir və borc bağlanır, artıq məbləğ isə «Əlavə gəlirlər» bölməsində gəlir sayılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы па доўгу перад вамі лічацца яго вяртаннем: рэшта доўгу пагашаецца і ён закрываецца, а лішак залічваецца ў даход «Даплаты»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze přijaté na dluh vůči vám se považují za jeho splacení: uhradí zbývající část a dluh uzavřou. Případný přeplatek je příjmem v «Příplatcích»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld auf eine Schuld, die Ihnen geschuldet wird, ist die Rückzahlung dieser Schuld: Sie nimmt, was übrig ist, und endet; was darüber liegt, ist Einnahme bei den „Aufschlägen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money onto a debt owed to you is the debt paid back: it takes what is left and closes, what is over is income in «Surcharges»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero que entra en una deuda que le deben es el pago de esa deuda: cubre lo que queda y se cierra; lo que sobre es ingreso en «Recargos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent versé sur une dette qui vous est due rembourse la dette : il prend ce qui reste et la clôt ; le surplus va en revenu dans « Surcharges »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեզ վերադարձված պարտքից մարվում է մնացորդը, և պարտքը փակվում է․ ավելցուկը եկամուտ է «Հավելավճարներ» բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un versamento su un credito viene considerato un rimborso: copre l’importo residuo e chiude il credito. L’eccedenza è un’entrata in «Maggiorazioni»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貸付への入金は返済として扱われます。残額分が返済されて完了となり、超過分は«Surcharges»の収入になります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენდამი ვალზე ჩარიცხული თანხა ვალის დაბრუნებად ითვლება: იფარება დარჩენილი ვალი, ზედმეტი თანხა კი შემოსავალია კატეგორიაში «Surcharges»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сізге берілген берешекке қайтарылған ақша — берешекті қайтару: ол қалғанын алып, жабылады, артығы «Үстемақылардағы» табыс болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받을 돈에 입금하면 채무 상환으로 처리됩니다. 남은 금액을 상환하면 채무가 종료되고, 초과 금액은 «Surcharges»의 수입으로 기록됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сизге болгон карызга түшкөн акча карыздын кайтарымы болуп эсептелет: калган карыз жабылат, ашыгы «Үстөктөр» категориясына киреше болуп түшөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ontvangst voor een schuld aan jou geldt als terugbetaling. Het resterende bedrag wordt afgelost en de schuld wordt afgesloten. Het teveel is een inkomst in «Toeslagen»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłata na należny Ci dług jest jego spłatą: pokrywa pozostałą kwotę i zamyka dług. Nadwyżka jest przychodem w «Surcharges»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor recebido por uma dívida devida a você quita o saldo restante e encerra a dívida; o excedente é uma receita em «Acréscimos»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor recebido por uma dívida a seu favor liquida o montante em falta e fecha a dívida; o excedente é registado como receita em «Surcharges»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги по долгу «Мне должны» — возврат долга: он заберёт остаток и закроется, лишнее станет доходом в «Доплатах»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағе, ки барои қарзи ба шумо додашуда меояд, баргардонидани қарз аст: бақияро мепӯшонад ва қарзро мебандад; маблағи зиёдатӣ даромад дар «Иловапардохтҳо» мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size olan bir borca gelen para, borcun geri ödemesidir: kalan borç kapatılır, fazlası «Ek Ödemeler» içinde gelir sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші в рахунок боргу вам — його погашення: залишок погашається, борг закривається, а надлишок стає доходом у «Доплатах»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizga bo‘lgan qarzga tushgan pul qarz qaytarimi hisoblanadi: qolgan qarz qoplanib, yopiladi, ortiqcha summa esa «Ustamalar»ga daromad sifatida yoziladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到他人还款时，金额会用于结清剩余债务，超出部分计入«Surcharges»收入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到別人欠你的款項時，會先償還剩餘債務並將其結清；超出部分會記為 «Surcharges» 的收入。"
          }
        }
      }
    },
