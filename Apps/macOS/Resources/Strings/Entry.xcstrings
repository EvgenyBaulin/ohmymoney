    "reimbursement.shareExceedsPart": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay alışın dəyərindən çoxdur. Artıq pul payın bir hissəsi deyil, artıqlıqdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля большая за кошт пакупкі. Лішнія грошы — гэта лішак, а не частка долі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podíl je vyšší než cena příslušné části nákupu. Peníze navíc jsou přebytek, nikoli součást podílu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anteil ist größer als das, was sein Kauf gekostet hat. Das überschüssige Geld ist ein Überschuss, kein Teil eines Anteils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A share is larger than what its purchase cost. The extra money is a surplus, not part of a share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte es mayor que lo que costó su compra. El dinero de más es un excedente, no parte de una cuota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une part est plus grande que ce que coûtait son achat. L'argent en trop est un surplus, pas une partie de la part."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բաժինը գերազանցում է գնման արժեքը։ Ավել գումարը ավելցուկ է, ոչ թե բաժնի մաս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una quota supera il costo del relativo acquisto. La differenza è un'eccedenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割当額が購入額を超えています。超過分は割当額ではなく余剰金です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წილი მისი შენაძენის ღირებულებას აღემატება. ზედმეტი თანხა ნამეტია და არა წილის ნაწილი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлес оның сатып алуының құнынан үлкен. Артық ақша — артықшылық, үлестің бөлігі емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분담액이 해당 구매 비용보다 큽니다. 초과 금액은 분담액이 아닌 잉여금입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлүш сатып алуунун наркынан көп. Ашыкча акча үлүшкө кирбейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aandeel is groter dan de kosten van de aankoop. Het extra geld is een overschot en hoort niet bij een aandeel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udział jest większy niż koszt zakupu. Nadwyżka nie jest częścią udziału."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parcela é maior que o custo da compra. O valor extra é um excedente, não parte da parcela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parte é superior ao custo da respetiva compra. O valor adicional é um excedente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля больше, чем стоила покупка. Лишние деньги — излишек, а не часть доли."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисса аз арзиши хариди он зиёд аст. Маблағи изофӣ қисми ҳисса нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pay, alışverişteki tutarını aşıyor. Fazla para, payın bir parçası değil, artıktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частка перевищує вартість покупки. Зайві гроші — надлишок, а не частина частки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulush xarid qiymatidan katta. Ortiqcha pul ulushga kirmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分摊金额超过了对应的购买支出。多出的钱属于盈余，不计入分摊金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分攤金額超過購買項目的費用。多出的款項屬於盈餘，並非分攤款項。"
          }
        }
      }
    },
    "reimbursement.sharesExceedReceived": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Payların cəmi qaytarılan məbləğdən çoxdur. Onları düzəldin və ya “Yenidən bölüşdür” seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума доляў большая за атрыманую суму. Выпраўце іх або націсніце «Размеркаваць зноў»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Součet podílů je vyšší než vrácená částka. Opravte je nebo stiskněte „Rozdělit znovu“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anteile ergeben mehr, als zurückkam. Korrigieren Sie sie oder drücken Sie „Erneut verteilen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shares add up to more than came back. Correct them or press “Spread again”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes suman más de lo que volvió. Corríjalas o pulse «Repartir de nuevo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parts font plus que ce qui est revenu. Corrigez-les ou appuyez sur « Répartir à nouveau »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բաժինների գումարը գերազանցում է վերադարձված գումարը։ Ուղղեք դրանք կամ սեղմեք «Կրկին բաշխել»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La somma delle quote supera l'importo ricevuto. Correggile o premi “Ripartisci di nuovo”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割当額の合計が返金額を超えています。修正するか、「再配分」を押してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წილების ჯამი დაბრუნებულ თანხას აღემატება. შეასწორეთ ისინი ან დააჭირეთ „ხელახლა განაწილებას“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлестердің қосындысы қайтқан соманы асып түр. Оларды түзетіңіз немесе «Қайта бөлу» басыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분담액의 합계가 돌려받은 금액보다 큽니다. 분담액을 수정하거나 “다시 배분”을 누르세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлүштөрдүн суммасы кайтарылган акчадан көп. Аларды оңдоңуз же «Кайра бөлүштүрүү» баскычын басыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aandelen zijn samen meer dan het ontvangen bedrag. Pas ze aan of druk op ‘Verdeel opnieuw’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma udziałów przekracza otrzymaną kwotę. Popraw je lub naciśnij „Rozdziel ponownie”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A soma das parcelas é maior que o valor devolvido. Corrija-as ou pressione “Distribuir novamente”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A soma das partes é superior ao valor recebido. Corrija-as ou prima “Distribuir novamente”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доли в сумме больше, чем вернули. Поправьте их или нажмите «Распределить заново»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷамъи ҳиссаҳо аз маблағи баргашта зиёд аст. Онҳоро ислоҳ кунед ё «Аз нав тақсим кардан»-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payların toplamı gelen parayı aşıyor. Payları düzeltin veya “Yeniden Dağıt”ı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума часток перевищує отримані гроші. Виправте їх або натисніть «Розподілити знову»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulushlar yig‘indisi qaytgan puldan ko‘p. Ularni tuzating yoki “Qayta taqsimlash”ni bosing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分摊金额之和超过了收到的金额。请修改金额或点击“重新分配”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分攤金額合計超過收到的款項。請修正金額或按「重新分配」。"
          }
        }
      }
    },
