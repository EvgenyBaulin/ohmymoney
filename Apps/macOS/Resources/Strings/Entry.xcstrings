    "entry.error.debtCurrency": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borc başqa valyutadadır: əməliyyatı borcun valyutasında daxil edin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доўг вядзецца ў іншай валюце: увядзіце аперацыю ў валюце доўгу"
          }
        },
        "cs": {
