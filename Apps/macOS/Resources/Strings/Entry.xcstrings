    "entry.add.accountNotBack": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак «%1$@» у архіве, і яго пакуль нельга вярнуць: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto „%1$@“ ist im Archiv und kann jetzt nicht zurückkommen: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account «%1$@» is in the archive and cannot come back now: %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto «%1$@» è nell’archivio e non può essere ripristinato ora: %2$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» есеп-шоты мұрағатта және қазір қайтарыла алмайды: %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт «%1$@» в архиве, и сейчас его не вернуть: %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок «%1$@» в архіві, і зараз його не можна повернути: %2$@"
          }
        }
      }
    },
    "entry.add.categoryTaken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут ужо ёсць катэгорыя з такой назвай."
