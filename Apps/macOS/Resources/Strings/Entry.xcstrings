      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — запісана ў %@. Дадаць яшчэ адну?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — erfasst um %@. Noch einen hinzufügen?"
