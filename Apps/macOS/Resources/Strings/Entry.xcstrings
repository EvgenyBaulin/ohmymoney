    "moneyBack.onlyProvisional": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усё, што вінны гэты чалавек, запісана паводле папярэдняга курсу. Запішыце грошы, калі курсы стануць канчатковымі, або ўручную."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was diese Person schuldet, steht auf einem vorläufigen Kurs. Erfassen Sie das Geld, sobald die Kurse endgültig sind, oder von Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything this person owes is on a provisional rate. Record the money once the rates are final, or manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que esta persona le debe está con un tipo provisional. Registre el dinero cuando los tipos sean definitivos, o a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que cette personne doit est au taux provisoire. Notez l'argent une fois les taux définitifs, ou à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli importi dovuti da questa persona hanno un tasso provvisorio. Registra il denaro quando i tassi sono definitivi oppure manualmente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл адамның барлық қарызы уақытша бағамда. Бағамдар соңғы болғанда немесе қолмен ақшаны жазыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie należności od tej osoby mają tymczasowy kurs. Zapisz zwrot, gdy kursy będą ostateczne, lub zrób to ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que essa pessoa deve está com cotação provisória. Lance o dinheiro quando as cotações forem definitivas ou faça isso manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что должен этот человек, пока по предварительному курсу. Запишите деньги, когда курс станет окончательным, или вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişinin tüm borçları geçici kurda. Kurlar kesinleşince veya elle kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі борги цієї людини мають попередній курс. Запишіть гроші після уточнення курсів або вручну."
          }
        }
      }
    },
    "moneyBack.owesNothing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты чалавек вам нічога не вінны. Грошы, якія не з'яўляюцца вяртаннем, — гэта даход. Запішыце іх як даход."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person schuldet Ihnen nichts. Geld, das für etwas nicht zurückgekommen ist, ist Einnahme — erfassen Sie es als Einnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This person owes you nothing. Money that did not come back for something is income — record it as income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta persona no le debe nada. El dinero que no volvió por algo es ingreso — regístrelo como ingreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne vous doit rien. L'argent qui n'est pas revenu pour quelque chose est un revenu — notez-le comme revenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona non ti deve nulla. Il denaro ricevuto senza un importo da rimborsare è un’entrata: registralo come tale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл адам сізге ештеңе қарыз емес. Бір нәрсе үшін қайтпаған ақша — табыс: оны табыс ретінде жазыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta osoba nic Ci nie jest winna. Pieniądze, które nie są zwrotem, to przychód — zapisz je jako przychód."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pessoa não deve nada a você. Dinheiro que não é reembolso é receita — lance-o como receita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот человек вам ничего не должен. Деньги не за что-то купленное — это доход: запишите их доходом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişinin size borcu yok. Bir ödemenin iadesi olmayan para gelirdir; gelir olarak kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця людина вам нічого не винна. Гроші, які не є поверненням за щось, — це дохід; запишіть їх як дохід."
          }
        }
      }
    },
    "moneyBack.owesNothingMore": {
