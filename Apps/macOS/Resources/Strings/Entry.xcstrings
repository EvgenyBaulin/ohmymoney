    "entry.minBalance.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасля гэтага баланс будзе %1$@ — ніжэй за %2$@, стаўка за месяц можа быць страчана"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach beträgt der Saldo %1$@ — unter %2$@, der Zinssatz für den Monat könnte verloren gehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this the balance will be %1$@ — below %2$@, the rate for the month may be lost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después el saldo será %1$@ — por debajo de %2$@, el tipo del mes puede perderse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après cela le solde sera de %1$@ — sous %2$@, le taux du mois peut être perdu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo sarà %1$@ — sotto %2$@ potresti perdere il tasso del mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осыдан кейін теңгерім %1$@ болады — %2$@ төмен, айдың мөлшерлемесі жоғалуы мүмкін"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo wyniesie %1$@ — poniżej %2$@ możesz stracić oprocentowanie za ten miesiąc"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo ficará em %1$@ — abaixo de %2$@; a taxa do mês pode ser perdida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этого остаток станет %1$@ — ниже %2$@, ставка за месяц может пропасть"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemden sonra bakiye %1$@ olacak — %2$@ tutarının altında kalırsa aylık faiz oranı kaybedilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після цього залишок буде %1$@ — менше ніж %2$@, ставку за місяць може бути втрачено"
          }
        }
      }
    },
