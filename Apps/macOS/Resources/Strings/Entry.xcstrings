            "state": "translated",
            "value": "Alt kateqoriya seçin və ya “—” saxlayın"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце падкатэгорыю або пакіньце «—»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
