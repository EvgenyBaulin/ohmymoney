          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución propia: algo comprado antes del libro de cuentas, o dinero retirado de un objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
