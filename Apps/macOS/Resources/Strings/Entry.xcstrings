    "reimbursement.shareExceedsPart": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля большая за кошт пакупкі. Лішнія грошы — гэта лішак, а не частка долі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anteil ist größer als das, was sein Kauf gekostet hat. Das überschüssige Geld ist ein Überschuss, kein Teil eines Anteils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A share is larger than what its purchase cost. The extra money is a surplus, not part of a share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte es mayor que lo que costó su compra. El dinero de más es un excedente, no parte de una cuota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une part est plus grande que ce que coûtait son achat. L'argent en trop est un surplus, pas une partie de la part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una quota supera il costo del relativo acquisto. La differenza è un'eccedenza."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлес оның сатып алуының құнынан үлкен. Артық ақша — артықшылық, үлестің бөлігі емес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udział jest większy niż koszt zakupu. Nadwyżka nie jest częścią udziału."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parcela é maior que o custo da compra. O valor extra é um excedente, não parte da parcela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля больше, чем стоила покупка. Лишние деньги — излишек, а не часть доли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pay, alışverişteki tutarını aşıyor. Fazla para, payın bir parçası değil, artıktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частка перевищує вартість покупки. Зайві гроші — надлишок, а не частина частки."
          }
        }
      }
    },
    "reimbursement.sharesExceedReceived": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума доляў большая за атрыманую суму. Выпраўце іх або націсніце «Размеркаваць зноў»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anteile ergeben mehr, als zurückkam. Korrigieren Sie sie oder drücken Sie „Erneut verteilen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shares add up to more than came back. Correct them or press “Spread again”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes suman más de lo que volvió. Corríjalas o pulse «Repartir de nuevo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parts font plus que ce qui est revenu. Corrigez-les ou appuyez sur « Répartir à nouveau »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La somma delle quote supera l'importo ricevuto. Correggile o premi “Ripartisci di nuovo”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлестердің қосындысы қайтқан соманы асып түр. Оларды түзетіңіз немесе «Қайта бөлу» басыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma udziałów przekracza otrzymaną kwotę. Popraw je lub naciśnij „Rozdziel ponownie”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A soma das parcelas é maior que o valor devolvido. Corrija-as ou pressione “Distribuir novamente”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доли в сумме больше, чем вернули. Поправьте их или нажмите «Распределить заново»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payların toplamı gelen parayı aşıyor. Payları düzeltin veya “Yeniden Dağıt”ı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума часток перевищує отримані гроші. Виправте їх або натисніть «Розподілити знову»."
          }
        }
      }
    },
