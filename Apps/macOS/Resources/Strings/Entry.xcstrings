    "entry.detailsCarried": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падрабязнасці — выбранае тут перанясецца ў наступную аперацыю"
          }
        },
        "de": {
          "stringUnit": {
