            "value": "Nie udało się zapisać zwrotu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registrar a devolução"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registar o reembolso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат записать не удалось"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақайдгирии ҷуброн имкон надод"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri ödeme kaydedilemedi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося записати повернення грошей"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytarilgan pulni qayd etib bo‘lmadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法记录还款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法記錄還款"
          }
        }
      }
    },
    "reimbursement.moneyRateProvisional": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank bu günün məzənnəsini hələ dərc etməyib. Pulun məzənnəsini daxil edin və ya sonra qeyd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк яшчэ не апублікаваў курс на гэты дзень. Увядзіце курс валюты або запішыце пазней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka zatím nezveřejnila kurz pro tento den. Zadejte kurz vrácených peněz nebo je zaznamenejte později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat den Kurs dieses Tages noch nicht veröffentlicht. Tragen Sie den Kurs des Geldes ein oder erfassen Sie es später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank has not published the rate of this day yet. Type the rate of the money, or record it later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco todavía no ha publicado el tipo de este día. Escriba el tipo del dinero, o regístrelo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque n'a pas encore publié le taux de ce jour. Saisissez le taux de l'argent, ou notez-le plus tard."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկը դեռ չի հրապարակել այդ օրվա փոխարժեքը։ Մուտքագրեք գումարի փոխարժեքը կամ գրանցեք ավելի ուշ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca non ha ancora pubblicato il tasso di questo giorno. Inserisci il tasso del rimborso o registralo più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行がこの日のレートをまだ公開していません。返金のレートを入力するか、後で記録してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკს ამ დღის კურსი ჯერ არ გამოუქვეყნებია. შეიყვანეთ თანხის კურსი ან მოგვიანებით აღრიცხეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк бұл күннің бағамын әлі жарияламаған. Ақшаның бағамын теріңіз, не ақшаны кейін жазыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행에서 이날의 환율을 아직 발표하지 않았습니다. 해당 금액의 환율을 입력하거나 나중에 기록하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк бул күндүн курсун азырынча жарыялай элек. Акчанын курсун киргизиңиз же кийин каттаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bank heeft de koers voor deze dag nog niet gepubliceerd. Voer de koers van het ontvangen geld in of leg de terugbetaling later vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank nie opublikował jeszcze kursu z tego dnia. Wpisz kurs zwróconych pieniędzy lub zapisz zwrot później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco ainda não publicou a taxa deste dia. Digite a taxa do dinheiro recebido ou registre depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco ainda não publicou a taxa deste dia. Introduza a taxa do dinheiro recebido ou registe-o mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ещё не опубликовал курс этого дня. Введите курс возврата или запишите позже."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк қурби ин рӯзро ҳанӯз нашр накардааст. Қурби асъорро ворид кунед ё баъдтар сабт кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka bu günün kurunu henüz yayımlamadı. Paranın kurunu girin veya daha sonra kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ще не опублікував курс за цей день. Введіть курс отриманих грошей або запишіть пізніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank bu kun uchun kursni hali e’lon qilmagan. Pul kursini kiriting yoki keyinroq qayd eting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行尚未公布当天的汇率。请输入还款汇率，或稍后记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行尚未公布當日匯率。請輸入款項的匯率，或稍後再記錄。"
          }
        }
      }
    },
    "reimbursement.noSurcharges": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Payların dəyərindən çox pul qaytarılıb və fərq üçün Əlavə ödənişlər kateqoriyası yoxdur. Heç nə qeydə alınmadı: payların dəyərindən çox olmayan məbləğ daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вярнулася больш, чым каштавалі долі, а катэгорыі для даплаты няма. Нічога не запісана: увядзіце суму не большую за кошт доляў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátilo se více, než kolik části stály, a pro rozdíl chybí kategorie Příplatky. Nic se nezaznamenalo. Zadejte nejvýše cenu částí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kam mehr zurück, als die Teile gekostet haben, und es gibt keine Kategorie „Aufschläge“ für die Differenz. Nichts wurde erfasst: Tragen Sie nicht mehr ein, als die Teile gekostet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More came back than the parts cost, and there is no Surcharges category for the difference. Nothing was recorded: enter no more than the parts cost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volvió más dinero del que costaron las partes, y no hay categoría de Recargos para la diferencia. No se registró nada: introduzca no más de lo que costaron las partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est revenu plus que ce que coûtaient les parts, et il n'y a pas de catégorie « Surcharges » pour l'écart. Rien n'a été noté : ne saisissez pas plus que le coût des parts."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերադարձվել է ավելին, քան մասերի արժեքն է, իսկ տարբերության համար «Հավելավճարներ» կատեգորիա չկա։ Ոչինչ չի գրանցվել․ մուտքագրեք մասերի արժեքը չգերազանցող գումար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rimborso supera il costo delle quote e non esiste una categoria Supplementi per la differenza. Non è stato registrato nulla: inserisci al massimo il costo delle quote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金額が立替額を超えていますが、差額を記録する「追加料金」カテゴリがありません。何も記録されていません。立替額以下を入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაბრუნებული თანხა ნაწილების ღირებულებას აღემატება, სხვაობისთვის კი დანამატების კატეგორია არ არსებობს. არაფერი აღრიცხულა: შეიყვანეთ არაუმეტეს ნაწილების ღირებულებისა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөліктердің құнынан артық қайтты, ал айырма үшін «Үстемақылар» санаты жоқ. Ештеңе жазылмады: бөліктердің құнынан артық енгізбеңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌려받은 금액이 해당 항목의 비용보다 많지만 차액을 기록할 추가 요금 카테고리가 없습니다. 기록된 내용이 없습니다. 해당 항목의 비용 이하로 입력하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүктөрдүн наркынан көп акча кайтарылды, бирок айырма үчүн Кошумча төлөмдөр категориясы жок. Эч нерсе катталган жок: бөлүктөрдүн наркынан ашырбай киргизиңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is meer teruggekomen dan de delen kostten en er is geen categorie Toeslagen voor het verschil. Er is niets vastgelegd: voer maximaal de kosten van de delen in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrócono więcej, niż wynosi koszt części, a brak kategorii Dopłaty dla różnicy. Nic nie zapisano: wpisz kwotę nie większą niż koszt części."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor devolvido é maior que o custo das partes e não há uma categoria de Acréscimos para a diferença. Nada foi registrado: informe no máximo o custo das partes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor recebido é superior ao custo das partes e não existe uma categoria de Sobretaxas para a diferença. Não foi registado nada: introduza um valor até ao custo das partes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернули больше, чем стоили части, а категории «Доплаты» для разницы нет. Ничего не записано: введите сумму не больше стоимости частей."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи баргашта аз арзиши қисмҳо зиёд аст ва барои фарқият категорияи «Иловапулӣ» нест. Ҳеҷ чиз сабт нашуд: маблағеро ворид кунед, ки аз арзиши қисмҳо зиёд набошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelen para payların tutarını aşıyor ve fark için bir Ek Ücretler kategorisi yok. Hiçbir şey kaydedilmedi: payların tutarından fazlasını girmeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернулося більше, ніж коштували частини, а категорії «Доплати» для різниці немає. Нічого не записано: введіть не більше вартості частин."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytgan pul qismlar qiymatidan ko‘p, farq uchun esa «Qo‘shimcha to‘lovlar» kategoriyasi yo‘q. Hech narsa qayd etilmadi: qismlar qiymatidan oshmaydigan summa kiriting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还款金额超过了这些部分的支出，且没有用于记录差额的“附加费”类别。未记录任何金额：请输入不超过支出的金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到的金額超過代墊款項，且沒有可記錄差額的「附加費」類別。未記錄任何款項：輸入金額不得超過代墊款項。"
          }
        }
      }
    },
    "reimbursement.partGone": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş pay artıq geri ödəniş gözləmir: alış silinib və ya pay silinib, yaxud bağlanıb. Siyahı yeniləndi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбраная доля больш не чакае вяртання грошай: пакупку выдалілі або долю спісалі ці закрылі. Спіс абноўлены."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U vybrané části se už nečeká na vrácení peněz. Nákup byl smazán nebo byla část odepsána či uzavřena. Seznam byl aktualizován."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gewählter Teil wartet nicht mehr auf sein Geld — sein Kauf wurde gelöscht, oder der Teil wurde abgeschrieben oder beendet. Die Liste wurde aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chosen part is no longer waiting for its money — its purchase was deleted, or the part was written off or closed. The list has been refreshed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte elegida ya no espera su dinero — su compra se eliminó, o la parte se dio de baja o se cerró. La lista se ha actualizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une part choisie n'attend plus son argent — son achat a été supprimé, ou la part a été passée en pertes ou clôturée. La liste a été actualisée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրված մասերից մեկի գումարն այլևս չի սպասվում․ գնումը ջնջվել է, կամ մասը դուրս է գրվել կամ փակվել։ Ցանկը թարմացվել է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una quota selezionata non è più in attesa di rimborso: l'acquisto è stato eliminato oppure la quota è stata stornata o chiusa. L'elenco è stato aggiornato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目は返金待ちではなくなりました。購入が削除されたか、項目が償却または完了されています。リストを更新しました。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არჩეული ნაწილი ანაზღაურებას აღარ ელოდება — მისი შენაძენი წაიშალა, ან ნაწილი ჩამოიწერა ან დაიხურა. სია განახლდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған бөлік енді ақшасын күтпейді — оның сатып алуы жойылған, не бөлік есептен шығарылған немесе жабылған. Тізім жаңартылды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목이 더 이상 변제를 기다리고 있지 않습니다. 구매 내역이 삭제되었거나 해당 항목이 대손 처리 또는 마감되었습니다. 목록이 새로고침되었습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тандалган бөлүк боюнча акча күтүлбөй калды: сатып алуу өчүрүлгөн же бөлүк эсептен чыгарылган же жабылган. Тизме жаңыртылды."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gekozen deel staat niet meer open: de aankoop is verwijderd of het deel is afgeboekt of afgesloten. De lijst is bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana część nie oczekuje już na zwrot — zakup został usunięty albo część została umorzona lub zamknięta. Lista została odświeżona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parte escolhida não aguarda mais devolução: a compra foi apagada ou a parte foi baixada ou encerrada. A lista foi atualizada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parte escolhida já não aguarda pagamento: a compra foi apagada ou a parte foi anulada ou encerrada. A lista foi atualizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная часть больше не ожидает возврата — покупку удалили, часть списали или уже закрыли. Список обновлён."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Яке аз қисмҳои интихобшуда дигар интизори пардохт нест: хариди он ҳазф шудааст ё қисм аз ҳисоб бароварда ё баста шудааст. Рӯйхат нав карда шуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen bir pay artık geri ödeme beklemiyor. Alışverişi silinmiş veya pay silinmiş ya da kapatılmış. Liste yenilendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана частина більше не очікує грошей: покупку видалено, частину списано або закрито. Список оновлено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlangan qism uchun to‘lov endi kutilmayapti: xarid o‘chirilgan yoki qism hisobdan chiqarilgan yoxud yopilgan. Ro‘yxat yangilandi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选部分已无需还款：购买记录已删除，或该部分已核销或结清。列表已刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選款項已不再等待償還，可能是購買項目已刪除，或款項已沖銷或結清。列表已更新。"
          }
        }
      }
    },
    "reimbursement.provisionalRate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışın məzənnəsi hələ dəqiqləşdirilir. ⌘R basın və yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс гэтай пакупкі яшчэ ўдакладняецца. Націсніце ⌘R і паспрабуйце яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz tohoto nákupu se ještě upřesňuje. Stiskněte ⌘R a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurs dieses Kaufs wird noch verfeinert — drücken Sie ⌘R und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate of this purchase is still being refined — press ⌘R and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de esta compra todavía se está ajustando — pulse ⌘R e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de cet achat est encore en cours de précision — appuyez sur ⌘R et réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գնման փոխարժեքը դեռ ճշտվում է․ սեղմեք ⌘R և կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso di questo acquisto è ancora in fase di definizione. Premi ⌘R e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この購入のレートはまだ確定していません。⌘Rを押してからやり直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ შენაძენის კურსი ჯერ ზუსტდება — დააჭირეთ ⌘R-ს და სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сатып алудың бағамы әлі нақтылануда — ⌘R басып, қайталап көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구매의 환율이 아직 확정되지 않았습니다. ⌘R을 누른 후 다시 시도하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сатып алуунун курсу азырынча такталып жатат — ⌘R басып, кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koers van deze aankoop wordt nog bijgewerkt. Druk op ⌘R en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs tego zakupu jest nadal aktualizowany — naciśnij ⌘R i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa desta compra ainda está sendo atualizada. Pressione ⌘R e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa desta compra ainda está a ser atualizada. Prima ⌘R e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс этой покупки ещё уточняется — нажмите ⌘R и попробуйте снова."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби ин харид ҳанӯз дақиқ мешавад — ⌘R-ро пахш кунед ва дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışverişin kuru hâlâ kesinleşiyor. ⌘R tuşlarına basıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс цієї покупки ще уточнюється — натисніть ⌘R і спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu xarid kursi hali aniqlashtirilmoqda. ⌘R tugmalarini bosib, qayta urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此笔购买的汇率仍在更新中，请按 ⌘R 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆購買的匯率仍在更新中，請按 ⌘R 再試一次。"
          }
        }
      }
    },
