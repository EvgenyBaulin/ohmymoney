    "entry.gap.category": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneldə və ya burada ↓ ↑ ilə kateqoriya və ya “Naməlum” seçin və Return düyməsini basın"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце катэгорыю або «Невядома» на панэлі ці тут клавішамі ↓ ↑ і націсніце Return"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte kategorii nebo „Neznámá“ na panelu či zde pomocí ↓ ↑ a stiskněte Return"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Kategorie oder „Unbekannt“ — im Bedienfeld oder hier mit ↓ ↑ — und drücken Sie Return"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a category or “Unknown” — in the panel, or with ↓ ↑ here — and press Return"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una categoría o «Desconocida» — en el panel, o con ↓ ↑ aquí — y pulse Intro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une catégorie ou « Inconnue » — dans le panneau, ou avec ↓ ↑ ici — puis appuyez sur Retour"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք կատեգորիա կամ «Անհայտ»՝ վահանակում կամ այստեղ՝ ↓ ↑ ստեղներով, և սեղմեք Return"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una categoria o “Sconosciuta” nel pannello o con ↓ ↑ qui, poi premi Invio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルまたはここで↓ ↑を使ってカテゴリか「不明」を選択し、Returnキーを押してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ კატეგორია ან “უცნობი” — პანელში ან აქ ↓ ↑ ღილაკებით — და დააჭირეთ Return-ს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санатты немесе «Белгісіз» таңдаңыз — панельде, не мұнда ↓ ↑ арқылы — және Return басыңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널이나 여기에서 ↓ ↑로 카테고리 또는 “알 수 없음”을 선택하고 Return을 누르십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Панелден же бул жерде ↓ ↑ менен категорияны же «Белгисизди» тандап, Return басыңыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een categorie of ‘Onbekend’ in het paneel of hier met ↓ ↑ en druk op Return"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kategorię lub „Nieznana” w panelu albo za pomocą ↓ ↑ i naciśnij Return"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma categoria ou “Desconhecida” no painel ou com ↓ ↑ aqui e pressione Return"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma categoria ou “Desconhecida” — no painel ou com ↓ ↑ aqui — e prima Return"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите категорию или «Не помню» — в панели или стрелками ↓ ↑ здесь — и нажмите Return"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар панел ё бо ↓ ↑ дар ин ҷо категория ё «Номаълум»-ро интихоб кунед ва Return-ро пахш кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelden veya burada ↓ ↑ ile bir kategori ya da “Bilinmiyor” seçin ve Return’e basın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть категорію або «Не знаю» — на панелі або тут за допомогою ↓ ↑ — і натисніть Return"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelda yoki shu yerda ↓ ↑ bilan turkumni yoki “Noma’lum”ni tanlang va Return tugmasini bosing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在面板中选择类别或“未知”，也可在此使用 ↓ ↑ 选择，然后按 Return"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在面板中或使用 ↓ ↑ 選擇類別或「未知」，然後按 Return"
          }
        }
      }
    },
