        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso avulso: algo comprado antes do registro ou dinheiro retirado de uma meta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат сам по себе: вещь куплена до учёта или деньги сняты с цели"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımsız bir iade: defter tutulmadan önce yapılan bir alışveriş veya bir hedeften çekilen para"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Окреме повернення: щось куплене до початку обліку або гроші, зняті з цілі"
          }
        }
      }
    },
    "reimbursement.differentPeople": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За адзначаныя долі вінны розныя людзі. Выберыце, чые грошы вярнуліся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angekreuzten Teile schulden verschiedene Personen. Wählen Sie, wessen Geld zurückkam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ticked parts are owed by different people. Choose whose money came back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes marcadas las deben personas distintas. Elija de quién volvió el dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parts cochées sont dues par des personnes différentes. Choisissez de qui vient l'argent rendu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quote selezionate sono dovute da persone diverse. Scegli chi ha restituito il denaro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгіленген бөліктерді әр түрлі адам қарыз. Ақша кімнен қайтқанын таңдаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczone części są należne od różnych osób. Wybierz, kto zwrócił pieniądze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes marcadas são devidas por pessoas diferentes. Escolha quem devolveu o dinheiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечены части разных людей. Выберите, чьи деньги вернулись."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen paylar farklı kişilere ait. Paranın kimden geldiğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За позначені частини винні різні люди. Виберіть, чиї гроші повернулися."
          }
        }
      }
    },
