    "entry.dictation.denied": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дазвольце OhMyMoney доступ да мікрафона і распазнавання маўлення ў сістэмных наладах прыватнасці. Вы можаце працягваць уводзіць тэкст."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie OhMyMoney in den Datenschutzeinstellungen des Systems den Zugriff auf Mikrofon und Spracherkennung. Sie können weiter tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone and speech recognition access for OhMyMoney in system privacy settings. You can keep typing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a OhMyMoney di accedere al microfono e al riconoscimento vocale nelle impostazioni di privacy del sistema. Puoi continuare a scrivere."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүйенің құпиялылық баптауларында OhMyMoney үшін микрофон мен сөйлеуді тану рұқсатын беріңіз. Теруді жалғастыра аласыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите OhMyMoney доступ к микрофону и распознаванию речи в настройках конфиденциальности системы. Можно продолжать вводить текст вручную."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте OhMyMoney доступ до мікрофона та розпізнавання мовлення в системних налаштуваннях приватності. Можна продовжувати вводити текст."
          }
        }
      }
    },
    "entry.dictation.listening": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухаю… Націсніце «Спыніць» або зрабіце паўзу, каб скончыць."
