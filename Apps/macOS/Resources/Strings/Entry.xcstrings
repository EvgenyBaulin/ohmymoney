    "entry.gap.category": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце катэгорыю або «Невядома» на панэлі ці тут клавішамі ↓ ↑ і націсніце Return"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Kategorie oder „Unbekannt“ — im Bedienfeld oder hier mit ↓ ↑ — und drücken Sie Return"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a category or “Unknown” — in the panel, or with ↓ ↑ here — and press Return"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una categoría o «Desconocida» — en el panel, o con ↓ ↑ aquí — y pulse Intro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une catégorie ou « Inconnue » — dans le panneau, ou avec ↓ ↑ ici — puis appuyez sur Retour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una categoria o “Sconosciuta” nel pannello o con ↓ ↑ qui, poi premi Invio"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санатты немесе «Белгісіз» таңдаңыз — панельде, не мұнда ↓ ↑ арқылы — және Return басыңыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kategorię lub „Nieznana” w panelu albo za pomocą ↓ ↑ i naciśnij Return"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma categoria ou “Desconhecida” no painel ou com ↓ ↑ aqui e pressione Return"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите категорию или «Не помню» — в панели или стрелками ↓ ↑ здесь — и нажмите Return"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelden veya burada ↓ ↑ ile bir kategori ya da “Bilinmiyor” seçin ve Return’e basın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть категорію або «Не знаю» — на панелі або тут за допомогою ↓ ↑ — і натисніть Return"
          }
        }
      }
    },
