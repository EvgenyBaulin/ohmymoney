    "entry.accountCharge.check": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума спісання не пералічана — праверце яе"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Belastet auf Konto“ wurde nicht neu berechnet — prüfen Sie es"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charged to account was not recalculated — check it"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’addebito sul conto non è stato ricalcolato: verifica l’importo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттан шегерілгені қайта есептелмеді — тексеріңіз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списано со счёта не пересчитано — проверьте"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списання з рахунку не перераховано — перевірте"
          }
        }
      }
    },
