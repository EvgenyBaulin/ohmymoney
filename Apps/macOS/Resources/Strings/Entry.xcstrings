    "refund.withoutPurchaseHelp": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Müstəqil geri ödəniş: uçotdan əvvəlki alış və ya məqsəddən çıxarılan pul"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асобнае вяртанне: за пакупку да пачатку ўліку або грошы, знятыя з мэты"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samostatné vrácení peněz: nákup před založením evidence nebo peníze vybrané z cíle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erstattung für sich: etwas, das vor den Büchern gekauft wurde, oder Geld, das aus einem Ziel genommen wurde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund of its own: something bought before the ledger, or money taken out of a goal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución propia: algo comprado antes del libro de cuentas, o dinero retirado de un objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement à part : quelque chose acheté avant le journal, ou de l'argent retiré d'un objectif"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանձին վերադարձ՝ մատյանից առաջ կատարված գնում կամ նպատակից հանված գումար"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rimborso a sé: un acquisto precedente al registro o denaro prelevato da un obiettivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入に紐づかない返金。家計簿をつける前の購入や、目標から引き出したお金など"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დამოუკიდებელი დაბრუნება: აღრიცხვის დაწყებამდე ნაყიდი ნივთი ან მიზნიდან გამოტანილი თანხა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз қайтаруы: кітапқа дейін сатып алынғаны немесе мақсаттан алынған ақша"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도의 환불: 가계부 작성 전에 구매한 항목이나 목표에서 인출한 금액"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзүнчө кайтаруу: эсепке алынганга чейин сатып алынган нерсе же максаттан алынган акча"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een losse terugbetaling: iets gekocht vóór de administratie, of geld opgenomen uit een spaardoel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodzielny zwrot: zakup sprzed rozpoczęcia ewidencji lub pieniądze pobrane z celu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso avulso: algo comprado antes do registro ou dinheiro retirado de uma meta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso independente: algo comprado antes do registo ou dinheiro retirado de um objetivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат сам по себе: вещь куплена до учёта или деньги сняты с цели"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баргардонидани мустақил: хариде пеш аз оғози ҳисобдорӣ ё пуле, ки аз ҳадаф гирифта шудааст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımsız bir iade: defter tutulmadan önce yapılan bir alışveriş veya bir hedeften çekilen para"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Окреме повернення: щось куплене до початку обліку або гроші, зняті з цілі"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Alohida qaytim: hisob yuritishdan oldingi xarid yoki maqsaddan olingan pul"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独记录退款：记账前的购买退款，或从目标中取出的钱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獨立記錄退款：例如記帳前的購買退款，或從目標取出的款項"
          }
        }
      }
    },
    "reimbursement.differentPeople": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşarələnmiş paylar müxtəlif şəxslərə aiddir. Kimin pulunun qaytarıldığını seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За адзначаныя долі вінны розныя людзі. Выберыце, чые грошы вярнуліся."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označené části dluží různí lidé. Vyberte, kdo peníze vrátil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angekreuzten Teile schulden verschiedene Personen. Wählen Sie, wessen Geld zurückkam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ticked parts are owed by different people. Choose whose money came back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes marcadas las deben personas distintas. Elija de quién volvió el dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parts cochées sont dues par des personnes différentes. Choisissez de qui vient l'argent rendu."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշված մասերի համար պարտք են տարբեր մարդիկ։ Ընտրեք, թե ում գումարն է վերադարձվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quote selezionate sono dovute da persone diverse. Scegli chi ha restituito il denaro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目の支払者が異なります。誰から返金されたか選択してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონიშნული ნაწილები სხვადასხვა ადამიანს ეკუთვნის. აირჩიეთ, ვინ დააბრუნა თანხა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгіленген бөліктерді әр түрлі адам қарыз. Ақша кімнен қайтқанын таңдаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목의 변제자가 서로 다릅니다. 누구에게서 돈을 돌려받았는지 선택하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгиленген бөлүктөрдү ар башка адамдар төлөшү керек. Кимдин акчасы кайтарылганын тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aangevinkte delen zijn van verschillende personen tegoed. Kies van wie het geld is teruggekomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczone części są należne od różnych osób. Wybierz, kto zwrócił pieniądze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes marcadas são devidas por pessoas diferentes. Escolha quem devolveu o dinheiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes assinaladas são devidas por pessoas diferentes. Escolha de quem recebeu o dinheiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечены части разных людей. Выберите, чьи деньги вернулись."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қисмҳои интихобшуда ба шахсони гуногун тааллуқ доранд. Интихоб кунед, ки пули кӣ баргашт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen paylar farklı kişilere ait. Paranın kimden geldiğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За позначені частини винні різні люди. Виберіть, чиї гроші повернулися."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgilangan qismlar uchun turli odamlar qarzdor. Kimning puli qaytganini tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选的部分由不同的人欠款。请选择谁还了钱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾選的款項由不同的人償還。請選擇誰已還款。"
          }
        }
      }
    },
