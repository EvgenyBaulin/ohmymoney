    "reimbursement.moneyRateProvisional": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank has not published the rate of this day yet. Type the rate of the money, or record it later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco todavía no ha publicado el tipo de este día. Escriba el tipo del dinero, o regístrelo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque n'a pas encore publié le taux de ce jour. Saisissez le taux de l'argent, ou notez-le plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ещё не опубликовал курс этого дня. Введите курс возврата или запишите позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ще не опублікував курс за цей день. Введіть курс отриманих грошей або запишіть пізніше."
          }
        }
      }
    },
    "reimbursement.noSurcharges": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More came back than the parts cost, and there is no Surcharges category for the difference. Nothing was recorded: enter no more than the parts cost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volvió más dinero del que costaron las partes, y no hay categoría de Recargos para la diferencia. No se registró nada: introduzca no más de lo que costaron las partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est revenu plus que ce que coûtaient les parts, et il n'y a pas de catégorie « Surcharges » pour l'écart. Rien n'a été noté : ne saisissez pas plus que le coût des parts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернули больше, чем стоили части, а категории «Доплаты» для разницы нет. Ничего не записано: введите сумму не больше стоимости частей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернулося більше, ніж коштували частини, а категорії «Доплати» для різниці немає. Нічого не записано: введіть не більше вартості частин."
          }
        }
      }
    },
    "reimbursement.partGone": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chosen part is no longer waiting for its money — its purchase was deleted, or the part was written off or closed. The list has been refreshed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte elegida ya no espera su dinero — su compra se eliminó, o la parte se dio de baja o se cerró. La lista se ha actualizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une part choisie n'attend plus son argent — son achat a été supprimé, ou la part a été passée en pertes ou clôturée. La liste a été actualisée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная часть больше не ожидает возврата — покупку удалили, часть списали или уже закрыли. Список обновлён."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана частина більше не очікує грошей: покупку видалено, частину списано або закрито. Список оновлено."
          }
        }
      }
    },
    "reimbursement.provisionalRate": {
