    "reimbursement.moneyRateProvisional": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк яшчэ не апублікаваў курс на гэты дзень. Увядзіце курс валюты або запішыце пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat den Kurs dieses Tages noch nicht veröffentlicht. Tragen Sie den Kurs des Geldes ein oder erfassen Sie es später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank has not published the rate of this day yet. Type the rate of the money, or record it later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco todavía no ha publicado el tipo de este día. Escriba el tipo del dinero, o regístrelo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque n'a pas encore publié le taux de ce jour. Saisissez le taux de l'argent, ou notez-le plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca non ha ancora pubblicato il tasso di questo giorno. Inserisci il tasso del rimborso o registralo più tardi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк бұл күннің бағамын әлі жарияламаған. Ақшаның бағамын теріңіз, не ақшаны кейін жазыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank nie opublikował jeszcze kursu z tego dnia. Wpisz kurs zwróconych pieniędzy lub zapisz zwrot później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco ainda não publicou a taxa deste dia. Digite a taxa do dinheiro recebido ou registre depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ещё не опубликовал курс этого дня. Введите курс возврата или запишите позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka bu günün kurunu henüz yayımlamadı. Paranın kurunu girin veya daha sonra kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ще не опублікував курс за цей день. Введіть курс отриманих грошей або запишіть пізніше."
          }
        }
      }
    },
    "reimbursement.noSurcharges": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вярнулася больш, чым каштавалі долі, а катэгорыі для даплаты няма. Нічога не запісана: увядзіце суму не большую за кошт доляў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kam mehr zurück, als die Teile gekostet haben, und es gibt keine Kategorie „Aufschläge“ für die Differenz. Nichts wurde erfasst: Tragen Sie nicht mehr ein, als die Teile gekostet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More came back than the parts cost, and there is no Surcharges category for the difference. Nothing was recorded: enter no more than the parts cost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volvió más dinero del que costaron las partes, y no hay categoría de Recargos para la diferencia. No se registró nada: introduzca no más de lo que costaron las partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est revenu plus que ce que coûtaient les parts, et il n'y a pas de catégorie « Surcharges » pour l'écart. Rien n'a été noté : ne saisissez pas plus que le coût des parts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rimborso supera il costo delle quote e non esiste una categoria Supplementi per la differenza. Non è stato registrato nulla: inserisci al massimo il costo delle quote."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөліктердің құнынан артық қайтты, ал айырма үшін «Үстемақылар» санаты жоқ. Ештеңе жазылмады: бөліктердің құнынан артық енгізбеңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrócono więcej, niż wynosi koszt części, a brak kategorii Dopłaty dla różnicy. Nic nie zapisano: wpisz kwotę nie większą niż koszt części."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor devolvido é maior que o custo das partes e não há uma categoria de Acréscimos para a diferença. Nada foi registrado: informe no máximo o custo das partes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернули больше, чем стоили части, а категории «Доплаты» для разницы нет. Ничего не записано: введите сумму не больше стоимости частей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelen para payların tutarını aşıyor ve fark için bir Ek Ücretler kategorisi yok. Hiçbir şey kaydedilmedi: payların tutarından fazlasını girmeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернулося більше, ніж коштували частини, а категорії «Доплати» для різниці немає. Нічого не записано: введіть не більше вартості частин."
          }
        }
      }
    },
    "reimbursement.partGone": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбраная доля больш не чакае вяртання грошай: пакупку выдалілі або долю спісалі ці закрылі. Спіс абноўлены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gewählter Teil wartet nicht mehr auf sein Geld — sein Kauf wurde gelöscht, oder der Teil wurde abgeschrieben oder beendet. Die Liste wurde aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chosen part is no longer waiting for its money — its purchase was deleted, or the part was written off or closed. The list has been refreshed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte elegida ya no espera su dinero — su compra se eliminó, o la parte se dio de baja o se cerró. La lista se ha actualizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une part choisie n'attend plus son argent — son achat a été supprimé, ou la part a été passée en pertes ou clôturée. La liste a été actualisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una quota selezionata non è più in attesa di rimborso: l'acquisto è stato eliminato oppure la quota è stata stornata o chiusa. L'elenco è stato aggiornato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған бөлік енді ақшасын күтпейді — оның сатып алуы жойылған, не бөлік есептен шығарылған немесе жабылған. Тізім жаңартылды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana część nie oczekuje już na zwrot — zakup został usunięty albo część została umorzona lub zamknięta. Lista została odświeżona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parte escolhida não aguarda mais devolução: a compra foi apagada ou a parte foi baixada ou encerrada. A lista foi atualizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная часть больше не ожидает возврата — покупку удалили, часть списали или уже закрыли. Список обновлён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen bir pay artık geri ödeme beklemiyor. Alışverişi silinmiş veya pay silinmiş ya da kapatılmış. Liste yenilendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана частина більше не очікує грошей: покупку видалено, частину списано або закрито. Список оновлено."
          }
        }
      }
    },
    "reimbursement.provisionalRate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс гэтай пакупкі яшчэ ўдакладняецца. Націсніце ⌘R і паспрабуйце яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurs dieses Kaufs wird noch verfeinert — drücken Sie ⌘R und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate of this purchase is still being refined — press ⌘R and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de esta compra todavía se está ajustando — pulse ⌘R e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de cet achat est encore en cours de précision — appuyez sur ⌘R et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso di questo acquisto è ancora in fase di definizione. Premi ⌘R e riprova."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сатып алудың бағамы әлі нақтылануда — ⌘R басып, қайталап көріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs tego zakupu jest nadal aktualizowany — naciśnij ⌘R i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa desta compra ainda está sendo atualizada. Pressione ⌘R e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс этой покупки ещё уточняется — нажмите ⌘R и попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışverişin kuru hâlâ kesinleşiyor. ⌘R tuşlarına basıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс цієї покупки ще уточнюється — натисніть ⌘R і спробуйте ще раз."
          }
        }
      }
    },
