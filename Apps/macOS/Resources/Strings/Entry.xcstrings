        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қарыздан артық %@ «Үстемақылардағы» табысқа кетеді"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ponad należną kwotę zostanie zapisane jako przychód w kategorii Dopłaty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ acima do valor devido será lançado como receita em Acréscimos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверх долга %@ — доход в «Доплатах»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borçtan fazla olan %@, Ek Ödemeler altında gelir olarak kaydedilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ понад борг стане доходом у «Доплатах»"
          }
        }
      }
    },
    "moneyBack.surplusToDebt": {
