    "entry.gap.mark.subcategory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце падкатэгорыю або пакіньце «—»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Unterkategorie oder lassen Sie „—“ stehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a subcategory or leave “—”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una subcategoría o deje «—»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une sous-catégorie ou laissez « — »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una sottocategoria o lascia “—”"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ішкі санатты таңдаңыз немесе «—» қалдырыңыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz podkategorię lub zostaw „—”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma subcategoria ou mantenha “—”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите подкатегорию или оставьте «—»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt kategori seçin veya “—” bırakın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть підкатегорію або залиште «—»"
          }
        }
      }
    },
    "entry.gap.subcategory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У радку не пазначана падкатэгорыя — выберыце яе на панэлі ці тут клавішамі ↓ ↑ або пакіньце «—» і націсніце Return"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeile nennt die Unterkategorie nicht — wählen Sie sie im Bedienfeld oder hier mit ↓ ↑ oder lassen Sie „—“ stehen, und drücken Sie Return"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line does not say the subcategory — choose it in the panel, or with ↓ ↑ here, or leave “—”, and press Return"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea no indica la subcategoría — elíjala en el panel, o con ↓ ↑ aquí, o deje «—», y pulse Intro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne ne précise pas la sous-catégorie — choisissez-la dans le panneau, ou avec ↓ ↑ ici, ou laissez « — », puis appuyez sur Retour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga non indica la sottocategoria: sceglila nel pannello o con ↓ ↑ qui, oppure lascia “—”, poi premi Invio"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жолда ішкі санат айтылмаған — оны панельде, не мұнда ↓ ↑ арқылы таңдаңыз, не «—» қалдырып, Return басыңыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiersz nie określa podkategorii. Wybierz ją w panelu albo za pomocą ↓ ↑ lub zostaw „—” i naciśnij Return"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha não informa a subcategoria — escolha uma no painel ou com ↓ ↑ aqui, ou mantenha “—” e pressione Return"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкатегорию по строке не определить — выберите её в панели или стрелками ↓ ↑ здесь, или оставьте «—», и нажмите Return"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırda alt kategori belirtilmemiş — panelden veya burada ↓ ↑ ile seçin ya da “—” bırakın ve Return’e basın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У рядку не вказано підкатегорію — виберіть її на панелі або тут за допомогою ↓ ↑ чи залиште «—» і натисніть Return"
          }
        }
      }
    },
