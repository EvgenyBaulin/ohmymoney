    "entry.overLimit.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank buna görə komissiya tuta bilər. Yenə də qeyd edilsin?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк можа спагнаць камісію. Усё адно запісаць?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka si může účtovat poplatek. Přesto zaznamenat?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank kann dafür eine Gebühr berechnen. Trotzdem erfassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank may charge a fee for it. Record it anyway?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco puede cobrar una comisión por ello. ¿Registrarlo igual?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque peut facturer des frais pour cela. Noter quand même ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկը կարող է միջնորդավճար գանձել։ Գրանցե՞լ այնուամենայնիվ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca potrebbe addebitare una commissione. Vuoi registrare comunque?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行から手数料が請求される場合があります。そのまま記録しますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკმა შესაძლოა საკომისიო დააკისროს. მაინც ჩაიწეროს?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк үшін комиссия алуы мүмкін. Бәрібір жазайық па?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행에서 수수료를 부과할 수 있습니다. 그래도 기록하시겠습니까?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк комиссия алышы мүмкүн. Баары бир жазылсынбы?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bank kan hiervoor kosten in rekening brengen. Toch invoeren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank może naliczyć opłatę. Zapisać mimo to?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco pode cobrar uma tarifa. Registrar mesmo assim?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco poderá cobrar uma comissão. Pretende registar na mesma?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможна комиссия банка. Записать всё равно?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк метавонад барои ин ҳаққи хизмат ситонад. Ба ҳар ҳол сабт мекунед?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka bunun için ücret alabilir. Yine de kaydedilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк може стягнути комісію. Усе одно записати?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank buning uchun komissiya olishi mumkin. Baribir kiritilsinmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行可能会收取费用。仍要记录吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行可能會收取費用。仍要記錄嗎？"
          }
        }
      }
    },
