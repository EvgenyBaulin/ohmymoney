    "entry.repeat.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@ tarixində qeydə alınıb. Daha birini əlavə edilsin?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — запісана ў %@. Дадаць яшчэ адну?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — zapsáno v %@. Přidat další?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — erfasst um %@. Noch einen hinzufügen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — recorded at %@. Add another one?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — registrado a las %2$@. ¿Añadir otro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — noté à %@. En ajouter une autre ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@՝ գրանցվել է %@։ Ավելացնե՞լ ևս մեկը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — registrata alle %@. Aggiungerne un’altra?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@に記録済みです。もう一件追加しますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — ჩაიწერა %@. კიდევ დაამატებთ?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@ уақытта жазылды. Тағы бірін қосайық па?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@에 기록됨. 하나 더 추가할까요?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@ убагында жазылган. Дагы бирин кошосузбу?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — vastgelegd om %@. Nog een toevoegen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — zapisano o %@. Dodać kolejny wpis?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — lançado às %@. Adicionar outro?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — registado às %@. Adicionar outro?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — записана в %@. Добавить ещё одну?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — соати %@ сабт шуд. Боз якто илова шавад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@ saatinde kaydedildi. Bir tane daha eklensin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — записано о %@. Додати ще одну?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@ da yozilgan. Yana birini qo‘shasizmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 已于 %@ 记录。再添加一笔？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@——已於 %@ 記錄。要再加入一筆嗎？"
