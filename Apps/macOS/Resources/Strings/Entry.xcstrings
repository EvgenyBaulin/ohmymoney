    "entry.prepay.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank kreditin müddətini qısaldacaq, aylıq ödənişi azaldacaq, yoxsa pul növbəti ödənişlərə yönələcək?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк скароціць тэрмін крэдыту, паменшыць штомесячны плацёж ці грошы пойдуць на наступныя плацяжы?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkrátí banka dobu splácení, sníží měsíční splátku, nebo peníze použije na další splátky předem?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkürzt die Bank die Laufzeit des Kredits oder senkt sie die monatliche Rate — oder bezahlt das Geld die nächsten Raten im Voraus?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will the bank shorten the term of the loan or lower its monthly payment — or does the money pay the next payments ahead?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿El banco acorta el plazo del préstamo o baja su pago mensual — o el dinero cubre por adelantado los pagos siguientes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque va-t-elle réduire la durée du crédit ou sa mensualité — ou l'argent couvre-t-il les prochaines échéances par avance ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկը կկրճատի՞ վարկի ժամկետը, կնվազեցնի՞ ամսական վճարը, թե՞ գումարը կուղղվի հաջորդ վճարումներին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca ridurrà la durata del prestito o la rata mensile? Oppure il denaro coprirà le prossime rate?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行はローンの期間を短縮しますか、毎月の返済額を減らしますか？それとも今後の返済を前倒ししますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკი სესხის ვადას შეამცირებს, ყოველთვიურ გადასახადს შეამცირებს თუ თანხა მომდევნო გადახდებს დაფარავს?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк несиенің мерзімін қысқарта ма, әлде айлық төлемін азайта ма — әлде ақша алдағы төлемдерді жабады ма?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행에서 대출 기간을 단축하나요, 월 납입액을 줄이나요? 아니면 다음 납입금을 미리 내나요?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк насыянын мөөнөтүн кыскартабы же айлык төлөмүн азайтабы? Же бул акча кийинки төлөмдөргө кетеби?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkort de bank de looptijd van de lening of verlaagt ze de maandlast? Of worden de volgende betalingen vooruitbetaald?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy bank skróci okres kredytu, obniży miesięczną ratę czy zaliczy wpłatę na poczet przyszłych rat?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco vai reduzir o prazo do empréstimo ou o valor da parcela mensal? Ou o dinheiro antecipa as próximas parcelas?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco vai reduzir o prazo do empréstimo ou a prestação mensal? Ou o dinheiro antecipa as próximas prestações?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк уменьшит срок кредита или ежемесячный платёж — или деньги закроют следующие платежи вперёд?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк муҳлати қарзро кӯтоҳ мекунад ё пардохти моҳонаро кам мекунад — ё маблағ барои пардохтҳои оянда меравад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka kredi vadesini mi kısaltacak, aylık taksiti mi düşürecek, yoksa para sonraki taksitler için peşin ödeme mi olacak?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк скоротить строк кредиту чи зменшить щомісячний платіж — або гроші підуть на наступні платежі наперед?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank kredit muddatini qisqartiradimi, oylik to‘lovni kamaytiradimi yoki pul keyingi to‘lovlarga o‘tkaziladimi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行会缩短贷款期限、降低月供，还是将这笔钱用于预付后续款项？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行會縮短貸款期限、降低每月還款額，還是將款項用於預繳後續還款？"
          }
        }
      }
    },
