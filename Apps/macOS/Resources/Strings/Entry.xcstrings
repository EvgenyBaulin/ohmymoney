    "entry.ahead.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запісаць зараз ці запланаваць? План будзе чакаць свайго дня ў планаванні."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So erfassen oder planen? Eine Planung wartet unter „Planung“ auf ihren Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record it as it is, or plan it? A plan waits in Planning for its day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Registrarla tal cual, o planificarla? Un plan espera en Planificación hasta su día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter tel quel, ou planifier ? Une planification attend dans « Planification » le jour venu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi registrarla così o pianificarla? Una voce pianificata attende il suo giorno in Pianificazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осылай жазамыз ба, әлде жоспарлаймыз ба? Жоспар күні келгенше «Жоспарлауда» тұрады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisać teraz czy zaplanować? Plan będzie czekać w Planowaniu do wybranego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar como está ou planejar? Um item planejado aguarda sua data em Planejamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать как есть или запланировать? План ждёт своего дня в «Планировании»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olduğu gibi kaydedilsin mi, planlansın mı? Planlanan işlem gününe kadar Planlama'da bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записати як є чи запланувати? План очікуватиме свого дня в «Плануванні»."
          }
        }
      }
    },
