    "moneyBack.surplus": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borc məbləğindən artıq %@ Əlavə ödənişlər bölməsində gəlirə yazılır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ звыш доўгу пойдзе ў даход у раздзеле «Даплаты»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nad dlužnou částku se zapíše jako příjem do Příplatků"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ über dem Geschuldeten gehen als Einnahme in „Aufschläge“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ over what is owed goes to income in Surcharges"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por encima de lo que se debe va a ingresos en Recargos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ au-delà de ce qui est dû va en revenu dans « Surcharges »"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պարտքից ավել %@-ը կգրանցվի որպես եկամուտ «Հավելավճարներ»-ում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oltre l’importo dovuto viene registrato come entrata in Surcharges"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未精算額を超える%@は「割増金」の収入になります"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალზე მეტი %@ შემოსავალში, დანამატებში ჩაიწერება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қарыздан артық %@ «Үстемақылардағы» табысқа кетеді"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받을 돈을 초과한 %@은(는) 추가 금액의 수입으로 기록됩니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карыздан ашкан %@ «Кошумча төлөмдөр» бөлүмүндөгү кирешеге өтөт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boven het verschuldigde bedrag gaat naar inkomen onder Toeslagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ponad należną kwotę zostanie zapisane jako przychód w kategorii Dopłaty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ acima do valor devido será lançado como receita em Acréscimos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ acima do valor em dívida é registado como receita em Suplementos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверх долга %@ — доход в «Доплатах»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зиёда аз қарз ба даромади «Иловапардохтҳо» мегузарад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borçtan fazla olan %@, Ek Ödemeler altında gelir olarak kaydedilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ понад борг стане доходом у «Доплатах»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarzdan ortiq %@ «Qo‘shimcha to‘lovlar»da daromadga o‘tadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
