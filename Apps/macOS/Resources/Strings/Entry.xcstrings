    "owed.writeOffFailed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося спісаць долю. Яна ўсё яшчэ чакае вяртання грошай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anteil konnte nicht abgeschrieben werden. Er wartet weiter auf sein Geld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The part could not be written off. It is still waiting for its money."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte no se pudo dar de baja. Sigue pendiente de su dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part n'a pas pu être passée en pertes. Elle attend toujours son argent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile stornare la quota. È ancora in attesa di rimborso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлікті есептен шығару мүмкін болмады. Ол әлі ақшасын күтуде."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się umorzyć tej części. Nadal oczekuje na zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível dar baixa na parte. Ela ainda aguarda pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось списать часть — она по-прежнему ждёт возврата."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutar alacaktan düşülemedi. Ödeme beklemeye devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося списати частину. Вона все ще очікує повернення грошей."
          }
        }
      }
    },
