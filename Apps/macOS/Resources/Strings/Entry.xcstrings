    "entry.error.closedPartChanged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За частку ўжо вярнулі грошы: яе суму, “аплачана за кагосьці”, валюту і тып нельга змяніць. Спачатку выдаліце кампенсацыю"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Teil wurde bereits Geld zurückgegeben: Sein Betrag, „für jemand anderen bezahlt“, die Währung und die Art lassen sich nicht ändern. Löschen Sie zuerst die Rückzahlung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money was already given back for a part: its amount, “paid for someone”, the currency and the type can’t change. Delete the reimbursement first"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte è già stata rimborsata: non è possibile modificarne l’importo, l’opzione “pagato per qualcuno”, la valuta o il tipo. Elimina prima il rimborso"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлікке ақша қайтарылған: оның сомасы, «біреу үшін төленді», валюта және түрі өзгере алмайды. Алдымен қайтаруды жойыңыз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За часть уже вернули деньги — её сумму, «за другого», валюту и тип не поменять. Сначала удалите возврат"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За частину вже повернули гроші: не можна змінити її суму, «за іншого», валюту та вид. Спочатку видаліть повернення грошей"
          }
        }
      }
    },
    "entry.error.closedPartRemoved": {
