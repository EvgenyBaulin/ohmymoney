    "entry.ahead.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record it as it is, or plan it? A plan waits in Planning for its day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Registrarla tal cual, o planificarla? Un plan espera en Planificación hasta su día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter tel quel, ou planifier ? Une planification attend dans « Planification » le jour venu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать как есть или запланировать? План ждёт своего дня в «Планировании»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записати як є чи запланувати? План очікуватиме свого дня в «Плануванні»."
          }
        }
      }
    },
