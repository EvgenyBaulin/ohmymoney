    "entry.ahead.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запісаць зараз ці запланаваць? План будзе чакаць свайго дня ў планаванні."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So erfassen oder planen? Eine Planung wartet unter „Planung“ auf ihren Tag."
