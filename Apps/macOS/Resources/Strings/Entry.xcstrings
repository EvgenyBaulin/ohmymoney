        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération a été supprimée, donc les modifications n'ont pas été enregistrées"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարքը ջնջվել է, ուստի փոփոխությունները չեն պահպանվել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'operazione è stata eliminata, quindi le modifiche non sono state salvate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引が削除されたため、変更は保存されませんでした"
