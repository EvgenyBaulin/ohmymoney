    "entry.beforeCount.dontAsk": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш не пытацца для гэтай зверкі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Abgleich nicht mehr fragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask again for this reconciliation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No volver a preguntar para esta conciliación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne plus demander pour ce rapprochement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non chiedere più per questa riconciliazione"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы салыстыру үшін енді сұрама"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie pytaj ponownie dla tego uzgodnienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não perguntar novamente nesta reconciliação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не спрашивать для этой сверки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mutabakat için tekrar sorma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не запитувати для цієї звірки"
          }
        }
      }
    },
    "entry.beforeCount.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэты дзень рахунак быў звераны. Калі аперацыя адбылася да зверкі, яе сума ўжо ўлічана ў звераным балансе: зменіцца розніца зверкі, а не баланс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wurde an diesem Tag abgeglichen. Wenn der Vorgang davor lag, steckt sein Geld bereits im abgeglichenen Saldo: Es ändert sich die Differenz des Abgleichs, nicht der Saldo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account was reconciled that day. If the operation happened before that, its money is already in the reconciled balance: the reconciliation's difference changes, not the balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta se concilió ese día. Si la operación fue antes, su dinero ya está en el saldo conciliado: cambia la diferencia de la conciliación, no el saldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte a été rapproché ce jour-là. Si l'opération a eu lieu avant, son argent est déjà dans le solde rapproché : c'est l'écart du rapprochement qui change, pas le solde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo conto è stato riconciliato quel giorno. Se l’operazione è avvenuta prima, l’importo è già incluso nel saldo riconciliato: cambia la differenza della riconciliazione, non il saldo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шот сол күні салыстырылған. Егер операция одан бұрын болса, оның ақшасы салыстырылған теңгерімде бар: өзгеретіні — салыстырудың айырмасы, теңгерім емес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego dnia uzgodniono saldo konta. Jeśli operacja miała miejsce wcześniej, jej kwota jest już uwzględniona w uzgodnionym saldzie. Zmieni się różnica uzgodnienia, a nie saldo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta foi reconciliada nesse dia. Se a operação ocorreu antes, o valor já está no saldo reconciliado: a diferença da reconciliação muda, mas o saldo não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день счёт сверяли. Если операция прошла до сверки, её деньги уже в сверенном остатке: изменится разница сверки, а не остаток."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap o gün mutabık kılındı. İşlem bundan önce yapıldıysa tutarı mutabık bakiyeye zaten dahildir: bakiye değil, mutabakat farkı değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього дня рахунок звіряли. Якщо операція була раніше, її гроші вже входять у звірений залишок: зміниться різниця звірки, а не залишок."
          }
        }
      }
    },
