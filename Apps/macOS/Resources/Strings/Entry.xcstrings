    "entry.error.reimbursementEdit": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğ geri ödənişə əsasən hesablanıb: məbləği, növü və valyutanı dəyişmək üçün geri ödənişi silib yenidən qeyd edin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана паводле кампенсацыі: каб змяніць суму, тып або валюту, выдаліце кампенсацыю і запішыце яе зноў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částka vychází z úhrady dluhu. Její částku, typ a měnu změníte jen smazáním a opětovným zadáním úhrady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch eine Rückzahlung festgelegt: Ihr Betrag, Ihre Art und Währung ändern sich nur, wenn Sie die Rückzahlung löschen und neu erfassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worked out by a reimbursement: its amount, type and currency change only by deleting the reimbursement and recording it again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado por una devolución: su importe, tipo y divisa cambian solo si se elimina la devolución y se registra de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé par un remboursement : son montant, son type et sa devise ne changent qu'en supprimant le remboursement puis en le notant à nouveau"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվարկվել է փոխհատուցմամբ․ գումարը, տեսակը և արժույթը փոխելու համար ջնջեք փոխհատուցումը և կրկին գրանցեք"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato da un rimborso: per modificarne importo, tipo o valuta, elimina il rimborso e registralo di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "精算から計算されています。金額、種類、通貨を変更するには、精算を削除して再登録してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოითვლება ანაზღაურებით: თანხის, ტიპისა და ვალუტის შესაცვლელად წაშალეთ ანაზღაურება და ხელახლა შეიყვანეთ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша қайтарылуымен есептелген: оның сомасы, түрі және валютасы тек қайтаруды жойып, қайта жазғанда өзгереді"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상환으로 계산된 금액입니다. 금액, 유형 또는 통화를 변경하려면 상환을 삭제하고 다시 기록하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ордун толтуруу аркылуу эсептелген: суммасын, түрүн жана валютасын өзгөртүү үчүн ордун толтурууну өчүрүп, кайра жазыңыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrekend met een terugbetaling. Verwijder de terugbetaling en voer deze opnieuw in om het bedrag, type of de valuta te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozliczono przez zwrot kosztów. Aby zmienić kwotę, typ lub walutę, usuń zwrot i dodaj go ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado por uma restituição: para alterar o valor, tipo ou moeda, apague a restituição e registre-a novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado por um reembolso: para alterar o valor, tipo ou moeda, apague o reembolso e registe-o novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассчитано возвратом денег: сумму, тип и валюту меняют, только удалив возврат и записав его заново"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо ҷуброн ҳисоб шудааст: барои тағйир додани маблағ, намуд ё асъори он ҷубронро ҳазф карда, аз нав сабт кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem bir geri ödeme ile oluşturuldu: tutarı, türü ve para birimi yalnızca geri ödeme silinip yeniden kaydedilerek değiştirilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислено під час повернення грошей: суму, вид і валюту можна змінити, лише видаливши повернення й записавши його знову"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Summa qoplash orqali hisoblangan: summa, tur va valyutani o‘zgartirish uchun qoplashni o‘chirib, qayta kiriting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此交易由报销生成。要更改金额、类型或货币，请删除报销并重新记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此交易由還款產生：若要更改金額、類型或貨幣，請刪除還款並重新記錄"
          }
        }
      }
    },
