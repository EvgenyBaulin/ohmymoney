    "entry.cashback.noRules": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” üçün keşbek qaydası yoxdur — məbləğ və ya faiz (“5%”) daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для “%@” няма правілаў кэшбэку — увядзіце суму або працэнт (“5%”)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nemá pravidla pro cashback — zadejte částku nebo procento („5%“)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat keine Cashback-Regeln — tragen Sie einen Betrag oder einen Prozentsatz („5 %“) ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” has no cashback rules — type an amount or a percent (“5%”)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no tiene reglas de cashback — escriba un importe o un porcentaje («5%»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n'a pas de règles de cashback — saisissez un montant ou un pourcentage (« 5% »)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»-ը քեշբեքի կանոններ չունի․ մուտքագրեք գումար կամ տոկոս («5%»)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non ha regole di cashback: inserisci un importo o una percentuale (“5%”)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”にキャッシュバックルールはありません。金額または割合（“5%”）を入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”-ს ქეშბექის წესები არ აქვს — შეიყვანეთ თანხა ან პროცენტი (“5%”)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” кешбэк ережелері жоқ — соманы немесе пайызды теріңіз («5%»)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”에 캐시백 규칙이 없습니다. 금액 또는 백분율(“5%”)을 입력하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” үчүн кэшбэк эрежелери жок — сумманы же пайызды киргизиңиз (“5%”)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ heeft geen cashbackregels. Voer een bedrag of percentage in (‘5%’)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie ma zasad cashbacku — wpisz kwotę lub wartość procentową („5%”)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não tem regras de cashback — digite um valor ou uma porcentagem (“5%”)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não tem regras de cashback — introduza um montante ou uma percentagem (“5%”)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%@» нет правил кэшбэка — впишите сумму или процент («5%»)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои “%@” қоидаи кэшбэк нест — маблағ ё фоизро ворид кунед (“5%”)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” için nakit iadesi kuralı yok — bir tutar veya yüzde (“5%”) girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для «%@» немає правил кешбеку — введіть суму або відсоток («5%»)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” uchun keshbek qoidalari yo‘q — summa yoki foiz kiriting (“5%”)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”没有返现规则，请输入金额或百分比（“5%”）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」沒有現金回饋規則，請輸入金額或百分比（「5%」）。"
          }
        }
      }
