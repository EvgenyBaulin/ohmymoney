    "entry.add.nameTaken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Такая назва ўжо ёсць: у радку запісу іх нельга будзе адрозніць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name ist bereits vergeben: Die Eingabezeile könnte beide nicht unterscheiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name is already taken: the entry line would not tell the two apart."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo nome è già in uso: non sarebbe possibile distinguere le voci."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл атау бос емес: енгізу жолы екеуін ажырата алмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое название уже есть: строка ввода не отличила бы одно от другого."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю назву вже зайнято: рядок вводу не зможе розрізнити записи."
          }
        }
      }
    },
