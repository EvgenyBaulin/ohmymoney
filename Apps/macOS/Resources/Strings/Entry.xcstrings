    "entry.minBalance.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк просіць захоўваць гэтую суму на рахунку. Вы ўсё адно можаце запісаць аперацыю."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank verlangt, dass auf dem Konto mindestens so viel bleibt. Verboten ist nichts: Sie können es trotzdem erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank asks to keep this much on the account. Nothing is forbidden: you can record it all the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco pide mantener esta cantidad en la cuenta. Nada está prohibido: puede registrarlo igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque demande de garder ce montant sur le compte. Rien n'est interdit : vous pouvez tout de même noter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca richiede di mantenere questo importo sul conto. Puoi comunque registrare l'operazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк есеп-шотта осыншама ақша ұстауды сұрайды. Тыйым салынбайды: соған қарамастан жаза аласыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank wymaga utrzymania tej kwoty na koncie. Nadal możesz zapisać operację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco pede que este valor seja mantido na conta. Você ainda pode registrar a operação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк просит держать на счёте не меньше. Ничего не запрещено: можно записать всё равно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka, hesapta bu tutarın tutulmasını istiyor. İşlemi yine de kaydedebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк просить залишати цю суму на рахунку. Заборони немає: операцію все одно можна записати."
          }
        }
      }
    },
