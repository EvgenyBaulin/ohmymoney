    "entry.accountCharge.provisionalHelp": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günün məzənnəsi hələ dəqiqləşdirilir: məbləği çıxarışla tutuşdurun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс на гэты дзень яшчэ ўдакладняецца: праверце суму паводле выпіскі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz pro tento den se ještě upřesňuje. Zkontrolujte částku podle výpisu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurs dieses Tages wird noch verfeinert: Prüfen Sie den Betrag anhand der Abrechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate of this day is still being refined: check the figure against the statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de este día todavía se está ajustando: compruebe la cifra con el extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de ce jour est encore en cours de précision : vérifiez le montant sur le relevé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ օրվա փոխարժեքը դեռ ճշտվում է․ համեմատեք գումարը քաղվածքի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso di quel giorno è ancora in fase di aggiornamento: verifica l’importo sull’estratto conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日のレートはまだ確定していません。明細と照らし合わせて確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ დღის კურსი ჯერ ზუსტდება: შეადარეთ თანხა ამონაწერს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күннің бағамы әлі нақтылануда: санды үзіндімен тексеріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜의 환율은 아직 확정되지 않았습니다. 명세서와 금액을 비교해 주세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул күндүн курсу такталууда: сумманы көчүрмө менен текшериңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koers van deze dag wordt nog bijgewerkt. Controleer het bedrag op het afschrift."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs z tego dnia jest jeszcze ustalany. Sprawdź kwotę na wyciągu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cotação deste dia ainda está sendo ajustada: confira o valor no extrato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa deste dia ainda está a ser apurada: confirme o valor no extrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс этого дня ещё уточняется: сверьте сумму с выпиской."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби ин рӯз ҳанӯз дақиқ мешавад: маблағро бо иқтибоси ҳисоб санҷед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günün kuru henüz kesinleşmedi: tutarı hesap özetiyle karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс за цей день ще уточнюється: звірте суму з випискою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kunning kursi hali aniqlashtirilmoqda: summani ko‘chirma bilan solishtiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当日汇率仍在调整，请对照账单核对金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當日匯率仍在調整中，請對照對帳單確認金額。"
          }
        }
      }
    },
