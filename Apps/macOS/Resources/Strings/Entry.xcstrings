    "entry.ahead.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Olduğu kimi qeyd edilsin, yoxsa planlaşdırılsın? Plan öz gününü Planlaşdırma bölməsində gözləyəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запісаць зараз ці запланаваць? План будзе чакаць свайго дня ў планаванні."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenat, nebo naplánovat? Plán počká v Plánování na svůj den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So erfassen oder planen? Eine Planung wartet unter „Planung“ auf ihren Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record it as it is, or plan it? A plan waits in Planning for its day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Registrarla tal cual, o planificarla? Un plan espera en Planificación hasta su día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter tel quel, ou planifier ? Une planification attend dans « Planification » le jour venu."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրանցե՞լ այսպես, թե՞ պլանավորել։ Պլանը կմնա Պլանավորում բաժնում մինչև իր օրը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi registrarla così o pianificarla? Una voce pianificata attende il suo giorno in Pianificazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま記録しますか？予定として登録すると、当日まで「予定」に表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩავწეროთ თუ დავგეგმოთ? გეგმა თავის დღეს დაგეგმვაში დაელოდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осылай жазамыз ба, әлде жоспарлаймыз ба? Жоспар күні келгенше «Жоспарлауда» тұрады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그대로 기록할까요, 아니면 예정할까요? 예정 항목은 해당 날짜까지 계획에 보관됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушул бойдон жазасызбы же пландайсызбы? План өз күнүнө чейин Пландоодо күтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu vastleggen of plannen? Een geplande transactie wacht in Planning tot de opgegeven dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisać teraz czy zaplanować? Plan będzie czekać w Planowaniu do wybranego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar como está ou planejar? Um item planejado aguarda sua data em Planejamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registar como está ou planear? Um plano fica em Planeamento até ao dia previsto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать как есть или запланировать? План ждёт своего дня в «Планировании»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳамин тавр сабт шавад ё ба нақша гирифта шавад? Нақша дар Банақшагирӣ то рӯзи худ мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olduğu gibi kaydedilsin mi, planlansın mı? Planlanan işlem gününe kadar Planlama'da bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записати як є чи запланувати? План очікуватиме свого дня в «Плануванні»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Amalni hozir qayd etasizmi yoki rejalashtirasizmi? Reja o‘z kunigacha Rejalashtirishda turadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接记账还是加入计划？计划会在“计划”中等待到期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要直接記錄還是排入計畫？計畫會在「規劃」中等待指定日期。"
          }
        }
      }
    },
