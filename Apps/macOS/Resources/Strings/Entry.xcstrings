    "entry.dictation.denied": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дазвольце OhMyMoney доступ да мікрафона і распазнавання маўлення ў сістэмных наладах прыватнасці. Вы можаце працягваць уводзіць тэкст."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie OhMyMoney in den Datenschutzeinstellungen des Systems den Zugriff auf Mikrofon und Spracherkennung. Sie können weiter tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone and speech recognition access for OhMyMoney in system privacy settings. You can keep typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a OhMyMoney el acceso al micrófono y al reconocimiento de voz en los ajustes de privacidad del sistema. Puede seguir escribiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès au micro et à la reconnaissance vocale pour OhMyMoney dans les réglages de confidentialité du système. Vous pouvez continuer à taper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a OhMyMoney di accedere al microfono e al riconoscimento vocale nelle impostazioni di privacy del sistema. Puoi continuare a scrivere."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүйенің құпиялылық баптауларында OhMyMoney үшін микрофон мен сөйлеуді тану рұқсатын беріңіз. Теруді жалғастыра аласыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól OhMyMoney na dostęp do mikrofonu i rozpoznawania mowy w ustawieniach prywatności systemu. Nadal możesz pisać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao microfone e ao reconhecimento de fala para o OhMyMoney nos ajustes de privacidade do sistema. Você pode continuar digitando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите OhMyMoney доступ к микрофону и распознаванию речи в настройках конфиденциальности системы. Можно продолжать вводить текст вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem gizlilik ayarlarında OhMyMoney için mikrofon ve konuşma tanıma erişimine izin verin. Yazmaya devam edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте OhMyMoney доступ до мікрофона та розпізнавання мовлення в системних налаштуваннях приватності. Можна продовжувати вводити текст."
          }
        }
      }
    },
    "entry.dictation.listening": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухаю… Націсніце «Спыніць» або зрабіце паўзу, каб скончыць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird zugehört… Tippen Sie auf Stopp oder Pause, um abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening… Tap stop or pause to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando… Pulse parar o pausa para terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute en cours… Appuyez sur stop ou pause pour terminer."
