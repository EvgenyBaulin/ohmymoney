        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupiono na kredyt — zmieniono w Długach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado a crédito — alterado em Dívidas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado a crédito — alterado em Dívidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка в кредит — меняется в разделе «Долги»"
