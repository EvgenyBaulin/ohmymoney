    "entry.error.creditNotPurchase": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız xərci kreditlə almaq olar"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У крэдыт можна купіць толькі расход"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na úvěr lze pořídit jen výdaj"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Ausgabe kann auf Kredit gekauft werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an expense can be bought on credit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un gasto puede comprarse a crédito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une dépense peut être achetée à crédit"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ապառիկ կարելի է գնել միայն ծախսը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una spesa può essere acquistata a credito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジット購入にできるのは支出のみです"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კრედიტით მხოლოდ ხარჯის შეძენაა შესაძლებელი"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Несиеге тек шығыс сатып алынуы мүмкін"
          }
        },
        "ko": {
          "stringUnit": {
