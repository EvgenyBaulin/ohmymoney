    "entry.debt.moneyBack": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы па доўгу перад вамі лічацца яго вяртаннем: рэшта доўгу пагашаецца і ён закрываецца, а лішак залічваецца ў даход «Даплаты»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld auf eine Schuld, die Ihnen geschuldet wird, ist die Rückzahlung dieser Schuld: Sie nimmt, was übrig ist, und endet; was darüber liegt, ist Einnahme bei den „Aufschlägen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money onto a debt owed to you is the debt paid back: it takes what is left and closes, what is over is income in «Surcharges»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero que entra en una deuda que le deben es el pago de esa deuda: cubre lo que queda y se cierra; lo que sobre es ingreso en «Recargos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent versé sur une dette qui vous est due rembourse la dette : il prend ce qui reste et la clôt ; le surplus va en revenu dans « Surcharges »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un versamento su un credito viene considerato un rimborso: copre l’importo residuo e chiude il credito. L’eccedenza è un’entrata in «Maggiorazioni»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сізге берілген берешекке қайтарылған ақша — берешекті қайтару: ол қалғанын алып, жабылады, артығы «Үстемақылардағы» табыс болады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłata na należny Ci dług jest jego spłatą: pokrywa pozostałą kwotę i zamyka dług. Nadwyżka jest przychodem w «Surcharges»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor recebido por uma dívida devida a você quita o saldo restante e encerra a dívida; o excedente é uma receita em «Acréscimos»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги по долгу «Мне должны» — возврат долга: он заберёт остаток и закроется, лишнее станет доходом в «Доплатах»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size olan bir borca gelen para, borcun geri ödemesidir: kalan borç kapatılır, fazlası «Ek Ödemeler» içinde gelir sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші в рахунок боргу вам — його погашення: залишок погашається, борг закривається, а надлишок стає доходом у «Доплатах»."
          }
        }
      }
    },
