    "moneyBack.onlyProvisional": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şəxsin bütün borcları müvəqqəti məzənnə ilədir. Məzənnələr dəqiqləşəndə pulu qeydə alın və ya əl ilə daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усё, што вінны гэты чалавек, запісана паводле папярэдняга курсу. Запішыце грошы, калі курсы стануць канчатковымі, або ўручную."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, co vám tato osoba dluží, má předběžný kurz. Peníze zapište po jeho potvrzení nebo ručně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was diese Person schuldet, steht auf einem vorläufigen Kurs. Erfassen Sie das Geld, sobald die Kurse endgültig sind, oder von Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything this person owes is on a provisional rate. Record the money once the rates are final, or manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que esta persona le debe está con un tipo provisional. Registre el dinero cuando los tipos sean definitivos, o a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que cette personne doit est au taux provisoire. Notez l'argent une fois les taux définitifs, ou à la main."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անձի ամբողջ պարտքը ժամանակավոր փոխարժեքով է։ Գրանցեք գումարը, երբ փոխարժեքները վերջնական լինեն, կամ գրանցեք ձեռքով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli importi dovuti da questa persona hanno un tasso provvisorio. Registra il denaro quando i tassi sono definitivi oppure manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この相手の未精算分はすべて仮レートです。レートが確定してから記録するか、手動で記録してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ადამიანის მთელი ვალი დროებითი კურსითაა. ჩაწერეთ თანხა საბოლოო კურსის მიღების შემდეგ ან ხელით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл адамның барлық қарызы уақытша бағамда. Бағамдар соңғы болғанда немесе қолмен ақшаны жазыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람에게 받을 돈은 모두 잠정 환율이 적용되어 있습니다. 환율이 확정된 후 기록하거나 수동으로 기록하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул адамдын бардык карыздары убактылуу курс менен жазылган. Курстар такталганда же кол менен жазыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat deze persoon je verschuldigd is, heeft een voorlopige koers. Leg het geld vast zodra de koersen definitief zijn, of doe dit handmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie należności od tej osoby mają tymczasowy kurs. Zapisz zwrot, gdy kursy będą ostateczne, lub zrób to ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que essa pessoa deve está com cotação provisória. Lance o dinheiro quando as cotações forem definitivas ou faça isso manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que esta pessoa deve tem uma taxa de câmbio provisória. Registe o dinheiro quando as taxas forem definitivas ou faça-o manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что должен этот человек, пока по предварительному курсу. Запишите деньги, когда курс станет окончательным, или вручную."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби ҳамаи қарзҳои ин шахс муваққатист. Пулро пас аз ниҳоӣ шудани қурбҳо ё дастӣ сабт кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişinin tüm borçları geçici kurda. Kurlar kesinleşince veya elle kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі борги цієї людини мають попередній курс. Запишіть гроші після уточнення курсів або вручну."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu odamning barcha qarzlari vaqtinchalik kursda. Kurslar tasdiqlangach yoki qo‘lda yozing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此人欠款的汇率均为暂定。请在汇率确定后记录收款，或手动记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此人所有欠款的匯率都尚未確定。請等匯率確定後再記錄款項，或手動記錄。"
          }
        }
      }
    },
    "moneyBack.owesNothing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şəxsin sizə borcu yoxdur. Hər hansı ödənişin qaytarılması olmayan pul gəlirdir — onu gəlir kimi qeydə alın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты чалавек вам нічога не вінны. Грошы, якія не з'яўляюцца вяртаннем, — гэта даход. Запішыце іх як даход."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato osoba vám nic nedluží. Peníze, které nejsou vrácením platby, jsou příjmem — zapište je jako příjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Person schuldet Ihnen nichts. Geld, das für etwas nicht zurückgekommen ist, ist Einnahme — erfassen Sie es als Einnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This person owes you nothing. Money that did not come back for something is income — record it as income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta persona no le debe nada. El dinero que no volvió por algo es ingreso — regístrelo como ingreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne vous doit rien. L'argent qui n'est pas revenu pour quelque chose est un revenu — notez-le comme revenu."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անձը ձեզ պարտք չէ։ Գումարը, որը որևէ ծախսի վերադարձ չէ, եկամուտ է․ գրանցեք այն որպես եկամուտ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona non ti deve nulla. Il denaro ricevuto senza un importo da rimborsare è un’entrata: registralo come tale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この相手の未精算分はありません。立て替えの返金ではないお金は、収入として記録してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ადამიანს თქვენი არაფერი მართებს. თანხა, რომელიც დაბრუნება არ არის, შემოსავალია — ჩაწერეთ შემოსავლად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл адам сізге ештеңе қарыз емес. Бір нәрсе үшін қайтпаған ақша — табыс: оны табыс ретінде жазыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람에게 받을 돈이 없습니다. 정산받은 돈이 아니라면 수입으로 기록하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул адамдын сизге карызы жок. Кайтарым болбогон акча — киреше. Аны киреше катары жазыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze persoon is je niets verschuldigd. Geld dat geen terugbetaling is, is inkomen. Leg het vast als inkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta osoba nic Ci nie jest winna. Pieniądze, które nie są zwrotem, to przychód — zapisz je jako przychód."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pessoa não deve nada a você. Dinheiro que não é reembolso é receita — lance-o como receita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pessoa não lhe deve nada. Dinheiro recebido que não seja um reembolso é uma receita — registe-o como tal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот человек вам ничего не должен. Деньги не за что-то купленное — это доход: запишите их доходом."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин шахс аз шумо қарздор нест. Пуле, ки баргардонидани хароҷот нест, даромад аст — онро ҳамчун даромад сабт кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişinin size borcu yok. Bir ödemenin iadesi olmayan para gelirdir; gelir olarak kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця людина вам нічого не винна. Гроші, які не є поверненням за щось, — це дохід; запишіть їх як дохід."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu odam sizga qarzdor emas. Qaytim bo‘lmagan pul daromad hisoblanadi — uni daromad sifatida yozing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此人不欠你钱。非还款的收款属于收入，请记为收入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此人沒有欠你錢。非歸還款項屬於收入，請記錄為收入。"
          }
        }
      }
    },
