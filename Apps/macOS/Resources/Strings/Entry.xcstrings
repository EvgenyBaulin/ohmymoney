    "moneyBack.provisionalPartsOwed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul hazırda bağlana bilən hissələrdən çoxdur, digər hissələr isə yekun məzənnəni gözləyir. Pulu sonra və ya əl ilə qeydə alın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошай больш, чым трэба для закрыцця даступных частак, а іншыя часткі чакаюць канчатковага курсу. Запішыце грошы пазней або ўручную."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze převyšují části, které lze vyrovnat, zatímco ostatní čekají na konečný kurz. Zapište je později nebo ručně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld ist mehr, als die Teile decken können, während andere Teile auf ihren endgültigen Kurs warten. Erfassen Sie es später oder von Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money is more than the parts it can close while other parts wait for their final rate. Record it later, or manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero supera lo que pueden cerrar las partes mientras otras esperan su tipo definitivo. Regístrelo más tarde, o a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent dépasse les parts qu'il peut clôturer, car d'autres parts attendent leur taux définitif. Notez-le plus tard, ou à la main."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը գերազանցում է այն մասերը, որոնք կարող են փակվել, մինչ մյուսները սպասում են վերջնական փոխարժեքի։ Գրանցեք ավելի ուշ կամ ձեռքով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro supera le parti che può saldare, mentre altre attendono il tasso definitivo. Registralo più tardi oppure manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定レートを待っている分があるため、今回精算できる金額を返金額が超えています。後で記録するか、手動で記録してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა მეტია იმ ნაწილებზე, რომელთა დაფარვაც ახლა შეიძლება, ხოლო სხვა ნაწილები საბოლოო კურსს ელოდება. ჩაწერეთ მოგვიანებით ან ხელით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша басқа бөліктер соңғы бағамын күтіп тұрғанда жабатын бөліктерден көп. Оны кейін жазыңыз, не қолмен."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 항목의 환율이 확정되기를 기다리는 동안 정산할 수 있는 금액보다 받은 돈이 많습니다. 나중에 기록하거나 수동으로 기록하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча азыр жабыла турган бөлүктөрдүн суммасынан көп, ал эми башка бөлүктөр акыркы курсту күтүп жатат. Кийинчерээк же кол менен жазыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bedrag is hoger dan de delen die ermee kunnen worden voldaan, terwijl andere delen nog op hun definitieve koers wachten. Leg het later of handmatig vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota przekracza wartość części, które można rozliczyć, a pozostałe czekają na ostateczny kurs. Zapisz zwrot później lub ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor é maior que o das partes que podem ser quitadas, enquanto outras aguardam a cotação definitiva. Lance-o depois ou manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro excede as partes que pode liquidar enquanto outras aguardam a taxa definitiva. Registe-o mais tarde ou manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Денег больше, чем закрывают части, а другие части ждут окончательного курса. Запишите позже или вручную."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пул аз қисмҳое, ки пӯшидан мумкин аст, зиёдтар аст; қисмҳои дигар мунтазири қурби ниҳоӣ ҳастанд. Онро дертар ё дастӣ сабт кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelen para, kapatılabilecek tutarlardan fazla; diğer tutarlar kesin kuru bekliyor. Daha sonra veya elle kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошей більше, ніж частин, які зараз можна закрити; інші частини ще чекають остаточного курсу. Запишіть пізніше або вручну."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul yopilishi mumkin bo‘lgan qismlardan ko‘p, boshqa qismlar esa yakuniy kursni kutmoqda. Keyinroq yoki qo‘lda yozing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收款金额超过了可结清的代付款，其他代付款仍在等待最终汇率。请稍后记录，或手动记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "款項超過目前可結清的分攤金額，其他分攤仍在等待匯率確定。請稍後記錄，或手動記錄。"
          }
        }
      }
    },
    "moneyBack.provisionalRate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pulun məzənnəsi hələ müvəqqətidir. ↓ panelində məzənnəni daxil edin və ya pulu sonra qeydə alın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс гэтых грошай яшчэ папярэдні. Увядзіце курс на панэлі ↓ або запішыце грошы пазней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz těchto peněz je zatím předběžný. Zadejte kurz na panelu ↓ nebo peníze zapište později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurs dieses Geldes ist noch vorläufig. Tragen Sie den Kurs im Bedienfeld ↓ ein oder erfassen Sie das Geld später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate of this money is still provisional. Type the rate in the ↓ panel, or record the money later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de este dinero todavía es provisional. Escriba el tipo en el panel ↓, o registre el dinero más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de cet argent est encore provisoire. Saisissez le taux dans le panneau ↓, ou notez l'argent plus tard."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գումարի փոխարժեքը դեռ ժամանակավոր է։ Մուտքագրեք փոխարժեքը ներքևի վահանակում կամ գրանցեք գումարը ավելի ուշ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso di questo denaro è ancora provvisorio. Inserisci il tasso nel pannello ↓ oppure registra il denaro più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金のレートはまだ仮です。↓のパネルにレートを入力するか、後で記録してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თანხის კურსი ჯერ დროებითია. შეიყვანეთ კურსი ↓ პანელში ან ჩაწერეთ თანხა მოგვიანებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ақшаның бағамы әлі уақытша. Бағамды ↓ панельде теріңіз, не ақшаны кейін жазыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 돈의 환율이 아직 잠정 환율입니다. ↓ 패널에 환율을 입력하거나 나중에 기록하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул акчанын курсу азырынча убактылуу. Курсту ↓ панелине киргизиңиз же акчаны кийинчерээк жазыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koers van dit geld is nog voorlopig. Voer de koers in het paneel ↓ in, of leg het geld later vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs tych pieniędzy jest jeszcze tymczasowy. Wpisz kurs w panelu ↓ lub zapisz zwrot później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cotação deste dinheiro ainda é provisória. Informe a cotação no painel ↓ ou lance o dinheiro depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de câmbio deste dinheiro ainda é provisória. Indique a taxa no painel ↓ ou registe o dinheiro mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс этих денег ещё предварительный. Введите курс в панели ↓ или запишите позже."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби ин пул ҳанӯз муваққатист. Қурбро дар панели ↓ ворид кунед ё пулро дертар сабт кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu paranın kuru hâlâ geçici. ↓ paneline kuru girin veya parayı daha sonra kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс цих грошей ще попередній. Введіть курс на панелі ↓ або запишіть гроші пізніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pulning kursi hali vaqtinchalik. Kursni ↓ paneliga kiriting yoki pulni keyinroq yozing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此笔收款的汇率仍为暂定。请在下方 ↓ 面板中输入汇率，或稍后记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此款項的匯率尚未確定。請在下方面板輸入匯率，或稍後記錄。"
          }
        }
      }
    },
