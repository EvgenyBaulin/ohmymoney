    "entry.minBalance.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra balans %1$@ olacaq — %2$@ məbləğindən aşağı düşdüyü üçün aylıq faiz itirilə bilər"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасля гэтага баланс будзе %1$@ — ніжэй за %2$@, стаўка за месяц можа быць страчана"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek pak bude %1$@ — při poklesu pod %2$@ můžete přijít o úrok za daný měsíc"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach beträgt der Saldo %1$@ — unter %2$@, der Zinssatz für den Monat könnte verloren gehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this the balance will be %1$@ — below %2$@, the rate for the month may be lost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después el saldo será %1$@ — por debajo de %2$@, el tipo del mes puede perderse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après cela le solde sera de %1$@ — sous %2$@, le taux du mois peut être perdu"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սրանից հետո մնացորդը կլինի %1$@․ %2$@-ից ցածր լինելու դեպքում ամսվա տոկոսադրույքը կարող է կորչել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo sarà %1$@ — sotto %2$@ potresti perdere il tasso del mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引後の残高は%1$@になります。%2$@を下回ると、今月の金利が適用されない場合があります"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამის შემდეგ ბალანსი იქნება %1$@ — %2$@-ზე ნაკლები; თვის სარგებელი შესაძლოა დაკარგოთ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осыдан кейін теңгерім %1$@ болады — %2$@ төмен, айдың мөлшерлемесі жоғалуы мүмкін"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래 후 잔액이 %1$@입니다. %2$@ 미만이므로 이번 달 금리가 적용되지 않을 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мындан кийин калдык %1$@ болот — %2$@ суммасынан аз болгондуктан, айлык пайыз жоголушу мүмкүн"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierna is het saldo %1$@ — onder %2$@ kan de maandrente vervallen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo wyniesie %1$@ — poniżej %2$@ możesz stracić oprocentowanie za ten miesiąc"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo ficará em %1$@ — abaixo de %2$@; a taxa do mês pode ser perdida"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Após esta operação, o saldo será %1$@ — abaixo de %2$@, poderá perder a taxa do mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этого остаток станет %1$@ — ниже %2$@, ставка за месяц может пропасть"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пас аз ин бақия %1$@ мешавад — аз %2$@ камтар; фоизи ин моҳ метавонад аз даст равад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemden sonra bakiye %1$@ olacak — %2$@ tutarının altında kalırsa aylık faiz oranı kaybedilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після цього залишок буде %1$@ — менше ніж %2$@, ставку за місяць може бути втрачено"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan keyin qoldiq %1$@ bo‘ladi — %2$@ dan kam, oylik stavka yo‘qotilishi mumkin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易后余额为 %1$@，低于 %2$@，可能无法享受当月利率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易後餘額將為 %1$@，低於 %2$@，可能失去本月利率"
          }
        }
      }
    },
