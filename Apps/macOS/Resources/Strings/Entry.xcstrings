          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase rate is still provisional: type the rate from the statement and the part closes now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de la compra todavía es provisional: escriba el tipo del extracto y la parte se cierra ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de l'achat est encore provisoire : saisissez le taux du relevé et la part se clôt maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso dell’acquisto è ancora provvisorio: inserisci quello dell’estratto conto per saldare subito la parte."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
