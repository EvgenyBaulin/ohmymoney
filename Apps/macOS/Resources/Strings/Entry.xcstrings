    "entry.error.noDependencies": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pəncərə məlumatları olmadan açılıb, ona görə heç nə yadda saxlanıla bilməz. Pəncərəni yenidən açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Акно адкрылася без даных, таму нічога не ўдасца захаваць. Адкрыйце яго зноў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno se zobrazilo bez dat, proto nelze nic uložit. Otevřete ho znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Fenster wurde ohne seine Daten angezeigt, daher kann nichts gespeichert werden. Öffnen Sie das Fenster erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window was shown without its data, so nothing can be saved. Reopen the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ventana se abrió sin sus datos, así que no se puede guardar nada. Vuelva a abrir la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fenêtre s'est ouverte sans ses données, donc rien ne peut être enregistré. Rouvrez la fenêtre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատուհանը բացվել է առանց տվյալների, ուստի ոչինչ չի պահպանվի։ Կրկին բացեք պատուհանը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra è stata aperta senza i suoi dati, quindi non è possibile salvare. Riapri la finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データがないままウインドウが表示されたため、保存できません。ウインドウを開き直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფანჯარა მონაცემების გარეშე გაიხსნა, ამიტომ შენახვა შეუძლებელია. ხელახლა გახსენით ფანჯარა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл терезе деректерсіз көрсетілді, сондықтан ештеңе сақтау мүмкін емес. Терезені қайта ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 없이 창이 열려 저장할 수 없습니다. 창을 다시 여십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Терезе дайындарсыз ачылгандыктан, эч нерсе сакталбайт. Терезени кайра ачыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit venster is zonder gegevens geopend. Er kan niets worden bewaard. Open het venster opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno zostało wyświetlone bez danych, więc nic nie można zachować. Otwórz je ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta janela foi aberta sem os dados necessários. Feche e abra novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta janela foi apresentada sem os respetivos dados, pelo que nada pode ser guardado. Abra-a novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это окно открыто без данных приложения, сохранить нечего. Закройте и откройте окно заново."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин равзана бе маълумоташ кушода шуд, бинобар ин чизе захира намешавад. Равзанаро аз нав кушоед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencere verileri olmadan açıldı, bu yüzden hiçbir şey kaydedilemiyor. Pencereyi yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це вікно відкрито без даних, тому нічого не можна зберегти. Відкрийте вікно знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyna ma’lumotlarsiz ochildi, shuning uchun hech narsani saqlab bo‘lmaydi. Oynani qayta oching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗口未载入数据，无法保存。请重新打开窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此視窗缺少資料，無法儲存。請重新開啟視窗。"
          }
        }
      }
    },
