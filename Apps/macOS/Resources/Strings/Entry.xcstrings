    "entry.instalments.summary": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hissə %@; ilk ödəniş alış günündədir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Частка — %@; першая ў дзень пакупкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Splátka činí %@; první v den nákupu."
          }
