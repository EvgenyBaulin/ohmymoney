    "entry.cashback.rememberSplit": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hissələrin kateqoriyaları fərqlidir — qaydanı hesabın Keşbek qaydaları bölməsində təyin edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Часткі маюць розныя катэгорыі — задайце правіла ў правілах кэшбэку рахунку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Části mají různé kategorie — nastavte pravidlo v pravidlech cashbacku účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Teile haben verschiedene Kategorien — legen Sie die Regel unter „Cashback-Regeln“ des Kontos fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parts have different categories — set the rule in the account’s Cashback Rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes tienen categorías distintas — fije la regla en las Reglas de cashback de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parts ont des catégories différentes — réglez la règle dans les « Règles de cashback » du compte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մասերն ունեն տարբեր կատեգորիաներ․ սահմանեք կանոնը հաշվի Քեշբեքի կանոններ բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parti hanno categorie diverse: imposta la regola nelle regole di cashback del conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各項目のカテゴリが異なります。口座の「キャッシュバックルール」で設定してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაწილებს სხვადასხვა კატეგორია აქვს — წესი ანგარიშის ქეშბექის წესებში დააყენეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөліктердің санаттары әртүрлі — ережені есеп-шоттың «Кешбэк ережелерінде» белгілеңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목의 카테고리가 서로 다릅니다. 계좌의 캐시백 규칙에서 설정하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүктөрдүн категориялары ар башка — эрежени эсептин Кэшбэк эрежелеринен орнотуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De onderdelen hebben verschillende categorieën. Stel de regel in bij de cashbackregels van de rekening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Części mają różne kategorie — ustaw regułę w zasadach cashbacku konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes têm categorias diferentes — defina a regra em Regras de Cashback da conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes têm categorias diferentes — defina a regra em Regras de cashback da conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У частей разные категории — правило задаётся в «Правилах кэшбэка» счёта."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қисмҳо категорияҳои гуногун доранд — қоидаро дар Қоидаҳои кэшбэки ҳисоб танзим кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçaların kategorileri farklı — kuralı hesabın Nakit İadesi Kuralları bölümünde ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У частин різні категорії — задайте правило в «Правилах кешбеку» рахунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qismlarning toifalari turlicha — qoidani hisobning Keshbek qoidalarida belgilang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各部分的类别不同，请在账户的“返现规则”中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各部分的類別不同，請在帳戶的「現金回饋規則」中設定。"
          }
        }
      }
    },
