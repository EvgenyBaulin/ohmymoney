    "entry.cashback.unreadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxunmur: məbləğ (“45”) və ya faiz (“5%”) daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося прачытаць: увядзіце суму (“45”) або працэнт (“5%”)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnotu nelze přečíst: zadejte částku („45“) nebo procento („5%“)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht lesbar: Tragen Sie einen Betrag („45“) oder einen Prozentsatz („5 %“) ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t read it: type an amount (“45”) or a percent (“5%”)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se lee: escriba un importe («45») o un porcentaje («5%»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible à lire : saisissez un montant (« 45 ») ou un pourcentage (« 5% »)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հնարավոր չէ կարդալ․ մուտքագրեք գումար («45») կամ տոկոս («5%»)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il valore: inserisci un importo (“45”) o una percentuale (“5%”)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れません。金額（“45”）または割合（“5%”）を入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერ იკითხება: შეიყვანეთ თანხა (“45”) ან პროცენტი (“5%”)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оқу мүмкін емес: соманы («45») немесе пайызды («5%») теріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 없습니다. 금액(“45”) 또는 백분율(“5%”)을 입력하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Окуу мүмкүн эмес: сумманы (“45”) же пайызды (“5%”) киргизиңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan dit niet lezen. Voer een bedrag (‘45’) of percentage (‘5%’) in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać: wpisz kwotę („45”) lub wartość procentową („5%”)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler: digite um valor (“45”) ou uma porcentagem (“5%”)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler: introduza um montante (“45”) ou uma percentagem (“5%”)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не читается: впишите сумму («45») или процент («5%»)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хондан имкон надорад: маблағ (“45”) ё фоизро (“5%”) ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunamıyor: bir tutar (“45”) veya yüzde (“5%”) girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати: введіть суму («45») або відсоток («5%»)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘qib bo‘lmadi: summa (“45”) yoki foiz (“5%”) kiriting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别，请输入金额（“45”）或百分比（“5%”）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取，請輸入金額（「45」）或百分比（「5%」）。"
          }
        }
      }
    },
