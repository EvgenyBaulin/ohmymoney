    "entry.selfEmployed.offer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeydə alındı. Fərdi fəaliyyət vergisi hesablansın?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запісана. Падлічыць падатак самазанятага?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapsáno. Vypočítat daň OSVČ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst. Die Steuer der Selbstständigen berechnen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded. Count the tax of the self-employed?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrado. ¿Calcular el impuesto de los autónomos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noté. Calculer l'impôt des indépendants ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրանցված է։ Հաշվե՞լ ինքնազբաղվածի հարկը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrato. Calcolare l’imposta sul lavoro autonomo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録しました。自営業者の税金を計算しますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაიწერა. გამოვთვალოთ თვითდასაქმებულის გადასახადი?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылды. Өзін-өзі жұмыспен қамтығандардың салығын есептейік пе?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록되었습니다. 자영업자 세금을 계산할까요?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылды. Өз алдынча иштеген адамдын салыгын эсептейсизби?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgelegd. Belasting voor zelfstandigen berekenen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano. Obliczyć podatek osoby samozatrudnionej?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lançado. Calcular o imposto de autônomo?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registado. Calcular o imposto de trabalhador independente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записано. Учитывать налог самозанятого?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сабт шуд. Андози худмашғулиро ҳисоб кунем?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedildi. Serbest meslek vergisi hesaplansın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записано. Рахувати податок самозайнятого?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yozildi. O‘zini o‘zi band qilganlar solig‘ini hisoblaysizmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
