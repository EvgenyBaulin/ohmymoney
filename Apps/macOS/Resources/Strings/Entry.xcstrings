    "moneyBack.owesOnDebt": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şəxs üçün ödənilmiş gözləyən məbləğ yoxdur, lakin onun sizə borcu var. Bu pul həmin borcun ödənişidir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Неаплачаных частак за гэтага чалавека няма, але ён мае перад вамі доўг. Гэтыя грошы — вяртанне доўгу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vrácení žádné platby za tuto osobu se nečeká, ale tato osoba vám dluží. Peníze jsou splátkou tohoto dluhu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts für diese Person Bezahltes wartet, aber sie schuldet Ihnen aus einer Schuld. Das Geld ist eine Rückzahlung dieser Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing paid for this person is waiting, but they owe you on a debt. The money is a repayment of that debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada pagado por esta persona pendiente, pero le debe en una deuda. El dinero es la devolución de esa deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien payé pour cette personne n'attend, mais elle vous doit sur une dette. L'argent est un remboursement de cette dette."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անձի համար վճարված գումարներից վերադարձի սպասող չկա, բայց նա ձեզ պարտք է։ Գումարը այդ պարտքի մարումն է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono importi pagati per questa persona in attesa di rimborso, ma ha un debito con te. Il denaro rimborsa quel debito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この相手への立て替えに未精算分はありませんが、借金があります。このお金は借金の返済です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ადამიანის ნაცვლად გადახდილი თანხა არ ელოდება დაბრუნებას, მაგრამ მას თქვენი ვალი აქვს. ეს თანხა ვალის დაფარვაა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл адам үшін төленген ешбір нәрсе күтпейді, бірақ ол сізге берешек бойынша қарыз. Ақша сол берешекті қайтару болып табылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람을 대신해 결제하고 받을 돈은 없지만, 이 사람에게 받을 채무가 있습니다. 이 돈은 해당 채무의 상환금입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул адам үчүн төлөнгөн күтүүдө турган чыгымдар жок, бирок ал сизге карыз. Бул акча ошол карыздын төлөмү."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staan geen betalingen voor deze persoon open, maar deze persoon heeft wel een schuld bij je. Het geld is een aflossing van die schuld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma oczekujących wydatków za tę osobę, ale ma ona wobec Ciebie dług. Te pieniądze są jego spłatą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há valores pagos por essa pessoa aguardando reembolso, mas ela tem uma dívida com você. O dinheiro é um pagamento dessa dívida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há pagamentos por esta pessoa à espera de reembolso, mas ela tem uma dívida consigo. O dinheiro é um pagamento dessa dívida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За этого человека ничего не ждёт возврата, но он должен вам по долгу. Эти деньги — возврат долга."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ин шахс пардохти интизорӣ нест, аммо ӯ аз шумо қарздор аст. Ин пул баргардонидани ҳамон қарз аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişi için ödenmiş ve bekleyen bir tutar yok, ancak size borcu var. Gelen para bu borcun ödemesidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає частин, оплачених за цю людину, що очікують повернення, але є її борг. Ці гроші — погашення того боргу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu odam uchun to‘langan kutilayotgan qismlar yo‘q, ammo u sizdan qarzdor. Bu pul qarz qaytimidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待收回的代付款，但此人有欠你的债务。这笔钱用于偿还该债务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有待收回的代付款，但此人仍有債務。這筆款項用於償還該債務。"
          }
        }
      }
    },
