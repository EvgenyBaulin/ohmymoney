    "entry.accountCharge.check": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabdan çıxılan məbləğ yenidən hesablanmadı — yoxlayın"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума спісання не пералічана — праверце яе"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částka stržená z účtu nebyla přepočítána. Zkontrolujte ji"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Belastet auf Konto“ wurde nicht neu berechnet — prüfen Sie es"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charged to account was not recalculated — check it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cargo en la cuenta no se recalculó: compruébelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le débit du compte n'a pas été recalculé — vérifiez-le"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվից գանձված գումարը չի վերահաշվարկվել․ ստուգեք այն"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’addebito sul conto non è stato ricalcolato: verifica l’importo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座からの引落額が再計算されていません。確認してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩამოჭრილი თანხა არ გადათვლილა — შეამოწმეთ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттан шегерілгені қайта есептелмеді — тексеріңіз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌 출금액이 다시 계산되지 않았습니다. 확인해 주세요"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептен алынган сумма кайра эсептелген жок — текшериңиз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het afgeschreven bedrag is niet opnieuw berekend. Controleer het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obciążzenie konta nie zostało przeliczone — sprawdź je"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor debitado da conta não foi recalculado — confira"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor debitado na conta não foi recalculado — verifique-o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списано со счёта не пересчитано — проверьте"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи аз ҳисоб гирифташуда аз нав ҳисоб нашуд — онро санҷед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaptan çekilen tutar yeniden hesaplanmadı — kontrol edin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списання з рахунку не перераховано — перевірте"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobdan yechilgan summa qayta hisoblanmadi — tekshiring"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户扣款未重新计算，请核对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶扣款金額未重新計算，請確認"
          }
        }
      }
    },
