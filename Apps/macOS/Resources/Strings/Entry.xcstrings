    "entry.cashback.unreadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося прачытаць: увядзіце суму (“45”) або працэнт (“5%”)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht lesbar: Tragen Sie einen Betrag („45“) oder einen Prozentsatz („5 %“) ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t read it: type an amount (“45”) or a percent (“5%”)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se lee: escriba un importe («45») o un porcentaje («5%»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible à lire : saisissez un montant (« 45 ») ou un pourcentage (« 5% »)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il valore: inserisci un importo (“45”) o una percentuale (“5%”)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оқу мүмкін емес: соманы («45») немесе пайызды («5%») теріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać: wpisz kwotę („45”) lub wartość procentową („5%”)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler: digite um valor (“45”) ou uma porcentagem (“5%”)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не читается: впишите сумму («45») или процент («5%»)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunamıyor: bir tutar (“45”) veya yüzde (“5%”) girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати: введіть суму («45») або відсоток («5%»)."
          }
        }
      }
    },
