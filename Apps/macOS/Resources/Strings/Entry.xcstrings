    "entry.ahead.planned.income": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An income is expected on %@ — it is in Planning, ⌘Z takes it back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se espera un ingreso el %@ — está en Planificación, ⌘Z lo quita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revenu est attendu le %@ — il est dans « Planification », ⌘Z le retire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поступление ожидается %@ — оно в «Планировании», ⌘Z вернёт"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід очікується %@ — він у «Плануванні», ⌘Z скасовує дію"
          }
        }
      }
    },
