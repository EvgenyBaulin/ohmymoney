            "value": "%1$@, borcun %2$@ tutarına karşılık gelir. Kur yalnızca bu ödeme içindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — це %2$@ боргу. Курс лише для цього погашення."
          }
        }
      }
    },
