    "entry.prepay.forward": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, əvvəlcədən ödənişdir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта плацёж наперад"
          }
        },
        "cs": {
          "stringUnit": {
