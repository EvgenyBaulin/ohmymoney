    "moneyBack.provisionalPartsOwed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошай больш, чым трэба для закрыцця даступных частак, а іншыя часткі чакаюць канчатковага курсу. Запішыце грошы пазней або ўручную."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld ist mehr, als die Teile decken können, während andere Teile auf ihren endgültigen Kurs warten. Erfassen Sie es später oder von Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money is more than the parts it can close while other parts wait for their final rate. Record it later, or manually."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro supera le parti che può saldare, mentre altre attendono il tasso definitivo. Registralo più tardi oppure manualmente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша басқа бөліктер соңғы бағамын күтіп тұрғанда жабатын бөліктерден көп. Оны кейін жазыңыз, не қолмен."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Денег больше, чем закрывают части, а другие части ждут окончательного курса. Запишите позже или вручную."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошей більше, ніж частин, які зараз можна закрити; інші частини ще чекають остаточного курсу. Запишіть пізніше або вручну."
          }
        }
      }
    },
    "moneyBack.provisionalRate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс гэтых грошай яшчэ папярэдні. Увядзіце курс на панэлі ↓ або запішыце грошы пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurs dieses Geldes ist noch vorläufig. Tragen Sie den Kurs im Bedienfeld ↓ ein oder erfassen Sie das Geld später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate of this money is still provisional. Type the rate in the ↓ panel, or record the money later."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso di questo denaro è ancora provvisorio. Inserisci il tasso nel pannello ↓ oppure registra il denaro più tardi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ақшаның бағамы әлі уақытша. Бағамды ↓ панельде теріңіз, не ақшаны кейін жазыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс этих денег ещё предварительный. Введите курс в панели ↓ или запишите позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс цих грошей ще попередній. Введіть курс на панелі ↓ або запишіть гроші пізніше."
          }
        }
      }
    },
