    "entry.ahead.planned.income": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einnahme wird am %@ erwartet — sie steht unter „Planung“, ⌘Z nimmt sie zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An income is expected on %@ — it is in Planning, ⌘Z takes it back"
