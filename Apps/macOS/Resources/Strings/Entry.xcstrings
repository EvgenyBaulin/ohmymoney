          "stringUnit": {
            "state": "translated",
            "value": "%@ — recorded at %@. Add another one?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — registrado a las %2$@. ¿Añadir otro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — noté à %@. En ajouter une autre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — registrata alle %@. Aggiungerne un’altra?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@ уақытта жазылды. Тағы бірін қосайық па?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — zapisano o %@. Dodać kolejny wpis?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — lançado às %@. Adicionar outro?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — записана в %@. Добавить ещё одну?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@ saatinde kaydedildi. Bir tane daha eklensin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — записано о %@. Додати ще одну?"
