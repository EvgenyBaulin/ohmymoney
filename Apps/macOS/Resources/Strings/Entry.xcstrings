    "entry.add.accountInArchive": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак з такой назвай знаходзіцца ў архіве. Ён захаваны; вы можаце аднавіць яго ў Наладах → Рахункі або перайменаваць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konto mit diesem Namen ist archiviert. Du kannst es unter Einstellungen → Konten wiederherstellen oder umbenennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with this name is in the archive. It is still saved; you can bring the old one back in Settings → Accounts or rename it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una cuenta con este nombre en el archivo. Sigue guardada; puedes restaurarla en Ajustes → Cuentas o cambiarle el nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte portant ce nom se trouve dans les archives. Il est toujours enregistré ; vous pouvez le restaurer dans Réglages → Comptes ou le renommer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto con questo nome è nell’archivio. È ancora salvato; puoi ripristinarlo in Impostazioni → Conti o rinominarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұндай атаулы шот архивте бар. Ол сақталған; оны Баптаулар → Шоттар бөлімінде қалпына келтіруге немесе атын өзгертуге болады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto o tej nazwie znajduje się w archiwum. Możesz je przywrócić w Ustawieniach → Konta lub zmienić jego nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta com este nome está no arquivo. Ela continua salva; você pode restaurá-la em Ajustes → Contas ou renomeá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт с таким названием есть в архиве. Всё равно сохранится; старый можно вернуть в «Настройки → Счета» или переименовать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ada sahip bir hesap arşivde. Hesap hâlâ kayıtlı; Ayarlar → Hesaplar bölümünden geri getirebilir veya adını değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок із такою назвою є в архіві. Він збережений; ви можете відновити його в Параметри → Рахунки або перейменувати."
          }
        }
      }
    },
    "entry.add.accountNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Іншы рахунак або картка ўжо маюць такую назву; радок уводу можа распазнаць яе як іх назву. Яны захаваны, і вы можаце перайменаваць любы з іх у Наладах."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Konto oder eine andere Karte trägt bereits diesen Namen. Die Eingabe könnte damit verwechselt werden. Beide bleiben gespeichert und können in den Einstellungen umbenannt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another account or card already answers to this name; the entry line may read it as that one. It is still saved, and you can rename either one in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra cuenta o tarjeta ya tiene este nombre; la línea de entrada podría confundirlas. Sigue guardada y puedes cambiar el nombre de cualquiera en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre compte ou une autre carte porte déjà ce nom ; la ligne de saisie pourrait les confondre. L’élément est toujours enregistré ; vous pouvez renommer l’un ou l’autre dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro conto o un’altra carta usa già questo nome; la riga di inserimento potrebbe interpretarlo come tale. È ancora salvato; puoi rinominare uno dei due in Impostazioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл атау басқа шотқа немесе картаға берілген; жазба жолы оны сол шот деп тануы мүмкін. Ол сақталған; кез келгенінің атын Баптауларда өзгертуге болады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne konto lub karta ma już tę nazwę. Wpis może zostać przypisany do tamtego konta. Możesz zmienić nazwę w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra conta ou cartão já usa este nome; o campo de lançamento pode interpretá-lo como o outro. Ambos continuam salvos e você pode renomeá-los em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой счёт или карта уже откликается на это название: строка ввода может прочитать его как тот. Всё равно сохранится; любой из них можно переименовать в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad başka bir hesap veya kartta kullanılıyor; giriş satırı onu seçebilir. Kayıtlı kalır ve Ayarlar'da ikisinden birinin adını değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший рахунок або картка вже мають таку назву; рядок введення може сприйняти її як їхню. Обидва збережені; ви можете перейменувати будь-який із них у Параметрах."
          }
        }
      }
    },
