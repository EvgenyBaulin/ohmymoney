        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’entrata è prevista per il %@: si trova in Pianificazione. Premi ⌘Z per annullare"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күні табыс күтіледі — ол «Жоспарлауда», ⌘Z қайтарады"
          }
        },
        "pl": {
          "stringUnit": {
