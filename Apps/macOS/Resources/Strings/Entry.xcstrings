    "entry.add.accountInArchive": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adda hesab arxivdədir. O, hələ saxlanılır; onu Parametrlər → Hesablar bölməsində bərpa edə və ya adını dəyişə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак з такой назвай знаходзіцца ў архіве. Ён захаваны; вы можаце аднавіць яго ў Наладах → Рахункі або перайменаваць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet s tímto názvem je v archivu. Je stále uložený; můžete ho obnovit v Nastavení → Účty nebo přejmenovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konto mit diesem Namen ist archiviert. Du kannst es unter Einstellungen → Konten wiederherstellen oder umbenennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with this name is in the archive. It is still saved; you can bring the old one back in Settings → Accounts or rename it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una cuenta con este nombre en el archivo. Sigue guardada; puedes restaurarla en Ajustes → Cuentas o cambiarle el nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte portant ce nom se trouve dans les archives. Il est toujours enregistré ; vous pouvez le restaurer dans Réglages → Comptes ou le renommer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անունով հաշիվ կա արխիվում։ Այն պահպանված է․ կարող եք վերականգնել այն Կարգավորումներ → Հաշիվներ բաժնում կամ վերանվանել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto con questo nome è nell’archivio. È ancora salvato; puoi ripristinarlo in Impostazioni → Conti o rinominarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前の口座がアーカイブにあります。データは保存されています。「設定」→「口座」から元に戻すか、名前を変更できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ სახელის ანგარიში არქივშია. ის შენახულია; შეგიძლიათ აღადგინოთ პარამეტრები → ანგარიშებიდან ან სახელი შეუცვალოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұндай атаулы шот архивте бар. Ол сақталған; оны Баптаулар → Шоттар бөлімінде қалпына келтіруге немесе атын өзгертуге болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 계좌가 보관함에 있습니다. 계좌는 그대로 저장되어 있으며, 설정 → 계좌에서 복원하거나 이름을 변경할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мындай аталыштагы эсеп архивде бар. Ал сакталган; аны Жөндөөлөр → Эсептер бөлүмүнөн кайтарып же атын өзгөртө аласыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rekening met deze naam staat in het archief. Je kunt de oude rekening terugzetten via Instellingen → Rekeningen of een andere naam geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto o tej nazwie znajduje się w archiwum. Możesz je przywrócić w Ustawieniach → Konta lub zmienić jego nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta com este nome está no arquivo. Ela continua salva; você pode restaurá-la em Ajustes → Contas ou renomeá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma conta com este nome no arquivo. Continua guardada; pode recuperá-la em Definições → Contas ou mudar-lhe o nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт с таким названием есть в архиве. Всё равно сохранится; старый можно вернуть в «Настройки → Счета» или переименовать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобе бо ин ном дар бойгонӣ аст. Он нигоҳ дошта шудааст; метавонед онро дар Танзимот → Ҳисобҳо барқарор кунед ё номашро иваз кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ada sahip bir hesap arşivde. Hesap hâlâ kayıtlı; Ayarlar → Hesaplar bölümünden geri getirebilir veya adını değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок із такою назвою є в архіві. Він збережений; ви можете відновити його в Параметри → Рахунки або перейменувати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nomdagi hisob arxivda. U saqlangan; uni Sozlamalar → Hisoblar orqali qaytarishingiz yoki nomini o‘zgartirishingiz mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档中已有同名账户。该账户仍然保留，可在“设置”→“账户”中恢复或重命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存中已有同名帳戶。該帳戶仍有保留；你可以在「設定」→「帳戶」中還原舊帳戶或重新命名。"
          }
        }
      }
    },
    "entry.add.accountNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad artıq başqa hesaba və ya karta aiddir; əməliyyat sətri onu seçə bilər. O, hələ saxlanılır və Parametrlərdə hər ikisinin adını dəyişə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Іншы рахунак або картка ўжо маюць такую назву; радок уводу можа распазнаць яе як іх назву. Яны захаваны, і вы можаце перайменаваць любы з іх у Наладах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento název už používá jiný účet nebo karta; při zadávání může být použit tento jiný účet. Je stále uložený a kterýkoli z nich můžete přejmenovat v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Konto oder eine andere Karte trägt bereits diesen Namen. Die Eingabe könnte damit verwechselt werden. Beide bleiben gespeichert und können in den Einstellungen umbenannt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another account or card already answers to this name; the entry line may read it as that one. It is still saved, and you can rename either one in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra cuenta o tarjeta ya tiene este nombre; la línea de entrada podría confundirlas. Sigue guardada y puedes cambiar el nombre de cualquiera en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre compte ou une autre carte porte déjà ce nom ; la ligne de saisie pourrait les confondre. L’élément est toujours enregistré ; vous pouvez renommer l’un ou l’autre dans Réglages."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անունով այլ հաշիվ կամ քարտ արդեն կա․ մուտքագրման տողը կարող է այն շփոթել։ Երկուսն էլ պահպանված են․ կարող եք վերանվանել Կարգավորումներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro conto o un’altra carta usa già questo nome; la riga di inserimento potrebbe interpretarlo come tale. È ancora salvato; puoi rinominare uno dei due in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前の口座またはカードがすでにあります。入力時にそちらとして認識される場合があります。データは保存されています。「設定」で名前を変更できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ სახელს სხვა ანგარიში ან ბარათი უკვე იყენებს; ჩანაწერის ველმა შეიძლება ის ამოიცნოს. ორივე შენახულია და სახელის შეცვლა პარამეტრებში შეგიძლიათ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл атау басқа шотқа немесе картаға берілген; жазба жолы оны сол шот деп тануы мүмкін. Ол сақталған; кез келгенінің атын Баптауларда өзгертуге болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계좌 또는 카드가 이미 이 이름을 사용하고 있습니다. 입력란에서 해당 계좌나 카드로 인식할 수 있습니다. 설정에서 이름을 변경할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мындай аталыштагы башка эсеп же карта бар; жазуу сабы аны тандашы мүмкүн. Ал сакталган, каалаганын Жөндөөлөрдөн өзгөртө аласыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere rekening of kaart heeft deze naam al. Bij het invoeren kan die rekening worden gekozen. Je kunt beide namen wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne konto lub karta ma już tę nazwę. Wpis może zostać przypisany do tamtego konta. Możesz zmienić nazwę w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra conta ou cartão já usa este nome; o campo de lançamento pode interpretá-lo como o outro. Ambos continuam salvos e você pode renomeá-los em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra conta ou cartão já tem este nome; a linha de registo pode associá-lo a esse item. Continua guardado e pode mudar o nome de qualquer um em Definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой счёт или карта уже откликается на это название: строка ввода может прочитать его как тот. Всё равно сохранится; любой из них можно переименовать в настройках."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоб ё корти дигаре аллакай ин номро дорад; сатри сабт метавонад онро интихоб кунад. Он нигоҳ дошта шудааст ва метавонед номи ҳар кадомро дар Танзимот иваз кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad başka bir hesap veya kartta kullanılıyor; giriş satırı onu seçebilir. Kayıtlı kalır ve Ayarlar'da ikisinden birinin adını değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший рахунок або картка вже мають таку назву; рядок введення може сприйняти її як їхню. Обидва збережені; ви можете перейменувати будь-який із них у Параметрах."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nom boshqa hisob yoki kartaga tegishli; kiritish qatori uni o‘sha hisob deb qabul qilishi mumkin. U saqlangan, ikkalasidan birining nomini Sozlamalarda o‘zgartirishingiz mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名账户或卡片，记账栏可能会将其识别为该账户或卡片。两者均已保留，可在“设置”中重命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有其他帳戶或卡片使用此名稱；輸入時可能會被辨識為該帳戶或卡片。兩者都仍有保留，你可以在「設定」中重新命名。"
          }
        }
      }
    },
