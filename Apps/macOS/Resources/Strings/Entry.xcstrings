          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs zakupu jest jeszcze tymczasowy: wpisz kurs z wyciągu, aby rozliczyć tę część."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
