    "entry.dictation.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device dictation is unavailable. Check the microphone and the offline speech model for the interface language in system settings. You can keep typing; cloud recognition is never used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado en el dispositivo no está disponible. Compruebe el micrófono y el modelo de voz sin conexión para el idioma de la interfaz en los ajustes del sistema. Puede seguir escribiendo; el reconocimiento en la nube nunca se usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée sur l'appareil n'est pas disponible. Vérifiez le micro et le modèle de reconnaissance hors ligne pour la langue de l'interface dans les réglages du système. Vous pouvez continuer à taper ; la reconnaissance dans le nuage n'est jamais utilisée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка на устройстве недоступна. Проверьте микрофон и офлайн-модель речи для языка интерфейса в настройках системы. Можно вводить текст вручную; облачное распознавание не используется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктування на пристрої недоступне. Перевірте мікрофон та офлайн-модель мовлення для мови інтерфейсу в системних налаштуваннях. Можна продовжувати вводити текст; хмарне розпізнавання не використовується."
          }
        }
      }
    },
