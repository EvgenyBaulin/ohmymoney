    "entry.error.reimbursementEdit": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана паводле кампенсацыі: каб змяніць суму, тып або валюту, выдаліце кампенсацыю і запішыце яе зноў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch eine Rückzahlung festgelegt: Ihr Betrag, Ihre Art und Währung ändern sich nur, wenn Sie die Rückzahlung löschen und neu erfassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worked out by a reimbursement: its amount, type and currency change only by deleting the reimbursement and recording it again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado por una devolución: su importe, tipo y divisa cambian solo si se elimina la devolución y se registra de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé par un remboursement : son montant, son type et sa devise ne changent qu'en supprimant le remboursement puis en le notant à nouveau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato da un rimborso: per modificarne importo, tipo o valuta, elimina il rimborso e registralo di nuovo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша қайтарылуымен есептелген: оның сомасы, түрі және валютасы тек қайтаруды жойып, қайта жазғанда өзгереді"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozliczono przez zwrot kosztów. Aby zmienić kwotę, typ lub walutę, usuń zwrot i dodaj go ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado por uma restituição: para alterar o valor, tipo ou moeda, apague a restituição e registre-a novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассчитано возвратом денег: сумму, тип и валюту меняют, только удалив возврат и записав его заново"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem bir geri ödeme ile oluşturuldu: tutarı, türü ve para birimi yalnızca geri ödeme silinip yeniden kaydedilerek değiştirilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислено під час повернення грошей: суму, вид і валюту можна змінити, лише видаливши повернення й записавши його знову"
          }
        }
      }
