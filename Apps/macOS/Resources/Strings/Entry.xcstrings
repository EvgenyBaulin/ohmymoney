            "value": "%@ tarixində gəlir gözlənilir — Planlaşdırma bölməsindədir, ⌘Z ilə geri alın"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ чакаецца даход — ён у планаванні, ⌘Z адменіць дзеянне"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjem se očekává %@ — najdete ho v Plánování, pomocí ⌘Z ho vrátíte zpět"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einnahme wird am %@ erwartet — sie steht unter „Planung“, ⌘Z nimmt sie zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An income is expected on %@ — it is in Planning, ⌘Z takes it back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se espera un ingreso el %@ — está en Planificación, ⌘Z lo quita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revenu est attendu le %@ — il est dans « Planification », ⌘Z le retire"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ սպասվում է եկամուտ․ այն Պլանավորում բաժնում է, ⌘Z-ը հետ կվերցնի այն"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’entrata è prevista per il %@: si trova in Pianificazione. Premi ⌘Z per annullare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に収入を予定しています。「予定」に登録されました。⌘Zで取り消せます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შემოსავალი მოსალოდნელია %@ — ის დაგეგმვაშია, ⌘Z გააუქმებს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күні табыс күтіледі — ол «Жоспарлауда», ⌘Z қайтарады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 수입이 예정되어 있습니다. 계획에 추가되었으며 ⌘Z로 실행 취소할 수 있습니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күнү киреше күтүлүүдө — ал Пландоодо, ⌘Z менен артка кайтара аласыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een inkomst wordt verwacht op %@ en staat in Planning. Druk op ⌘Z om dit ongedaan te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przychód jest oczekiwany %@ — znajdziesz go w Planowaniu. Naciśnij ⌘Z, aby cofnąć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma receita é esperada em %@ — ela está em Planejamento; ⌘Z desfaz"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É esperada uma receita em %@ — está em Planeamento; ⌘Z anula"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поступление ожидается %@ — оно в «Планировании», ⌘Z вернёт"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромад дар %@ интизор аст — он дар Банақшагирӣ аст, ⌘Z онро бекор мекунад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinde bir gelir bekleniyor — Planlama'da; ⌘Z ile geri alınabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід очікується %@ — він у «Плануванні», ⌘Z скасовує дію"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kuni daromad kutilmoqda — u Rejalashtirishda, ⌘Z bilan bekor qilinadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计于%@收到一笔收入，已加入“计划”。按 ⌘Z 可撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預計在 %@ 收入，已加入「規劃」，按 ⌘Z 可還原"
          }
        }
      }
    },
