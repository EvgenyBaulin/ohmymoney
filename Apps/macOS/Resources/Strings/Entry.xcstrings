    "entry.add.accountInArchive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with this name is in the archive. It is still saved; you can bring the old one back in Settings → Accounts or rename it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт с таким названием есть в архиве. Всё равно сохранится; старый можно вернуть в «Настройки → Счета» или переименовать."
          }
        }
      }
    },
    "entry.add.accountNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another account or card already answers to this name; the entry line may read it as that one. It is still saved, and you can rename either one in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой счёт или карта уже откликается на это название: строка ввода может прочитать его как тот. Всё равно сохранится; любой из них можно переименовать в настройках."
          }
        }
      }
    },
