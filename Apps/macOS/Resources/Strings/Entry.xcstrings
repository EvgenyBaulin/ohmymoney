    "entry.overLimit.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк можа спагнаць камісію. Усё адно запісаць?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank kann dafür eine Gebühr berechnen. Trotzdem erfassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank may charge a fee for it. Record it anyway?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco puede cobrar una comisión por ello. ¿Registrarlo igual?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque peut facturer des frais pour cela. Noter quand même ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca potrebbe addebitare una commissione. Vuoi registrare comunque?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк үшін комиссия алуы мүмкін. Бәрібір жазайық па?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank może naliczyć opłatę. Zapisać mimo to?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco pode cobrar uma tarifa. Registrar mesmo assim?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможна комиссия банка. Записать всё равно?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka bunun için ücret alabilir. Yine de kaydedilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк може стягнути комісію. Усе одно записати?"
          }
        }
      }
    },
