        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 삭제되어 변경사항이 저장되지 않았습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция өчүрүлгөндүктөн, өзгөртүүлөр сакталган жок"
          }
        },
        "nl": {
          "stringUnit": {
