    "entry.minBalance.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank hesabda bu qədər vəsait saxlamağı tələb edir. Yenə də əməliyyatı qeyd edə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк просіць захоўваць гэтую суму на рахунку. Вы ўсё адно можаце запісаць аперацыю."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka požaduje tuto částku ponechat na účtu. Operaci přesto můžete zaznamenat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank verlangt, dass auf dem Konto mindestens so viel bleibt. Verboten ist nichts: Sie können es trotzdem erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank asks to keep this much on the account. Nothing is forbidden: you can record it all the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco pide mantener esta cantidad en la cuenta. Nada está prohibido: puede registrarlo igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque demande de garder ce montant sur le compte. Rien n'est interdit : vous pouvez tout de même noter."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկը պահանջում է այս գումարը պահել հաշվում։ Կարող եք, այնուամենայնիվ, գրանցել գործարքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca richiede di mantenere questo importo sul conto. Puoi comunque registrare l'operazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行は口座にこの金額を残すよう求めています。そのまま記録することもできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკი ითხოვს ამ თანხის ანგარიშზე შენარჩუნებას. ჩაწერა მაინც შეგიძლიათ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк есеп-шотта осыншама ақша ұстауды сұрайды. Тыйым салынбайды: соған қарамастан жаза аласыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행에서 계좌에 이 금액을 유지하도록 요구합니다. 그래도 기록할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк эсепте ушул сумманы калтырууну талап кылат. Баары бир жазсаңыз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bank vraagt dit bedrag op de rekening te laten staan. Je kunt de transactie toch invoeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank wymaga utrzymania tej kwoty na koncie. Nadal możesz zapisać operację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco pede que este valor seja mantido na conta. Você ainda pode registrar a operação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco pede que mantenha este valor na conta. Pode registar a operação na mesma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк просит держать на счёте не меньше. Ничего не запрещено: можно записать всё равно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк талаб мекунад, ки ин маблағ дар ҳисоб бимонад. Шумо метавонед амалиётро ба ҳар ҳол сабт кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka, hesapta bu tutarın tutulmasını istiyor. İşlemi yine de kaydedebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк просить залишати цю суму на рахунку. Заборони немає: операцію все одно можна записати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank hisobda shu miqdorni saqlashni so‘raydi. Amalni baribir kiritishingiz mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行要求账户保留此金额。你仍可继续记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行要求帳戶保留此金額。你仍可記錄這筆交易。"
          }
        }
      }
    },
