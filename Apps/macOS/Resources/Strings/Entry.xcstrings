    "moneyBack.owesOnDebt": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Неаплачаных частак за гэтага чалавека няма, але ён мае перад вамі доўг. Гэтыя грошы — вяртанне доўгу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts für diese Person Bezahltes wartet, aber sie schuldet Ihnen aus einer Schuld. Das Geld ist eine Rückzahlung dieser Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing paid for this person is waiting, but they owe you on a debt. The money is a repayment of that debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada pagado por esta persona pendiente, pero le debe en una deuda. El dinero es la devolución de esa deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien payé pour cette personne n'attend, mais elle vous doit sur une dette. L'argent est un remboursement de cette dette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono importi pagati per questa persona in attesa di rimborso, ma ha un debito con te. Il denaro rimborsa quel debito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл адам үшін төленген ешбір нәрсе күтпейді, бірақ ол сізге берешек бойынша қарыз. Ақша сол берешекті қайтару болып табылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma oczekujących wydatków za tę osobę, ale ma ona wobec Ciebie dług. Te pieniądze są jego spłatą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há valores pagos por essa pessoa aguardando reembolso, mas ela tem uma dívida com você. O dinheiro é um pagamento dessa dívida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За этого человека ничего не ждёт возврата, но он должен вам по долгу. Эти деньги — возврат долга."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişi için ödenmiş ve bekleyen bir tutar yok, ancak size borcu var. Gelen para bu borcun ödemesidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає частин, оплачених за цю людину, що очікують повернення, але є її борг. Ці гроші — погашення того боргу."
          }
        }
      }
    },
