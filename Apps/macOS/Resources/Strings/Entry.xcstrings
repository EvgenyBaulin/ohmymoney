        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Toifa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类别"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "類別"
          }
        }
      }
    },
    "entry.closedPart": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hissə üçün pul qaytarılıb — məbləği dəyişmək üçün əvvəlcə geri ödənişi silin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэтую частку ўжо вярнулі грошы — каб змяніць суму, спачатку выдаліце кампенсацыю"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za tuto část už byly vráceny peníze — chcete-li změnit její částku, nejprve smažte vrácení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Teil wurde Geld zurückgegeben — um seinen Betrag zu ändern, löschen Sie zuerst die Rückzahlung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money came back for this part — to change its amount, delete the reimbursement first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por esta parte se devolvió dinero — para cambiar su importe, elimine antes la devolución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l'argent est revenu pour cette part — pour changer son montant, supprimez d'abord le remboursement"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս մասի գումարը վերադարձվել է․ գումարը փոխելու համար նախ ջնջեք փոխհատուցումը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa parte è già stata rimborsata: per modificarne l’importo, elimina prima il rimborso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は返金済みです。金額を変更するには、先に返金を削除してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ნაწილის თანხა დაბრუნებულია — თანხის შესაცვლელად ჯერ წაშალეთ ანაზღაურება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл бөлік үшін ақша қайтарылған — оның сомасын өзгерту үшін алдымен қайтаруды жойыңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목에 대해 이미 환급받았습니다. 금액을 변경하려면 먼저 환급을 삭제하세요"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул бөлүк үчүн акча кайтарылган — суммасын өзгөртүү үчүн адегенде кайтарымды өчүрүңүз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor dit onderdeel is geld terugbetaald. Verwijder eerst de terugbetaling om het bedrag te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrócono pieniądze za tę część — aby zmienić jej kwotę, najpierw usuń zwrot"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor desta parte foi reembolsado — para alterá-lo, apague o reembolso primeiro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta parte já foi reembolsada — para alterar o montante, apague primeiro o reembolso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За эту часть деньги вернули — чтобы изменить сумму, сначала удалите возврат"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ин қисм баргардонда шудааст — барои тағйири он аввал ҷубронро нест кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parça için para iade edildi — tutarını değiştirmek için önce geri ödemeyi silin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цю частину вже повернули гроші — щоб змінити суму, спочатку видаліть повернення грошей"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qism uchun pul qaytarilgan — summani o‘zgartirish uchun avval qaytarimni o‘chiring"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此部分已收到退款。如需更改金额，请先删除退款记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此部分已有退款；若要更改金額，請先刪除退款"
          }
        }
      }
    },
    "entry.closesTerm": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay daha ödəniş yoxdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш плацяжоў у гэтым месяцы не будзе"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento měsíc už žádné splátky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine weiteren Zahlungen in diesem Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more payments this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No habrá más pagos este mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de paiements ce mois-ci"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս այլ վճարումներ չկան"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro pagamento questo mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の支払いはこれで完了"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში გადახდები აღარ იქნება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда басқа төлем жоқ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 추가 결제 없음"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда башка төлөм жок"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze maand geen betalingen meer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez dalszych płatności w tym miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem mais pagamentos neste mês"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem mais pagamentos este mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце больше платежей не будет"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин моҳ пардохти дигар нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay başka ödeme yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього місяця більше платежів немає"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy boshqa to‘lov yo‘q"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月无需再付款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月不再付款"
          }
        }
      }
    },
    "entry.closesTerm.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödəniş aylıq məbləğdən az olsa da, bu borcun aylıq ödənişi ödənilmiş sayılır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж па гэтым доўгу лічыцца ўнесеным, хоць ён меншы за штомесячны"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Splátka tohoto dluhu se počítá jako uhrazená, i když je platba nižší než měsíční splátka"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fälligkeit dieser Schuld gilt als bezahlt, auch wenn die Zahlung kleiner ist als die monatliche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The due of this debt counts as paid although the payment is smaller than the monthly one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vencimiento de esta deuda cuenta como pagado aunque el pago sea menor que el mensual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'échéance de cette dette compte comme payée, bien que le paiement soit plus petit que la mensualité"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պարտքի այս ամսվա վճարումը կհամարվի կատարված, թեև գումարը ամսական վճարումից փոքր է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rata di questo debito viene considerata pagata anche se il pagamento è inferiore all’importo mensile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月の支払額より少なくても、今月の返済は完了として扱われます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალის ამ თვის გადასახადი დაფარულად ჩაითვლება, მიუხედავად იმისა, რომ გადახდა ყოველთვიურ თანხაზე ნაკლებია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл берешектің міндеттемесі төленген деп саналады, төлем айлықтан кіші болса да"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 금액이 월 납입액보다 적더라도 이번 달 채무를 납부한 것으로 처리합니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлөм айлык төлөмдөн аз болсо да, бул карыздын мөөнөттүү төлөмү төлөндү деп эсептелет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De termijn van deze schuld geldt als betaald, ook al is de betaling lager dan het maandbedrag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rata długu zostanie uznana za zapłaconą, choć płatność jest niższa od miesięcznej raty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parcela desta dívida é considerada paga, mesmo que o pagamento seja menor que o valor mensal"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A prestação desta dívida é considerada paga, embora o pagamento seja inferior ao valor mensal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок по этому долгу будет считаться оплаченным, хотя платёж меньше ежемесячного"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пардохти ин қарз иҷрошуда ҳисоб мешавад, гарчанде маблағаш аз пардохти моҳона камтар аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme aylık tutardan az olsa da bu borcun taksiti ödenmiş sayılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж за цим боргом вважається внесеним, хоча сума менша за щомісячний платіж"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘lov oylik summadan kam bo‘lsa ham, bu qarzning to‘lovi to‘langan deb hisoblanadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使付款金额低于月供，此债务的本月应付款也会标记为已付"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使付款金額低於每月應付金額，此債務的本期款項仍視為已付清"
          }
        }
      }
    },
    "entry.creditInDebts": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditlə alınıb — Borclar bölməsində dəyişdirilib"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Набыта ў крэдыт — змяняецца ў раздзеле даўгоў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koupeno na úvěr — upravuje se v Dluzích"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Kredit gekauft — geändert unter „Schulden“"
