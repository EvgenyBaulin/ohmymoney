    "moneyBack.purchaseRate.caption": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ паводле гэтага курсу — %2$@. Купля запісваецца паводле яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zu diesem Kurs sind %2$@. Der Kauf wird zu diesem Kurs erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ at this rate is %2$@. The purchase is recorded at it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a este tipo son %2$@. La compra se registra con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ à ce taux font %2$@. L'achat est noté à ce taux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a questo tasso corrisponde a %2$@. L’acquisto è registrato a questo tasso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы бағам бойынша %1$@ — %2$@. Сатып алу осы бағаммен жазылған."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ po tym kursie to %2$@. Zakup zostanie zapisany po tym kursie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a essa cotação equivale a %2$@. A compra é lançada com essa cotação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ по этому курсу — %2$@. Покупка будет записана по нему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bu kurla %2$@ eder. Satın alma bu kurla kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ за цим курсом — %2$@. Покупку записано за ним."
          }
        }
      }
    },
    "moneyBack.purchaseRate.provisional": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс куплі яшчэ папярэдні: увядзіце курс з выпіскі, каб закрыць частку зараз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
