    "entry.accountCharge.check": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charged to account was not recalculated — check it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cargo en la cuenta no se recalculó: compruébelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le débit du compte n'a pas été recalculé — vérifiez-le"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списано со счёта не пересчитано — проверьте"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
