        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Części mają różne kategorie — ustaw regułę w zasadach cashbacku konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes têm categorias diferentes — defina a regra em Regras de Cashback da conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
