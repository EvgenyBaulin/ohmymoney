    "entry.beforeCount.dontAsk": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш не пытацца для гэтай зверкі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Abgleich nicht mehr fragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask again for this reconciliation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non chiedere più per questa riconciliazione"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы салыстыру үшін енді сұрама"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не спрашивать для этой сверки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не запитувати для цієї звірки"
          }
        }
      }
    },
    "entry.beforeCount.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэты дзень рахунак быў звераны. Калі аперацыя адбылася да зверкі, яе сума ўжо ўлічана ў звераным балансе: зменіцца розніца зверкі, а не баланс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wurde an diesem Tag abgeglichen. Wenn der Vorgang davor lag, steckt sein Geld bereits im abgeglichenen Saldo: Es ändert sich die Differenz des Abgleichs, nicht der Saldo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account was reconciled that day. If the operation happened before that, its money is already in the reconciled balance: the reconciliation's difference changes, not the balance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo conto è stato riconciliato quel giorno. Se l’operazione è avvenuta prima, l’importo è già incluso nel saldo riconciliato: cambia la differenza della riconciliazione, non il saldo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шот сол күні салыстырылған. Егер операция одан бұрын болса, оның ақшасы салыстырылған теңгерімде бар: өзгеретіні — салыстырудың айырмасы, теңгерім емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день счёт сверяли. Если операция прошла до сверки, её деньги уже в сверенном остатке: изменится разница сверки, а не остаток."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього дня рахунок звіряли. Якщо операція була раніше, її гроші вже входять у звірений залишок: зміниться різниця звірки, а не залишок."
          }
        }
      }
    },
