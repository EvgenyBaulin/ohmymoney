    "entry.transfer.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesablararası köçürməni burada qeydə alın: bu formadakı məbləğ, hesab və tarix köçürməyə keçiriləcək"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перавод з рахунку на рахунак: сума, рахунак і дата з гэтай формы перанясуцца ў яго"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Převod mezi účty zapsaný přímo zde: částka, účet a datum se převezmou z tohoto formuláře"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Überweisung von Konto zu Konto, hier erfasst: Betrag, Konto und Datum dieses Formulars werden in sie übernommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer from account to account, written right here: the amount, the account and the date of this form carry over to it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transferencia de cuenta a cuenta, anotada aquí mismo: el importe, la cuenta y la fecha de este formulario pasan a ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un virement d'un compte à un autre, noté ici : le montant, le compte et la date de ce formulaire lui sont repris"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխանցում հաշիվների միջև․ այս ձևի գումարը, հաշիվը և ամսաթիվը կփոխանցվեն դրան"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trasferimento tra conti, registrato qui: importo, conto e data di questo modulo verranno riportati nel trasferimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここから口座間の振替を記録します。この画面の金額、口座、日付が引き継がれます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშებს შორის გადარიცხვა აქვე ჩაიწერება: ამ ფორმის თანხა, ანგარიში და თარიღი გადარიცხვაში გადავა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттан есеп-шотқа аударым, осы жерде жазылады: осы форманың сомасы, есеп-шоты және күні соған көшеді"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 계좌 간 이체를 기록합니다. 이 양식의 금액, 계좌, 날짜가 이체에 적용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептер ортосундагы которуу ушул жерден жазылат: бул формадагы сумма, эсеп жана күн которууга өтөт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg hier een overboeking tussen rekeningen vast. Het bedrag, de rekening en de datum van dit formulier worden overgenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelew między kontami zapisany tutaj: kwota, konto i data z tego formularza zostaną przeniesione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma transferência entre contas, lançada aqui: o valor, a conta e a data deste formulário serão usados nela"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
