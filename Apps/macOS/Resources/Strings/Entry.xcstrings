          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente uma despesa pode ser comprada a crédito"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível comprar uma despesa a crédito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В кредит можно записать только расход"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо хароҷотро ба қарз харидан мумкин аст"
          }
        },
        "tr": {
