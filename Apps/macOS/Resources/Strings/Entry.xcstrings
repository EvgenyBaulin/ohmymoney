    "reimbursement.moneyRateProvisional": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк яшчэ не апублікаваў курс на гэты дзень. Увядзіце курс валюты або запішыце пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat den Kurs dieses Tages noch nicht veröffentlicht. Tragen Sie den Kurs des Geldes ein oder erfassen Sie es später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank has not published the rate of this day yet. Type the rate of the money, or record it later."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca non ha ancora pubblicato il tasso di questo giorno. Inserisci il tasso del rimborso o registralo più tardi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк бұл күннің бағамын әлі жарияламаған. Ақшаның бағамын теріңіз, не ақшаны кейін жазыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ещё не опубликовал курс этого дня. Введите курс возврата или запишите позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ще не опублікував курс за цей день. Введіть курс отриманих грошей або запишіть пізніше."
          }
        }
      }
    },
    "reimbursement.noSurcharges": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вярнулася больш, чым каштавалі долі, а катэгорыі для даплаты няма. Нічога не запісана: увядзіце суму не большую за кошт доляў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kam mehr zurück, als die Teile gekostet haben, und es gibt keine Kategorie „Aufschläge“ für die Differenz. Nichts wurde erfasst: Tragen Sie nicht mehr ein, als die Teile gekostet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More came back than the parts cost, and there is no Surcharges category for the difference. Nothing was recorded: enter no more than the parts cost."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rimborso supera il costo delle quote e non esiste una categoria Supplementi per la differenza. Non è stato registrato nulla: inserisci al massimo il costo delle quote."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөліктердің құнынан артық қайтты, ал айырма үшін «Үстемақылар» санаты жоқ. Ештеңе жазылмады: бөліктердің құнынан артық енгізбеңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернули больше, чем стоили части, а категории «Доплаты» для разницы нет. Ничего не записано: введите сумму не больше стоимости частей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернулося більше, ніж коштували частини, а категорії «Доплати» для різниці немає. Нічого не записано: введіть не більше вартості частин."
          }
        }
      }
    },
    "reimbursement.partGone": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбраная доля больш не чакае вяртання грошай: пакупку выдалілі або долю спісалі ці закрылі. Спіс абноўлены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gewählter Teil wartet nicht mehr auf sein Geld — sein Kauf wurde gelöscht, oder der Teil wurde abgeschrieben oder beendet. Die Liste wurde aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chosen part is no longer waiting for its money — its purchase was deleted, or the part was written off or closed. The list has been refreshed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una quota selezionata non è più in attesa di rimborso: l'acquisto è stato eliminato oppure la quota è stata stornata o chiusa. L'elenco è stato aggiornato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған бөлік енді ақшасын күтпейді — оның сатып алуы жойылған, не бөлік есептен шығарылған немесе жабылған. Тізім жаңартылды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная часть больше не ожидает возврата — покупку удалили, часть списали или уже закрыли. Список обновлён."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана частина більше не очікує грошей: покупку видалено, частину списано або закрито. Список оновлено."
          }
        }
      }
    },
