    "moneyBack.purchaseRate.caption": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu məzənnə ilə %1$@ — %2$@ edir. Alış bu məzənnə ilə qeydə alınır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ паводле гэтага курсу — %2$@. Купля запісваецца паводле яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ při tomto kurzu odpovídá %2$@. Nákup se zapíše s tímto kurzem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zu diesem Kurs sind %2$@. Der Kauf wird zu diesem Kurs erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ at this rate is %2$@. The purchase is recorded at it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a este tipo son %2$@. La compra se registra con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ à ce taux font %2$@. L'achat est noté à ce taux."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ն այս փոխարժեքով %2$@ է։ Գնումը գրանցվում է այս փոխարժեքով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a questo tasso corrisponde a %2$@. L’acquisto è registrato a questo tasso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレートでは%1$@は%2$@です。購入はこのレートで記録されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ამ კურსით არის %2$@. შენაძენი ამ კურსით ჩაიწერება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы бағам бойынша %1$@ — %2$@. Сатып алу осы бағаммен жазылған."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환율로 계산한 %1$@은(는) %2$@입니다. 구매에 이 환율이 적용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ бул курс менен %2$@ болот. Сатып алуу ушул курс менен жазылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is tegen deze koers %2$@. De aankoop wordt tegen deze koers vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ po tym kursie to %2$@. Zakup zostanie zapisany po tym kursie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a essa cotação equivale a %2$@. A compra é lançada com essa cotação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a esta taxa corresponde a %2$@. A compra é registada com esta taxa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ по этому курсу — %2$@. Покупка будет записана по нему."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ бо ин қурб баробари %2$@ аст. Харид бо ҳамин қурб сабт мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bu kurla %2$@ eder. Satın alma bu kurla kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ за цим курсом — %2$@. Покупку записано за ним."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bu kursda %2$@ ga teng. Xarid shu kursda yoziladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 按此汇率折合 %2$@。购买将按此汇率记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 按此匯率換算為 %2$@。購買項目將按此匯率記錄。"
          }
        }
      }
    },
    "moneyBack.purchaseRate.provisional": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alış məzənnəsi hələ müvəqqətidir: çıxarışdakı məzənnəni daxil edin və hissə dərhal bağlansın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс куплі яшчэ папярэдні: увядзіце курс з выпіскі, каб закрыць частку зараз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz nákupu je zatím předběžný: zadejte kurz z výpisu a část se vyrovná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurs des Kaufs ist noch vorläufig: Tragen Sie den Kurs aus der Abrechnung ein, dann ist der Teil jetzt beglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase rate is still provisional: type the rate from the statement and the part closes now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de la compra todavía es provisional: escriba el tipo del extracto y la parte se cierra ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux de l'achat est encore provisoire : saisissez le taux du relevé et la part se clôt maintenant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գնման փոխարժեքը դեռ ժամանակավոր է․ մուտքագրեք քաղվածքի փոխարժեքը, և մասը կփակվի հիմա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso dell’acquisto è ancora provvisorio: inserisci quello dell’estratto conto per saldare subito la parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入時のレートはまだ仮です。明細のレートを入力すると、この分が精算されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენაძენის კურსი ჯერ დროებითია: შეიყვანეთ კურსი ამონაწერიდან და ნაწილი ახლავე დაიფარება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алу бағамы әлі уақытша: үзіндідегі бағамды теріңіз — бөлік дәл қазір жабылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 환율이 아직 잠정 환율입니다. 명세서의 환율을 입력하면 지금 정산됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алуунун курсу азырынча убактылуу: көчүрмөдөгү курсту киргизсеңиз, бөлүк азыр жабылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoopkoers is nog voorlopig: voer de koers van het afschrift in om het deel nu te voldoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs zakupu jest jeszcze tymczasowy: wpisz kurs z wyciągu, aby rozliczyć tę część."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cotação da compra ainda é provisória: informe a cotação do extrato para quitar a parte agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de câmbio da compra ainda é provisória: indique a taxa do extrato para liquidar a parte agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс покупки ещё предварительный: впишите курс из выписки, и часть закроется сейчас."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби харид ҳанӯз муваққатист: қурби иқтибосро ворид кунед ва қисм ҳозир пӯшида мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma kuru hâlâ geçici: ekstreden kuru girin, ilgili tutar hemen kapansın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс покупки ще попередній: введіть курс із виписки, і частину буде закрито зараз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarid kursi hali vaqtinchalik: ko‘chirmadagi kursni kiriting, shunda qism hozir yopiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买汇率仍为暂定：输入账单上的汇率即可结清此部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買匯率尚未確定：輸入帳單上的匯率即可結清此分攤。"
          }
        }
      }
    },
