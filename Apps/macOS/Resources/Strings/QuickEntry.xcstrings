    "quick.repeat.left": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəziləri buraxıldı: onlar üçün hələ məzənnə yoxdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Некаторыя аперацыі прапушчаны: для іх яшчэ няма курсу валют"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige wurden ausgelassen: dafür gibt es noch keinen Kurs"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some were left out: no exchange rate for them yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas se dejaron fuera: todavía no tienen tipo de cambio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines ont été laissées de côté : pas encore de taux de change pour elles"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որոշները բաց են թողնվել․ դրանց համար դեռ փոխարժեք չկա"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune operazioni sono state escluse: il tasso di cambio non è ancora disponibile"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზოგი გამოტოვებულია: მათთვის გაცვლითი კურსი ჯერ არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбірі шығарылды: оларға әлі айырбастау бағамы жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айрымдары калтырылды: алар үчүн валюта курсу азырынча жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre pominięto: brak dla nich kursu wymiany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas ficaram de fora: ainda não há cotação para elas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas ficaram de fora: ainda não há taxa de câmbio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть не записана: для неё пока нет курса"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баъзеҳо гузаронда шуданд: ҳоло қурби асъор барои онҳо нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazıları atlandı: henüz döviz kuru yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дещо не враховано: ще немає валютного курсу"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba’zilari o‘tkazib yuborildi: ular uchun hali kurs yo‘q"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分項目未記錄：尚無適用的匯率"
          }
