    "quick.move.month": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyat başqa aya köçürülür: limitlər və hesabatlar da dəyişəcək"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыя пераносіцца ў іншы месяц: ліміты і справаздачы зменяцца адпаведна"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wandert in einen anderen Monat: Limits und Berichte folgen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves to another month: limits and reports follow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa a otro mes: los límites y los informes se ajustan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle passe dans un autre mois : les plafonds et les rapports suivent"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարքը կտեղափոխվի այլ ամիս․ սահմանաչափերն ու հաշվետվությունները կփոխվեն"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'operazione passa a un altro mese: limiti e report verranno aggiornati"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაცია სხვა თვეში გადადის: შეიცვლება ლიმიტები და ანგარიშები"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа айға көшеді: лимиттер мен есептер соған ілеседі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Башка айга жылдырылат: чектөөлөр менен отчеттор да өзгөрөт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja zostanie przeniesiona do innego miesiąca i uwzględniona w jego limitach i raportach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação será movida para outro mês, junto com seus efeitos nos limites e relatórios"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao mover para outro mês, os limites e relatórios são atualizados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция уйдёт в другой месяц: лимиты и отчёты пересчитаются"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёт ба моҳи дигар мегузарад: маҳдудиятҳо ва ҳисоботҳо тағйир меёбанд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem başka bir aya taşınır; limitler ve raporlar buna göre güncellenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція переходить в інший місяць: ліміти й звіти зміняться відповідно"
          }
        },
        "uz": {
          "stringUnit": {
