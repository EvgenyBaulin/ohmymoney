    "quick.cardAsk.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank's texts name these digits. Which of your cards is it? The digits are kept on the card, not the number."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сообщениях банка стоят эти цифры. Какая это из ваших карт? Запоминаются только цифры, не номер."
          }
        }
      }
    },
    "quick.cardAsk.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not any of them"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна"
          }
        }
      }
    },
