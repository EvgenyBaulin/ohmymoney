    "quick.card.details.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free text: holder, expiry date. Never keep the code from the back of the card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободный текст: владелец, срок действия. Код с обратной стороны карты здесь не храните."
          }
        }
      }
