    "quick.split.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перацягніце падзельнік паміж часткамі; ён рухаецца з крокам 10."
          }
        },
