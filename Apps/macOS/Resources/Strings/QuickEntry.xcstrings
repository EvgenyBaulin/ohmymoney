    "quick.repeat.none": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма чаго паўтараць: у той дзень вы не ўводзілі выдаткі ўручную"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu wiederholen: An diesem Tag wurden keine Ausgaben von Hand erfasst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to repeat: no spending of yours was entered by hand that day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que repetir: ese día no se introdujo a mano ningún gasto suyo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à répéter : aucune dépense saisie à la main ce jour-là"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da ripetere: quel giorno non hai inserito spese a mano"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайталайтын ештеңе жоқ: сол күні сіз қолмен енгізген шығын болмаған"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего повторять: своих расходов, записанных руками, за тот день нет"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає що повторити: цього дня ви не вводили власних витрат вручну"
          }
        }
      }
    },
    "quick.repeat.subtitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
