    "quick.cardAsk.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank mətnlərində bu rəqəmlər göstərilib. Bu, kartlarınızdan hansıdır? Nömrə deyil, rəqəmlər kartda saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У тэкстах банка пазначаны гэтыя лічбы. Якая гэта з вашых карт? На карце захоўваюцца толькі гэтыя лічбы, а не нумар."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Texte der Bank nennen diese Ziffern. Welche Ihrer Karten ist es? Gespeichert werden die Ziffern auf der Karte, nicht die Nummer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank's texts name these digits. Which of your cards is it? The digits are kept on the card, not the number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los textos del banco citan estas cifras. ¿Cuál de sus tarjetas es? Se guardan las cifras en la tarjeta, no el número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes de la banque nomment ces chiffres. Laquelle de vos cartes est-ce ? Seuls les chiffres sont gardés sur la carte, pas le numéro."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս թվանշանները նշված են բանկի հաղորդագրություններում։ Ձեր ո՞ր քարտին են պատկանում։ Պահվում են միայն թվանշանները, ոչ թե քարտի համարը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I testi della banca riportano queste cifre. A quale delle tue carte appartengono? Sulla carta vengono salvate le cifre, non il numero."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ციფრები ბანკის ტექსტებშია მითითებული. რომელ თქვენს ბარათს ეკუთვნის? ბარათზე მხოლოდ ციფრები ინახება და არა ნომერი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк мәтіндерінде осы цифрлар аталған. Бұл сіздің қай картаңыз? Сақталатыны — цифрлар, нөмір емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын тексттеринде ушул сандар көрсөтүлгөн. Бул сиздин кайсы картаңыз? Картанын номери эмес, ушул сандар сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te cyfry pojawiają się w wiadomościach banku. Której z Twoich kart dotyczą? Cyfry są zapisywane przy karcie, ale nie jej numer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens do banco indicam estes dígitos. Qual dos seus cartões é este? Apenas os dígitos são salvos no cartão, não o número."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens do banco indicam estes dígitos. A qual dos seus cartões pertencem? Os dígitos são guardados no cartão, mas não o número completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сообщениях банка стоят эти цифры. Какая это из ваших карт? Запоминаются только цифры, не номер."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар матнҳои бонк ин рақамҳо омадаанд. Ин кадом корти шумост? Рақамҳо дар маълумоти корт нигоҳ дошта мешаванд, на рақами пурра."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka metinlerinde bu rakamlar geçiyor. Kartlarınızdan hangisi? Kartta numaranın tamamı değil, bu rakamlar saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У текстах банку є ці цифри. Яка це ваша картка? На картці зберігаються лише цифри, а не номер."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank matnlarida shu raqamlar ko‘rsatilgan. Bu qaysi kartangiz? Kartada to‘liq raqam emas, shu raqamlar saqlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行訊息中有這幾位數字。這是哪張卡片？只會儲存這幾位數字，不會儲存卡號。"
          }
        }
      }
    },
