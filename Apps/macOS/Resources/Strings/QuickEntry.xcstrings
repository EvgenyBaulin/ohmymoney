    "quick.correction.refused.moneyBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money back from a person cannot change its amount: delete it and enter it again"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат денег от человека нельзя изменить: удалите его и запишите заново"
          }
        }
      }
    },
    "quick.correction.refused.parts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something in this operation was returned or paid back: change it in the ↓ panel"
