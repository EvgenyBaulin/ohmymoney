    "quick.card.last4.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дапамагае праграме знаходзіць гэту карту ў тэкстах банка. Гэта не нумар карты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt die App diese Karte in den Texten der Bank finden. Nicht die Kartennummer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the app find this card in the bank's texts. Not the card number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a la app encontrar esta tarjeta en los textos del banco. No es el número de la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
