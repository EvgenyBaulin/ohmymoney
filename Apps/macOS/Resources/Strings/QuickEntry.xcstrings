    "quick.bank.reconcile": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрыць зверку пасля запісу (паводле тэксту засталося %@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Schreiben den Abgleich öffnen (der Text sagt, dass %@ übrig ist)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the reconciliation after writing (the text says %@ is left)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir la conciliación tras escribir (el texto dice que quedan %@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le rapprochement après l'écriture (le texte indique qu'il reste %@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la riconciliazione dopo la registrazione (il testo indica un saldo di %@)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазғаннан кейін салыстыруды ашу (мәтінде %@ қалғаны айтылған)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть сверку после записи (в сообщении остаток %@)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити звірку після запису (у тексті залишок %@)"
          }
        }
      }
    },
    "quick.bills.categoryNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тое, што гісторыя і мадэль не могуць размеркаваць, трапіць у «Не памятаю»; пазней гэта можна змяніць у спісе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der Verlauf und das Modell nicht einordnen können, geht zu „Nicht erinnert“; ändern Sie es später in der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the history and the model cannot file goes to «Don't remember»; change it later in the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el historial y el modelo no pueden clasificar va a «No recuerdo»; cámbielo después en la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l'historique et le modèle ne peuvent pas classer va dans « Je ne sais plus » ; changez-le plus tard dans la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che la cronologia e il modello non riescono a classificare va in «Non ricordo»; puoi cambiarlo in seguito nell'elenco."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарих пен үлгі санатқа жатқыза алмағанның бәрі «Есімде жоқ» болады; оны кейін тізімде өзгертуге болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что история и модель не смогли разложить, попадает в «Не помню»; потом это можно поправить в списке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що історія та модель не змогли визначити, потрапить у «Не пам'ятаю»; змініть пізніше в списку."
          }
        }
      }
    },
