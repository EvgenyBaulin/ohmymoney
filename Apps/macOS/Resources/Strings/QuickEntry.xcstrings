    "quick.card.last4.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqə bu kartı bank mətnlərində tapmağa kömək edir. Kart nömrəsi deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дапамагае праграме знаходзіць гэту карту ў тэкстах банка. Гэта не нумар карты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt die App diese Karte in den Texten der Bank finden. Nicht die Kartennummer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the app find this card in the bank's texts. Not the card number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a la app encontrar esta tarjeta en los textos del banco. No es el número de la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à l'app de retrouver cette carte dans les textes de la banque. Ce n'est pas le numéro de carte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգնում է հավելվածին գտնել այս քարտը բանկի հաղորդագրություններում։ Քարտի համարը չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette all'app di trovare questa carta nei testi della banca. Non è il numero della carta."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპს ეხმარება ბარათის პოვნაში ბანკის ტექსტებში. ეს ბარათის ნომერი არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба банк мәтіндерінде осы картаны таниды. Карта нөмірі емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмого бул картаны банктын тексттеринен табууга жардам берет. Бул картанын номери эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala znaleźć tę kartę w wiadomościach banku. To nie jest numer karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite encontrar este cartão nas mensagens do banco. Não é o número do cartão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite encontrar este cartão nas mensagens do banco. Não é o número do cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По ним приложение находит карту в сообщениях банка. Это не номер карты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома бо ин рақамҳо кортро дар матнҳои бонк меёбад. Ин рақами корт нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın bu kartı banka metinlerinde bulmasını sağlar. Kart numarası değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допомагає знайти картку в текстах банку. Це не номер картки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova kartani bank matnlaridan topishi uchun kerak. Bu karta raqami emas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 App 在銀行訊息中辨識這張卡片，並非卡號。"
          }
        }
      }
    },
