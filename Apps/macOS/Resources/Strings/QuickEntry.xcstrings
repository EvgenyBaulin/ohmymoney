            "value": "Платіж за боргом змінюється на екрані самого боргу"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarz to‘lovi qarzning o‘z sahifasida o‘zgartiriladi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在債務畫面中更改還款"
          }
        }
      }
    },
    "quick.correction.refused.moneyBack": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şəxsdən geri alınan pulun məbləğini dəyişmək olmur: onu silib yenidən daxil edin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Суму вяртання грошай ад чалавека нельга змяніць: выдаліце запіс і ўвядзіце яго зноў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld zurück von einer Person kann seinen Betrag nicht ändern: Löschen Sie es und erfassen Sie es erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money back from a person cannot change its amount: delete it and enter it again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero devuelto por una persona no puede cambiar de importe: elimínelo y vuelva a introducirlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent rendu par une personne ne peut pas changer de montant : supprimez-le et saisissez-le à nouveau"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անձից վերադարձված գումարը փոխել հնարավոր չէ․ ջնջեք և կրկին մուտքագրեք"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi modificare l'importo di un rimborso ricevuto da una persona: eliminalo e inseriscilo di nuovo"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პირისგან დაბრუნებული თანხის შეცვლა შეუძლებელია: წაშალეთ და ხელახლა შეიყვანეთ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адамнан қайтарылған ақшаның сомасын өзгертуге болмайды: оны жойып, қайта енгізіңіз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адамдан кайтарылган акчанын суммасын өзгөртүү мүмкүн эмес: өчүрүп, кайра киргизиңиз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zmienić kwoty zwrotu od osoby: usuń go i wprowadź ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível alterar o valor de uma devolução de uma pessoa: apague e registre novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível alterar o valor devolvido por uma pessoa: apague-o e registe-o novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат денег от человека нельзя изменить: удалите его и запишите заново"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи аз шахс баргардондашударо тағйир додан мумкин нест: онро нест карда, аз нав ворид кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kişiden geri alınan paranın tutarı değiştirilemez: silip yeniden girin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна змінити суму повернення грошей від людини: видаліть і введіть знову"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odamdan qaytarilgan pul summasini o‘zgartirib bo‘lmaydi: uni o‘chirib, qayta kiriting"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更改他人退款的金額：請刪除後重新輸入"
          }
        }
      }
    },
    "quick.correction.refused.parts": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu əməliyyatın bir hissəsi qaytarılıb və ya ödənilib: onu ↓ panelində dəyişin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Частка гэтай аперацыі была вернута або выплачана: змяніце яе на панэлі ↓"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas an diesem Vorgang wurde zurückgegeben oder erstattet: Ändern Sie es im Bedienfeld ↓"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something in this operation was returned or paid back: change it in the ↓ panel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo de esta operación se devolvió o se pagó: cámbielo en el panel ↓"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de cette opération a été rendue ou remboursée : modifiez-la dans le panneau ↓"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գործարքի գումարի մի մասը վերադարձվել կամ հետ է վճարվել․ փոխեք այն ↓ վահանակում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte di questa operazione è stata restituita o rimborsata: modificala nel pannello ↓"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ოპერაციის ნაწილი დაბრუნებულია ან გადახდილია: შეცვალეთ ↓ პანელში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл операцияның бір бөлігі қайтарылған немесе қайтарылған: ↓ панельде өзгертіңіз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул операциянын бир бөлүгү кайтарылган же төлөнгөн: аны ↓ панелинде өзгөртүңүз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część tej operacji została zwrócona lub spłacona: zmień ją w panelu ↓"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte desta operação foi devolvida ou reembolsada: altere no painel ↓"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte desta operação foi devolvida ou reembolsada: altere-a no painel ↓"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть этой операции уже возвращена или погашена: измените её в панели ↓"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қисме аз ин амалиёт баргардонда ё пардохт шудааст: онро дар панели ↓ тағйир диҳед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemin bir kısmı iade edildi veya geri ödendi: ↓ panelinde değiştirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частину цієї операції вже повернули або відшкодували: змініть на панелі ↓"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu operatsiyaning bir qismi qaytarilgan yoki to‘langan: uni ↓ panelida o‘zgartiring"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此交易的部分金額已退還或償還：請在下方 ↓ 面板更改"
          }
        }
      }
    },
    "quick.correction.refused.rate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni məbləği hesablamaq üçün əməliyyatın məzənnəsi yoxdur: onu ↓ panelində dəyişin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У аперацыі няма курсу для разліку новай сумы: змяніце яе на панэлі ↓"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang hat keinen Kurs, nach dem der neue Betrag bewertet werden könnte: Ändern Sie ihn im Bedienfeld ↓"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation has no rate to price the new amount by: change it in the ↓ panel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación no tiene tipo con el que valorar el nuevo importe: cámbiela en el panel ↓"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération n'a pas de taux pour valoriser le nouveau montant : modifiez-la dans le panneau ↓"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարքը նոր գումարը հաշվարկելու փոխարժեք չունի․ փոխեք այն ↓ վահանակում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'operazione non ha un tasso di cambio per calcolare il nuovo importo: modificala nel pannello ↓"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალი თანხის გამოსათვლელად ოპერაციას კურსი არ აქვს: შეცვალეთ ↓ პანელში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцияда жаңа соманы санайтын бағам жоқ: ↓ панельде өзгертіңіз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңы сумманы эсептөө үчүн операцияда курс жок: аны ↓ панелинде өзгөртүңүз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja nie ma kursu do przeliczenia nowej kwoty: zmień ją w panelu ↓"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação não tem cotação para calcular o novo valor: altere no painel ↓"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação não tem uma taxa para calcular o novo valor: altere-a no painel ↓"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У операции нет курса для новой суммы: измените её в панели ↓"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ҳисоб кардани маблағи нав қурб мавҷуд нест: онро дар панели ↓ тағйир диҳед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni tutarı hesaplamak için işlemin kuru yok: ↓ panelinde değiştirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В операції немає курсу для нової суми: змініть на панелі ↓"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi summani hisoblash uchun operatsiyada kurs yo‘q: uni ↓ panelida o‘zgartiring"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此交易沒有可用來計算新金額的匯率：請在下方 ↓ 面板更改"
          }
        }
      }
    },
    "quick.correction.stale": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son qeyd, %@, bir saatdan çox əvvəl edilib: %@ → %@. O düzəldilsin?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апошні запіс, %@, зроблены больш за гадзіну таму: %@ → %@. Выправіць яго?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Eintrag, %@, wurde vor über einer Stunde gemacht: %@ → %@. Diesen korrigieren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last entry, %@, was made over an hour ago: %@ → %@. Correct that one?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último apunte, %1$@, se hizo hace más de una hora: %2$@ → %3$@. ¿Corregir ese?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière saisie, %@, a été faite il y a plus d'une heure : %@ → %@. Corriger celle-là ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին գրառումը՝ %@, կատարվել է ավելի քան մեկ ժամ առաջ՝ %@ → %@։ Ուղղե՞լ այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima operazione, %@, è stata registrata più di un'ora fa: %@ → %@. Vuoi correggerla?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო ჩანაწერი, %@, საათზე მეტი ხნის წინ გაკეთდა: %@ → %@. შესწორდეს?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы жазба, %1$@, сағаттан көп бұрын жасалған: %2$@ → %3$@. Соны түзетейін бе?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы жазуу, %@, бир сааттан ашык мурун жасалган: %@ → %@. Аны оңдойсузбу?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni wpis, %@, dodano ponad godzinę temu: %@ → %@. Poprawić go?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O último lançamento, %@, foi feito há mais de uma hora: %@ → %@. Corrigir?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O último registo, %@, foi feito há mais de uma hora: %@ → %@. Corrigir esse registo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя запись, %@, сделана больше часа назад: %@ → %@. Исправить её?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сабти охирин, %@, зиёда аз як соат пеш анҷом шудааст: %@ → %@. Ҳамин сабт ислоҳ карда шавад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kayıt %@, bir saatten uzun süre önce yapıldı: %@ → %@. Bu kayıt düzeltilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останній запис, %@, зроблено понад годину тому: %@ → %@. Виправити саме його?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi yozuv, %@, bir soatdan ko‘proq oldin kiritilgan: %@ → %@. Shu yozuv tuzatilsinmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次的紀錄 %@ 已超過一小時：%@ → %@。要更正這筆紀錄嗎？"
          }
        }
      }
    },
