    "quick.repeat.none": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təkrarlanacaq heç nə yoxdur: həmin gün əl ilə xərc daxil etməmisiniz"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма чаго паўтараць: у той дзень вы не ўводзілі выдаткі ўручную"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu wiederholen: An diesem Tag wurden keine Ausgaben von Hand erfasst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to repeat: no spending of yours was entered by hand that day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que repetir: ese día no se introdujo a mano ningún gasto suyo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à répéter : aucune dépense saisie à la main ce jour-là"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կրկնելու բան չկա․ այդ օրը ձեռքով ծախս չեք մուտքագրել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da ripetere: quel giorno non hai inserito spese a mano"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გასამეორებელი არაფერია: იმ დღეს ხარჯი ხელით არ შეგიყვანიათ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайталайтын ештеңе жоқ: сол күні сіз қолмен енгізген шығын болмаған"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кайталай турган эч нерсе жок: ал күнү чыгымдарыңызды кол менен киргизген эмессиз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma czego powtórzyć: tego dnia nie wpisano ręcznie żadnych wydatków"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a repetir: você não registrou gastos manualmente nesse dia"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para repetir: não registou despesas manualmente nesse dia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего повторять: своих расходов, записанных руками, за тот день нет"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чизе барои такрор нест: дар он рӯз шумо хароҷотро дастӣ ворид накардаед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrarlanacak bir şey yok: o gün elle girilmiş harcamanız yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає що повторити: цього дня ви не вводили власних витрат вручну"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Takrorlaydigan hech narsa yo‘q: o‘sha kuni xarajatlaringiz qo‘lda kiritilmagan"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可重複的項目：你當天沒有手動輸入支出"
          }
        }
      }
    },
    "quick.repeat.subtitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarixində əl ilə daxil etdikləriniz. Bu gün üçün yazılacaqları seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тое, што вы ўвялі ўручную %@. Выберыце, што запісаць на сёння."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Sie am %@ von Hand erfasst haben. Markieren Sie, was für heute geschrieben werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you entered by hand on %@. Tick what to write for today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que introdujo a mano el %@. Marque lo que quiere escribir para hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez saisi à la main le %@. Cochez ce qu'il faut noter pour aujourd'hui."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեռքով մուտքագրված ծախսերը %@ օրը։ Նշեք, թե ինչ գրանցել այսօր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni inserite a mano il %@. Seleziona quelle da registrare oggi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რაც ხელით შეიყვანეთ %@. მონიშნეთ, რა ჩაიწეროს დღეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күні қолмен енгізгеніңіз. Бүгінге не жазылатынын белгілеңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күнү кол менен киргизгендериңиз. Бүгүн жазыла тургандарды белгилеңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy dodane ręcznie dnia %@. Zaznacz, co zapisać na dziś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você registrou manualmente em %@. Marque o que deseja registrar hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que registou manualmente em %@. Selecione o que pretende registar hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы записали руками %@. Отметьте, что записать на сегодня."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Он чи шумо дар %@ дастӣ ворид кардаед. Барои сабти имрӯз интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinde elle girdikleriniz. Bugün kaydedilecekleri seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що ви ввели вручну %@. Позначте, що записати на сьогодні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kuni qo‘lda kiritganlaringiz. Bugun yoziladiganlarini belgilang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %@ 手動輸入的項目。勾選要記錄在今天的項目。"
          }
        }
      }
    },
