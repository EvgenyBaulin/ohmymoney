    "quick.card.last4.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt die App diese Karte in den Texten der Bank finden. Nicht die Kartennummer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the app find this card in the bank's texts. Not the card number."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба банк мәтіндерінде осы картаны таниды. Карта нөмірі емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По ним приложение находит карту в сообщениях банка. Это не номер карты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допомагає знайти картку в текстах банку. Це не номер картки."
          }
        }
      }
    },
