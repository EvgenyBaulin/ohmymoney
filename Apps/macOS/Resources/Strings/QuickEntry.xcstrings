    "quick.card.details.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адвольны тэкст: уладальнік, тэрмін дзеяння. Ніколі не захоўвайце код з адваротнага боку карты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freitext: Inhaber, Ablaufdatum. Bewahren Sie nie den Code von der Rückseite der Karte auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free text: holder, expiry date. Never keep the code from the back of the card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto libre: titular, fecha de caducidad. Nunca guarde el código del dorso de la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte libre : titulaire, date d'expiration. Ne gardez jamais le code au dos de la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo libero: titolare, data di scadenza. Non conservare mai il codice sul retro della carta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Еркін мәтін: иесі, жарамдылық мерзімі. Картаның артындағы кодты ешқашан сақтамаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободный текст: владелец, срок действия. Код с обратной стороны карты здесь не храните."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довільний текст: власник, строк дії. Ніколи не зберігайте код зі звороту картки."
          }
        }
      }
    },
