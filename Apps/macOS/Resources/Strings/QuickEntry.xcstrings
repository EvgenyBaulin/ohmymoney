    "quick.move.ahead.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyat gələcək günə olduğu kimi köçürülsün?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перанесці аперацыю на будучы дзень без змен?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Vorgang so, wie er ist, auf einen Tag in der Zukunft verschieben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the operation to a day ahead as it is?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Mover la operación tal cual a un día futuro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer l'opération à un jour à venir tel quel ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարքը տեղափոխե՞լ ապագա օր՝ առանց փոփոխության։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi spostare l'operazione in un giorno futuro così com'è?"
          }
        },
        "ka": {
