    "quick.split.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İki hissə arasındakı ayırıcını sürüşdürün; 10 vahidlik addımla hərəkət edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перацягніце падзельнік паміж часткамі; ён рухаецца з крокам 10."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie den Trenner zwischen den beiden Teilen; er bewegt sich um 10."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the divider between the two parts; it moves by 10."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre el divisor entre las dos partes; se mueve de 10 en 10."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser le séparateur entre les deux parts ; il se déplace de 10."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քաշեք երկու մասերի միջև բաժանարարը․ այն շարժվում է 10-ի քայլով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il divisore tra le due parti; si sposta a intervalli di 10."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაათრიეთ გამყოფი ორ ნაწილს შორის; ის 10-ით გადაადგილდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екі бөлікті бөлетін сызықты сүйреңіз; ол 10-шар жылжиды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эки бөлүктүн ортосундагы бөлгүчтү сүйрөңүз; ал 10 кадам менен жылат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij separator między częściami; przesuwa się co 10."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o divisor entre as duas partes; ele avança de 10 em 10."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o separador entre as duas partes; move-se em intervalos de 10."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяните границу между частями; шаг — 10."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷудокунаки байни ду қисмро кашед; он бо қадами 10 ҳаракат мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki kısım arasındaki ayırıcıyı sürükleyin; 10'ar 10'ar hareket eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть роздільник між двома частинами; крок — 10."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikki qism orasidagi ajratgichni suring; u 10 birlikdan siljiydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移兩部分之間的分隔線，每次移動 10。"
          }
        }
      }
    },
