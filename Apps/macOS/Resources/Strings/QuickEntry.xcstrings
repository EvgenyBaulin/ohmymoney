    "quick.bank.reconcile": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdıqdan sonra tutuşdurmanı aç (mətnə görə %@ qalıb)"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрыць зверку пасля запісу (паводле тэксту засталося %@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Schreiben den Abgleich öffnen (der Text sagt, dass %@ übrig ist)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the reconciliation after writing (the text says %@ is left)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir la conciliación tras escribir (el texto dice que quedan %@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le rapprochement après l'écriture (le texte indique qu'il reste %@)"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրանցելուց հետո բացել համեմատումը (ըստ հաղորդագրության՝ մնացել է %@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la riconciliazione dopo la registrazione (il testo indica un saldo di %@)"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაწერის შემდეგ შედარების გახსნა (ტექსტის მიხედვით დარჩენილია %@)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазғаннан кейін салыстыруды ашу (мәтінде %@ қалғаны айтылған)"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазгандан кийин салыштырууну ачуу (текстте %@ калганы айтылат)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz uzgadnianie po zapisaniu (według wiadomości pozostało %@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir a conciliação após registrar (a mensagem diz que restam %@)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir a reconciliação após registar (a mensagem indica que restam %@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть сверку после записи (в сообщении остаток %@)"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пас аз сабт муқоисаро кушоед (дар матн бақия %@ аст)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettikten sonra mutabakatı aç (metne göre %@ kaldı)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити звірку після запису (у тексті залишок %@)"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yozgach, solishtirishni ochish (matnga ko‘ra %@ qolgan)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄後開啟對帳（訊息顯示剩餘 %@）"
          }
        }
      }
    },
    "quick.bills.categoryNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarixçə və modelin kateqoriyaya ayıra bilmədikləri «Xatırlamıram» bölməsinə düşür; sonra siyahıda dəyişə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тое, што гісторыя і мадэль не могуць размеркаваць, трапіць у «Не памятаю»; пазней гэта можна змяніць у спісе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der Verlauf und das Modell nicht einordnen können, geht zu „Nicht erinnert“; ändern Sie es später in der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the history and the model cannot file goes to «Don't remember»; change it later in the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el historial y el modelo no pueden clasificar va a «No recuerdo»; cámbielo después en la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l'historique et le modèle ne peuvent pas classer va dans « Je ne sais plus » ; changez-le plus tard dans la liste."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատմությամբ և մոդելով չորոշվածները կհայտնվեն «Չեմ հիշում» բաժնում․ ցանկում կարող եք հետո փոխել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che la cronologia e il modello non riescono a classificare va in «Non ricordo»; puoi cambiarlo in seguito nell'elenco."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რასაც ისტორია და მოდელი ვერ ანაწილებს, მოხვდება კატეგორიაში «არ მახსოვს»; მოგვიანებით შეცვალეთ სიაში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарих пен үлгі санатқа жатқыза алмағанның бәрі «Есімде жоқ» болады; оны кейін тізімде өзгертуге болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарых жана модель аныктай албагандар «Эсимде жок» бөлүмүнө өтөт; кийин тизмеден өзгөртүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, czego historia i model nie rozpoznają, trafi do «Nie pamiętam»; możesz to później zmienić na liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o histórico e o modelo não classificarem vai para «Não lembro»; altere depois na lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o histórico e o modelo não conseguirem classificar fica em «Não me lembro»; pode alterar depois na lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что история и модель не смогли разложить, попадает в «Не помню»; потом это можно поправить в списке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Он чи таърих ва модел гурӯҳбандӣ карда наметавонанд, ба «Дар хотир нест» меравад; баъдтар дар рӯйхат тағйир диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişin ve modelin sınıflandıramadıkları «Hatırlamıyorum» kategorisine gider; daha sonra listeden değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що історія та модель не змогли визначити, потрапить у «Не пам'ятаю»; змініть пізніше в списку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarix va model tasniflay olmaganlari «Don't remember»ga tushadi; keyinroq ro‘yxatda o‘zgartiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法依紀錄和模型分類的項目會歸入「不記得」；之後可在列表中更改。"
          }
        }
      }
    },
