    "quick.drafts.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaralama əməliyyat deyil: tamamlanıb yazılana qədər heç bir hesablamaya daxil edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чарнавік — не аперацыя: ён не ўлічваецца ў разліках, пакуль вы яго не завершыце і не запішаце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Entwurf ist kein Vorgang: Er zählt in keiner Zahl, bis Sie ihn abschließen und schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A draft is not an operation: it counts in no figure until you finish it and write it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un borrador no es una operación: no cuenta en ninguna cifra hasta que lo termine y lo escriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brouillon n'est pas une opération : il ne compte dans aucun chiffre tant que vous ne l'avez pas terminé et noté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սևագիրը գործարք չէ․ այն չի հաշվարկվում, մինչև չավարտեք և չգրանցեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bozza non è un'operazione: non viene conteggiata finché non la completi e registri."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონახაზი ოპერაცია არ არის: ის გამოთვლებში არ შედის, სანამ არ დაასრულებთ და არ ჩაწერთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қаралама — операция емес: оны аяқтап жазғанға дейін ешбір санда есептелмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Долбоор операция эмес: аны аяктап, жазмайынча эч бир көрсөткүчкө кирбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szkic nie jest operacją: nie jest uwzględniany w obliczeniach, dopóki go nie dokończysz i nie zapiszesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um rascunho não é uma operação: ele não entra nos cálculos até ser concluído e registrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um rascunho não é uma operação: não conta para nenhum valor até ser concluído e registado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновик — не операция: он не входит ни в одну сумму, пока вы его не допишете и не запишете."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пешнавис амалиёт нест: то анҷом ва сабт нашуданаш дар ҳеҷ ҳисобе ба назар гирифта намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslak bir işlem değildir: tamamlayıp kaydedene kadar hiçbir hesaplamaya dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чернетка — не операція: вона не входить у жоден підсумок, доки ви не завершите й не запишете її."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoralama operatsiya emas: uni yakunlab yozmaguningizcha, hisob-kitoblarga kirmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿不會計入任何數據，直到完成並記錄為交易。"
          }
        }
      }
    },
