    "quick.bills.categoryNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the history and the model cannot file goes to «Don't remember»; change it later in the list."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что история и модель не смогли разложить, попадает в «Не помню»; потом это можно поправить в списке."
          }
        }
      }
    },
