    "quick.bank.read": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank mətnindən oxu: %@"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прачытана з тэксту банка: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Text der Bank gelesen: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the bank's text: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído del texto del banco: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu dans le texte de la banque : %@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարդացվել է բանկի հաղորդագրությունից՝ %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letto dal testo della banca: %@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამოკითხულია ბანკის ტექსტიდან: %@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк мәтінінен оқылған: %@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын текстинен окулду: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytano z wiadomości banku: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido na mensagem do banco: %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido na mensagem do banco: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано из сообщения банка: %@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз матни бонк хонда шуд: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka metninden okunan: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано з тексту банку: %@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank matnidan o‘qildi: %@"
          }
        },
