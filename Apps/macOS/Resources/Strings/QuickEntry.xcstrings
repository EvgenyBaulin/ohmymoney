    "quick.bills.subtitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazılacaq əməliyyatları seçin. Artıq mövcud olanlar seçilməyib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце, што запісаць. Ужо запісанае не выбрана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie, was geschrieben werden soll. Was Sie schon haben, ist abgewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick what to write. What you already have is unticked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque lo que quiere escribir. Lo que ya tiene está desmarcado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez ce qu'il faut noter. Ce que vous avez déjà est décoché."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշեք, թե ինչ գրանցել։ Արդեն առկա գործարքները նշված չեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona cosa registrare. Le operazioni già presenti non sono selezionate."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონიშნეთ, რა ჩაიწეროს. უკვე არსებული ოპერაციები მონიშნული არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылатындарды белгілеңіз. Сізде бар нәрсе белгіленбейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазыра тургандарды белгилеңиз. Мурда жазылгандар белгиленген эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz, co zapisać. Istniejące operacje nie są zaznaczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o que deseja registrar. O que já existe fica desmarcado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o que pretende registar. O que já existe não está selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте, что записать. То, что уже записано, не отмечено."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои сабт интихоб кунед. Сабтҳои мавҷуда интихоб нашудаанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilecekleri seçin. Zaten kaydedilmiş olanlar seçili değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте, що записати. Уже наявні операції не позначено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoziladiganlarini belgilang. Mavjudlari belgilanmagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾選要記錄的項目。已有的項目不會勾選。"
          }
        }
      }
    },
