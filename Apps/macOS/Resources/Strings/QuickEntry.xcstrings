    "quick.card.details.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sərbəst mətn: kart sahibi, son istifadə tarixi. Kartın arxasındakı kodu heç vaxt saxlamayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адвольны тэкст: уладальнік, тэрмін дзеяння. Ніколі не захоўвайце код з адваротнага боку карты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freitext: Inhaber, Ablaufdatum. Bewahren Sie nie den Code von der Rückseite der Karte auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free text: holder, expiry date. Never keep the code from the back of the card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto libre: titular, fecha de caducidad. Nunca guarde el código del dorso de la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte libre : titulaire, date d'expiration. Ne gardez jamais le code au dos de la carte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ազատ տեքստ՝ քարտապան, վավերականության ժամկետ։ Երբեք մի պահեք քարտի հետևի կոդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo libero: titolare, data di scadenza. Non conservare mai il codice sul retro della carta."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თავისუფალი ტექსტი: მფლობელი, ვადა. არასოდეს შეინახოთ ბარათის უკანა მხარეს არსებული კოდი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Еркін мәтін: иесі, жарамдылық мерзімі. Картаның артындағы кодты ешқашан сақтамаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эркин текст: картанын ээси, жарактуулук мөөнөтү. Картанын артындагы кодду эч качан сактабаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dowolny tekst: posiadacz, data ważności. Nigdy nie zapisuj kodu z odwrotu karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto livre: titular, validade. Nunca guarde o código do verso do cartão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto livre: titular, data de validade. Nunca guarde o código do verso do cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободный текст: владелец, срок действия. Код с обратной стороны карты здесь не храните."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Матни озод: соҳиби корт, муҳлати амал. Рамзи пушти кортро ҳаргиз нигоҳ надоред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serbest metin: kart sahibi, son kullanma tarihi. Kartın arkasındaki kodu asla saklamayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довільний текст: власник, строк дії. Ніколи не зберігайте код зі звороту картки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkin matn: egasi, amal qilish muddati. Karta orqasidagi kodni hech qachon saqlamang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自由輸入：持卡人、到期日。請勿儲存卡片背面的安全碼。"
          }
        }
      }
    },
