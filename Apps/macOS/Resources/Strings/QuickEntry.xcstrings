    "quick.cardAsk.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У тэкстах банка пазначаны гэтыя лічбы. Якая гэта з вашых карт? На карце захоўваюцца толькі гэтыя лічбы, а не нумар."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Texte der Bank nennen diese Ziffern. Welche Ihrer Karten ist es? Gespeichert werden die Ziffern auf der Karte, nicht die Nummer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank's texts name these digits. Which of your cards is it? The digits are kept on the card, not the number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los textos del banco citan estas cifras. ¿Cuál de sus tarjetas es? Se guardan las cifras en la tarjeta, no el número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes de la banque nomment ces chiffres. Laquelle de vos cartes est-ce ? Seuls les chiffres sont gardés sur la carte, pas le numéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I testi della banca riportano queste cifre. A quale delle tue carte appartengono? Sulla carta vengono salvate le cifre, non il numero."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк мәтіндерінде осы цифрлар аталған. Бұл сіздің қай картаңыз? Сақталатыны — цифрлар, нөмір емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сообщениях банка стоят эти цифры. Какая это из ваших карт? Запоминаются только цифры, не номер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У текстах банку є ці цифри. Яка це ваша картка? На картці зберігаються лише цифри, а не номер."
          }
        }
      }
    },
