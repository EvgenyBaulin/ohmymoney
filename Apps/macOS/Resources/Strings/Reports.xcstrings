    "archive.tables.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız baxış: tətbiqdə heç nə dəyişmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі прагляд: даныя ў праграме не змяняюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze náhled: v aplikaci se nic nezmění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Ansicht: An der App wird nichts verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a view: nothing in the app is changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es una vista: no se cambia nada en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple affichage : rien dans l'app n'est modifié."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն դիտում․ հավելվածում ոչինչ չի փոխվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo visualizzazione: nessuna modifica nell’app."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ დათვალიერება: აპში არაფერი იცვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек көрініс: қолданбада ештеңе өзгермейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрүү гана: колдонмодогу маалымат өзгөрбөйт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko podgląd: dane w aplikacji nie zostaną zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas visualização: nada é alterado no app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas visualização: nada é alterado na app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр: в приложении ничего не меняется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо намоиш: дар барнома чизе тағйир намеёбад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca görüntüleme: Uygulamada hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише перегляд: нічого в застосунку не змінюється."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat ko‘rish: ilovada hech narsa o‘zgarmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供檢視，不會更改 App 中的資料。"
          }
        }
      }
    },
