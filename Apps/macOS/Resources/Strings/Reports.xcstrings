            "value": "Gəlir və xərclər seçdiyiniz qovluqda iki CSV faylı kimi saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даходы і выдаткі будуць захаваны ў выбранай папцы ў двух файлах CSV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjmy a výdaje se uloží jako dva soubory CSV do vybrané složky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen und die Ausgaben werden als zwei CSV-Dateien im gewählten Ordner gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income and the spending are saved as two CSV files in the folder you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ingresos y los gastos se guardan como dos archivos CSV en la carpeta que elija."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus et les dépenses sont enregistrés en deux fichiers CSV dans le dossier que vous choisissez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եկամուտն ու ծախսերը պահվում են որպես երկու CSV ֆայլ ձեր ընտրած պանակում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate e le uscite vengono salvate come due file CSV nella cartella scelta."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შემოსავალი და ხარჯი ორ CSV ფაილად შეინახება თქვენ მიერ არჩეულ საქაღალდეში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табыс пен шығын таңдаған қалтада екі CSV файл ретінде сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Киреше менен чыгаша тандалган папкага эки CSV файл катары сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przychody i wydatki zostaną zachowane jako dwa pliki CSV w wybranym folderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As receitas e despesas são salvas como dois arquivos CSV na pasta escolhida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As receitas e despesas são guardadas em dois ficheiros CSV na pasta escolhida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходы и расходы сохранятся двумя файлами CSV в выбранную папку."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромад ва хароҷот ҳамчун ду файли CSV дар ҷузвдони интихобкардаатон захира мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelir ve harcamalar, seçtiğiniz klasöre iki CSV dosyası olarak kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходи й витрати зберігаються двома файлами CSV у теці, яку ви оберете."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Daromad va xarajatlar tanlangan jildga ikkita CSV fayli sifatida saqlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收入和支出會以兩個 CSV 檔案儲存在所選檔案夾中。"
          }
        }
      }
    },
