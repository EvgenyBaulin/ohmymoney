    "archive.tables.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a table on the left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una tabla a la izquierda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un tableau à gauche"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите таблицу слева"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть таблицю зліва"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сол жақтан кестені таңдаңыз"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie links eine Tabelle"
          }
        }
      }
    },
    "archive.tables.cut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the first %1$@ of %2$@ lines"
          }
        },
