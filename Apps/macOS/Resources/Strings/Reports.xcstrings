    "archive.tables.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a view: nothing in the app is changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es una vista: no se cambia nada en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple affichage : rien dans l'app n'est modifié."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр: в приложении ничего не меняется."
