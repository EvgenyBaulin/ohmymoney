    "archive.tables.cut": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ sətirdən ilk %1$@ göstərilir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паказаны першыя %1$@ з %2$@ радкоў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazeno prvních %1$@ z %2$@ řádků"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden die ersten %1$@ von %2$@ Zeilen gezeigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the first %1$@ of %2$@ lines"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran las primeras %1$@ de %2$@ líneas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage des %1$@ premières lignes sur %2$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցուցադրվում է %2$@ տողից առաջին %1$@-ը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrate le prime %1$@ righe su %2$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაჩვენებია %2$@ სტრიქონიდან პირველი %1$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жолдардың алғашқы %1$@ / %2$@ көрсетілген"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ саптын алгачкы %1$@ сапы көрсөтүлүүдө"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsze %1$@ z %2$@ wierszy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibindo as primeiras %1$@ de %2$@ linhas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mostrar as primeiras %1$@ de %2$@ linhas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны первые %1$@; всего строк: %2$@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аввалин %1$@ аз %2$@ сатр нишон дода шудааст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ satırın ilk %1$@ tanesi gösteriliyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано перші %1$@ з %2$@ рядків"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ satrdan birinchi %1$@ tasi ko‘rsatilmoqda"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示共 %2$@ 行中的前 %1$@ 行"
          }
        }
      }
    },
