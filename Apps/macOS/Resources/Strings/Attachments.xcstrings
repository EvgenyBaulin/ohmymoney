            "state": "translated",
            "value": "Захоўваць заўсёды"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep forever"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar siempre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder à jamais"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva per sempre"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мәңгілікке сақтау"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj na zawsze"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранить всегда"
          }
        },
