          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կտրոնների լուսանկարները պահել ընդմիշտ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva le foto delle ricevute per sempre"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ქვითრების ფოტოების მუდმივად შენახვა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек фотосын мәңгі сақтау"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чектердин сүрөттөрүн дайыма сактоо"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuj zdjęcia paragonów na zawsze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter fotos de comprovantes para sempre"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter fotografias de recibos para sempre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранить фото чеков всегда"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аксҳои расидҳо ҳамеша нигоҳ дошта шаванд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiş fotoğraflarını süresiz sakla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігати фото чеків назавжди"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chek suratlarini doim saqlash"
          }
        },
