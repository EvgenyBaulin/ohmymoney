    "att.import.without": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым архіве няма далучаных файлаў. У іх радках будзе пазначана «выдалена паводле правіла захоўвання»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Archiv enthält keine angehängten Dateien. Ihre Zeilen lauten „durch die Aufbewahrungsregel entfernt“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This archive has no attached files. Their rows will read “removed by the retention rule”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no tiene adjuntos. Sus filas dirán «eliminado por la regla de conservación»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette archive ne contient pas de fichiers joints. Leurs lignes indiqueront « supprimé par la règle de conservation »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo archivio non contiene allegati. Le relative righe indicheranno “rimosso dalla regola di conservazione”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл мұрағатта тіркелген файлдар жоқ. Олардың жолдары «сақтау ережесі бойынша жойылды» деп көрінеді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To archiwum nie zawiera załączników. Przy ich pozycjach pojawi się informacja „usunięto zgodnie z regułą przechowywania”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом архиве нет вложений. Их записи будут отмечены «удалено по правилу хранения»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arşivde ekli dosya yok. İlgili satırlarda “saklama kuralı gereği silindi” yazacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей архів не містить вкладених файлів. Їхні рядки матимуть позначку «видалено за правилом зберігання»."
          }
        }
      }
    },
    "att.keep": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
