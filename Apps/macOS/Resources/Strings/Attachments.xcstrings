    "att.settings.keepReceipts": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qəbz şəkillərini həmişə saxla"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоўваць фота чэкаў заўсёды"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechat fotky účtenek navždy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegfotos für immer behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep receipt photos forever"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
