    "att.settings.archive": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əlavələri köçürmə arxivinə daxil et"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадаваць укладанні ў архіў пераносу"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahrnout přílohy do přenosového archivu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge ins Übertragungsarchiv legen"
