    "att.settings.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы захоўваюцца ў першапачатковым выглядзе: яны не сціскаюцца і не змяняюцца, незалежна ад памеру."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien bleiben genau so, wie sie hinzugefügt wurden: Nichts wird komprimiert oder verändert, egal wie groß sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are kept exactly as they were added: nothing is compressed or changed, whatever their size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se conservan tal como se añadieron: no se comprimen ni se cambian, sea cual sea su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont conservés tels qu'ils ont été ajoutés : rien n'est compressé ni modifié, quelle que soit leur taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono conservati esattamente come sono stati aggiunti: non vengono compressi né modificati, indipendentemente dalle dimensioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлдар қосылғандай сақталады: өлшеміне қарамай ешқандай қысылмайды және өзгермейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki są przechowywane w oryginalnej postaci, bez kompresji i zmian, niezależnie od rozmiaru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы хранятся такими, какими их добавили: ничего не сжимается и не меняется, каким бы ни был размер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar eklendikleri gibi saklanır: Boyutları ne olursa olsun sıkıştırılmaz veya değiştirilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли зберігаються такими, як їх додано: нічого не стискається й не змінюється, незалежно від розміру."
          }
        }
      }
    },
