      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: a receipt photo goes to the trash a week after it was added. Warranties and documents are never touched."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: фото чека через неделю уходит в корзину. Гарантий и документов это не касается."
          }
        }
      }
    },
