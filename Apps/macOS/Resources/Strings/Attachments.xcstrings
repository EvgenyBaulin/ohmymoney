    "att.settings.archiveHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlarınızı saxlayarkən «Əlavələrlə» seçiminin standart vəziyyəti."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прадвызначаны стан сцяжка «З укладаннямі» пры захаванні даных."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí nastavení volby «S přílohami» při ukládání dat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorgabe des Kästchens „Mit Anhängen“ beim Speichern Ihrer Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default of the box «With attachments» when you save your data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor por defecto de la casilla «Con adjuntos» al guardar sus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage par défaut de la case « Avec les pièces jointes » lors de l'enregistrement de vos données."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալները պահպանելիս «Կցորդներով» վանդակի լռելյայն վիճակը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazione predefinita della casella «Con allegati» quando salvi i dati."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემების შენახვისას „დანართებით“ ველის ნაგულისხმევი მდგომარეობა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректерді сақтағанда «Тіркемелермен» құсбелгісінің әдепкі мәні."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалыматтарды сактаганда «Тиркемелери менен» белгисинин демейки абалы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślne ustawienie pola «Z załącznikami» podczas zapisywania danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado padrão da opção «Com anexos» ao salvar seus dados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado predefinido da opção «Com anexos» ao guardar os dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так будет отмечена галочка «С вложениями», когда вы сохраняете данные."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳолати пешфарзи қуттии «Бо замимаҳо» ҳангоми нигоҳдории маълумот."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerinizi kaydederken «Eklerle» kutusunun varsayılan durumu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типовий стан прапорця «Із вкладеннями» під час збереження даних."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlarni saqlashda «Biriktirmalar bilan» katagining standart holati."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存資料時，「包含附件」的預設勾選狀態。"
          }
        }
      }
    },
