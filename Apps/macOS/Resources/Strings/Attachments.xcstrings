    "att.settings.keepReceiptsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söndürüldükdə qəbz şəkli əlavə edildikdən bir həftə sonra səbətə atılır. Zəmanətlər və sənədlər silinmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі выключана, фота чэка трапляе ў сметніцу праз тыдзень пасля дадання. Гарантыі і дакументы не выдаляюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při vypnutí se fotka účtenky přesune do koše týden po přidání. Záručních listů a dokumentů se to netýká."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Ein Belegfoto landet eine Woche nach dem Hinzufügen im Papierkorb. Garantien und Dokumente werden nie angerührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: a receipt photo goes to the trash a week after it was added. Warranties and documents are never touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: la foto de un recibo va a la papelera una semana después de añadirse. Las garantías y los documentos nunca se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : une photo de ticket part à la corbeille une semaine après son ajout. Les garanties et documents ne sont jamais touchés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անջատված լինելու դեպքում կտրոնի լուսանկարը տեղափոխվում է աղբարկղ՝ ավելացնելուց մեկ շաբաթ անց։ Երաշխիքներն ու փաստաթղթերը չեն հեռացվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, le foto delle ricevute vengono spostate nel Cestino una settimana dopo l’aggiunta. Le garanzie e i documenti non vengono mai rimossi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამორთვისას ქვითრის ფოტო დამატებიდან ერთი კვირის შემდეგ სანაგვეში გადადის. გარანტიები და დოკუმენტები არ იშლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өшірулі: чек фотосы қосылғаннан кейін бір аптадан соң себетке түседі. Кепілдіктер мен құжаттарға ешқашан тиілмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өчүк болсо, чектин сүрөтү кошулгандан бир жума өткөндөн кийин себетке жылдырылат. Кепилдиктер жана документтер өчүрүлбөйт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyłączone: zdjęcie paragonu trafia do kosza tydzień po dodaniu. Gwarancje i dokumenty nie są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: fotos de comprovantes vão para o Lixo uma semana após serem adicionadas. Garantias e documentos nunca são removidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: as fotografias de recibos são movidas para o lixo uma semana após serem adicionadas. As garantias e os documentos não são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: фото чека через неделю уходит в корзину. Гарантий и документов это не касается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми хомӯш будан: акси расид як ҳафта пас аз илова шудан ба сабад меравад. Кафолатҳо ва ҳуҷҷатҳо дастнорас мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıysa fiş fotoğrafları eklendikten bir hafta sonra Çöp Sepeti’ne taşınır. Garanti belgeleri ve diğer belgeler silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вимкнено, фото чека потрапляє в кошик через тиждень після додавання. Гарантії та документи не змінюються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘chiq bo‘lsa, chek surati qo‘shilganidan bir hafta o‘tib savatga ko‘chiriladi. Kafolatlar va hujjatlar o‘chirilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，收據照片會在加入一週後移至垃圾桶。保固和文件不受影響。"
          }
        }
      }
    },
    "att.settings.mirror": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
