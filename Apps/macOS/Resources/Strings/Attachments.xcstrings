    "att.settings.mirrorHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayllar günün nüsxəsi ilə birlikdə nüsxələr qovluğuna köçürülür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы трапляюць у папку копій разам з копіяй за дзень."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory se uloží do složky kopií spolu s denní kopií."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien kommen zusammen mit der Kopie des Tages in den Ordner der Kopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files go to the folder of copies together with the copy of the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos van a la carpeta de copias junto con la copia del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers vont dans le dossier des copies avec la copie du jour."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլերը պահվում են պատճենների պանակում՝ օրվա պատճենի հետ միասին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono salvati nella cartella delle copie insieme alla copia del giorno."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილები ასლების საქაღალდეში დღის ასლთან ერთად ინახება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлдар күн көшірмесімен бірге көшірмелер қалтасына түседі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлдар күндүн көчүрмөсү менен кошо көчүрмөлөр папкасына сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki trafiają do folderu kopii razem z kopią danego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos são enviados à pasta de cópias junto com a cópia do dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros são guardados na pasta de cópias juntamente com a cópia do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы копируются в папку для копий вместе с копией дня."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлҳо ҳамроҳи нусхаи рӯз ба ҷузвдони нусхаҳо мегузаранд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar, günlük kopyayla birlikte kopyalar klasörüne kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли потрапляють до папки копій разом із копією дня."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayllar kunlik nusxa bilan birga nusxalar jildiga saqlanadi."
          }
