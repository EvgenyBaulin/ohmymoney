    "att.empty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ fayl yoxdur. Qəbzi, zəmanət talonunu və ya müqaviləni bura sürüşdürün, yaxud «Əlavə et» düyməsinə basın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлаў пакуль няма. Перацягніце сюды чэк, гарантыйны талон або дагавор ці націсніце «Дадаць»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné soubory. Přetáhněte sem účtenku, záruční list nebo smlouvu, případně klikněte na Přidat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Dateien. Ziehen Sie einen Beleg, eine Garantiekarte oder einen Vertrag hierher oder drücken Sie „Hinzufügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No files yet. Drop a receipt, a warranty card or a contract here, or press Add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay archivos. Arrastre aquí un recibo, una tarjeta de garantía o un contrato, o pulse Añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier pour l'instant. Glissez ici un ticket, une carte de garantie ou un contrat, ou appuyez sur « Ajouter »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ ֆայլեր չկան։ Քաշեք կտրոն, երաշխիքային քարտ կամ պայմանագիր այստեղ, կամ սեղմեք «Ավելացնել»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file. Trascina qui una ricevuta, una garanzia o un contratto, oppure premi Aggiungi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილები ჯერ არ არის. ჩააგდეთ აქ ქვითარი, საგარანტიო ტალონი ან ხელშეკრულება, ან დააჭირეთ „დამატებას“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлдар әлі жоқ. Чекті, кепілдік картасын немесе шартты осында сүйреңіз, не «Қосу» басыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлдар жок. Чекти, кепилдик талонун же келишимди бул жерге таштаңыз же «Кошуу» баскычын басыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak plików. Upuść tutaj paragon, kartę gwarancyjną lub umowę albo kliknij Dodaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum arquivo ainda. Solte um comprovante, certificado de garantia ou contrato aqui, ou clique em Adicionar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há ficheiros. Arraste um recibo, uma garantia ou um contrato para aqui, ou prima Adicionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлов пока нет. Перетащите сюда чек, гарантию или договор или нажмите «Добавить»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз файл нест. Расид, талони кафолат ё шартномаро ба ин ҷо кашед ё «Илова кардан»-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz dosya yok. Buraya bir fiş, garanti belgesi veya sözleşme bırakın ya da Ekle’ye basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлів поки немає. Перетягніть сюди чек, гарантійний талон чи договір або натисніть «Додати»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha fayllar yo‘q. Chek, kafolat taloni yoki shartnomani shu yerga tashlang yoki Qo‘shish tugmasini bosing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無檔案。將收據、保固卡或合約拖放至此，或按下「加入」。"
          }
        }
      }
    },
