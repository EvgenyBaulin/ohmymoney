    "att.settings.keepReceiptsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі выключана, фота чэка трапляе ў сметніцу праз тыдзень пасля дадання. Гарантыі і дакументы не выдаляюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Ein Belegfoto landet eine Woche nach dem Hinzufügen im Papierkorb. Garantien und Dokumente werden nie angerührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: a receipt photo goes to the trash a week after it was added. Warranties and documents are never touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: la foto de un recibo va a la papelera una semana después de añadirse. Las garantías y los documentos nunca se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : une photo de ticket part à la corbeille une semaine après son ajout. Les garanties et documents ne sont jamais touchés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, le foto delle ricevute vengono spostate nel Cestino una settimana dopo l’aggiunta. Le garanzie e i documenti non vengono mai rimossi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өшірулі: чек фотосы қосылғаннан кейін бір аптадан соң себетке түседі. Кепілдіктер мен құжаттарға ешқашан тиілмейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyłączone: zdjęcie paragonu trafia do kosza tydzień po dodaniu. Gwarancje i dokumenty nie są usuwane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: фото чека через неделю уходит в корзину. Гарантий и документов это не касается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıysa fiş fotoğrafları eklendikten bir hafta sonra Çöp Sepeti’ne taşınır. Garanti belgeleri ve diğer belgeler silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вимкнено, фото чека потрапляє в кошик через тиждень після додавання. Гарантії та документи не змінюються."
          }
        }
      }
    },
