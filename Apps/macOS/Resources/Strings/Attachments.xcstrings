          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Замимаҳо ба бойгонии интиқол илова шаванд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekleri aktarım arşivine dahil et"
          }
        },
        "uk": {
