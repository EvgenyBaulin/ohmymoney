        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會隨當日副本一同存入副本檔案夾。"
          }
        }
      }
    },
    "att.settings.openTrash": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əlavələr səbəti…"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сметніца ўкладанняў…"
          }
