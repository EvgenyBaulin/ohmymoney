    "att.import.without": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arxivdə əlavə edilmiş fayl yoxdur. Onların sətrlərində “saxlama qaydasına görə silinib” yazılacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым архіве няма далучаных файлаў. У іх радках будзе пазначана «выдалена паводле правіла захоўвання»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento archiv neobsahuje žádné přílohy. U jejich položek se zobrazí „odstraněno podle pravidla uchovávání“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Archiv enthält keine angehängten Dateien. Ihre Zeilen lauten „durch die Aufbewahrungsregel entfernt“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This archive has no attached files. Their rows will read “removed by the retention rule”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no tiene adjuntos. Sus filas dirán «eliminado por la regla de conservación»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette archive ne contient pas de fichiers joints. Leurs lignes indiqueront « supprimé par la règle de conservation »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս արխիվում կցված ֆայլեր չկան։ Դրանց տողերում կգրվի «Հեռացվել է պահպանման կանոնով»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo archivio non contiene allegati. Le relative righe indicheranno “rimosso dalla regola di conservazione”."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ არქივს ფაილები არ ახლავს. მათ მწკრივებში გამოჩნდება „შენახვის წესით წაიშალა“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл мұрағатта тіркелген файлдар жоқ. Олардың жолдары «сақтау ережесі бойынша жойылды» деп көрінеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул архивде тиркелген файлдар жок. Алардын катарларында “сактоо эрежесине ылайык өчүрүлгөн” деп көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To archiwum nie zawiera załączników. Przy ich pozycjach pojawi się informacja „usunięto zgodnie z regułą przechowywania”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não contém anexos. As respectivas linhas exibirão “removido pela regra de retenção”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não tem ficheiros anexados. As respetivas linhas indicarão “removido pela regra de retenção”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом архиве нет вложений. Их записи будут отмечены «удалено по правилу хранения»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин бойгонӣ файли замимашуда надорад. Дар сатри онҳо «мувофиқи қоидаи нигоҳдорӣ нест карда шуд» навишта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arşivde ekli dosya yok. İlgili satırlarda “saklama kuralı gereği silindi” yazacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей архів не містить вкладених файлів. Їхні рядки матимуть позначку «видалено за правилом зберігання»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arxivda biriktirilgan fayllar yo‘q. Ularning qatorlarida “saqlash qoidasiga ko‘ra olib tashlangan” deb yoziladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此封存檔不含附件。其項目將顯示「已依保留規則移除」。"
          }
        }
      }
    },
