    "att.empty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No files yet. Drop a receipt, a warranty card or a contract here, or press Add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay archivos. Arrastre aquí un recibo, una tarjeta de garantía o un contrato, o pulse Añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier pour l'instant. Glissez ici un ticket, une carte de garantie ou un contrat, ou appuyez sur « Ajouter »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлов пока нет. Перетащите сюда чек, гарантию или договор или нажмите «Добавить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлів поки немає. Перетягніть сюди чек, гарантійний талон чи договір або натисніть «Додати»."
          }
        }
      }
    },
