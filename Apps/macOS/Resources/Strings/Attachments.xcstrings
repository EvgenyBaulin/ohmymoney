        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Anhängen (%@, nicht alle passen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With attachments (%@, not all fit)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con adjuntos (%@, no caben todos)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec les pièces jointes (%@, pas toutes ne tiennent)"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կցորդներով (%@, ոչ բոլորն են տեղավորվում)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con allegati (%@, non tutti inclusi)"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დანართებით (%@, ყველა ვერ დაეტია)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіркемелермен (%@, барлығы сыймайды)"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиркемелери менен (%@, баары баткан жок)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z załącznikami (%@, nie wszystkie się zmieściły)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com anexos (%@, nem todos cabem)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com anexos (%@, nem todos cabem)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С вложениями (%@, не все поместятся)"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо замимаҳо (%@, на ҳамаашон ҷой шуданд)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklerle (%@, tümü sığmadı)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Із вкладеннями (%@, умістилися не всі)"
          }
