    "att.settings.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayllar əlavə edildiyi kimi saxlanılır: ölçüsündən asılı olmayaraq sıxılmır və dəyişdirilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы захоўваюцца ў першапачатковым выглядзе: яны не сціскаюцца і не змяняюцца, незалежна ад памеру."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory se uchovávají přesně tak, jak byly přidány, bez komprese nebo úprav a bez ohledu na velikost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien bleiben genau so, wie sie hinzugefügt wurden: Nichts wird komprimiert oder verändert, egal wie groß sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are kept exactly as they were added: nothing is compressed or changed, whatever their size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se conservan tal como se añadieron: no se comprimen ni se cambian, sea cual sea su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont conservés tels qu'ils ont été ajoutés : rien n'est compressé ni modifié, quelle que soit leur taille."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլերը պահվում են ավելացված տեսքով․ անկախ չափից՝ դրանք չեն սեղմվում կամ փոփոխվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono conservati esattamente come sono stati aggiunti: non vengono compressi né modificati, indipendentemente dalle dimensioni."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილები ინახება ზუსტად ისე, როგორც დაემატა: ზომის მიუხედავად, არაფერი იკუმშება ან იცვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлдар қосылғандай сақталады: өлшеміне қарамай ешқандай қысылмайды және өзгермейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлдар кандай кошулса, ошондой сакталат: өлчөмүнө карабай кысылбайт жана өзгөртүлбөйт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki są przechowywane w oryginalnej postaci, bez kompresji i zmian, niezależnie od rozmiaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos são mantidos exatamente como foram adicionados, sem compressão ou alterações, independentemente do tamanho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros são mantidos exatamente como foram adicionados, sem compressão nem alterações, independentemente do tamanho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы хранятся такими, какими их добавили: ничего не сжимается и не меняется, каким бы ни был размер."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлҳо ҳамон тавре ки илова шудаанд, нигоҳ дошта мешаванд: новобаста аз андозаашон, чизе фишурда ё тағйир дода намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar eklendikleri gibi saklanır: Boyutları ne olursa olsun sıkıştırılmaz veya değiştirilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли зберігаються такими, як їх додано: нічого не стискається й не змінюється, незалежно від розміру."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayllar qanday qo‘shilgan bo‘lsa, shunday saqlanadi: hajmidan qat’i nazar, ular siqilmaydi yoki o‘zgartirilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會以加入時的原貌保留，無論大小皆不會壓縮或更動。"
          }
        }
      }
    },
