    "att.archive.partial": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З укладаннямі (%@, не ўсе змясціліся)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Anhängen (%@, nicht alle passen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With attachments (%@, not all fit)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con adjuntos (%@, no caben todos)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec les pièces jointes (%@, pas toutes ne tiennent)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con allegati (%@, non tutti inclusi)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіркемелермен (%@, барлығы сыймайды)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z załącznikami (%@, nie wszystkie się zmieściły)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С вложениями (%@, не все поместятся)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklerle (%@, tümü sığmadı)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Із вкладеннями (%@, умістилися не всі)"
          }
        }
      }
    },
