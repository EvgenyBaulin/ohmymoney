    "att.archive.partial": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əlavələrlə (%@, hamısı sığmır)"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З укладаннямі (%@, не ўсе змясціліся)"
