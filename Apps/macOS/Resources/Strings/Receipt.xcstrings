    "receipt.check.numbers": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çapdan oxundu. Fiskal nömrələr yoxlamadan keçmədi, buna görə çek onlarsız qeydə alınacaq. Məbləği və tarixi kağızdakı ilə tutuşdurun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даныя счытаны з раздрукоўкі. Фіскальныя нумары не прайшлі праверку, таму чэк запісаны без іх. Параўнайце суму і дату з раздрукоўкай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje byly načteny z tisku. Fiskální čísla neprošla kontrolou, proto je účtenka zaznamenána bez nich. Porovnejte částku a datum s papírovou účtenkou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Aufdruck gelesen. Die Steuernummern haben die Prüfungen nicht bestanden, daher wird der Beleg ohne sie erfasst. Vergleichen Sie Summe und Datum mit dem Papier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the print. The fiscal numbers did not pass the checks, so the receipt is recorded without them. Compare the sum and the date with the paper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído de la impresión. Los números fiscales no pasaron las comprobaciones, así que el recibo se registra sin ellos. Compare la suma y la fecha con el papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu sur l'impression. Les numéros fiscaux n'ont pas passé les contrôles, donc le ticket est noté sans eux. Comparez la somme et la date avec le papier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարդացվել է տպվածքից։ Ֆիսկալ համարները չեն անցել ստուգումը, ուստի կտրոնը գրանցվում է առանց դրանց։ Համեմատեք գումարն ու ամսաթիվը թղթային կտրոնի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letto dalla stampa. I dati fiscali non hanno superato i controlli, quindi lo scontrino è stato registrato senza di essi. Confronta l’importo e la data con la stampa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印字から読み取りました。税務番号の検証に失敗したため、番号なしでレシートを登録します。金額と日付を原本と照合してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წაკითხულია ამონაბეჭდიდან. ფისკალურმა ნომრებმა შემოწმება ვერ გაიარა, ამიტომ ქვითარი მათ გარეშე აღირიცხება. შეადარეთ თანხა და თარიღი ქაღალდის ქვითარს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баспадан оқылған. Фискалдық нөмірлер тексеруден өтпеді, сондықтан чек оларсыз жазылады. Соманы және күнді қағазбен салыстырыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인쇄된 내용을 읽었습니다. 세금 관련 번호를 확인할 수 없어 번호 없이 등록합니다. 금액과 날짜를 영수증과 비교하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Басылган чектен окулду. Фискалдык номерлер текшерүүдөн өткөн жок, андыктан чек аларсыз катталат. Сумманы жана күндү кагаздагы чек менен салыштырыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelezen van de bon. De fiscale nummers zijn niet door de controle gekomen en zijn niet vastgelegd. Vergelijk het bedrag en de datum met de papieren bon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytano z wydruku. Numery fiskalne nie przeszły weryfikacji, więc paragon zapisano bez nich. Porównaj kwotę i datę z wydrukiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido do comprovante impresso. Os números fiscais não passaram na verificação, então o comprovante foi registrado sem eles. Compare o valor e a data com o papel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido do documento impresso. Os números fiscais não passaram nas verificações, pelo que o recibo foi registado sem eles. Compare o valor e a data com o documento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано с печати. Номера ФН, ФД и ФП не прошли проверку, поэтому чек записывается без них. Сверьте сумму и дату с бумагой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз матни чопшуда хонда шуд. Рақамҳои фискалӣ аз санҷиш нагузаштанд, бинобар ин чек бе онҳо сабт мешавад. Маблағ ва санаро бо чек муқоиса кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basılı fişten okundu. Mali numaralar doğrulanamadığı için fiş numaralar olmadan kaydediliyor. Tutarı ve tarihi basılı fişle karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано з друку. Фіскальні номери не пройшли перевірки, тому чек записується без них. Звірте суму й дату з паперовим чеком."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar chekdan o‘qildi. Fiskal raqamlar tekshiruvdan o‘tmadi, shuning uchun chek ularsiz qayd etiladi. Summa va sanani qog‘ozdagi ma’lumotlar bilan solishtiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从纸质小票读取。税务编号未通过校验，记录时未包含这些编号。请与纸质小票核对金额和日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從印刷內容讀取。稅務號碼未通過驗證，因此記錄收據時未包含這些號碼。請對照紙本核對金額和日期。"
          }
        }
      }
    },
    "receipt.check.other": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çapdan yalnız yekun məbləğ və tarix oxundu; mallar və çek nömrəsi oxunmadı. Kağızdakı ilə tutuşdurun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З раздрукоўкі счытаны толькі сума і дата, без пазіцый і нумара чэка. Параўнайце з раздрукоўкай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z tisku byly načteny jen celková částka a datum, bez položek a čísla účtenky. Porovnejte je s papírovou účtenkou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Summe und Datum wurden aus dem Aufdruck gelesen, ohne Positionen und ohne Belegnummer. Vergleichen Sie mit dem Papier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the total and the date were read from the print, with no lines and no receipt number. Compare with the paper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se leyeron de la impresión el total y la fecha, sin líneas y sin número de recibo. Compare con el papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls le total et la date ont été lus sur l'impression, sans lignes ni numéro de ticket. Comparez avec le papier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տպվածքից կարդացվել են միայն ընդհանուր գումարն ու ամսաթիվը՝ առանց ապրանքների և կտրոնի համարի։ Համեմատեք թղթային կտրոնի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla stampa sono stati letti solo il totale e la data, senza voci né numero dello scontrino. Confronta con la stampa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印字から合計金額と日付のみを読み取りました。明細とレシート番号はありません。原本と照合してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამონაბეჭდიდან წაკითხულია მხოლოდ ჯამი და თარიღი, პოზიციებისა და ქვითრის ნომრის გარეშე. შეადარეთ ქაღალდის ქვითარს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баспадан тек жиын мен күн оқылды, жолдар мен чек нөмірі жоқ. Қағазбен салыстырыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인쇄된 내용에서 합계와 날짜만 읽었습니다. 항목과 영수증 번호는 없습니다. 영수증과 비교하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Басылган чектен жалпы сумма жана күн гана окулду, товарлар жана чек номери окулган жок. Кагаздагы чек менен салыштырыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het totaalbedrag en de datum zijn van de bon gelezen, zonder regels of bonnummer. Vergelijk ze met de papieren bon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z wydruku odczytano tylko kwotę i datę, bez pozycji i numeru paragonu. Porównaj z wydrukiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o valor total e a data foram lidos do comprovante impresso, sem itens ou número do comprovante. Compare com o papel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas foram lidos o total e a data do documento impresso, sem linhas nem número de recibo. Compare com o documento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитаны только итог и дата с печати, без позиций и номера чека. Сверьте с бумагой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз матни чопшуда танҳо маблағи умумӣ ва сана хонда шуданд, бе рӯйхати молҳо ва рақами чек. Бо чек муқоиса кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basılı fişten yalnızca toplam tutar ve tarih okundu; kalemler ve fiş numarası okunamadı. Basılı fişle karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З друку прочитано лише підсумок і дату, без позицій та номера чека. Звірте з паперовим чеком."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chekdan faqat summa va sana o‘qildi, xaridlar ro‘yxati va chek raqami o‘qilmadi. Qog‘ozdagi ma’lumotlar bilan solishtiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅从纸质小票读取了总额和日期，未读取明细和小票编号。请与纸质小票核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅從印刷內容讀取了總額和日期，沒有品項明細和收據號碼。請與紙本核對。"
          }
        }
      }
    },
    "receipt.check.printed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "QR koddan deyil, çapdan oxundu. Qeydə almadan əvvəl məbləği, tarixi və nömrələri kağızdakı ilə tutuşdurun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даныя счытаны з раздрукоўкі, а не з QR-кода. Перад запісам параўнайце суму, дату і нумары з раздрукоўкай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje byly načteny z tisku, ne z QR kódu. Před zaznamenáním porovnejte částku, datum a čísla s papírovou účtenkou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Aufdruck gelesen, nicht aus einem QR-Code. Vergleichen Sie Summe, Datum und Nummern mit dem Papier, bevor Sie erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the print, not from a QR code. Compare the sum, the date and the numbers with the paper before recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído de la impresión, no de un código QR. Compare la suma, la fecha y los números con el papel antes de registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu sur l'impression, pas depuis un QR code. Comparez la somme, la date et les numéros avec le papier avant d'enregistrer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարդացվել է տպվածքից, ոչ թե QR կոդից։ Գրանցելուց առաջ գումարը, ամսաթիվը և համարները համեմատեք թղթային կտրոնի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letto dalla stampa, non da un codice QR. Confronta l’importo, la data e i numeri con la stampa prima di registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードではなく印字から読み取りました。登録前に金額、日付、番号を原本と照合してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წაკითხულია ამონაბეჭდიდან და არა QR კოდიდან. აღრიცხვამდე შეადარეთ თანხა, თარიღი და ნომრები ქაღალდის ქვითარს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-кодтан емес, баспадан оқылған. Жазбас бұрын соманы, күнді және нөмірлерді қағазбен салыстырыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드가 아닌 인쇄된 내용을 읽었습니다. 등록하기 전에 금액, 날짜 및 번호를 영수증과 비교하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "QR коддон эмес, басылган чектен окулду. Каттоодон мурун сумманы, күндү жана номерлерди кагаздагы чек менен салыштырыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelezen van de bon, niet van een QR-code. Vergelijk het bedrag, de datum en de nummers met de papieren bon voordat je deze vastlegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytano z wydruku, nie z kodu QR. Przed zapisaniem porównaj kwotę, datę i numery z wydrukiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido do comprovante impresso, não do código QR. Compare o valor, a data e os números com o papel antes de registrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido do documento impresso, não de um código QR. Compare o valor, a data e os números com o documento antes de registar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано с печати, а не с QR-кода. Сверьте сумму, дату и номера с бумагой, прежде чем записывать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз матни чопшуда хонда шуд, на аз рамзи QR. Пеш аз сабт маблағ, сана ва рақамҳоро бо чек муқоиса кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodundan değil, basılı fişten okundu. Kaydetmeden önce tutarı, tarihi ve numaraları basılı fişle karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано з друку, а не з QR-коду. Перед записом звірте суму, дату й номери з паперовим чеком."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar QR koddan emas, chekdan o‘qildi. Qayd etishdan oldin summa, sana va raqamlarni qog‘ozdagi ma’lumotlar bilan solishtiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从纸质小票读取，而非二维码。记录前请与纸质小票核对金额、日期和编号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從印刷內容讀取，並非來自 QR 碼。記錄前請對照紙本核對金額、日期和號碼。"
          }
        }
      }
    },
    "receipt.check.slip": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kart terminalının qəbzidir: məbləğ və vaxt ondan götürülüb, qəbzdə çek nömrəsi yoxdur. Kağızdakı ilə tutuşdurun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта квітанцыя тэрмінала: з яе ўзяты сума і час, нумара чэка на ёй няма. Параўнайце з раздрукоўкай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je doklad z platebního terminálu. Částka a čas pocházejí z něj, číslo účtenky neobsahuje. Porovnejte údaje s papírovým dokladem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Bon eines Kartenterminals: Summe und Uhrzeit stammen daher, ein Bon hat keine Belegnummer. Vergleichen Sie mit dem Papier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a card terminal slip: the sum and the time come from it, a slip has no receipt number. Compare with the paper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un comprobante de terminal de tarjeta: la suma y la hora salen de él, y un comprobante no tiene número de recibo. Compare con el papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un reçu de terminal de carte : la somme et l'heure en viennent, un reçu n'a pas de numéro de ticket. Comparez avec le papier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա քարտային տերմինալի կտրոն է․ գումարն ու ժամը վերցված են դրանից, իսկ կտրոնի համար այն չունի։ Համեմատեք թղթային կտրոնի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una ricevuta del terminale: l’importo e l’ora provengono da essa, ma non contiene un numero di scontrino. Confronta con la stampa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはカードの利用控えです。金額と時刻を読み取りました。利用控えにレシート番号はありません。原本と照合してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ბარათის ტერმინალის ამონაბეჭდია: თანხა და დრო მისგანაა აღებული, ქვითრის ნომერი კი მას არ აქვს. შეადარეთ ქაღალდის ამონაბეჭდს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл карта терминалының қағазы: сома мен уақыт осыдан алынады, қағазда чек нөмірі жоқ. Қағазбен салыстырыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 전표에서 금액과 시간을 읽었습니다. 카드 전표에는 영수증 번호가 없습니다. 전표와 비교하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул карта терминалынын түбөлүгү: сумма жана убакыт андан алынды, түбөлүктө чек номери болбойт. Кагаздагы түбөлүк менен салыштырыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een pinbon: het bedrag en de tijd zijn hiervan overgenomen. Een pinbon heeft geen bonnummer. Vergelijk ze met de papieren bon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To potwierdzenie z terminala. Kwotę i godzinę odczytano z wydruku, który nie zawiera numeru paragonu. Porównaj z wydrukiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um recibo de cartão: o valor e o horário foram lidos dele. Recibos de cartão não têm número de comprovante fiscal. Compare com o papel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é um talão de pagamento com cartão: o valor e a hora foram lidos do talão, que não tem número de recibo. Compare com o documento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это слип терминала: сумма и время взяты с него, номера чека на слипе нет. Сверьте с бумагой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин расиди терминали корт аст: маблағ ва вақт аз он гирифта шудаанд. Расид рақами чек надорад. Бо нусхаи коғазӣ муқоиса кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir kart terminali slipidir. Tutar ve saat slipten alınmıştır; slipte fiş numarası bulunmaz. Basılı sliple karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це квитанція карткового термінала: з неї взято суму й час, номера чека вона не має. Звірте з паперовим документом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu karta terminali kvitansiyasi: summa va vaqt undan olindi, unda chek raqami yo‘q. Qog‘ozdagi ma’lumotlar bilan solishtiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是刷卡凭条：金额和时间来自凭条，凭条没有小票编号。请与纸质凭条核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是刷卡機簽帳單：金額和時間取自簽帳單，簽帳單沒有收據號碼。請與紙本核對。"
          }
        }
      }
    },
