    "receipt.iphone.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaxınlıqda eyni Apple ID ilə daxil olmuş, Wi-Fi və Bluetooth-u aktiv olan iPhone və ya iPad lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбны iPhone або iPad побач, з тым жа Apple ID і ўключанымі Wi-Fi і Bluetooth."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje iPhone nebo iPad v blízkosti, přihlášený ke stejnému Apple ID a se zapnutou Wi-Fi a Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht ein iPhone oder iPad in der Nähe, angemeldet mit derselben Apple-ID, mit eingeschaltetem WLAN und Bluetooth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs an iPhone or iPad nearby, signed in with the same Apple ID, with Wi-Fi and Bluetooth on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta un iPhone o iPad cerca, con la misma cuenta de Apple, con Wi-Fi y Bluetooth activados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut un iPhone ou un iPad à proximité, connecté au même identifiant Apple, avec le Wi-Fi et le Bluetooth activés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անհրաժեշտ է մոտակայքում գտնվող iPhone կամ iPad՝ նույն Apple ID-ով մուտք գործած և միացված Wi-Fi-ով ու Bluetooth-ով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede un iPhone o iPad nelle vicinanze, con lo stesso Apple ID e Wi-Fi e Bluetooth attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じApple IDでサインインし、Wi-FiとBluetoothがオンになっているiPhoneまたはiPadが近くに必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საჭიროა ახლოს მდებარე iPhone ან iPad, რომელზეც შესულია იგივე Apple ID და ჩართულია Wi-Fi და Bluetooth."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жақын жерде iPhone немесе iPad керек, бірдей Apple ID-мен кірген, Wi-Fi және Bluetooth қосулы."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 Apple ID로 로그인하고 Wi-Fi와 Bluetooth를 켠 iPhone 또는 iPad가 가까이 있어야 합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жакын жерде ошол эле Apple ID менен кирген, Wi-Fi жана Bluetooth күйгүзүлгөн iPhone же iPad керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiervoor is een iPhone of iPad in de buurt nodig, ingelogd met dezelfde Apple ID en met wifi en Bluetooth ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga iPhone’a lub iPada w pobliżu, zalogowanego na to samo Apple ID, z włączonym Wi-Fi i Bluetooth."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer um iPhone ou iPad por perto, com a mesma Conta Apple e Wi-Fi e Bluetooth ativados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer um iPhone ou iPad por perto, com sessão iniciada no mesmo ID Apple e com Wi-Fi e Bluetooth ativados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен iPhone или iPad рядом, с тем же Apple ID и включёнными Wi-Fi и Bluetooth."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ё iPad бояд дар наздикӣ бошад, бо ҳамон Apple ID ворид шуда бошад ва Wi-Fi ва Bluetooth фаъол бошанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınınızda, aynı Apple ID ile giriş yapılmış ve Wi-Fi ile Bluetooth açık olan bir iPhone veya iPad gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен iPhone або iPad поруч із тим самим Apple ID та ввімкненими Wi-Fi і Bluetooth."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaqinda bir xil Apple ID bilan kirilgan, Wi-Fi va Bluetooth yoqilgan iPhone yoki iPad bo‘lishi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要附近有已登录同一 Apple ID 的 iPhone 或 iPad，且已开启 Wi-Fi 和蓝牙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要附近有已登入相同 Apple ID 的 iPhone 或 iPad，且 Wi-Fi 和藍牙皆已開啟。"
          }
        }
      }
    },
