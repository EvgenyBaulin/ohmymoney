            "value": "Pressione ⌘Z para desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima ⌘Z para anular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z отменит."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z амалро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri almak için ⌘Z tuşlarına basın."
          }
