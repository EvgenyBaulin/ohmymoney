    "receipt.already": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This receipt is already recorded: “%1$@”, %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recibo ya está registrado: «%1$@», %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ticket est déjà noté : « %1$@ », %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чек уже записан: «%1$@», %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чек уже записано: «%1$@», %2$@."
          }
        }
      }
    },
    "receipt.already.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same receipt is not added twice. To record it again, delete that operation first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo recibo no se añade dos veces. Para registrarlo de nuevo, elimine antes esa operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même ticket n'est pas ajouté deux fois. Pour le noter à nouveau, supprimez d'abord cette opération."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один чек дважды не добавляется. Чтобы записать его заново, сначала удалите ту операцию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Той самий чек не додається двічі. Щоб записати його знову, спочатку видаліть ту операцію."
          }
        }
      }
    },
