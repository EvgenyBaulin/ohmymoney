    "receipt.done.time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time %@ is added."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время %@ добавлено."
          }
        }
      }
