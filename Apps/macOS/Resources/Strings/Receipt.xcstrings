    "receipt.drop": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Və ya QR kodlu şəkli bura buraxın: foto və ya ekran görüntüsü."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Або перацягніце сюды выяву з QR-кодам: фота ці здымак экрана."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebo sem přetáhněte obrázek s QR kódem: fotku nebo snímek obrazovky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder ziehen Sie hier ein Bild mit dem QR-Code hinein: ein Foto, einen Screenshot."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or drop a picture with the QR code here: a photo, a screenshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O arrastre aquí una imagen con el código QR: una foto, una captura de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou déposez ici une image avec le QR code : une photo, une capture d'écran."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կամ այստեղ գցեք QR կոդով նկար՝ լուսանկար կամ սքրինշոթ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure trascina qui un’immagine con il codice QR: una foto o un’istantanea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または、QRコードが写った写真やスクリーンショットをここにドロップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ან გადმოაგდეთ აქ QR კოდის სურათი: ფოტო ან ეკრანის ანაბეჭდი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немесе QR-коды бар суретті осында тастаңыз: фото, скриншот."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 QR 코드가 있는 사진이나 스크린샷을 여기에 놓으세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Же QR коду бар сүрөттү бул жерге таштаңыз: фото же скриншот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of sleep hier een afbeelding met de QR-code naartoe: een foto of schermafbeelding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz też upuścić tutaj obraz z kodem QR: zdjęcie lub zrzut ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou solte aqui uma imagem com o código QR: uma foto ou captura de tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou arraste para aqui uma imagem com o código QR: uma fotografia ou captura de ecrã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или перетащите сюда картинку с QR-кодом: фото, скриншот."
