    "receipt.backToFound": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вярнуцца да знойдзенага"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zum gefundenen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the one found"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табылғанға қайту"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуться к найденной"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад до знайденого"
          }
        }
      }
    },
    "receipt.bill": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта рахунак, а не чэк: аплата яшчэ наперадзе. Пасля аплаты сфатаграфуйце чэк або квітанцыю тэрмінала."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Rechnung, kein Beleg: Die Zahlung steht noch aus. Fotografieren Sie den Beleg oder den Kartenbon nach der Zahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a bill, not a receipt: the payment is still to come. Photograph the receipt or the card slip after paying."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл шот, чек емес: төлем әлі алда. Төлегеннен кейін чекті немесе карта төлемінің қағазын суретке түсіріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это счёт, а не чек: оплата ещё впереди. Сфотографируйте чек или слип терминала после оплаты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це рахунок, а не чек: оплату ще не здійснено. Сфотографуйте чек або квитанцію термінала після оплати."
          }
        }
      }
    },
    "receipt.camera.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недаступная. Выберыце выяву."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht verfügbar. Wählen Sie stattdessen ein Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is not available. Choose a picture instead."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера қолжетімсіз. Орнына сурет таңдаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Выберите картинку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Натомість виберіть зображення."
          }
        }
      }
    },
