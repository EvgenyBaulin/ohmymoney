    "receipt.already": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Beleg ist schon erfasst: „%1$@“, %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This receipt is already recorded: “%1$@”, %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чек уже записан: «%1$@», %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чек уже записано: «%1$@», %2$@."
          }
        }
      }
    },
    "receipt.already.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Beleg wird nicht zweimal hinzugefügt. Um ihn erneut zu erfassen, löschen Sie zuerst diesen Vorgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same receipt is not added twice. To record it again, delete that operation first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один чек дважды не добавляется. Чтобы записать его заново, сначала удалите ту операцию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Той самий чек не додається двічі. Щоб записати його знову, спочатку видаліть ту операцію."
          }
        }
      }
    },
    "receipt.anotherReceipt": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Beleg"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another receipt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой чек"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший чек"
          }
        }
      }
    },
    "receipt.backToFound": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zum gefundenen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the one found"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуться к найденной"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад до знайденого"
          }
        }
      }
    },
    "receipt.bill": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Rechnung, kein Beleg: Die Zahlung steht noch aus. Fotografieren Sie den Beleg oder den Kartenbon nach der Zahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a bill, not a receipt: the payment is still to come. Photograph the receipt or the card slip after paying."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это счёт, а не чек: оплата ещё впереди. Сфотографируйте чек или слип терминала после оплаты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це рахунок, а не чек: оплату ще не здійснено. Сфотографуйте чек або квитанцію термінала після оплати."
          }
        }
      }
    },
    "receipt.camera.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht verfügbar. Wählen Sie stattdessen ein Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is not available. Choose a picture instead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Выберите картинку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Натомість виберіть зображення."
          }
        }
      }
    },
    "receipt.cancel": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати"
          }
        }
      }
    },
    "receipt.check.numbers": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Aufdruck gelesen. Die Steuernummern haben die Prüfungen nicht bestanden, daher wird der Beleg ohne sie erfasst. Vergleichen Sie Summe und Datum mit dem Papier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the print. The fiscal numbers did not pass the checks, so the receipt is recorded without them. Compare the sum and the date with the paper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано с печати. Номера ФН, ФД и ФП не прошли проверку, поэтому чек записывается без них. Сверьте сумму и дату с бумагой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано з друку. Фіскальні номери не пройшли перевірки, тому чек записується без них. Звірте суму й дату з паперовим чеком."
          }
        }
      }
    },
    "receipt.check.other": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Summe und Datum wurden aus dem Aufdruck gelesen, ohne Positionen und ohne Belegnummer. Vergleichen Sie mit dem Papier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the total and the date were read from the print, with no lines and no receipt number. Compare with the paper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитаны только итог и дата с печати, без позиций и номера чека. Сверьте с бумагой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З друку прочитано лише підсумок і дату, без позицій та номера чека. Звірте з паперовим чеком."
          }
        }
      }
    },
    "receipt.check.printed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Aufdruck gelesen, nicht aus einem QR-Code. Vergleichen Sie Summe, Datum und Nummern mit dem Papier, bevor Sie erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the print, not from a QR code. Compare the sum, the date and the numbers with the paper before recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано с печати, а не с QR-кода. Сверьте сумму, дату и номера с бумагой, прежде чем записывать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано з друку, а не з QR-коду. Перед записом звірте суму, дату й номери з паперовим чеком."
          }
        }
      }
    },
    "receipt.check.slip": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Bon eines Kartenterminals: Summe und Uhrzeit stammen daher, ein Bon hat keine Belegnummer. Vergleichen Sie mit dem Papier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a card terminal slip: the sum and the time come from it, a slip has no receipt number. Compare with the paper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это слип терминала: сумма и время взяты с него, номера чека на слипе нет. Сверьте с бумагой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це квитанція карткового термінала: з неї взято суму й час, номера чека вона не має. Звірте з паперовим документом."
          }
        }
      }
    },
