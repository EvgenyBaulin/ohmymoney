    "receipt.similar.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəlkə bunlardan biridir? Məbləğ bir az fərqlənir (yuvarlaqlaşdırma və ya bəxşiş)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Або гэта адна з іх? Сума крыху адрозніваецца праз акругленне або чаявыя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není to některá z těchto operací? Částka se mírně liší, například kvůli zaokrouhlení nebo spropitnému."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder ist es einer von diesen? Die Summe weicht etwas ab (eine Rundung oder ein Trinkgeld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or is it one of these? The sum differs a little (a rounding or a tip)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿O es una de estas? La suma difiere un poco (un redondeo o una propina)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou est-ce l'une de celles-ci ? La somme diffère un peu (un arrondi ou un pourboire)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կամ գուցե սրանցի՞ց մեկն է։ Գումարը փոքր-ինչ տարբերվում է՝ կլորացման կամ թեյավճարի պատճառով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure è una di queste? L’importo è leggermente diverso, per un arrotondamento o una mancia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こちらの取引ですか？金額が少し異なります（端数処理やチップ）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ან ერთ-ერთი მათგანია? თანხა ოდნავ განსხვავდება (დამრგვალება ან ჩაის ფული)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немесе осылардың бірі ме? Сома сәл өзгеше (дөңгелектеу не сыйақы)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 거래 중 하나인가요? 금액이 조금 다릅니다(반올림 또는 팁)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Же булардын бириби? Суммасы бир аз айырмаланат (тегеректөө же чайпул)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of is het een van deze? Het bedrag wijkt iets af, bijvoorbeeld door afronding of fooi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "A może to jedna z tych operacji? Kwota nieco się różni, np. z powodu zaokrąglenia lub napiwku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou é uma destas? O valor é um pouco diferente (por arredondamento ou gorjeta)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou será uma destas? O valor difere ligeiramente (arredondamento ou gorjeta)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или это одна из этих? Сумма чуть отличается (округление или чаевые)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ё яке аз инҳост? Маблағ каме фарқ мекунад (яклухткунӣ ё ҳақчой)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoksa bunlardan biri mi? Tutar biraz farklı (yuvarlama veya bahşiş nedeniyle)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можливо, це одна з цих операцій? Сума трохи відрізняється через округлення або чайові."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoki bulardan birimi? Summa biroz farq qiladi (yaxlitlash yoki choychaqa)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者是以下交易之一？金额略有不同，可能是舍入或小费所致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或是以下其中一筆？金額略有差異（可能是四捨五入或小費）。"
          }
        }
      }
    },
    "receipt.subtitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kassa çekindəki koddan məbləği, tarixi və vaxtı oxuyur. Heç nə şəbəkəyə göndərilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Счытвае суму, дату і час з кода на касавым чэку. Даныя не адпраўляюцца ў сетку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načte částku, datum a čas z kódu na pokladní účtence. Nic se neodesílá po síti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest Summe, Datum und Uhrzeit aus dem Code auf einem Kassenbeleg. Nichts wird ins Netz geschickt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the sum, the date and the time from the code on a cash receipt. Nothing goes to the network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee la suma, la fecha y la hora del código de un recibo de caja. Nada se envía a la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit la somme, la date et l'heure depuis le QR code d'un ticket de caisse. Rien ne part sur le réseau."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարդում է գումարը, ամսաթիվն ու ժամը դրամարկղային կտրոնի կոդից։ Տվյալները ցանց չեն ուղարկվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge importo, data e ora dal codice su uno scontrino. Nessun dato viene inviato in rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートのQRコードから金額、日付、時刻を読み取ります。データはネットワークに送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კითხულობს თანხას, თარიღსა და დროს სალაროს ქვითრის კოდიდან. მონაცემები ქსელში არ იგზავნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолма-қол чектің кодынан соманы, күнді және уақытты оқиды. Ештеңе желіге жіберілмейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증의 코드에서 금액, 날짜 및 시간을 읽습니다. 데이터는 네트워크로 전송되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кассалык чектеги коддон сумманы, күндү жана убакытты окуйт. Маалымат тармакка жөнөтүлбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest het bedrag, de datum en de tijd uit de code op een kassabon. Er wordt niets via het netwerk verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje kwotę, datę i godzinę z kodu na paragonie. Dane nie są przesyłane do sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o valor, a data e o horário do código em um comprovante fiscal. Nada é enviado pela rede."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o valor, a data e a hora do código num recibo. Nenhum dado é enviado pela rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берёт сумму, дату и время из кода на кассовом чеке. В сеть ничего не уходит."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағ, сана ва вақтро аз рамзи чеки хазинавӣ мехонад. Маълумот ба шабака фиристода намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa fişindeki koddan tutarı, tarihi ve saati okur. Ağa hiçbir veri gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає суму, дату й час із коду на касовому чеку. Нічого не надсилає в мережу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kassa cheki kodidan summa, sana va vaqtni o‘qiydi. Ma’lumotlar tarmoqqa yuborilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从小票二维码读取金额、日期和时间。数据不会上传到网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從收據上的 QR 碼讀取金額、日期和時間。不會傳送任何資料至網路。"
          }
        }
      }
    },
    "receipt.supplement.question": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” tapıldı — %2$@ vaxtı əlavə edilsin?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Знойдзена “%1$@” — дадаць час %2$@?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalezena operace „%1$@“. Přidat čas %2$@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ gefunden — Uhrzeit %2$@ hinzufügen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found “%1$@” — add the time %2$@?"
          }
        },
