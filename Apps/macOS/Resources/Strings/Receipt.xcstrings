    "receipt.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "receipt.done.created": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation is recorded."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция записана."
          }
        }
      }
    },
    "receipt.done.time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time %@ is added."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время %@ добавлено."
          }
        }
      }
    },
    "receipt.done.undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z takes it back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z отменит."
          }
        }
      }
    },
    "receipt.drop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or drop a picture with the QR code here: a photo, a screenshot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или перетащите сюда картинку с QR-кодом: фото, скриншот."
          }
        }
      }
    },
    "receipt.facts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt: %1$@ · %2$@ · %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек: %1$@ · %2$@ · %3$@"
          }
        }
      }
    },
    "receipt.failed.gone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That operation was deleted meanwhile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту операцию успели удалить."
          }
        }
      }
    },
    "receipt.failed.noCategory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no “Don't remember” category to file the new operation under. Record it from the entry line."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет категории «Не помню», чтобы записать новую операцию. Запишите её строкой ввода."
          }
        }
      }
    },
    "receipt.failed.notWritten": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write it. Try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось записать. Попробуйте ещё раз."
          }
        }
      }
    },
    "receipt.iphone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo with iPhone…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снять на iPhone…"
          }
        }
      }
    },
    "receipt.iphone.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs an iPhone or iPad nearby, signed in with the same Apple ID, with Wi-Fi and Bluetooth on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен iPhone или iPad рядом, с тем же Apple ID и включёнными Wi-Fi и Bluetooth."
          }
        }
      }
    },
    "receipt.iphone.menuHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo from iPhone or iPad (it has to be nearby):"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимок с iPhone или iPad (он должен быть рядом):"
          }
        }
      }
    },
    "receipt.menu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt by QR…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек по QR…"
          }
        }
      }
    },
    "receipt.new.category": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category stays “Don't remember” until you choose it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория останется «Не помню», пока вы её не выберете."
          }
        }
      }
    },
    "receipt.new.refundHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund is recorded on the purchase it takes back: open that purchase and add the refund there."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат записывается на покупку, которую он возвращает: откройте эту покупку и добавьте возврат там."
          }
        }
      }
    },
    "receipt.new.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New operation: %1$@, %2$@ at %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая операция: %1$@, %2$@ в %3$@"
          }
        }
      }
    },
    "receipt.noCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No QR code on the picture. Try a closer, straighter shot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На картинке нет QR-кода. Попробуйте снять ближе и ровнее."
          }
        }
      }
    },
    "receipt.notReceipt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR code is not a cash receipt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это QR-код, но не кассового чека."
          }
        }
      }
    },
    "receipt.operation.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
