    "receipt.noCode": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şəkildə QR kod yoxdur. Daha yaxından və düz bucaqdan çəkin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На выяве няма QR-кода. Паспрабуйце зняць бліжэй і раўней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na obrázku není QR kód. Zkuste fotku pořídit zblízka a zpříma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein QR-Code auf dem Bild. Versuchen Sie eine nähere, gerade Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No QR code on the picture. Try a closer, straighter shot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay código QR en la imagen. Pruebe con una toma más cercana y recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun QR code sur l'image. Essayez une photo plus proche et plus droite."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նկարում QR կոդ չկա։ Փորձեք լուսանկարել ավելի մոտիկից և ուղիղ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun codice QR nell’immagine. Prova a scattare da più vicino e frontalmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像にQRコードがありません。近づいて正面から撮影してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სურათზე QR კოდი ვერ მოიძებნა. გადაიღეთ უფრო ახლოდან და სწორად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суретте QR-код жоқ. Жақынырақ, тіктеу түсірініп көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에 QR 코드가 없습니다. 더 가까이에서 정면으로 촬영해 보세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сүрөттө QR код жок. Жакыныраактан жана түз тартып көрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen QR-code op de afbeelding. Maak een foto van dichterbij en recht van voren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kodu QR na obrazie. Zrób zdjęcie z bliższej odległości i na wprost."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum código QR na imagem. Tente uma foto mais próxima e alinhada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há código QR na imagem. Tente tirar uma fotografia mais próxima e de frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На картинке нет QR-кода. Попробуйте снять ближе и ровнее."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар расм рамзи QR нест. Аз наздиктар ва росттар акс гиред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimde QR kodu bulunamadı. Daha yakından ve düz bir açıyla çekmeyi deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На зображенні немає QR-коду. Спробуйте сфотографувати ближче й рівніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasmda QR kod topilmadi. Yaqinroq va to‘g‘riroq suratga olib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片中没有二维码。请靠近并正对小票拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片中沒有 QR 碼。請靠近並正對 QR 碼重新拍攝。"
          }
        }
      }
    },
