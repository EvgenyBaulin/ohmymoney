{
  "sourceLanguage": "en",
  "strings": {
    "receipt.addTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the time"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить время"
          }
        }
      }
    },
    "receipt.addTimePhoto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add time and photo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить время и фото"
          }
        }
      }
    },
    "receipt.already": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This receipt is already recorded: “%1$@”, %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чек уже записан: «%1$@», %2$@."
          }
        }
      }
    },
    "receipt.already.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same receipt is not added twice. To record it again, delete that operation first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один чек дважды не добавляется. Чтобы записать его заново, сначала удалите ту операцию."
          }
        }
      }
    },
    "receipt.anotherReceipt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another receipt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой чек"
          }
        }
      }
    },
    "receipt.backToFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the one found"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуться к найденной"
          }
        }
      }
    },
    "receipt.bill": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a bill, not a receipt: the payment is still to come. Photograph the receipt or the card slip after paying."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это счёт, а не чек: оплата ещё впереди. Сфотографируйте чек или слип терминала после оплаты."
          }
        }
      }
    },
    "receipt.camera.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is not available. Choose a picture instead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Выберите картинку."
          }
        }
      }
    },
    "receipt.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "receipt.check.numbers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the print. The fiscal numbers did not pass the checks, so the receipt is recorded without them. Compare the sum and the date with the paper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано с печати. Номера ФН, ФД и ФП не прошли проверку, поэтому чек записывается без них. Сверьте сумму и дату с бумагой."
          }
        }
      }
    },
    "receipt.check.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the total and the date were read from the print, with no lines and no receipt number. Compare with the paper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитаны только итог и дата с печати, без позиций и номера чека. Сверьте с бумагой."
          }
        }
      }
    },
    "receipt.check.printed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the print, not from a QR code. Compare the sum, the date and the numbers with the paper before recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано с печати, а не с QR-кода. Сверьте сумму, дату и номера с бумагой, прежде чем записывать."
          }
        }
      }
    },
    "receipt.check.slip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a card terminal slip: the sum and the time come from it, a slip has no receipt number. Compare with the paper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это слип терминала: сумма и время взяты с него, номера чека на слипе нет. Сверьте с бумагой."
          }
        }
      }
    },
    "receipt.choices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching operations"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящие операции"
          }
        }
      }
    },
    "receipt.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a picture…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать картинку…"
          }
        }
      }
    },
