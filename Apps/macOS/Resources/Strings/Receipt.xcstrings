          }
        }
      }
    },
    "receipt.facts": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt: %1$@ · %2$@ · %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibo: %1$@ · %2$@ · %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ticket : %1$@ · %2$@ · %3$@"
          }
