    "receipt.already": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çek artıq qeydə alınıb: “%1$@”, %2$@."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты чэк ужо запісаны: “%1$@”, %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato účtenka už je zaznamenaná: „%1$@“, %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Beleg ist schon erfasst: „%1$@“, %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This receipt is already recorded: “%1$@”, %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recibo ya está registrado: «%1$@», %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ticket est déjà noté : « %1$@ », %2$@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս կտրոնն արդեն գրանցված է՝ «%1$@», %2$@։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo scontrino è già stato registrato: “%1$@”, %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレシートは登録済みです：“%1$@”、%2$@。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ქვითარი უკვე აღრიცხულია: “%1$@”, %2$@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл чек бұрын жазылған: “%1$@”, %2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 등록된 영수증: “%1$@”, %2$@."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул чек мурунтан катталган: “%1$@”, %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bon is al vastgelegd: ‘%1$@’, %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten paragon jest już zapisany: „%1$@”, %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comprovante já foi registrado: “%1$@”, %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recibo já está registado: “%1$@”, %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чек уже записан: «%1$@», %2$@."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин чек аллакай сабт шудааст: “%1$@”, %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fiş zaten kaydedilmiş: “%1$@”, %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чек уже записано: «%1$@», %2$@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu chek allaqachon qayd etilgan: “%1$@”, %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张小票已记录：“%1$@”，%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張收據已記錄：「%1$@」，%2$@。"
          }
        }
      }
    },
    "receipt.already.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyni çek iki dəfə əlavə edilmir. Yenidən qeydə almaq üçün əvvəlcə həmin əməliyyatı silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адзін і той жа чэк не дадаецца двойчы. Каб запісаць яго зноў, спачатку выдаліце гэту аперацыю."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stejnou účtenku nelze přidat dvakrát. Pokud ji chcete zaznamenat znovu, nejprve smažte původní operaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Beleg wird nicht zweimal hinzugefügt. Um ihn erneut zu erfassen, löschen Sie zuerst diesen Vorgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same receipt is not added twice. To record it again, delete that operation first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo recibo no se añade dos veces. Para registrarlo de nuevo, elimine antes esa operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même ticket n'est pas ajouté deux fois. Pour le noter à nouveau, supprimez d'abord cette opération."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նույն կտրոնը երկու անգամ չի ավելացվում։ Կրկին գրանցելու համար նախ ջնջեք այդ գործարքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso scontrino non viene aggiunto due volte. Per registrarlo di nuovo, elimina prima l’operazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じレシートは重複して追加できません。もう一度登録するには、先にその取引を削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთი და იგივე ქვითარი ორჯერ არ ემატება. ხელახლა აღსარიცხად ჯერ წაშალეთ ეს ოპერაცია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірдей чек екі рет қосылмайды. Оны қайта жазу үшін алдымен сол операцияны жойыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 영수증은 두 번 추가할 수 없습니다. 다시 등록하려면 먼저 해당 거래를 삭제하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир эле чек эки жолу кошулбайт. Кайра каттоо үчүн алгач ошол операцияны өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezelfde bon wordt niet twee keer toegevoegd. Verwijder eerst de transactie om de bon opnieuw vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam paragon nie jest dodawany dwa razy. Aby zapisać go ponownie, najpierw usuń tę operację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo comprovante não é adicionado duas vezes. Para registrá-lo novamente, apague a operação primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo recibo não é adicionado duas vezes. Para o registar novamente, apague primeiro essa operação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один чек дважды не добавляется. Чтобы записать его заново, сначала удалите ту операцию."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Як чек ду бор илова намешавад. Барои сабти дубора, аввал он амалиётро нест кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı fiş iki kez eklenmez. Tekrar kaydetmek için önce o işlemi silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Той самий чек не додається двічі. Щоб записати його знову, спочатку видаліть ту операцію."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir chek ikki marta qo‘shilmaydi. Uni qayta kiritish uchun avval shu operatsiyani o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一张小票不会重复添加。如需再次记录，请先删除该笔交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一張收據不會重複加入。若要再次記錄，請先刪除該筆交易。"
          }
        }
      }
    },
