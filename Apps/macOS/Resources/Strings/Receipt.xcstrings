          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "операцию"
          }
        }
      }
    },
    "receipt.otherPurchase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is another purchase"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это другая покупка"
          }
        }
      }
    },
    "receipt.photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотографии"
          }
        }
      }
    },
    "receipt.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for the QR code…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищем QR-код…"
          }
        }
      }
    },
    "receipt.refund": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a refund of a purchase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это возврат покупки."
          }
        }
      }
    },
    "receipt.scan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with the camera"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навести камеру"
          }
        }
      }
    },
    "receipt.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the sum, the date and the time from the code on a cash receipt. Nothing goes to the network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берёт сумму, дату и время из кода на кассовом чеке. В сеть ничего не уходит."
          }
        }
      }
    },
    "receipt.supplement.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found “%1$@” — add the time %2$@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нашли «%1$@» — добавить время %2$@?"
          }
        }
      }
    },
    "receipt.supplement.question.photo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found “%1$@” — add the time %2$@ and the photo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нашли «%1$@» — добавить время %2$@ и фото?"
          }
        }
      }
    },
    "receipt.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt by QR"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек по QR"
          }
        }
      }
    }
