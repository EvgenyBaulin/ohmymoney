    "receipt.new.refundHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytarma aid olduğu alışda qeydə alınır: həmin alışı açın və qaytarmanı əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне запісваецца ў адпаведнай пакупцы: адкрыйце яе і дадайце вяртанне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrácení peněz se zaznamenává u příslušného nákupu. Otevřete nákup a přidejte vrácení tam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erstattung wird auf dem Kauf erfasst, den sie zurücknimmt: Öffnen Sie diesen Kauf und tragen Sie die Erstattung dort ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund is recorded on the purchase it takes back: open that purchase and add the refund there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución se registra en la compra que anula: abra esa compra y añada la devolución allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement se note sur l'achat qu'il annule : ouvrez cet achat et ajoutez-y le remboursement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերադարձը գրանցվում է համապատասխան գնման մեջ․ բացեք գնումը և այնտեղ ավելացրեք վերադարձը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rimborso si registra sull’acquisto a cui si riferisce: apri l’acquisto e aggiungi il rimborso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金は元の購入に登録します。その購入を開き、返金を追加してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხის დაბრუნება აღირიცხება შესაბამის შესყიდვაზე: გახსენით შესყიდვა და იქ დაამატეთ დაბრუნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтару сол қайтаратын сатып алуға жазылады: сол сатып алуды ашып, қайтаруды сонда қосыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환불은 해당 구매에 등록됩니다. 구매 내역을 열고 환불을 추가하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кайтарым тиешелүү сатып алууда катталат: ошол сатып алууну ачып, кайтарымды кошуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een terugbetaling leg je vast bij de oorspronkelijke aankoop. Open die aankoop en voeg daar de terugbetaling toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot zapisuje się przy zakupie, którego dotyczy. Otwórz ten zakup i dodaj zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso é registrado na compra correspondente: abra a compra e adicione o reembolso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O reembolso é registado na compra a que diz respeito: abra essa compra e adicione aí o reembolso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат записывается на покупку, которую он возвращает: откройте эту покупку и добавьте возврат там."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баргардонидани маблағ дар худи харид сабт мешавад: он харидро кушоед ва баргардониданро дар он илова кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İade, ilgili alışverişe kaydedilir. Alışverişi açıp iadeyi oraya ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення записується до початкової покупки: відкрийте її та додайте повернення там."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul qaytarilishi tegishli xaridga qo‘shiladi: xaridni ochib, qaytarilishni o‘sha yerga qo‘shing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款记录在原购买交易中：请打开该交易并添加退款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款會記錄在原購買交易中：請開啟該筆購買交易並加入退款。"
          }
        }
      }
    },
