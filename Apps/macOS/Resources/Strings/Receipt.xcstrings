    "screenshot.needsTime": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam uyğunluq yoxdur. 24 saat ərzində axtarmaq üçün ekran görüntüsündəki vaxtı daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дакладных супадзенняў няма. Увядзіце час са здымка экрана для пошуку ў межах 24 гадзін."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná přesná shoda. Zadejte čas ze snímku obrazovky pro hledání v rozmezí 24 hodin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine genaue Übereinstimmung. Tragen Sie die Uhrzeit aus dem Screenshot ein, um innerhalb von 24 Stunden zu suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No exact match. Enter the time shown in the screenshot to look within 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay coincidencia exacta. Escriba la hora que muestra la captura para buscar en un margen de 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de correspondance exacte. Saisissez l'heure affichée sur la capture pour chercher dans les 24 heures."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ճշգրիտ համընկնում չկա։ 24 ժամվա միջակայքում որոնելու համար մուտքագրեք սքրինշոթում նշված ժամը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna corrispondenza esatta. Inserisci l’ora mostrata nell’istantanea per cercare entro 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に一致する取引はありません。24時間以内を検索するには、スクリーンショットに表示された時刻を入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზუსტი დამთხვევა ვერ მოიძებნა. 24-საათიან შუალედში მოსაძებნად შეიყვანეთ ეკრანის ანაბეჭდზე ნაჩვენები დრო."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәл сәйкес жоқ. 24 сағат ішінде іздеу үшін скриншотта көрсетілген уақытты теріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확히 일치하는 거래가 없습니다. 24시간 이내의 거래를 찾으려면 스크린샷에 표시된 시간을 입력하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Так дал келген операция жок. 24 сааттын ичинде издөө үчүн скриншоттогу убакытты киргизиңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen exacte overeenkomst. Voer de tijd op de schermafbeelding in om binnen 24 uur te zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dokładnego dopasowania. Wpisz godzinę ze zrzutu ekranu, aby przeszukać zakres 24 godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma correspondência exata. Digite o horário mostrado na captura de tela para buscar em um intervalo de 24 horas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem correspondência exata. Introduza a hora mostrada na captura de ecrã para procurar num intervalo de 24 horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точного совпадения нет. Укажите время со скриншота для поиска в пределах суток."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мувофиқати дақиқ нест. Барои ҷустуҷӯ дар давоми 24 соат вақти дар скриншот нишондодашударо ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam eşleşme yok. 24 saat içinde aramak için ekran görüntüsündeki saati girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точного збігу немає. Введіть час зі знімка екрана для пошуку в межах 24 годин."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘liq mos operatsiya topilmadi. 24 soat oralig‘ida qidirish uchun skrinshotdagi vaqtni kiriting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有完全匹配项。输入截屏中显示的时间，以搜索 24 小时内的交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有完全符合的交易。請輸入截圖中顯示的時間，以搜尋 24 小時內的交易。"
          }
        }
      }
    },
