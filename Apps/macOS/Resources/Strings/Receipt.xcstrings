    "screenshot.confirmFacts": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanınan məlumatları yoxlayın və hesab seçin. Açmaq üçün uyğun əməliyyatı seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праверце распазнаныя даныя і выберыце рахунак. Выберыце супадзенне, каб адкрыць яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte rozpoznané údaje a vyberte účet. Klepnutím na shodu ji otevřete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie die erkannten Angaben und wählen Sie ein Konto. Wählen Sie eine Übereinstimmung, um sie zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the recognized details and choose an account. Select a match to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise los datos reconocidos y elija una cuenta. Seleccione una coincidencia para abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les détails reconnus et choisissez un compte. Sélectionnez une correspondance pour l'ouvrir."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստուգեք ճանաչված տվյալները և ընտրեք հաշիվ։ Բացելու համար ընտրեք համընկնող գործարքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i dati riconosciuti e scegli un conto. Seleziona una corrispondenza per aprirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識された内容を確認し、口座を選択してください。一致する取引を選択すると開きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეამოწმეთ ამოცნობილი მონაცემები და აირჩიეთ ანგარიში. გასახსნელად აირჩიეთ შესაბამისი ოპერაცია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Танылған мәліметтерді тексеріп, есеп-шотты таңдаңыз. Сәйкесті таңдап, оны ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식된 정보를 확인하고 계좌를 선택하세요. 일치하는 거래를 선택하여 여세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Таанылган маалыматтарды текшерип, эсеп тандаңыз. Ачуу үчүн дал келген операцияны тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de herkende gegevens en kies een rekening. Selecteer een overeenkomst om deze te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź rozpoznane dane i wybierz konto. Wybierz pasującą operację, aby ją otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira os dados reconhecidos e escolha uma conta. Selecione um resultado para abri-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique os dados reconhecidos e escolha uma conta. Selecione uma correspondência para a abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте распознанные данные и выберите счёт. Совпадение откроется только по вашему выбору."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумоти шинохташударо санҷед ва ҳисобро интихоб кунед. Барои кушодан мувофиқатро интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Algılanan bilgileri kontrol edin ve bir hesap seçin. Açmak için bir eşleşme seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте розпізнані дані й виберіть рахунок. Виберіть збіг, щоб відкрити його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Aniqlangan ma’lumotlarni tekshiring va hisobni tanlang. Ochish uchun mos operatsiyani tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查识别出的信息并选择账户。选择匹配项以打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查辨識出的資料並選擇帳戶。選取符合的交易以開啟。"
          }
        }
      }
    },
