        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z를 눌러 실행 취소할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z менен артка кайтарсаңыз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op ⌘Z om dit ongedaan te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij ⌘Z, aby cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
