        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” табылды — %2$@ уақытын қосайық па?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”을(를) 찾았습니다. 시간 %2$@을(를) 추가할까요?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” табылды — %2$@ убактысы кошулсунбу?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ gevonden. Tijd %2$@ toevoegen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaleziono „%1$@” — dodać godzinę %2$@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” encontrado — adicionar o horário %2$@?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrada “%1$@” — adicionar a hora %2$@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нашли «%1$@» — добавить время %2$@?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ёфт шуд — вақти %2$@ илова шавад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” bulundu. %2$@ saati eklensin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдено «%1$@» — додати час %2$@?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” topildi — %2$@ vaqtini qo‘shilsinmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到“%1$@”，要添加时间 %2$@ 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找到「%1$@」——要加入時間 %2$@ 嗎？"
          }
        }
      }
    },
