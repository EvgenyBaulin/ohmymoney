    "receipt.already": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты чэк ужо запісаны: “%1$@”, %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Beleg ist schon erfasst: „%1$@“, %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This receipt is already recorded: “%1$@”, %2$@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл чек бұрын жазылған: “%1$@”, %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чек уже записан: «%1$@», %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чек уже записано: «%1$@», %2$@."
          }
        }
      }
    },
    "receipt.already.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адзін і той жа чэк не дадаецца двойчы. Каб запісаць яго зноў, спачатку выдаліце гэту аперацыю."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Beleg wird nicht zweimal hinzugefügt. Um ihn erneut zu erfassen, löschen Sie zuerst diesen Vorgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same receipt is not added twice. To record it again, delete that operation first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірдей чек екі рет қосылмайды. Оны қайта жазу үшін алдымен сол операцияны жойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один чек дважды не добавляется. Чтобы записать его заново, сначала удалите ту операцию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Той самий чек не додається двічі. Щоб записати його знову, спочатку видаліть ту операцію."
          }
        }
      }
    },
    "receipt.anotherReceipt": {
