    "receipt.new.category": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category stays “Don't remember” until you choose it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория останется «Не помню», пока вы её не выберете."
          }
        }
      }
    },
    "receipt.new.refundHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund is recorded on the purchase it takes back: open that purchase and add the refund there."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат записывается на покупку, которую он возвращает: откройте эту покупку и добавьте возврат там."
          }
        }
      }
    },
    "receipt.new.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New operation: %1$@, %2$@ at %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая операция: %1$@, %2$@ в %3$@"
          }
        }
      }
    },
    "receipt.noCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No QR code on the picture. Try a closer, straighter shot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На картинке нет QR-кода. Попробуйте снять ближе и ровнее."
          }
        }
      }
    },
    "receipt.notReceipt": {
