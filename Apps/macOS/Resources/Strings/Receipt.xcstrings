          "stringUnit": {
            "state": "translated",
            "value": "Encontrada «%1$@» — ¿añadir la hora %2$@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » trouvé — ajouter l'heure %2$@ ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գտնվել է «%1$@»․ ավելացնե՞լ %2$@ ժամը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovata “%1$@”: aggiungere l’ora %2$@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”が見つかりました。時刻%2$@を追加しますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაპოვნია “%1$@” — დაემატოს დრო %2$@?"
