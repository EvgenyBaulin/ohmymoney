    "receipt.bill": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a bill, not a receipt: the payment is still to come. Photograph the receipt or the card slip after paying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es una factura, no un recibo: el pago todavía está por llegar. Fotografíe el recibo o el comprobante de la tarjeta después de pagar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est une facture, pas un ticket : le paiement reste à venir. Photographiez le ticket ou le reçu de carte après avoir payé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это счёт, а не чек: оплата ещё впереди. Сфотографируйте чек или слип терминала после оплаты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це рахунок, а не чек: оплату ще не здійснено. Сфотографуйте чек або квитанцію термінала після оплати."
          }
        }
      }
    },
    "receipt.camera.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is not available. Choose a picture instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible. Elija una imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil photo n'est pas disponible. Choisissez une image à la place."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Выберите картинку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Натомість виберіть зображення."
          }
        }
      }
    },
    "receipt.cancel": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
