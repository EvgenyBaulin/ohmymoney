            "value": "⌘Z nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z la deshace."
          }
        },
        "fr": {
          "stringUnit": {
