    "receipt.iphone.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs an iPhone or iPad nearby, signed in with the same Apple ID, with Wi-Fi and Bluetooth on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен iPhone или iPad рядом, с тем же Apple ID и включёнными Wi-Fi и Bluetooth."
          }
        }
      }
    },
    "receipt.iphone.menuHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo from iPhone or iPad (it has to be nearby):"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимок с iPhone или iPad (он должен быть рядом):"
          }
        }
      }
    },
    "receipt.menu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt by QR…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек по QR…"
          }
        }
