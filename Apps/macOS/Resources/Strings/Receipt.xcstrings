    "receipt.new.category": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kateqoriya siz seçənədək “Xatırlamıram” olaraq qalacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыя застанецца “Не памятаю”, пакуль вы яе не выберыце."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie zůstane „Nepamatuji si“, dokud nevyberete jinou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorie bleibt „Nicht erinnert“, bis Sie eine wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category stays “Don't remember” until you choose it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoría se queda en «No recuerdo» hasta que la elija."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie reste « Je ne sais plus » tant que vous n'en choisissez pas une."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կատեգորիան կմնա «Չեմ հիշում», մինչև ընտրեք այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoria resta “Non ricordo” finché non ne scegli una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリを選択するまで、“覚えていない”のままになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორია დარჩება “არ მახსოვს”, სანამ სხვას არ აირჩევთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіз таңдамайынша санат “Есімде жоқ” болып қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리를 선택할 때까지 “기억나지 않음”으로 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияны тандаганга чейин “Эсимде жок” бойдон калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De categorie blijft ‘Weet ik niet meer’ totdat je een categorie kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria pozostanie ustawiona na „Nie pamiętam”, dopóki jej nie zmienisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A categoria permanece como “Não lembro” até você escolher outra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A categoria mantém-se como “Não me lembro” até escolher outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория останется «Не помню», пока вы её не выберете."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То интихоби шумо категория “Дар ёд надорам” мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz seçene kadar kategori “Hatırlamıyorum” olarak kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія залишиться «Не пам'ятаю», доки ви її не виберете."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Turkum tanlanmaguncha “Eslamayman” bo‘lib qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择类别前，将保持为“记不清”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇類別前，會保留「不記得」。"
          }
        }
      }
    },
