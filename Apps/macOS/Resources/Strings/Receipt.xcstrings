            "value": "⌘Z скасовує дію."
          }
        }
      }
    },
    "receipt.done.undo.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Rückgängig“ nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Undo” takes it back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отменить» вернёт всё назад."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скасувати дію» повертає попередній стан."
          }
        }
      }
    },
    "receipt.drop": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder ziehen Sie hier ein Bild mit dem QR-Code hinein: ein Foto, einen Screenshot."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or drop a picture with the QR code here: a photo, a screenshot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или перетащите сюда картинку с QR-кодом: фото, скриншот."
