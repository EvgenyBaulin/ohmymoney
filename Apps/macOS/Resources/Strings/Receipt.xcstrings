    "receipt.failed.noCategory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni əməliyyatı əlavə etmək üçün “Xatırlamıram” kateqoriyası yoxdur. Onu daxiletmə sətrindən qeydə alın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма катэгорыі “Не памятаю” для новай аперацыі. Запішыце яе праз радок уводу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie „Nepamatuji si“ pro zařazení nové operace neexistuje. Zaznamenejte ji pomocí zadávacího řádku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Kategorie „Nicht erinnert“, unter der der neue Vorgang eingeordnet werden könnte. Erfassen Sie ihn über die Eingabezeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no “Don't remember” category to file the new operation under. Record it from the entry line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay categoría «No recuerdo» en la que archivar la nueva operación. Regístrela desde la línea de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de catégorie « Je ne sais plus » où classer la nouvelle opération. Notez-la depuis la ligne de saisie."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Չեմ հիշում» կատեգորիան չկա՝ նոր գործարքն այնտեղ ավելացնելու համար։ Գրանցեք այն մուտքագրման տողից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non esiste una categoria “Non ricordo” in cui inserire la nuova operazione. Registrala dalla riga di inserimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい取引を分類する“覚えていない”カテゴリがありません。入力欄から登録してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალი ოპერაციისთვის კატეგორია “არ მახსოვს” არ არსებობს. აღრიცხეთ ის შეყვანის ველიდან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа операцияны жазатын “Есімде жоқ” санаты жоқ. Оны енгізу жолынан жазыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 거래를 분류할 “기억나지 않음” 카테고리가 없습니다. 입력란에서 등록하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңы операцияны кошуу үчүн “Эсимде жок” категориясы жок. Аны киргизүү сабынан каттаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen categorie ‘Weet ik niet meer’ voor de nieuwe transactie. Leg deze vast via de invoerregel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kategorii „Nie pamiętam” dla nowej operacji. Zapisz ją w wierszu wprowadzania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há uma categoria “Não lembro” para a nova operação. Registre-a no campo de entrada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não existe a categoria “Não me lembro” para a nova operação. Registe-a na linha de introdução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет категории «Не помню», чтобы записать новую операцию. Запишите её строкой ввода."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои сабти амалиёти нав категорияи “Дар ёд надорам” вуҷуд надорад. Онро аз сатри воридкунӣ сабт кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni işlemin kaydedileceği “Hatırlamıyorum” kategorisi bulunamadı. İşlemi giriş satırından kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає категорії «Не пам'ятаю» для нової операції. Запишіть її через рядок вводу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi operatsiyani qo‘shish uchun “Eslamayman” turkumi mavjud emas. Uni kiritish qatoridan qayd eting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有“记不清”类别可供新交易使用。请在输入栏中记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有「不記得」類別可供歸入新交易。請從輸入列記錄。"
          }
        }
      }
    },
