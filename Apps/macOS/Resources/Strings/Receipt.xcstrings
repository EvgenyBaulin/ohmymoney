    "receipt.done.undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z takes it back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z отменит."
          }
        }
      }
    },
    "receipt.done.undo.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Undo” takes it back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отменить» вернёт всё назад."
          }
        }
      }
    },
    "receipt.drop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or drop a picture with the QR code here: a photo, a screenshot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или перетащите сюда картинку с QR-кодом: фото, скриншот."
          }
        }
      }
    },
    "receipt.facts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt: %1$@ · %2$@ · %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек: %1$@ · %2$@ · %3$@"
          }
        }
      }
