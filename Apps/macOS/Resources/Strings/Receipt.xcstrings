    "receipt.done.undo": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z takes it back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z отменит."
          }
        },
        "uk": {
