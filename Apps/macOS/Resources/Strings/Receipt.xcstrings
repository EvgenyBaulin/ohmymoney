    "receipt.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a picture…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать картинку…"
          }
        }
      }
