    "receipt.bill": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, çek deyil, hesabdır: ödəniş hələ edilməyib. Ödənişdən sonra çeki və ya kart qəbzini çəkin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта рахунак, а не чэк: аплата яшчэ наперадзе. Пасля аплаты сфатаграфуйце чэк або квітанцыю тэрмінала."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je účet, ne účtenka. Platba teprve proběhne. Po zaplacení vyfoťte účtenku nebo doklad z terminálu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Rechnung, kein Beleg: Die Zahlung steht noch aus. Fotografieren Sie den Beleg oder den Kartenbon nach der Zahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a bill, not a receipt: the payment is still to come. Photograph the receipt or the card slip after paying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es una factura, no un recibo: el pago todavía está por llegar. Fotografíe el recibo o el comprobante de la tarjeta después de pagar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est une facture, pas un ticket : le paiement reste à venir. Photographiez le ticket ou le reçu de carte après avoir payé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա հաշիվ է, ոչ թե կտրոն․ վճարումը դեռ կատարված չէ։ Վճարելուց հետո լուսանկարեք կտրոնը կամ քարտային վճարման կտրոնը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è un conto, non uno scontrino: il pagamento deve ancora avvenire. Dopo aver pagato, fotografa lo scontrino o la ricevuta della carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはレシートではなく請求書です。支払いはまだ済んでいません。支払い後にレシートまたはカードの利用控えを撮影してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ანგარიშია და არა ქვითარი: გადახდა ჯერ არ მომხდარა. გადახდის შემდეგ გადაიღეთ ქვითარი ან ტერმინალის ამონაბეჭდი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл шот, чек емес: төлем әлі алда. Төлегеннен кейін чекті немесе карта төлемінің қағазын суретке түсіріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증이 아닌 청구서입니다. 결제 후 영수증이나 카드 전표를 촬영하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул чек эмес, төлөм эсеби: ал төлөнө элек. Төлөгөндөн кийин чекти же карта түбөлүгүн сүрөткө тартыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een rekening, geen bon: de betaling moet nog plaatsvinden. Fotografeer na het betalen de bon of de pinbon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To rachunek, nie paragon — płatność jeszcze nie nastąpiła. Po zapłaceniu sfotografuj paragon lub potwierdzenie płatności kartą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma conta, não um comprovante: o pagamento ainda não foi feito. Fotografe o comprovante ou o recibo do cartão após pagar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é uma conta, não um recibo: o pagamento ainda está por fazer. Fotografe o recibo ou o talão do cartão depois de pagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это счёт, а не чек: оплата ещё впереди. Сфотографируйте чек или слип терминала после оплаты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ҳисоб аст, на чек: пардохт ҳанӯз анҷом нашудааст. Пас аз пардохт чек ё расиди кортро акс гиред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir hesap, fiş değil; ödeme henüz yapılmamış. Ödeme yaptıktan sonra fişin veya kart slipinin fotoğrafını çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це рахунок, а не чек: оплату ще не здійснено. Сфотографуйте чек або квитанцію термінала після оплати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu chek emas, to‘lov hisobi: hali to‘lanmagan. To‘lagach, chek yoki karta terminali kvitansiyasini suratga oling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一张账单，尚未付款。付款后请拍摄小票或刷卡凭条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是帳單，不是收據：尚未付款。請在付款後拍攝收據或簽帳單。"
          }
        }
      }
    },
