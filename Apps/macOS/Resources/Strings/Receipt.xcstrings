    "receipt.done.undo.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Undo” takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Deshacer» la deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Annuler » le reprend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отменить» вернёт всё назад."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скасувати дію» повертає попередній стан."
          }
        }
      }
    },
    "receipt.drop": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or drop a picture with the QR code here: a photo, a screenshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O arrastre aquí una imagen con el código QR: una foto, una captura de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
