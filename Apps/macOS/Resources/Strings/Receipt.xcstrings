          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z скасуе дзеянне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změnu vrátíte stisknutím ⌘Z."
