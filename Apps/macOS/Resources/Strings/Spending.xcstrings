    "spending.usual.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 90 gündə xərc olan günlərin medianı; birdəfəlik alışlar daxil deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Медыяна дзён з выдаткамі за апошнія 90 дзён, без разавых пакупак"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Medián dnů s výdaji za posledních 90 dní; bez jednorázových nákupů"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Median der Tage mit Ausgaben in den letzten 90 Tagen; Einmalkäufe ausgenommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The median of the days with spending in the last 90 days; one-off purchases left out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mediana de los días con gasto de los últimos 90 días; las compras puntuales se dejan fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La médiane des jours avec dépenses des 90 derniers jours ; achats ponctuels exclus"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին 90 օրվա ծախսով օրերի մեդիանը՝ առանց միանվագ գնումների"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mediana dei giorni con spese negli ultimi 90 giorni, esclusi gli acquisti una tantum"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去90日間の支出があった日の中央値。一時的な購入を除く"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯიანი დღეების მედიანა ბოლო 90 დღეში; ერთჯერადი შენაძენების გარეშე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 90 күндегі шығын болған күндердің медианасы; бір реттік сатып алулар кірмейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы 90 күндө чыгым болгон күндөрдүн медианасы; бир жолку сатып алуулар кирбейт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mediaan van dagen met uitgaven in de afgelopen 90 dagen, exclusief eenmalige aankopen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediana dni z wydatkami z ostatnich 90 dni, bez jednorazowych zakupów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediana dos dias com gastos nos últimos 90 dias, sem compras pontuais"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediana dos dias com despesas nos últimos 90 dias, sem compras pontuais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиана дней с тратами за последние 90 дней; разовые не входят"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Медианаи рӯзҳои дорои хароҷот дар 90 рӯзи охир; харидҳои якдафъаина ба ҳисоб намераванд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 90 günde harcama yapılan günlerin medyanı; tek seferlik alışverişler hariç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіана днів із витратами за останні 90 днів; разові покупки не враховуються"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "So‘nggi 90 kundagi xarajatli kunlar medianasi; bir martalik xaridlar hisobga olinmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 90 天中有支出的日子的支出中位数；不含一次性购买"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 90 天有支出日的中位數；不含一次性購買"
          }
        }
      }
    },
