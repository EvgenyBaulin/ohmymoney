        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена в часах выключена. Включите её в «Настройках», раздел «Планирование»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціну в годинах вимкнено. Увімкніть її в «Налаштування», «Планування»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
