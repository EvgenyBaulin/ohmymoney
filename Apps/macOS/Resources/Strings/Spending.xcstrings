        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы ў катэгорыі не было выдаткаў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Kategorie wurde diesen Monat nichts ausgegeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was spent in this category this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mes no se gastó nada en esta categoría"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été dépensé dans cette catégorie ce mois-ci"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս այս կատեգորիայում ծախսեր չեն եղել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna spesa in questa categoria questo mese"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში ამ კატეგორიაში არაფერი დახარჯულა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда бұл санатта шығын болған жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда бул категорияда чыгым болгон жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu nic nie wydano w tej kategorii"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum gasto nesta categoria este mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой категории в этом месяце трат нет"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин моҳ дар ин категория чизе сарф нашудааст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay bu kategoride harcama yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цій категорії цього місяця нічого не витрачено"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
