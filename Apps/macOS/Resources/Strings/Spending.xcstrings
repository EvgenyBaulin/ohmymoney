        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემები არასაკმარისია: %1$lld დღე ხარჯებით, სულ %2$lld-დან"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерек жеткіліксіз: шығын бар %1$lld күн, қажеті %2$lld"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат жетишсиз: чыгым болгон %2$lld күндүн %1$lld күнү"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych: %1$lld z %2$lld dni z wydatkami"
          }
        },
        "pt-BR": {
