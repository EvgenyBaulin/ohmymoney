    "spending.people.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son on iki ay: şəxsin payı və onun üçün silinən məbləğlər; qaytarılması gözlənilən pul xərc sayılmır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За апошнія дванаццаць месяцаў: долі гэтага чалавека і сумы, якія я за яго спісаў; грошы, якія яшчэ чакаю назад, не лічацца выдаткамі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posledních dvanáct měsíců: podíly dané osoby a částky, které jsem jí odepsal; očekávané vrácení peněz není výdaj"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten zwölf Monate: Teile für die Person plus was ich für sie abgeschrieben habe; Geld, das noch zurückerwartet wird, ist keine Ausgabe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last twelve months: parts for the person plus what I wrote off for them; money still expected back is not spending"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimos doce meses: partes para la persona más lo que yo le di de baja; el dinero que todavía se espera de vuelta no es gasto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les douze derniers mois : les parts pour la personne plus ce que j'ai passé en pertes pour elle ; l'argent encore attendu en retour n'est pas une dépense"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին տասներկու ամիսը․ անձին բաժին ընկնող գումարները և նրա համար դուրս գրված գումարները․ դեռ վերադարձի սպասող գումարը ծախս չէ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimi dodici mesi: le quote per la persona più gli importi che ho rinunciato a farmi restituire; il denaro ancora da ricevere non è una spesa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去12か月のその人の負担分と、返済不要にした金額。返済待ちの金額は支出に含みません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო თორმეტი თვე: ამ ადამიანის წილი და მისთვის ჩამოწერილი თანხა; დასაბრუნებელი თანხა ხარჯად არ ითვლება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы он екі ай: адамға арналған бөліктер мен оған кешірген қарызым; қайтуы күтілетін ақша шығын емес"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы он эки ай: адамдын үлүшү жана ал үчүн чыгымга жазган суммаңыз; кайтарыла элек акча чыгымга кирбейт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgelopen twaalf maanden: delen voor deze persoon plus wat ik voor die persoon heb afgeschreven; geld dat ik nog terugverwacht, telt niet als uitgave"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie 12 miesięcy: części przypisane osobie oraz kwoty umorzone; pieniądze oczekujące na zwrot nie są wydatkiem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimos 12 meses: partes atribuídas à pessoa e valores que você deixou de cobrar; valores ainda a receber não são gastos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimos doze meses: partes atribuídas à pessoa e valores que decidi não recuperar; o dinheiro ainda a receber não conta como despesa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние двенадцать месяцев: части на человека и списанное за него; то, что ещё ждёт возврата, не трата"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дувоздаҳ моҳи охир: ҳиссаҳои шахс ва маблағе, ки барои ӯ аз ҳисоб баровардаам; маблағе, ки бозпас интизор аст, хароҷот нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 12 ay: Kişiye ait paylar ve onun için sildiğim alacaklar; geri ödenmesi beklenen tutarlar harcama sayılmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останні дванадцять місяців: частки на людину плюс те, що я списав за неї; гроші, які ще очікуються назад, не є витратами"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi o‘n ikki oy: shu odamga tegishli ulushlar va uning uchun hisobdan chiqarilgan summalar; qaytarilishi kutilayotgan pul xarajat hisoblanmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去十二个月：该人物的分摊金额加上我为其核销的款项；仍待收回的款项不计为支出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 12 個月：此人的分攤金額加上我為其核銷的款項；仍待收回的款項不計為支出"
          }
        }
      }
    },
