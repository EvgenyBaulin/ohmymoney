    "spending.weekend.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametrlərdə həftəsonu kimi təyin edilmiş saatlarda bütün xərclərim: birdəfəlik alışlar söndürülməyibsə, daxil edilir; vaxtı göstərilməyən əməliyyat yalnız bütün gün həftəsonuna düşdükdə sayılır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума маіх выдаткаў за гадзіны, вызначаныя ў наладах як выхадныя. Разавыя пакупкі ўключаны, калі вы іх не адключыце; аперацыя без часу ўлічваецца, толькі калі ўвесь дзень прыпадае на выхадныя"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben in den Stunden, die die Einstellungen als Wochenende bezeichnen, als Summe: Einmalkäufe bleiben enthalten, außer Sie schalten sie aus; ein Vorgang ohne Uhrzeit zählt nur, wenn sein ganzer Tag Wochenende ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending in the hours the settings call the weekend, a total: one-off purchases stay in unless you switch them off; an operation with no time counts only when its whole day is weekend"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto en las horas que los ajustes llaman fin de semana, en total: las compras puntuales se quedan dentro salvo que las desactive; una operación sin hora cuenta solo si todo su día es fin de semana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses aux heures que les réglages appellent le week-end, en total : les achats ponctuels restent inclus sauf si vous les désactivez ; une opération sans heure ne compte que si toute sa journée est un week-end"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Իմ ծախսերի ընդհանուր գումարը՝ կարգավորումներում հանգստյան օր նշված ժամերին․ միանվագ գնումները ներառվում են, եթե դրանք չեք անջատել․ առանց ժամի գործարքը հաշվվում է միայն այն դեպքում, երբ ամբողջ օրը հանգստյան է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il totale delle mie spese negli orari definiti come weekend nelle impostazioni. Gli acquisti una tantum sono inclusi, salvo esclusione; un'operazione senza orario viene conteggiata solo se l'intera giornata è nel weekend"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი ხარჯების ჯამი პარამეტრებში უქმეებად მითითებულ საათებში. ერთჯერადი შენაძენები შედის, თუ არ გამორთავთ; ოპერაცია დროის გარეშე ითვლება მხოლოდ მაშინ, თუ მთელი დღე უქმეა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баптауларда демалыс деп берілген сағаттардағы өз шығыным, жалпы сома: бір реттік сатып алулар өшірілмесе, есепке кіреді; уақыты жоқ операция тек бүкіл күні демалыс болса есептеледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жөндөөлөрдө дем алыш деп белгиленген сааттардагы бардык чыгымдарым: бир жолку сатып алуулар өчүрүлбөсө, эсепке алынат; убактысы көрсөтүлбөгөн операция күнү толугу менен дем алышка туура келгенде гана эсептелет"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma moich wydatków w godzinach określonych w ustawieniach jako weekend; obejmuje jednorazowe zakupy, chyba że je wyłączysz. Operacja bez godziny jest uwzględniana tylko wtedy, gdy cały dzień należy do weekendu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Total dos meus gastos no período definido como fim de semana nos ajustes. Compras pontuais são incluídas, a menos que você as exclua; operações sem horário contam apenas se o dia inteiro for fim de semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы в часы, которые настройки считают выходными, итогом: разовые остаются, если не выключить; операция без времени — только если выходной весь её день"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳамаи хароҷоти ман дар соатҳое, ки дар танзимот ҳамчун рӯзҳои истироҳат таъйин шудаанд; харидҳои якдафъаина ҳисоб мешаванд, агар онҳоро хомӯш накунед; амалиёти бе вақт танҳо вақте ҳисоб мешавад, ки тамоми рӯз истироҳат бошад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarda hafta sonu olarak belirlenen saatlerdeki toplam harcamalarınız; tek seferlik alışverişler kapatılmadıkça dahil edilir. Saati belirtilmeyen bir işlem, yalnızca günün tamamı hafta sonuysa sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати в години, які налаштування називають вихідними, підсумком: разові покупки лишаються, якщо їх не вимкнено; операція без часу рахується, лише коли весь її день — вихідний"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlamalarda belgilangan dam olish vaqtlaridagi jami xarajatlarim: bir martalik xaridlar o‘chirilmasa hisobga olinadi; vaqti ko‘rsatilmagan operatsiya faqat butun kuni dam olish vaqtiga to‘g‘ri kelsa hisoblanadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定中週末時段內的總支出：除非關閉，否則包含一次性購買；沒有時間的交易僅在當天全天為週末時才計入"
          }
        }
      }
    },
