    "spending.cmp.empty": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце перыяды для параўнання: для пары з падзеяй патрэбна падзея, для ўласных перыядаў — абодва перыяды з датай заканчэння пасля пачатку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Zeiträume zum Vergleich: Ein Ereignispaar braucht ein Ereignis, ein eigener Bereich braucht beide Bereiche mit einem Ende nach dem Anfang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the periods to compare: an event pair needs an event, a custom range needs both ranges with an end after the start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija los periodos a comparar: un par de eventos necesita un evento, un rango a medida necesita los dos rangos con un final posterior al inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les périodes à comparer : une paire d'événements demande un événement, une plage personnalisée demande deux plages dont la fin est après le début."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i periodi da confrontare: per un confronto con un evento serve un evento; per intervalli personalizzati servono entrambi gli intervalli, con la fine successiva all’inizio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыстыру кезеңдерін таңдаңыз: оқиғалар жұбына оқиға, еркін аралықтарға басталуынан кейін аяқталатын екі аралық қажет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz okresy do porównania: dla pary ze zdarzeniem wybierz zdarzenie, a dla własnych zakresów podaj oba zakresy z datą końcową po początkowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os períodos para comparar: para comparar um evento, escolha um evento; para períodos personalizados, informe as datas de início e fim de ambos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, что сравнивать: для пары с событием нужно событие, для своего диапазона — оба диапазона, где конец не раньше начала."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırılacak dönemleri seçin: Etkinlik karşılaştırması için bir etkinlik, özel karşılaştırma için bitişi başlangıcından sonra olan iki aralık gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть періоди для порівняння: пара з подією потребує події, власний діапазон — обох діапазонів з кінцем пізніше за початок."
          }
        }
      }
    },
