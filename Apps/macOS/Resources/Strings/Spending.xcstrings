        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихідні"
          }
        }
      }
    },
    "why.weekend.window": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выхадныя — гэта гадзіны, зададзеныя ў раздзеле «Налады» → «Планаванне». Аперацыя без часу ўлічваецца, толькі калі ўвесь дзень прыпадае на выхадныя. Разавыя пакупкі ўключаны, як і ва ўсе агульныя сумы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wochenende sind die Stunden, die unter Einstellungen, Planung festgelegt sind; ein Vorgang ohne Uhrzeit zählt nur, wenn sein ganzer Tag Wochenende ist; Einmalkäufe bleiben drin, wie in jeder Summe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weekend is the hours set in Settings, Planning; an operation with no time counts only when its whole day is weekend; one-off purchases stay in, as in every total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fin de semana son las horas fijadas en Ajustes, Planificación; una operación sin hora cuenta solo si todo su día es fin de semana; las compras puntuales se quedan dentro, como en cada total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le week-end correspond aux heures fixées dans Réglages, Planification ; une opération sans heure ne compte que si toute sa journée est un week-end ; les achats ponctuels restent inclus, comme dans tous les totaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il weekend comprende gli orari definiti in Impostazioni, Pianificazione. Un'operazione senza orario viene conteggiata solo se l'intera giornata è nel weekend. Gli acquisti una tantum sono inclusi, come in ogni totale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демалыс — Баптаулардың Жоспарлау бөлімінде берілген сағаттар; уақыты жоқ операция тек бүкіл күні демалыс болса есептеледі; барлық қорытындыдағыдай бір реттік сатып алулар да кіреді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekend obejmuje godziny określone w Ustawieniach, w sekcji Planowanie. Operacja bez godziny jest uwzględniana tylko wtedy, gdy cały dzień należy do weekendu. Jednorazowe zakupy są uwzględniane, tak jak w każdej sumie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fim de semana corresponde aos horários definidos em Ajustes, Planejamento. Operações sem horário contam apenas se o dia inteiro for fim de semana; compras pontuais são incluídas, como em todos os totais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходные — часы из «Настроек», раздел «Планирование»; операция без времени — только если выходной весь её день; разовые остаются, как в любом итоге."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonu, Ayarlar > Planlama bölümünde belirlenen saatlerdir. Saati belirtilmeyen bir işlem, yalnızca günün tamamı hafta sonuysa sayılır. Tek seferlik alışverişler, tüm toplamlarda olduğu gibi dahildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихідні — це години, задані в «Налаштування», «Планування»; операція без часу рахується, лише коли весь її день — вихідний; разові покупки лишаються, як у кожному підсумку."
          }
        }
      }
    }
  },
  "version": "1.0"
}
