    "spending.oneOff.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortalama və proqnozlara daxil deyil; aylıq cəmlərə və limitlərə daxildir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўлічваецца ў сярэдніх значэннях і прагнозах, але ўваходзіць у сумы за месяц і ліміты"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezapočítává se do průměrů a předpovědí; v měsíčních součtech a limitech zůstává"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Durchschnitten und Prognosen herausgelassen; die Monatssummen und die Limits behalten ihn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left out of averages and forecasts; the month totals and the limits keep it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deja fuera de las medias y previsiones; los totales del mes y los límites lo siguen contando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclu des moyennes et des prévisions ; les totaux du mois et les plafonds le gardent"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ներառված չէ միջիններում և կանխատեսումներում, բայց ներառված է ամսվա ընդհանուր գումարում և սահմանաչափերում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escluso da medie e previsioni; incluso nei totali mensili e nei limiti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均と予測には含めず、月の合計と上限には含めます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არ შედის საშუალო მაჩვენებლებსა და პროგნოზებში; შედის თვის ჯამებსა და ლიმიტებში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орташа мәндер мен болжамдарға кірмейді; ай қорытындысы мен лимиттерде қалады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Орточо көрсөткүчтөргө жана божомолдорго кирбейт; айлык жыйынтыкта жана лимиттерде калат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt niet mee in gemiddelden en prognoses, maar wel in maandtotalen en limieten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomijany w średnich i prognozach; uwzględniany w sumach miesięcznych i limitach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não entra nas médias e previsões; permanece nos totais mensais e nos limites"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluída das médias e previsões; incluída nos totais mensais e limites"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не входит в средние и прогнозы; итоги месяца и лимиты его учитывают"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба ҳисобҳои миёна ва пешгӯиҳо дохил намешавад; дар ҷамъи моҳ ва лимитҳо мемонад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortalamalara ve tahminlere dahil edilmez; aylık toplamlara ve limitlere dahil edilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не враховується в середніх і прогнозах; підсумки місяця й ліміти її зберігають"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘rtacha va prognozlarga kirmaydi; oylik jami va limitlarda hisobga olinadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不计入平均值和预测，但计入月度总额和额度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不計入平均值和預測，仍計入每月總額和限額"
          }
        }
      }
    },
    "spending.oneOff.mark": {
      "extractionState": "manual",
      "localizations": {
