    "spending.yearAgo.basis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month of the toolbar against the same month a year before, by category; only you, nobody else"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes de la barra de herramientas frente al mismo mes del año anterior, por categoría; solo usted, nadie más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mois de la barre d'outils comparé au même mois un an plus tôt, par catégorie ; vous seul, personne d'autre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц из панели против того же месяца год назад, по категориям; только вы сами"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць з панелі інструментів проти того самого місяця роком раніше, за категоріями; лише ви, ніхто інший"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құралдар тақтасындағы айды былтырғы сол аймен санат бойынша салыстыру; тек өзіңіз, басқаларсыз"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monat der Werkzeugleiste gegenüber demselben Monat ein Jahr davor, nach Kategorie; nur Sie, sonst niemand"
          }
        }
      }
    },
