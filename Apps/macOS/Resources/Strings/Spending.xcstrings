    "spending.heat.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dövrdə vaxtı məlum olan əməliyyat yoxdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэты перыяд няма аперацый з указаным часам"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Vorgänge mit Uhrzeit in diesem Zeitraum"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No operations with a time in this period"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay operaciones con hora en este periodo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune opération avec une heure sur cette période"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ժամանակահատվածում ժամով գործարքներ չկան"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna operazione con orario in questo periodo"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ პერიოდში დროით მითითებული ოპერაციები არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кезеңде уақыты бар операциялар жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул мезгилде убактысы көрсөтүлгөн операциялар жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak operacji ze znaną godziną w tym okresie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma operação com horário neste período"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом периоде нет операций со временем"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин давра амалиёти дорои вақт нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönemde saati bilinen işlem yok"
          }
        },
        "uk": {
          "stringUnit": {
