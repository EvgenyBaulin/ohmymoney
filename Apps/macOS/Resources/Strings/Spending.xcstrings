    "spending.limit.basis": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тры найбольшыя пакупкі ў катэгорыі за месяц з улікам падкатэгорый і вяртанняў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die drei größten Käufe der Kategorie im Monat, Unterkategorien eingeschlossen, Erstattungen abgezogen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The three largest purchases of the category in the month, subcategories included, refunds taken off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tres compras más grandes de la categoría en el mes, con subcategorías, descontadas las devoluciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trois plus gros achats de la catégorie dans le mois, sous-catégories comprises, remboursements déduits"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tre acquisti più costosi della categoria nel mese, incluse le sottocategorie e al netto dei rimborsi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдағы санаттың ең ірі үш сатып алуы, ішкі санаттармен бірге, қайтарымдар шегеріледі"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy największe zakupy w kategorii w tym miesiącu, z uwzględnieniem podkategorii i zwrotów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As três maiores compras da categoria no mês, incluindo subcategorias e descontando reembolsos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три самые крупные покупки категории за месяц, с подкатегориями, за вычетом возвратов"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
