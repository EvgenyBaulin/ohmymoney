    "spending.cmp.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Digər bölmələrdəki kimi xərclərim; birdəfəlik alışlar ümumi məbləğə daxildir, gündəlik ortalamaya daxil deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі, як і ўсюды; аднаразовыя пакупкі ўваходзяць у агульныя сумы, але не ў сярэднія выдаткі за дзень"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje výdaje jako jinde; jednorázové nákupy se započítávají do součtů, ale ne do denního průměru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben, wie überall; Einmalkäufe bleiben in den Summen und nicht im durchschnittlichen Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending, as everywhere; one-off purchases stay in the totals and out of the average day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto, como en todas partes; las compras puntuales se quedan en los totales y fuera del día medio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses, comme partout ; les achats ponctuels restent dans les totaux et hors du jour moyen"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Իմ ծախսերը, ինչպես ամենուր․ միանվագ գնումները ներառված են ընդհանուր գումարում, բայց ոչ օրական միջինում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese, come nel resto dell’app; gli acquisti una tantum sono inclusi nei totali ma esclusi dalla media giornaliera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの画面と同じく自分の支出。一時的な購入は合計に含め、1日平均には含めません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი ხარჯები, როგორც ყველგან; ერთჯერადი შენაძენები შედის ჯამში, მაგრამ არა დღის საშუალო ხარჯში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық жердегідей өз шығындарым; бір реттік сатып алулар қорытындыда қалады, күндік орташаға кірмейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бардык жердегидей эле менин чыгымдарым; бир жолку сатып алуулар жалпы суммага кирет, күндүк орточого кирбейт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn uitgaven, zoals overal; eenmalige aankopen tellen mee in de totalen, maar niet in het daggemiddelde"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki, jak wszędzie; jednorazowe zakupy są uwzględniane w sumach, ale nie w średniej dziennej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos, como nas outras telas; compras pontuais entram nos totais, mas não na média diária"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas, como nas restantes vistas; as compras pontuais contam nos totais, mas não na média diária"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы, как везде; разовые остаются в итогах и не входят в средний день"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ман, мисли дигар бахшҳо; харидҳои якдафъаина ба ҷамъ дохил мешаванд, вале ба ҳисоби миёнаи рӯзона не"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer yerlerde olduğu gibi harcamalarım; tek seferlik alımlar toplamlara dahil edilir, günlük ortalamaya edilmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати, як скрізь; разові покупки лишаються в підсумках і не входять до середнього дня"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa joylardagi kabi xarajatlarim; bir martalik xaridlar jami summaga kiradi, kunlik o‘rtachaga kirmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与其他地方一样，以我的支出计算；一次性购买计入总额，但不计入日均支出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與其他地方一樣，以我的支出計算；單次購買計入總額，但不計入每日平均"
          }
        }
      }
    },
