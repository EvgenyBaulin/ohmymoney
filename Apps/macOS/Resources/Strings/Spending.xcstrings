        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No description matches a place you have"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna descripción coincide con un lugar que tenga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune description ne correspond à un lieu que vous avez"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նկարագրություններից ոչ մեկը չի համընկնում ձեր վայրերի հետ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna descrizione corrisponde a un luogo salvato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録済みの場所と一致する説明はありません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არცერთი აღწერა არ ემთხვევა თქვენს ადგილებს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ешбір сипаттама орындарыңызға сәйкес келмейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эч бир сүрөттөмө сиздеги жерлерге дал келбейт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen beschrijving komt overeen met een van je locaties"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden opis nie pasuje do Twoich miejsc"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma descrição corresponde a um local salvo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma descrição corresponde a um dos seus locais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одно описание не совпадает с вашим местом"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ягон тавсиф ба ҷойҳои шумо мувофиқат намекунад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıklamalarınız kayıtlı yerlerle eşleşmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден опис не збігається з вашим місцем"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavsiflarning hech biri joylaringizga mos kelmadi"
          }
        },
        "zh-Hans": {
