    "spending.leaks.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough history to tell leaks: at least 20 purchases in 90 days are needed"
          }
        },
        "es": {
          "stringUnit": {
