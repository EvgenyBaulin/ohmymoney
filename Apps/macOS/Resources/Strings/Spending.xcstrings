    "spending.leaks.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 90 günün kiçik, tez-tez edilən alışları, öz tarixçəniz əsasında"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дробныя частыя пакупкі за апошнія 90 дзён паводле вашай гісторыі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine, häufige Käufe der letzten 90 Tage, gefunden anhand Ihres eigenen Verlaufs"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small, frequent purchases of the last 90 days, found against your own history"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compras pequeñas y frecuentes de los últimos 90 días, comparadas con su propio historial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petits achats fréquents des 90 derniers jours, repérés par rapport à votre propre historique"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին 90 օրվա փոքր, հաճախակի գնումները՝ ըստ ձեր պատմության"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccoli acquisti frequenti degli ultimi 90 giorni, individuati in base alla tua cronologia"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო 90 დღის მცირე, ხშირი შენაძენები, გამოვლენილი თქვენი ისტორიის მიხედვით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз тарихыңызбен салыстырғанда табылған соңғы 90 күндегі ұсақ, жиі сатып алулар"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы 90 күндөгү майда, тез-тез сатып алуулар, өз тарыхыңызга жараша аныкталды"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drobne, częste zakupy z ostatnich 90 dni, wykryte na podstawie Twojej historii"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequenas compras frequentes dos últimos 90 dias, identificadas com base no seu histórico"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мелкие частые покупки за последние 90 дней, найденные по вашей истории"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Харидҳои хурду зуд-зуд дар 90 рӯзи охир, аз рӯи таърихи харидҳои шумо"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 90 gündeki küçük ve sık alımlar, kendi geçmişinize göre belirlenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дрібні часті покупки за останні 90 днів, знайдені за вашою власною історією"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi 90 kundagi kichik va tez-tez qilingan xaridlar, xaridlar tarixingiz asosida aniqlangan"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你的消費紀錄，找出過去 90 天頻繁發生的小額購買"
          }
        }
      }
    },
    "spending.leaks.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xərc sızmalarını müəyyən etmək üçün tarixçə kifayət deyil: 90 gündə ən azı 20 alış lazımdır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова гісторыі, каб выявіць дробныя выдаткі: патрэбна не менш за 20 пакупак за 90 дзён"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Verlauf, um Lecks zu erkennen: Es braucht mindestens 20 Käufe in 90 Tagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough history to tell leaks: at least 20 purchases in 90 days are needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay historial suficiente para ver fugas: hacen falta al menos 20 compras en 90 días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d'historique pour repérer des fuites : il faut au moins 20 achats en 90 jours"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալները բավարար չեն արտահոսքերը գտնելու համար․ անհրաժեշտ է առնվազն 20 գնում 90 օրում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronologia insufficiente per individuare le piccole spese: servono almeno 20 acquisti in 90 giorni"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯების გაჟონვის გამოსავლენად ისტორია არასაკმარისია: საჭიროა სულ მცირე 20 შენაძენი 90 დღეში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Артық шығынды анықтауға тарих жеткіліксіз: 90 күнде кемінде 20 сатып алу қажет"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чыгымдарды аныктоого тарых жетишсиз: 90 күндө кеминде 20 сатып алуу керек"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych, by wykryć wycieki: potrzeba co najmniej 20 zakupów w ciągu 90 dni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico insuficiente para identificar gastos recorrentes: são necessárias pelo menos 20 compras em 90 dias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало истории, чтобы найти утечки: нужно не меньше 20 покупок за 90 дней"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таърихи кофӣ барои муайян кардани хароҷоти майда нест: дар 90 рӯз ҳадди ақал 20 харид лозим аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereksiz harcamaları belirlemek için yeterli geçmiş yok: 90 günde en az 20 alım gerekir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історії замало, щоб бачити витоки: потрібно щонайменше 20 покупок за 90 днів"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayda xarajatlarni aniqlash uchun tarix yetarli emas: 90 kunda kamida 20 ta xarid kerak"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄不足，無法找出零星支出：90 天內至少需要 20 筆購買"
          }
        }
      }
    },
