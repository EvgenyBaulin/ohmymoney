    "spending.people.basis": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За апошнія дванаццаць месяцаў: долі гэтага чалавека і сумы, якія я за яго спісаў; грошы, якія яшчэ чакаю назад, не лічацца выдаткамі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten zwölf Monate: Teile für die Person plus was ich für sie abgeschrieben habe; Geld, das noch zurückerwartet wird, ist keine Ausgabe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last twelve months: parts for the person plus what I wrote off for them; money still expected back is not spending"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimos doce meses: partes para la persona más lo que yo le di de baja; el dinero que todavía se espera de vuelta no es gasto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les douze derniers mois : les parts pour la personne plus ce que j'ai passé en pertes pour elle ; l'argent encore attendu en retour n'est pas une dépense"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimi dodici mesi: le quote per la persona più gli importi che ho rinunciato a farmi restituire; il denaro ancora da ricevere non è una spesa"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы он екі ай: адамға арналған бөліктер мен оған кешірген қарызым; қайтуы күтілетін ақша шығын емес"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie 12 miesięcy: części przypisane osobie oraz kwoty umorzone; pieniądze oczekujące na zwrot nie są wydatkiem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimos 12 meses: partes atribuídas à pessoa e valores que você deixou de cobrar; valores ainda a receber não são gastos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние двенадцать месяцев: части на человека и списанное за него; то, что ещё ждёт возврата, не трата"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 12 ay: Kişiye ait paylar ve onun için sildiğim alacaklar; geri ödenmesi beklenen tutarlar harcama sayılmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останні дванадцять місяців: частки на людину плюс те, що я списав за неї; гроші, які ще очікуються назад, не є витратами"
          }
        }
      }
    },
