    "spending.places.noneToSet": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніводнае апісанне не супадае з вашымі месцамі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Beschreibung passt zu einem Ort, den Sie haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No description matches a place you have"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna descripción coincide con un lugar que tenga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune description ne correspond à un lieu que vous avez"
