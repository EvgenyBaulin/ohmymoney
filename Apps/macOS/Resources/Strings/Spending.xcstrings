    "spending.hours.basis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average earnings of the last three months, what reached your accounts, over the hours you work in a month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus ingresos medios de los últimos tres meses, lo que llegó a sus cuentas, entre las horas que trabaja en un mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos gains moyens des trois derniers mois, ce qui est arrivé sur vos comptes, rapportés aux heures que vous travaillez dans un mois"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш средний заработок за последние три месяца, то, что пришло на счета, на часы работы в месяц"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш середній заробіток за останні три місяці — що надійшло на рахунки — поділений на години, які ви працюєте за місяць"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы үш айда шоттарыңызға түскен орташа табыстың айлық жұмыс сағатына қатынасы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr durchschnittlicher Verdienst der letzten drei Monate, was auf Ihren Konten ankam, über die Stunden, die Sie im Monat arbeiten"
          }
        }
      }
    },
    "spending.hours.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough data: no earnings in the last three months"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos insuficientes: no hay ingresos en los últimos tres meses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données insuffisantes : pas de gains sur les trois derniers mois"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных: за последние три месяца нет заработка"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Даних замало: за останні три місяці заробітку немає"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерек жеткіліксіз: соңғы үш айда табыс жоқ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Daten: kein Verdienst in den letzten drei Monaten"
          }
        }
      }
    },
    "spending.hours.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price in hours is off. Turn it on in Settings, Planning."
