        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "күнүнө орточо, мезгилдердин узактыгы ар башка"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "średnio dziennie, okresy mają różną długość"
