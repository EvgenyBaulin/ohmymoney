    "spending.places.setFromNote.rule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense with no place gets the place whose name or alias is exactly its description. You can switch lines off; one step of ⌘Z takes it all back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gasto sin lugar recibe el lugar cuyo nombre u otro nombre coincide exactamente con su descripción. Puede desactivar líneas; un paso de ⌘Z lo deshace todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense sans lieu reçoit le lieu dont le nom ou l'autre nom est exactement sa description. Vous pouvez désactiver des lignes ; un seul ⌘Z reprend tout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трата без места получает место, название или псевдоним которого в точности совпадает с описанием. Строки можно снять; один шаг ⌘Z вернёт всё назад."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витраті без місця призначається місце, назва або псевдонім якого точно збігаються з її описом. Рядки можна вимкнути; один крок ⌘Z скасовує все."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орны жоқ шығынға атауы не балама атауы сипаттамамен дәл сәйкес келетін орын қойылады. Жолдарды өшіруге болады; ⌘Z бір қадамда бәрін қайтарады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe ohne Ort bekommt den Ort, dessen Name oder weiterer Name genau ihrer Beschreibung entspricht. Zeilen können Sie ausschalten; ein Schritt von ⌘Z nimmt alles zurück."
          }
        }
      }
    },
    "spending.places.setFromNote.rule.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense with no place gets the place whose name or alias is exactly its description. You can switch lines off; one “Undo” takes it all back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gasto sin lugar recibe el lugar cuyo nombre u otro nombre coincide exactamente con su descripción. Puede desactivar líneas; un «Deshacer» lo deshace todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense sans lieu reçoit le lieu dont le nom ou l'autre nom est exactement sa description. Vous pouvez désactiver des lignes ; un seul « Annuler » reprend tout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трата без места получает место, название или псевдоним которого в точности совпадает с описанием. Строки можно снять; одно нажатие «Отменить» вернёт всё назад."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витраті без місця призначається місце, назва або псевдонім якого точно збігаються з її описом. Рядки можна вимкнути; один крок «Скасувати» повертає все."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орны жоқ шығынға атауы не балама атауы сипаттамамен дәл сәйкес келетін орын қойылады. Жолдарды өшіруге болады; бір “Болдырмау” бәрін қайтарады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe ohne Ort bekommt den Ort, dessen Name oder weiterer Name genau ihrer Beschreibung entspricht. Zeilen können Sie ausschalten; „Rückgängig“ nimmt alles zurück."
          }
        }
      }
    },
