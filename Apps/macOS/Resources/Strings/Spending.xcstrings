    "spending.oneOff.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўлічваецца ў сярэдніх значэннях і прагнозах, але ўваходзіць у сумы за месяц і ліміты"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Durchschnitten und Prognosen herausgelassen; die Monatssummen und die Limits behalten ihn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left out of averages and forecasts; the month totals and the limits keep it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deja fuera de las medias y previsiones; los totales del mes y los límites lo siguen contando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclu des moyennes et des prévisions ; les totaux du mois et les plafonds le gardent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escluso da medie e previsioni; incluso nei totali mensili e nei limiti"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орташа мәндер мен болжамдарға кірмейді; ай қорытындысы мен лимиттерде қалады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomijany w średnich i prognozach; uwzględniany w sumach miesięcznych i limitach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não entra nas médias e previsões; permanece nos totais mensais e nos limites"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не входит в средние и прогнозы; итоги месяца и лимиты его учитывают"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortalamalara ve tahminlere dahil edilmez; aylık toplamlara ve limitlere dahil edilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не враховується в середніх і прогнозах; підсумки місяця й ліміти її зберігають"
          }
        }
      }
    },
