    "spending.places.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız məkanı göstərilən əməliyyatlar; orta çekdən qaytarmalar çıxılır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі аперацыі з указаным месцам; сярэдні чэк з улікам вяртанняў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen operace s místem; průměrná útrata zohledňuje vrácené platby"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Vorgänge mit einem Ort; der durchschnittliche Bon ist abzüglich Erstattungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only operations that name a place; the average check is net of refunds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo operaciones que nombran un lugar; el ticket medio es neto de devoluciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement les opérations qui nomment un lieu ; le ticket moyen est net des remboursements"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն վայրով գործարքները․ միջին կտրոնը՝ վերադարձները հանած"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le operazioni con un luogo; lo scontrino medio è al netto dei rimborsi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所が設定された取引のみ。平均支出額は返金を差し引いた金額です"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ ოპერაციები მითითებული ადგილით; საშუალო ჩეკი დაბრუნებების გამოკლებით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек орны көрсетілген операциялар; орташа чектен қайтарымдар шегеріледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жери көрсөтүлгөн операциялар гана; орточо чек кайтарууларды эске алат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen transacties met een locatie; het gemiddelde bedrag is na terugbetalingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko operacje z miejscem; średni rachunek uwzględnia zwroty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas operações com local; o valor médio desconta os reembolsos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas operações com um local; a despesa média exclui os reembolsos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только операции с местом; средний чек — за вычетом возвратов"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо амалиёти дорои ҷой; чеки миёна бо назардошти баргардонидани маблағ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yer belirtilen işlemler; ortalama tutardan iadeler düşülür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише операції з місцем; середній чек — без повернень"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat joyi ko‘rsatilgan operatsiyalar; o‘rtacha chek qaytimlarni hisobga oladi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含有地点的交易；平均消费已扣除退款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
