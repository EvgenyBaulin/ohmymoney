    "spending.hours.rate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гадзіна вашай працы прыносіць %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Stunde Ihrer Arbeit bringt %@"
          }
