    "spending.heat.basis": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі з указаным часам паводле мясцовага часу; аднаразовыя пакупкі не ўлічваюцца"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge mit echter Uhrzeit, nach der Uhr des Ortes, an dem sie geschahen; Einmalkäufe ausgenommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations with a real time, by the clock of the place they happened in; one-off purchases left out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Operaciones con hora real, según el reloj del lugar donde ocurrieron; las compras puntuales se dejan fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opérations avec une heure réelle, à l'heure du lieu où elles ont eu lieu ; achats ponctuels exclus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Operazioni con un orario, in base all’ora locale del luogo in cui sono avvenute; acquisti una tantum esclusi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нақты уақыты бар операциялар, болған жерінің уақытымен; бір реттік сатып алулар кірмейді"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje ze znaną godziną, według czasu miejsca ich wykonania; bez zakupów jednorazowych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Operações com horário registrado, no horário local; compras pontuais não incluídas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции с настоящим временем, по часам того места, где они были; разовые не входят"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saati bilinen işlemler, yapıldıkları yerin saatine göre; tek seferlik alımlar hariç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції з реальним часом за годинником місця, де вони відбулися; разові покупки не враховуються"
          }
        }
      }
    },
