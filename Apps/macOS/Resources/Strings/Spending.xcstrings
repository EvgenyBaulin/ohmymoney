            "state": "translated",
            "value": "Dados insuficientes: %1$lld de %2$lld dias com gastos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных: %1$lld из %2$lld дней с тратами"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумот нокифоя аст: %1$lld аз %2$lld рӯзи дорои хароҷот"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli veri yok: %2$lld günün %1$lld kadarında harcama var"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Даних замало: %1$lld з %2$lld днів із витратами"
          }
        },
        "uz": {
