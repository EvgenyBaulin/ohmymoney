    "spending.heat.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtı məlum olan əməliyyatlar, baş verdiyi məkanın saatı ilə; birdəfəlik alışlar daxil deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі з указаным часам паводле мясцовага часу; аднаразовыя пакупкі не ўлічваюцца"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace se známým časem podle místního času; bez jednorázových nákupů"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge mit echter Uhrzeit, nach der Uhr des Ortes, an dem sie geschahen; Einmalkäufe ausgenommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations with a real time, by the clock of the place they happened in; one-off purchases left out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Operaciones con hora real, según el reloj del lugar donde ocurrieron; las compras puntuales se dejan fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opérations avec une heure réelle, à l'heure du lieu où elles ont eu lieu ; achats ponctuels exclus"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հստակ ժամով գործարքները՝ ըստ կատարման վայրի ժամի․ միանվագ գնումները ներառված չեն"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Operazioni con un orario, in base all’ora locale del luogo in cui sono avvenute; acquisti una tantum esclusi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻のある取引を発生場所の時刻で表示。一時的な購入は含みません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაციები მითითებული დროით, შესრულების ადგილის დროით; ერთჯერადი შენაძენების გარეშე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нақты уақыты бар операциялар, болған жерінің уақытымен; бір реттік сатып алулар кірмейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Убактысы көрсөтүлгөн операциялар, жасалган жердин убактысы боюнча; бир жолку сатып алуулар кирбейт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacties met een tijdstip, volgens de lokale tijd; eenmalige aankopen zijn weggelaten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje ze znaną godziną, według czasu miejsca ich wykonania; bez zakupów jednorazowych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Operações com horário registrado, no horário local; compras pontuais não incluídas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Operações com hora registada, na hora local; exclui compras pontuais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции с настоящим временем, по часам того места, где они были; разовые не входят"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёт бо вақти воқеӣ, аз рӯи вақти маҳаллии ҷойи амалиёт; харидҳои якдафъаина дохил намешаванд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saati bilinen işlemler, yapıldıkları yerin saatine göre; tek seferlik alımlar hariç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції з реальним часом за годинником місця, де вони відбулися; разові покупки не враховуються"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaqti aniq operatsiyalar, amalga oshirilgan joyning mahalliy vaqti bo‘yicha; bir martalik xaridlar kiritilmagan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按发生地点的当地时间统计有具体时间的交易；不包括一次性购买"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有確切時間的交易，依交易地點的當地時間顯示；不含單次購買"
          }
        }
      }
    },
