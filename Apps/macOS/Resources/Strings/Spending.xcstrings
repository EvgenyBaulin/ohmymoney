    "spending.places.setFromNote": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вызначыць месцы па апісаннях"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orte aus Beschreibungen setzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set places from descriptions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner lugares a partir de las descripciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renseigner les lieux d'après les descriptions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta luoghi dalle descrizioni"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сипаттамалардан орындарды қою"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw miejsca na podstawie opisów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir locais pelas descrições"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставить место по описанию"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıklamalardan yerleri ayarla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призначити місця з описів"
          }
        }
      }
    },
    "spending.places.setFromNote.rule": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выдатку без месца выбіраецца месца, назва або псеўданім якога дакладна супадае з апісаннем. Можна адключыць асобныя радкі; ⌘Z адменіць усё адразу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe ohne Ort bekommt den Ort, dessen Name oder weiterer Name genau ihrer Beschreibung entspricht. Zeilen können Sie ausschalten; ein Schritt von ⌘Z nimmt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense with no place gets the place whose name or alias is exactly its description. You can switch lines off; one step of ⌘Z takes it all back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gasto sin lugar recibe el lugar cuyo nombre u otro nombre coincide exactamente con su descripción. Puede desactivar líneas; un paso de ⌘Z lo deshace todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense sans lieu reçoit le lieu dont le nom ou l'autre nom est exactement sa description. Vous pouvez désactiver des lignes ; un seul ⌘Z reprend tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni spesa senza luogo viene assegnato il luogo il cui nome o alias corrisponde esattamente alla descrizione. Puoi disattivare le righe; ⌘Z annulla tutto in un solo passaggio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орны жоқ шығынға атауы не балама атауы сипаттамамен дәл сәйкес келетін орын қойылады. Жолдарды өшіруге болады; ⌘Z бір қадамда бәрін қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do wydatku bez miejsca zostanie przypisane miejsce, którego nazwa lub alias jest identyczny z opisem. Możesz wyłączyć wybrane wiersze; jedno ⌘Z cofnie całą operację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma despesa sem local recebe o local cujo nome ou alias corresponde exatamente à descrição. Você pode desativar linhas; ⌘Z desfaz tudo de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трата без места получает место, название или псевдоним которого в точности совпадает с описанием. Строки можно снять; один шаг ⌘Z вернёт всё назад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeri belirtilmemiş bir harcamaya, adı veya diğer adı açıklamayla tam eşleşen yer atanır. Satırları kapatabilirsiniz; ⌘Z ile tümünü geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витраті без місця призначається місце, назва або псевдонім якого точно збігаються з її описом. Рядки можна вимкнути; один крок ⌘Z скасовує все."
          }
        }
      }
    },
    "spending.places.setFromNote.rule.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выдатку без месца выбіраецца месца, назва або псеўданім якога дакладна супадае з апісаннем. Можна адключыць асобныя радкі; адно дзеянне «Адмяніць» адменіць усё адразу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe ohne Ort bekommt den Ort, dessen Name oder weiterer Name genau ihrer Beschreibung entspricht. Zeilen können Sie ausschalten; „Rückgängig“ nimmt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense with no place gets the place whose name or alias is exactly its description. You can switch lines off; one “Undo” takes it all back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gasto sin lugar recibe el lugar cuyo nombre u otro nombre coincide exactamente con su descripción. Puede desactivar líneas; un «Deshacer» lo deshace todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense sans lieu reçoit le lieu dont le nom ou l'autre nom est exactement sa description. Vous pouvez désactiver des lignes ; un seul « Annuler » reprend tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni spesa senza luogo viene assegnato il luogo il cui nome o alias corrisponde esattamente alla descrizione. Puoi disattivare le righe; “Annulla” annulla tutto in un solo passaggio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орны жоқ шығынға атауы не балама атауы сипаттамамен дәл сәйкес келетін орын қойылады. Жолдарды өшіруге болады; бір “Болдырмау” бәрін қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do wydatku bez miejsca zostanie przypisane miejsce, którego nazwa lub alias jest identyczny z opisem. Możesz wyłączyć wybrane wiersze; jedno „Cofnij” cofnie całą operację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma despesa sem local recebe o local cujo nome ou alias corresponde exatamente à descrição. Você pode desativar linhas; um toque em “Desfazer” reverte tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трата без места получает место, название или псевдоним которого в точности совпадает с описанием. Строки можно снять; одно нажатие «Отменить» вернёт всё назад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeri belirtilmemiş bir harcamaya, adı veya diğer adı açıklamayla tam eşleşen yer atanır. Satırları kapatabilirsiniz; “Geri Al” ile tümünü geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витраті без місця призначається місце, назва або псевдонім якого точно збігаються з її описом. Рядки можна вимкнути; один крок «Скасувати» повертає все."
          }
        }
      }
    },
