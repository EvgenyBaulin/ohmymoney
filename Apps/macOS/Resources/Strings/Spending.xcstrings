    "spending.yearAgo.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alətlər panelindəki ayın ötən ilin eyni ayı ilə kateqoriyalar üzrə müqayisəsi; yalnız sizin xərcləriniz"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Параўнанне выбранага месяца з тым жа месяцам год таму па катэгорыях; толькі вашы выдаткі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíc vybraný na panelu oproti stejnému měsíci před rokem, podle kategorií; jen vaše výdaje"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monat der Werkzeugleiste gegenüber demselben Monat ein Jahr davor, nach Kategorie; nur Sie, sonst niemand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month of the toolbar against the same month a year before, by category; only you, nobody else"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes de la barra de herramientas frente al mismo mes del año anterior, por categoría; solo usted, nadie más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mois de la barre d'outils comparé au même mois un an plus tôt, par catégorie ; vous seul, personne d'autre"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործիքագոտում ընտրված ամիսը՝ նախորդ տարվա նույն ամսվա համեմատ, ըստ կատեգորիաների․ միայն ձեր տվյալները"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mese selezionato nella barra degli strumenti a confronto con lo stesso mese dell'anno precedente, per categoria; solo le tue spese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーで選択した月と前年同月をカテゴリ別に比較。自分の取引のみ"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხელსაწყოთა ზოლში არჩეული თვე წინა წლის იმავე თვესთან შედარებით, კატეგორიების მიხედვით; მხოლოდ თქვენი ხარჯები"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құралдар тақтасындағы айды былтырғы сол аймен санат бойынша салыстыру; тек өзіңіз, басқаларсыз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Куралдар тилкесинде тандалган айды өткөн жылдын ошол эле айы менен категориялар боюнча салыштыруу; өзүңүздүн гана чыгымдарыңыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maand in de knoppenbalk vergeleken met dezelfde maand een jaar eerder, per categorie; alleen jouw uitgaven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównanie miesiąca wybranego na pasku narzędzi z tym samym miesiącem rok wcześniej, według kategorii; tylko Twoje wydatki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mês selecionado na barra de ferramentas comparado ao mesmo mês do ano anterior, por categoria; apenas seus gastos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mês selecionado na barra de ferramentas comparado com o mesmo mês do ano anterior, por categoria; apenas as suas despesas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц из панели против того же месяца год назад, по категориям; только вы сами"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моҳи интихобшуда дар панели асбобҳо бо ҳамон моҳи соли гузашта аз рӯи категория муқоиса мешавад; танҳо хароҷоти шумо"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç çubuğunda seçilen ayın geçen yılın aynı ayıyla kategoriye göre karşılaştırması; yalnızca sizin harcamalarınız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць з панелі інструментів проти того самого місяця роком раніше, за категоріями; лише ви, ніхто інший"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asboblar panelida tanlangan oy o‘tgan yilning shu oyi bilan toifalar bo‘yicha solishtiriladi; faqat sizning xarajatlaringiz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按类别比较工具栏所选月份与去年同月的支出；仅包含你的支出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按類別比較工具列所選月份與去年同月；僅計入你的支出"
          }
        }
      }
    },
