            "value": "Açıklamalarınız kayıtlı yerlerle eşleşmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден опис не збігається з вашим місцем"
          }
        }
      }
