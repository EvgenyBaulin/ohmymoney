    "spending.tile.usual.lowData": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumat yetərli deyil: %2$lld gündən %1$lld günündə xərc var"
          }
        },
        "be": {
