    "spending.receipt.basis": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Па месяцах за апошнія 12 месяцаў; улічваюцца месяцы з двума і больш наведваннямі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Monat, letzte zwölf Monate; ein Monat zählt ab zwei Besuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By month, last twelve months; a month counts with at least two visits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por mes, últimos doce meses; un mes cuenta con al menos dos visitas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par mois, les douze derniers mois ; un mois compte à partir de deux visites"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mese, negli ultimi dodici mesi; un mese viene incluso se ha almeno due visite"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай бойынша, соңғы он екі ай; кемінде екі рет барған ай есептеледі"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Według miesięcy, ostatnie 12 miesięcy; uwzględniane są miesiące z co najmniej dwiema wizytami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por mês, nos últimos 12 meses; apenas meses com pelo menos duas visitas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По месяцам за последние двенадцать; месяц входит, если в нём хотя бы два визита"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 12 ay, aylara göre; en az iki ziyaret içeren aylar sayılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За місяцями, останні дванадцять місяців; місяць враховується, якщо є щонайменше два відвідування"
          }
        }
      }
    },
