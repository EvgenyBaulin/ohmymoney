    "spending.places.setFromNote": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məkanları təsvirlərdən təyin et"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вызначыць месцы па апісаннях"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavit místa podle popisů"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orte aus Beschreibungen setzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set places from descriptions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner lugares a partir de las descripciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renseigner les lieux d'après les descriptions"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշել վայրերը նկարագրություններից"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta luoghi dalle descrizioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明から場所を設定"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ადგილების მითითება აღწერებით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сипаттамалардан орындарды қою"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жерлерди сүрөттөмөлөрдөн аныктоо"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locaties instellen op basis van beschrijvingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw miejsca na podstawie opisów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir locais pelas descrições"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir locais a partir das descrições"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставить место по описанию"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таъйини ҷойҳо аз тавсифҳо"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıklamalardan yerleri ayarla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призначити місця з описів"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavsiflardan joylarni belgilash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据描述设置地点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從描述設定地點"
          }
        }
      }
    },
    "spending.places.setFromNote.rule": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məkanı olmayan xərcə adı və ya alternativ adı təsvirlə tam eyni olan məkan təyin edilir. Sətirləri söndürə bilərsiniz; ⌘Z bütün dəyişiklikləri geri qaytarır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выдатку без месца выбіраецца месца, назва або псеўданім якога дакладна супадае з апісаннем. Можна адключыць асобныя радкі; ⌘Z адменіць усё адразу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výdaji bez místa se přiřadí místo, jehož název nebo alias přesně odpovídá popisu. Řádky můžete vypnout; jedním stisknutím ⌘Z vrátíte vše zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe ohne Ort bekommt den Ort, dessen Name oder weiterer Name genau ihrer Beschreibung entspricht. Zeilen können Sie ausschalten; ein Schritt von ⌘Z nimmt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense with no place gets the place whose name or alias is exactly its description. You can switch lines off; one step of ⌘Z takes it all back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gasto sin lugar recibe el lugar cuyo nombre u otro nombre coincide exactamente con su descripción. Puede desactivar líneas; un paso de ⌘Z lo deshace todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense sans lieu reçoit le lieu dont le nom ou l'autre nom est exactement sa description. Vous pouvez désactiver des lignes ; un seul ⌘Z reprend tout."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց վայրի ծախսին նշանակվում է այն վայրը, որի անունը կամ այլանունը ճշգրտորեն համընկնում է նկարագրությանը։ Կարող եք անջատել տողերը․ ⌘Z-ի մեկ սեղմումը կչեղարկի ամենը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni spesa senza luogo viene assegnato il luogo il cui nome o alias corrisponde esattamente alla descrizione. Puoi disattivare le righe; ⌘Z annulla tutto in un solo passaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所が未設定の支出には、説明と名前または別名が完全に一致する場所が設定されます。行ごとにオフにできます。⌘Zを1回押すとすべて元に戻ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯს ადგილის გარეშე მიენიჭება ადგილი, რომლის სახელი ან სხვა სახელწოდება ზუსტად ემთხვევა აღწერას. შეგიძლიათ გამორთოთ სტრიქონები; ⌘Z ყველაფერს ერთდროულად გააუქმებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орны жоқ шығынға атауы не балама атауы сипаттамамен дәл сәйкес келетін орын қойылады. Жолдарды өшіруге болады; ⌘Z бір қадамда бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жери көрсөтүлбөгөн чыгымга аталышы же башка аты анын сүрөттөмөсүнө так дал келген жер коюлат. Саптарды өчүрө аласыз; ⌘Z баарын бир кадамда артка кайтарат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een uitgave zonder locatie krijgt de locatie waarvan de naam of alias exact overeenkomt met de beschrijving. Je kunt regels uitschakelen; met één keer ⌘Z maak je alles ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do wydatku bez miejsca zostanie przypisane miejsce, którego nazwa lub alias jest identyczny z opisem. Możesz wyłączyć wybrane wiersze; jedno ⌘Z cofnie całą operację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma despesa sem local recebe o local cujo nome ou alias corresponde exatamente à descrição. Você pode desativar linhas; ⌘Z desfaz tudo de uma vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada despesa sem local é atribuído o local cujo nome ou nome alternativo corresponda exatamente à descrição. Pode desativar linhas; prima ⌘Z uma vez para desfazer tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трата без места получает место, название или псевдоним которого в точности совпадает с описанием. Строки можно снять; один шаг ⌘Z вернёт всё назад."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба хароҷоти бе ҷой ҷойе таъйин мешавад, ки ном ё номи дигараш бо тавсиф пурра мувофиқат мекунад. Сатрҳоро хомӯш кардан мумкин аст; ⌘Z ҳамаашро якбора бекор мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeri belirtilmemiş bir harcamaya, adı veya diğer adı açıklamayla tam eşleşen yer atanır. Satırları kapatabilirsiniz; ⌘Z ile tümünü geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витраті без місця призначається місце, назва або псевдонім якого точно збігаються з її описом. Рядки можна вимкнути; один крок ⌘Z скасовує все."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Joyi ko‘rsatilmagan xarajatga nomi yoki boshqa nomi tavsifga aynan mos keladigan joy belgilanadi. Satrlarni o‘chirishingiz mumkin; ⌘Z barcha o‘zgarishlarni bir yo‘la bekor qiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有地点的支出会匹配名称或别名与描述完全相同的地点。你可以关闭部分条目；按一次 ⌘Z 即可全部撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有地點的支出會套用名稱或別名與描述完全相符的地點。你可以取消勾選項目；按一次 ⌘Z 即可全部還原。"
          }
        }
      }
    },
    "spending.places.setFromNote.rule.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məkanı olmayan xərcə adı və ya alternativ adı təsvirlə tam eyni olan məkan təyin edilir. Sətirləri söndürə bilərsiniz; “Geri al” bütün dəyişiklikləri geri qaytarır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выдатку без месца выбіраецца месца, назва або псеўданім якога дакладна супадае з апісаннем. Можна адключыць асобныя радкі; адно дзеянне «Адмяніць» адменіць усё адразу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výdaji bez místa se přiřadí místo, jehož název nebo alias přesně odpovídá popisu. Řádky můžete vypnout; jedním klepnutím na „Zpět“ vrátíte vše zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe ohne Ort bekommt den Ort, dessen Name oder weiterer Name genau ihrer Beschreibung entspricht. Zeilen können Sie ausschalten; „Rückgängig“ nimmt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense with no place gets the place whose name or alias is exactly its description. You can switch lines off; one “Undo” takes it all back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gasto sin lugar recibe el lugar cuyo nombre u otro nombre coincide exactamente con su descripción. Puede desactivar líneas; un «Deshacer» lo deshace todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense sans lieu reçoit le lieu dont le nom ou l'autre nom est exactement sa description. Vous pouvez désactiver des lignes ; un seul « Annuler » reprend tout."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց վայրի ծախսին նշանակվում է այն վայրը, որի անունը կամ այլանունը ճշգրտորեն համընկնում է նկարագրությանը։ Կարող եք անջատել տողերը․ «Չեղարկել»-ի մեկ սեղմումը կչեղարկի ամենը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni spesa senza luogo viene assegnato il luogo il cui nome o alias corrisponde esattamente alla descrizione. Puoi disattivare le righe; “Annulla” annulla tutto in un solo passaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所が未設定の支出には、説明と名前または別名が完全に一致する場所が設定されます。行ごとにオフにできます。「取り消す」を1回実行するとすべて元に戻ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯს ადგილის გარეშე მიენიჭება ადგილი, რომლის სახელი ან სხვა სახელწოდება ზუსტად ემთხვევა აღწერას. შეგიძლიათ გამორთოთ სტრიქონები; ერთი „გაუქმება“ ყველაფერს დააბრუნებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орны жоқ шығынға атауы не балама атауы сипаттамамен дәл сәйкес келетін орын қойылады. Жолдарды өшіруге болады; бір “Болдырмау” бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жери көрсөтүлбөгөн чыгымга аталышы же башка аты анын сүрөттөмөсүнө так дал келген жер коюлат. Саптарды өчүрө аласыз; “Артка кайтаруу” баарын бир кадамда жокко чыгарат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een uitgave zonder locatie krijgt de locatie waarvan de naam of alias exact overeenkomt met de beschrijving. Je kunt regels uitschakelen; met één keer ‘Herstel’ maak je alles ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do wydatku bez miejsca zostanie przypisane miejsce, którego nazwa lub alias jest identyczny z opisem. Możesz wyłączyć wybrane wiersze; jedno „Cofnij” cofnie całą operację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma despesa sem local recebe o local cujo nome ou alias corresponde exatamente à descrição. Você pode desativar linhas; um toque em “Desfazer” reverte tudo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada despesa sem local é atribuído o local cujo nome ou nome alternativo corresponda exatamente à descrição. Pode desativar linhas; toque uma vez em “Desfazer” para repor tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трата без места получает место, название или псевдоним которого в точности совпадает с описанием. Строки можно снять; одно нажатие «Отменить» вернёт всё назад."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба хароҷоти бе ҷой ҷойе таъйин мешавад, ки ном ё номи дигараш бо тавсиф пурра мувофиқат мекунад. Сатрҳоро хомӯш кардан мумкин аст; як маротиба “Бекор кардан” ҳамаашро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeri belirtilmemiş bir harcamaya, adı veya diğer adı açıklamayla tam eşleşen yer atanır. Satırları kapatabilirsiniz; “Geri Al” ile tümünü geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витраті без місця призначається місце, назва або псевдонім якого точно збігаються з її описом. Рядки можна вимкнути; один крок «Скасувати» повертає все."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Joyi ko‘rsatilmagan xarajatga nomi yoki boshqa nomi tavsifga aynan mos keladigan joy belgilanadi. Satrlarni o‘chirishingiz mumkin; «Bekor qilish» barcha o‘zgarishlarni bir yo‘la bekor qiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有地点的支出会匹配名称或别名与描述完全相同的地点。你可以关闭部分条目；轻点一次“撤销”即可全部撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有地點的支出會套用名稱或別名與描述完全相符的地點。你可以取消勾選項目；點一下「還原」即可全部還原。"
          }
        }
      }
    },
