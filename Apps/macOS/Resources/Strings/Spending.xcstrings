    "spending.yearAgo.basis": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Параўнанне выбранага месяца з тым жа месяцам год таму па катэгорыях; толькі вашы выдаткі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monat der Werkzeugleiste gegenüber demselben Monat ein Jahr davor, nach Kategorie; nur Sie, sonst niemand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month of the toolbar against the same month a year before, by category; only you, nobody else"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes de la barra de herramientas frente al mismo mes del año anterior, por categoría; solo usted, nadie más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mois de la barre d'outils comparé au même mois un an plus tôt, par catégorie ; vous seul, personne d'autre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mese selezionato nella barra degli strumenti a confronto con lo stesso mese dell'anno precedente, per categoria; solo le tue spese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құралдар тақтасындағы айды былтырғы сол аймен санат бойынша салыстыру; тек өзіңіз, басқаларсыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównanie miesiąca wybranego na pasku narzędzi z tym samym miesiącem rok wcześniej, według kategorii; tylko Twoje wydatki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mês selecionado na barra de ferramentas comparado ao mesmo mês do ano anterior, por categoria; apenas seus gastos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц из панели против того же месяца год назад, по категориям; только вы сами"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç çubuğunda seçilen ayın geçen yılın aynı ayıyla kategoriye göre karşılaştırması; yalnızca sizin harcamalarınız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць з панелі інструментів проти того самого місяця роком раніше, за категоріями; лише ви, ніхто інший"
          }
        }
      }
    },
