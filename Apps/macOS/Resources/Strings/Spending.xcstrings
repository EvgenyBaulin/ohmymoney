            "value": "Ҷое, ки дар ҳадди ақал 6 ҳафта аз 8 ҳафтаи охир боздид шудааст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 8 haftanın en az 6'sında ziyaret edilen yerler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місце, яке відвідували щонайменше 6 разів за останні 8 тижнів"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi 8 haftadan kamida 6 tasida borilgan joy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 8 周中至少有 6 周到访的地点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 8 週中至少有 6 週曾造訪的地點"
          }
        }
      }
    },
    "spending.habits.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ vərdiş yoxdur: 8 həftədə heç bir məkana 6 dəfə gedilməyib"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма звычак: ніводнае месца не наведана 6 разоў за 8 тыдняў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné návyky: žádné místo nemá 6 návštěv za 8 týdnů"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Gewohnheiten: Kein Ort hat 6 Besuche in 8 Wochen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No habits yet: no place has 6 visits in 8 weeks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay hábitos: ningún lugar tiene 6 visitas en 8 semanas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'habitudes : aucun lieu n'a 6 visites en 8 semaines"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ սովորություններ չկան․ 8 շաբաթում ոչ մի վայր 6 անգամ չեք այցելել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna abitudine: nessun luogo visitato in 6 delle ultime 8 settimane"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣はまだありません。8週間のうち6週間以上訪れた場所はありません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩვევები ჯერ არ არის: არცერთ ადგილს არ აქვს 6 ვიზიტი 8 კვირაში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әлі әдеттер жоқ: ешбір орынға 8 аптада 6 рет барылмаған"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча адаттар жок: 8 аптада 6 жолу барган жер жок"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen gewoonten: geen locatie is 6 keer bezocht in 8 weken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak nawyków: żadne miejsce nie było odwiedzane przez 6 z 8 tygodni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum hábito: nenhum local foi visitado em 6 das últimas 8 semanas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há hábitos: nenhum local teve 6 visitas em 8 semanas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычек пока нет: ни в одном месте нет визитов в 6 из 8 недель"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло одате нест: ягон ҷой дар 8 ҳафта 6 бор боздид нашудааст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz alışkanlık yok: 8 haftada 6 kez ziyaret edilen yer yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звичок ще немає: жодне місце не має 6 відвідувань за 8 тижнів"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha odatlar yo‘q: 8 haftada hech bir joyga 6 marta borilmagan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无习惯：没有地点在 8 周内到访 6 次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無習慣：沒有地點在 8 週內造訪達 6 次"
          }
        }
      }
    },
