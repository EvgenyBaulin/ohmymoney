    "spending.hours.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç ayda hesablarınıza daxil olan orta qazancınızın ayda işlədiyiniz saatlara nisbəti"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сярэдні заробак за апошнія тры месяцы, які паступіў на вашы рахункі, падзелены на колькасць працоўных гадзін за месяц"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průměrný příjem připsaný na vaše účty za poslední tři měsíce, vydělený počtem pracovních hodin za měsíc"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr durchschnittlicher Verdienst der letzten drei Monate, was auf Ihren Konten ankam, über die Stunden, die Sie im Monat arbeiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average earnings of the last three months, what reached your accounts, over the hours you work in a month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus ingresos medios de los últimos tres meses, lo que llegó a sus cuentas, entre las horas que trabaja en un mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos gains moyens des trois derniers mois, ce qui est arrivé sur vos comptes, rapportés aux heures que vous travaillez dans un mois"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին երեք ամսում ձեր հաշիվներին հասած միջին վաստակը՝ բաժանած ամսական աշխատանքային ժամերի վրա"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La media dei guadagni degli ultimi tre mesi, ricevuti sui tuoi conti, divisa per le ore lavorate in un mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去3か月に口座に入った収入の平均を、月の労働時間で割った金額"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო სამ თვეში თქვენს ანგარიშებზე მიღებული საშუალო შემოსავალი, გაყოფილი თვეში სამუშაო საათებზე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы үш айда шоттарыңызға түскен орташа табыстың айлық жұмыс сағатына қатынасы"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы үч айда эсептериңизге түшкөн орточо киреше жана айына иштеген сааттарыңыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gemiddelde inkomsten van de afgelopen drie maanden op je rekeningen, gedeeld door het aantal uren dat je per maand werkt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnie wpływy na Twoje konta z ostatnich trzech miesięcy, podzielone przez liczbę godzin pracy w miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A média do que você recebeu nas suas contas nos últimos três meses, dividida pelas horas que trabalha por mês"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os rendimentos médios recebidos nas suas contas nos últimos três meses, divididos pelas horas que trabalha num mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш средний заработок за последние три месяца, то, что пришло на счета, на часы работы в месяц"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади миёнаи се моҳи охир, ки ба ҳисобҳоятон ворид шудааст, тақсим бар соатҳои корӣ дар як моҳ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç ayda hesaplarınıza geçen ortalama gelirinizin, aylık çalışma saatinize oranı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш середній заробіток за останні три місяці — що надійшло на рахунки — поділений на години, які ви працюєте за місяць"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi uch oyda hisoblaringizga tushgan o‘rtacha daromadingiz, oylik ish soatlaringizga bo‘lingan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去三个月到账收入的月均值，除以每月工作小时数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去三個月實際入帳的平均收入，除以每月工作時數"
          }
        }
      }
    },
