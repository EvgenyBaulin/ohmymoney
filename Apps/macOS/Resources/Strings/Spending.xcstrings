            "state": "translated",
            "value": "Դեռ չկա վայր՝ մեկ ամսում երկու այցով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun luogo ha ancora due visite in un mese"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არცერთ ადგილს არ აქვს ორი ვიზიტი ერთ თვეში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге ешбір орынға бір айда екі рет барылмаған"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир айда эки жолу барган жер азырынча жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne miejsce nie ma jeszcze dwóch wizyt w jednym miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum local tem duas visitas no mesmo mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ни у одного места нет месяца с двумя визитами"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз ягон ҷой дар як моҳ ду боздид надорад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir ayda iki kez ziyaret edilen yer yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодне місце ще не має двох відвідувань в одному місяці"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha hech bir joyga bir oyda ikki marta tashrif buyurilmagan"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無地點在同一個月內造訪兩次"
          }
        }
      }
    },
