    "spending.people.basis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last twelve months: parts for the person plus what I wrote off for them; money still expected back is not spending"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimos doce meses: partes para la persona más lo que yo le di de baja; el dinero que todavía se espera de vuelta no es gasto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les douze derniers mois : les parts pour la personne plus ce que j'ai passé en pertes pour elle ; l'argent encore attendu en retour n'est pas une dépense"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние двенадцать месяцев: части на человека и списанное за него; то, что ещё ждёт возврата, не трата"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останні дванадцять місяців: частки на людину плюс те, що я списав за неї; гроші, які ще очікуються назад, не є витратами"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы он екі ай: адамға арналған бөліктер мен оған кешірген қарызым; қайтуы күтілетін ақша шығын емес"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten zwölf Monate: Teile für die Person plus was ich für sie abgeschrieben habe; Geld, das noch zurückerwartet wird, ist keine Ausgabe"
          }
        }
      }
    },
