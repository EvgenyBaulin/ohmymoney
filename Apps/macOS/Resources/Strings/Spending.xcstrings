    "spending.settings.weekend.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həftəsonunun dəyəri və həftəsonu üçün adi gün bu saatlara əsaslanır. Son həftənin əvvəlində ola bilər; bu halda həftəsonu növbəti həftəyə keçir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя гадзіны выкарыстоўваюцца для разліку кошту выхадных і звычайнага дня на выхадных. Канец можа прыпадаць на больш ранні дзень тыдня, чым пачатак; тады выхадныя працягваюцца на наступным тыдні."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Preis des Wochenendes und der übliche Tag am Wochenende nutzen diese Stunden. Das Ende kann in der Woche früher liegen als der Anfang; dann läuft das Wochenende über den Wochenwechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price of the weekend and the usual day on weekends use these hours. The end may fall earlier in the week than the start, then the weekend runs over the turn of the week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio del fin de semana y el día habitual en fin de semana usan estas horas. El final puede caer antes en la semana que el inicio; entonces el fin de semana cruza el cambio de semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix du week-end et le jour habituel le week-end utilisent ces heures. La fin peut tomber plus tôt dans la semaine que le début ; le week-end passe alors à cheval sur le changement de semaine."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ժամերն օգտագործվում են հանգստյան օրերի արժեքը և հանգստյան օրերի սովորական ծախսը հաշվելու համար։ Ավարտը կարող է շաբաթվա ընթացքում սկզբից շուտ լինել․ այդ դեպքում հանգստյան օրերը շարունակվում են հաջորդ շաբաթ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il costo del weekend e il giorno tipo nei weekend usano questi orari. La fine può precedere l'inizio nella settimana: in tal caso il weekend prosegue nella settimana successiva."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს საათები გამოიყენება უქმეების ფასისა და უქმეებზე ჩვეულებრივი დღის გამოსათვლელად. დასასრული შეიძლება კვირის უფრო ადრეულ დღეს იყოს — მაშინ უქმეები მომდევნო კვირაში გაგრძელდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демалыс құны мен демалыстағы әдеттегі күн осы сағаттарды қолданады. Аяқталуы аптада басталуынан ерте болуы мүмкін, онда демалыс апта ауысқанда жалғасады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сааттар дем алыштын наркын жана дем алыштагы кадимки күндү эсептөөдө колдонулат. Аяктоо күнү жума ичинде баштоо күнүнөн мурда болсо, дем алыш кийинки жумага өтөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te godziny służą do obliczania kosztu weekendu i typowego dnia weekendowego. Koniec może przypadać wcześniej w tygodniu niż początek — weekend obejmuje wtedy przełom tygodni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O custo do fim de semana e o dia habitual nos fins de semana usam estes horários. Se o fim vier antes do início na semana, o período passa para a semana seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена выходных и обычный день по выходным считаются по этим часам. Конец может приходиться раньше начала, тогда выходные идут через границу недели."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Арзиши рӯзҳои истироҳат ва рӯзи маъмулӣ дар рӯзҳои истироҳат аз ин соатҳо истифода мебаранд. Анҷом метавонад аз оғоз дар аввали ҳафта бошад; дар ин ҳолат рӯзҳои истироҳат ба ҳафтаи оянда мегузаранд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonu maliyeti ve hafta sonundaki tipik gün bu saatleri kullanır. Bitiş, haftanın başlangıçtan önceki bir gününe denk gelebilir; bu durumda hafta sonu sonraki haftaya uzanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціна вихідних і звичайний день на вихідних використовують ці години. Кінець може бути раніше в тижні, ніж початок, тоді вихідні переходять через межу тижня."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu vaqtlar dam olish kunlari narxi va odatiy kun hisobida ishlatiladi. Tugash vaqti hafta ichida boshlanish vaqtidan oldin bo‘lsa, dam olish kunlari keyingi haftaga o‘tadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週末花費和一般週末日的計算會使用此時段。結束時間可早於開始時間，週末時段將跨越一週的結尾。"
          }
        }
      }
    },
