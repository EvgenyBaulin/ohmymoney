    },
    "spending.cmp.basis": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі, як і ўсюды; аднаразовыя пакупкі ўваходзяць у агульныя сумы, але не ў сярэднія выдаткі за дзень"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben, wie überall; Einmalkäufe bleiben in den Summen und nicht im durchschnittlichen Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending, as everywhere; one-off purchases stay in the totals and out of the average day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto, como en todas partes; las compras puntuales se quedan en los totales y fuera del día medio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses, comme partout ; les achats ponctuels restent dans les totaux et hors du jour moyen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese, come nel resto dell’app; gli acquisti una tantum sono inclusi nei totali ma esclusi dalla media giornaliera"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық жердегідей өз шығындарым; бір реттік сатып алулар қорытындыда қалады, күндік орташаға кірмейді"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki, jak wszędzie; jednorazowe zakupy są uwzględniane w sumach, ale nie w średniej dziennej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos, como nas outras telas; compras pontuais entram nos totais, mas não na média diária"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы, как везде; разовые остаются в итогах и не входят в средний день"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer yerlerde olduğu gibi harcamalarım; tek seferlik alımlar toplamlara dahil edilir, günlük ortalamaya edilmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати, як скрізь; разові покупки лишаються в підсумках і не входять до середнього дня"
          }
        }
      }
    },
