    "spending.habits.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 8 həftənin ən azı 6-sında ziyarət edilən məkan"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Месца, наведанае не менш чым у 6 з апошніх 8 тыдняў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ort, der in mindestens 6 der letzten 8 Wochen besucht wurde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A place visited in at least 6 of the last 8 weeks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lugar visitado al menos 6 de las últimas 8 semanas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lieu visité au moins 6 fois sur les 8 dernières semaines"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վայրեր, որոնք այցելել եք վերջին 8 շաբաթից առնվազն 6-ում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un luogo visitato in almeno 6 delle ultime 8 settimane"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ადგილები, რომლებსაც ბოლო 8 კვირიდან სულ მცირე 6-ში ესტუმრეთ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 8 аптаның кемінде 6 аптасында барған орын"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы 8 аптанын кеминде 6сында барган жер"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce odwiedzone w co najmniej 6 z ostatnich 8 tygodni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Local visitado em pelo menos 6 das últimas 8 semanas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место, где вы бывали минимум в 6 из последних 8 недель"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷое, ки дар ҳадди ақал 6 ҳафта аз 8 ҳафтаи охир боздид шудааст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 8 haftanın en az 6'sında ziyaret edilen yerler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місце, яке відвідували щонайменше 6 разів за останні 8 тижнів"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi 8 haftadan kamida 6 tasida borilgan joy"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 8 週中至少有 6 週曾造訪的地點"
          }
        }
      }
    },
