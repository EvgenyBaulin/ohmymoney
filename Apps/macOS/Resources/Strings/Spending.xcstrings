    "spending.limit.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay ərzində kateqoriyanın üç ən böyük alışı; alt kateqoriyalar daxildir, geri ödənişlər çıxılıb"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тры найбольшыя пакупкі ў катэгорыі за месяц з улікам падкатэгорый і вяртанняў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tři největší nákupy v kategorii za měsíc, včetně podkategorií a po odečtení vratek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die drei größten Käufe der Kategorie im Monat, Unterkategorien eingeschlossen, Erstattungen abgezogen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The three largest purchases of the category in the month, subcategories included, refunds taken off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tres compras más grandes de la categoría en el mes, con subcategorías, descontadas las devoluciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trois plus gros achats de la catégorie dans le mois, sous-catégories comprises, remboursements déduits"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա երեք ամենախոշոր գնումները կատեգորիայում՝ ներառյալ ենթակատեգորիաները և հանած վերադարձները"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tre acquisti più costosi della categoria nel mese, incluse le sottocategorie e al netto dei rimborsi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月のこのカテゴリの購入額上位3件。サブカテゴリを含み、返金を差し引いています"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორიის სამი უდიდესი შენაძენი თვეში, ქვეკატეგორიების ჩათვლით და დაბრუნებების გამოკლებით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдағы санаттың ең ірі үш сатып алуы, ішкі санаттармен бірге, қайтарымдар шегеріледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Категориядагы айдын үч эң ири сатып алуусу, ички категориялар кошулуп, кайтарымдар алынган"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De drie grootste aankopen in de categorie deze maand, inclusief subcategorieën en na aftrek van terugbetalingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy największe zakupy w kategorii w tym miesiącu, z uwzględnieniem podkategorii i zwrotów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As três maiores compras da categoria no mês, incluindo subcategorias e descontando reembolsos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As três maiores compras da categoria no mês, incluindo subcategorias e descontando reembolsos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три самые крупные покупки категории за месяц, с подкатегориями, за вычетом возвратов"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Се хариди калонтарини категория дар як моҳ, бо зеркатегорияҳо ва пас аз тарҳи маблағҳои баргардонидашуда"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt kategoriler dahil, iadeler düşüldükten sonra kategorideki ayın en büyük üç alımı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Три найбільші покупки категорії за місяць, підкатегорії враховано, повернення віднято"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Toifaning shu oydagi uchta eng yirik xaridi, quyi toifalar bilan birga va qaytarilgan summalar chegirilgan holda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月该类别中金额最高的三笔购买，包括子类别，已扣除退款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當月此類別中金額最高的三筆購買，包含子類別並扣除退款"
          }
        }
      }
    },
