    "spending.cmp.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Müqayisə üçün dövrləri seçin: hadisə müqayisəsi üçün hadisə, xüsusi aralıqlar üçün isə sonu başlanğıcdan sonra olan iki aralıq lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце перыяды для параўнання: для пары з падзеяй патрэбна падзея, для ўласных перыядаў — абодва перыяды з датай заканчэння пасля пачатку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte období k porovnání. Pro porovnání události vyberte událost, pro vlastní období zadejte oba rozsahy s koncem po začátku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Zeiträume zum Vergleich: Ein Ereignispaar braucht ein Ereignis, ein eigener Bereich braucht beide Bereiche mit einem Ende nach dem Anfang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the periods to compare: an event pair needs an event, a custom range needs both ranges with an end after the start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija los periodos a comparar: un par de eventos necesita un evento, un rango a medida necesita los dos rangos con un final posterior al inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les périodes à comparer : une paire d'événements demande un événement, une plage personnalisée demande deux plages dont la fin est après le début."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք համեմատվող ժամանակահատվածները․ իրադարձությունը համեմատելու համար ընտրեք իրադարձություն, իսկ հատուկ միջակայքերի համար՝ երկու միջակայք՝ ավարտը սկզբից հետո։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i periodi da confrontare: per un confronto con un evento serve un evento; per intervalli personalizzati servono entrambi gli intervalli, con la fine successiva all’inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較する期間を選択してください。イベントとの比較にはイベントが必要です。期間を指定する場合は、両方の期間の終了日を開始日より後にしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ შესადარებელი პერიოდები: ღონისძიებასთან შესადარებლად საჭიროა ღონისძიება, ხოლო საკუთარი პერიოდებისთვის — ორივე პერიოდის დასაწყისი და მის შემდგომი დასასრული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыстыру кезеңдерін таңдаңыз: оқиғалар жұбына оқиға, еркін аралықтарға басталуынан кейін аяқталатын екі аралық қажет."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыштыруу үчүн мезгилдерди тандаңыз: окуяны салыштыруу үчүн окуя, ал эми өз мезгилдериңиз үчүн башталышы менен аягы көрсөтүлгөн эки аралык керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de perioden die je wilt vergelijken. Voor een evenement is een evenement nodig; voor aangepaste perioden zijn twee perioden nodig waarvan de einddatum na de begindatum ligt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz okresy do porównania: dla pary ze zdarzeniem wybierz zdarzenie, a dla własnych zakresów podaj oba zakresy z datą końcową po początkowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os períodos para comparar: para comparar um evento, escolha um evento; para períodos personalizados, informe as datas de início e fim de ambos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os períodos a comparar: para comparar um evento, selecione-o; para períodos personalizados, indique ambos com o fim após o início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, что сравнивать: для пары с событием нужно событие, для своего диапазона — оба диапазона, где конец не раньше начала."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Давраҳоро барои муқоиса интихоб кунед: барои муқоисаи рӯйдод рӯйдод лозим аст, барои давраҳои дилхоҳ бошад, ҳар ду давра бояд анҷоми пас аз оғоз дошта бошанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırılacak dönemleri seçin: Etkinlik karşılaştırması için bir etkinlik, özel karşılaştırma için bitişi başlangıcından sonra olan iki aralık gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть періоди для порівняння: пара з подією потребує події, власний діапазон — обох діапазонів з кінцем пізніше за початок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Taqqoslash uchun davrlarni tanlang: voqeani taqqoslash uchun voqea kerak, o‘z davrlaringiz uchun esa ikkala davrning tugash sanasi boshlanish sanasidan keyin bo‘lishi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要比较的时段：按事件比较需要选择事件；自定范围需要设置两个时段，且结束日期须晚于开始日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要比較的期間：比較活動需要選擇活動；自訂範圍需要設定兩個範圍，且結束日期須晚於開始日期。"
          }
        }
      }
    },
