    "spending.receipt.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son on iki ay üzrə; ayda ən azı iki ziyarət nəzərə alınır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Па месяцах за апошнія 12 месяцаў; улічваюцца месяцы з двума і больш наведваннямі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po měsících za posledních dvanáct měsíců; měsíc se započítá při alespoň dvou návštěvách"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Monat, letzte zwölf Monate; ein Monat zählt ab zwei Besuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By month, last twelve months; a month counts with at least two visits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por mes, últimos doce meses; un mes cuenta con al menos dos visitas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par mois, les douze derniers mois ; un mois compte à partir de deux visites"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ըստ ամիսների՝ վերջին տասներկու ամսում․ ամիսը հաշվվում է առնվազն երկու այցի դեպքում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mese, negli ultimi dodici mesi; un mese viene incluso se ha almeno due visite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去12か月の月別データ。月に2回以上の訪問がある場合に集計"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვეების მიხედვით, ბოლო 12 თვე; ითვლება თვე სულ მცირე ორი ვიზიტით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай бойынша, соңғы он екі ай; кемінде екі рет барған ай есептеледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы он эки ай, айлар боюнча; кеминде эки жолу барган айлар эсептелет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Per maand, over de afgelopen twaalf maanden; een maand telt mee bij minimaal twee bezoeken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Według miesięcy, ostatnie 12 miesięcy; uwzględniane są miesiące z co najmniej dwiema wizytami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por mês, nos últimos 12 meses; apenas meses com pelo menos duas visitas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por mês, nos últimos 12 meses; só contam meses com pelo menos duas visitas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По месяцам за последние двенадцать; месяц входит, если в нём хотя бы два визита"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз рӯи моҳ, дар 12 моҳи охир; моҳ бо ҳадди ақал ду боздид ҳисоб мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 12 ay, aylara göre; en az iki ziyaret içeren aylar sayılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За місяцями, останні дванадцять місяців; місяць враховується, якщо є щонайменше два відвідування"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "So‘nggi o‘n ikki oy, oylar bo‘yicha; kamida ikki tashrifli oylar hisobga olinadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按月统计过去十二个月；每月至少到访两次才计入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按月顯示最近十二個月；每月至少造訪兩次才會計入"
          }
        }
      }
    },
    "spending.receipt.noChart": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ heç bir məkanın bir ayda iki ziyarəti yoxdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма месцаў з двума наведваннямі за месяц"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné místo zatím nemá dvě návštěvy v jednom měsíci"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Ort hat zwei Besuche in einem Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No place has two visits in one month yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún lugar tiene todavía dos visitas en un mismo mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lieu n'a encore deux visites dans un même mois"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ չկա վայր՝ մեկ ամսում երկու այցով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun luogo ha ancora due visite in un mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1か月に2回以上訪問した場所はまだありません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არცერთ ადგილს არ აქვს ორი ვიზიტი ერთ თვეში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге ешбір орынға бір айда екі рет барылмаған"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир айда эки жолу барган жер азырынча жок"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen locatie heeft twee bezoeken in één maand"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne miejsce nie ma jeszcze dwóch wizyt w jednym miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum local tem duas visitas no mesmo mês"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há locais com duas visitas no mesmo mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ни у одного места нет месяца с двумя визитами"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз ягон ҷой дар як моҳ ду боздид надорад"
