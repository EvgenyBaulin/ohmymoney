    "spending.hours.basis": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сярэдні заробак за апошнія тры месяцы, які паступіў на вашы рахункі, падзелены на колькасць працоўных гадзін за месяц"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr durchschnittlicher Verdienst der letzten drei Monate, was auf Ihren Konten ankam, über die Stunden, die Sie im Monat arbeiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average earnings of the last three months, what reached your accounts, over the hours you work in a month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus ingresos medios de los últimos tres meses, lo que llegó a sus cuentas, entre las horas que trabaja en un mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos gains moyens des trois derniers mois, ce qui est arrivé sur vos comptes, rapportés aux heures que vous travaillez dans un mois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La media dei guadagni degli ultimi tre mesi, ricevuti sui tuoi conti, divisa per le ore lavorate in un mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы үш айда шоттарыңызға түскен орташа табыстың айлық жұмыс сағатына қатынасы"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnie wpływy na Twoje konta z ostatnich trzech miesięcy, podzielone przez liczbę godzin pracy w miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A média do que você recebeu nas suas contas nos últimos três meses, dividida pelas horas que trabalha por mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш средний заработок за последние три месяца, то, что пришло на счета, на часы работы в месяц"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç ayda hesaplarınıza geçen ortalama gelirinizin, aylık çalışma saatinize oranı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш середній заробіток за останні три місяці — що надійшло на рахунки — поділений на години, які ви працюєте за місяць"
          }
        }
      }
    },
    "spending.hours.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова даных: за апошнія тры месяцы няма заробку"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Daten: kein Verdienst in den letzten drei Monaten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough data: no earnings in the last three months"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos insuficientes: no hay ingresos en los últimos tres meses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données insuffisantes : pas de gains sur les trois derniers mois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati insufficienti: nessun guadagno negli ultimi tre mesi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерек жеткіліксіз: соңғы үш айда табыс жоқ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych: brak wpływów z pracy w ostatnich trzech miesiącach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados insuficientes: nenhum rendimento nos últimos três meses"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных: за последние три месяца нет заработка"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli veri yok: Son üç ayda gelir yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Даних замало: за останні три місяці заробітку немає"
          }
        }
      }
    },
    "spending.hours.off": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошт у гадзінах выключаны. Уключыце яго ў Наладах, у раздзеле «Планаванне»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Preis in Stunden ist ausgeschaltet. Schalten Sie ihn in den Einstellungen unter Planung ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price in hours is off. Turn it on in Settings, Planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio en horas está desactivado. Actívelo en Ajustes, Planificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix en heures est désactivé. Activez-le dans Réglages, Planification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo in ore è disattivato. Attivalo in Impostazioni, Pianificazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жұмыс сағатымен баға өшірулі. Баптаулардың Жоспарлау бөлімінде қосыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena w godzinach jest wyłączona. Włącz ją w Ustawieniach, w sekcji Planowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço em horas está desativado. Ative-o em Ajustes, Planejamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена в часах выключена. Включите её в «Настройках», раздел «Планирование»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat cinsinden fiyat kapalı. Ayarlar'da Planlama bölümünden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціну в годинах вимкнено. Увімкніть її в «Налаштування», «Планування»."
          }
        }
      }
    },
