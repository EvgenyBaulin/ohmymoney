    "spending.settings.weekend.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price of the weekend and the usual day on weekends use these hours. The end may fall earlier in the week than the start, then the weekend runs over the turn of the week."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена выходных и обычный день по выходным считаются по этим часам. Конец может приходиться раньше начала, тогда выходные идут через границу недели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціна вихідних і звичайний день на вихідних використовують ці години. Кінець може бути раніше в тижні, ніж початок, тоді вихідні переходять через межу тижня."
          }
        }
      }
    },
