    "afford.fewHistory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мала даных: менш за тры поўныя месяцы, таму час чакання разлічваецца толькі паводле абавязковых выдаткаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Verlauf: weniger als drei volle Monate, daher wird die Wartezeit nur aus den notwendigen Ausgaben gerechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little history: fewer than three full months, so the wait is counted from the obligatory spending only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco historial: menos de tres meses completos, así que la espera se calcula solo con el gasto obligatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique court : moins de trois mois complets, donc l'attente ne se calcule que d'après les dépenses obligatoires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronologia limitata: meno di tre mesi completi. L’attesa è calcolata solo sulle spese obbligatorie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарих аз: үш толық айдан аз, сондықтан күту уақыты тек міндетті шығындармен есептеледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат аз: үч толук айга жетпейт. Күтүү мөөнөтү милдеттүү чыгымдар боюнча гана эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mało danych: mniej niż trzy pełne miesiące, więc czas oczekiwania obliczono tylko na podstawie obowiązkowych wydatków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco histórico: menos de três meses completos. A espera é calculada apenas com os gastos obrigatórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало истории: меньше трёх полных месяцев, поэтому срок посчитан только по обязательным тратам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli geçmiş yok: Üç tam aydan az veri olduğundan bekleme süresi yalnızca zorunlu harcamalara göre hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало історії: менше трьох повних місяців, тому строк очікування обчислено лише за обов'язковими витратами."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarix kam: uch to‘liq oydan kam, shuning uchun kutish faqat majburiy xarajatlar asosida hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄不足三個完整月，因此僅依必要支出計算等待時間。"
          }
        }
      }
    },
