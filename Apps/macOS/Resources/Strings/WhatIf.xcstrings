    "afford.fewHistory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little history: fewer than three full months, so the wait is counted from the obligatory spending only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco historial: menos de tres meses completos, así que la espera se calcula solo con el gasto obligatorio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало истории: меньше трёх полных месяцев, поэтому срок посчитан только по обязательным тратам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало історії: менше трьох повних місяців, тому строк очікування обчислено лише за обов'язковими витратами."
          }
        }
      }
    },
    "afford.free": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free to spend now: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libre para gastar ahora: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно тратить сейчас: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз вільно для витрат: %@"
          }
        }
      }
    },
    "afford.noCount": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile an account first: without its balance the free money is not known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie antes una cuenta: sin su saldo no se sabe el dinero libre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала сверьте счёт: без остатка свободные деньги неизвестны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку звірте рахунок: без його залишку вільна сума невідома."
          }
        }
      }
    },
    "afford.notEnough": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No — %@ more is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No — hacen falta %@ más."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — не хватает %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні — бракує ще %@."
          }
        }
      }
    },
    "afford.notEnoughUntil": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No — not enough until %@, %@ more is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No — hasta el %1$@ no basta, hacen falta %2$@ más."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — не хватит до %@, нужно ещё %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні — до %@ не вистачає, потрібно ще %@."
          }
        }
      }
    },
    "afford.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not financial advice. The answer comes from your records and plans; it does not suggest a loan or an instalment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es asesoramiento financiero. La respuesta sale de sus registros y planes; no sugiere ningún préstamo ni plazo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не финансовая консультация. Ответ считается по вашим записям и планам и не предлагает кредит или рассрочку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не фінансова порада. Відповідь ґрунтується на ваших записах і планах та не пропонує кредиту або розстрочки."
          }
        }
      }
    },
    "afford.shift": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” moves a month later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se desplaza un mes más tarde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» сдвинется на месяц"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» зсувається на місяць пізніше"
          }
        }
      }
    },
    "afford.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I afford it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Me lo puedo permitir?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хватит ли?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи можу я собі це дозволити?"
          }
        }
      }
    },
    "afford.typeAmount": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
