    "afford.fewHistory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Verlauf: weniger als drei volle Monate, daher wird die Wartezeit nur aus den notwendigen Ausgaben gerechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little history: fewer than three full months, so the wait is counted from the obligatory spending only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало истории: меньше трёх полных месяцев, поэтому срок посчитан только по обязательным тратам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало історії: менше трьох повних місяців, тому строк очікування обчислено лише за обов'язковими витратами."
          }
        }
      }
    },
    "afford.free": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt frei verfügbar: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free to spend now: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно тратить сейчас: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз вільно для витрат: %@"
          }
        }
      }
    },
    "afford.noCount": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichen Sie zuerst ein Konto ab: Ohne seinen Saldo ist das freie Geld nicht bekannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile an account first: without its balance the free money is not known."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала сверьте счёт: без остатка свободные деньги неизвестны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку звірте рахунок: без його залишку вільна сума невідома."
          }
        }
      }
    },
    "afford.notEnough": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein — %@ mehr wird gebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No — %@ more is needed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — не хватает %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні — бракує ще %@."
          }
        }
      }
    },
    "afford.notEnoughUntil": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein — bis %@ reicht es nicht, %@ mehr wird gebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No — not enough until %@, %@ more is needed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — не хватит до %@, нужно ещё %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні — до %@ не вистачає, потрібно ще %@."
          }
        }
      }
    },
    "afford.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Finanzberatung. Die Antwort stammt aus Ihren Aufzeichnungen und Plänen; sie schlägt keinen Kredit und keine Ratenzahlung vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not financial advice. The answer comes from your records and plans; it does not suggest a loan or an instalment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не финансовая консультация. Ответ считается по вашим записям и планам и не предлагает кредит или рассрочку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не фінансова порада. Відповідь ґрунтується на ваших записах і планах та не пропонує кредиту або розстрочки."
          }
        }
      }
    },
    "afford.shift": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verschiebt sich um einen Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” moves a month later"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» сдвинется на месяц"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» зсувається на місяць пізніше"
          }
        }
      }
    },
    "afford.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann ich mir das leisten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I afford it?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хватит ли?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи можу я собі це дозволити?"
          }
        }
      }
    },
    "afford.typeAmount": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie den Preis ein, um die Antwort zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the price to see the answer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите цену — и появится ответ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ціну, щоб побачити відповідь."
          }
        }
      }
    },
    "afford.yes": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, es reicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, there is enough."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, хватает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, грошей вистачає."
          }
        }
      }
    },
    "afford.yesCushionBelowTarget": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, aber das Polster fällt unter sein Ziel: %1$@ übrig von %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, but the cushion drops below its target: %@ left of %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, но подушка опустится ниже цели: останется %@ при цели %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, але подушка стане меншою за ціль: залишиться %@ із %@."
          }
        }
      }
    },
    "afford.yesGoalsShift": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
