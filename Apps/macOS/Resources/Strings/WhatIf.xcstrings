{
  "sourceLanguage": "en",
  "strings": {
    "afford.amount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Price of the purchase"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена покупки"
          }
        }
      }
    },
    "afford.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        }
      }
    },
    "afford.fewHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little history: fewer than three full months, so the wait is counted from the obligatory spending only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало истории: меньше трёх полных месяцев, поэтому срок посчитан только по обязательным тратам."
          }
        }
      }
    },
    "afford.free": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free to spend now: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно тратить сейчас: %@"
          }
        }
      }
    },
    "afford.noCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile an account first: without its balance the free money is not known."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала сверьте счёт: без остатка свободные деньги неизвестны."
          }
        }
      }
    },
    "afford.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No — %@ more is needed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — не хватает %@."
          }
        }
      }
    },
    "afford.notEnoughUntil": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No — not enough until %@, %@ more is needed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — не хватит до %@, нужно ещё %@."
          }
        }
      }
    },
    "afford.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not financial advice. The answer comes from your records and plans; it does not suggest a loan or an instalment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не финансовая консультация. Ответ считается по вашим записям и планам и не предлагает кредит или рассрочку."
          }
        }
      }
    },
    "afford.shift": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” moves a month later"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» сдвинется на месяц"
          }
        }
      }
    },
    "afford.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I afford it?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хватит ли?"
          }
        }
      }
    },
    "afford.typeAmount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the price to see the answer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите цену — и появится ответ."
          }
        }
      }
    },
    "afford.yes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, there is enough."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, хватает."
          }
        }
      }
    },
    "afford.yesCushionBelowTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, but the cushion drops below its target: %@ left of %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, но подушка опустится ниже цели: останется %@ при цели %@."
          }
        }
      }
    },
    "afford.yesGoalsShift": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, but a goal moves later:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, но цель сдвинется:"
          }
        }
      }
    },
    "afford.yesIfWait": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, if you wait until %@ (%@ more is needed)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, если подождать до %@ (нужно ещё %@)."
          }
        }
      }
    },
