          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите цену — и появится ответ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ціну, щоб побачити відповідь."
          }
        }
      }
    },
    "afford.yes": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, there is enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, hay suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, хватает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, грошей вистачає."
          }
        }
      }
    },
    "afford.yesCushionBelowTarget": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, but the cushion drops below its target: %@ left of %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, pero el colchón baja de su objetivo: queda %1$@ de %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, но подушка опустится ниже цели: останется %@ при цели %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, але подушка стане меншою за ціль: залишиться %@ із %@."
          }
        }
      }
    },
    "afford.yesGoalsShift": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, but a goal moves later:"
