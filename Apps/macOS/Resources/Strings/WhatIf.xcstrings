    "whatif.unread": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце суму і колькасць месяцаў — да таго радок не ўлічваецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie Betrag und Monate ein — bis dahin bleibt eine Zeile weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in the amount and months — until then a line is left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellene el importe y los meses — hasta entonces una línea se deja fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renseignez le montant et les mois — d'ici là, une ligne est laissée de côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci importo e mesi; fino ad allora la riga viene esclusa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сома мен айларды толтырыңыз — оған дейін жол есептелмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумманы жана айлардын санын киргизиңиз — ага чейин сап эсепке алынбайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzupełnij kwotę i liczbę miesięcy — do tego czasu pozycja będzie pomijana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha o valor e os meses. Até lá, a linha não será incluída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите сумму и месяцы — пока строка не учитывается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarı ve ay sayısını girin; girilene kadar satır hesaba katılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заповніть суму й місяці — до того рядок не враховується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Miqdor va oylarni kiriting — shundan keyin qator hisobga olinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫金額和月數，否則該項目不會納入計算。"
          }
        }
      }
    },
