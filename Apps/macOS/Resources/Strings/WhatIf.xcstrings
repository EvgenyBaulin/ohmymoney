    "afford.noCount": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку зверце рахунак: без яго балансу свабодныя грошы невядомыя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichen Sie zuerst ein Konto ab: Ohne seinen Saldo ist das freie Geld nicht bekannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile an account first: without its balance the free money is not known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie antes una cuenta: sin su saldo no se sabe el dinero libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez d'abord un compte : sans son solde, l'argent libre n'est pas connu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima riconcilia un conto: senza il saldo non si conosce il denaro disponibile."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдымен шотты салыстырыңыз: қалдығынсыз бос ақша белгісіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адегенде эсепти тактаңыз: анын калдыгы жок болгондуктан, бош акча белгисиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw uzgodnij konto: bez jego salda nie można ustalić dostępnych środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie uma conta primeiro: sem o saldo, não é possível saber quanto está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала сверьте счёт: без остатка свободные деньги неизвестны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir hesabı mutabık hale getirin. Hesap bakiyesi olmadan harcanabilir tutar bilinemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку звірте рахунок: без його залишку вільна сума невідома."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval hisob qoldig‘ini tekshiring: qoldiqsiz bo‘sh mablag‘ni aniqlab bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先核對帳戶：沒有餘額就無法得知可用金額。"
          }
        }
      }
    },
    "afford.notEnough": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не — не хапае %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein — %@ mehr wird gebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No — %@ more is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No — hacen falta %@ más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non — il manque encore %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No, mancano %@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоқ — тағы %@ қажет."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жок — дагы %@ керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie — brakuje %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não — faltam %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — не хватает %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayır — %@ daha gerekli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні — бракує ще %@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo‘q — yana %@ kerak."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不行，還差 %@。"
          }
        }
      }
    },
    "afford.notEnoughUntil": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не — да %@ грошай не хапае, патрэбна яшчэ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein — bis %@ reicht es nicht, %@ mehr wird gebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No — not enough until %@, %@ more is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No — hasta el %1$@ no basta, hacen falta %2$@ más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non — pas assez jusqu'au %@, il manque encore %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No, fino al %@ non bastano: mancano %@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоқ — %@ дейін жетпейді, тағы %@ қажет."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жок — %@ чейин жетпейт, дагы %@ керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie — do %@ nie wystarczy środków, brakuje %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não — até %@ ainda faltam %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет — не хватит до %@, нужно ещё %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayır — %@ tarihine kadar yeterli değil, %@ daha gerekli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні — до %@ не вистачає, потрібно ще %@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo‘q — %@ gacha yetmaydi, yana %@ kerak."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不行，到 %@ 前都不夠，還差 %@。"
          }
        }
      }
    },
    "afford.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта не фінансавая парада. Адказ заснаваны на вашых запісах і планах; ён не прадугледжвае крэдыту або растэрміноўкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Finanzberatung. Die Antwort stammt aus Ihren Aufzeichnungen und Plänen; sie schlägt keinen Kredit und keine Ratenzahlung vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not financial advice. The answer comes from your records and plans; it does not suggest a loan or an instalment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es asesoramiento financiero. La respuesta sale de sus registros y planes; no sugiere ningún préstamo ni plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas un conseil financier. La réponse vient de vos saisies et de vos plans ; elle ne suggère ni crédit ni échéancier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è una consulenza finanziaria. La risposta si basa sui tuoi dati e piani; non suggerisce prestiti o rate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қаржылық кеңес емес. Жауап жазбаларыңыз бен жоспарларыңыздан есептеледі; несие не бөліп төлеуді ұсынбайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул каржылык кеңеш эмес. Жооп жазууларыңызга жана пландарыңызга негизделет; насыя же бөлүп төлөө сунушталбайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest porada finansowa. Odpowiedź opiera się na Twoich zapisach i planach; nie sugeruje pożyczki ani zakupu na raty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não é uma recomendação financeira. A resposta usa seus registros e planos e não sugere empréstimos ou parcelamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не финансовая консультация. Ответ считается по вашим записям и планам и не предлагает кредит или рассрочку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir finansal tavsiye değildir. Yanıt kayıtlarınıza ve planlarınıza dayanır; kredi veya taksit önermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не фінансова порада. Відповідь ґрунтується на ваших записах і планах та не пропонує кредиту або розстрочки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu moliyaviy maslahat emas. Javob yozuvlaringiz va rejalaringizga asoslanadi; kredit yoki bo‘lib to‘lashni tavsiya qilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此結果不是財務建議，而是根據你的記錄和計畫計算，並非建議貸款或分期付款。"
          }
        }
      }
    },
    "afford.shift": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» пераносіцца на месяц"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verschiebt sich um einen Monat"
          }
        },
        "en": {
