    "bank.forgotten.mayCharge": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк можа браць плату за абслугоўванне"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank könnte für die Führung berechnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank may charge for the service"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco puede cobrar por el servicio"
          }
        },
