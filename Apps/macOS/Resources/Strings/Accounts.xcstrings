    "group.screen.excluded": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qrup yekuna daxil deyil: vəsaiti nə «Cəmi» məbləğində, nə də sərbəst məbləğdə sayılır; gəlir və xərcləri isə hər yerdə nəzərə alınır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Група па-за зводкай: яе грошы не ўваходзяць ва «Усяго» ці свабодную суму; даходы і выдаткі ўлічваюцца ўсюды."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupina není zahrnuta do souhrnu: její peníze nejsou v celkové ani volné částce. Její příjmy a výdaje se nadále započítávají všude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe ist aus der Übersicht herausgenommen: Ihr Geld zählt weder in „Gesamt“ noch im freien Betrag; ihre Einnahmen und Ausgaben zählen überall weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group is left out of the summary: its money is not in «Total» nor in the free sum; its income and spending still count everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo está fuera del resumen: su dinero no entra en «Total» ni en la suma libre; sus ingresos y gastos siguen contando en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe est exclu du récapitulatif : son argent n'est ni dans « Total » ni dans la somme libre ; ses revenus et dépenses comptent toujours partout."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խումբը ներառված չէ ամփոփագրում․ դրա գումարը չի մտնում ո՛չ «Ընդամենը»-ի, ո՛չ ազատ գումարի մեջ։ Եկամուտներն ու ծախսերը շարունակում են հաշվվել ամենուր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo è escluso dal riepilogo: il suo saldo non è incluso né in «Totale» né nella somma disponibile; le sue entrate e uscite vengono comunque conteggiate ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループは集計に含まれません。残高は「合計」と自由に使える金額に含まれませんが、収入と支出は引き続き集計されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯგუფი შეჯამებაში არ შედის: მისი თანხა არ აისახება არც «სულ» თანხაში და არც თავისუფალ თანხაში; შემოსავლები და ხარჯები კვლავ ყველგან ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топ қорытындыдан шығарылған: оның ақшасы «Барлығына» да, бос қаржыға да кірмейді; табысы мен шығысы әр жерде әлі есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹은 요약에서 제외됩니다. 그룹의 금액은 «합계»와 사용 가능 금액에 포함되지 않지만, 수입과 지출은 모든 곳에서 계산됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Топ жалпы эсепке кирбейт: анын акчасы «Бардыгына» да, бош суммага да кошулбайт. Кирешеси менен чыгашасы бардык жерде эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De groep staat niet in het overzicht: het geld telt niet mee in ‘Totaal’ of het vrije bedrag. Inkomen en uitgaven tellen overal wel mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupa jest pominięta w podsumowaniu: jej środki nie są uwzględniane w kwocie «Łącznie» ani w wolnych środkach. Jej przychody i wydatki są nadal wszędzie uwzględniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo está fora do resumo: seu dinheiro não aparece em «Total» nem no valor livre; suas receitas e despesas continuam sendo contabilizadas em todos os lugares."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo está excluído do resumo: o seu dinheiro não entra no «Total» nem no saldo disponível; os seus rendimentos e despesas continuam a contar em todo o lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа не в общей сводке: её деньги не входят во «Всего» и в свободную сумму; доходы и траты учитываются везде."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гурӯҳ ба ҷамъбаст дохил нест: маблағи он дар «Ҳамагӣ» ва маблағи озод ҳисоб намешавад; даромад ва хароҷоти он ҳамоно дар ҳама ҷо ҳисоб мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup özete dahil değil: parası «Toplam»a veya kullanılabilir tutara katılmaz; gelir ve harcamaları ise her yerde hesaba katılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групу вилучено з підсумку: її гроші не входять ані до «Усього», ані до вільної суми; її доходи й витрати всюди враховуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Guruh umumiy hisobga kiritilmagan: uning mablag‘i «Jami» va erkin summaga qo‘shilmaydi; daromad va xarajatlari esa hamma joyda hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分组不计入汇总：其中的资金不计入“总计”或可用金额；收入和支出仍会计入各处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此群組不計入摘要：其資金不計入「總計」或可用金額，但收入和支出仍計入所有相關統計。"
          }
        }
      }
    },
