    "account.editor.accentHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Каляровая кропка побач з рахункам у спісах і паласа на яго картцы. Назва заўсёды напісана побач."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Punkt in dieser Farbe steht in den Listen neben dem Konto, ein Streifen auf seiner Karte. Der Name steht immer daneben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dot of it stands by the account in the lists and a stripe on its card. The name is always written next to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto de ese color acompaña a la cuenta en las listas y una franja en su tarjeta. El nombre siempre se escribe junto a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point de cette couleur accompagne le compte dans les listes et une bande orne sa carte. Le nom est toujours écrit à côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto colorato appare accanto al conto negli elenchi e una striscia sulla sua scheda. Il nome è sempre indicato accanto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның нүктесі тізімдерде есеп-шот жанында, ал картасында жолақ болып тұрады. Атауы әрқашан соның жанында жазылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тизмелерде эсептин жанында түстүү чекит, ал эми анын карточкасында тилке көрсөтүлөт. Жанында дайыма аталышы жазылат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolorowa kropka pojawia się obok konta na listach, a pasek na jego kafelku. Nazwa jest zawsze widoczna obok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor aparece como um ponto ao lado da conta nas listas e como uma faixa no cartão da conta. O nome aparece sempre ao lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точка этого цвета стоит у счёта в списках, полоска — у его карточки. Рядом всегда написано название счёта."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар рӯйхатҳо назди ҳисоб нуқтаи ранга ва дар корти он рах нишон дода мешавад. Ном ҳамеша дар паҳлуяш навишта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listelerde hesabın yanında bu renkte bir nokta, hesap kartında ise bir şerit gösterilir. Adı her zaman yanında yazılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його крапка стоїть біля рахунку в списках, а смужка — на його картці. Назва завжди пишеться поруч."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro‘yxatlarda hisob yonida rangli nuqta, hisob kartasida esa chiziq ko‘rsatiladi. Nom har doim yonida yoziladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶在列表中會顯示色點，在卡片上則會顯示色條，旁邊一律附有名稱。"
          }
        }
      }
    },
