    "account.merge.emptyKeepsCount": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer — „%@“ behält ihren letzten Stand; die Vergangenheit des anderen Kontos wird zur Historie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty — «%@» keeps its latest count; the other account's past becomes history."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бос — «%@» соңғы санауын сақтайды; басқа есеп-шоттың өткені тарихқа айналады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусто — «%@» останется со своей последней сверкой, прошлое второго счёта станет историей."
          }
        }
      }
    },
    "account.merge.into": {
