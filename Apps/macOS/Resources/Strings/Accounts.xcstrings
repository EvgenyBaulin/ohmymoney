    "account.editor.cushionHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс рахунку — падушка: на колькі месяцаў яе хопіць, паказана ў «Капітале»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo des Kontos ist das Polster: Wie viele Monate es reicht, steht unter „Kapital“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance of the account is the cushion: how many months it lasts is on «Capital»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de la cuenta es el colchón: cuántos meses dura se ve en «Capital»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde du compte est le matelas : le nombre de mois qu'il couvre se trouve dans « Capital »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo del conto costituisce il fondo di emergenza: in «Capital» puoi vedere per quanti mesi basta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттың теңгерімі — жастық: ол неше айға жететіні «Капиталда» көрсетіледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептин калдыгы — коопсуздук жаздыгы. Канча айга жетери «Капиталда» көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo konta stanowi poduszkę: liczbę miesięcy, na które wystarczy, zobaczysz w «Kapitał»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo da conta é a reserva: veja quantos meses ela dura em «Capital»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток счёта — подушка: на сколько месяцев её хватит, видно в «Капитале»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи ҳисоб захираи эҳтиётӣ аст: чанд моҳ басанда будани он дар «Capital» нишон дода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap bakiyesi güvence birikimidir. Kaç ay yeteceğini «Sermaye» bölümünde görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок рахунку і є подушкою: на «Капіталі» видно, на скільки місяців її вистачає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob qoldig‘i zaxira hisoblanadi. Uning necha oyga yetishi «Kapital»da ko‘rsatiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶餘額即為緊急預備金；可在「資產」查看能支應幾個月。"
          }
        }
      }
    },
