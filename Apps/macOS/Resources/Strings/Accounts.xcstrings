          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ce que la banque a versé : la somme ici est une estimation."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք բանկի վճարած գումարը․ այստեղ նշվածը մոտավոր է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci l’importo pagato dalla banca: quello indicato è una stima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行から支払われた金額を入力してください。ここに表示される金額は概算です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ ბანკის მიერ ჩარიცხული თანხა: აქ ნაჩვენები თანხა სავარაუდოა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк төлегенін теріңіз: мұнда көрсетілген сома — болжам."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행에서 지급한 금액을 입력하세요. 여기에 표시된 금액은 예상치입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк төлөгөн сумманы киргизиңиз: бул жердеги сумма болжолдуу."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul in wat de bank heeft uitbetaald: het bedrag hier is een schatting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kwotę wypłaconą przez bank. Podana tutaj kwota jest szacunkowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o valor pago pelo banco: o valor exibido é uma estimativa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique o que o banco pagou: o montante apresentado é uma estimativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите, сколько заплатил банк: здесь сумма — оценка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи пардохткардаи бонкро ворид кунед: маблағи ин ҷо тахминӣ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankanın ödediği tutarı girin; buradaki tutar tahminidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть, скільки виплатив банк: сума тут є оцінкою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank to‘lagan summani kiriting: bu yerdagi summa taxminiy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入银行实际支付的金额，此处金额为估算值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入銀行實際支付的金額；此處顯示的是預估值。"
          }
        }
      }
    },
