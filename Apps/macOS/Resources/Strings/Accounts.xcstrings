    "account.editor.accentHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dot of it stands by the account in the lists and a stripe on its card. The name is always written next to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto de ese color acompaña a la cuenta en las listas y una franja en su tarjeta. El nombre siempre se escribe junto a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point de cette couleur accompagne le compte dans les listes et une bande orne sa carte. Le nom est toujours écrit à côté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точка этого цвета стоит у счёта в списках, полоска — у его карточки. Рядом всегда написано название счёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його крапка стоїть біля рахунку в списках, а смужка — на його картці. Назва завжди пишеться поруч."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto colorato appare accanto al conto negli elenchi e una striscia sulla sua scheda. Il nome è sempre indicato accanto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның нүктесі тізімдерде есеп-шот жанында, ал картасында жолақ болып тұрады. Атауы әрқашан соның жанында жазылады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Каляровая кропка побач з рахункам у спісах і паласа на яго картцы. Назва заўсёды напісана побач."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Punkt in dieser Farbe steht in den Listen neben dem Konto, ein Streifen auf seiner Karte. Der Name steht immer daneben."
          }
        }
      }
    },
