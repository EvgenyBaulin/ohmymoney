          "stringUnit": {
            "state": "translated",
            "value": "Das Festgeld endet, bevor es beginnt."
          }
        }
      }
    },
    "account.interest.refusal.endNeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest paid at the end of the term needs the day the deposit closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses pagados al final del plazo necesitan el día en que se cierra el depósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des intérêts versés à l'échéance demandent la date de clôture du dépôt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выплаты в конце срока укажите, когда вклад закрывается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки, що виплачуються наприкінці строку, потребують дня закриття депозиту."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per gli interessi pagati a scadenza serve la data di chiusura del deposito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзім аяқталғанда төленетін пайызға салым жабылатын күн керек."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выплаты працэнтаў у канцы тэрміну патрэбны дзень закрыцця ўкладу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen, die am Ende der Laufzeit gezahlt werden, brauchen den Tag, an dem das Festgeld endet."
          }
        }
      }
    },
    "account.interest.refusal.payoutAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest can go only to another account that is not in the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses solo pueden ir a otra cuenta que no esté archivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts ne peuvent aller que vers un autre compte qui n'est pas dans les archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты можно перечислять только на другой счёт не из архива."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки можна направити лише на інший рахунок, який не в архіві."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli interessi possono essere versati solo su un altro conto non archiviato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз тек мұрағатта жоқ басқа есеп-шотқа ғана жазылады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнты могуць паступаць толькі на іншы рахунак па-за архівам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen können nur auf ein anderes Konto gehen, das nicht im Archiv liegt."
          }
        }
      }
    },
    "account.interest.refusal.rate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the rate in percent a year: above 0 and up to 100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba el tipo en porcentaje anual: mayor que 0 y de hasta 100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le taux en pourcentage par an : supérieur à 0 et jusqu'à 100."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите ставку в процентах годовых: больше 0 и не больше 100."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ставку у відсотках на рік: більше 0 і до 100."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tasso annuo in percentuale: maggiore di 0 e fino a 100."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөлшерлемені жылдық пайызбен теріңіз: 0-ден жоғары және 100-ге дейін."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце стаўку ў працэнтах гадавых: больш за 0 і да 100."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie den Zinssatz in Prozent pro Jahr ein: über 0 und bis 100."
          }
        }
      }
    },
