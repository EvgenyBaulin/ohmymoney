    "account.refusal.balanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın balansı məlum deyil: hesabda pul hərəkəti olub, amma balans heç vaxt yoxlanılmayıb. Balansı yoxlayın; sıfır olduqda hesabı arxivə göndərmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс рахунку невядомы: на ім быў рух грошай, але ён ніколі не звяраўся. Зверце яго; пры нулявым балансе можна архіваваць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek účtu není známý: na účtu proběhly pohyby, ale jeho zůstatek nebyl nikdy upraven. Upravte zůstatek; při nulovém zůstatku lze účet archivovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo des Kontos ist niemandem bekannt: Auf dem Konto wurde Geld bewegt, es wurde aber nie abgeglichen. Gleichen Sie es ab; bei null kann es ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance of the account: money moved on it, but it was never reconciled. Reconcile it; at zero it can go to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie conoce el saldo de la cuenta: se movió dinero en ella, pero nunca se conció. Concíliela; con saldo cero puede pasar al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne connaît le solde du compte : de l'argent y a bougé, mais il n'a jamais été rapproché. Rapprochez-le ; à zéro, il peut aller aux archives."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվի մնացորդն անհայտ է․ հաշվով շարժ է եղել, բայց այն երբեք չի ճշգրտվել։ Ճշգրտեք մնացորդը․ զրոյական լինելու դեպքում հաշիվը կարելի է արխիվացնել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo del conto è sconosciuto: ci sono stati movimenti, ma non è mai stato riconciliato. Riconcilialo; se il saldo è zero, puoi archiviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座では入出金がありましたが、残高が照合されていないため不明です。残高を照合してください。ゼロになればアーカイブできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშის ნაშთი უცნობია: თანხა მოძრაობდა, მაგრამ ნაშთი არასოდეს შეჯერებულა. შეაჯერეთ ანგარიში; ნულოვანი ნაშთისას მისი დაარქივება შესაძლებელი იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттың теңгерімі ешкімге белгісіз: онда ақша қозғалды, бірақ ешқашан салыстырылмаған. Салыстырыңыз; нөлде ол мұрағатқа өтуі мүмкін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌에 거래가 있었지만 잔액을 맞춘 적이 없어 잔액을 알 수 없습니다. 잔액을 맞춘 후 0이 되면 보관함에 이동할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсепте акча кыймылы болгон, бирок калдык эч качан такталган эмес. Калдыгын тактаңыз; нөл болсо, эсепти архивге жылдырса болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo van de rekening is onbekend: er zijn transacties geweest, maar het saldo is nooit gecontroleerd. Controleer het saldo; bij nul kan de rekening naar het archief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo konta jest nieznane: były na nim operacje, ale nigdy nie uzgodniono salda. Uzgodnij saldo. Gdy wyniesie zero, konto będzie można przenieść do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo da conta é desconhecido: houve movimentações, mas ela nunca foi conciliada. Concilie a conta; com saldo zero, ela pode ser arquivada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo da conta é desconhecido: houve movimentos, mas nunca foi reconciliada. Reconcilie-a; com saldo zero, pode arquivá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток счёта неизвестен: по нему были движения, но его ни разу не сверяли. Сверьте счёт — с нулём его можно убрать в архив."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи суратҳисоб номаълум аст: дар он гардиши пул буд, аммо бақияаш ҳеҷ гоҳ муқоиса нашудааст. Бақияро муқоиса кунед; агар сифр бошад, онро ба бойгонӣ бурдан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın bakiyesi bilinmiyor: hesapta para hareketi var ancak hiç mutabakat yapılmamış. Mutabakat yapın; bakiye sıfırken hesap arşive kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок рахунку ніхто не знає: кошти на ньому рухалися, але його ніколи не звіряли. Звірте його; з нульовим залишком він може піти в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob qoldig‘i noma’lum: unda pul harakati bo‘lgan, lekin qoldiq hech qachon solishtirilmagan. Qoldiqni solishtiring; u nol bo‘lsa, hisobni arxivga o‘tkazish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户余额未知：此账户有资金变动，但从未核对余额。请先核对余额；余额为零时可归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶餘額未知：此帳戶有資金往來，但從未對帳。請先對帳，餘額為零時即可封存。"
          }
        }
      }
    },
    "account.refusal.bankHasLiveAccounts": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankın hələ arxivdə olmayan hesabları var: əvvəlcə onları arxivə göndərin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка яшчэ ёсць рахункі па-за архівам: спачатку архівуйце іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka má stále účty mimo archiv. Nejprve je archivujte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat noch Konten außerhalb des Archivs: Verschieben Sie diese zuerst ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank still has accounts outside the archive: move them to the archive first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco aún tiene cuentas fuera del archivo: pásalas antes al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque a encore des comptes hors des archives : mettez-les d'abord aux archives."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկն ունի արխիվից դուրս հաշիվներ․ նախ արխիվացրեք դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca ha ancora conti non archiviati: archiviali prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この銀行にはアーカイブされていない口座があります。先に口座をアーカイブしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკს ჯერ კიდევ აქვს არაარქივირებული ანგარიშები: ჯერ ისინი დაარქივეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкте әлі мұрағатта жоқ есеп-шоттар бар: алдымен оларды мұрағатқа өткізіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 은행에 보관되지 않은 계좌가 있습니다. 먼저 계좌를 보관함에 이동하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын архивден тышкары эсептери бар. Адегенде аларды архивге жылдырыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bank heeft nog rekeningen buiten het archief: verplaats die eerst naar het archief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank nadal ma konta poza archiwum. Najpierw przenieś je do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco ainda tem contas ativas. Arquive-as primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco ainda tem contas fora do arquivo: arquive-as primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка есть счета не в архиве — сначала уберите в архив их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк то ҳол суратҳисобҳои берун аз бойгонӣ дорад: аввал онҳоро ба бойгонӣ баред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankanın arşiv dışında hesapları var. Önce bunları arşive kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У банку ще є рахунки поза архівом: спершу перенесіть їх в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankda hali arxivga o‘tkazilmagan hisoblar bor: avval ularni arxivga o‘tkazing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此银行仍有未归档的账户，请先将这些账户归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此銀行仍有未封存的帳戶，請先將這些帳戶封存。"
          }
        }
      }
    },
    "account.refusal.bankInUse": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka arxivdəkilər də daxil olmaqla hesablar bağlıdır: bankı arxivə göndərmək olar, silmək olmaz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да банка адносяцца рахункі, у тым ліку архіўныя: яго можна архіваваць, але не выдаліць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K bance patří účty, včetně archivovaných. Banku lze archivovat, ale ne smazat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Bank stehen Konten, auch archivierte: Sie kann ins Archiv, nicht gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, archived ones too, are under the bank: it can go to the archive, not be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cuentas, también archivadas, bajo el banco: puede pasar al archivo, pero no eliminarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des comptes, même archivés, sont rattachés à la banque : elle peut aller aux archives, mais non être supprimée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկին կցված են հաշիվներ, այդ թվում՝ արխիվացված։ Այն կարելի է արխիվացնել, բայց ոչ ջնջել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca contiene conti, anche archiviati: puoi archiviarla, ma non eliminarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この銀行にはアーカイブ済みのものを含め口座があるため、削除できません。アーカイブはできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკს ანგარიშები, მათ შორის არქივირებულიც, ეკუთვნის: მისი დაარქივება შესაძლებელია, წაშლა კი — არა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк астында есеп-шоттар бар, мұрағаттағылар да: ол мұрағатқа өтуі мүмкін, бірақ жойылмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 계좌를 포함하여 이 은행에 속한 계좌가 있습니다. 삭제할 수는 없지만 보관함에 이동할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкка эсептер, анын ичинде архивдегилери да таандык. Аны архивге жылдырса болот, бирок өчүрүүгө болбойт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staan rekeningen onder deze bank, ook in het archief: de bank kan naar het archief, maar kan niet worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do banku są przypisane konta, również te w archiwum. Można go przenieść do archiwum, ale nie można go usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há contas vinculadas ao banco, inclusive arquivadas. Ele pode ser arquivado, mas não apagado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há contas associadas ao banco, incluindo arquivadas: pode arquivá-lo, mas não apagá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под банком есть счета, в том числе архивные: его можно убрать в архив, но не удалить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисобҳо, аз ҷумла суратҳисобҳои бойгонӣ, ба ин бонк тааллуқ доранд: онро ба бойгонӣ бурдан мумкин аст, аммо нест кардан не."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bankaya bağlı hesaplar var; arşivdekiler de dahil. Banka silinemez, ancak arşive kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під банком є рахунки, в тому числі архівні: він може піти в архів, але не видалитися."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankka hisoblar, jumladan arxivdagilari ham bog‘langan: bankni arxivga o‘tkazish mumkin, ammo o‘chirib bo‘lmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此银行下仍有账户（包括已归档账户），只能归档，无法删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此銀行下仍有帳戶，包括已封存的帳戶；只能封存，無法刪除。"
          }
        }
      }
    },
    "account.refusal.bankNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adlı bank artıq mövcuddur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк з такой назвай ужо ёсць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka s tímto názvem už existuje."
          }
        },
        "de": {
          "stringUnit": {
