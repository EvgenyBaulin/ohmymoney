    "account.merge.emptyKeepsCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty — «%@» keeps its latest count; the other account's past becomes history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía: «%@» conserva su último recuento; el pasado de la otra cuenta pasa al historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide — « %@ » garde son dernier relevé ; le passé de l'autre compte devient l'historique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусто — «%@» останется со своей последней сверкой, прошлое второго счёта станет историей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожній — «%@» зберігає свою останню звірку, минуле іншого рахунку стає історією."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoto: «%@» mantiene l’ultima riconciliazione; il passato dell’altro conto rimane nello storico."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бос — «%@» соңғы санауын сақтайды; басқа есеп-шоттың өткені тарихқа айналады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуста — «%@» захавае апошні падлік; мінулае іншага рахунку стане гісторыяй."
