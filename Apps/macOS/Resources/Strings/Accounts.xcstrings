    "sidebar.totalHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на рахунках у зводцы, у рублях па сённяшніх курсах."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld auf den Konten in der Übersicht, in Rubel zu den heutigen Kursen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money on the accounts in the summary, in rubles at today's rates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de las cuentas del resumen, en rublos a los tipos de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent des comptes du récapitulatif, en roubles au cours du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo dei conti inclusi nel riepilogo, in rubli ai tassi di oggi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы есеп-шоттардағы ақша, бүгінгі бағам бойынша рубльмен."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалпы эсепке кирген эсептердеги акча, бүгүнкү курс боюнча рубль менен."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środki na kontach uwzględnionych w podsumowaniu, w rublach według dzisiejszych kursów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro das contas incluídas no resumo, em rublos, pelas cotações de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги на счетах в сводке, в рублях по сегодняшнему курсу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özete dahil hesapların bugünkü kurlarla ruble cinsinden toplamı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші на рахунках, що входять до підсумку, у рублях за сьогоднішнім курсом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumiy hisobga kiritilgan hisoblardagi mablag‘, bugungi kurs bo‘yicha rublda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要中各帳戶的資金，按今日匯率換算為盧布。"
          }
        }
      }
    },
    "sidebar.totalNotCounted": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверце рахункі адзін раз, і тут з'явіцца іх агульная сума."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichen Sie die Konten einmal ab, dann erscheint hier ihre Summe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile the accounts once, and their total appears here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie las cuentas una vez y aquí aparecerá su total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez les comptes une fois, et leur total apparaît ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconcilia i conti per visualizzare qui il totale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттарды бір рет салыстырыңыз — сонда олардың жиыны осында көрінеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептерди бир жолу тактаңыз, алардын жалпы суммасы бул жерде көрүнөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź saldo kont, aby zobaczyć tutaj ich sumę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie as contas uma vez para que o total apareça aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверьте счета один раз — и здесь появится их сумма."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplarla mutabakat yapıldığında toplamları burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звірте рахунки один раз, і тут з'явиться їхній підсумок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblar qoldig‘ini bir marta tekshiring, shunda jami summa shu yerda ko‘rinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對帳後，帳戶總額便會顯示於此。"
          }
        }
      }
    },
