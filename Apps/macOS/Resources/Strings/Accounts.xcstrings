            "value": "Оның астына ешбір есеп-шот тізімделмеген. ⌘Z қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹에 속한 계좌가 없습니다. ⌘Z로 복원할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул топто эсептер жок. ⌘Z аны калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen rekeningen in deze groep. Met ⌘Z zet je deze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma w niej żadnych kont. ⌘Z przywróci ją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há contas neste grupo. ⌘Z o restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há contas neste grupo. Prima ⌘Z para o recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К ней не отнесён ни один счёт. ⌘Z вернёт её."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар он ҳисобе нест. ⌘Z онро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu grupta hesap yok. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У ньому немає жодного рахунку. ⌘Z поверне її."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu guruhda hisob yo‘q. ⌘Z uni qaytaradi."
          }
        },
