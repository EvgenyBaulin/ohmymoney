    "bank.card.expiresHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A month before it ends, Overview reminds you and lists what is paid with the card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mes antes de que venza, Resumen se lo recuerda y enumera lo que se paga con la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mois avant l'échéance, l'Aperçu vous le rappelle et liste ce qui est payé avec la carte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За месяц до конца срока «Стоит посмотреть» напомнит и покажет, что платится с этой карты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За місяць до закінчення «Огляд» нагадає про це й покаже, що сплачується карткою."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mese prima della scadenza, Panoramica ti avvisa e mostra i pagamenti effettuati con la carta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аяқталғанға бір ай қалғанда «Шолу» еске салады және картамен төленетіндерді тізеді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За месяц да заканчэння Агляд нагадае і пакажа, што аплачваецца картай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Monat vor dem Ablauf erinnert Sie die Übersicht und listet auf, was mit der Karte bezahlt wird."
          }
        }
      }
    },
