    "accounts.delete.messageMoney": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo %@ verschwindet mit ihm aus allen Summen. Nichts verweist auf das Konto. ⌘Z holt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance %@ leaves every total with it. Nothing refers to the account. ⌘Z brings it back."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімі оның бірге барлық жиынтықтан шығады. Есеп-шотқа ештеңе сілтемейді. ⌘Z қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток %@ пропадёт из итогов. На счёт ничто не ссылается. ⌘Z вернёт его."
          }
        }
      }
    },
