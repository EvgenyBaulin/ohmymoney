    "account.refusal.noSuccessor": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма іншага рахунку ў зводцы, які можа стаць асноўным. Спачатку дадайце рахунак або ўключыце яго ў зводку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein anderes Konto in der Übersicht kann Hauptkonto werden. Legen Sie zuerst ein Konto an oder nehmen Sie eines in die Übersicht auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other account in the summary can become main. Add an account or bring one into the summary first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna otra cuenta del resumen puede ser la principal. Antes añada una cuenta o incluya una en el resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun autre compte du récapitulatif ne peut devenir principal. Ajoutez d'abord un compte ou intégrez-en un au récapitulatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro conto nel riepilogo può diventare principale. Prima aggiungi un conto o includine uno nel riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы басқа есеп-шот негізгі бола алмайды. Алдымен есеп-шот қосыңыз немесе қорытындыға бірін енгізіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жыйынтыктагы башка эсептердин бири да негизги боло албайт. Адегенде эсеп кошуңуз же бирин жыйынтыкка киргизиңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne inne konto w podsumowaniu nie może zostać kontem głównym. Najpierw dodaj konto lub uwzględnij je w podsumowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma outra conta no resumo pode ser a principal. Adicione uma conta ou inclua uma no resumo primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основным стать некому: нужен другой счёт в общей сводке. Сначала добавьте счёт или включите его группу в сводку."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ягон суратҳисоби дигари ҷамъбаст асосӣ шуда наметавонад. Аввал суратҳисоб илова кунед ё якеро ба ҷамъбаст дохил кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özette ana hesap olabilecek başka bir hesap yok. Önce bir hesap ekleyin veya bir hesabı özete dahil edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніякий інший рахунок у підсумку не може стати основним. Спершу додайте рахунок або включіть один до підсумку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumiy ko‘rinishdagi boshqa hech bir hisob asosiy bo‘la olmaydi. Avval hisob qo‘shing yoki biror hisobni umumiy ko‘rinishga kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要中沒有其他帳戶可設為主要帳戶。請先新增帳戶或將帳戶納入摘要。"
          }
        }
      }
    },
    "account.refusal.notFound": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтага запісу больш няма — магчыма, ён выдалены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht mehr vorhanden — vielleicht wurde es gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not there any more — it may have been deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no está: quizá se eliminó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est plus là — il a peut-être été supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è più disponibile: potrebbe essere stato eliminato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол енді жоқ — жойылған болуы мүмкін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул эми жок — өчүрүлгөн болушу мүмкүн."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma już tej pozycji — mogła zostać usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item não está mais aqui. Ele pode ter sido apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого больше нет — возможно, уже удалено."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Он дигар вуҷуд надорад — шояд нест шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık burada değil; silinmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його вже немає — можливо, його видалили."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "U endi mavjud emas — o‘chirilgan bo‘lishi mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目已不存在，可能已被刪除。"
          }
        }
      }
    },
    "account.refusal.otherBank": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аб'ядноўваюцца толькі рахункі аднаго банка. Каб злучыць два банкі, спачатку аб'яднайце іх у Наладах → Рахункі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammengeführt werden nur Konten einer Bank. Um zwei Banken zusammenzuführen, führen Sie zuerst die Banken in den Einstellungen unter „Konten“ zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only accounts of one bank are merged. To bring two banks together, merge the banks first in Settings → Accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se fusionan cuentas de un mismo banco. Para unir dos bancos, fusiónelos antes en Ajustes → Cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne fusionne que les comptes d'une même banque. Pour réunir deux banques, fusionnez d'abord les banques dans Réglages → Comptes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi unire solo conti della stessa banca. Per unire due banche, uniscile prima in Impostazioni → Conti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек бір банктің есеп-шоттары біріктіріледі. Екі банкті біріктіру үшін алдымен «Параметрлер → Есеп-шоттар» бөлімінде банктерді біріктіріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир банктын эсептерин гана бириктирсе болот. Эки банкты бириктирүү үчүн адегенде Жөндөөлөр → Эсептер бөлүмүндө банктарды бириктириңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można połączyć tylko konta tego samego banku. Aby połączyć dwa banki, najpierw połącz je w Ustawienia → Konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível unir contas do mesmo banco. Para unir dois bancos, una-os primeiro em Ajustes → Contas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяются только счета одного банка. Чтобы свести два банка вместе, сначала объедините банки в «Настройки → Счета»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо суратҳисобҳои як бонк якҷоя мешаванд. Барои муттаҳид кардани ду бонк, аввал онҳоро дар Танзимот → Суратҳисобҳо якҷоя кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca aynı bankanın hesapları birleştirilebilir. İki bankayı bir araya getirmek için önce Ayarlar → Hesaplar bölümünde bankaları birleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зливаються лише рахунки одного банку. Щоб об'єднати два банки, спершу злийте їх у «Налаштування → Рахунки»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat bir bank hisoblarini birlashtirish mumkin. Ikki bankni birlashtirish uchun avval Sozlamalar → Hisoblar bo‘limida banklarni birlashtiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能合併同一銀行的帳戶。若要合併不同銀行的帳戶，請先在「設定」→「帳戶」中合併銀行。"
          }
        }
      }
    },
    "account.refusal.otherNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ужо з'яўляецца назвай іншага рахунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits ein Name eines anderen Kontos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» is already a name of another account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya es otro nombre de una cuenta distinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà un nom d'un autre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è già un nome di un altro conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» басқа есеп-шоттың атауы болып тұр."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — башка эсептин аталышы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» jest już nazwą innego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» já é um nome de outra conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — уже название другого счёта."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» аллакай номи суратҳисоби дигар аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» zaten başka bir hesabın adı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже є назвою іншого рахунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» allaqachon boshqa hisobning nomi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» 已是另一個帳戶的名稱。"
          }
        }
      }
    },
    "account.refusal.removesCurrencyWithMoney": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На гэтым рахунку ёсць грошы ў %@: валюта застанецца, пакуль яе баланс не стане нулявым."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Konto liegt Geld in %@: Die Währung bleibt, bis ihr Saldo null ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is money in %@ on this account: the currency stays until its balance is zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta cuenta hay dinero en %@: la divisa se queda hasta que su saldo sea cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a de l'argent en %@ sur ce compte : la devise reste jusqu'à ce que son solde soit nul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo conto contiene denaro in %@: la valuta rimane finché il saldo non è zero."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шотта %@ валютасында ақша бар: теңгерім нөлге тең болғанша валюта қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул эсепте %@ бар: калдык нөлгө жетмейинче валюта калат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym koncie są środki w walucie %@. Waluta pozostanie na koncie, dopóki jej saldo nie wyniesie zero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta tem dinheiro em %@. A moeda permanecerá até que seu saldo seja zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги в %@: валюта останется, пока её остаток не станет нулём."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин суратҳисоб бо %@ пул ҳаст: асъор то сифр шудани бақияаш мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesapta %@ cinsinden para var. Bakiye sıfırlanana kadar para birimi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому рахунку є гроші в %@: валюта залишиться, доки її залишок не стане нульовим."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hisobda %@ valyutasida pul bor: qoldiq nol bo‘lguncha valyuta qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶仍有 %@ 餘額，餘額歸零前無法移除此貨幣。"
          }
        }
      }
    },
