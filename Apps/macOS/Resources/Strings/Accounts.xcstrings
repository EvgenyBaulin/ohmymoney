        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек бір есеп-шоттың карталарын ғана біріктіруге болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 계좌의 카드만 병합할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир эсептин карталарын гана бириктирүүгө болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen kaarten van dezelfde rekening kunnen worden samengevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można łączyć tylko karty należące do jednego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente cartões da mesma conta podem ser combinados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível unir cartões da mesma conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединить можно только карты одного счёта."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо кортҳои як ҳисобро якҷоя кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca aynı hesaba ait kartlar birleştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зливати можна лише картки одного рахунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat bir hisobga tegishli kartalarni birlashtirish mumkin."
