    "card.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations of “%1$@” (in the bin too) and its scheduled payments move to “%2$@”, and its name and other names become other names of “%2$@”. The card “%1$@” is deleted. No money moves: both cards are of one account, so balances and reconciliations stay as they are. ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de «%1$@» (también las de la papelera) y sus pagos programados pasan a «%2$@», y su nombre y sus otros nombres pasan a ser otros nombres de «%2$@». La tarjeta «%1$@» se elimina. No se mueve dinero: ambas tarjetas son de una misma cuenta, así que los saldos y las conciliaciones quedan como están. ⌘Z lo devuelve todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции карты «%1$@» (и в корзине) и её платежи перейдут на «%2$@», а её название и другие названия станут другими названиями «%2$@». Карта «%1$@» удалится. Деньги не двигаются: обе карты одного счёта, остатки и сверки не меняются. ⌘Z вернёт всё."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції «%1$@» (у тому числі в кошику) і його заплановані платежі переходять на «%2$@», а його назва та інші назви стають іншими назвами «%2$@». Картка «%1$@» видаляється. Гроші не рухаються: обидві картки належать одному рахунку, тож залишки й звірки лишаються як є. ⌘Z поверне все."
          }
        }
      }
    },
    "card.merge.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations of “%1$@” (in the bin too) and its scheduled payments move to “%2$@”, and its name and other names become other names of “%2$@”. The card “%1$@” is deleted. No money moves: both cards are of one account, so balances and reconciliations stay as they are. “Undo” brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de «%1$@» (también las de la papelera) y sus pagos programados pasan a «%2$@», y su nombre y sus otros nombres pasan a ser otros nombres de «%2$@». La tarjeta «%1$@» se elimina. No se mueve dinero: ambas tarjetas son de una misma cuenta, así que los saldos y las conciliaciones quedan como están. «Deshacer» lo devuelve todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции карты «%1$@» (и в корзине) и её платежи перейдут на «%2$@», а её название и другие названия станут другими названиями «%2$@». Карта «%1$@» удалится. Деньги не двигаются: обе карты одного счёта, остатки и сверки не меняются. «Отменить» вернёт всё."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції «%1$@» (у тому числі в кошику) і його заплановані платежі переходять на «%2$@», а його назва та інші назви стають іншими назвами «%2$@». Картка «%1$@» видаляється. Гроші не рухаються: обидві картки належать одному рахунку, тож залишки й звірки лишаються як є. «Скасувати» поверне все."
          }
        }
      }
    },
    "card.merge.moves": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving to the kept card: operations — %1$lld, scheduled payments — %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa a la tarjeta que se conserva: operaciones — %1$lld, pagos programados — %2$lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдут на оставшуюся карту: операций — %1$lld, плановых платежей — %2$lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На картку, що лишається: операцій — %1$lld, запланованих платежів — %2$lld"
          }
        }
      }
    },
