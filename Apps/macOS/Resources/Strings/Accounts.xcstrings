    "archived.leftover.noCounterpart": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На іншых рахунках няма %1$@. Дадайце валюту на рахунак або аднавіце «%2$@» з архіва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein anderes Konto hält %1$@. Fügen Sie die Währung einem Konto hinzu oder holen Sie „%2$@“ aus dem Archiv zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other account holds %1$@. Add the currency to an account or bring «%2$@» back from the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna otra cuenta tiene %1$@. Añada la divisa a una cuenta o recupere «%2$@» del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun autre compte ne détient %1$@. Ajoutez la devise à un compte ou ramenez « %2$@ » depuis les archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro conto dispone di %1$@. Aggiungi la valuta a un conto o ripristina «%2$@» dall’archivio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа ешбір есеп-шотта %1$@ жоқ. Валютаны бір есеп-шотқа қосыңыз немесе «%2$@» мұрағаттан қайтарыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Башка эсептерде %1$@ жок. Эсепке валютаны кошуңуз же «%2$@» архивден чыгарыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne inne konto nie ma waluty %1$@. Dodaj ją do konta lub przywróć «%2$@» z archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma outra conta tem %1$@. Adicione a moeda a uma conta ou restaure «%2$@» do arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет другого счёта в %1$@. Добавьте эту валюту счёту или верните «%2$@» из архива."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka hiçbir hesapta %1$@ yok. Bir hesaba para birimini ekleyin veya «%2$@» hesabını arşivden çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден інший рахунок не має %1$@. Додайте валюту до якогось рахунку або поверніть «%2$@» з архіву."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa hisoblarda %1$@ yo‘q. Valyutani biror hisobga qo‘shing yoki «%2$@»ni arxivdan qaytaring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他帳戶都沒有 %1$@。請將此貨幣加入帳戶，或還原已封存的「%2$@」。"
          }
        }
      }
    },
