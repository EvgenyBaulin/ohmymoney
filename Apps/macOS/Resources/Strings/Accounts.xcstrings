    "account.interest.refusal.endBeforeOpening": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уклад закрываецца раней, чым адкрываецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Festgeld endet, bevor es beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deposit closes before it opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El depósito se cierra antes de abrirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt est clôturé avant d'être ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il deposito si chiude prima dell’apertura."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салым ашылғанға дейін жабылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аманат ачыла электе жабылат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokata kończy się przed jej otwarciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O depósito termina antes de começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклад закрывается раньше, чем открыт."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасандоз пеш аз кушода шуданаш баста мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevduat, açılmadan önce kapanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Депозит закривається раніше, ніж відкривається."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Omonat ochilishidan oldin yopiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存款結束日期早於開立日期。"
          }
        }
      }
    },
    "account.interest.refusal.endNeeded": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выплаты працэнтаў у канцы тэрміну патрэбны дзень закрыцця ўкладу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen, die am Ende der Laufzeit gezahlt werden, brauchen den Tag, an dem das Festgeld endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest paid at the end of the term needs the day the deposit closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses pagados al final del plazo necesitan el día en que se cierra el depósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des intérêts versés à l'échéance demandent la date de clôture du dépôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per gli interessi pagati a scadenza serve la data di chiusura del deposito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзім аяқталғанда төленетін пайызға салым жабылатын күн керек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөөнөт аягында пайыз төлөө үчүн аманат жабыла турган күн керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wypłacić odsetki na koniec okresu, podaj datę zakończenia lokaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para juros pagos no vencimento, informe a data de vencimento do depósito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выплаты в конце срока укажите, когда вклад закрывается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои пардохти фоиз дар охири муҳлат санаи бастани пасандоз лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vade sonunda ödenen faiz için mevduatın kapanış tarihi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки, що виплачуються наприкінці строку, потребують дня закриття депозиту."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Muddat oxirida to‘lanadigan foiz uchun omonat yopiladigan sanani kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到期支付利息需要設定存款結束日期。"
          }
        }
      }
    },
    "account.interest.refusal.payoutAccount": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнты могуць паступаць толькі на іншы рахунак па-за архівам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen können nur auf ein anderes Konto gehen, das nicht im Archiv liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest can go only to another account that is not in the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses solo pueden ir a otra cuenta que no esté archivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts ne peuvent aller que vers un autre compte qui n'est pas dans les archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli interessi possono essere versati solo su un altro conto non archiviato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз тек мұрағатта жоқ басқа есеп-шотқа ғана жазылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайызды архивде эмес башка эсепке гана которсо болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsetki można przelać tylko na inne konto, które nie jest w archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros só podem ser enviados para outra conta que não esteja arquivada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты можно перечислять только на другой счёт не из архива."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоизро танҳо ба суратҳисоби дигаре, ки дар бойгонӣ нест, гузаронидан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz yalnızca arşivde olmayan başka bir hesaba aktarılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки можна направити лише на інший рахунок, який не в архіві."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Foizni faqat arxivda bo‘lmagan boshqa hisobga o‘tkazish mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "利息只能存入其他未封存的帳戶。"
          }
        }
      }
    },
    "account.interest.refusal.rate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце стаўку ў працэнтах гадавых: больш за 0 і да 100."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie den Zinssatz in Prozent pro Jahr ein: über 0 und bis 100."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the rate in percent a year: above 0 and up to 100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba el tipo en porcentaje anual: mayor que 0 y de hasta 100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le taux en pourcentage par an : supérieur à 0 et jusqu'à 100."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tasso annuo in percentuale: maggiore di 0 e fino a 100."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөлшерлемені жылдық пайызбен теріңіз: 0-ден жоғары және 100-ге дейін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылдык ченди пайыз менен киргизиңиз: 0дөн жогору, 100гө чейин."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj oprocentowanie w procentach rocznie: powyżej 0 i maksymalnie 100."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a taxa em porcentagem ao ano: acima de 0 e até 100."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите ставку в процентах годовых: больше 0 и не больше 100."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Меъёри фоизи солонаро аз 0 зиёд ва то 100 ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık faiz oranını yüzde olarak girin: 0'dan büyük ve en fazla 100."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ставку у відсотках на рік: більше 0 і до 100."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yillik foiz stavkasini kiriting: 0 dan katta va 100 gacha."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入年利率百分比，須大於 0 且不超過 100。"
          }
        }
      }
    },
