    "account.interest.notCounted": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı hesablamaya daxil edin — balans olmadan faiz hesablamaq mümkün deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падлічыце рахунак — без балансу нельга разлічыць працэнты"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Započítávejte účet — bez zůstatku nelze úrok vypočítat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählen Sie das Konto mit — ohne Saldo gibt es keine Zinsen zu berechnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count the account — without a balance there is no interest to work out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuente la cuenta: sin saldo no hay intereses que calcular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez le compte — sans solde, il n'y a pas d'intérêts à calculer"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ներառեք հաշիվը․ առանց մնացորդի տոկոսները հնարավոր չէ հաշվարկել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi il conto: senza saldo non è possibile calcolare gli interessi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座を集計対象にしてください。残高がないと利息を計算できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართეთ ანგარიში აღრიცხვაში — ნაშთის გარეშე პროცენტი ვერ გამოითვლება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотты есептеңіз — теңгерімсіз пайызды есептеу мүмкін емес"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌를 집계에 포함하세요. 잔액이 없으면 이자를 계산할 수 없습니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсепти эсепке кошуңуз — калдыксыз пайызды эсептөө мүмкүн эмес"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel de rekening mee — zonder saldo kan de rente niet worden berekend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwzględnij konto — bez salda nie można obliczyć odsetek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua a conta — sem saldo, não é possível calcular os rendimentos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua a conta — sem saldo não é possível calcular os juros"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверьте счёт — без остатка проценты не посчитать"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобро ба ҳисоб гиред — бе бақия фоиз ҳисоб намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı dahil edin — bakiye olmadan faiz hesaplanamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порахуйте рахунок — без залишку відсотків не розрахувати"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobni hisobga oling — qoldiqsiz foizlarni hisoblab bo‘lmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请计入此账户；没有余额就无法计算利息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將帳戶計入總覽；沒有餘額就無法計算利息"
          }
        }
      }
    },
    "account.interest.offHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əmanət və ya yığım hesabı üçün: hesab ekranında gözlənilən faiz göstərilir və ödəniş daxil olmadıqda soruşulur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ўкладу ці ашчаднага рахунку: на экране з'явяцца чаканыя працэнты і пытанне, калі выплата не паступіць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro termínovaný vklad nebo spořicí účet. Na stránce účtu se zobrazí očekávaný úrok a upozornění na chybějící výplatu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein Festgeld oder Sparkonto: Der Bildschirm des Kontos zeigt dann die erwarteten Zinsen und fragt nach, wenn eine Auszahlung ausbleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a deposit or a savings account: the account screen then shows the interest expected and asks when a payout does not come."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un depósito o una cuenta de ahorro: la pantalla de la cuenta mostrará entonces los intereses previstos y preguntará cuando un abono no llegue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un dépôt ou un compte d'épargne : l'écran du compte affiche alors les intérêts attendus et demande quand un versement n'arrive pas."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավանդի կամ խնայողական հաշվի համար․ հաշվի էկրանին կցուցադրվեն սպասվող տոկոսները, և հավելվածը կհարցնի, եթե վճարումը չստացվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un deposito o un conto di risparmio: la schermata del conto mostra gli interessi previsti e segnala gli accrediti mancati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期預金または貯蓄口座に設定すると、口座画面に利息の予定額が表示され、支払日に入金を確認できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანაბრისთვის ან შემნახველი ანგარიშისთვის: ანგარიშის ეკრანზე გამოჩნდება მოსალოდნელი პროცენტი და შეტყობინება, თუ ჩარიცხვა არ შესრულდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салым немесе жинақ шоты үшін: есеп-шот экраны күтілетін пайызды көрсетеді және төлем келмесе, сұрайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예금 또는 저축 계좌에 사용합니다. 계좌 화면에 예상 이자가 표시되고 지급되지 않은 이자를 확인할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Депозит же жыйнак эсеби үчүн: эсеп экранында күтүлгөн пайыз көрсөтүлүп, төлөм түшпөсө суралат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een deposito of spaarrekening. Het rekeningoverzicht toont dan de verwachte rente en vraagt ernaar als een uitbetaling uitblijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla lokaty lub konta oszczędnościowego: ekran konta pokaże wtedy oczekiwane odsetki i zapyta, jeśli wypłata nie nadejdzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para depósitos ou contas poupança: a tela da conta mostra o rendimento previsto e pergunta quando um pagamento não chega."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um depósito a prazo ou uma conta poupança: o ecrã da conta mostra os juros esperados e pergunta se um pagamento não foi recebido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вклада или накопительного счёта: экран счёта покажет ожидаемые проценты и спросит, если выплата не пришла."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои пасандоз ё ҳисоби пасандозӣ: саҳифаи ҳисоб фоизи интизориро нишон медиҳад ва агар пардохт наояд, мепурсад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevduat veya birikim hesabı için: hesap ekranı beklenen faizi gösterir ve ödeme gelmediğinde sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для депозиту або накопичувального рахунку: екран рахунку тоді покаже очікувані відсотки й запитає, коли виплата не надійшла."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Omonat yoki jamg‘arma hisobi uchun: hisob ekranida kutilayotgan foizlar ko‘rsatiladi va to‘lov tushmasa, so‘raladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于定期存款或储蓄账户：账户页面会显示预计利息，并在利息未到账时提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於定存或儲蓄帳戶。開啟後，帳戶畫面會顯示預期利息，並在利息未入帳時提醒你。"
          }
        }
      }
    },
