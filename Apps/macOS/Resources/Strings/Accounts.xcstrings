    "sidebar.totalHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money on the accounts in the summary, in rubles at today's rates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de las cuentas del resumen, en rublos a los tipos de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent des comptes du récapitulatif, en roubles au cours du jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги на счетах в сводке, в рублях по сегодняшнему курсу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші на рахунках, що входять до підсумку, у рублях за сьогоднішнім курсом."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo dei conti inclusi nel riepilogo, in rubli ai tassi di oggi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы есеп-шоттардағы ақша, бүгінгі бағам бойынша рубльмен."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на рахунках у зводцы, у рублях па сённяшніх курсах."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld auf den Konten in der Übersicht, in Rubel zu den heutigen Kursen."
          }
        }
      }
    },
    "sidebar.totalNotCounted": {
      "extractionState": "manual",
      "localizations": {
