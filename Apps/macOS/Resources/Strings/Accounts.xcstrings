    "account.screen.paymentsNone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No scheduled payment is paid from this account. A payment shows on the account chosen in its form («Account»); one with no account shows on the main one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún pago programado se paga desde esta cuenta. Un pago aparece en la cuenta elegida en su formulario («Cuenta»); uno sin cuenta aparece en la principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun paiement planifié ne sort de ce compte. Un paiement apparaît sur le compte choisi dans son formulaire (« Compte ») ; sans compte, il apparaît sur le compte principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этого счёта не оплачивается ни один платёж. Платёж показывается на счёте, выбранном в его форме («Счёт»); платёж без счёта — на основном."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З цього рахунку не сплачується жоден заплановий платіж. Платіж показується на рахунку, обраному у його формі («Рахунок»); платіж без рахунку показується на основному."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun pagamento programmato viene addebitato su questo conto. Un pagamento appare sul conto scelto nel modulo («Conto»); se non è stato scelto un conto, appare su quello principale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шоттан жоспарланған төлем төленбейді. Төлем өз формасында таңдалған есеп-шотта («Есеп-шот») көрсетіледі; есеп-шотсыз төлем негізгісінде көрінеді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З гэтага рахунку няма планавых плацяжоў. Плацеж паказваецца на рахунку з яго формы («Рахунак»); без рахунку — на асноўным."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine geplante Zahlung wird von diesem Konto bezahlt. Eine Zahlung erscheint auf dem Konto, das in ihrem Formular gewählt ist („Konto“); ohne Konto erscheint sie auf dem Hauptkonto."
          }
        }
      }
    },
