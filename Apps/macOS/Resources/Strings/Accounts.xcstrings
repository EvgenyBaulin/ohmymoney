          "stringUnit": {
            "state": "translated",
            "value": "Les soldes %@ sortent de tous les totaux avec eux. Rien ne s'y réfère. « Annuler » les rétablit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки %@ пропадут из итогов. На счета ничто не ссылается. «Отменить» вернёт их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки %@ разом із ними зникають з усіх підсумків. Ніщо на рахунки не посилається. «Скасувати» поверне їх."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi %@ verranno rimossi da tutti i totali. Nessun elemento fa riferimento ai conti. Tocca “Annulla” per ripristinarli."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімдері олармен бірге барлық жиынтықтан шығады. Есеп-шоттарға ештеңе сілтемейді. «Болдырмау» оларды қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансы %@ знікнуць з усіх вынікаў разам з рахункамі. Нішто на рахункі не спасылаецца. “Адмяніць” адновіць іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Salden %@ verschwinden mit ihnen aus allen Summen. Nichts verweist auf die Konten. „Rückgängig“ holt sie zurück."
          }
        }
      }
    },
