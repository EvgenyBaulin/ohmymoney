            "value": "Оның астына ешбір есеп-шот тізімделмеген. «Болдырмау» қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул топто эсептер жок. “Артка кайтаруу” аны калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma w niej żadnych kont. „Cofnij” przywróci ją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há contas neste grupo. “Desfazer” o restaura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К ней не отнесён ни один счёт. «Отменить» вернёт её."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu grupta hesap yok. “Geri Al” ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У ньому немає жодного рахунку. «Скасувати» поверне її."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu guruhda hisob yo‘q. “Bekor qilish” uni qaytaradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此群組沒有帳戶。使用「復原」可還原。"
          }
        }
      }
    },
