    "cashback.settings.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the bank pays"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo paga el banco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как банк платит"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як банк нараховує"
          }
        }
      }
    },
    "cashback.settings.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rounding is applied to the cashback of each purchase. The day is the day of the next month the bank pays by. Points count as the currency of their account, one to one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El redondeo se aplica al cashback de cada compra. El día es el del mes siguiente en que el banco paga. Los puntos cuentan como la divisa de su cuenta, uno a uno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Округление применяется к кэшбэку каждой покупки. День — до какого числа следующего месяца банк платит. Баллы считаются в валюте их счёта, один к одному."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Округлення застосовується до кешбеку з кожної покупки. День — це день наступного місяця, до якого банк нараховує. Бали рахуються як валюта свого рахунку, один до одного."
          }
        }
      }
    },
    "cashback.sheet.accountHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account’s rules hold for all its cards, unless a card has a rule of its own for the same month and category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de la cuenta valen para todas sus tarjetas, salvo que una tarjeta tenga una regla propia para el mismo mes y categoría."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила счёта действуют для всех его карт, если у карты нет своего правила на тот же месяц и категорию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила рахунку діють для всіх його карток, якщо в картки немає власного правила на той самий місяць і категорію."
          }
        }
      }
    },
    "cashback.sheet.addRule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Rule"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir regla"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
