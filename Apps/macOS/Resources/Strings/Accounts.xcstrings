    "account.handOver.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account that becomes main instead. The most used one is picked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la cuenta que pasará a ser la principal. Se propone la más usada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le compte qui deviendra principal à la place. Le plus utilisé est proposé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите счёт, который станет основным вместо него. Предложен самый используемый."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть рахунок, який стане основним. Вибрано найчастіше використовуваний."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il nuovo conto principale. È selezionato quello più usato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның орнына негізгі болатын есеп-шотты таңдаңыз. Ең көп қолданылаты таңдалады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце рахунак, які стане асноўным. Прапанаваны самы ўжываны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie stattdessen das Konto, das Hauptkonto wird. Das am meisten genutzte wird vorgeschlagen."
          }
        }
      }
    },
