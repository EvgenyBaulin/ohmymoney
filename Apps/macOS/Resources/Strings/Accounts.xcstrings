    "transfer.sheet.atmFeeLaid": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank komissiyası: %@ — kartın xaricdə istifadə şərtlərinə əsasən avtomatik qeydə alınıb. Çıxarışla yoxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камісія банка: %@ — запісана аўтаматычна па ўмовах карты за мяжой. Зверце з выпіскай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankovní poplatek: %@ — zaznamenán samostatně podle podmínek karty pro zahraničí. Zkontrolujte ho podle výpisu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankgebühr: %@ — von selbst eingetragen, nach den Bedingungen der Karte im Ausland. Prüfen Sie sie anhand der Abrechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank fee: %@ — written by itself, by the terms of the card abroad. Check it against the statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comisión del banco: %@ — se anota sola, según las condiciones de la tarjeta en el extranjero. Compárela con el extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frais de la banque : %@ — notés automatiquement selon les conditions de la carte à l'étranger. Vérifiez-les sur le relevé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկի միջնորդավճար՝ %@․ գրանցվում է ավտոմատ՝ արտերկրում քարտի պայմաններով։ Ստուգեք քաղվածքով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Commissione bancaria: %@ — registrata automaticamente in base alle condizioni della carta all'estero. Verificala nell'estratto conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行手数料: %@ — カードの海外利用条件に基づき自動入力されました。明細と照合してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკის საკომისიო: %@ — ავტომატურად ჩაიწერა საზღვარგარეთ ბარათის პირობების მიხედვით. შეამოწმეთ ამონაწერთან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк комиссиясы: %@ — шетелдегі картаның шарттары бойынша өзі жазылды. Үзіндімен тексеріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 수수료: %@ — 카드의 해외 이용 약관에 따라 자동으로 기록됩니다. 명세서와 확인하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк комиссиясы: %@ — картаны чет өлкөдө колдонуу шарттарына ылайык автоматтык жазылды. Көчүрмө менен текшериңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankkosten: %@ — afzonderlijk geregistreerd volgens de voorwaarden van de kaart in het buitenland. Controleer dit met het rekeningafschrift."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłata bankowa: %@ — dodana automatycznie zgodnie z warunkami korzystania z karty za granicą. Sprawdź ją na wyciągu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarifa bancária: %@ — registrada separadamente conforme as condições do cartão no exterior. Confira no extrato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Comissão bancária: %@ — registada automaticamente segundo as condições do cartão no estrangeiro. Confirme no extrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия банка: %@ — запишется сама, по условиям карты за границей. Сверьте с выпиской."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссияи бонк: %@ — мувофиқи шартҳои истифодаи корт дар хориҷа худкор сабт шудааст. Онро бо иқтибоси ҳисоб санҷед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka ücreti: %@ — kartın yurt dışı koşullarına göre otomatik girildi. Ekstreyle karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія банку: %@ — записана сама, за умовами картки за кордоном. Звірте з випискою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank komissiyasi: %@ — kartaning chet elda ishlash shartlariga ko‘ra avtomatik kiritildi. Uni ko‘chirma bilan tekshiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行手续费：%@ — 已根据卡片境外使用条款单独记录。请与账单核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行手續費：%@ — 已依卡片海外使用條款自動記錄。請與帳單核對。"
          }
        }
      }
    },
