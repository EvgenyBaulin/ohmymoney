    "accounts.alphabetizeHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabları sürüşdürərək qurduğunuz sıra silinir; əsas hesab birinci qalır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Скінуць парадак, зададзены перацягваннем; асноўны рахунак застанецца першым"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit ruční pořadí účtů; hlavní účet zůstane první"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reihenfolge, in die Sie die Konten gezogen haben, wird vergessen; das Hauptkonto bleibt vorn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget the order you dragged the accounts into; the main account stays first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar el orden en que arrastró las cuentas; la cuenta principal sigue primera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier l'ordre dans lequel vous avez glissé les comptes ; le compte principal reste en tête"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չեղարկել հաշիվների ձեռքով սահմանված հերթականությունը․ գլխավոր հաշիվը կմնա առաջինը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reimposta l’ordine dei conti; il conto principale resta al primo posto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで変更した口座の順序をリセットします。メイン口座は先頭のままです"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშების ხელით დადგენილი რიგის გაუქმება; მთავარი ანგარიში პირველი დარჩება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттарды сүйреп орнатқан тәртіпті ұмыту; негізгі есеп-шот бірінші тұрады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 정한 계좌 순서를 지웁니다. 주 계좌는 맨 앞에 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептердин кол менен коюлган ирети өчүрүлөт; негизги эсеп биринчи бойдон калат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de aangepaste volgorde van rekeningen terug; de hoofdrekening blijft bovenaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń ręcznie ustawioną kolejność kont; konto główne pozostanie na początku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta a ordem definida ao arrastar as contas; a conta principal permanece em primeiro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Repor a ordem das contas; a conta principal mantém-se em primeiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть порядок, в который вы перетащили счета; основной счёт остаётся первым"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тартиби дастии ҳисобҳоро пок кунед; ҳисоби асосӣ аввал мемонад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesapların sürüklenerek belirlenen sırasını kaldırır; ana hesap ilk sırada kalır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забути порядок, у якому ви перетягували рахунки; основний рахунок лишається першим"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblarning qo‘lda belgilangan tartibini bekor qilish; asosiy hisob birinchi bo‘lib qoladi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
