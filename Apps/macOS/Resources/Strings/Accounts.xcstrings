    "transfer.beforeCount.dontAsk": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask again for this reconciliation"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не спрашивать для этой сверки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не запитувати для цієї звірки"
          }
        }
      }
    },
    "transfer.beforeCount.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That day's balance was counted then. Made before the count, the transfer is already inside the balance counted: the difference of the count changes, not the balance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В это время в тот день был сверен остаток. Если перевод был до сверки, он уже внутри сверенного остатка: изменится разница сверки, а не остаток."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок того дня тоді вже був порахований. Якщо переказ зроблено до звірки, він уже входить до порахованого залишку: змінюється різниця звірки, а не залишок."
          }
        }
      }
    },
    "transfer.beforeCount.no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, After It"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет, после"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні, після"
          }
        }
      }
    },
