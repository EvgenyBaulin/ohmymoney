    "account.credit.offHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie es für eine Karte mit Kreditlimit ein: Der Bildschirm des Kontos zeigt dann, bis wann gezahlt werden muss, um keine Zinsen zu zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on for a card with a credit limit: the screen of the account will say what to pay by when not to pay interest."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредит лимиті бар карта үшін қосыңыз: есеп-шот экраны қашан және не төлеу керектігін, пайыз төленбеуі үшін көрсетеді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите для карты с кредитным лимитом: экран счёта подскажет, сколько и до какого дня внести, чтобы не платить проценты."
          }
        }
      }
    },
