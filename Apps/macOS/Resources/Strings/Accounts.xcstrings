    "card.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уласныя правілы кэшбэку выдаляюцца разам з ёй. ⌘Z усё адновіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigenen Cashback-Regeln gehen mit ihr. ⌘Z holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its own cashback rules go with it. ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus reglas propias de cashback se eliminan con ella. ⌘Z lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses règles de cashback propres partent avec elle. ⌘Z rétablit tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le sue regole cashback verranno eliminate. Premi ⌘Z per ripristinare tutto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның өз кешбэк ережелері де бірге кетеді. ⌘Z бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Анын өз кэшбэк эрежелери да өчүрүлөт. ⌘Z баарын калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własne zasady cashbacku karty też zostaną usunięte. ⌘Z przywróci wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras próprias de cashback também serão apagadas. Use ⌘Z para restaurar tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её собственные правила кэшбэка удалятся вместе с ней. ⌘Z вернёт всё."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta ait para iadesi kuralları da silinir. ⌘Z ile tümünü geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Разом із нею зникають її власні правила кешбеку. ⌘Z поверне все."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartaning o‘z keshbek qoidalari ham o‘chiriladi. ⌘Z hammasini tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片的專屬現金回饋規則也會一併刪除。按下 ⌘Z 可還原所有內容。"
          }
        }
      }
    },
    "card.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уласныя правілы кэшбэку выдаляюцца разам з ёй. “Адмяніць” усё адновіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigenen Cashback-Regeln gehen mit ihr. „Rückgängig“ holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its own cashback rules go with it. “Undo” brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus reglas propias de cashback se eliminan con ella. «Deshacer» lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses règles de cashback propres partent avec elle. « Annuler » rétablit tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le sue regole cashback verranno eliminate. Tocca “Annulla” per ripristinare tutto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның өз кешбэк ережелері де бірге кетеді. «Болдырмау» бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Анын өз кэшбэк эрежелери да өчүрүлөт. “Артка кайтаруу” баарын калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własne zasady cashbacku karty też zostaną usunięte. „Cofnij” przywróci wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras próprias de cashback também serão apagadas. Use “Desfazer” para restaurar tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её собственные правила кэшбэка удалятся вместе с ней. «Отменить» вернёт всё."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
