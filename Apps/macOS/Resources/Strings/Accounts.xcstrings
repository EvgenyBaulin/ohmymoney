          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте каждый платёж или подписку и выберите другую карту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ödemeyi veya aboneliği açıp başka bir kart seçin."
