        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул көчүрмөнүн пайызы таштандыда — аны ошол жерден калыбына келтириңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsetki z tego wyciągu są w koszu — przywróć je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros desta fatura estão na lixeira. Restaure-os para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты этой выписки лежат в корзине — верните их оттуда."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоизи ин суратҳисоб дар сабад аст — онро аз он ҷо барқарор кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekstrenin faizi çöp kutusunda. Oradan geri getirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки цієї виписки в кошику — поверніть їх звідти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ko‘chirmaning foizi savatda — uni u yerdan tiklang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳單的利息位於垃圾桶中，請先將其還原。"
          }
        }
      }
    },
