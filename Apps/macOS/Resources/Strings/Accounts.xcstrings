            "value": "Переказ не видалено"
          }
        }
      }
    },
    "transfer.fee.fromArchive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee goes to «%@», which comes back from the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión va a «%@», que vuelve del archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия пойдёт в «%@» — она вернётся из архива."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія йде на «%@», який повертається з архіву."
          }
        }
      }
    },
    "transfer.fee.fromArchiveWithParent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee goes to «%1$@», which comes back from the archive with «%2$@»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión va a «%1$@», que vuelve del archivo junto con «%2$@»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия пойдёт в «%1$@» — она вернётся из архива вместе с «%2$@»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
