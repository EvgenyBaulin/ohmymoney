    "account.interest.base.minBalance": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мінімальны астатак за месяц"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
