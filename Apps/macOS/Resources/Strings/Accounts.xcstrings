    "card.merge.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card in the archive is not merged: bring it back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta del archivo no se fusiona: recupérela antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte aux archives ne se fusionne pas : ramenez-la d'abord."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карту в архиве объединить нельзя — сначала верните её."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка в архіві не зливається: спершу поверніть її."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta archiviata non può essere unita: ripristinala prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы карта біріктірілмейді: алдымен оны қайтарыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карту ў архіве нельга аб'яднаць: спачатку аднавіце яе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte im Archiv wird nicht zusammengeführt: Holen Sie sie zuerst zurück."
          }
        }
      }
    },
    "card.merge.refusal.otherAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only cards of one account can be merged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden fusionar tarjetas de una misma cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne peut fusionner que des cartes d'un même compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединить можно только карты одного счёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зливати можна лише картки одного рахунку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi unire solo carte dello stesso conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек бір есеп-шоттың карталарын ғана біріктіруге болады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна аб'яднаць толькі карты аднаго рахунку."
          }
        },
        "de": {
          "stringUnit": {
