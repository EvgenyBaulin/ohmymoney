    "accounts.groupsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group left out of the summary keeps its money out of «Total» and the free sum; its income and spending still count everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo fuera del resumen deja su dinero fuera de «Total» y de la suma libre; sus ingresos y gastos siguen contando en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe exclu du récapitulatif garde son argent hors de « Total » et de la somme libre ; ses revenus et dépenses comptent toujours partout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги группы вне сводки не входят во «Всего» и в свободную сумму; её доходы и траты по-прежнему учитываются везде."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Група, вилучена з підсумку, тримає свої гроші поза «Усього» і вільною сумою; її доходи й витрати всюди враховуються."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro di un gruppo escluso dal riepilogo non viene incluso nel «Totale» né nella somma disponibile; le entrate e le spese vengono comunque conteggiate ovunque."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдан шығарылған топ өз ақшасын «Барлығынан» және бос қаржыдан тыс ұстайды; оның табысы мен шығысы әр жерде әлі есептеледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы групы па-за зводкай не ўваходзяць ва «Усяго» і свабодную суму; яе даходы і выдаткі ўлічваюцца ўсюды."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe, die aus der Übersicht herausgenommen ist, hält ihr Geld aus „Gesamt“ und dem freien Betrag heraus; ihre Einnahmen und Ausgaben zählen überall weiterhin."
          }
        }
      }
    },
