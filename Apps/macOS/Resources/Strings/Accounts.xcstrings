                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld переказів між двома рахунками в одній валюті будуть видалені"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld переказ між двома рахунками в одній валюті буде видалено"
                }
