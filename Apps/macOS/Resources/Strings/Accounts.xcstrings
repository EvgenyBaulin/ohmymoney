    "account.balance.creditHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a credit card, type what you owe the bank with a minus: −30,000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кредитной карты впишите долг банку со знаком минус: −30,000."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кредитної картки введіть, скільки ви винні банку, з мінусом: −30 000."
          }
        }
      }
    },
    "account.credit.available": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available %1$@ of %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно %1$@ из %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно %1$@ з %2$@"
          }
        }
      }
    },
    "account.credit.cashNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash or transfer on %1$@: %2$@ — interest runs at once"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие или перевод %1$@: %2$@ — проценты пойдут сразу"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готівка або переказ за %1$@: %2$@ — відсотки нараховуються одразу"
          }
        }
      }
    },
    "account.credit.cashRate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate on cash and transfers, % a year"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка на снятие и переводы, % годовых"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка на готівку та перекази, % на рік"
          }
        }
      }
    },
    "account.credit.cashWithoutGrace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash and transfers have no grace period"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие и переводы без льготного периода"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На готівку й перекази пільгового періоду немає"
          }
        }
      }
    },
    "account.credit.category": {
      "extractionState": "manual",
