      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in use — operations: %1$lld, transfers: %2$lld, scheduled payments: %3$lld, debt entries: %4$lld. It cannot be deleted: merge it with another account or move it to the archive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт используется — операций: %1$lld, переводов: %2$lld, платежей: %3$lld, записей долгов: %4$lld. Удалить его нельзя: объедините с другим счётом или уберите в архив."
          }
        }
      }
    },
