    "cashback.refusal.loan": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borc ödənişinə keşbek verilmir, buna görə “Kreditlər” üçün qayda yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацеж па пазыцы не дае кэшбэку, таму для “Пазык” няма правіла."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za splátku dluhu se cashback nepřipisuje, proto pro „Půjčky“ nelze vytvořit pravidlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahlung auf eine Schuld bringt keinen Cashback, deshalb gibt es für „Kredite“ keine Regel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A payment on a debt earns no cashback, so there is no rule for “Loans”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pago de deuda no genera cashback, así que no hay regla para «Préstamos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paiement de dette ne rapporte aucun cashback : il n'y a donc pas de règle pour « Crédits »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պարտքի վճարման համար քեշբեք չի տրվում, ուստի “Վարկեր”-ի համար կանոն չկա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento di un debito non genera cashback, quindi non esiste una regola per “Prestiti”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "借入の返済にはキャッシュバックが付かないため、“ローン”のルールはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალის გადახდაზე ქეშბექი არ ირიცხება, ამიტომ „სესხებისთვის“ წესი არ არსებობს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек бойынша төлем кешбэк бермейді, сондықтан “Несие” үшін ереже жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채무 상환에는 캐시백이 적립되지 않아 “대출” 규칙을 설정할 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карыз төлөмүнө кэшбэк берилбейт, ошондуктан “Насыялар” үчүн эреже жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aflossing levert geen cashback op, dus er is geen regel voor ‘Leningen’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spłata zadłużenia nie daje cashbacku, więc nie ma zasady dla kategorii „Pożyczki”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamentos de dívidas não geram cashback, por isso não há regra para “Empréstimos”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pagamento de dívida não gera cashback, pelo que não há regra para “Empréstimos”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За платёж по долгу кэшбэк не платят, поэтому правила для «Кредитов» нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои пардохти қарз кешбэк дода намешавад, бинобар ин барои “Қарзҳо” қоида нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borç ödemelerinde para iadesi kazanılmaz; bu yüzden “Krediler” için kural yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж за боргом кешбеку не приносить, тому правила для «Кредитів» немає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarz to‘loviga keshbek berilmaydi, shuning uchun “Qarzlar” uchun qoida yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偿还债务不产生返现，因此无法为“贷款”设置规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "償還債務不會獲得現金回饋，因此無法為「貸款」設定規則。"
          }
        }
      }
    },
    "cashback.refusal.percent": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz 0-dan 100-ə qədər olmalı, vergüldən sonra ən çox dörd rəqəm olmalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнт ад 0 да 100, не больш за чатыры знакі пасля кропкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procento musí být od 0 do 100, nejvýše se čtyřmi desetinnými místy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozentsatz liegt zwischen 0 und 100, mit höchstens vier Nachkommastellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The percent is from 0 to 100, with at most four digits after the point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje va de 0 a 100, con cuatro cifras decimales como máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pourcentage va de 0 à 100, avec au plus quatre chiffres après la virgule."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տոկոսը պետք է լինի 0-ից 100՝ ստորակետից հետո առավելագույնը չորս թվանշանով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale deve essere compresa tra 0 e 100, con un massimo di quattro cifre decimali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーセントは0〜100で、小数点以下は4桁までです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პროცენტი უნდა იყოს 0-დან 100-მდე, ათწილადის შემდეგ არაუმეტეს ოთხი ციფრით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз 0-ден 100-ге дейін, үтірден кейін ең көбі төрт таңба."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비율은 0부터 100까지이며 소수점 아래 네 자리까지 입력할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз 0дөн 100гө чейин, үтүрдөн кийин эң көп дегенде төрт сан болушу керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het percentage moet tussen 0 en 100 liggen, met maximaal vier cijfers achter de komma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procent musi wynosić od 0 do 100 i mieć maksymalnie cztery cyfry po przecinku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porcentagem deve ser de 0 a 100, com no máximo quatro casas decimais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A percentagem deve estar entre 0 e 100, com um máximo de quatro casas decimais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процент — от 0 до 100, не больше четырёх знаков после точки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоиз бояд аз 0 то 100 бошад ва пас аз нуқта на бештар аз чор рақам дошта бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzde 0 ile 100 arasında olmalı ve virgülden sonra en fazla dört basamak içermelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсоток — від 0 до 100, не більше чотирьох знаків після коми."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Foiz 0 dan 100 gacha bo‘lishi va verguldan keyin ko‘pi bilan to‘rtta raqam bo‘lishi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比须介于 0 到 100 之间，最多保留四位小数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比須介於 0 到 100 之間，小數點後最多四位。"
          }
        }
      }
    },
    "cashback.refusal.pointsArchived": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
