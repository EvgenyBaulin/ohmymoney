          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı para birimindeki %@ transfer hesaba katılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекази в іншій валюті (%@) не враховано."
          }
        }
      }
    },
    "account.savings.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пераводы на гэты рахунак з рахункаў, якія не прызначаны для зберажэнняў, за вылікам выведзеных назад грошай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überweisungen auf dieses Konto von Konten, die nicht zum Sparen dienen, abzüglich der Rücküberweisungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers into this account from accounts that are not saving places, less what went back out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferencias a esta cuenta desde cuentas que no son de ahorro, menos lo que se ha retirado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virements vers ce compte depuis des comptes qui ne sont pas destinés à l’épargne, moins les retraits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasferimenti verso questo conto da conti non destinati al risparmio, al netto dei trasferimenti in uscita."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жинақ шоттары емес шоттардан осы шотқа аударылған сома, кері шығарылған ақшаны шегергенде."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelewy na to konto z kont innych niż oszczędnościowe, pomniejszone o wypłacone środki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências para esta conta de contas que não são usadas para guardar dinheiro, descontando o que saiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы на этот счёт со счетов, которые не копят, за вычетом того, что ушло обратно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birikim hesabı olmayan hesaplardan bu hesaba yapılan transferlerden, geri çıkan tutar düşülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекази на цей рахунок з інших рахунків, що не є місцями заощаджень, за вирахуванням повернених коштів."
          }
        }
      }
    },
