    "bank.forgotten.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account or card has stood idle with money on it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna cuenta ni tarjeta lleva parada con dinero"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет счетов и карт, на которых лежат деньги без движения"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден рахунок або картка не простоювали з грошима"
          }
        }
      }
    },
    "bank.forgotten.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts and cards nothing has moved on for %1$@ days or more that hold money or may charge for service. A deposit that is still running is not forgotten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentas y tarjetas sin movimientos desde hace %1$@ días o más, que tienen dinero o pueden cobrar por el servicio. Un depósito que sigue vigente no se considera olvidado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета и карты без движения %1$@ дней и больше, на которых есть деньги или может быть плата за обслуживание. Вклад до конца срока не считается забытым."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки й картки, за якими жодного руху не було %1$@ днів і більше, а на них є гроші або банк може брати плату за обслуговування. Депозит, що ще триває, не вважається забутим."
          }
        }
      }
    },
