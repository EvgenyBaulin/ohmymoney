        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკომისიო ნულზე ნაკლები ვერ იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия нөлден төмен бола алмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수수료는 0보다 작을 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия нөлдөн аз болбойт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosten kunnen niet lager zijn dan nul."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłata nie może być mniejsza od zera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarifa não pode ser menor que zero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma comissão não pode ser inferior a zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия не может быть меньше нуля."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия аз сифр кам буда наметавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücret sıfırın altında olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія не може бути меншою за нуль."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya noldan kam bo‘lishi mumkin emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手续费不能小于零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手續費不能小於零。"
          }
        }
      }
    },
