    "account.editor.bank.newHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank of its own, called like the account unless you name it. An account called like a bank that is there already joins that bank."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк под своим именем — как у счёта, если не назвать иначе. Счёт, названный как уже существующий банк, встаёт под него."
          }
