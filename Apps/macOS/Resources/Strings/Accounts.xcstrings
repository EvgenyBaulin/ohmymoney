    "account.editor.mainHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is first in every list; an operation with no account of its own goes to it. Only one account is main."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal va primera en todas las listas; una operación sin cuenta propia va a ella. Solo una cuenta es la principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal est en tête de chaque liste ; une opération sans compte propre lui est affectée. Un seul compte est principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт — первый во всех списках; операция без своего счёта попадает на него. Основной счёт один."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок стоїть першим у кожному списку; операція без власного рахунку йде на нього. Основний рахунок один."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale è il primo in ogni elenco. Le operazioni senza un conto assegnato vengono registrate su questo conto. Un solo conto può essere principale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот әр тізімде бірінші тұрады; өз есеп-шоты жоқ операция соған жазылады. Негізгі бір ғана есеп-шот болады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак першы ва ўсіх спісах; аперацыя без свайго рахунку трапляе на яго. Асноўным можа быць толькі адзін рахунак."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto steht in jeder Liste an erster Stelle; ein Vorgang ohne eigenes Konto wird ihm zugeordnet. Nur ein Konto ist das Hauptkonto."
          }
        }
      }
    },
    "account.editor.mainStays": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be switched off: make another account main, and this one stops being main."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal no se puede desactivar: haga principal otra cuenta y esta dejará de serlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal ne peut pas être désactivé : désignez un autre compte comme principal, et celui-ci cessera de l'être."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не выключается: сделайте основным другой счёт — этот перестанет им быть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок не можна вимкнути: зробіть основним інший рахунок, і цей перестане бути основним."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale non può essere disattivato. Imposta un altro conto come principale per sostituirlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шотты өшіру мүмкін емес: басқа есеп-шотты негізгі етіңіз, осы есеп-шот негізгі болудан қалады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак нельга адключыць: зрабіце асноўным іншы, і гэты перастане ім быць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto lässt sich nicht ausschalten: Machen Sie ein anderes Konto zum Hauptkonto, dann ist dieses nicht mehr das Hauptkonto."
          }
        }
      }
    },
    "account.editor.makeMainCurrency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make Main Currency"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer principal la divisa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir comme devise principale"
          }
        },
