    "bank.fees.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fees are the category “Fees” with its subcategories (service fees too); interest is what loans and credit cards charged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las comisiones son la categoría «Comisiones» con sus subcategorías (también las de servicio); los intereses son lo que cobraron los préstamos y las tarjetas de crédito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais sont la catégorie « Frais » avec ses sous-catégories (y compris les frais de service) ; les intérêts sont ce que facturent les crédits et cartes de crédit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссии — категория «Комиссии» с подкатегориями (в том числе плата за обслуживание); проценты — то, что взяли кредиты и кредитные карты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісії — це категорія «Комісії» з її підкатегоріями (у тому числі комісії за обслуговування); відсотки — це те, що стягнули кредити й кредитні картки."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le commissioni includono la categoria “Commissioni” e le sue sottocategorie, anche per il servizio. Gli interessi sono quelli addebitati su prestiti e carte di credito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссиялар — «Комиссиялар» санаты мен оның ішкі санаттары (қызмет комиссиялары да); пайыз — несие мен кредиттік карталар алған."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камісіі — катэгорыя “Камісіі” з падкатэгорыямі (таксама за абслугоўванне); працэнты — налічэнні па крэдытах і крэдытных картах."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebühren sind die Kategorie „Gebühren“ mit ihren Unterkategorien (auch Kontoführungsgebühren); Zinsen sind das, was Kredite und Kreditkarten berechnet haben."
          }
        }
      }
    },
