    "account.refusal.unreadableBalance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance in %@ does not read as an amount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo en %@ no se lee como importe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde en %@ ne se lit pas comme un montant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в %@ не читается как сумма."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок у %@ не вдалося прочитати як суму."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo in %@ non è un importo valido."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ валютасындағы теңгерім соманы білдірмейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс у %@ не распазнаны як сума."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo in %@ ist kein lesbarer Betrag."
          }
        }
