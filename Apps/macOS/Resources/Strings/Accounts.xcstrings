              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transfer between the two accounts in one currency will be deleted"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transfers between the two accounts in one currency will be deleted"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se eliminarán %lld transferencias entre las dos cuentas en una divisa"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se eliminará %lld transferencia entre las dos cuentas en una divisa"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se eliminarán %lld transferencias entre las dos cuentas en una divisa"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
