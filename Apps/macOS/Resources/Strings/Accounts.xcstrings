    "account.editor.bank.newHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank of its own, called like the account unless you name it. An account called like a bank that is there already joins that bank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banco propio, con el nombre de la cuenta salvo que indique otro. Una cuenta con el nombre de un banco que ya existe se añade a ese banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк под своим именем — как у счёта, если не назвать иначе. Счёт, названный как уже существующий банк, встаёт под него."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк окремо, називається так само, як рахунок, якщо ви не назвете інакше. Рахунок, названий як уже наявний банк, приєднується до нього."
          }
        }
      }
    },
