    "accounts.delete.messageMoney": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance %@ leaves every total with it. Nothing refers to the account. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo %@ sale de todos los totales con ella. Nada hace referencia a la cuenta. ⌘Z la devuelve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток %@ пропадёт из итогов. На счёт ничто не ссылается. ⌘Z вернёт его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок %@ разом із ним зникає з усіх підсумків. Ніщо на рахунок не посилається. ⌘Z поверне його."
          }
        }
      }
    },
