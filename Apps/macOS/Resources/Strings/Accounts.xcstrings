            "state": "translated",
            "value": "Geben Sie einen Namen ein."
          }
        }
      }
    },
    "account.refusal.groupHasLiveAccounts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group still has accounts outside the archive: move them to the archive first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo aún tiene cuentas fuera del archivo: pásalas antes al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe a encore des comptes hors des archives : mettez-les d'abord aux archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе есть счета не в архиве — сначала уберите в архив их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У групі ще є рахунки поза архівом: спершу перенесіть їх в архів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo contiene ancora conti non archiviati: archiviali prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топта әлі мұрағатта жоқ есеп-шоттар бар: алдымен оларды мұрағатқа өткізіңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У групе яшчэ ёсць рахункі па-за архівам: спачатку архівуйце іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe hat noch Konten außerhalb des Archivs: Verschieben Sie diese zuerst ins Archiv."
          }
        }
      }
    },
    "account.refusal.groupHoldsMain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is in this group, so it stays in the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal está en este grupo, así que se queda en el resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal se trouve dans ce groupe, il reste donc dans le récapitulatif."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе основной счёт, поэтому она остаётся в общей сводке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок є в цій групі, тому він залишається в підсумку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale è in questo gruppo, che quindi rimane nel riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот осы топта, сондықтан ол қорытындыда қалады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак у гэтай групе, таму яна застаецца ў зводцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto ist in dieser Gruppe, deshalb bleibt sie in der Übersicht."
          }
        }
      }
    },
    "account.refusal.groupInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, archived ones too, are filed under the group: it can go to the archive, not be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cuentas, también archivadas, dentro del grupo: puede pasar al archivo, pero no eliminarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des comptes, même archivés, sont classés dans le groupe : il peut aller aux archives, mais non être supprimé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К группе отнесены счета, в том числе архивные: её можно убрать в архив, но не удалить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки, в тому числі архівні, лежать у групі: вона може піти в архів, але не видалитися."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo contiene conti, anche archiviati: puoi archiviarlo, ma non eliminarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топ астында есеп-шоттар тізімделген, мұрағаттағылар да: ол мұрағатқа өтуі мүмкін, бірақ жойылмайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да групы адносяцца рахункі, у тым ліку архіўныя: яе можна архіваваць, але не выдаліць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Gruppe sind Konten abgelegt, auch archivierte: Sie kann ins Archiv, nicht gelöscht werden."
          }
        }
      }
    },
    "account.refusal.groupNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group with this name already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un grupo con este nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe portant ce nom existe déjà."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа с таким названием уже есть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Група із такою назвою вже є."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un gruppo con questo nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен топ бұрыннан бар."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Група з такой назвай ужо ёсць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe mit diesem Namen gibt es bereits."
          }
        }
      }
    },
    "account.refusal.hasMoney": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is money on the account. Transfer the balance to another account or reconcile it to zero, then move it to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la cuenta hay dinero. Transfiera el saldo a otra cuenta o concílielo a cero, y después páselo al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a de l'argent sur le compte. Virez le solde sur un autre compte ou rapprochez-le à zéro, puis mettez-le aux archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги. Переведите остаток на другой счёт или сверьте счёт до нуля, а потом уберите в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку є гроші. Перекажіть залишок на інший рахунок або звірте його з нульовим залишком, а потім перенесіть у архів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto contiene denaro. Trasferisci il saldo su un altro conto o riconcilialo a zero, poi archivialo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотта ақша бар. Теңгерімді басқа есеп-шотқа аударыңыз немесе нөлге дейін салыстырыңыз, содан кейін мұрағатқа өткізіңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку ёсць грошы. Перавядзіце рэшту на іншы рахунак або зверце яго да нуля, затым архівуйце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Konto liegt Geld. Übertragen Sie den Saldo auf ein anderes Konto oder gleichen Sie es auf null ab und verschieben Sie es dann ins Archiv."
          }
        }
      }
    },
    "account.refusal.inArchive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name is in the archive: bring that one back instead of making a second one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nombre está en el archivo: recupere esa cuenta en lugar de crear una segunda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom est dans les archives : restaurez celui-là au lieu d'en créer un second."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое название есть в архиве: верните его, а не заводите второе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Така назва є в архіві: поверніть той рахунок замість створення другого."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo nome è nell’archivio: ripristina l’elemento esistente invece di crearne un altro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл атау мұрағатта бар: екінші есеп-шот жасаудың орнына сол есеп-шотты қайтарыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта назва ў архіве: аднавіце наяўны запіс замест стварэння другога."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name ist im Archiv: Holen Sie jenes Konto zurück, statt ein zweites anzulegen."
          }
        }
      }
    },
    "account.refusal.inUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in use — operations: %1$lld, transfers: %2$lld, scheduled payments: %3$lld, debt entries: %4$lld. It cannot be deleted: merge it with another account or move it to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta está en uso — operaciones: %1$lld, transferencias: %2$lld, pagos programados: %3$lld, apuntes de deuda: %4$lld. No se puede eliminar: fusiónela con otra cuenta o pásela al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte est utilisé — opérations : %1$lld, virements : %2$lld, paiements planifiés : %3$lld, entrées de dette : %4$lld. Il ne peut pas être supprimé : fusionnez-le avec un autre compte ou mettez-le aux archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт используется — операций: %1$lld, переводов: %2$lld, платежей: %3$lld, записей долгов: %4$lld. Удалить его нельзя: объедините с другим счётом или уберите в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок використовується — операцій: %1$lld, переказів: %2$lld, запланованих платежів: %3$lld, записів боргів: %4$lld. Його не можна видалити: злийте його з іншим рахунком або перенесіть в архів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto è in uso: operazioni: %1$lld, trasferimenti: %2$lld, pagamenti programmati: %3$lld, voci di debito: %4$lld. Non puoi eliminarlo: uniscilo a un altro conto o archivialo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот қолданыста — операциялар: %1$lld, аударымдар: %2$lld, жоспарланған төлемдер: %3$lld, берешек жазбалары: %4$lld. Оны жою мүмкін емес: басқа есеп-шотпен біріктіріңіз немесе мұрағатқа өткізіңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак выкарыстоўваецца — аперацый: %1$lld, пераводаў: %2$lld, планавых плацяжоў: %3$lld, запісаў пазык: %4$lld. Нельга выдаліць: аб'яднайце з іншым рахункам ці архівуйце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto wird verwendet — Vorgänge: %1$lld, Überweisungen: %2$lld, geplante Zahlungen: %3$lld, Schuldeneinträge: %4$lld. Es kann nicht gelöscht werden: Führen Sie es mit einem anderen Konto zusammen oder verschieben Sie es ins Archiv."
          }
        }
      }
    },
    "account.refusal.inUseAlsoPoints": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is also the points account of the cashback of %lld accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También es la cuenta de puntos del cashback de %lld cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sert aussi de compte de points pour le cashback de %lld comptes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он же — счёт для баллов кэшбэка у счетов: %lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він також рахунок для балів кешбеку %lld рахунків."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È anche il conto punti per il cashback di %lld conti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол сонымен қатар %lld есеп-шоттың кешбэк ұпайларының есеп-шоты."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ён таксама з'яўляецца балавым рахункам кэшбэку для %lld рахункаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist außerdem das Punktekonto für den Cashback von %lld Konten."
          }
        }
      }
    },
    "account.refusal.inUsePoints": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the points account of the cashback of %lld accounts. It cannot be deleted: choose another points account in their “Cashback rules…”, merge it with another account or move it to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la cuenta de puntos del cashback de %lld cuentas. No se puede eliminar: elija otra cuenta de puntos en sus «Reglas de cashback…», fusiónela con otra cuenta o pásela al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sert de compte de points pour le cashback de %lld comptes. Il ne peut pas être supprimé : choisissez un autre compte de points dans leurs « Règles de cashback… », fusionnez-le avec un autre compte ou mettez-le aux archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это счёт для баллов кэшбэка у счетов: %lld. Удалить его нельзя: выберите другой счёт для баллов в их «Правилах кэшбэка…», объедините его с другим счётом или уберите в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він є рахунком для балів кешбеку %lld рахунків. Його не можна видалити: оберіть інший рахунок для балів у їхніх «Правилах кешбеку…», злийте його з іншим рахунком або перенесіть в архів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il conto punti per il cashback di %lld conti. Non puoi eliminarlo: scegli un altro conto punti nelle relative “Regole cashback…”, uniscilo a un altro conto o archivialo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол %lld есеп-шоттың кешбэк ұпайларының есеп-шоты. Оны жою мүмкін емес: олардың «Кешбэк ережелері…» бөлімінде басқа ұпайлар есеп-шотын таңдаңыз, басқа есеп-шотпен біріктіріңіз немесе мұрағатқа өткізіңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта балавы рахунак кэшбэку для %lld рахункаў. Нельга выдаліць: выберыце іншы балавы рахунак у іх “Правілах кэшбэку…”, аб'яднайце з іншым рахункам ці архівуйце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist das Punktekonto für den Cashback von %lld Konten. Es kann nicht gelöscht werden: Wählen Sie in deren „Cashback-Regeln…“ ein anderes Punktekonto, führen Sie es mit einem anderen Konto zusammen oder verschieben Sie es ins Archiv."
          }
        }
      }
    },
    "account.refusal.lastLiveAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the last account and cannot go to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la última cuenta y no puede pasar al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le dernier compte : il ne peut pas partir aux archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это последний счёт — в архив его не убрать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це останній рахунок, і його не можна перенести в архів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È l’ultimo conto e non può essere archiviato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл соңғы есеп-шот, мұрағатқа өткізілмейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта апошні рахунак, яго нельга архіваваць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist das letzte Konto und kann nicht ins Archiv."
          }
        }
      }
    },
    "account.refusal.mainInExcludedGroup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be in a group left out of the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal no puede estar en un grupo fuera del resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal ne peut pas se trouver dans un groupe exclu du récapitulatif."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не может быть в группе вне общей сводки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок не може бути в групі, яку вилучено з підсумку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale non può trovarsi in un gruppo escluso dal riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот қорытындыдан шығарылған топта бола алмайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак не можа быць у групе па-за зводкай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto kann nicht in einer Gruppe stehen, die aus der Übersicht herausgenommen ist."
          }
        }
      }
    },
    "account.refusal.nameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with this name already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una cuenta con este nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte portant ce nom existe déjà."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт с таким названием уже есть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок із такою назвою вже є."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un conto con questo nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен есеп-шот бұрыннан бар."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак з такой назвай ужо ёсць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konto mit diesem Namen gibt es bereits."
          }
        }
      }
    },
    "account.refusal.nameTakenByCard": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card is called “%@” — choose another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta se llama «%@»: elija otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte s'appelle « %@ » — choisissez un autre nom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так называется карта «%@» — выберите другое название."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка має назву «%@» — виберіть іншу."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” деп аталған карта бар — басқа атау таңдаңыз."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta si chiama “%@”: scegli un altro nome."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ёсць карта “%@” — выберыце іншую назву."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte heißt „%@“ — wählen Sie einen anderen Namen."
          }
        }
      }
    },
    "account.refusal.needsNewMain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account that becomes main first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero elija la cuenta que pasará a ser la principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d'abord le compte qui deviendra principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите счёт, который станет основным."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу оберіть рахунок, який стане основним."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima scegli il conto che diventerà principale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдымен негізгі болатын есеп-шотты таңдаңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку выберыце рахунак, які стане асноўным."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie zuerst das Konto, das Hauptkonto wird."
          }
        }
      }
    },
    "account.refusal.noCurrency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose at least one currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija al menos una divisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez au moins une devise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите хотя бы одну валюту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть хоча б одну валюту."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli almeno una valuta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кем дегенде бір валюта таңдаңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце хаця б адну валюту."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie mindestens eine Währung."
          }
        }
      }
    },
    "account.refusal.noSuccessor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other account in the summary can become main. Add an account or bring one into the summary first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna otra cuenta del resumen puede ser la principal. Antes añada una cuenta o incluya una en el resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun autre compte du récapitulatif ne peut devenir principal. Ajoutez d'abord un compte ou intégrez-en un au récapitulatif."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основным стать некому: нужен другой счёт в общей сводке. Сначала добавьте счёт или включите его группу в сводку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніякий інший рахунок у підсумку не може стати основним. Спершу додайте рахунок або включіть один до підсумку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro conto nel riepilogo può diventare principale. Prima aggiungi un conto o includine uno nel riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы басқа есеп-шот негізгі бола алмайды. Алдымен есеп-шот қосыңыз немесе қорытындыға бірін енгізіңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма іншага рахунку ў зводцы, які можа стаць асноўным. Спачатку дадайце рахунак або ўключыце яго ў зводку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein anderes Konto in der Übersicht kann Hauptkonto werden. Legen Sie zuerst ein Konto an oder nehmen Sie eines in die Übersicht auf."
          }
        }
      }
    },
    "account.refusal.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not there any more — it may have been deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no está: quizá se eliminó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est plus là — il a peut-être été supprimé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого больше нет — возможно, уже удалено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його вже немає — можливо, його видалили."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è più disponibile: potrebbe essere stato eliminato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол енді жоқ — жойылған болуы мүмкін."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтага запісу больш няма — магчыма, ён выдалены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht mehr vorhanden — vielleicht wurde es gelöscht."
          }
        }
      }
    },
    "account.refusal.otherBank": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only accounts of one bank are merged. To bring two banks together, merge the banks first in Settings → Accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se fusionan cuentas de un mismo banco. Para unir dos bancos, fusiónelos antes en Ajustes → Cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne fusionne que les comptes d'une même banque. Pour réunir deux banques, fusionnez d'abord les banques dans Réglages → Comptes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяются только счета одного банка. Чтобы свести два банка вместе, сначала объедините банки в «Настройки → Счета»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зливаються лише рахунки одного банку. Щоб об'єднати два банки, спершу злийте їх у «Налаштування → Рахунки»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi unire solo conti della stessa banca. Per unire due banche, uniscile prima in Impostazioni → Conti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек бір банктің есеп-шоттары біріктіріледі. Екі банкті біріктіру үшін алдымен «Параметрлер → Есеп-шоттар» бөлімінде банктерді біріктіріңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аб'ядноўваюцца толькі рахункі аднаго банка. Каб злучыць два банкі, спачатку аб'яднайце іх у Наладах → Рахункі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammengeführt werden nur Konten einer Bank. Um zwei Banken zusammenzuführen, führen Sie zuerst die Banken in den Einstellungen unter „Konten“ zusammen."
          }
        }
      }
    },
    "account.refusal.otherNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» is already a name of another account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya es otro nombre de una cuenta distinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà un nom d'un autre compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — уже название другого счёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже є назвою іншого рахунку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è già un nome di un altro conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» басқа есеп-шоттың атауы болып тұр."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ужо з'яўляецца назвай іншага рахунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits ein Name eines anderen Kontos."
          }
        }
      }
    },
    "account.refusal.removesCurrencyWithMoney": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is money in %@ on this account: the currency stays until its balance is zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta cuenta hay dinero en %@: la divisa se queda hasta que su saldo sea cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a de l'argent en %@ sur ce compte : la devise reste jusqu'à ce que son solde soit nul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги в %@: валюта останется, пока её остаток не станет нулём."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому рахунку є гроші в %@: валюта залишиться, доки її залишок не стане нульовим."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo conto contiene denaro in %@: la valuta rimane finché il saldo non è zero."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шотта %@ валютасында ақша бар: теңгерім нөлге тең болғанша валюта қалады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На гэтым рахунку ёсць грошы ў %@: валюта застанецца, пакуль яе баланс не стане нулявым."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Konto liegt Geld in %@: Die Währung bleibt, bis ihr Saldo null ist."
          }
        }
      }
    },
