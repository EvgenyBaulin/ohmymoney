          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати правило"
          }
        }
      }
    },
    "cashback.sheet.always": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди"
          }
        }
      }
    },
    "cashback.sheet.cardHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card keeps only what differs from its account; the rest it takes from the account’s rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta guarda solo lo que se diferencia de su cuenta; lo demás lo toma de las reglas de la cuenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта держит только то, чем отличается от счёта; остальное берёт из правил счёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка зберігає лише те, чим відрізняється від свого рахунку; решту бере з правил рахунку."
          }
        }
      }
    },
    "cashback.sheet.category": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category"
          }
        },
        "es": {
          "stringUnit": {
