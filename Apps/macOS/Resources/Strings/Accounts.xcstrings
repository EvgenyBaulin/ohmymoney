    "transfer.beforeCount.dontAsk": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Abgleich nicht mehr fragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask again for this reconciliation"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не спрашивать для этой сверки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не запитувати для цієї звірки"
          }
        }
      }
    },
    "transfer.beforeCount.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo dieses Tages wurde damals gezählt. Wurde die Überweisung vor dem Zählen gemacht, steckt sie bereits im gezählten Saldo: Es ändert sich die Differenz der Zählung, nicht der Saldo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That day's balance was counted then. Made before the count, the transfer is already inside the balance counted: the difference of the count changes, not the balance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В это время в тот день был сверен остаток. Если перевод был до сверки, он уже внутри сверенного остатка: изменится разница сверки, а не остаток."
          }
        }
      }
    },
    "transfer.beforeCount.no": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein, danach"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, After It"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет, после"
          }
        }
      }
    },
    "transfer.beforeCount.title": {
