    "bank.forgotten.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account or card has stood idle with money on it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna cuenta ni tarjeta lleva parada con dinero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte ni carte n'est resté dormant avec de l'argent dessus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет счетов и карт, на которых лежат деньги без движения"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден рахунок або картка не простоювали з грошима"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conto o carta con denaro è rimasto inattivo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақшасы бар, ұзақ бос тұрған есеп-шот немесе карта жоқ"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма рахункаў ці карт з грашыма без руху"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto und keine Karte stand mit Geld untätig herum"
          }
        }
      }
    },
    "bank.forgotten.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts and cards nothing has moved on for %1$@ days or more that hold money or may charge for service. A deposit that is still running is not forgotten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentas y tarjetas sin movimientos desde hace %1$@ días o más, que tienen dinero o pueden cobrar por el servicio. Un depósito que sigue vigente no se considera olvidado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptes et cartes sans aucun mouvement depuis %1$@ jours ou plus, qui détiennent de l'argent ou peuvent facturer un service. Un dépôt encore en cours n'est pas oublié."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета и карты без движения %1$@ дней и больше, на которых есть деньги или может быть плата за обслуживание. Вклад до конца срока не считается забытым."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки й картки, за якими жодного руху не було %1$@ днів і більше, а на них є гроші або банк може брати плату за обслуговування. Депозит, що ще триває, не вважається забутим."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conti e carte senza movimenti da almeno %1$@ giorni, con denaro o possibili costi di servizio. Un deposito ancora in corso non è considerato dimenticato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күн және одан көп қозғалыссыз тұрған, ақшасы бар немесе қызмет үшін ақы алуы мүмкін есеп-шоттар мен карталар. Әлі жұмыс істеп тұрған салым ұмытылған саналмайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахункі і карты без руху не менш за %1$@ дзён, дзе ёсць грошы ці магчымая плата за абслугоўванне. Дзейны ўклад не лічыцца забытым."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten und Karten, auf denen seit %1$@ Tagen oder länger nichts bewegt wurde und die Geld halten oder für die Führung berechnen könnten. Ein laufendes Festgeld gilt nicht als vergessen."
          }
        }
      }
    },
