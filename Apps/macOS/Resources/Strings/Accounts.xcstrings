    "account.credit.notCounted": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı üzləşdirin — balans olmadan çıxarışları hesablamaq mümkün deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверце рахунак — без балансу нельга разлічыць выпіскі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsouhlaste účet — bez zůstatku nelze výpisy vypočítat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichen Sie das Konto ab — ohne Saldo gibt es keine Abrechnungen zu berechnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile the account — without a balance there are no statements to work out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie la cuenta: sin saldo no hay extractos que calcular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez le compte — sans solde, il n'y a pas de relevés à calculer"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համադրեք հաշիվը․ առանց մնացորդի հնարավոր չէ հաշվարկել քաղվածքները"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconcilia il conto: senza un saldo non è possibile calcolare gli estratti conto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座残高を照合してください。残高がないと明細を計算できません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეაჯერეთ ანგარიში — ბალანსის გარეშე ამონაწერების გამოთვლა შეუძლებელია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотты салыстырыңыз — теңгерімсіз үзінділерді есептеу мүмкін емес"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌 잔액을 확인하세요. 잔액이 없으면 명세서를 계산할 수 없습니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсепти салыштырыңыз — баланссыз көчүрмөлөрдү эсептөө мүмкүн эмес"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de rekening: zonder saldo kunnen afschriften niet worden berekend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzgodnij konto — bez salda nie można obliczyć wyciągów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie a conta — sem saldo, não é possível calcular as faturas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcilie a conta — é necessário um saldo para calcular os extratos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверьте счёт — без остатка выписки не посчитать"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобро муқоиса кунед — бе бақия суратҳисобҳоро ҳисоб кардан намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı mutabık hale getirin — bakiye olmadan ekstreler hesaplanamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звіріть рахунок — без залишку немає виписок для розрахунку"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobni solishtiring — balanssiz ko‘chirmalarni hisoblab bo‘lmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对账户余额；没有余额便无法计算账单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先核對帳戶；沒有餘額就無法計算帳單"
          }
        }
      }
    },
    "account.credit.offHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit limitli kart üçün aktiv edin: hesab ekranında faiz ödəməmək üçün nə qədər və nə vaxtadək ödəməli olduğunuz göstəriləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце для карты з крэдытным лімітам: на экране рахунку будзе бачна, колькі і калі заплаціць, каб пазбегнуць працэнтаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte pro kartu s úvěrovým limitem. Na obrazovce účtu pak uvidíte, kolik a do kdy zaplatit, abyste neplatili úroky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie es für eine Karte mit Kreditlimit ein: Der Bildschirm des Kontos zeigt dann, bis wann gezahlt werden muss, um keine Zinsen zu zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on for a card with a credit limit: the screen of the account will say what to pay by when not to pay interest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívelo para una tarjeta con límite de crédito: la pantalla de la cuenta indicará hasta cuándo pagar para no pagar intereses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le pour une carte avec un plafond de crédit : l'écran du compte indiquera jusqu'à quand payer pour ne pas payer d'intérêts."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացրեք վարկային սահմանաչափով քարտի համար․ հաշվի էկրանին կերևա, թե որքան և երբ վճարել՝ տոկոսներից խուսափելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva per una carta con limite di credito: la schermata del conto indicherà quanto e quando pagare per evitare interessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用限度額のあるカードでオンにすると、利息を発生させないための支払額と期限が口座画面に表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართეთ საკრედიტო ლიმიტის მქონე ბარათისთვის: ანგარიშის ეკრანზე გამოჩნდება, რამდენი და როდის უნდა გადაიხადოთ პროცენტის თავიდან ასაცილებლად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредит лимиті бар карта үшін қосыңыз: есеп-шот экраны қашан және не төлеу керектігін, пайыз төленбеуі үшін көрсетеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신용 한도가 있는 카드에 켜세요. 이자 없이 결제하려면 언제까지 얼마를 납부해야 하는지 계좌 화면에 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттик лимити бар карта үчүн күйгүзүңүз: эсеп экранында пайыз төлөбөш үчүн канча жана качан төлөө керектиги көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel in voor een kaart met een kredietlimiet. Op het rekeningoverzicht zie je dan hoeveel je vóór welke datum moet betalen om rente te voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dla karty z limitem kredytowym. Na ekranie konta zobaczysz, ile i do kiedy zapłacić, aby uniknąć odsetek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para um cartão com limite de crédito: a tela da conta mostrará quanto e quando pagar para evitar juros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para um cartão com limite de crédito: a conta mostrará quanto e até quando pagar para evitar juros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите для карты с кредитным лимитом: экран счёта подскажет, сколько и до какого дня внести, чтобы не платить проценты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои корти дорои ҳадди кредит фаъол кунед: дар саҳифаи ҳисоб нишон дода мешавад, ки барои напардохтани фоиз чӣ қадар ва то кай пардохт кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi limitli bir kart için açın: Hesap ekranında faiz ödememek için neyi, ne zaman ödeyeceğiniz gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть для картки з кредитним лімітом: екран рахунку скаже, що і до якого дня сплатити, щоб не платити відсотків."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit limitli karta uchun yoqing: hisob ekranida foiz to‘lamaslik uchun qancha va qachongacha to‘lash ko‘rsatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果卡片有信用额度，请打开此选项。账户页面会显示还款金额和期限，帮助你避免支付利息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為有信用額度的卡片開啟此選項，帳戶畫面就會顯示免息所需的繳款金額和期限。"
          }
        }
      }
    },
