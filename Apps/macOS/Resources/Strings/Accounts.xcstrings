          }
        }
      }
    },
    "transfer.sheet.feeHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstəyə bağlıdır. Pul çıxan hesabdan «Komissiyalar» bölməsində xərc kimi qeydə alınır; köçürmə ilə birlikdə silinir və geri qaytarılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Неабавязкова. Запісваецца як выдатак у «Камісіі» з рахунку спісання; выдаляецца і адмяняецца разам з пераводам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné. Zapíše se jako výdaj do kategorie «Poplatky» z účtu, ze kterého peníze odešly. Při smazání nebo vrácení převodu se odstraní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Wird als Ausgabe in „Gebühren“ vom Konto eingetragen, von dem das Geld abging; sie wird mit der Überweisung gelöscht und rückgängig gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Written as an expense in «Fees» from the account the money left; it is deleted and undone with the transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Se anota como gasto en «Comisiones» desde la cuenta de la que salió el dinero; se elimina y se deshace junto con la transferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Noté comme dépense dans « Frais » depuis le compte d'où part l'argent ; il est supprimé et annulé avec le virement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչ պարտադիր։ Գրանցվում է որպես «Միջնորդավճարներ» ծախս՝ ելքագրման հաշվից։ Ջնջվում և հետ է շրջվում փոխանցման հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativa. Registrata come uscita in «Commissioni» dal conto di origine; viene eliminata e annullata con il trasferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。振替元の口座に「手数料」の支出として記録され、振替の削除時や取り消し時に一緒に削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არასავალდებულო. ჩაიწერება ხარჯად კატეგორიაში «საკომისიოები» იმ ანგარიშიდან, საიდანაც თანხა გავიდა; გადარიცხვასთან ერთად წაიშლება და გაუქმდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міндетті емес. Ақша кеткен есеп-шоттан «Комиссияларға» шығыс ретінде жазылады; аударыммен бірге жойылады және болдырылмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항입니다. 출금 계좌의 «수수료»에 지출로 기록되며, 이체와 함께 취소 및 삭제됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Милдеттүү эмес. Акча чыккан эсептен «Комиссиялар» бөлүмүнө чыгаша катары жазылат; которуу менен кошо өчүрүлөт жана жокко чыгарылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Wordt als uitgave in «Kosten» geboekt op de rekening waarvan het geld is afgeschreven en samen met de overboeking verwijderd en teruggedraaid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie. Zapisana jako wydatek w kategorii «Opłaty» na koncie źródłowym; usunięcie przelewu cofa ją i usuwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Registrada como despesa em «Tarifas» na conta de origem; é apagada e desfeita com a transferência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Registada como despesa em «Comissões» na conta de origem; é eliminada e revertida com a transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Запишется расходом в «Комиссии» со счёта, откуда ушли деньги; удаляется и отменяется вместе с переводом."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ихтиёрӣ. Ҳамчун хароҷот дар «Комиссияҳо» аз ҳисоби манбаъ сабт мешавад; бо интиқол нест ва бекор карда мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Paranın çıktığı hesaptan «Ücretler» kategorisine gider olarak kaydedilir; transferle birlikte silinir ve geri alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов'язково. Записується як витрата в «Комісіях» з рахунку, з якого пішли гроші; видаляється і скасовується разом із переказом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ixtiyoriy. Pul yechilgan hisobda «Komissiyalar» xarajati sifatida yoziladi; oʻtkazma bilan birga oʻchiriladi va bekor qilinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。作为转出账户的支出记入“手续费”，并随转账一同删除和撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填。會記為轉出帳戶的「手續費」支出；刪除或撤銷轉帳時會一併刪除或撤銷。"
          }
        }
      }
    },
