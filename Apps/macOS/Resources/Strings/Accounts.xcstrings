    "account.editor.bank.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account stands under this bank; in lists of choices the bank names it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta figura bajo este banco; en las listas de opciones aparece el nombre del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte est rattaché à cette banque ; dans les listes de choix, c'est elle qui le nomme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт стоит под этим банком; в списках выбора его называет банк."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок належить цьому банку; у списках вибору його називає банк."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto è associato a questa banca; negli elenchi di scelta è indicato con il nome della banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот осы банк астында тұрады; таңдау тізімдерінде банк оның атауын береді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак знаходзіцца ў гэтым банку; у спісах выбару пазначаны яго назвай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto steht unter dieser Bank; in Auswahllisten nennt die Bank es."
          }
        }
      }
    },
