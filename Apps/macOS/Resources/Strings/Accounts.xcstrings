        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Група з такой назвай ужо ёсць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupina s tímto názvem už existuje."
          }
        },
        "de": {
