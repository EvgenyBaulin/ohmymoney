    "account.credit.toPay": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz ödəməmək üçün %1$@ tarixinədək ödəyin: %2$@"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аплаціць да %1$@: %2$@, каб пазбегнуць працэнтаў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro bezúročné období zaplaťte do %1$@: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis %1$@ zahlen: %2$@, um keine Zinsen zu zahlen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay by %1$@: %2$@ not to pay interest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar antes del %1$@: %2$@ para no pagar intereses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer avant le %1$@ : %2$@ pour ne pas payer d'intérêts"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարեք մինչև %1$@՝ %2$@՝ տոկոսներից խուսափելու համար"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga entro il %1$@: %2$@ per evitare interessi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利息を発生させないために、%1$@までに%2$@を支払い"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პროცენტის თავიდან ასაცილებლად გადაიხადეთ %1$@-მდე: %2$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күніне дейін төлеңіз: %2$@ — пайыз төлемеу үшін"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이자 없이 결제하려면 %1$@까지 %2$@ 납부"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз төлөбөш үчүн %1$@ чейин төлөңүз: %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaal vóór %1$@: %2$@ om rente te voorkomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapłać do %1$@: %2$@, aby uniknąć odsetek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague até %1$@: %2$@ para evitar juros"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague até %1$@: %2$@ para evitar juros"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внести до %1$@: %2$@, чтобы не платить проценты"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То %1$@ пардохт кунед: %2$@ барои напардохтани фоиз"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz ödememek için %1$@ tarihine kadar ödeyin: %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплатити до %1$@: %2$@, щоб не платити відсотків"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Foiz to‘lamaslik uchun %1$@ gacha %2$@ to‘lang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$@前还款 %2$@，即可免付利息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 前繳付 %2$@ 即可免息"
          }
        }
      }
