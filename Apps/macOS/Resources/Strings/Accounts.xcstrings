    "accounts.banksHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank is the top of «bank → account → card». A new bank brings its first account and card; a list of choices names a bank with one account and one card by the bank alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco es el nivel superior de «banco → cuenta → tarjeta». Un banco nuevo trae su primera cuenta y tarjeta; en una lista de opciones, un banco con una cuenta y una tarjeta se nombra solo por el banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque est le sommet de « banque → compte → carte ». Une nouvelle banque apporte son premier compte et sa carte ; dans une liste de choix, une banque est désignée par son seul nom, avec un compte et une carte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк — верхний уровень «банк → счёт → карта». Новый банк приносит первый счёт и карту; в списках выбора банк с одним счётом и одной картой назван просто по имени банка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк — це верхній рівень «банк → рахунок → картка». Новий банк додає свій перший рахунок і картку; у списку вибору банк називається лише за назвою, із одним рахунком і однією карткою."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca è al vertice di «banca → conto → carta». Una nuova banca include il primo conto e la prima carta; negli elenchi di scelta, una banca con un solo conto e una sola carta è indicata solo con il nome della banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк — «банк → есеп-шот → карта» тізбегінің бастауы. Жаңа банк өзінің алғашқы есеп-шотын және картасын әкеледі; таңдау тізімінде банк бір есеп-шотпен және бір картамен тек банк атымен аталады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк — верхні ўзровень «банк → рахунак → карта». Новы банк ствараецца з першым рахункам і картай; банк з адным рахункам і адной картай пазначаны ў спісах выбару толькі назвай банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank steht ganz oben bei „Bank → Konto → Karte“. Eine neue Bank bringt ihr erstes Konto und ihre erste Karte mit; in Auswahllisten nennt eine Bank mit einem Konto und einer Karte allein den Namen der Bank."
          }
        }
      }
    },
