        }
      }
    },
    "transfer.refusal.amountsDiffer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one currency the same amount arrives as leaves; write what the bank kept as the fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una misma divisa, llega el mismo importe que sale; escriba lo que se quedó el banco como comisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans une même devise, le même montant arrive tel qu'il part ; notez ce que la banque a retenu comme frais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В одной валюте зачисляется столько же, сколько списано; то, что удержал банк, запишите комиссией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В одній валюті на іншу сторону приходить та сама сума; запишіть, що банк утримав, як комісію."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella stessa valuta, l'importo ricevuto deve essere uguale a quello inviato; inserisci ciò che la banca ha trattenuto come commissione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір валютада бірдей сома келеді де кетеді; банк ұстап қалғанын комиссия ретінде жазыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У адной валюце паступае столькі ж, колькі спісваецца; утрыманае банкам запішыце як камісію."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Währung kommt derselbe Betrag an, der abgeht; tragen Sie als Gebühr ein, was die Bank einbehalten hat."
          }
        }
      }
    },
    "transfer.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in the archive: bring it back to transfer to or from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta está en el archivo: recupérela para transferir desde ella o hacia ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte est aux archives : ramenez-le pour y virer ou en virer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт в архиве — верните его, чтобы переводить на него или с него."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок в архіві: поверніть його, щоб переказувати на нього або з нього."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto è archiviato: ripristinalo per effettuare trasferimenti da o verso di esso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот мұрағатта: оған немесе одан аудару үшін оны қайтарыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак у архіве: аднавіце яго для пераводаў з яго ці на яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto ist im Archiv: Holen Sie es zurück, um darauf oder davon zu überweisen."
          }
        }
      }
    },
    "transfer.refusal.feeMoneyBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money was already given back for this transfer's fee: its amount and currency can't change, and it can't be taken off. Delete that money back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se devolvió dinero por la comisión de esta transferencia: su importe y divisa no pueden cambiar, y no puede quitarse. Primero elimine esa devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement a déjà été fait sur les frais de ce virement : son montant et sa devise ne peuvent plus changer, et il ne peut pas être retiré. Supprimez d'abord ce remboursement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За комиссию этого перевода уже вернули деньги: её сумму и валюту не изменить, а саму комиссию не убрать. Сначала удалите этот возврат денег."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За комісію цього переказу вже повернуто гроші: її суму й валюту не можна змінити, і її не можна зняти. Спершу видаліть це повернення."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già stato restituito denaro per la commissione di questo trasferimento: non puoi modificarne l'importo o la valuta, né rimuoverla. Elimina prima la restituzione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл аударымның комиссиясына ақша қайтарылған: оның сомасы мен валютасы өзгере алмайды, және ол алынып тасталмайды. Алдымен сол қайтарылған ақшаны жойыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За камісію гэтага пераводу ўжо вярнулі грошы: нельга змяняць суму, валюту ці прыбіраць яе. Спачатку выдаліце вяртанне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Gebühr dieser Überweisung wurde bereits Geld zurückgegeben: Betrag und Währung lassen sich nicht ändern, und sie kann nicht entfernt werden. Löschen Sie zuerst diese Rückzahlung."
          }
        }
      }
    },
    "transfer.refusal.feeRefunded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund was recorded against this transfer's fee: the fee can't be taken off, made smaller than what was refunded or moved to another currency, and the transfer can't be deleted with it. Delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una devolución registrada sobre la comisión de esta transferencia: la comisión no puede quitarse, reducirse por debajo de lo devuelto ni pasar a otra divisa, y la transferencia no puede eliminarse con ella. Elimine antes la devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement a été noté sur les frais de ce virement : les frais ne peuvent pas être retirés, ramenés sous le montant remboursé ni passés dans une autre devise, et le virement ne peut pas être supprimé avec eux. Supprimez d'abord le remboursement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На комиссию этого перевода оформлен возврат: её нельзя убрать, сделать меньше возвращённого или перевести в другую валюту, а перевод — удалить вместе с ней. Сначала удалите возврат."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За комісію цього переказу записано повернення: її не можна зняти, зменшити нижче повернутої суми чи перенести в іншу валюту, і переказ разом із нею не видаляється. Спершу видаліть повернення."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già stato registrato un rimborso per la commissione di questo trasferimento: non puoi rimuoverla, ridurla sotto l'importo rimborsato o cambiarne la valuta, né eliminare il trasferimento. Elimina prima il rimborso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл аударымның комиссиясына қайтару жазылған: комиссияны алып тастауға, қайтарылғаннан кіші етуге немесе басқа валютаға көшіруге болмайды, және аударымды онымен бірге жою мүмкін емес. Алдымен қайтаруды жойыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На камісію гэтага пераводу запісана вяртанне: нельга прыбіраць камісію, памяншаць ніжэй за вернутае, змяняць валюту ці выдаляць перавод разам з ёй. Спачатку выдаліце вяртанне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Gebühr dieser Überweisung ist eine Erstattung erfasst: Die Gebühr lässt sich nicht entfernen, nicht kleiner machen als die Erstattung oder in eine andere Währung verschieben, und die Überweisung lässt sich mit ihr nicht löschen. Löschen Sie zuerst die Erstattung."
          }
        }
      }
    },
    "transfer.refusal.fromCurrency": {
      "extractionState": "manual",
      "localizations": {
