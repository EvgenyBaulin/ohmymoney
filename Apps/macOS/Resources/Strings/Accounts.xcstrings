          "stringUnit": {
            "state": "translated",
            "value": "È previsto l’accredito di %1$@ di interessi per %2$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ үшін %1$@ пайыз төленуі тиіс"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ үчүн %1$@ пайыз төлөнүшү керек"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas na odsetki %1$@ za %2$@"
          }
        },
        "pt-BR": {
