    "account.screen.cashbackApproximate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прыблізны даход: ≈ %1$@, з яго па правілах і без пацвярджэння — %2$@. Няма чаго пацвярджаць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefähre Einnahmen: ≈ %1$@, davon nach den Regeln und unbestätigt — %2$@. Nichts zu bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate income: ≈ %1$@, of it by the rules and unconfirmed — %2$@. Nothing to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingreso aproximado: ≈ %1$@, de ello por reglas y sin confirmar — %2$@. Nada que confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenu approximatif : ≈ %1$@, dont selon les règles et non confirmé — %2$@. Rien à confirmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrate stimate: ≈ %1$@, di cui calcolate secondo le regole e non confermate: %2$@. Nulla da confermare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шамамен табыс: ≈ %1$@, оның ережелер бойынша және расталмаған бөлігі — %2$@. Растайтын ештеңе жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Болжолдуу киреше: ≈ %1$@, анын ичинде эрежелер боюнча эсептелген жана ырастала элек — %2$@. Ырастай турган эч нерсе жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacowany przychód: ≈ %1$@, w tym naliczony według zasad i niepotwierdzony — %2$@. Nie ma nic do potwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receita aproximada: ≈ %1$@, sendo %2$@ calculados pelas regras e não confirmados. Nada a confirmar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерный доход: ≈ %1$@, из них по правилам, без подтверждения, — %2$@. Подтверждать не нужно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади тахминӣ: ≈ %1$@, аз он тибқи қоидаҳо ва тасдиқнашуда — %2$@. Чизе барои тасдиқ нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık gelir: ≈ %1$@; bunun %2$@ kadarı kurallara göre hesaplandı ve onaylanmadı. Onaylanacak bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орієнтовний дохід: ≈ %1$@, з них за правилами й не підтверджено — %2$@. Нічого підтверджувати не потрібно."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxminiy daromad: ≈ %1$@, shundan qoidalar bo‘yicha hisoblangan va tasdiqlanmagani — %2$@. Tasdiqlash uchun hech narsa yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預估收入：約 %1$@，其中依規則計算且尚未確認的金額為 %2$@。沒有需要確認的項目。"
          }
        }
      }
    },
