    "bank.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every account of “%1$@”, archived ones too, moves under “%2$@”, and “%1$@” is deleted. “%2$@” keeps its name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cuenta de «%1$@», también las archivadas, pasa a estar bajo «%2$@», y «%1$@» se elimina. «%2$@» conserva su nombre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все счета банка «%1$@», и архивные тоже, перейдут в банк «%2$@», а банк «%1$@» будет удалён. Название «%2$@» останется прежним."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рахунок «%1$@», в тому числі архівні, переходить під «%2$@», а «%1$@» видаляється. «%2$@» зберігає свою назву."
          }
        }
      }
    },
    "bank.merge.money": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No money moves and every account keeps its name and its balance. Accounts of one bank can then be merged with each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se mueve dinero y cada cuenta conserva su nombre y su saldo. Después se pueden fusionar entre sí las cuentas de un mismo banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги никуда не переходят, у каждого счёта остаются его название и остаток. После этого счета одного банка можно объединять между собой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші не рухаються, і кожен рахунок зберігає свою назву та залишок. Рахунки одного банку потім можна зливати між собою."
          }
        }
      }
    },
    "bank.merge.noAccounts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank has no accounts: it is only deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco no tiene cuentas: solo se elimina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В банке нет счетов: он будет просто удалён."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У банку немає рахунків: його лише видаляють."
          }
        }
      }
    },
    "bank.merge.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank in the archive is not merged: bring it back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banco del archivo no se fusiona: recupérelo antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк в архиве не объединяется: сначала верните его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк в архіві не зливається: спершу поверніть його."
          }
        }
      }
    },
    "bank.merge.title": {
