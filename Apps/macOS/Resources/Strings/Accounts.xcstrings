    "cashback.sheet.cardHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartda yalnız hesabdan fərqlənən qaydalar saxlanılır; qalanları hesabdan götürülür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта захоўвае толькі адрозненні ад рахунку; астатняе бярэ з яго правілаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta si uchovává jen odlišnosti od účtu. Ostatní přebírá z pravidel účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte behält nur, was sich von ihrem Konto unterscheidet; das Übrige übernimmt sie von den Regeln des Kontos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card keeps only what differs from its account; the rest it takes from the account’s rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta guarda solo lo que se diferencia de su cuenta; lo demás lo toma de las reglas de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte ne garde que ce qui diffère de son compte ; le reste vient des règles du compte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քարտի համար պահվում են միայն հաշվից տարբերվող կանոնները, իսկ մնացածը վերցվում է հաշվից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La carta conserva solo le regole diverse da quelle del conto; per il resto usa le regole del conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードには口座と異なるルールだけが保存され、残りは口座のルールが適用されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარათზე მხოლოდ ანგარიშისგან განსხვავებული წესები ინახება; დანარჩენზე ანგარიშის წესები ვრცელდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта тек есеп-шоттан өзгеше бөлігін сақтайды; қалғанын есеп-шоттың ережелерінен алады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드에는 계좌와 다른 규칙만 저장됩니다. 나머지는 계좌 규칙을 따릅니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Картада эсептин эрежелеринен айырмалангандары гана сакталат; калгандары эсептен алынат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kaart bewaart alleen wat afwijkt van de rekening. Voor de rest gelden de regels van de rekening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta przechowuje tylko różnice względem konta; pozostałe zasady przyjmuje z konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão mantém apenas o que difere da conta; o restante segue as regras da conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão guarda apenas o que difere da conta; o resto segue as regras da conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта держит только то, чем отличается от счёта; остальное берёт из правил счёта."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои корт танҳо фарқиятҳо аз ҳисоб нигоҳ дошта мешаванд; боқимонда аз қоидаҳои ҳисоб гирифта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartta yalnızca hesabından farklı kurallar saklanır; diğerleri hesaptan alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка зберігає лише те, чим відрізняється від свого рахунку; решту бере з правил рахунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartada faqat hisob qoidalaridan farq qiladigan qoidalar saqlanadi; qolganlari hisobdan olinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片只保存与账户不同的规则，其余沿用账户规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片只保留與帳戶不同的規則，其餘沿用帳戶規則。"
          }
        }
      }
    },
