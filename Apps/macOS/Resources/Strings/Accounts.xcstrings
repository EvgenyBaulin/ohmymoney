          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Шарттардагы сумма окулган жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać kwoty w warunkach"
          }
        },
        "pt-BR": {
