    "accounts.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada hace referencia a ella. ⌘Z la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'y réfère. ⌘Z le rétablit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На него ничто не ссылается. ⌘Z вернёт его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо на нього не посилається. ⌘Z поверне його."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento vi fa riferimento. Premi ⌘Z per ripristinarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған ештеңе сілтемейді. ⌘Z қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нішто на яго не спасылаецца. ⌘Z адновіць яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist darauf. ⌘Z holt es zurück."
          }
        }
      }
    },
    "accounts.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it. “Undo” brings it back."
