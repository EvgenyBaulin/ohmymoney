    "card.refusal.inUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations or payments name this card — it can only be archived."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Operaciones o pagos citan esta tarjeta: solo puede archivarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des opérations ou paiements portent ce nom de carte — elle ne peut qu'être archivée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По карте есть операции или платежи — её можно только убрать в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції або платежі називають цю картку — її можна лише перенести в архів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La carta è associata a operazioni o pagamenti: puoi solo archiviarla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар немесе төлемдер бұл картаны көрсетеді — оны тек мұрағатқа өткізуге болады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта пазначана ў аперацыях ці плацяжах — яе можна толькі архіваваць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge oder Zahlungen nennen diese Karte — sie kann nur archiviert werden."
          }
        }
      }
    },
    "card.refusal.lastCardOfCreditCard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the only card of a credit card, and a credit card is never left without one. Add another card first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la única tarjeta de una tarjeta de crédito, y una tarjeta de crédito nunca se queda sin ninguna. Añada antes otra tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la seule carte d'une carte de crédit, et une carte de crédit n'est jamais sans carte. Ajoutez d'abord une autre carte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это единственная карта кредитной карты, а без карты она не остаётся. Сначала добавьте другую карту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це єдина картка кредитного рахунку, а кредитний рахунок ніколи не лишається без картки. Спершу додайте ще одну картку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è l’unica carta associata alla carta di credito, che deve averne sempre almeno una. Aggiungine prima un’altra."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кредиттік картаның жалғыз картасы, ал кредиттік картада карта болмай қалмайды. Алдымен басқа карта қосыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта адзіная карта крэдытнага рахунку, які не можа застацца без карты. Спачатку дадайце іншую."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die einzige Karte einer Kreditkarte, und eine Kreditkarte bleibt nie ohne Karte. Fügen Sie zuerst eine andere Karte hinzu."
          }
        }
      }
    },
