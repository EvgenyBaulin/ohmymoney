    "card.editor.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money and balance belong to the account; a card says what paid, and follows the account’s cashback rules unless it keeps some of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero y el saldo pertenecen a la cuenta; la tarjeta indica con qué se paga y sigue las reglas de cashback de la cuenta, salvo que tenga algunas propias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent et le solde appartiennent au compte ; une carte indique ce qui a été payé, et suit les règles de cashback du compte, sauf si elle en garde quelques-unes à elle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги и остаток — у счёта; карта говорит, чем заплатили, и берёт правила кэшбэка у счёта, если не держит своих."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші й залишок належать рахунку; картка показує, чим сплачено, і йде за правилами кешбеку рахунку, якщо не має власних."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro e il saldo appartengono al conto. La carta indica come hai pagato e segue le regole cashback del conto, a meno che non abbia regole proprie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша мен теңгерім есеп-шотқа тиесілі; карта не төлегенін білдіреді және өз ережелерін сақтамаса, есеп-шоттың кешбэк ережелерін ұстанады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы і баланс належаць рахунку; карта паказвае, чым плацілі, і выкарыстоўвае правілы кэшбэку рахунку, калі не мае ўласных."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld und Saldo gehören zum Konto; eine Karte sagt, womit bezahlt wurde, und folgt den Cashback-Regeln des Kontos, sofern sie nicht einige eigene behält."
          }
        }
      }
    },
