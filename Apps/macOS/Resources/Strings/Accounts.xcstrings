    "card.refusal.accountArchived": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesab arxivdədir — əvvəlcə onu bərpa edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак у архіве — спачатку аднавіце яго."
