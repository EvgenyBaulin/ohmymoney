    "account.screen.cashbackLate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк за пакупкі %1$@ не паступіў: чакалася ≈ %2$@, тэрмін да %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback für die Käufe vom %1$@ ist nicht eingegangen: erwartet ≈ %2$@, fällig bis %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback for the purchases %1$@ has not come: expected ≈ %2$@, due by %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cashback de las compras %1$@ no ha llegado: previsto ≈ %2$@, vence el %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback des achats %1$@ n'est pas arrivé : attendu ≈ %2$@, dû avant le %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cashback per gli acquisti %1$@ non è arrivato: previsto ≈ %2$@ entro il %3$@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сатып алулар үшін кешбэк келмеді: күтілуде ≈ %2$@, мерзімі — %3$@."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сатып алуулары үчүн кэшбэк түшкөн жок: күтүлгөнү ≈ %2$@, түшүү мөөнөтү %3$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback za zakupy %1$@ nie dotarł: oczekiwano ≈ %2$@ do %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback das compras %1$@ não chegou: previsto ≈ %2$@, até %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк за покупки %1$@ не пришёл: ждали ≈ %2$@, срок был %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ alışverişlerinin para iadesi gelmedi: beklenen ≈ %2$@, son ödeme tarihi %3$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешбек за покупки %1$@ не надійшов: очікувався ≈ %2$@, мав прийти до %3$@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ xaridlari uchun keshbek kelmadi: kutilgan ≈ %2$@, to‘lov muddati %3$@ gacha edi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的消費回饋尚未入帳：預計約 %2$@，應於 %3$@ 前入帳。"
          }
        }
      }
    },
    "account.screen.cashbackNone": {
