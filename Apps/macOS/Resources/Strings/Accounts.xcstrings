    "account.credit.recordHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradakı məbləğ təxminidir: çıxarışdakı məbləği daxil edin. O, bu çıxarışın təxmini faizini əvəz edəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума тут прыблізная: увядзіце суму з выпіскі. Яна заменіць разлік гэтай выпіскі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvedená částka je odhad. Zadejte částku z výpisu; nahradí odhad pro tento výpis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Summe hier ist eine Schätzung: Tragen Sie ein, was die Abrechnung sagt. Sie ersetzt die Schätzung dieser Abrechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sum here is an estimate: enter what the statement says. It replaces the estimate of this statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suma aquí es una estimación: escriba lo que dice el extracto. Sustituye la estimación de este extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La somme ici est une estimation : saisissez ce qu'indique le relevé. Elle remplace l'estimation de ce relevé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այստեղ նշված գումարը մոտավոր է․ մուտքագրեք քաղվածքի գումարը։ Այն կփոխարինի այս քաղվածքի մոտավոր արժեքին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo importo è una stima: inserisci quello indicato nell’estratto conto. Sostituirà la stima per questo estratto conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示額は見込みです。明細の金額を入力してください。この明細の見込み額が置き換えられます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქ მითითებული თანხა სავარაუდოა: შეიყვანეთ ამონაწერში მითითებული თანხა. ის ამ ამონაწერის სავარაუდო თანხას ჩაანაცვლებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда көрсетілген сома — болжам: үзіндіде не жазылғанын енгізіңіз. Ол осы үзіндінің болжамын ауыстырады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 표시된 금액은 예상 금액입니다. 명세서의 금액을 입력하세요. 이 명세서의 예상 금액이 대체됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сумма болжолдуу: көчүрмөдө көрсөтүлгөн сумманы киргизиңиз. Ал ушул көчүрмөнүн болжолдуу суммасын алмаштырат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bedrag is een schatting. Vul het bedrag van het afschrift in. Dit vervangt de schatting voor dit afschrift."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kwota jest szacunkowa. Wpisz kwotę z wyciągu, aby zastąpić nią szacunkowe odsetki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este valor é uma estimativa: digite o valor da fatura. Ele substitui a estimativa desta fatura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este valor é uma estimativa: introduza o valor do extrato. Substitui a estimativa deste extrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь сумма — оценка: впишите ту, что в выписке. Она заменит оценку этой выписки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ин ҷо тахминӣ аст: маблағи суратҳисобро ворид кунед. Он ҷойи маблағи тахминии ин суратҳисобро мегирад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki tutar tahminidir: Ekstredeki tutarı girin. Bu, söz konusu ekstrenin tahmini tutarının yerini alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут сума є оцінкою: введіть те, що написано у виписці. Вона замінить оцінку цієї виписки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu summa taxminiy: ko‘chirmadagi summani kiriting. U shu ko‘chirma uchun taxminiy summani almashtiradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处金额为估算值，请输入账单上的金额。输入后将替代此账单的估算值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處金額為預估值，請輸入帳單上的金額，取代此帳單的預估值。"
          }
        }
      }
    },
