            "value": "Группа с таким названием уже есть."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гурӯҳ бо ин ном аллакай вуҷуд дорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ada sahip bir grup zaten var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Група із такою назвою вже є."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunday nomli guruh allaqachon mavjud."
          }
