    "accounts.delete.messageMoney": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ balansı bütün yekunlardan çıxarılacaq. Hesaba heç nə bağlı deyil. ⌘Z ilə bərpa etmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс %@ знікне з усіх вынікаў разам з рахункам. Нішто на рахунак не спасылаецца. ⌘Z адновіць яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek %@ se s účtem odečte ze všech součtů. Na účet nic neodkazuje. Zkratkou ⌘Z ho obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo %@ verschwindet mit ihm aus allen Summen. Nichts verweist auf das Konto. ⌘Z holt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance %@ leaves every total with it. Nothing refers to the account. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo %@ sale de todos los totales con ella. Nada hace referencia a la cuenta. ⌘Z la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde %@ sort de tous les totaux avec lui. Rien ne s'y réfère. ⌘Z le rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ մնացորդը նույնպես կհանվի բոլոր հանրագումարներից։ Հաշիվն այլ տեղ չի օգտագործվում։ ⌘Z-ը կվերականգնի այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo %@ verrà rimosso da tutti i totali. Nessun elemento fa riferimento al conto. Premi ⌘Z per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高%@はすべての合計から除外されます。この口座を参照している項目はありません。⌘Zで元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბალანსი %@ ყველა ჯამიდან ამოიღება. ანგარიშს არაფერი უკავშირდება. ⌘Z აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімі оның бірге барлық жиынтықтан шығады. Есеп-шотқа ештеңе сілтемейді. ⌘Z қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액 %@도 모든 합계에서 제외됩니다. 이 계좌를 참조하는 항목이 없습니다. ⌘Z로 복원할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ калдыгы аны менен кошо бардык жыйынтыктардан чыгарылат. Эсепке эч нерсе байланышкан эмес. ⌘Z аны калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo %@ verdwijnt ook uit alle totalen. Er wordt nergens naar de rekening verwezen. Met ⌘Z zet je deze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo %@ zostanie usunięte ze wszystkich sum. Nic nie odwołuje się do konta. ⌘Z przywróci je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de %@ será removido de todos os totais. Nada faz referência à conta. ⌘Z a restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo %@ será removido de todos os totais. Nada faz referência à conta. Prima ⌘Z para a recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток %@ пропадёт из итогов. На счёт ничто не ссылается. ⌘Z вернёт его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи %@ ҳамроҳи ҳисоб аз ҳамаи ҷамъҳо хориҷ мешавад. Ҳеҷ чиз ба ҳисоб ишора намекунад. ⌘Z онро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyesi tüm toplamlarından çıkarılır. Hesaba bağlı bir öğe yok. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок %@ разом із ним зникає з усіх підсумків. Ніщо на рахунок не посилається. ⌘Z поверне його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qoldiq barcha jami summalardan chiqariladi. Hisobga hech narsa bog‘lanmagan. ⌘Z uni qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额 %@ 将从所有总额中移除。没有项目引用此账户。按 ⌘Z 可将其恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額 %@ 也會從所有總計中移除。沒有項目參照此帳戶。按下 ⌘Z 可還原。"
          }
        }
      }
    },
