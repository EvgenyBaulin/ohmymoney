    "sidebar.totalHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yekuna daxil olan hesablardakı vəsait, bugünkü məzənnə ilə rublla."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на рахунках у зводцы, у рублях па сённяшніх курсах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze na účtech v souhrnu, přepočtené na rubly podle dnešních kurzů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld auf den Konten in der Übersicht, in Rubel zu den heutigen Kursen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money on the accounts in the summary, in rubles at today's rates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de las cuentas del resumen, en rublos a los tipos de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent des comptes du récapitulatif, en roubles au cours du jour."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփագրում ներառված հաշիվների գումարը՝ ռուբլով, այսօրվա փոխարժեքներով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo dei conti inclusi nel riepilogo, in rubli ai tassi di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集計対象の口座の残高を、今日のレートでルーブルに換算した金額です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯამებაში ჩართულ ანგარიშებზე არსებული თანხა, რუბლებში, დღევანდელი კურსით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы есеп-шоттардағы ақша, бүгінгі бағам бойынша рубльмен."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요약에 포함된 계좌의 금액을 오늘의 환율로 환산한 루블 합계입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалпы эсепке кирген эсептердеги акча, бүгүнкү курс боюнча рубль менен."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geld op de rekeningen in het overzicht, in roebels tegen de koersen van vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środki na kontach uwzględnionych w podsumowaniu, w rublach według dzisiejszych kursów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro das contas incluídas no resumo, em rublos, pelas cotações de hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro nas contas incluídas no resumo, em rublos às taxas de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги на счетах в сводке, в рублях по сегодняшнему курсу."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ҳисобҳои ҷамъбаст бо рубл, аз рӯйи қурби имрӯза."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özete dahil hesapların bugünkü kurlarla ruble cinsinden toplamı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші на рахунках, що входять до підсумку, у рублях за сьогоднішнім курсом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumiy hisobga kiritilgan hisoblardagi mablag‘, bugungi kurs bo‘yicha rublda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计入汇总的账户资金，按今日汇率折算为卢布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要中各帳戶的資金，按今日匯率換算為盧布。"
          }
        }
      }
    },
