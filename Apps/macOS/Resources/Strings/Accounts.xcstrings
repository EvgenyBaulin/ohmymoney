    "account.editor.otherNamesHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daxiletmə sətri hesabı bu adların hər biri ilə tanıyır. Məsələn: Т-Банк — тинькофф, тинек."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Радок уводу пазнае рахунак па любой з іх. Напрыклад: Т-Банк — тинькофф, тинек."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při zadávání lze účet označit kterýmkoli z nich. Například: Т-Банк — тинькофф, тинек."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingabezeile erkennt das Konto an jedem dieser Namen. Zum Beispiel: Т-Банк — тинькофф, тинек."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entry line knows the account by any of them. For example: Т-Банк — тинькофф, тинек."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea de entrada reconoce la cuenta por cualquiera de ellos. Por ejemplo: Т-Банк — тинькофф, тинек."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne de saisie reconnaît le compte par l'un d'eux. Par exemple : Т-Банк — тинькофф, тинек."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրման տողը ճանաչում է հաշիվն այս անուններից յուրաքանչյուրով։ Օրինակ՝ Т-Банк — тинькофф, тинек։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi usare uno qualsiasi di questi nomi nella riga di inserimento. Ad esempio: Т-Банк — тинькофф, тинек."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄ではどの名前でも口座を指定できます。例：Т-Банк — тинькофф、тинек。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეყვანის ველი ანგარიშს ნებისმიერი ამ სახელით ამოიცნობს. მაგალითად: Т-Банк — тинькофф, тинек."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енгізу жолы есеп-шотты кез келген атымен таниды. Мысалы: Т-Банк — тинькофф, тинек."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력란에서 이 이름들로 계좌를 찾을 수 있습니다. 예: Т-Банк — тинькофф, тинек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Киргизүү сабы эсепти ушул аттардын баары менен тааныйт. Мисалы: Т-Банк — тинькофф, тинек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de rekening met elk van deze namen invoeren. Bijvoorbeeld: Т-Банк — тинькофф, тинек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W polu wpisywania możesz użyć dowolnej z tych nazw. Na przykład: Т-Банк — тинькофф, тинек."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode usar qualquer um deles na linha de entrada. Por exemplo: Т-Банк — тинькофф, тинек."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode usar qualquer um destes nomes ao introduzir uma operação. Por exemplo: Т-Банк — тинькофф, тинек."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка ввода узнаёт счёт по любому из них. Например: Т-Банк — тинькофф, тинек."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар сатри воридкунӣ ҳисоб бо ҳар яке аз ин номҳо шинохта мешавад. Масалан: Т-Банк — тинькофф, тинек."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş satırı hesabı bu adların herhangi biriyle tanır. Örneğin: Т-Банк — тинькофф, тинек."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок введення знає рахунок за будь-якою з них. Наприклад: Т-Банк — тинькофф, тинек."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiritish qatorida hisobni shu nomlarning istalgani bilan topish mumkin. Masalan: Т-Банк — тинькофф, тинек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录入时可使用任一名称识别账户。例如：Т-Банк — тинькофф, тинек。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入交易時，可用這些名稱識別帳戶。例如：Т-Банк — тинькофф、тинек。"
          }
        }
      }
    },
    "account.editor.piggy": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Скарбонка — тут адкладваюцца грошы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spardose – hier wird Geld zurückgelegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Piggy bank — money is put aside here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hucha: dinero apartado aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirelire — argent mis de côté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvadanaio — qui metti da parte i soldi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жинақ сандығы — мұнда ақша жиналады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skarbonka — miejsce na oszczędności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofrinho — guarde dinheiro aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копилка: сюда откладывают деньги"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumbara — burada para biriktirilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скарбничка — сюди відкладаються гроші"
          }
        }
      }
    },
    "account.editor.piggyHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пераводы ў скарбонку, у тым ліку акругленні, лічацца адкладзенымі за гэты месяц."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überweisungen in eine Spardose, einschließlich Aufrundungen, zählen als diesen Monat zurückgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers to a piggy bank, round-ups included, count as put aside this month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias a una hucha, incluidos los redondeos, cuentan como dinero apartado este mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les virements vers une tirelire, arrondis compris, comptent comme argent mis de côté ce mois-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trasferimenti al salvadanaio, inclusi gli arrotondamenti, contano come risparmi del mese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жинақ сандығына аударымдар, соның ішінде дөңгелектеу, осы айдағы жинаққа саналады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelewy do skarbonki, w tym zaokrąglenia, są liczone jako oszczędności w tym miesiącu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências para o cofrinho, incluindo arredondamentos, contam como dinheiro guardado no mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы в копилку, в том числе округление, считаются отложенными за месяц."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuvarlamalar dahil kumbaraya yapılan transferler, bu ay biriktirilen tutara eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекази до скарбнички, зокрема округлення, зараховуються до відкладеного за цей місяць."
          }
        }
      }
    },
