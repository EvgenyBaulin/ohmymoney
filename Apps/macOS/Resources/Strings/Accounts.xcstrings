    "bank.merge.undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z brings the bank back as it was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z devuelve el banco tal como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ramène la banque telle qu'elle était."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z вернёт банк как был."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z поверне банк таким, яким він був."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ripristina la banca com’era."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z банкті бұрынғыдай қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z адновіць банк у ранейшым стане."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z holt die Bank so zurück, wie sie war."
          }
        }
      }
    },
