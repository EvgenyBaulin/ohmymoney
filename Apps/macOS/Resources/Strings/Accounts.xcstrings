            "value": "Закрывается"
          }
        }
      }
    },
    "account.interest.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen werden aus dem Saldo jedes Tages berechnet und als Schätzung mit „≈“ angezeigt; zur Einnahme werden sie erst, wenn Sie sie erfassen. Eine Einlage, von der Sie nichts ausgeben, kann in eine Gruppe außerhalb der Übersicht gelegt werden — dann zählt sie nicht in „Frei verfügbar“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest is worked out on the balance of each day and shown as an estimate, with «≈»; it is income only once you record it. A deposit you do not spend from can go into a group kept out of the summary — then it does not count in «Free to spend»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз әр күннің теңгерімі бойынша есептеледі және «≈» белгісімен болжам ретінде көрсетіледі; оны жазғаннан кейін ғана табыс болады. Ақшасын жұмсамайтын салым шығарылған топқа салынуы мүмкін — сонда ол «Бос қаржыға» есептелмейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты считаются на остаток каждого дня и показываются оценкой, с «≈»; доходом они становятся, только когда вы их запишете. Вклад, с которого вы не тратите, можно положить в группу «не в сводке» — тогда он не войдёт в «Можно тратить»."
          }
        }
      }
    },
    "account.interest.isDeposit": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festgeld: hat ein Ende"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deposit: it has an end"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
