    "account.credit.refusal.days": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колькасць дзён льготнага перыяду па-за дапушчальным дыяпазонам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tage der zinsfreien Frist liegen außerhalb des zulässigen Bereichs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The days of the grace period are out of range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días del periodo de gracia están fuera de rango."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours de la période de grâce sont hors limites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni del periodo senza interessi non rientrano nell’intervallo consentito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейінге қалдыру күндері рұқсат етілген ауқымнан тыс."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жеңилдетилген мөөнөттүн күндөрү уруксат берилген чектен тышкары."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba dni okresu bezodsetkowego jest poza zakresem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número de dias do período sem juros está fora do intervalo permitido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни льготного периода вне допустимых значений."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шумораи рӯзҳои давраи имтиёзнок берун аз ҳудуди иҷозатдодашуда аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faizsiz dönem gün sayısı geçerli aralığın dışında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Днів пільгового періоду поза допустимим діапазоном."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Imtiyozli davr kunlari ruxsat etilgan oraliqdan tashqarida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免息期天數超出範圍。"
          }
        }
      }
    },
    "account.credit.refusal.fee": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Незразумелая камісія: працэнт да 100 і сума не меншая за нуль."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gebühr ist nicht lesbar: ein Prozentsatz bis 100 und ein Betrag nicht unter null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee does not read: a percent up to 100 and an amount not below zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión no es válida: un porcentaje de hasta 100 y una cantidad no menor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais ne sont pas lisibles : un pourcentage jusqu'à 100 et un montant non négatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Commissione non valida: inserisci una percentuale fino a 100 e un importo non inferiore a zero."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия оқылмады: пайыз — 100-ге дейін, сома — нөлден кем емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссияны текшериңиз: пайыз 100дөн ашпашы, сумма нөлдөн кем болбошу керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowa opłata. Procent nie może przekraczać 100, a kwota nie może być ujemna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarifa inválida: use uma porcentagem de até 100 e um valor igual ou maior que zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия не читается: процент до 100 и сумма не меньше нуля."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия нодуруст аст: фоиз то 100 ва маблағ на камтар аз сифр бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücret okunamıyor: Yüzde 100'ü aşmamalı ve tutar sıfırdan küçük olmamalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісію не вдалося прочитати: відсоток до 100 і сума не менше нуля."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya noto‘g‘ri: foiz 100 dan oshmasligi, summa esa noldan kam bo‘lmasligi kerak."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手續費無效：百分比不得超過 100，金額不得低於零。"
          }
        }
      }
    },
    "account.credit.refusal.inTheBin": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнты гэтай выпіскі ў сметніцы — аднавіце іх адтуль."
