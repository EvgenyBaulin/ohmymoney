    "account.credit.feeFixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus a fixed fee"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плюс фиксированная сумма"
          }
        }
