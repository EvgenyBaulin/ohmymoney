          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nome está no arquivo: restaure o elemento existente em vez de criar outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое название есть в архиве: верните его, а не заводите второе."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ном дар бойгонӣ аст: онро барқарор кунед, на ин ки дуюмӣ созед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad arşivde. Yeni bir tane oluşturmak yerine arşivdekini geri yükleyin."
