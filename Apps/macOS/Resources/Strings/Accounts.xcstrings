    "bank.card.rebind.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No payments or subscriptions are paid with this card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta tarjeta no se paga ningún pago ni suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun paiement ni abonnement n'est réglé avec cette carte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этой карты не платятся ни платежи, ни подписки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
