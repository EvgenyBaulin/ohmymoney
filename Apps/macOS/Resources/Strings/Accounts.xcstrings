    "account.editor.currenciesHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first currency is the main one: an operation in a currency the account does not hold is charged in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera divisa es la principal: una operación en una divisa que la cuenta no tiene se cobra en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première devise est la principale : une opération dans une devise que le compte ne détient pas est débitée dans celle-ci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая валюта — основная: операция в валюте, которой у счёта нет, списывается в ней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перша валюта — основна: операція у валюті, якої немає на рахунку, списується в ній."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima valuta è quella principale: le operazioni in una valuta non presente nel conto vengono addebitate in questa valuta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірінші валюта — негізгі: есеп-шотта жоқ валютамен жасалған операция соның бойынша есептеледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Першая валюта — асноўная: аперацыі ў валютах, якіх няма на рахунку, спісваюцца ў ёй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Währung ist die Hauptwährung: Ein Vorgang in einer Währung, die das Konto nicht führt, wird in dieser Währung belastet."
          }
        }
      }
    },
