    "card.editor.otherNamesHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entry line knows the card by any of these names and puts it on its account: “coffee 300 virtual”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea de entrada reconoce la tarjeta por cualquiera de estos nombres y la asigna a su cuenta: «café 300 virtual»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne de saisie reconnaît la carte par l'un de ces noms et la rattache à son compte : « café 300 virtuelle »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка ввода узнаёт карту по любому из названий и ставит её счёт: «кофе 300 виртуалка»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок введення знає картку за будь-якою з цих назв і записує її на її рахунок: «кава 300 віртуальна»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga di inserimento riconosce la carta con uno qualsiasi di questi nomi e la associa al suo conto: “caffè 300 virtuale”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енгізу жолы картаны осы атаулардың кез келгенімен таниды және оны есеп-шотына қояды: «кофе 300 виртуал»."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Радок уводу пазнае карту па любой назве і выбірае яе рахунак: “кава 300 віртуальная”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingabezeile erkennt die Karte an jedem dieser Namen und ordnet sie ihrem Konto zu: „Kaffee 300 virtuell“."
          }
        }
      }
    },
