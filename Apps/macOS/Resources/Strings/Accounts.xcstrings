    "account.credit.cashNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash or transfer on %1$@: %2$@ — interest runs at once"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectivo o transferencia el %1$@: %2$@ — los intereses corren de inmediato"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrait ou virement le %1$@ : %2$@ — les intérêts courent tout de suite"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие или перевод %1$@: %2$@ — проценты пойдут сразу"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готівка або переказ за %1$@: %2$@ — відсотки нараховуються одразу"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contanti o bonifico il %1$@: %2$@ — gli interessi decorrono subito"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күні қолма-қол ақша немесе аударым: %2$@ — пайыз бірден есептеледі"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Наяўныя ці перавод %1$@: %2$@ — працэнты налічваюцца адразу"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargeld oder Überweisung am %1$@: %2$@ — Zinsen laufen sofort"
          }
        }
      }
    },
    "account.credit.cashRate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate on cash and transfers, % a year"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo para efectivo y transferencias, % anual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux sur les retraits et virements, % par an"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка на снятие и переводы, % годовых"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка на готівку та перекази, % на рік"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasso su contanti e bonifici, % annuo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолма-қол ақша мен аударымдағы мөлшерлеме, жылына %"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стаўка на наяўныя і пераводы, % гадавых"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinssatz auf Bargeld und Überweisungen, % pro Jahr"
          }
        }
      }
    },
    "account.credit.cashWithoutGrace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash and transfers have no grace period"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectivo y transferencias no tienen periodo de gracia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les retraits et virements n'ont pas de période de grâce"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие и переводы без льготного периода"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На готівку й перекази пільгового періоду немає"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
