    "account.mainCard.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакупка з рахунку аплачваецца гэтай картай, калі ва ўводзе не пазначана іншая карта ці «з рахунку»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf auf dem Konto wird mit dieser Karte getätigt, sofern der Eintrag keine andere Karte nennt oder „von Konto“ sagt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A purchase on the account is made with this card unless the entry names another card or says «from account»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra de la cuenta se hace con esta tarjeta, salvo que el apunte indique otra tarjeta o diga «desde la cuenta»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un achat sur le compte se fait avec cette carte, sauf si la saisie nomme une autre carte ou indique « depuis le compte »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti sul conto vengono effettuati con questa carta, a meno che la voce non indichi un’altra carta o «dal conto»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттан жасалған сатып алу осы картамен жасалады, енгізуде басқа карта аталмаса немесе «есеп-шоттан» делінбесе."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазууда башка карта же «эсептен» деп көрсөтүлбөсө, сатып алуу ушул карта менен жүргүзүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakupy z tego konta są przypisywane do tej karty, chyba że wpis wskazuje inną kartę lub zawiera «z konta»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras da conta são feitas com este cartão, a menos que o lançamento indique outro cartão ou «da conta»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка по счёту записывается с этой карты, если в записи не названа другая карта или «со счёта»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Харид аз суратҳисоб бо ин корт анҷом мешавад, агар дар сабт корти дигар ё «аз суратҳисоб» нишон дода нашавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtta başka bir kart veya «hesaptan» belirtilmedikçe hesaptan yapılan alışverişlerde bu kart kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка з рахунку оформлюється цією карткою, якщо запис не називає іншу картку або не каже «з рахунку»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobdan xarid shu karta bilan amalga oshiriladi, agar yozuvda boshqa karta yoki «hisobdan» ko‘rsatilmagan bo‘lsa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶的消費預設使用此卡片，除非記錄指定其他卡片或註明「從帳戶」。"
          }
        }
      }
    },
