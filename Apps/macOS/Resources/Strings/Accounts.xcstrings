        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Origine e destinazione sono lo stesso conto nella stessa valuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振替元と振替先が同じ口座と通貨です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამგზავნი და მიმღები ერთი და იმავე ვალუტის ერთი და იგივე ანგარიშია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайдан және қайда бірдей есеп-шот, бірдей валюта."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출금 계좌와 입금 계좌의 통화가 같습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жөнөтүүчү жана алуучу эсеп менен валюта бирдей."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van en naar zijn dezelfde rekening met dezelfde valuta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto źródłowe i docelowe są takie same i mają tę samą walutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A origem e o destino são a mesma conta na mesma moeda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A origem e o destino são a mesma conta na mesma moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откуда и куда — один и тот же счёт в одной валюте."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби ирсолкунанда ва қабулкунанда бо як асъор якхелаанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak ve hedef, aynı para birimindeki aynı hesap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звідки і куди — той самий рахунок у тій самій валюті."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul bir hisobning bir xil valyutasiga o‘tkazilmoqda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转出和转入账户及货币相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉出和轉入為同一帳戶的相同貨幣。"
          }
        }
      }
    },
