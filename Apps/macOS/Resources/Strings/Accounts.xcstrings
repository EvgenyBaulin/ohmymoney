        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月"
          }
        }
      }
    },
    "account.interest.notCounted": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падлічыце рахунак — без балансу нельга разлічыць працэнты"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählen Sie das Konto mit — ohne Saldo gibt es keine Zinsen zu berechnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count the account — without a balance there is no interest to work out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuente la cuenta: sin saldo no hay intereses que calcular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez le compte — sans solde, il n'y a pas d'intérêts à calculer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi il conto: senza saldo non è possibile calcolare gli interessi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотты есептеңіз — теңгерімсіз пайызды есептеу мүмкін емес"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсепти эсепке кошуңуз — калдыксыз пайызды эсептөө мүмкүн эмес"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwzględnij konto — bez salda nie można obliczyć odsetek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua a conta — sem saldo, não é possível calcular os rendimentos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверьте счёт — без остатка проценты не посчитать"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобро ба ҳисоб гиред — бе бақия фоиз ҳисоб намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı dahil edin — bakiye olmadan faiz hesaplanamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порахуйте рахунок — без залишку відсотків не розрахувати"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobni hisobga oling — qoldiqsiz foizlarni hisoblab bo‘lmaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將帳戶計入總覽；沒有餘額就無法計算利息"
          }
        }
      }
    },
    "account.interest.offHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ўкладу ці ашчаднага рахунку: на экране з'явяцца чаканыя працэнты і пытанне, калі выплата не паступіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein Festgeld oder Sparkonto: Der Bildschirm des Kontos zeigt dann die erwarteten Zinsen und fragt nach, wenn eine Auszahlung ausbleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a deposit or a savings account: the account screen then shows the interest expected and asks when a payout does not come."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un depósito o una cuenta de ahorro: la pantalla de la cuenta mostrará entonces los intereses previstos y preguntará cuando un abono no llegue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un dépôt ou un compte d'épargne : l'écran du compte affiche alors les intérêts attendus et demande quand un versement n'arrive pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un deposito o un conto di risparmio: la schermata del conto mostra gli interessi previsti e segnala gli accrediti mancati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салым немесе жинақ шоты үшін: есеп-шот экраны күтілетін пайызды көрсетеді және төлем келмесе, сұрайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Депозит же жыйнак эсеби үчүн: эсеп экранында күтүлгөн пайыз көрсөтүлүп, төлөм түшпөсө суралат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla lokaty lub konta oszczędnościowego: ekran konta pokaże wtedy oczekiwane odsetki i zapyta, jeśli wypłata nie nadejdzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para depósitos ou contas poupança: a tela da conta mostra o rendimento previsto e pergunta quando um pagamento não chega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вклада или накопительного счёта: экран счёта покажет ожидаемые проценты и спросит, если выплата не пришла."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои пасандоз ё ҳисоби пасандозӣ: саҳифаи ҳисоб фоизи интизориро нишон медиҳад ва агар пардохт наояд, мепурсад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevduat veya birikim hesabı için: hesap ekranı beklenen faizi gösterir ve ödeme gelmediğinde sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для депозиту або накопичувального рахунку: екран рахунку тоді покаже очікувані відсотки й запитає, коли виплата не надійшла."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Omonat yoki jamg‘arma hisobi uchun: hisob ekranida kutilayotgan foizlar ko‘rsatiladi va to‘lov tushmasa, so‘raladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於定存或儲蓄帳戶。開啟後，帳戶畫面會顯示預期利息，並在利息未入帳時提醒你。"
          }
        }
      }
    },
