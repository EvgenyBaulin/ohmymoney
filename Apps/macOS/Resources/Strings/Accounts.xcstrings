        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming the bank does not rename its accounts and cards: the entry line still knows them by their own names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cambia el nombre del banco, sus cuentas y tarjetas no cambian de nombre: la línea de entrada las sigue reconociendo por sus propios nombres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renommer la banque ne renomme pas ses comptes et cartes : la ligne de saisie les reconnaît toujours par leur propre nom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименование банка не переименовывает его счета и карты: строка ввода по-прежнему знает их по их названиям."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейменування банку не перейменовує його рахунки й картки: рядок введення знає їх за їхніми власними назвами."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinominare la banca non cambia i nomi dei suoi conti e delle sue carte: la riga di inserimento continua a riconoscerli con i propri nomi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкті қайта атағанда оның есеп-шоттары мен карталары атауы өзгермейді: енгізу жолы оларды әлі өз атымен таниды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змена назвы банка не змяняе назвы яго рахункаў і карт: радок уводу па-ранейшаму ведае іх па ўласных назвах."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie die Bank umbenennen, werden ihre Konten und Karten nicht umbenannt: Die Eingabezeile kennt sie weiterhin unter ihren eigenen Namen."
          }
        }
      }
    },
