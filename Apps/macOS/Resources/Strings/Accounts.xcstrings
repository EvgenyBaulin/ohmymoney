            "value": "Esiste già un gruppo con questo nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のグループがすでにあります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ასეთი სახელის ჯგუფი უკვე არსებობს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен топ бұрыннан бар."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름의 그룹이 이미 있습니다."
