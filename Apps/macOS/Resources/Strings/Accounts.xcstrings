    "accounts.orderHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is always first, in every list and menu. Drag the others into the order you like, or sort them alphabetically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal siempre va primera, en todas las listas y menús. Arrastre las demás al orden que prefiera, o ordénelas alfabéticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal est toujours en premier, dans chaque liste et chaque menu. Faites glisser les autres dans l'ordre souhaité, ou triez-les par ordre alphabétique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт всегда первый — во всех списках и меню. Остальные перетащите в удобном порядке или отсортируйте по алфавиту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок завжди перший у кожному списку й меню. Перетягніть інші в зручний для вас порядок або впорядкуйте їх за алфавітом."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale è sempre al primo posto in tutti gli elenchi e i menu. Trascina gli altri nell’ordine desiderato oppure ordinali alfabeticamente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот әр тізімде және мәзірде әрқашан бірінші тұрады. Басқаларын қалаған тәртіпке сүйреңіз немесе әліпби бойынша сұрыптаңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак заўсёды першы ва ўсіх спісах і меню. Перацягніце астатнія ў патрэбны парадак або адсартуйце паводле алфавіта."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto steht immer an erster Stelle, in jeder Liste und jedem Menü. Ziehen Sie die anderen in die gewünschte Reihenfolge oder sortieren Sie sie alphabetisch."
          }
        }
      }
    },
