      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is first in every list; an operation with no account of its own goes to it. Only one account is main."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal va primera en todas las listas; una operación sin cuenta propia va a ella. Solo una cuenta es la principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт — первый во всех списках; операция без своего счёта попадает на него. Основной счёт один."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок стоїть першим у кожному списку; операція без власного рахунку йде на нього. Основний рахунок один."
          }
