    "bank.cond.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankın tətbiqində göstərilənləri daxil edin. Tətbiq bankdan məlumat almır və məsləhət vermir: şərtləri bankdan dəqiqləşdirin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце ўмовы з праграмы банка. Праграма не атрымлівае даных ад банка і не дае парад: правярайце ўмовы ў банку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte údaje uvedené v aplikaci banky. Aplikace nezískává údaje od banky ani neposkytuje poradenství. Podmínky si ověřte u banky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie ein, was die eigene App der Bank anzeigt. Die App erfährt nichts von der Bank und gibt keine Empfehlungen: Prüfen Sie die Bedingungen bei der Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type what the bank's own app says. The app learns nothing from the bank and does not give advice: check the terms with the bank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba lo que dice la propia app del banco. La app no recibe nada del banco y no da consejos: revise las condiciones con el banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ce qu'indique l'application de la banque. L'application n'apprend rien de la banque et ne donne aucun conseil : vérifiez les conditions auprès de la banque."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք բանկի հավելվածում նշված տվյալները։ Հավելվածը բանկից տվյալներ չի ստանում և խորհուրդներ չի տալիս. պայմանները ճշտեք բանկում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci i dati indicati nell’app della banca. L’app non riceve dati dalla banca e non fornisce consigli: verifica le condizioni con la banca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行のアプリに表示されている内容を入力してください。このアプリは銀行から情報を取得せず、助言も行いません。条件は銀行に確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ ის, რაც ბანკის აპში წერია. აპი ბანკიდან მონაცემებს არ იღებს და რჩევებს არ იძლევა: პირობები ბანკთან გადაამოწმეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктің өз қолданбасы не көрсетсе, соны теріңіз. Қолданба банктен ештеңе үйренбейді және кеңес бермейді: шарттарды банкпен тексеріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 앱에 표시된 내용을 입력하세요. 앱은 은행에서 정보를 가져오거나 조언을 제공하지 않습니다. 조건은 은행에서 확인하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын колдонмосунда көрсөтүлгөн маалыматты киргизиңиз. Колдонмо банктан маалымат албайт жана кеңеш бербейт: шарттарды банктан тактаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul in wat in de app van de bank staat. De app ontvangt geen gegevens van de bank en geeft geen advies. Controleer de voorwaarden bij de bank."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz dane z aplikacji banku. Aplikacja nie pobiera danych z banku ani nie udziela porad. Sprawdź warunki w banku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite as informações do app do banco. Este app não recebe dados do banco nem oferece aconselhamento: confira as condições com o banco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o que consta na app do banco. A app não obtém dados do banco nem dá conselhos: confirme as condições junto do banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите то, что написано в приложении банка. Приложение ничего не узнаёт у банка и не даёт советов: уточните условия в банке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумотро аз барномаи бонк ворид кунед. Барнома аз бонк маълумот намегирад ва маслиҳат намедиҳад: шартҳоро аз бонк санҷед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankanın kendi uygulamasında yazanları girin. Uygulama bankadan bilgi almaz ve tavsiye vermez; koşulları bankadan kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть те, що написано в застосунку самого банку. Застосунок нічого не отримує від банку й не дає порад: умови уточнюйте в банку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank ilovasidagi ma’lumotlarni kiriting. Ilova bankdan ma’lumot olmaydi va maslahat bermaydi: shartlarni bankdan tekshiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按银行 App 中的信息填写。此 App 不会从银行获取信息，也不提供建议；请向银行确认相关条款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請依銀行 App 顯示的內容輸入。此 App 不會從銀行取得資料，也不提供建議；請向銀行確認條款。"
          }
        }
      }
    },
