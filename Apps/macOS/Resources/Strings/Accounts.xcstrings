    "account.editor.bank.newHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine eigene Bank, benannt wie das Konto, sofern Sie keinen anderen Namen angeben. Ein Konto, das wie eine bereits vorhandene Bank heißt, wird dieser Bank zugeordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank of its own, called like the account unless you name it. An account called like a bank that is there already joins that bank."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз банкі, атауы басқа атау енгізілмесе, есеп-шотпен бірдей. Бұрыннан бар банктің атымен аталған есеп-шот сол банкке қосылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк под своим именем — как у счёта, если не назвать иначе. Счёт, названный как уже существующий банк, встаёт под него."
          }
        }
      }
    },
