    "bank.card.expiresHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Müddətin bitməsinə bir ay qalmış İcmal sizə xatırladır və kartla ödənilənləri göstərir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За месяц да заканчэння Агляд нагадае і пакажа, што аплачваецца картай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíc před koncem platnosti vás Přehled upozorní a zobrazí platby hrazené touto kartou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Monat vor dem Ablauf erinnert Sie die Übersicht und listet auf, was mit der Karte bezahlt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A month before it ends, Overview reminds you and lists what is paid with the card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mes antes de que venza, Resumen se lo recuerda y enumera lo que se paga con la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mois avant l'échéance, l'Aperçu vous le rappelle et liste ce qui est payé avec la carte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամկետի ավարտից մեկ ամիս առաջ «Ակնարկը» կհիշեցնի և ցույց կտա այս քարտով կատարվող վճարումները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mese prima della scadenza, Panoramica ti avvisa e mostra i pagamenti effettuati con la carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限の1か月前に「概要」でお知らせし、このカードで支払っている項目を表示します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვადის ამოწურვამდე ერთი თვით ადრე მიმოხილვა შეგახსენებთ და გაჩვენებთ, რას იხდით ამ ბარათით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аяқталғанға бір ай қалғанда «Шолу» еске салады және картамен төленетіндерді тізеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료 한 달 전에 개요에서 알려 주고 이 카드로 결제하는 항목을 표시합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөөнөтү бүтөрүнө бир ай калганда, «Обзор» эскертип, карта менен төлөнгөн кызматтарды көрсөтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een maand voor het verlopen geeft Overzicht een herinnering en toont wat met de kaart wordt betaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesiąc przed końcem ważności Przegląd przypomni o karcie i pokaże opłacane nią płatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mês antes do vencimento, o Resumo avisa e mostra o que é pago com o cartão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mês antes de expirar, a Vista geral avisa e apresenta o que é pago com o cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За месяц до конца срока «Стоит посмотреть» напомнит и покажет, что платится с этой карты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Як моҳ пеш аз анҷоми муҳлат Шарҳ ёдрас мекунад ва пардохтҳои бо корт анҷомшавандаро нишон медиҳад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel Bakış, süre dolmadan bir ay önce hatırlatır ve kartla yapılan ödemeleri listeler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За місяць до закінчення «Огляд» нагадає про це й покаже, що сплачується карткою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Muddat tugashidan bir oy oldin umumiy ko‘rinishda eslatma va karta orqali to‘lanadigan xizmatlar ko‘rsatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到期前一个月，“概览”会提醒你并列出使用此卡支付的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到期前一個月，「總覽」會提醒你，並列出使用此卡付款的項目。"
          }
        }
      }
    },
