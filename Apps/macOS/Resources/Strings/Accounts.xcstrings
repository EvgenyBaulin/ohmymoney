            "state": "translated",
            "value": "Ждём проценты %1$@ за %2$@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоизи %1$@ барои %2$@ бояд пардохт шавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ için %1$@ faiz ödemesi bekleniyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки %1$@ за %2$@ мали надійти"
          }
        },
        "uz": {
