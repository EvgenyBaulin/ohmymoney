    "card.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its own cashback rules go with it. ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus reglas propias de cashback se eliminan con ella. ⌘Z lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses règles de cashback propres partent avec elle. ⌘Z rétablit tout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её собственные правила кэшбэка удалятся вместе с ней. ⌘Z вернёт всё."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Разом із нею зникають її власні правила кешбеку. ⌘Z поверне все."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le sue regole cashback verranno eliminate. Premi ⌘Z per ripristinare tutto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның өз кешбэк ережелері де бірге кетеді. ⌘Z бәрін қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уласныя правілы кэшбэку выдаляюцца разам з ёй. ⌘Z усё адновіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigenen Cashback-Regeln gehen mit ihr. ⌘Z holt alles zurück."
          }
        }
      }
    },
    "card.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its own cashback rules go with it. “Undo” brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus reglas propias de cashback se eliminan con ella. «Deshacer» lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses règles de cashback propres partent avec elle. « Annuler » rétablit tout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её собственные правила кэшбэка удалятся вместе с ней. «Отменить» вернёт всё."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Разом із нею зникають її власні правила кешбеку. «Скасувати» поверне все."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le sue regole cashback verranno eliminate. Tocca “Annulla” per ripristinare tutto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның өз кешбэк ережелері де бірге кетеді. «Болдырмау» бәрін қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уласныя правілы кэшбэку выдаляюцца разам з ёй. “Адмяніць” усё адновіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigenen Cashback-Regeln gehen mit ihr. „Rückgängig“ holt alles zurück."
          }
        }
      }
    },
