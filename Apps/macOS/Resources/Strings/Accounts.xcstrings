    "card.merge.rulesDropped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules for a month and category the kept card already has a rule for — its own stays, these are deleted: %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglas de un mes y categoría para las que la tarjeta que se conserva ya tiene regla — se queda la suya propia, estas se eliminan: %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles pour un mois et une catégorie pour lesquels la carte conservée a déjà une règle — la sienne reste, celles-ci sont supprimées : %lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил на месяц и категорию, для которых у оставшейся карты уже есть своё правило, — остаётся её, эти удалятся: %lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила на місяць і категорію, для яких у картки, що лишається, уже є правило, — її власне лишається, а ці видаляються: %lld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i mesi e le categorie con una regola sulla carta mantenuta, la sua regola resta e queste vengono eliminate: %lld"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалатын картада ережесі бар ай мен санат үшін ережелер — оның өз ережесі қалады, мыналар жойылады: %lld"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правілы на месяц і катэгорыю, для якіх захаваная карта ўжо мае правіла — яе застанецца, гэтыя выдаляюцца: %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln für einen Monat und eine Kategorie, für die die behaltene Karte schon eine Regel hat — ihre eigene bleibt, diese werden gelöscht: %lld"
          }
        }
      }
    },
