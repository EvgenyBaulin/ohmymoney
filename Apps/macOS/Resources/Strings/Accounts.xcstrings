    "account.editor.bank.newHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank of its own, called like the account unless you name it. An account called like a bank that is there already joins that bank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banco propio, con el nombre de la cuenta salvo que indique otro. Una cuenta con el nombre de un banco que ya existe se añade a ese banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une banque à part, nommée comme le compte si vous ne la nommez pas autrement. Un compte nommé comme une banque déjà présente rejoint cette banque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк под своим именем — как у счёта, если не назвать иначе. Счёт, названный как уже существующий банк, встаёт под него."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк окремо, називається так само, як рахунок, якщо ви не назвете інакше. Рахунок, названий як уже наявний банк, приєднується до нього."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una banca separata, con lo stesso nome del conto se non ne inserisci uno. Un conto con il nome di una banca esistente viene associato a quella banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз банкі, атауы басқа атау енгізілмесе, есеп-шотпен бірдей. Бұрыннан бар банктің атымен аталған есеп-шот сол банкке қосылады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асобны банк з назвай рахунку, калі вы не задасце іншую. Рахунак з назвай наяўнага банка далучыцца да яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine eigene Bank, benannt wie das Konto, sofern Sie keinen anderen Namen angeben. Ein Konto, das wie eine bereits vorhandene Bank heißt, wird dieser Bank zugeordnet."
          }
        }
      }
    },
