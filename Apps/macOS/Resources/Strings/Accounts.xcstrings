          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Балавы рахунак у архіве: спачатку аднавіце яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodový účet je archivovaný. Nejprve ho obnovte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Punktekonto ist im Archiv: Holen Sie es zuerst zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The points account is in the archive: bring it back first."
          }
        },
        "es": {
