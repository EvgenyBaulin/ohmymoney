          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen wisselkoers voor %@ — uitgaven kunnen niet worden omgerekend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu dla %@ — nie można przeliczyć wydatków"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cotação para %@ — não é possível converter os gastos"
