    "cashback.settings.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the bank pays"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo paga el banco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment la banque verse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как банк платит"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як банк нараховує"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come paga la banca"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк қалай төлейді"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Як плаціць банк"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie die Bank auszahlt"
          }
        }
      }
    },
    "cashback.settings.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rounding is applied to the cashback of each purchase. The day is the day of the next month the bank pays by. Points count as the currency of their account, one to one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El redondeo se aplica al cashback de cada compra. El día es el del mes siguiente en que el banco paga. Los puntos cuentan como la divisa de su cuenta, uno a uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arrondi s'applique au cashback de chaque achat. Le jour est celui du mois suivant où la banque verse. Les points comptent comme la devise de leur compte, un pour un."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Округление применяется к кэшбэку каждой покупки. День — до какого числа следующего месяца банк платит. Баллы считаются в валюте их счёта, один к одному."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Округлення застосовується до кешбеку з кожної покупки. День — це день наступного місяця, до якого банк нараховує. Бали рахуються як валюта свого рахунку, один до одного."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrotondamento si applica al cashback di ogni acquisto. Il giorno indica entro quando la banca paga nel mese successivo. I punti valgono quanto la valuta del loro conto, uno a uno."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дөңгелектеу әр сатып алудың кешбэгіне қолданылады. Күн — банк төлейтін келесі айдың күні. Ұпайлар өз есеп-шотының валютасы ретінде, бірден бірге саналады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк акругляецца для кожнай пакупкі. Дзень — тэрмін выплаты ў наступным месяцы. Балы ўлічваюцца ў валюце балавага рахунку адзін да аднаго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rundung wird auf den Cashback jedes Kaufs angewendet. Der Tag ist der Tag des nächsten Monats, bis zu dem die Bank auszahlt. Punkte zählen als Währung ihres Kontos, eins zu eins."
          }
        }
      }
    },
    "cashback.sheet.accountHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account’s rules hold for all its cards, unless a card has a rule of its own for the same month and category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de la cuenta valen para todas sus tarjetas, salvo que una tarjeta tenga una regla propia para el mismo mes y categoría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles du compte valent pour toutes ses cartes, sauf si une carte a sa propre règle pour le même mois et la même catégorie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила счёта действуют для всех его карт, если у карты нет своего правила на тот же месяц и категорию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила рахунку діють для всіх його карток, якщо в картки немає власного правила на той самий місяць і категорію."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole del conto valgono per tutte le sue carte, a meno che una carta non abbia una regola propria per lo stesso mese e la stessa categoria."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттың ережелері оның барлық карталарына қолданылады, егер картаның сол ай мен санат үшін өз ережесі болмаса."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правілы рахунку дзейнічаюць для ўсіх яго карт, калі карта не мае ўласнага правіла на той жа месяц і катэгорыю."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln des Kontos gelten für alle seine Karten, sofern eine Karte nicht eine eigene Regel für denselben Monat und dieselbe Kategorie hat."
          }
        }
      }
    },
    "cashback.sheet.addRule": {
