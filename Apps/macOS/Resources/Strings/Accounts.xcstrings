    "account.credit.refusal.days": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The days of the grace period are out of range."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни льготного периода вне допустимых значений."
