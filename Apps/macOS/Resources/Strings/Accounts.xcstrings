    "account.screen.paymentsNone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine geplante Zahlung wird von diesem Konto bezahlt. Eine Zahlung erscheint auf dem Konto, das in ihrem Formular gewählt ist („Konto“); ohne Konto erscheint sie auf dem Hauptkonto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No scheduled payment is paid from this account. A payment shows on the account chosen in its form («Account»); one with no account shows on the main one."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шоттан жоспарланған төлем төленбейді. Төлем өз формасында таңдалған есеп-шотта («Есеп-шот») көрсетіледі; есеп-шотсыз төлем негізгісінде көрінеді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этого счёта не оплачивается ни один платёж. Платёж показывается на счёте, выбранном в его форме («Счёт»); платёж без счёта — на основном."
          }
        }
      }
    },
