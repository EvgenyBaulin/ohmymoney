    "bank.fees.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fees are the category “Fees” with its subcategories (service fees too); interest is what loans and credit cards charged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las comisiones son la categoría «Comisiones» con sus subcategorías (también las de servicio); los intereses son lo que cobraron los préstamos y las tarjetas de crédito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссии — категория «Комиссии» с подкатегориями (в том числе плата за обслуживание); проценты — то, что взяли кредиты и кредитные карты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісії — це категорія «Комісії» з її підкатегоріями (у тому числі комісії за обслуговування); відсотки — це те, що стягнули кредити й кредитні картки."
          }
        }
      }
    },
