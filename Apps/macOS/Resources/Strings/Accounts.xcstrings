    "account.interest.missing": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ üçün %1$@ faiz daxil olmayıb?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнты %1$@ за %2$@ не паступілі?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedorazil úrok %1$@ za %2$@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen %1$@ für %2$@ sind nicht eingegangen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest %1$@ for %2$@ did not come?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No llegaron los intereses %1$@ de %2$@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts %1$@ pour %2$@ ne sont pas arrivés ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ժամանակահատվածի %1$@ տոկոսները չե՞ն ստացվել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ricevuto %1$@ di interessi per %2$@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@の利息%1$@は入金されましたか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-ის პროცენტი %1$@ არ ჩარიცხულა?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ үшін %1$@ пайыз келмеді ме?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 이자 %1$@이(가) 아직 들어오지 않았나요?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ үчүн %1$@ пайыз түшкөн жокпу?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rente %1$@ over %2$@ niet ontvangen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsetki %1$@ za %2$@ nie dotarły?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rendimento de %1$@ referente a %2$@ não entrou?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não recebeu os juros de %1$@ referentes a %2$@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты %1$@ за %2$@ не пришли?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоизи %1$@ барои %2$@ наомад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ için %1$@ faiz gelmedi mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки %1$@ за %2$@ не надійшли?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ uchun %1$@ foiz tushmadimi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 的利息 %1$@ 尚未到账？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 的利息 %1$@ 尚未入帳？"
          }
