        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անունն արխիվում է․ նորը ստեղծելու փոխարեն վերականգնեք այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo nome è nell’archivio: ripristina l’elemento esistente invece di crearne un altro."
