    "account.merge.unknownHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu valyutanın balansını hesablamaq mümkün deyil. Bilirsinizsə, daxil edin və ya boş saxlayıb sonra yoxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга вылічыць баланс гэтай валюты. Увядзіце яго, калі ведаеце, або пакіньце пустым і зверце пазней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek v této měně nelze vypočítat. Pokud ho znáte, zadejte ho, nebo pole nechte prázdné a zůstatek upravte později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo dieser Währung lässt sich nicht berechnen. Tragen Sie ihn ein, wenn Sie ihn kennen, oder lassen Sie das Feld leer und gleichen später ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance of this currency cannot be worked out. Enter it if you know it, or leave it empty and reconcile later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de esta divisa no se puede calcular. Introdúzcalo si lo conoce, o déjelo vacío y concilie más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde de cette devise ne peut pas être calculé. Saisissez-le si vous le connaissez, ou laissez vide et rapprochez plus tard."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս արժույթի մնացորդը հնարավոր չէ հաշվարկել։ Մուտքագրեք այն, եթե գիտեք, կամ թողեք դատարկ և ավելի ուշ ճշգրտեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile calcolare il saldo di questa valuta. Inseriscilo se lo conosci oppure lascia il campo vuoto e riconcilia più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この通貨の残高を計算できません。分かる場合は入力し、分からない場合は空欄のままにして後で残高を照合してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ვალუტის ნაშთის გამოთვლა შეუძლებელია. თუ იცით, შეიყვანეთ; ან დატოვეთ ცარიელი და მოგვიანებით შეაჯერეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл валютаның теңгерімін есептеу мүмкін емес. Білсеңіз, енгізіңіз, әйтпесе бос қалдырып, кейін салыстырыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 통화의 잔액을 계산할 수 없습니다. 잔액을 알고 있다면 입력하고, 모른다면 비워 둔 후 나중에 맞추세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул валютанын калдыгын эсептөө мүмкүн эмес. Билсеңиз киргизиңиз же бош калтырып, кийин тактаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo in deze valuta kan niet worden berekend. Vul het in als je het weet, of laat het leeg en controleer het later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można ustalić salda tej waluty. Wpisz je, jeśli je znasz, lub zostaw pole puste i uzgodnij saldo później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível calcular o saldo nesta moeda. Informe-o se souber ou deixe em branco e concilie depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível calcular o saldo nesta moeda. Indique-o se o souber ou deixe em branco e reconcilie mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в этой валюте не посчитать. Введите его, если знаете, или оставьте пустым и сверьте позже."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи ин асъорро ҳисоб кардан намешавад. Агар медонед, ворид кунед ё холӣ монед ва баъдтар муқоиса кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu para biriminin bakiyesi hesaplanamıyor. Biliyorsanız girin veya boş bırakıp daha sonra mutabakat yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок цієї валюти не можна розрахувати. Введіть його, якщо знаєте, або залиште порожнім і звірте пізніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu valyuta qoldig‘ini hisoblab bo‘lmaydi. Bilsangiz, kiriting yoki bo‘sh qoldirib, keyinroq solishtiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法计算此币种的余额。如已知余额，请输入；也可留空，稍后核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
