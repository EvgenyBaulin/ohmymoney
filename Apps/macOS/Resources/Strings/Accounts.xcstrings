    "account.balance.creditHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit kartı üçün banka borcunuzu mənfi işarə ilə daxil edin: −30,000."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для крэдытнай карты ўвядзіце доўг банку са знакам мінус: −30 000."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U kreditní karty zadejte dluh vůči bance se znaménkem minus: −30,000."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine Kreditkarte tippen Sie den Betrag, den Sie der Bank schulden, mit einem Minus: −30.000."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a credit card, type what you owe the bank with a minus: −30,000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para una tarjeta de crédito, escriba con signo menos lo que debe al banco: −30.000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une carte de crédit, saisissez ce que vous devez à la banque avec un moins : −30 000."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վարկային քարտի համար մուտքագրեք բանկին պարտք գումարը՝ մինուս նշանով՝ −30,000։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per una carta di credito, inserisci l’importo dovuto alla banca con un meno: −30,000."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットカードの場合は、銀行への借入額をマイナスで入力してください。例：−30,000"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკრედიტო ბარათისთვის ბანკის მიმართ დავალიანება მინუსით შეიყვანეთ: −30,000."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік картада банкке берешегіңізді минуспен теріңіз: −30,000."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신용카드는 은행에 갚을 금액을 마이너스로 입력하세요: −30,000."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттик карта үчүн банкка карызыңызды минус менен жазыңыз: −30,000."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul bij een creditcard je schuld aan de bank in met een minteken: −30,000."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przypadku karty kredytowej wpisz zadłużenie ze znakiem minus: −30,000."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um cartão de crédito, digite o valor devido ao banco com um sinal de menos: −30.000."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um cartão de crédito, introduza o valor em dívida ao banco com um sinal negativo: −30,000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кредитной карты впишите долг банку со знаком минус: −30,000."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои корти кредитӣ қарзатонро ба бонк бо аломати минус ворид кунед: −30,000."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi kartı için bankaya olan borcunuzu eksi işaretiyle girin: −30,000."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кредитної картки введіть, скільки ви винні банку, з мінусом: −30 000."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit karta uchun bankdan qarzingizni minus bilan kiriting: −30,000."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于信用卡，请用负数输入欠银行的金额，例如：−30,000。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡欠款請加上負號輸入，例如：−30,000。"
          }
        }
      }
    },
    "account.credit.available": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ məbləğindən %1$@ əlçatandır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даступна %1$@ з %2$@"
          }
        },
