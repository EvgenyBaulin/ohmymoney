            "value": "Punkty czy pieniądze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos ou dinheiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баллы или деньги"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puan mı, para mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бали чи гроші"
          }
        }
      }
    },
    "account.points.nothingBurns": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На працягу месяца нічога не згарае."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Innerhalb eines Monats verfällt nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing burns within a month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No caduca ningún punto durante el próximo mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun point n’expire dans le mois."
