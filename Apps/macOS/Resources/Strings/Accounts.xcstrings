    "cashback.sheet.cardHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card keeps only what differs from its account; the rest it takes from the account’s rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta guarda solo lo que se diferencia de su cuenta; lo demás lo toma de las reglas de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte ne garde que ce qui diffère de son compte ; le reste vient des règles du compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта держит только то, чем отличается от счёта; остальное берёт из правил счёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка зберігає лише те, чим відрізняється від свого рахунку; решту бере з правил рахунку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La carta conserva solo le regole diverse da quelle del conto; per il resto usa le regole del conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта тек есеп-шоттан өзгеше бөлігін сақтайды; қалғанын есеп-шоттың ережелерінен алады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта захоўвае толькі адрозненні ад рахунку; астатняе бярэ з яго правілаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte behält nur, was sich von ihrem Konto unterscheidet; das Übrige übernimmt sie von den Regeln des Kontos."
          }
        }
      }
    },
