    "cashback.refusal.loan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A payment on a debt earns no cashback, so there is no rule for “Loans”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pago de deuda no genera cashback, así que no hay regla para «Préstamos»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За платёж по долгу кэшбэк не платят, поэтому правила для «Кредитов» нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж за боргом кешбеку не приносить, тому правила для «Кредитів» немає."
          }
        }
      }
    },
    "cashback.refusal.percent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The percent is from 0 to 100, with at most four digits after the point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje va de 0 a 100, con cuatro cifras decimales como máximo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процент — от 0 до 100, не больше четырёх знаков после точки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсоток — від 0 до 100, не більше чотирьох знаків після коми."
          }
        }
      }
    },
    "cashback.refusal.pointsArchived": {
      "extractionState": "manual",
