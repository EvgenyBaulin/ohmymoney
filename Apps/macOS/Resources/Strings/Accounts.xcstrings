    "account.interest.offHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein Festgeld oder Sparkonto: Der Bildschirm des Kontos zeigt dann die erwarteten Zinsen und fragt nach, wenn eine Auszahlung ausbleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a deposit or a savings account: the account screen then shows the interest expected and asks when a payout does not come."
          }
        },
        "kk": {
