    "account.refusal.removesCurrencyWithMoney": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabda %@ var: balansı sıfır olana qədər valyuta qalacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На гэтым рахунку ёсць грошы ў %@: валюта застанецца, пакуль яе баланс не стане нулявым."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto účtu jsou peníze v měně %@. Měna zůstane, dokud její zůstatek nebude nulový."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Konto liegt Geld in %@: Die Währung bleibt, bis ihr Saldo null ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is money in %@ on this account: the currency stays until its balance is zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta cuenta hay dinero en %@: la divisa se queda hasta que su saldo sea cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a de l'argent en %@ sur ce compte : la devise reste jusqu'à ce que son solde soit nul."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հաշվում %@ արժույթով գումար կա․ արժույթը կմնա, մինչև դրա մնացորդը զրոյանա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo conto contiene denaro in %@: la valuta rimane finché il saldo non è zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座には%@の残高があります。残高がゼロになるまで通貨を削除できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ანგარიშზე %@ ვალუტაში თანხაა: ვალუტა დარჩება, სანამ მისი ნაშთი არ განულდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шотта %@ валютасында ақша бар: теңгерім нөлге тең болғанша валюта қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계좌에 %@ 잔액이 있습니다. 잔액이 0이 될 때까지 통화가 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул эсепте %@ бар: калдык нөлгө жетмейинче валюта калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staat geld in %@ op deze rekening: de valuta blijft staan tot het saldo nul is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym koncie są środki w walucie %@. Waluta pozostanie na koncie, dopóki jej saldo nie wyniesie zero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta tem dinheiro em %@. A moeda permanecerá até que seu saldo seja zero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta tem dinheiro em %@: a moeda mantém-se até o saldo ser zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги в %@: валюта останется, пока её остаток не станет нулём."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин суратҳисоб бо %@ пул ҳаст: асъор то сифр шудани бақияаш мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesapta %@ cinsinden para var. Bakiye sıfırlanana kadar para birimi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому рахунку є гроші в %@: валюта залишиться, доки її залишок не стане нульовим."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hisobda %@ valyutasida pul bor: qoldiq nol bo‘lguncha valyuta qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户仍有 %@ 余额，余额为零后才能移除此币种。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶仍有 %@ 餘額，餘額歸零前無法移除此貨幣。"
          }
        }
      }
    },
