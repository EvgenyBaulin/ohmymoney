    "bank.cond.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie ein, was die eigene App der Bank anzeigt. Die App erfährt nichts von der Bank und gibt keine Empfehlungen: Prüfen Sie die Bedingungen bei der Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type what the bank's own app says. The app learns nothing from the bank and does not give advice: check the terms with the bank."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктің өз қолданбасы не көрсетсе, соны теріңіз. Қолданба банктен ештеңе үйренбейді және кеңес бермейді: шарттарды банкпен тексеріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите то, что написано в приложении банка. Приложение ничего не узнаёт у банка и не даёт советов: уточните условия в банке."
          }
        }
      }
    },
