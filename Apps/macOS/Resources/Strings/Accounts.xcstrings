    "transfer.sheet.receivedHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Абедзве сумы, як іх паказвае банк."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Beträge so, wie die Bank sie anzeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both amounts as the bank shows them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos importes tal como los muestra el banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux montants tels que la banque les affiche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi gli importi come indicati dalla banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екі сома да банк көрсеткендей."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эки сумманы тең банк көрсөткөндөй киргизиңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obie kwoty tak, jak podaje je bank."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois valores como aparecem no banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обе суммы — как в выписке банка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki tutarı bankada göründüğü gibi girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидві суми так, як їх показує банк."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikkala summa ham bankda koʻrsatilganidek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩筆金額均依銀行顯示為準。"
          }
        }
      }
    },
    "transfer.sheet.sameAmount": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паступае тая ж сума: утрыманае банкам — камісія."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Betrag kommt an: Ein Abzug, den die Bank nimmt, ist die Gebühr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same amount arrives: a cut the bank takes is the fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega el mismo importe: el descuento que cobra el banco es la comisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même montant arrive : la retenue prise par la banque est le frais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo ricevuto è lo stesso: ciò che la banca trattiene è la commissione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірдей сома келеді: банк ұстап алған үлес — комиссия."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошол эле сумма түшөт: банк кармаган акча — комиссия."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dociera ta sama kwota: część pobrana przez bank to opłata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo valor chega ao destino; o valor retido pelo banco é a tarifa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачисляется столько же: то, что удержал банк, — комиссия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı tutar ulaşır; bankanın kestiği tutar ücrettir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Та сама сума приходить: відрахування, яке бере банк, — це комісія."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir xil summa tushadi: bank ushlab qolgan summa komissiyadir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉入金額相同；銀行收取的款項為手續費。"
          }
        }
      }
    },
