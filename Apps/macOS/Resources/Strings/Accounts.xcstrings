    "accounts.alphabetizeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget the order you dragged the accounts into; the main account stays first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar el orden en que arrastró las cuentas; la cuenta principal sigue primera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier l'ordre dans lequel vous avez glissé les comptes ; le compte principal reste en tête"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть порядок, в который вы перетащили счета; основной счёт остаётся первым"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забути порядок, у якому ви перетягували рахунки; основний рахунок лишається першим"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reimposta l’ordine dei conti; il conto principale resta al primo posto"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттарды сүйреп орнатқан тәртіпті ұмыту; негізгі есеп-шот бірінші тұрады"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Скінуць парадак, зададзены перацягваннем; асноўны рахунак застанецца першым"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reihenfolge, in die Sie die Konten gezogen haben, wird vergessen; das Hauptkonto bleibt vorn"
          }
        }
      }
    },
