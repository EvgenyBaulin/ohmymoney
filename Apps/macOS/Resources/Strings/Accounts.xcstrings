    "account.interest.offHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a deposit or a savings account: the account screen then shows the interest expected and asks when a payout does not come."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un depósito o una cuenta de ahorro: la pantalla de la cuenta mostrará entonces los intereses previstos y preguntará cuando un abono no llegue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вклада или накопительного счёта: экран счёта покажет ожидаемые проценты и спросит, если выплата не пришла."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для депозиту або накопичувального рахунку: екран рахунку тоді покаже очікувані відсотки й запитає, коли виплата не надійшла."
