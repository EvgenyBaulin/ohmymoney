    "accounts.delete.messageMoney": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс %@ знікне з усіх вынікаў разам з рахункам. Нішто на рахунак не спасылаецца. ⌘Z адновіць яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo %@ verschwindet mit ihm aus allen Summen. Nichts verweist auf das Konto. ⌘Z holt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance %@ leaves every total with it. Nothing refers to the account. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo %@ sale de todos los totales con ella. Nada hace referencia a la cuenta. ⌘Z la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde %@ sort de tous les totaux avec lui. Rien ne s'y réfère. ⌘Z le rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo %@ verrà rimosso da tutti i totali. Nessun elemento fa riferimento al conto. Premi ⌘Z per ripristinarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімі оның бірге барлық жиынтықтан шығады. Есеп-шотқа ештеңе сілтемейді. ⌘Z қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ калдыгы аны менен кошо бардык жыйынтыктардан чыгарылат. Эсепке эч нерсе байланышкан эмес. ⌘Z аны калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo %@ zostanie usunięte ze wszystkich sum. Nic nie odwołuje się do konta. ⌘Z przywróci je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de %@ será removido de todos os totais. Nada faz referência à conta. ⌘Z a restaura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток %@ пропадёт из итогов. На счёт ничто не ссылается. ⌘Z вернёт его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyesi tüm toplamlarından çıkarılır. Hesaba bağlı bir öğe yok. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок %@ разом із ним зникає з усіх підсумків. Ніщо на рахунок не посилається. ⌘Z поверне його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qoldiq barcha jami summalardan chiqariladi. Hisobga hech narsa bog‘lanmagan. ⌘Z uni qaytaradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額 %@ 也會從所有總計中移除。沒有項目參照此帳戶。按下 ⌘Z 可還原。"
          }
        }
      }
    },
