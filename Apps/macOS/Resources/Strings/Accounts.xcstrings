    "bank.merge.into": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Bank"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With bank"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қабылдайтын банк"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С банком"
          }
        }
      }
    },
    "bank.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Konto von „%1$@“, auch archivierte, wandert unter „%2$@“, und „%1$@“ wird gelöscht. „%2$@“ behält seinen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every account of “%1$@”, archived ones too, moves under “%2$@”, and “%1$@” is deleted. “%2$@” keeps its name."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” банкінің барлық есеп-шоты, мұрағаттағылары да, “%2$@” астына көшеді, ал “%1$@” жойылады. “%2$@” өз атын сақтайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все счета банка «%1$@», и архивные тоже, перейдут в банк «%2$@», а банк «%1$@» будет удалён. Название «%2$@» останется прежним."
          }
        }
      }
    },
    "bank.merge.money": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Geld wird bewegt, und jedes Konto behält seinen Namen und seinen Saldo. Konten einer Bank lassen sich danach untereinander zusammenführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No money moves and every account keeps its name and its balance. Accounts of one bank can then be merged with each other."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша қозғалмайды, әр есеп-шот өз атын және теңгерімін сақтайды. Осыдан кейін бір банктің есеп-шоттарын өзара біріктіруге болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги никуда не переходят, у каждого счёта остаются его название и остаток. После этого счета одного банка можно объединять между собой."
          }
        }
      }
    },
    "bank.merge.noAccounts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat keine Konten: Sie wird nur gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank has no accounts: it is only deleted."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкте есеп-шот жоқ: ол тек жойылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В банке нет счетов: он будет просто удалён."
          }
        }
      }
    },
    "bank.merge.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank im Archiv wird nicht zusammengeführt: Holen Sie sie zuerst zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank in the archive is not merged: bring it back first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы банк біріктірілмейді: алдымен оны қайтарыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк в архиве не объединяется: сначала верните его."
          }
        }
      }
    },
    "bank.merge.title": {
      "extractionState": "manual",
      "localizations": {
