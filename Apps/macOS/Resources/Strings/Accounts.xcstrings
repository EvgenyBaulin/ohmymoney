    "account.editor.bank.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак знаходзіцца ў гэтым банку; у спісах выбару пазначаны яго назвай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto steht unter dieser Bank; in Auswahllisten nennt die Bank es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account stands under this bank; in lists of choices the bank names it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta figura bajo este banco; en las listas de opciones aparece el nombre del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte est rattaché à cette banque ; dans les listes de choix, c'est elle qui le nomme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto è associato a questa banca; negli elenchi di scelta è indicato con il nome della banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот осы банк астында тұрады; таңдау тізімдерінде банк оның атауын береді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсеп ушул банкка таандык; тандоо тизмелеринде банктын аты көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto należy do tego banku; na listach wyboru jest wyświetlane pod jego nazwą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta pertence a este banco; nas listas, ela aparece com o nome do banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт стоит под этим банком; в списках выбора его называет банк."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоб ба ин бонк тааллуқ дорад; дар рӯйхати интихобҳо номи бонк нишон дода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap bu bankaya bağlıdır; seçim listelerinde banka adı gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок належить цьому банку; у списках вибору його називає банк."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob shu bankka tegishli; tanlash ro‘yxatlarida bank nomi ko‘rsatiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶隸屬於這家銀行；選擇帳戶時會顯示銀行名稱。"
          }
        }
      }
    },
