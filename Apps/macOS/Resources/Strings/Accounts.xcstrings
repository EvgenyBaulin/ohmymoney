    "cashback.refusal.category": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rule names an expense category outside Goals and the reconciliation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla cita una categoría de gasto fuera de Objetivos y de la conciliación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle nomme une catégorie de dépenses hors Objectifs et rapprochement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило задаётся для категории расходов, кроме «Целей» и «Сверки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило називає категорію витрат поза «Цілями» і звіркою."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola deve indicare una categoria di spesa diversa da Obiettivi e dalla riconciliazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ереже Мақсаттар мен салыстыруға кірмейтін шығыс санатын көрсетеді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У правіле патрэбна катэгорыя выдаткаў, акрамя Мэт і зверкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel nennt eine Ausgabenkategorie außerhalb von Zielen und Abgleich."
          }
        }
      }
    },
