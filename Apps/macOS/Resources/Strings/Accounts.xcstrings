          "stringUnit": {
            "state": "translated",
            "value": "Les deux montants tels que la banque les affiche."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երկու գումարներն էլ՝ ինչպես ցույց է տալիս բանկը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi gli importi come indicati dalla banca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の金額を銀行の表示どおりに入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ორივე თანხა ისე, როგორც ბანკშია მითითებული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екі сома да банк көрсеткендей."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행에 표시된 두 금액을 입력하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эки сумманы тең банк көрсөткөндөй киргизиңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide bedragen zoals de bank ze toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obie kwoty tak, jak podaje je bank."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois valores como aparecem no banco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos os montantes como apresentados pelo banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обе суммы — как в выписке банка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳар ду маблағро тавре ворид кунед, ки бонк нишон медиҳад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki tutarı bankada göründüğü gibi girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидві суми так, як їх показує банк."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikkala summa ham bankda koʻrsatilganidek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按银行显示的金额填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩筆金額均依銀行顯示為準。"
          }
        }
      }
    },
    "transfer.sheet.sameAmount": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyni məbləğ çatır: bankın tutduğu hissə komissiyadır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паступае тая ж сума: утрыманае банкам — камісія."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorazí stejná částka. Částka stržená bankou je poplatek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Betrag kommt an: Ein Abzug, den die Bank nimmt, ist die Gebühr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same amount arrives: a cut the bank takes is the fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega el mismo importe: el descuento que cobra el banco es la comisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même montant arrive : la retenue prise par la banque est le frais."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստացվում է նույն գումարը․ բանկի գանձած մասը միջնորդավճարն է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo ricevuto è lo stesso: ciò che la banca trattiene è la commissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同額が入金されます。銀行に差し引かれる分は手数料です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ირიცხება იგივე თანხა: ბანკის მიერ ჩამოჭრილი თანხა საკომისიოა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірдей сома келеді: банк ұстап алған үлес — комиссия."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 금액이 입금됩니다. 은행이 차감한 금액은 수수료입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошол эле сумма түшөт: банк кармаган акча — комиссия."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hetzelfde bedrag komt aan; wat de bank inhoudt zijn de kosten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dociera ta sama kwota: część pobrana przez bank to opłata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo valor chega ao destino; o valor retido pelo banco é a tarifa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Chega o mesmo montante: o valor cobrado pelo banco é a comissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачисляется столько же: то, что удержал банк, — комиссия."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳамин маблағ мерасад; маблағи гирифтаи бонк комиссия аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı tutar ulaşır; bankanın kestiği tutar ücrettir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Та сама сума приходить: відрахування, яке бере банк, — це комісія."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir xil summa tushadi: bank ushlab qolgan summa komissiyadir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到账金额相同；银行扣取的金额为手续费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉入金額相同；銀行收取的款項為手續費。"
          }
        }
      }
    },
