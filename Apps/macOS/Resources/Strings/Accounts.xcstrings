    "account.credit.cashNow": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Наяўныя ці перавод %1$@: %2$@ — працэнты налічваюцца адразу"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargeld oder Überweisung am %1$@: %2$@ — Zinsen laufen sofort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash or transfer on %1$@: %2$@ — interest runs at once"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectivo o transferencia el %1$@: %2$@ — los intereses corren de inmediato"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrait ou virement le %1$@ : %2$@ — les intérêts courent tout de suite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contanti o bonifico il %1$@: %2$@ — gli interessi decorrono subito"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күні қолма-қол ақша немесе аударым: %2$@ — пайыз бірден есептеледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күнүнө карата накталай алуу же которуу: %2$@ — пайыз дароо эсептелет"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotówka lub przelew dnia %1$@: %2$@ — odsetki naliczane od razu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saque ou transferência em %1$@: %2$@ — juros imediatos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие или перевод %1$@: %2$@ — проценты пойдут сразу"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нақд ё интиқол дар %1$@: %2$@ — фоиз фавран ҳисоб мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarihinde nakit veya transfer: %2$@ — faiz hemen işlemeye başlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готівка або переказ за %1$@: %2$@ — відсотки нараховуються одразу"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sanasida naqd pul yoki o‘tkazma: %2$@ — foiz darhol hisoblanadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的預借現金或轉帳：%2$@，立即計息"
          }
        }
      }
    },
