    "account.credit.recordHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sum here is an estimate: enter what the statement says. It replaces the estimate of this statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suma aquí es una estimación: escriba lo que dice el extracto. Sustituye la estimación de este extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La somme ici est une estimation : saisissez ce qu'indique le relevé. Elle remplace l'estimation de ce relevé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь сумма — оценка: впишите ту, что в выписке. Она заменит оценку этой выписки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут сума є оцінкою: введіть те, що написано у виписці. Вона замінить оцінку цієї виписки."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo importo è una stima: inserisci quello indicato nell’estratto conto. Sostituirà la stima per questo estratto conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда көрсетілген сома — болжам: үзіндіде не жазылғанын енгізіңіз. Ол осы үзіндінің болжамын ауыстырады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума тут прыблізная: увядзіце суму з выпіскі. Яна заменіць разлік гэтай выпіскі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Summe hier ist eine Schätzung: Tragen Sie ein, was die Abrechnung sagt. Sie ersetzt die Schätzung dieser Abrechnung."
          }
        }
      }
    },
