          "stringUnit": {
            "state": "translated",
            "value": "Keine Schuld auf der Karte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No debt on the card"
          }
        },
        "ru": {
          "stringUnit": {
