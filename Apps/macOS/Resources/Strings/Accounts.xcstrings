    "bank.settings.forgottenDays.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu müddət ərzində hərəkət olmayan, balansında pul və ya borc olan hesab və kartlar unudulmuş kimi göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахункі і карты без руху такі час, з грашыма ці платай за абслугоўванне, паказваюцца як забытыя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účty a karty, na kterých se takto dlouho nic neděje a je na nich zůstatek nebo poplatek, se zobrazí jako zapomenuté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten und Karten, auf denen so lange nichts bewegt wird und mit Geld oder einer Gebühr darauf, werden als vergessen aufgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts and cards nothing moves on this long, with money or a charge on them, are listed as forgotten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas y tarjetas sin movimientos durante este tiempo, con dinero o un cargo, aparecen como olvidadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes et cartes sans aucun mouvement pendant ce délai, avec de l'argent ou des frais, sont listés comme oubliés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսքան ժամանակ շարժ չունեցող հաշիվներն ու քարտերը, որոնց վրա գումար կամ պարտք կա, համարվում են մոռացված։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I conti e le carte senza movimenti per questo periodo, con un saldo o un costo, sono elencati come dimenticati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日数の間、取引がなく、残高または請求がある口座やカードを「忘れられた項目」に表示します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშები და ბარათები, რომლებზეც ამ დროის განმავლობაში მოძრაობა არ ყოფილა და თანხა ან დავალიანება აქვთ, დავიწყებულად ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осыншама күн қозғалыссыз тұрған, ақшасы немесе ақы алуы бар есеп-шоттар мен карталар ұмытылғандар тізіміне қосылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액이나 청구액이 있고 이 기간 동안 거래가 없는 계좌와 카드를 방치된 항목으로 표시합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушул убакытта кыймыл болбогон, бирок акчасы же карызы бар эсептер жана карталар унутулган деп көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekeningen en kaarten waarop zo lang geen activiteit is geweest en waarop nog geld of een schuld staat, worden als vergeten weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konta i karty bez operacji przez ten czas, na których są środki lub zadłużenie, są uznawane za zapomniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas e cartões sem movimentação por esse período, mas com saldo ou cobrança, são listados como esquecidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As contas e os cartões sem movimentos durante este período, com saldo ou encargos, são considerados esquecidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета и карты, на которых столько дней нет движения, а деньги или плата есть, попадают в «Забытые деньги»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобҳо ва кортҳое, ки дар ин муддат ҳаракат надоштанд ва бақия ё қарз доранд, фаромӯшшуда ҳисоб мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu süre boyunca hareket olmayan ve bakiyesi veya borcu bulunan hesaplar ve kartlar unutulmuş olarak listelenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки й картки, за якими стільки часу нічого не рухається, а на них є гроші або плата, потрапляють до списку забутих."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuncha vaqt harakat bo‘lmagan, qoldig‘i yoki qarzi bor hisob va kartalar unutilganlar ro‘yxatiga qo‘shiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过此天数没有交易，但仍有余额或费用的账户和卡片会被列为已遗忘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶和卡片若在此天數內沒有交易，但仍有餘額或費用，會列為閒置。"
          }
        }
      }
    },
