    "accounts.deleteBank.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu banka bağlı hesab yoxdur. ⌘Z ilə bərpa etmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У ім няма рахункаў. ⌘Z адновіць яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobsahuje žádný účet. Zkratkou ⌘Z ji obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darunter steht kein Konto. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account is under it. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cuenta bajo él. ⌘Z lo devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte n'y est rattaché. ⌘Z la rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս բանկում հաշիվներ չկան։ ⌘Z-ը կվերականգնի այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non contiene conti. Premi ⌘Z per ripristinarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この銀行に口座はありません。⌘Zで元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მას ანგარიში არ ეკუთვნის. ⌘Z აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Астында ешбір есеп-шот жоқ. ⌘Z қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 은행에 속한 계좌가 없습니다. ⌘Z로 복원할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Анын алдында эсептер жок. ⌘Z аны калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen rekeningen bij deze bank. Met ⌘Z zet je deze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma w nim żadnych kont. ⌘Z przywróci go."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há contas neste banco. ⌘Z o restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há contas neste banco. Prima ⌘Z para o recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под ним нет ни одного счёта. ⌘Z вернёт его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар он ҳисобе нест. ⌘Z онро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bankaya bağlı hesap yok. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під ним немає жодного рахунку. ⌘Z поверне його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bankda hisob yo‘q. ⌘Z uni qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此银行下没有账户。按 ⌘Z 可将其恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此銀行沒有帳戶。按下 ⌘Z 可還原。"
          }
        }
      }
    },
    "accounts.deleteBank.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
