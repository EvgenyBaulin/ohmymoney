    "account.credit.firstCardHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte wird zusammen mit ihrer ersten Karte eröffnet. Leer: Die Karte heißt wie das Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is opened together with its first card. Empty: the card is named like the account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитная карта открывается вместе с первой картой. Пусто: карта называется как счёт."
          }
        }
      }
    },
