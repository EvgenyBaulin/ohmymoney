        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Упайлардын эсеби архивде: адегенде аны калыбына келтириңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De puntenrekening is gearchiveerd. Zet deze eerst terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto punktowe jest w archiwum — najpierw je przywróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta de pontos está arquivada. Restaure-a primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta de pontos está arquivada: restaure-a primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт для баллов в архиве: сначала верните его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби холҳо дар бойгонӣ аст: аввал онро барқарор кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puan hesabı arşivde: Önce hesabı geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок для балів в архіві — спершу поверніть його."
