    "account.refusal.groupHasLiveAccounts": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У групе яшчэ ёсць рахункі па-за архівам: спачатку архівуйце іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe hat noch Konten außerhalb des Archivs: Verschieben Sie diese zuerst ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group still has accounts outside the archive: move them to the archive first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo aún tiene cuentas fuera del archivo: pásalas antes al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe a encore des comptes hors des archives : mettez-les d'abord aux archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo contiene ancora conti non archiviati: archiviali prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топта әлі мұрағатта жоқ есеп-шоттар бар: алдымен оларды мұрағатқа өткізіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Топто архивден тышкары эсептер бар. Адегенде аларды архивге жылдырыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupa nadal zawiera konta poza archiwum. Najpierw przenieś je do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo ainda tem contas ativas. Arquive-as primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе есть счета не в архиве — сначала уберите в архив их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гурӯҳ то ҳол суратҳисобҳои берун аз бойгонӣ дорад: аввал онҳоро ба бойгонӣ баред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grubun arşiv dışında hesapları var. Önce bunları arşive kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У групі ще є рахунки поза архівом: спершу перенесіть їх в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Guruhda hali arxivga o‘tkazilmagan hisoblar bor: avval ularni arxivga o‘tkazing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此群組仍有未封存的帳戶，請先將這些帳戶封存。"
          }
        }
      }
    },
    "account.refusal.groupHoldsMain": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак у гэтай групе, таму яна застаецца ў зводцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto ist in dieser Gruppe, deshalb bleibt sie in der Übersicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is in this group, so it stays in the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal está en este grupo, así que se queda en el resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal se trouve dans ce groupe, il reste donc dans le récapitulatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale è in questo gruppo, che quindi rimane nel riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот осы топта, сондықтан ол қорытындыда қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги эсеп бул топто болгондуктан, топ жыйынтыкта калат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto główne należy do tej grupy, więc pozostaje ona w podsumowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal está neste grupo, por isso ele permanece no resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе основной счёт, поэтому она остаётся в общей сводке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисоби асосӣ дар ин гурӯҳ аст, бинобар ин гурӯҳ дар ҷамъбаст мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana hesap bu grupta olduğundan grup özette kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок є в цій групі, тому він залишається в підсумку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy hisob shu guruhda, shuning uchun guruh umumiy ko‘rinishda qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要帳戶位於此群組，因此此群組會保留在摘要中。"
          }
        }
      }
    },
    "account.refusal.groupInUse": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да групы адносяцца рахункі, у тым ліку архіўныя: яе можна архіваваць, але не выдаліць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Gruppe sind Konten abgelegt, auch archivierte: Sie kann ins Archiv, nicht gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, archived ones too, are filed under the group: it can go to the archive, not be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cuentas, también archivadas, dentro del grupo: puede pasar al archivo, pero no eliminarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des comptes, même archivés, sont classés dans le groupe : il peut aller aux archives, mais non être supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo contiene conti, anche archiviati: puoi archiviarlo, ma non eliminarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топ астында есеп-шоттар тізімделген, мұрағаттағылар да: ол мұрағатқа өтуі мүмкін, бірақ жойылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Топко эсептер, анын ичинде архивдегилери да кирет. Аны архивге жылдырса болот, бирок өчүрүүгө болбойт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do grupy są przypisane konta, również te w archiwum. Można ją przenieść do archiwum, ale nie można jej usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há contas neste grupo, inclusive arquivadas. Ele pode ser arquivado, mas não apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К группе отнесены счета, в том числе архивные: её можно убрать в архив, но не удалить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисобҳо, аз ҷумла суратҳисобҳои бойгонӣ, дар ин гурӯҳанд: онро ба бойгонӣ бурдан мумкин аст, аммо нест кардан не."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gruba bağlı hesaplar var; arşivdekiler de dahil. Grup silinemez, ancak arşive kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки, в тому числі архівні, лежать у групі: вона може піти в архів, але не видалитися."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Guruhga hisoblar, jumladan arxivdagilari ham biriktirilgan: guruhni arxivga o‘tkazish mumkin, ammo o‘chirib bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此群組下仍有帳戶，包括已封存的帳戶；只能封存，無法刪除。"
          }
        }
      }
    },
    "account.refusal.groupNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "be": {
