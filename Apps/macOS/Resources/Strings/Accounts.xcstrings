    "accounts.alphabetizeHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Скінуць парадак, зададзены перацягваннем; асноўны рахунак застанецца першым"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reihenfolge, in die Sie die Konten gezogen haben, wird vergessen; das Hauptkonto bleibt vorn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget the order you dragged the accounts into; the main account stays first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar el orden en que arrastró las cuentas; la cuenta principal sigue primera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier l'ordre dans lequel vous avez glissé les comptes ; le compte principal reste en tête"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reimposta l’ordine dei conti; il conto principale resta al primo posto"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттарды сүйреп орнатқан тәртіпті ұмыту; негізгі есеп-шот бірінші тұрады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептердин кол менен коюлган ирети өчүрүлөт; негизги эсеп биринчи бойдон калат"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń ręcznie ustawioną kolejność kont; konto główne pozostanie na początku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta a ordem definida ao arrastar as contas; a conta principal permanece em primeiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть порядок, в который вы перетащили счета; основной счёт остаётся первым"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesapların sürüklenerek belirlenen sırasını kaldırır; ana hesap ilk sırada kalır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забути порядок, у якому ви перетягували рахунки; основний рахунок лишається першим"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblarning qo‘lda belgilangan tartibini bekor qilish; asosiy hisob birinchi bo‘lib qoladi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除手動排列的帳戶順序；主要帳戶會保留在最前面"
          }
        }
      }
    },
    "accounts.archive": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
