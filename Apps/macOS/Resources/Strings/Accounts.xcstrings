          "stringUnit": {
            "state": "translated",
            "value": "Grace period"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Льготный период"
          }
        }
      }
    },
    "account.credit.grace.fromPurchase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days from the first purchase"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни с первой покупки"
          }
        }
      }
    },
    "account.credit.grace.statement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Statement every month"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выписка каждый месяц"
          }
        }
      }
    },
    "account.credit.graceLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grace period is lost: pay the whole debt, %@, and interest stops"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Льготный период потерян: внесите весь долг %@, и проценты перестанут начисляться"
          }
        }
      }
    },
    "account.credit.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is an account whose balance goes below zero; it is not a debt. Every term is in %@. Interest is shown as an estimate until you record it from the statement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитная карта — это счёт, остаток которого уходит в минус, а не долг. Все условия — в %@. Проценты видны как оценка, пока вы не запишете их по выписке."
          }
        }
      }
    },
    "account.credit.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credit limit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитный лимит"
          }
        }
      }
    },
    "account.credit.minFloor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum payment at least"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимальный платёж не меньше"
          }
        }
      }
    },
    "account.credit.minPercent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum payment, % of the debt"
          }
