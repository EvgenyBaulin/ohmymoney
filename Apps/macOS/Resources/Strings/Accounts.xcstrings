    "card.editor.otherNamesHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daxiletmə sətri kartı bu adlardan hər hansı biri ilə tanıyır və əməliyyatı onun hesabına əlavə edir: “coffee 300 virtual”."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Радок уводу пазнае карту па любой назве і выбірае яе рахунак: “кава 300 віртуальная”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadávací řádek kartu rozpozná podle kteréhokoli z těchto názvů a přiřadí ji k účtu: „káva 300 virtuální“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingabezeile erkennt die Karte an jedem dieser Namen und ordnet sie ihrem Konto zu: „Kaffee 300 virtuell“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entry line knows the card by any of these names and puts it on its account: “coffee 300 virtual”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea de entrada reconoce la tarjeta por cualquiera de estos nombres y la asigna a su cuenta: «café 300 virtual»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne de saisie reconnaît la carte par l'un de ces noms et la rattache à son compte : « café 300 virtuelle »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրման տողը ճանաչում է քարտն այս անուններից յուրաքանչյուրով և գործարքը գրանցում դրա հաշվին․ “coffee 300 virtual”։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga di inserimento riconosce la carta con uno qualsiasi di questi nomi e la associa al suo conto: “caffè 300 virtuale”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄では、どの別名でもカードを指定して口座に記録できます: “コーヒー 300 バーチャル”。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეყვანის ველი ბარათს ამ სახელებითაც ამოიცნობს და მის ანგარიშს მიაკუთვნებს: „ყავა 300 ვირტუალური“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енгізу жолы картаны осы атаулардың кез келгенімен таниды және оны есеп-шотына қояды: «кофе 300 виртуал»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력란에서 이 이름으로 카드를 인식하고 해당 계좌에 기록합니다: “커피 300 가상”."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Киргизүү сабы картаны ушул аттардын каалаганы боюнча таанып, анын эсебин колдонот: “coffee 300 virtual”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De invoerregel herkent de kaart aan elk van deze namen en koppelt de transactie aan de rekening: ‘koffie 300 virtueel’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisując operację, możesz użyć dowolnej z tych nazw, aby przypisać ją do konta karty: „kawa 300 wirtualna”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha de entrada reconhece o cartão por qualquer um destes nomes e o associa à conta: “café 300 virtual”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha de registo reconhece o cartão por qualquer um destes nomes e associa-o à conta: “café 300 virtual”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка ввода узнаёт карту по любому из названий и ставит её счёт: «кофе 300 виртуалка»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатри воридкунӣ кортро бо ҳар яке аз ин номҳо мешиносад ва амалиётро ба ҳисоби он мегузорад: “coffee 300 virtual”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş satırı kartı bu adlardan herhangi biriyle tanır ve işlemi hesabına ekler: “kahve 300 sanal”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок введення знає картку за будь-якою з цих назв і записує її на її рахунок: «кава 300 віртуальна»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiritish satri kartani bu nomlarning har biri bo‘yicha taniydi va uning hisobiga bog‘laydi: “coffee 300 virtual”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入时可用任一名称识别卡片，并将交易记入其账户，例如：“coffee 300 virtual”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入交易時可用這些名稱辨識卡片並歸入其帳戶，例如「coffee 300 virtual」。"
          }
        }
      }
    },
