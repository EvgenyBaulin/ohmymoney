    "bank.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every account of “%1$@”, archived ones too, moves under “%2$@”, and “%1$@” is deleted. “%2$@” keeps its name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cuenta de «%1$@», también las archivadas, pasa a estar bajo «%2$@», y «%1$@» se elimina. «%2$@» conserva su nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque compte de « %1$@ », y compris les archivés, passe sous « %2$@ », et « %1$@ » est supprimée. « %2$@ » garde son nom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все счета банка «%1$@», и архивные тоже, перейдут в банк «%2$@», а банк «%1$@» будет удалён. Название «%2$@» останется прежним."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рахунок «%1$@», в тому числі архівні, переходить під «%2$@», а «%1$@» видаляється. «%2$@» зберігає свою назву."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i conti di “%1$@”, inclusi quelli archiviati, vengono spostati in “%2$@” e “%1$@” viene eliminata. “%2$@” mantiene il proprio nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” банкінің барлық есеп-шоты, мұрағаттағылары да, “%2$@” астына көшеді, ал “%1$@” жойылады. “%2$@” өз атын сақтайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе рахункі “%1$@”, у тым ліку архіўныя, пяройдуць у “%2$@”, а “%1$@” будзе выдалены. “%2$@” захавае назву."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Konto von „%1$@“, auch archivierte, wandert unter „%2$@“, und „%1$@“ wird gelöscht. „%2$@“ behält seinen Namen."
          }
        }
      }
    },
    "bank.merge.money": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No money moves and every account keeps its name and its balance. Accounts of one bank can then be merged with each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se mueve dinero y cada cuenta conserva su nombre y su saldo. Después se pueden fusionar entre sí las cuentas de un mismo banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun argent ne bouge et chaque compte garde son nom et son solde. Les comptes d'une même banque peuvent ensuite être fusionnés entre eux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги никуда не переходят, у каждого счёта остаются его название и остаток. После этого счета одного банка можно объединять между собой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші не рухаються, і кожен рахунок зберігає свою назву та залишок. Рахунки одного банку потім можна зливати між собою."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun denaro viene spostato e ogni conto mantiene il proprio nome e saldo. I conti della stessa banca possono poi essere uniti tra loro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша қозғалмайды, әр есеп-шот өз атын және теңгерімін сақтайды. Осыдан кейін бір банктің есеп-шоттарын өзара біріктіруге болады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы не перамяшчаюцца, кожны рахунак захавае назву і баланс. Затым можна аб'яднаць рахункі аднаго банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Geld wird bewegt, und jedes Konto behält seinen Namen und seinen Saldo. Konten einer Bank lassen sich danach untereinander zusammenführen."
          }
        }
      }
    },
    "bank.merge.noAccounts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank has no accounts: it is only deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco no tiene cuentas: solo se elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque n'a aucun compte : elle est seulement supprimée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В банке нет счетов: он будет просто удалён."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У банку немає рахунків: його лише видаляють."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca non ha conti: viene solo eliminata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкте есеп-шот жоқ: ол тек жойылады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка няма рахункаў: ён толькі выдаляецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat keine Konten: Sie wird nur gelöscht."
          }
        }
      }
    },
    "bank.merge.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank in the archive is not merged: bring it back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banco del archivo no se fusiona: recupérelo antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une banque aux archives ne se fusionne pas : ramenez-la d'abord."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк в архиве не объединяется: сначала верните его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк в архіві не зливається: спершу поверніть його."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una banca archiviata non può essere unita: prima ripristinala."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы банк біріктірілмейді: алдымен оны қайтарыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк у архіве нельга аб'яднаць: спачатку аднавіце яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank im Archiv wird nicht zusammengeführt: Holen Sie sie zuerst zurück."
          }
        }
      }
    },
