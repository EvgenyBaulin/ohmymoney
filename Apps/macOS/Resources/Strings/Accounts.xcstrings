    "bank.card.rebind.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kartla ödənilən ödəniş və ya abunə yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтай картай не аплачваюцца плацяжы ці падпіскі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Touto kartou se nehradí žádné platby ani předplatná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser Karte werden keine Zahlungen oder Abos bezahlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No payments or subscriptions are paid with this card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta tarjeta no se paga ningún pago ni suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun paiement ni abonnement n'est réglé avec cette carte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս քարտով վճարումներ կամ բաժանորդագրություններ չկան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun pagamento o abbonamento usa questa carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードで支払っている支払いやサブスクリプションはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ბარათით არცერთი გადახდა ან გამოწერა არ იფარება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл картамен төленетін төлемдер мен жазылымдар жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카드로 결제하는 지출 또는 구독이 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул карта менен төлөнгөн төлөмдөр же жазылуулар жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er worden geen betalingen of abonnementen met deze kaart betaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta karta nie jest używana do żadnych płatności ani subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum pagamento ou assinatura usa este cartão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum pagamento ou assinatura é pago com este cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этой карты не платятся ни платежи, ни подписки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо ин корт пардохт ё обунае пардохт намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kartla yapılan ödeme veya abonelik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден платіж або підписка не сплачується цією карткою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu karta orqali to‘lanadigan to‘lov yoki obunalar yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有使用此卡支付的付款或订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有使用此卡付款的項目或訂閱。"
          }
        }
      }
    },
    "bank.card.rebind.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər ödənişi və ya abunəni açıb başqa kart seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрыйце кожны плацеж ці падпіску і выберыце іншую карту."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete každou platbu nebo předplatné a vyberte jinou kartu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie jede Zahlung oder jedes Abo und wählen Sie eine andere Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open each payment or subscription and pick another card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra cada pago o suscripción y elija otra tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez chaque paiement ou abonnement et choisissez une autre carte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացեք յուրաքանչյուր վճարում կամ բաժանորդագրություն և ընտրեք այլ քարտ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri ogni pagamento o abbonamento e scegli un’altra carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各支払いやサブスクリプションを開き、別のカードを選択してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გახსენით თითოეული გადახდა ან გამოწერა და აირჩიეთ სხვა ბარათი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр төлемді немесе жазылымды ашып, басқа картаны таңдаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 지출 또는 구독을 열어 다른 카드를 선택하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир төлөмдү же жазылууну ачып, башка картаны тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open elke betaling of elk abonnement en kies een andere kaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz każdą płatność lub subskrypcję i wybierz inną kartę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra cada pagamento ou assinatura e escolha outro cartão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra cada pagamento ou assinatura e escolha outro cartão."
          }
        },
        "ru": {
