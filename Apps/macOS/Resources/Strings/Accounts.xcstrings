    "accounts.groupsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group left out of the summary keeps its money out of «Total» and the free sum; its income and spending still count everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo fuera del resumen deja su dinero fuera de «Total» y de la suma libre; sus ingresos y gastos siguen contando en todas partes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги группы вне сводки не входят во «Всего» и в свободную сумму; её доходы и траты по-прежнему учитываются везде."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Група, вилучена з підсумку, тримає свої гроші поза «Усього» і вільною сумою; її доходи й витрати всюди враховуються."
          }
        }
      }
    },
