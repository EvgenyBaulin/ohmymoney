    "card.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі “%1$@” (таксама ў сметніцы) і яе планавыя плацяжы пяройдуць на “%2$@”, а назва і іншыя назвы стануць іншымі назвамі “%2$@”. Карта “%1$@” будзе выдалена. Грошы не перамяшчаюцца: карты належаць аднаму рахунку, таму балансы і зверкі не змяняюцца. ⌘Z усё адновіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge von „%1$@“ (auch im Papierkorb) und ihre geplanten Zahlungen wandern zu „%2$@“, und ihr Name sowie ihre weiteren Namen werden weitere Namen von „%2$@“. Die Karte „%1$@“ wird gelöscht. Es wird kein Geld bewegt: Beide Karten gehören zu einem Konto, daher bleiben Salden und Abgleiche, wie sie sind. ⌘Z holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations of “%1$@” (in the bin too) and its scheduled payments move to “%2$@”, and its name and other names become other names of “%2$@”. The card “%1$@” is deleted. No money moves: both cards are of one account, so balances and reconciliations stay as they are. ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de «%1$@» (también las de la papelera) y sus pagos programados pasan a «%2$@», y su nombre y sus otros nombres pasan a ser otros nombres de «%2$@». La tarjeta «%1$@» se elimina. No se mueve dinero: ambas tarjetas son de una misma cuenta, así que los saldos y las conciliaciones quedan como están. ⌘Z lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations de « %1$@ » (y compris dans la corbeille) et ses paiements planifiés passent sur « %2$@ », et son nom et ses autres noms deviennent d'autres noms de « %2$@ ». La carte « %1$@ » est supprimée. Aucun argent ne bouge : les deux cartes sont du même compte, donc les soldes et rapprochements restent tels quels. ⌘Z rétablit tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni di “%1$@” (anche nel cestino) e i suoi pagamenti programmati vengono trasferiti a “%2$@”; il suo nome e gli altri nomi diventano altri nomi di “%2$@”. La carta “%1$@” viene eliminata. Non viene spostato denaro: entrambe le carte appartengono allo stesso conto, quindi saldi e riconciliazioni rimangono invariati. Premi ⌘Z per ripristinare tutto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” операциялары (себетте жатқандары да) және оның жоспарланған төлемдері “%2$@” картасына көшеді, ал оның атауы мен басқа атаулары “%2$@” картасының басқа атаулары болады. “%1$@” картасы жойылады. Ақша қозғалмайды: екі карта да бір есеп-шотқа тиесілі, сондықтан теңгерімдер мен салыстырулар өзгермейді. ⌘Z бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” картасынын операциялары (таштандыдагылар да) жана пландалган төлөмдөрү “%2$@” картасына өтөт, ал эми аты жана башка аттары “%2$@” картасынын башка аттарына кошулат. “%1$@” картасы өчүрүлөт. Акча которулбайт: эки карта тең бир эсепке таандык, ошондуктан калдыктар жана салыштыруулар өзгөрбөйт. ⌘Z баарын калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje karty „%1$@” (także te w koszu) i jej zaplanowane płatności zostaną przeniesione do „%2$@”, a jej nazwa i inne nazwy staną się innymi nazwami karty „%2$@”. Karta „%1$@” zostanie usunięta. Środki nie zostaną przeniesione: obie karty należą do jednego konta, więc salda i uzgodnienia pozostaną bez zmian. ⌘Z przywróci wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações de “%1$@” (inclusive na lixeira) e seus pagamentos agendados serão movidos para “%2$@”. Seu nome e outros nomes passarão a ser outros nomes de “%2$@”. O cartão “%1$@” será apagado. Nenhum dinheiro será movido: os dois cartões pertencem à mesma conta, então os saldos e as conciliações permanecerão iguais. Use ⌘Z para restaurar tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции карты «%1$@» (и в корзине) и её платежи перейдут на «%2$@», а её название и другие названия станут другими названиями «%2$@». Карта «%1$@» удалится. Деньги не двигаются: обе карты одного счёта, остатки и сверки не меняются. ⌘Z вернёт всё."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” kartının işlemleri (çöp kutusundakiler de) ve planlanmış ödemeleri “%2$@” kartına taşınır; adı ve diğer adları “%2$@” kartının diğer adları olur. “%1$@” kartı silinir. Para taşınmaz: Her iki kart da aynı hesaba ait olduğundan bakiyeler ve mutabakatlar değişmez. ⌘Z ile tümünü geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції «%1$@» (у тому числі в кошику) і його заплановані платежі переходять на «%2$@», а його назва та інші назви стають іншими назвами «%2$@». Картка «%1$@» видаляється. Гроші не рухаються: обидві картки належать одному рахунку, тож залишки й звірки лишаються як є. ⌘Z поверне все."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” operatsiyalari (savatdagilari ham) va rejalashtirilgan to‘lovlari “%2$@” kartasiga o‘tadi; uning nomi va boshqa nomlari “%2$@” kartasining boshqa nomlariga aylanadi. “%1$@” kartasi o‘chiriladi. Mablag‘ ko‘chmaydi: ikkala karta bir hisobga tegishli, shuning uchun qoldiq va solishtirishlar o‘zgarmaydi. ⌘Z hammasini tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」的交易（包括垃圾桶中的交易）和排定付款會移至「%2$@」，其名稱及其他名稱會成為「%2$@」的其他名稱。卡片「%1$@」會被刪除。兩張卡片屬於同一帳戶，因此資金不會移動，餘額和對帳紀錄也不會改變。按下 ⌘Z 可還原所有內容。"
          }
        }
      }
    },
    "card.merge.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі “%1$@” (таксама ў сметніцы) і яе планавыя плацяжы пяройдуць на “%2$@”, а назва і іншыя назвы стануць іншымі назвамі “%2$@”. Карта “%1$@” будзе выдалена. Грошы не перамяшчаюцца: карты належаць аднаму рахунку, таму балансы і зверкі не змяняюцца. “Адмяніць” усё адновіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge von „%1$@“ (auch im Papierkorb) und ihre geplanten Zahlungen wandern zu „%2$@“, und ihr Name sowie ihre weiteren Namen werden weitere Namen von „%2$@“. Die Karte „%1$@“ wird gelöscht. Es wird kein Geld bewegt: Beide Karten gehören zu einem Konto, daher bleiben Salden und Abgleiche, wie sie sind. „Rückgängig“ holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations of “%1$@” (in the bin too) and its scheduled payments move to “%2$@”, and its name and other names become other names of “%2$@”. The card “%1$@” is deleted. No money moves: both cards are of one account, so balances and reconciliations stay as they are. “Undo” brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de «%1$@» (también las de la papelera) y sus pagos programados pasan a «%2$@», y su nombre y sus otros nombres pasan a ser otros nombres de «%2$@». La tarjeta «%1$@» se elimina. No se mueve dinero: ambas tarjetas son de una misma cuenta, así que los saldos y las conciliaciones quedan como están. «Deshacer» lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations de « %1$@ » (y compris dans la corbeille) et ses paiements planifiés passent sur « %2$@ », et son nom et ses autres noms deviennent d'autres noms de « %2$@ ». La carte « %1$@ » est supprimée. Aucun argent ne bouge : les deux cartes sont du même compte, donc les soldes et rapprochements restent tels quels. « Annuler » rétablit tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni di “%1$@” (anche nel cestino) e i suoi pagamenti programmati vengono trasferiti a “%2$@”; il suo nome e gli altri nomi diventano altri nomi di “%2$@”. La carta “%1$@” viene eliminata. Non viene spostato denaro: entrambe le carte appartengono allo stesso conto, quindi saldi e riconciliazioni rimangono invariati. Tocca “Annulla” per ripristinare tutto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” операциялары (себетте жатқандары да) және оның жоспарланған төлемдері “%2$@” картасына көшеді, ал оның атауы мен басқа атаулары “%2$@” картасының басқа атаулары болады. “%1$@” картасы жойылады. Ақша қозғалмайды: екі карта да бір есеп-шотқа тиесілі, сондықтан теңгерімдер мен салыстырулар өзгермейді. «Болдырмау» бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” картасынын операциялары (таштандыдагылар да) жана пландалган төлөмдөрү “%2$@” картасына өтөт, ал эми аты жана башка аттары “%2$@” картасынын башка аттарына кошулат. “%1$@” картасы өчүрүлөт. Акча которулбайт: эки карта тең бир эсепке таандык, ошондуктан калдыктар жана салыштыруулар өзгөрбөйт. “Артка кайтаруу” баарын калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje karty „%1$@” (także te w koszu) i jej zaplanowane płatności zostaną przeniesione do „%2$@”, a jej nazwa i inne nazwy staną się innymi nazwami karty „%2$@”. Karta „%1$@” zostanie usunięta. Środki nie zostaną przeniesione: obie karty należą do jednego konta, więc salda i uzgodnienia pozostaną bez zmian. „Cofnij” przywróci wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações de “%1$@” (inclusive na lixeira) e seus pagamentos agendados serão movidos para “%2$@”. Seu nome e outros nomes passarão a ser outros nomes de “%2$@”. O cartão “%1$@” será apagado. Nenhum dinheiro será movido: os dois cartões pertencem à mesma conta, então os saldos e as conciliações permanecerão iguais. Use “Desfazer” para restaurar tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции карты «%1$@» (и в корзине) и её платежи перейдут на «%2$@», а её название и другие названия станут другими названиями «%2$@». Карта «%1$@» удалится. Деньги не двигаются: обе карты одного счёта, остатки и сверки не меняются. «Отменить» вернёт всё."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” kartının işlemleri (çöp kutusundakiler de) ve planlanmış ödemeleri “%2$@” kartına taşınır; adı ve diğer adları “%2$@” kartının diğer adları olur. “%1$@” kartı silinir. Para taşınmaz: Her iki kart da aynı hesaba ait olduğundan bakiyeler ve mutabakatlar değişmez. “Geri Al” ile tümünü geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції «%1$@» (у тому числі в кошику) і його заплановані платежі переходять на «%2$@», а його назва та інші назви стають іншими назвами «%2$@». Картка «%1$@» видаляється. Гроші не рухаються: обидві картки належать одному рахунку, тож залишки й звірки лишаються як є. «Скасувати» поверне все."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” operatsiyalari (savatdagilari ham) va rejalashtirilgan to‘lovlari “%2$@” kartasiga o‘tadi; uning nomi va boshqa nomlari “%2$@” kartasining boshqa nomlariga aylanadi. “%1$@” kartasi o‘chiriladi. Mablag‘ ko‘chmaydi: ikkala karta bir hisobga tegishli, shuning uchun qoldiq va solishtirishlar o‘zgarmaydi. “Bekor qilish” hammasini tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」的交易（包括垃圾桶中的交易）和排定付款會移至「%2$@」，其名稱及其他名稱會成為「%2$@」的其他名稱。卡片「%1$@」會被刪除。兩張卡片屬於同一帳戶，因此資金不會移動，餘額和對帳紀錄也不會改變。使用「復原」可還原所有內容。"
          }
        }
      }
    },
    "card.merge.moves": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перанос на захаваную карту: аперацый — %1$lld, планавых плацяжоў — %2$lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die behaltene Karte wandern: Vorgänge — %1$lld, geplante Zahlungen — %2$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving to the kept card: operations — %1$lld, scheduled payments — %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa a la tarjeta que se conserva: operaciones — %1$lld, pagos programados — %2$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers la carte conservée : opérations — %1$lld, paiements planifiés — %2$lld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da trasferire alla carta mantenuta: operazioni — %1$lld, pagamenti programmati — %2$lld"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалатын картаға көшеді: операциялар — %1$lld, жоспарланған төлемдер — %2$lld"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сакталган картага өтөт: операциялар — %1$lld, пландалган төлөмдөр — %2$lld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoszone do zachowanej karty: operacje — %1$lld, zaplanowane płatności — %2$lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mover para o cartão mantido: operações — %1$lld, pagamentos agendados — %2$lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдут на оставшуюся карту: операций — %1$lld, плановых платежей — %2$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunacak karta taşınacaklar: işlem — %1$lld, planlanmış ödeme — %2$lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На картку, що лишається: операцій — %1$lld, запланованих платежів — %2$lld"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Saqlanadigan kartaga o‘tadi: operatsiyalar — %1$lld, rejalashtirilgan to‘lovlar — %2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移至保留的卡片：交易 %1$lld 筆，排定付款 %2$lld 筆"
          }
        }
      }
    },
    "card.merge.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карту ў архіве нельга аб'яднаць: спачатку аднавіце яе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte im Archiv wird nicht zusammengeführt: Holen Sie sie zuerst zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card in the archive is not merged: bring it back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta del archivo no se fusiona: recupérela antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte aux archives ne se fusionne pas : ramenez-la d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta archiviata non può essere unita: ripristinala prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы карта біріктірілмейді: алдымен оны қайтарыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивдеги картаны бириктирүү мүмкүн эмес: адегенде аны калыбына келтириңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć karty z archiwum. Najpierw ją przywróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão arquivado não pode ser combinado: restaure-o primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карту в архиве объединить нельзя — сначала верните её."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivdeki kart birleştirilemez: Önce kartı geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка в архіві не зливається: спершу поверніть її."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdagi kartani birlashtirib bo‘lmaydi: avval uni tiklang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法合併已封存的卡片，請先還原。"
          }
        }
      }
    },
    "card.merge.refusal.otherAccount": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна аб'яднаць толькі карты аднаго рахунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammengeführt werden nur Karten eines Kontos."
          }
        },
        "en": {
