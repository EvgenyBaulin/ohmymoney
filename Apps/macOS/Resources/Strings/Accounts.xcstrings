    "account.balance.creditHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine Kreditkarte tippen Sie den Betrag, den Sie der Bank schulden, mit einem Minus: −30.000."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a credit card, type what you owe the bank with a minus: −30,000."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік картада банкке берешегіңізді минуспен теріңіз: −30,000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кредитной карты впишите долг банку со знаком минус: −30,000."
          }
        }
      }
    },
    "account.credit.available": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar %1$@ von %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available %1$@ of %2$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ішінен %1$@ қолжетімді"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно %1$@ из %2$@"
          }
        }
      }
    },
    "account.credit.cashNow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargeld oder Überweisung am %1$@: %2$@ — Zinsen laufen sofort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash or transfer on %1$@: %2$@ — interest runs at once"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күні қолма-қол ақша немесе аударым: %2$@ — пайыз бірден есептеледі"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие или перевод %1$@: %2$@ — проценты пойдут сразу"
          }
        }
      }
    },
    "account.credit.cashRate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinssatz auf Bargeld und Überweisungen, % pro Jahr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate on cash and transfers, % a year"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолма-қол ақша мен аударымдағы мөлшерлеме, жылына %"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка на снятие и переводы, % годовых"
          }
        }
      }
    },
    "account.credit.cashWithoutGrace": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargeld und Überweisungen haben keine zinsfreie Frist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash and transfers have no grace period"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолма-қол ақша мен аударымдарда кейінге қалдыру кезеңі жоқ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие и переводы без льготного периода"
          }
        }
      }
    },
    "account.credit.category": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditkartenzinsen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credit card interest"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта бойынша пайыз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты по кредитке"
          }
        }
      }
    },
    "account.credit.dayLast": {
      "extractionState": "manual",
      "localizations": {
