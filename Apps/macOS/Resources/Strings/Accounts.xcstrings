    "cashback.settings.header": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie die Bank auszahlt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the bank pays"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк қалай төлейді"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как банк платит"
          }
        }
      }
    },
    "cashback.settings.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rundung wird auf den Cashback jedes Kaufs angewendet. Der Tag ist der Tag des nächsten Monats, bis zu dem die Bank auszahlt. Punkte zählen als Währung ihres Kontos, eins zu eins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rounding is applied to the cashback of each purchase. The day is the day of the next month the bank pays by. Points count as the currency of their account, one to one."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дөңгелектеу әр сатып алудың кешбэгіне қолданылады. Күн — банк төлейтін келесі айдың күні. Ұпайлар өз есеп-шотының валютасы ретінде, бірден бірге саналады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Округление применяется к кэшбэку каждой покупки. День — до какого числа следующего месяца банк платит. Баллы считаются в валюте их счёта, один к одному."
          }
        }
      }
    },
    "cashback.sheet.accountHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln des Kontos gelten für alle seine Karten, sofern eine Karte nicht eine eigene Regel für denselben Monat und dieselbe Kategorie hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account’s rules hold for all its cards, unless a card has a rule of its own for the same month and category."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттың ережелері оның барлық карталарына қолданылады, егер картаның сол ай мен санат үшін өз ережесі болмаса."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила счёта действуют для всех его карт, если у карты нет своего правила на тот же месяц и категорию."
          }
        }
      }
    },
    "cashback.sheet.addRule": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel hinzufügen"
          }
