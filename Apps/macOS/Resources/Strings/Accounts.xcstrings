    },
    "account.group.holdsMain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is in this group, so it always counts in the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal está en este grupo, así que siempre cuenta en el resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal se trouve dans ce groupe, il compte donc toujours dans le récapitulatif."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе основной счёт, поэтому она всегда в общей сводке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок є в цій групі, тому він завжди враховується в підсумку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale è in questo gruppo, quindi è sempre incluso nel riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот осы топта, сондықтан ол қорытындыда әрқашан есептеледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак у гэтай групе, таму яна заўсёды ўлічваецца ў зводцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto ist in dieser Gruppe, deshalb zählt sie immer in der Übersicht mit."
          }
        }
      }
    },
    "account.group.inSummary": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
