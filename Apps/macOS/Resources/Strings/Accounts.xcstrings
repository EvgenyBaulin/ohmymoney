    "accounts.orderHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas hesab bütün siyahı və menyularda həmişə birincidir. Digərlərini istədiyiniz sıraya sürüşdürün və ya əlifba sırası ilə düzün."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак заўсёды першы ва ўсіх спісах і меню. Перацягніце астатнія ў патрэбны парадак або адсартуйце паводле алфавіта."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní účet je vždy první v každém seznamu a nabídce. Ostatní přetáhněte do požadovaného pořadí nebo je seřaďte abecedně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto steht immer an erster Stelle, in jeder Liste und jedem Menü. Ziehen Sie die anderen in die gewünschte Reihenfolge oder sortieren Sie sie alphabetisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is always first, in every list and menu. Drag the others into the order you like, or sort them alphabetically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal siempre va primera, en todas las listas y menús. Arrastre las demás al orden que prefiera, o ordénelas alfabéticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal est toujours en premier, dans chaque liste et chaque menu. Faites glisser les autres dans l'ordre souhaité, ou triez-les par ordre alphabétique."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գլխավոր հաշիվը միշտ առաջինն է բոլոր ցուցակներում և ընտրացանկերում։ Քաշեք մյուսները ցանկալի հերթականությամբ կամ դասավորեք այբբենական։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale è sempre al primo posto in tutti gli elenchi e i menu. Trascina gli altri nell’ordine desiderato oppure ordinali alfabeticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイン口座はすべてのリストとメニューで常に先頭に表示されます。ほかの口座はドラッグして並べ替えるか、名前順に並べることができます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავარი ანგარიში ყოველთვის პირველია ყველა სიასა და მენიუში. დანარჩენები სასურველი რიგით გადაიტანეთ ან ანბანით დაალაგეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот әр тізімде және мәзірде әрқашан бірінші тұрады. Басқаларын қалаған тәртіпке сүйреңіз немесе әліпби бойынша сұрыптаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 계좌는 모든 목록과 메뉴에서 항상 맨 앞에 표시됩니다. 나머지는 원하는 순서로 드래그하거나 이름순으로 정렬하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги эсеп бардык тизмелерде жана менюларда дайыма биринчи турат. Калгандарын каалаган иретте сүйрөңүз же алфавит боюнча иреттеңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoofdrekening staat altijd bovenaan, in elke lijst en elk menu. Sleep de andere in de gewenste volgorde of sorteer ze alfabetisch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto główne jest zawsze pierwsze na każdej liście i w każdym menu. Przeciągnij pozostałe konta, aby ustawić ich kolejność, lub posortuj je alfabetycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal sempre aparece primeiro em todas as listas e menus. Arraste as outras para ordená-las como quiser ou ordene-as alfabeticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal aparece sempre primeiro, em todas as listas e menus. Arraste as restantes para a ordem pretendida ou ordene-as alfabeticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт всегда первый — во всех списках и меню. Остальные перетащите в удобном порядке или отсортируйте по алфавиту."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби асосӣ дар ҳама рӯйхатҳо ва менюҳо ҳамеша аввал аст. Дигарҳоро ба тартиби дилхоҳ кашед ё аз рӯйи алифбо ҷудо кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana hesap tüm listelerde ve menülerde her zaman ilk sıradadır. Diğerlerini istediğiniz sıraya sürükleyin veya alfabetik sıralayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок завжди перший у кожному списку й меню. Перетягніть інші в зручний для вас порядок або впорядкуйте їх за алфавітом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy hisob barcha ro‘yxat va menyularda doim birinchi turadi. Qolganlarini istalgan tartibga torting yoki alifbo bo‘yicha saralang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主账户在所有列表和菜单中始终排在首位。拖动其他账户以调整顺序，或按字母顺序排序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要帳戶在所有列表和選單中都會排在最前面。拖移其他帳戶來排序，或依字母順序排列。"
          }
        }
      }
    },
