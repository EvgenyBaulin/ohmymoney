    "accounts.banksHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank is the top of «bank → account → card». A new bank brings its first account and card; a list of choices names a bank with one account and one card by the bank alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco es el nivel superior de «banco → cuenta → tarjeta». Un banco nuevo trae su primera cuenta y tarjeta; en una lista de opciones, un banco con una cuenta y una tarjeta se nombra solo por el banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк — верхний уровень «банк → счёт → карта». Новый банк приносит первый счёт и карту; в списках выбора банк с одним счётом и одной картой назван просто по имени банка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк — це верхній рівень «банк → рахунок → картка». Новий банк додає свій перший рахунок і картку; у списку вибору банк називається лише за назвою, із одним рахунком і однією карткою."
          }
        }
      }
    },
