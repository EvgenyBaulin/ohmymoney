      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No debt on the card"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долга по карте нет"
          }
        }
      }
