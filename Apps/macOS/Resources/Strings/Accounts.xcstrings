    "transfer.sheet.atmFeeLaid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank fee: %@ — written by itself, by the terms of the card abroad. Check it against the statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comisión del banco: %@ — se anota sola, según las condiciones de la tarjeta en el extranjero. Compárela con el extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frais de la banque : %@ — notés automatiquement selon les conditions de la carte à l'étranger. Vérifiez-les sur le relevé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия банка: %@ — запишется сама, по условиям карты за границей. Сверьте с выпиской."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія банку: %@ — записана сама, за умовами картки за кордоном. Звірте з випискою."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Commissione bancaria: %@ — registrata automaticamente in base alle condizioni della carta all'estero. Verificala nell'estratto conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк комиссиясы: %@ — шетелдегі картаның шарттары бойынша өзі жазылды. Үзіндімен тексеріңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камісія банка: %@ — запісана аўтаматычна па ўмовах карты за мяжой. Зверце з выпіскай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankgebühr: %@ — von selbst eingetragen, nach den Bedingungen der Karte im Ausland. Prüfen Sie sie anhand der Abrechnung."
