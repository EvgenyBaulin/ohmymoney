    "account.refusal.unreadableBalance": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ balansı məbləğ kimi oxunmur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс у %@ не распазнаны як сума."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek v měně %@ není platná částka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo in %@ ist kein lesbarer Betrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance in %@ does not read as an amount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo en %@ no se lee como importe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde en %@ ne se lit pas comme un montant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ արժույթով մնացորդը վավեր գումար չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo in %@ non è un importo valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の残高を金額として読み取れません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ვალუტაში ნაშთი თანხას არ შეესაბამება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ валютасындағы теңгерім соманы білдірмейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 잔액을 금액으로 읽을 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ боюнча калдык сумма катары таанылган жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo in %@ wordt niet als bedrag herkend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo w walucie %@ nie jest prawidłową kwotą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo em %@ não é um valor válido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo em %@ não é um montante válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в %@ не читается как сумма."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақия бо %@ ҳамчун маблағ хонда намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyesi tutar olarak okunamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок у %@ не вдалося прочитати як суму."
          }
        },
        "uz": {
          "stringUnit": {
