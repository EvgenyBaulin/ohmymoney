            "value": "移至保留的卡片：交易 %1$lld 筆，排定付款 %2$lld 筆"
          }
        }
      }
    },
    "card.merge.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdəki kart birləşdirilə bilməz: əvvəlcə onu bərpa edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карту ў архіве нельга аб'яднаць: спачатку аднавіце яе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivovanou kartu nelze sloučit. Nejprve ji obnovte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte im Archiv wird nicht zusammengeführt: Holen Sie sie zuerst zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card in the archive is not merged: bring it back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta del archivo no se fusiona: recupérela antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte aux archives ne se fusionne pas : ramenez-la d'abord."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվացված քարտը հնարավոր չէ միավորել․ նախ վերականգնեք այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta archiviata non può essere unita: ripristinala prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済みのカードは結合できません。先に復元してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივში მყოფი ბარათის შერწყმა შეუძლებელია: ჯერ აღადგინეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы карта біріктірілмейді: алдымен оны қайтарыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 카드는 병합할 수 없습니다. 먼저 복원하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивдеги картаны бириктирүү мүмкүн эмес: адегенде аны калыбына келтириңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gearchiveerde kaart kan niet worden samengevoegd. Zet deze eerst terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć karty z archiwum. Najpierw ją przywróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão arquivado não pode ser combinado: restaure-o primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível unir um cartão arquivado: restaure-o primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карту в архиве объединить нельзя — сначала верните её."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Корти бойгонишударо якҷоя кардан мумкин нест: аввал онро барқарор кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivdeki kart birleştirilemez: Önce kartı geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка в архіві не зливається: спершу поверніть її."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdagi kartani birlashtirib bo‘lmaydi: avval uni tiklang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法合并已归档的卡片，请先恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法合併已封存的卡片，請先還原。"
          }
        }
      }
    },
    "card.merge.refusal.otherAccount": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız eyni hesaba aid kartlar birləşdirilə bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна аб'яднаць толькі карты аднаго рахунку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
