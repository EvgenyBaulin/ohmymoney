    "bank.editor.newHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank standart valyutada, onunla eyni adlı ilk hesab və kartla yaradılır. Hesabın növünü, valyutalarını və balansını sonra dəyişmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ствараецца з першым рахункам і картай, абодва з яго назвай, у прадвызначанай валюце. Тып, валюты і баланс рахунку можна змяніць пазней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka se vytvoří s prvním účtem a kartou stejného názvu ve výchozí měně. Typ, měny a zůstatek účtu můžete později změnit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank kommt mit ihrem ersten Konto und ihrer ersten Karte, beide heißen wie sie, in der Standardwährung. Art, Währungen und Saldo des Kontos lassen sich danach ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank comes with its first account and card, both called like it, in the default currency. The kind, the currencies and the balance of the account can be changed afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco llega con su primera cuenta y tarjeta, ambas con su nombre, en la divisa principal. El tipo, las divisas y el saldo de la cuenta se pueden cambiar después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque arrive avec son premier compte et sa carte, nommés comme elle, dans la devise par défaut. Le type, les devises et le solde du compte peuvent être modifiés ensuite."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկը ստեղծվում է առաջին հաշվով և քարտով՝ բանկի անունով և լռելյայն արժույթով։ Հետագայում կարելի է փոխել հաշվի տեսակը, արժույթներն ու մնացորդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca viene creata con un primo conto e una prima carta, entrambi con lo stesso nome e nella valuta predefinita. Il tipo, le valute e il saldo del conto possono essere modificati in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行と同じ名前の口座とカードが、デフォルト通貨で作成されます。口座の種類、通貨、残高は後から変更できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკს დაემატება პირველი ანგარიში და ბარათი იმავე სახელით და ნაგულისხმევი ვალუტით. ანგარიშის ტიპის, ვალუტებისა და ნაშთის შეცვლა მოგვიანებით შეგიძლიათ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк өзінің алғашқы есеп-шотымен және картасымен келеді, екеуі де банк атымен, әдепкі валютада. Есеп-шоттың түрін, валюталарын және теңгерімін кейін өзгертуге болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행을 추가하면 기본 통화로 된 첫 계좌와 카드가 같은 이름으로 생성됩니다. 계좌의 종류, 통화 및 잔액은 나중에 변경할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк менен кошо анын атындагы биринчи эсеп жана карта демейки валютада түзүлөт. Эсептин түрүн, валюталарын жана калдыгын кийин өзгөртсө болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bank krijgt een eerste rekening en kaart met dezelfde naam, in de standaardvaluta. Je kunt het type, de valuta's en het saldo van de rekening later wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank zostanie dodany z pierwszym kontem i kartą o tej samej nazwie, w domyślnej walucie. Rodzaj, waluty i saldo konta można później zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco vem com sua primeira conta e cartão, ambos com o mesmo nome do banco e na moeda padrão. O tipo, as moedas e o saldo da conta podem ser alterados depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco é criado com uma conta e um cartão com o mesmo nome, na moeda predefinida. Pode alterar o tipo, as moedas e o saldo da conta mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с банком появятся первый счёт и карта с тем же названием, в валюте по умолчанию. Вид, валюты и остаток счёта можно поправить потом."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк бо суратҳисоб ва корти аввалия, бо номи бонк ва асъори пешфарз сохта мешавад. Навъ, асъорҳо ва бақияи суратҳисобро баъдтар тағйир додан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka, varsayılan para biriminde ve bankayla aynı adda bir hesap ve kartla oluşturulur. Hesabın türü, para birimleri ve bakiyesi daha sonra değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк створюється з першим рахунком і карткою, які називаються так само, у валюті за замовчуванням. Тип, валюти й залишок рахунку можна змінити згодом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank bilan birga standart valyutada, bank nomidagi birinchi hisob va karta yaratiladi. Hisob turi, valyutalari va balansini keyin o‘zgartirish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新银行将包含一个账户和一张卡，名称均与银行相同，并使用默认货币。之后可更改账户类型、货币和余额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會以預設貨幣建立第一個帳戶和卡片，兩者皆使用銀行名稱。之後可更改帳戶類型、貨幣和餘額。"
          }
        }
      }
    },
