        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсеп архивде — адегенде аны калыбына келтириңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rekening is gearchiveerd. Zet deze eerst terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto jest w archiwum — najpierw je przywróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta está arquivada. Restaure-a primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta está arquivada — restaure-a primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт в архиве — сначала верните его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоб дар бойгонӣ аст — аввал онро барқарор кунед."
