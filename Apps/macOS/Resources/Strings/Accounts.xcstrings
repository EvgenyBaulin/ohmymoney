          "stringUnit": {
            "state": "translated",
            "value": "Куди"
          }
        }
      }
    },
    "account.merge.mainMoves": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» becomes the main account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» pasa a ser la cuenta principal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основным станет «%@»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» стає основним рахунком"
          }
        }
      }
    },
    "account.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations, transfers, payments and debt entries move to «%1$@», and «%2$@» goes to the archive with a zero balance; its name becomes another name of «%1$@». ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones, transferencias, pagos y apuntes de deuda pasan a «%1$@», y «%2$@» va al archivo con saldo cero; su nombre pasa a ser otro nombre de «%1$@». ⌘Z devuelve todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции, переводы, платежи и записи долгов перейдут на «%1$@», а «%2$@» уйдёт в архив с нулевым остатком; его название станет другим названием «%1$@». ⌘Z вернёт всё как было."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції, перекази, платежі та записи боргів переходять на «%1$@», а «%2$@» іде в архів з нульовим залишком; його назва стає ще однією назвою «%1$@». ⌘Z повертає все назад."
          }
        }
      }
    },
    "account.merge.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations, transfers, payments and debt entries move to «%1$@», and «%2$@» goes to the archive with a zero balance; its name becomes another name of «%1$@». “Undo” brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones, transferencias, pagos y apuntes de deuda pasan a «%1$@», y «%2$@» va al archivo con saldo cero; su nombre pasa a ser otro nombre de «%1$@». «Deshacer» devuelve todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции, переводы, платежи и записи долгов перейдут на «%1$@», а «%2$@» уйдёт в архив с нулевым остатком; его название станет другим названием «%1$@». «Отменить» вернёт всё как было."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції, перекази, платежі та записи боргів переходять на «%1$@», а «%2$@» іде в архів з нульовим залишком; його назва стає ще однією назвою «%1$@». «Скасувати» повертає все назад."
          }
        }
      }
    },
    "account.merge.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge «%@» with…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionar «%@» con…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединить «%@» с…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Злити «%@» з…"
          }
        }
      }
    },
    "account.merge.transfers": {
      "extractionState": "manual",
      "localizations": {
