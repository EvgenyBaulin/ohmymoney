          "stringUnit": {
            "state": "translated",
            "value": "此分组下没有账户。按 ⌘Z 可将其恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此群組沒有帳戶。按下 ⌘Z 可還原。"
