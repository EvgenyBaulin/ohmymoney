          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta está arquivada. Restaure-a para fazer transferências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт в архиве — верните его, чтобы переводить на него или с него."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap arşivde. Transfer yapmak için hesabı geri getirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок в архіві: поверніть його, щоб переказувати на нього або з нього."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob arxivda: undan yoki unga o‘tkazma qilish uchun uni qaytaring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶已封存；請先恢復帳戶，再轉入或轉出。"
          }
        }
      }
    },
    "transfer.refusal.feeMoneyBack": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За камісію гэтага пераводу ўжо вярнулі грошы: нельга змяняць суму, валюту ці прыбіраць яе. Спачатку выдаліце вяртанне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Gebühr dieser Überweisung wurde bereits Geld zurückgegeben: Betrag und Währung lassen sich nicht ändern, und sie kann nicht entfernt werden. Löschen Sie zuerst diese Rückzahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money was already given back for this transfer's fee: its amount and currency can't change, and it can't be taken off. Delete that money back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se devolvió dinero por la comisión de esta transferencia: su importe y divisa no pueden cambiar, y no puede quitarse. Primero elimine esa devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement a déjà été fait sur les frais de ce virement : son montant et sa devise ne peuvent plus changer, et il ne peut pas être retiré. Supprimez d'abord ce remboursement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già stato restituito denaro per la commissione di questo trasferimento: non puoi modificarne l'importo o la valuta, né rimuoverla. Elimina prima la restituzione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл аударымның комиссиясына ақша қайтарылған: оның сомасы мен валютасы өзгере алмайды, және ол алынып тасталмайды. Алдымен сол қайтарылған ақшаны жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул которуунун комиссиясы үчүн акча кайтарылып берилген: анын суммасын же валютасын өзгөртүүгө жана аны алып салууга болбойт. Адегенде кайтарылган акчаны өчүрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot opłaty za ten przelew został już wypłacony. Nie można zmienić jej kwoty ani waluty ani jej usunąć. Najpierw usuń zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já houve devolução de dinheiro para a tarifa desta transferência. O valor e a moeda da tarifa não podem ser alterados, e ela não pode ser removida. Apague a devolução primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За комиссию этого перевода уже вернули деньги: её сумму и валюту не изменить, а саму комиссию не убрать. Сначала удалите этот возврат денег."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu transferin ücreti için para iadesi zaten yapıldı: ücretin tutarı ve para birimi değiştirilemez veya ücret kaldırılamaz. Önce para iadesini silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За комісію цього переказу вже повернуто гроші: її суму й валюту не можна змінити, і її не можна зняти. Спершу видаліть це повернення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu o‘tkazma komissiyasi uchun pul allaqachon qaytarilgan: komissiya summasi va valyutasini o‘zgartirib yoki uni olib tashlab bo‘lmaydi. Avval qaytarilgan pulni o‘chiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此轉帳的手續費已有退款，其金額和貨幣無法更改，也無法移除。請先刪除該退款。"
          }
        }
      }
    },
    "transfer.refusal.feeRefunded": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На камісію гэтага пераводу запісана вяртанне: нельга прыбіраць камісію, памяншаць ніжэй за вернутае, змяняць валюту ці выдаляць перавод разам з ёй. Спачатку выдаліце вяртанне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Gebühr dieser Überweisung ist eine Erstattung erfasst: Die Gebühr lässt sich nicht entfernen, nicht kleiner machen als die Erstattung oder in eine andere Währung verschieben, und die Überweisung lässt sich mit ihr nicht löschen. Löschen Sie zuerst die Erstattung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund was recorded against this transfer's fee: the fee can't be taken off, made smaller than what was refunded or moved to another currency, and the transfer can't be deleted with it. Delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una devolución registrada sobre la comisión de esta transferencia: la comisión no puede quitarse, reducirse por debajo de lo devuelto ni pasar a otra divisa, y la transferencia no puede eliminarse con ella. Elimine antes la devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement a été noté sur les frais de ce virement : les frais ne peuvent pas être retirés, ramenés sous le montant remboursé ni passés dans une autre devise, et le virement ne peut pas être supprimé avec eux. Supprimez d'abord le remboursement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già stato registrato un rimborso per la commissione di questo trasferimento: non puoi rimuoverla, ridurla sotto l'importo rimborsato o cambiarne la valuta, né eliminare il trasferimento. Elimina prima il rimborso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл аударымның комиссиясына қайтару жазылған: комиссияны алып тастауға, қайтарылғаннан кіші етуге немесе басқа валютаға көшіруге болмайды, және аударымды онымен бірге жою мүмкін емес. Алдымен қайтаруды жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул которуунун комиссиясы боюнча кайтарым жазылган: комиссияны алып салууга, кайтарылган суммадан азайтууга же валютасын өзгөртүүгө болбойт. Комиссиясы бар которууну да өчүрүүгө болбойт. Адегенде кайтарымды өчүрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano zwrot opłaty za ten przelew. Nie można jej usunąć, zmniejszyć poniżej zwróconej kwoty ani zmienić jej waluty. Nie można też usunąć przelewu wraz z opłatą. Najpierw usuń zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um reembolso registrado para a tarifa desta transferência. A tarifa não pode ser removida, reduzida abaixo do valor reembolsado ou alterada para outra moeda, e a transferência não pode ser apagada enquanto a tarifa existir. Apague o reembolso primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На комиссию этого перевода оформлен возврат: её нельзя убрать, сделать меньше возвращённого или перевести в другую валюту, а перевод — удалить вместе с ней. Сначала удалите возврат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu transferin ücreti için bir iade kaydedildi: ücret kaldırılamaz, iade edilen tutarın altına düşürülemez veya para birimi değiştirilemez; transfer de ücretiyle birlikte silinemez. Önce iadeyi silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За комісію цього переказу записано повернення: її не можна зняти, зменшити нижче повернутої суми чи перенести в іншу валюту, і переказ разом із нею не видаляється. Спершу видаліть повернення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu o‘tkazma komissiyasi uchun qaytim qayd etilgan: komissiyani olib tashlab, qaytarilgan summadan kamaytirib yoki boshqa valyutaga o‘tkazib bo‘lmaydi. O‘tkazmani ham o‘chirib bo‘lmaydi. Avval qaytimni o‘chiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此轉帳的手續費已有退款記錄：無法移除手續費、將其調低至退款金額以下或更改貨幣，也無法刪除此轉帳。請先刪除退款。"
          }
        }
      }
    },
    "transfer.refusal.fromCurrency": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку спісання няма гэтай валюты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto, von dem das Geld abgeht, führt diese Währung nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account the money leaves does not hold this currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de la que sale el dinero no tiene esta divisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte d'où part l'argent ne détient pas cette devise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto di origine non contiene questa valuta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша кететін есеп-шотта бұл валюта жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча алынуучу эсепте бул валюта жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto źródłowe nie obsługuje tej waluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta de origem não aceita esta moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт, откуда уходят деньги, не держит эту валюту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranın çıktığı hesapta bu para birimi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок, з якого йдуть гроші, не має цієї валюти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul olinadigan hisobda bu valyuta yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉出帳戶不支援此貨幣。"
          }
        }
      }
    },
    "transfer.refusal.negativeFee": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камісія не можа быць меншай за нуль."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gebühr kann nicht unter null liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fee cannot be below zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión no puede ser menor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des frais ne peuvent pas être inférieurs à zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La commissione non può essere inferiore a zero."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия нөлден төмен бола алмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия нөлдөн аз болбойт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłata nie może być mniejsza od zera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarifa não pode ser menor que zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия не может быть меньше нуля."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücret sıfırın altında olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія не може бути меншою за нуль."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya noldan kam bo‘lishi mumkin emas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手續費不能小於零。"
          }
        }
      }
    },
    "transfer.refusal.noFrom": {
      "extractionState": "manual",
      "localizations": {
