    "accounts.groupsHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yekuna daxil edilməyən qrupun vəsaiti «Cəmi» və sərbəst məbləğə daxil edilmir; gəlir və xərcləri isə hər yerdə hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы групы па-за зводкай не ўваходзяць ва «Усяго» і свабодную суму; яе даходы і выдаткі ўлічваюцца ўсюды."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze ve skupině vynechané z přehledu se nezapočítávají do «Celkem» ani do volné částky; její příjmy a výdaje se nadále započítávají všude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe, die aus der Übersicht herausgenommen ist, hält ihr Geld aus „Gesamt“ und dem freien Betrag heraus; ihre Einnahmen und Ausgaben zählen überall weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group left out of the summary keeps its money out of «Total» and the free sum; its income and spending still count everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo fuera del resumen deja su dinero fuera de «Total» y de la suma libre; sus ingresos y gastos siguen contando en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe exclu du récapitulatif garde son argent hors de « Total » et de la somme libre ; ses revenus et dépenses comptent toujours partout."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփումից բացառված խմբի գումարը չի ներառվում «Ընդամենը» և ազատ գումարի մեջ, սակայն դրա եկամուտներն ու ծախսերը հաշվառվում են ամենուր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro di un gruppo escluso dal riepilogo non viene incluso nel «Totale» né nella somma disponibile; le entrate e le spese vengono comunque conteggiate ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集計から除外したグループの残高は「合計」と使える金額に含まれません。収入と支出は引き続き集計されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯამებიდან გამორიცხული ჯგუფის თანხა არ შედის «სულ» და თავისუფალ თანხაში; მისი შემოსავლები და ხარჯები ყველგან ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдан шығарылған топ өз ақшасын «Барлығынан» және бос қаржыдан тыс ұстайды; оның табысы мен шығысы әр жерде әлі есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요약에서 제외한 그룹의 금액은 «합계»와 사용 가능 금액에 포함되지 않습니다. 수입과 지출은 모든 곳에 계속 반영됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жыйынтыктан чыгарылган топтун акчасы «Бардыгы» жана бош суммага кошулбайт; анын кирешеси менен чыгашасы бардык жерде эсептеле берет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geld in een groep die is uitgesloten van het overzicht telt niet mee in «Totaal» en het vrije bedrag; inkomsten en uitgaven tellen wel overal mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środki grupy wyłączonej z podsumowania nie są uwzględniane w «Razem» ani w wolnej kwocie; jej przychody i wydatki nadal są wszędzie uwzględniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro de um grupo excluído do resumo não entra no «Total» nem no valor livre; suas receitas e despesas continuam sendo contabilizadas em todos os lugares."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro de um grupo excluído do resumo não entra no «Total» nem no montante disponível; as receitas e despesas continuam a contar em todo o lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги группы вне сводки не входят во «Всего» и в свободную сумму; её доходы и траты по-прежнему учитываются везде."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули гурӯҳе, ки ба ҷамъбаст дохил нест, ба «Ҳамагӣ» ва маблағи озод дохил намешавад; даромад ва хароҷоти он дар ҳама ҷо ба ҳисоб мераванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özete dahil edilmeyen bir grubun parası «Toplam»a ve kullanılabilir tutara katılmaz; gelir ve giderleri her yerde hesaba katılmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Група, вилучена з підсумку, тримає свої гроші поза «Усього» і вільною сумою; її доходи й витрати всюди враховуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumiy hisobga kiritilmagan guruhning mablag‘i «Jami» va erkin summaga qo‘shilmaydi; uning daromad va xarajatlari esa hamma joyda hisobga olinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不计入汇总的分组，其资金不会计入«合计»和可用金额；收入和支出仍会在各处计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不列入摘要的群組，其資金不會計入「總計」和可用金額；收入與支出仍會計入各處。"
          }
        }
      }
    },
