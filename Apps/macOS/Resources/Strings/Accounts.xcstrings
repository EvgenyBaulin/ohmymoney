    "card.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations of “%1$@” (in the bin too) and its scheduled payments move to “%2$@”, and its name and other names become other names of “%2$@”. The card “%1$@” is deleted. No money moves: both cards are of one account, so balances and reconciliations stay as they are. ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de «%1$@» (también las de la papelera) y sus pagos programados pasan a «%2$@», y su nombre y sus otros nombres pasan a ser otros nombres de «%2$@». La tarjeta «%1$@» se elimina. No se mueve dinero: ambas tarjetas son de una misma cuenta, así que los saldos y las conciliaciones quedan como están. ⌘Z lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations de « %1$@ » (y compris dans la corbeille) et ses paiements planifiés passent sur « %2$@ », et son nom et ses autres noms deviennent d'autres noms de « %2$@ ». La carte « %1$@ » est supprimée. Aucun argent ne bouge : les deux cartes sont du même compte, donc les soldes et rapprochements restent tels quels. ⌘Z rétablit tout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции карты «%1$@» (и в корзине) и её платежи перейдут на «%2$@», а её название и другие названия станут другими названиями «%2$@». Карта «%1$@» удалится. Деньги не двигаются: обе карты одного счёта, остатки и сверки не меняются. ⌘Z вернёт всё."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції «%1$@» (у тому числі в кошику) і його заплановані платежі переходять на «%2$@», а його назва та інші назви стають іншими назвами «%2$@». Картка «%1$@» видаляється. Гроші не рухаються: обидві картки належать одному рахунку, тож залишки й звірки лишаються як є. ⌘Z поверне все."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni di “%1$@” (anche nel cestino) e i suoi pagamenti programmati vengono trasferiti a “%2$@”; il suo nome e gli altri nomi diventano altri nomi di “%2$@”. La carta “%1$@” viene eliminata. Non viene spostato denaro: entrambe le carte appartengono allo stesso conto, quindi saldi e riconciliazioni rimangono invariati. Premi ⌘Z per ripristinare tutto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” операциялары (себетте жатқандары да) және оның жоспарланған төлемдері “%2$@” картасына көшеді, ал оның атауы мен басқа атаулары “%2$@” картасының басқа атаулары болады. “%1$@” картасы жойылады. Ақша қозғалмайды: екі карта да бір есеп-шотқа тиесілі, сондықтан теңгерімдер мен салыстырулар өзгермейді. ⌘Z бәрін қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі “%1$@” (таксама ў сметніцы) і яе планавыя плацяжы пяройдуць на “%2$@”, а назва і іншыя назвы стануць іншымі назвамі “%2$@”. Карта “%1$@” будзе выдалена. Грошы не перамяшчаюцца: карты належаць аднаму рахунку, таму балансы і зверкі не змяняюцца. ⌘Z усё адновіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge von „%1$@“ (auch im Papierkorb) und ihre geplanten Zahlungen wandern zu „%2$@“, und ihr Name sowie ihre weiteren Namen werden weitere Namen von „%2$@“. Die Karte „%1$@“ wird gelöscht. Es wird kein Geld bewegt: Beide Karten gehören zu einem Konto, daher bleiben Salden und Abgleiche, wie sie sind. ⌘Z holt alles zurück."
          }
        }
      }
    },
    "card.merge.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations of “%1$@” (in the bin too) and its scheduled payments move to “%2$@”, and its name and other names become other names of “%2$@”. The card “%1$@” is deleted. No money moves: both cards are of one account, so balances and reconciliations stay as they are. “Undo” brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de «%1$@» (también las de la papelera) y sus pagos programados pasan a «%2$@», y su nombre y sus otros nombres pasan a ser otros nombres de «%2$@». La tarjeta «%1$@» se elimina. No se mueve dinero: ambas tarjetas son de una misma cuenta, así que los saldos y las conciliaciones quedan como están. «Deshacer» lo devuelve todo."
          }
        },
        "fr": {
