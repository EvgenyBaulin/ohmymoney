    "cashback.refusal.pointsItself": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesab özünün xal hesabı ola bilməz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак не можа быць уласным балавым рахункам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet nemůže být vlastním bodovým účtem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konto kann nicht sein eigenes Punktekonto sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account cannot be its own points account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta no puede ser su propia cuenta de puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte ne peut pas être son propre compte de points."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշիվը չի կարող ինքն իր միավորների հաշիվը լինել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto non può essere il proprio conto punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ口座をポイント口座に指定することはできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიში ვერ იქნება საკუთარი ქულების ანგარიში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот өзінің ұпайлар есеп-шоты бола алмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 계좌를 포인트 계좌로 지정할 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсеп өзүнүн упайлар эсеби боло албайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rekening kan niet zijn eigen puntenrekening zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto nie może być własnym kontem punktowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta não pode ser sua própria conta de pontos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta não pode ser a sua própria conta de pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт не может быть своим счётом для баллов."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоб наметавонад ҳисоби холҳои худ бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hesap kendi puan hesabı olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок не може бути рахунком для власних балів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob o‘zi uchun ballar hisobi bo‘la olmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户不能作为自己的积分账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶不能作為自己的點數帳戶。"
          }
