    "account.points.compareBurn": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічыцца, што балы будуць патрачаны своечасова: праграма не ведае, калі яны згараюць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird angenommen, dass die Punkte rechtzeitig eingelöst werden. Die App kennt ihr Verfallsdatum nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points are counted as spent in time: the app does not know when they burn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se supone que los puntos se gastan a tiempo: la app no sabe cuándo caducan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points sont considérés comme utilisés à temps : l’app ne connaît pas leur date d’expiration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si presume che i punti vengano usati in tempo: l’app non sa quando scadono."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұпайлар уақытында жұмсалады деп есептеледі: қолданба олардың қашан күйіп кететінін білмейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakładamy, że punkty zostaną wykorzystane na czas. Aplikacja nie zna daty ich wygaśnięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos são considerados gastos a tempo: o app não sabe quando expiram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баллы считаются потраченными вовремя: когда они сгорают, расчёт не знает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puanların zamanında harcandığı varsayılır. Uygulama, sürelerinin ne zaman dolduğunu bilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вважається, що бали витрачаються вчасно: програма не знає, коли вони згорять."
          }
        }
      }
    },
