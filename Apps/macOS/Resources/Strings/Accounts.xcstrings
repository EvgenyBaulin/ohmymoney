    "account.merge.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "balance unknown"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "saldo desconocido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "остаток неизвестен"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "залишок невідомий"
          }
        }
      }
    },
    "account.merge.unknownHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance of this currency cannot be worked out. Enter it if you know it, or leave it empty and reconcile later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de esta divisa no se puede calcular. Introdúzcalo si lo conoce, o déjelo vacío y concilie más tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в этой валюте не посчитать. Введите его, если знаете, или оставьте пустым и сверьте позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок цієї валюти не можна розрахувати. Введіть його, якщо знаєте, або залиште порожнім і звірте пізніше."
          }
        }
      }
    },
    "account.refusal.balanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance of the account: money moved on it, but it was never reconciled. Reconcile it; at zero it can go to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie conoce el saldo de la cuenta: se movió dinero en ella, pero nunca se conció. Concíliela; con saldo cero puede pasar al archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток счёта неизвестен: по нему были движения, но его ни разу не сверяли. Сверьте счёт — с нулём его можно убрать в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок рахунку ніхто не знає: кошти на ньому рухалися, але його ніколи не звіряли. Звірте його; з нульовим залишком він може піти в архів."
          }
        }
      }
    },
    "account.refusal.bankHasLiveAccounts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank still has accounts outside the archive: move them to the archive first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco aún tiene cuentas fuera del archivo: pásalas antes al archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка есть счета не в архиве — сначала уберите в архив их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У банку ще є рахунки поза архівом: спершу перенесіть їх в архів."
          }
        }
      }
    },
    "account.refusal.bankInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, archived ones too, are under the bank: it can go to the archive, not be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cuentas, también archivadas, bajo el banco: puede pasar al archivo, pero no eliminarse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под банком есть счета, в том числе архивные: его можно убрать в архив, но не удалить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під банком є рахунки, в тому числі архівні: він може піти в архів, але не видалитися."
          }
        }
      }
    },
    "account.refusal.bankNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank with this name already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un banco con este nombre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк с таким названием уже есть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк із такою назвою вже є."
          }
        }
      }
    },
    "account.refusal.creditCardNeedsCard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card cannot be saved without a card. Give the card a name that nothing else has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito no se puede guardar sin tarjeta. Dé a la tarjeta un nombre que no use nada más."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитную карту нельзя сохранить без карты. Назовите карту так, как не называется ничего другого."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитну картку не можна зберегти без картки. Дайте картці назву, якої ні в кого немає."
          }
        }
      }
    },
    "account.refusal.currencyBalanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance in %@: money moved in it, but it was never reconciled. Reconcile the account; at zero the currency can go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie conoce el saldo en %@: se movió dinero en ella, pero nunca se conció. Concilie la cuenta; con saldo cero la divisa puede quitarse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в %@ неизвестен: движения были, но валюту ни разу не сверяли. Сверьте счёт — с нулём валюту можно убрать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок у %@ ніхто не знає: кошти в ній рухалися, але їх ніколи не звіряли. Звірте рахунок; з нульовим залишком валюту можна прибрати."
          }
        }
      }
    },
    "account.refusal.currencyNotEnabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is switched off in Settings → Currencies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desactivada en Ajustes → Divisas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта %@ выключена в Настройках → Валюты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вимкнено в «Налаштування → Валюти»."
          }
        }
      }
    },
    "account.refusal.deletesWithMoney": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has money on it. Transfer the balance to another account and archive this one, or reconcile it to zero without recording the difference and then delete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta cuenta hay dinero. Transfiera el saldo a otra cuenta y archive esta, o concíliela a cero sin registrar la diferencia y después elimínela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги. Переведите остаток на другой счёт и уберите этот в архив — или сверьте его до нуля без записи разницы, тогда его можно удалить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку є гроші. Перекажіть залишок на інший рахунок і перенесіть цей в архів або звірте його з нульовим залишком без запису різниці, а потім видаліть."
          }
        }
      }
    },
    "account.refusal.duplicateCurrency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A currency is listed twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una divisa aparece dos veces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта указана дважды."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одну валюту вказано двічі."
          }
        }
      }
    },
    "account.refusal.emptyName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponga un nombre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите название."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте назву."
          }
        }
      }
    },
    "account.refusal.groupHasLiveAccounts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group still has accounts outside the archive: move them to the archive first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo aún tiene cuentas fuera del archivo: pásalas antes al archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе есть счета не в архиве — сначала уберите в архив их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У групі ще є рахунки поза архівом: спершу перенесіть їх в архів."
          }
        }
      }
    },
    "account.refusal.groupHoldsMain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is in this group, so it stays in the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal está en este grupo, así que se queda en el resumen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе основной счёт, поэтому она остаётся в общей сводке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок є в цій групі, тому він залишається в підсумку."
          }
        }
      }
    },
    "account.refusal.groupInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, archived ones too, are filed under the group: it can go to the archive, not be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cuentas, también archivadas, dentro del grupo: puede pasar al archivo, pero no eliminarse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К группе отнесены счета, в том числе архивные: её можно убрать в архив, но не удалить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки, в тому числі архівні, лежать у групі: вона може піти в архів, але не видалитися."
          }
        }
      }
    },
    "account.refusal.groupNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group with this name already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un grupo con este nombre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа с таким названием уже есть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Група із такою назвою вже є."
          }
        }
      }
    },
    "account.refusal.hasMoney": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is money on the account. Transfer the balance to another account or reconcile it to zero, then move it to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la cuenta hay dinero. Transfiera el saldo a otra cuenta o concílielo a cero, y después páselo al archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги. Переведите остаток на другой счёт или сверьте счёт до нуля, а потом уберите в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку є гроші. Перекажіть залишок на інший рахунок або звірте його з нульовим залишком, а потім перенесіть у архів."
          }
        }
      }
    },
    "account.refusal.inArchive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name is in the archive: bring that one back instead of making a second one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nombre está en el archivo: recupere esa cuenta en lugar de crear una segunda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое название есть в архиве: верните его, а не заводите второе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Така назва є в архіві: поверніть той рахунок замість створення другого."
          }
        }
      }
    },
    "account.refusal.inUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in use — operations: %1$lld, transfers: %2$lld, scheduled payments: %3$lld, debt entries: %4$lld. It cannot be deleted: merge it with another account or move it to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta está en uso — operaciones: %1$lld, transferencias: %2$lld, pagos programados: %3$lld, apuntes de deuda: %4$lld. No se puede eliminar: fusiónela con otra cuenta o pásela al archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт используется — операций: %1$lld, переводов: %2$lld, платежей: %3$lld, записей долгов: %4$lld. Удалить его нельзя: объедините с другим счётом или уберите в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок використовується — операцій: %1$lld, переказів: %2$lld, запланованих платежів: %3$lld, записів боргів: %4$lld. Його не можна видалити: злийте його з іншим рахунком або перенесіть в архів."
          }
        }
      }
    },
    "account.refusal.inUseAlsoPoints": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is also the points account of the cashback of %lld accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También es la cuenta de puntos del cashback de %lld cuentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он же — счёт для баллов кэшбэка у счетов: %lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він також рахунок для балів кешбеку %lld рахунків."
          }
        }
      }
    },
    "account.refusal.inUsePoints": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the points account of the cashback of %lld accounts. It cannot be deleted: choose another points account in their “Cashback rules…”, merge it with another account or move it to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la cuenta de puntos del cashback de %lld cuentas. No se puede eliminar: elija otra cuenta de puntos en sus «Reglas de cashback…», fusiónela con otra cuenta o pásela al archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это счёт для баллов кэшбэка у счетов: %lld. Удалить его нельзя: выберите другой счёт для баллов в их «Правилах кэшбэка…», объедините его с другим счётом или уберите в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він є рахунком для балів кешбеку %lld рахунків. Його не можна видалити: оберіть інший рахунок для балів у їхніх «Правилах кешбеку…», злийте його з іншим рахунком або перенесіть в архів."
          }
        }
      }
    },
    "account.refusal.lastLiveAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the last account and cannot go to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la última cuenta y no puede pasar al archivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это последний счёт — в архив его не убрать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це останній рахунок, і його не можна перенести в архів."
          }
        }
      }
    },
    "account.refusal.mainInExcludedGroup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be in a group left out of the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal no puede estar en un grupo fuera del resumen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не может быть в группе вне общей сводки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок не може бути в групі, яку вилучено з підсумку."
          }
        }
      }
    },
    "account.refusal.nameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with this name already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una cuenta con este nombre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт с таким названием уже есть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок із такою назвою вже є."
          }
        }
      }
    },
    "account.refusal.nameTakenByCard": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card is called “%@” — choose another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta se llama «%@»: elija otro nombre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так называется карта «%@» — выберите другое название."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка має назву «%@» — виберіть іншу."
          }
        }
      }
    },
    "account.refusal.needsNewMain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account that becomes main first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero elija la cuenta que pasará a ser la principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите счёт, который станет основным."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу оберіть рахунок, який стане основним."
          }
        }
      }
    },
    "account.refusal.noCurrency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose at least one currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija al menos una divisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите хотя бы одну валюту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть хоча б одну валюту."
          }
        }
      }
    },
    "account.refusal.noSuccessor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other account in the summary can become main. Add an account or bring one into the summary first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna otra cuenta del resumen puede ser la principal. Antes añada una cuenta o incluya una en el resumen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основным стать некому: нужен другой счёт в общей сводке. Сначала добавьте счёт или включите его группу в сводку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніякий інший рахунок у підсумку не може стати основним. Спершу додайте рахунок або включіть один до підсумку."
          }
        }
      }
    },
    "account.refusal.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not there any more — it may have been deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no está: quizá se eliminó."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого больше нет — возможно, уже удалено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його вже немає — можливо, його видалили."
          }
        }
      }
    },
    "account.refusal.otherBank": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only accounts of one bank are merged. To bring two banks together, merge the banks first in Settings → Accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se fusionan cuentas de un mismo banco. Para unir dos bancos, fusiónelos antes en Ajustes → Cuentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяются только счета одного банка. Чтобы свести два банка вместе, сначала объедините банки в «Настройки → Счета»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зливаються лише рахунки одного банку. Щоб об'єднати два банки, спершу злийте їх у «Налаштування → Рахунки»."
          }
        }
      }
    },
    "account.refusal.otherNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» is already a name of another account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya es otro nombre de una cuenta distinta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — уже название другого счёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже є назвою іншого рахунку."
          }
        }
      }
    },
    "account.refusal.removesCurrencyWithMoney": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is money in %@ on this account: the currency stays until its balance is zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta cuenta hay dinero en %@: la divisa se queda hasta que su saldo sea cero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги в %@: валюта останется, пока её остаток не станет нулём."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому рахунку є гроші в %@: валюта залишиться, доки її залишок не стане нульовим."
          }
        }
      }
    },
    "account.refusal.restore": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити"
          }
        }
      }
    },
    "account.refusal.unreadableBalance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance in %@ does not read as an amount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo en %@ no se lee como importe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в %@ не читается как сумма."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок у %@ не вдалося прочитати як суму."
          }
        }
      }
    },
    "account.screen.balances": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
