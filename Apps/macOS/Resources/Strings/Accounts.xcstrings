    "account.credit.refusal.fee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee does not read: a percent up to 100 and an amount not below zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión no es válida: un porcentaje de hasta 100 y una cantidad no menor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
