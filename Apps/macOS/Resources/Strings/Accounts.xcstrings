    "accounts.delete.messageMoneyMany": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ balansları bütün yekunlardan çıxarılacaq. Hesablara heç nə bağlı deyil. ⌘Z ilə bərpa etmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансы %@ знікнуць з усіх вынікаў разам з рахункамі. Нішто на рахункі не спасылаецца. ⌘Z адновіць іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatky %@ se s účty odečtou ze všech součtů. Na účty nic neodkazuje. Zkratkou ⌘Z je obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Salden %@ verschwinden mit ihnen aus allen Summen. Nichts verweist auf die Konten. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balances %@ leave every total with them. Nothing refers to the accounts. ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos %@ salen de todos los totales con ellas. Nada hace referencia a las cuentas. ⌘Z las devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes %@ sortent de tous les totaux avec eux. Rien ne s'y réfère. ⌘Z les rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ մնացորդները նույնպես կհեռացվեն բոլոր հանրագումարներից։ Հաշիվներն այլ տեղ չեն օգտագործվում։ ⌘Z-ը կվերականգնի դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi %@ verranno rimossi da tutti i totali. Nessun elemento fa riferimento ai conti. Premi ⌘Z per ripristinarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高%@はすべての合計から除外されます。これらの口座を参照している項目はありません。⌘Zで元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბალანსები %@ ყველა ჯამიდან ამოიღება. ანგარიშებს არაფერი უკავშირდება. ⌘Z აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімдері олармен бірге барлық жиынтықтан шығады. Есеп-шоттарға ештеңе сілтемейді. ⌘Z оларды қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액 %@도 모든 합계에서 제외됩니다. 이 계좌들을 참조하는 항목이 없습니다. ⌘Z로 복원할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ калдыктары алар менен кошо бардык жыйынтыктардан чыгарылат. Эсептерге эч нерсе байланышкан эмес. ⌘Z аларды калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De saldi %@ verdwijnen ook uit alle totalen. Er wordt nergens naar de rekeningen verwezen. Met ⌘Z zet je deze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salda %@ zostaną usunięte ze wszystkich sum. Nic nie odwołuje się do kont. ⌘Z przywróci je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos de %@ serão removidos de todos os totais. Nada faz referência às contas. ⌘Z as restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos %@ serão removidos de todos os totais. Nada faz referência às contas. Prima ⌘Z para as recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки %@ пропадут из итогов. На счета ничто не ссылается. ⌘Z вернёт их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияҳои %@ ҳамроҳи ҳисобҳо аз ҳамаи ҷамъҳо хориҷ мешаванд. Ҳеҷ чиз ба ҳисобҳо ишора намекунад. ⌘Z онҳоро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyeleri tüm toplamlarından çıkarılır. Hesaplara bağlı öğe yok. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки %@ разом із ними зникають з усіх підсумків. Ніщо на рахунки не посилається. ⌘Z поверне їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qoldiqlar barcha jami summalardan chiqariladi. Hisoblarga hech narsa bog‘lanmagan. ⌘Z ularni qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额 %@ 将从所有总额中移除。没有项目引用这些账户。按 ⌘Z 可将其恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額 %@ 也會從所有總計中移除。沒有項目參照這些帳戶。按下 ⌘Z 可還原。"
          }
        }
      }
    },
