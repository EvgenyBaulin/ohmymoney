    "transfer.beforeCount.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo dieses Tages wurde damals gezählt. Wurde die Überweisung vor dem Zählen gemacht, steckt sie bereits im gezählten Saldo: Es ändert sich die Differenz der Zählung, nicht der Saldo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That day's balance was counted then. Made before the count, the transfer is already inside the balance counted: the difference of the count changes, not the balance."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сол күнгі теңгерім сол кезде есептелген. Санаудан бұрын жасалған болса, аударым есептелген теңгерімнің ішінде бар: өзгеретіні — санаудағы айырма, теңгерім емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В это время в тот день был сверен остаток. Если перевод был до сверки, он уже внутри сверенного остатка: изменится разница сверки, а не остаток."
          }
        }
      }
    },
    "transfer.beforeCount.no": {
      "extractionState": "manual",
