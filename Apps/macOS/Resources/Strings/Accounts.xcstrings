    "account.credit.refusal.fee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee does not read: a percent up to 100 and an amount not below zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия не читается: процент до 100 и сумма не меньше нуля."
          }
        }
      }
    },
    "account.credit.refusal.inTheBin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interest of this statement is in the bin — bring it back from there."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты этой выписки лежат в корзине — верните их оттуда."
          }
        }
      }
    },
    "account.credit.refusal.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the credit limit — an amount above zero."
