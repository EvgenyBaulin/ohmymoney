    "account.credit.firstCardHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is opened together with its first card. Empty: the card is named like the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito se abre junto con su primera tarjeta. Si está vacío, la tarjeta se llama como la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit s'ouvre avec sa première carte. Vide : la carte porte le nom du compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитная карта открывается вместе с первой картой. Пусто: карта называется как счёт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитний рахунок відкривається разом із його першою карткою. Якщо поле порожнє, картка називається так само, як рахунок."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta di credito viene aperta insieme alla sua prima carta. Se lasci vuoto, la carta prende il nome del conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта алғашқы картасымен бірге ашылады. Бос болса: карта есеп-шот атауымен аталады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крэдытны рахунак адкрываецца разам з першай картай. Пуста: назва карты супадае з назвай рахунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte wird zusammen mit ihrer ersten Karte eröffnet. Leer: Die Karte heißt wie das Konto."
          }
        }
      }
    },
