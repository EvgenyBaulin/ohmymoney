    "bank.min.below": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance is below the minimum %1$@ by %2$@: the rate for the month may be lost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo está por debajo del mínimo %1$@ en %2$@: el tipo del mes puede perderse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde est inférieur de %2$@ au minimum de %1$@ : le taux du mois peut être perdu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток ниже неснижаемого %1$@ на %2$@: ставка за месяц может пропасть"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок нижче мінімуму %1$@ на %2$@: ставка за місяць може бути втрачена"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo è inferiore al minimo di %1$@ di %2$@: potresti perdere il tasso del mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теңгерім ең аз %1$@ мөлшерінен %2$@ төмен: айдың мөлшерлемесі жоғалуы мүмкін"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс на %2$@ ніжэйшы за мінімум %1$@: месячная стаўка можа быць страчана"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo liegt um %2$@ unter dem Mindestsaldo von %1$@: Der Zinssatz für den Monat könnte verloren gehen"
          }
        }
      }
    },
