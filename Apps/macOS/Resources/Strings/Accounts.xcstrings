    "bank.min.below": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс на %2$@ ніжэйшы за мінімум %1$@: месячная стаўка можа быць страчана"
          }
        },
        "de": {
          "stringUnit": {
