    "account.credit.graceLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grace period is lost: pay the whole debt, %@, and interest stops"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pierde el periodo de gracia: pague la deuda completa, %@, y los intereses dejan de correr"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Льготный период потерян: внесите весь долг %@, и проценты перестанут начисляться"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пільговий період втрачено: сплатіть весь борг, %@, і відсотки припиняться"
          }
        }
      }
    },
    "account.credit.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is an account whose balance goes below zero; it is not a debt. Every term is in %@. Interest is shown as an estimate until you record it from the statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta de crédito es una cuenta cuyo saldo baja de cero; no es una deuda. Todas las condiciones están en %@. Los intereses se muestran como estimación hasta que los registre según el extracto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитная карта — это счёт, остаток которого уходит в минус, а не долг. Все условия — в %@. Проценты видны как оценка, пока вы не запишете их по выписке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитна картка — це рахунок, баланс якого опускається нижче нуля; це не борг. Усі умови вказано в %@. Відсотки показано як оцінку, доки ви не запишете їх із виписки."
          }
        }
      }
    },
    "account.credit.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
