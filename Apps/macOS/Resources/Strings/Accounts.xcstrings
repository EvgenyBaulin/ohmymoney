          }
        }
      }
    },
    "account.credit.grace.fromPurchase": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage ab dem ersten Kauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days from the first purchase"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алғашқы сатып алудан бастап күндер"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дни с первой покупки"
