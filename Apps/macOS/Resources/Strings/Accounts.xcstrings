            "state": "translated",
            "value": "已有同名的群組。"
          }
        }
      }
    },
    "account.refusal.hasMoney": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку ёсць грошы. Перавядзіце рэшту на іншы рахунак або зверце яго да нуля, затым архівуйце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Konto liegt Geld. Übertragen Sie den Saldo auf ein anderes Konto oder gleichen Sie es auf null ab und verschieben Sie es dann ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is money on the account. Transfer the balance to another account or reconcile it to zero, then move it to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la cuenta hay dinero. Transfiera el saldo a otra cuenta o concílielo a cero, y después páselo al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a de l'argent sur le compte. Virez le solde sur un autre compte ou rapprochez-le à zéro, puis mettez-le aux archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto contiene denaro. Trasferisci il saldo su un altro conto o riconcilialo a zero, poi archivialo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотта ақша бар. Теңгерімді басқа есеп-шотқа аударыңыз немесе нөлге дейін салыстырыңыз, содан кейін мұрағатқа өткізіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсепте акча бар. Калдыгын башка эсепке которуңуз же нөлгө чейин тактаңыз, анан архивге жылдырыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na koncie są środki. Przelej je na inne konto lub uzgodnij saldo do zera, a następnie przenieś konto do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta tem dinheiro. Transfira o saldo para outra conta ou concilie-a para zerar o saldo e depois arquive-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги. Переведите остаток на другой счёт или сверьте счёт до нуля, а потом уберите в архив."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар суратҳисоб пул ҳаст. Бақияро ба суратҳисоби дигар гузаронед ё онро ба сифр баробар кунед, сипас ба бойгонӣ баред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesapta para var. Bakiyeyi başka bir hesaba aktarın veya sıfıra eşitleyin, ardından hesabı arşive kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку є гроші. Перекажіть залишок на інший рахунок або звірте його з нульовим залишком, а потім перенесіть у архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobda pul bor. Qoldiqni boshqa hisobga o‘tkazing yoki nolga tenglang, so‘ng hisobni arxivga o‘tkazing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶仍有餘額。請將餘額轉至其他帳戶或對帳為零，再封存帳戶。"
          }
        }
      }
    },
    "account.refusal.inArchive": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта назва ў архіве: аднавіце наяўны запіс замест стварэння другога."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name ist im Archiv: Holen Sie jenes Konto zurück, statt ein zweites anzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name is in the archive: bring that one back instead of making a second one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nombre está en el archivo: recupere esa cuenta en lugar de crear una segunda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom est dans les archives : restaurez celui-là au lieu d'en créer un second."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo nome è nell’archivio: ripristina l’elemento esistente invece di crearne un altro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл атау мұрағатта бар: екінші есеп-шот жасаудың орнына сол есеп-шотты қайтарыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мындай аталыш архивде бар. Жаңысын түзүүнүн ордуна аны калыбына келтириңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta nazwa jest w archiwum. Przywróć istniejącą pozycję zamiast tworzyć kolejną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nome está no arquivo. Restaure o item existente em vez de criar outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое название есть в архиве: верните его, а не заводите второе."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ном дар бойгонӣ аст: онро барқарор кунед, на ин ки дуюмӣ созед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad arşivde. Yeni bir tane oluşturmak yerine arşivdekini geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Така назва є в архіві: поверніть той рахунок замість створення другого."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nom arxivda bor: yangisini yaratish o‘rniga uni tiklang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此名稱已存在於封存項目中，請還原該項目。"
          }
        }
      }
    },
    "account.refusal.inUse": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак выкарыстоўваецца — аперацый: %1$lld, пераводаў: %2$lld, планавых плацяжоў: %3$lld, запісаў пазык: %4$lld. Нельга выдаліць: аб'яднайце з іншым рахункам ці архівуйце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto wird verwendet — Vorgänge: %1$lld, Überweisungen: %2$lld, geplante Zahlungen: %3$lld, Schuldeneinträge: %4$lld. Es kann nicht gelöscht werden: Führen Sie es mit einem anderen Konto zusammen oder verschieben Sie es ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in use — operations: %1$lld, transfers: %2$lld, scheduled payments: %3$lld, debt entries: %4$lld. It cannot be deleted: merge it with another account or move it to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta está en uso — operaciones: %1$lld, transferencias: %2$lld, pagos programados: %3$lld, apuntes de deuda: %4$lld. No se puede eliminar: fusiónela con otra cuenta o pásela al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte est utilisé — opérations : %1$lld, virements : %2$lld, paiements planifiés : %3$lld, entrées de dette : %4$lld. Il ne peut pas être supprimé : fusionnez-le avec un autre compte ou mettez-le aux archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto è in uso: operazioni: %1$lld, trasferimenti: %2$lld, pagamenti programmati: %3$lld, voci di debito: %4$lld. Non puoi eliminarlo: uniscilo a un altro conto o archivialo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот қолданыста — операциялар: %1$lld, аударымдар: %2$lld, жоспарланған төлемдер: %3$lld, берешек жазбалары: %4$lld. Оны жою мүмкін емес: басқа есеп-шотпен біріктіріңіз немесе мұрағатқа өткізіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсеп колдонулууда — операциялар: %1$lld, которуулар: %2$lld, пландалган төлөмдөр: %3$lld, карыз жазуулары: %4$lld. Аны өчүрүүгө болбойт: башка эсеп менен бириктириңиз же архивге жылдырыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto jest używane — operacje: %1$lld, przelewy: %2$lld, zaplanowane płatności: %3$lld, wpisy dotyczące długów: %4$lld. Nie można go usunąć. Połącz je z innym kontem lub przenieś do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta está em uso — operações: %1$lld, transferências: %2$lld, pagamentos agendados: %3$lld, lançamentos de dívidas: %4$lld. Ela não pode ser apagada. Una-a a outra conta ou arquive-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт используется — операций: %1$lld, переводов: %2$lld, платежей: %3$lld, записей долгов: %4$lld. Удалить его нельзя: объедините с другим счётом или уберите в архив."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисоб истифода мешавад — амалиёт: %1$lld, интиқолҳо: %2$lld, пардохтҳои ба нақша гирифташуда: %3$lld, сабтҳои қарз: %4$lld. Онро нест кардан мумкин нест: бо суратҳисоби дигар якҷоя кунед ё ба бойгонӣ баред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap kullanımda: işlemler: %1$lld, transferler: %2$lld, planlanmış ödemeler: %3$lld, borç kayıtları: %4$lld. Silinemez; başka bir hesapla birleştirin veya arşive kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок використовується — операцій: %1$lld, переказів: %2$lld, запланованих платежів: %3$lld, записів боргів: %4$lld. Його не можна видалити: злийте його з іншим рахунком або перенесіть в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob ishlatilmoqda — amaliyotlar: %1$lld, o‘tkazmalar: %2$lld, rejalashtirilgan to‘lovlar: %3$lld, qarz yozuvlari: %4$lld. Uni o‘chirib bo‘lmaydi: boshqa hisob bilan birlashtiring yoki arxivga o‘tkazing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶使用中：交易 %1$lld 筆、轉帳 %2$lld 筆、排程付款 %3$lld 筆、債務記錄 %4$lld 筆。無法刪除；請將它與其他帳戶合併或封存。"
          }
        }
      }
    },
    "account.refusal.inUseAlsoPoints": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ён таксама з'яўляецца балавым рахункам кэшбэку для %lld рахункаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist außerdem das Punktekonto für den Cashback von %lld Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is also the points account of the cashback of %lld accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También es la cuenta de puntos del cashback de %lld cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sert aussi de compte de points pour le cashback de %lld comptes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È anche il conto punti per il cashback di %lld conti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол сонымен қатар %lld есеп-шоттың кешбэк ұпайларының есеп-шоты."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул ошондой эле %lld эсептин кэшбэк упайларынын эсеби."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To także konto punktowe dla cashbacku %lld kont."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela também é a conta de pontos do cashback de %lld contas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он же — счёт для баллов кэшбэка у счетов: %lld."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Он ҳамчунин суратҳисоби холҳои кешбэки %lld суратҳисоб аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıca %lld hesabın para iadesi için puan hesabı olarak kullanılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він також рахунок для балів кешбеку %lld рахунків."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hisob yana %lld ta hisob keshbekining ballar hisobi sifatida ishlatiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶也是 %lld 個帳戶的現金回饋點數帳戶。"
          }
        }
      }
    },
    "account.refusal.inUsePoints": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта балавы рахунак кэшбэку для %lld рахункаў. Нельга выдаліць: выберыце іншы балавы рахунак у іх “Правілах кэшбэку…”, аб'яднайце з іншым рахункам ці архівуйце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist das Punktekonto für den Cashback von %lld Konten. Es kann nicht gelöscht werden: Wählen Sie in deren „Cashback-Regeln…“ ein anderes Punktekonto, führen Sie es mit einem anderen Konto zusammen oder verschieben Sie es ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the points account of the cashback of %lld accounts. It cannot be deleted: choose another points account in their “Cashback rules…”, merge it with another account or move it to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la cuenta de puntos del cashback de %lld cuentas. No se puede eliminar: elija otra cuenta de puntos en sus «Reglas de cashback…», fusiónela con otra cuenta o pásela al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sert de compte de points pour le cashback de %lld comptes. Il ne peut pas être supprimé : choisissez un autre compte de points dans leurs « Règles de cashback… », fusionnez-le avec un autre compte ou mettez-le aux archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il conto punti per il cashback di %lld conti. Non puoi eliminarlo: scegli un altro conto punti nelle relative “Regole cashback…”, uniscilo a un altro conto o archivialo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол %lld есеп-шоттың кешбэк ұпайларының есеп-шоты. Оны жою мүмкін емес: олардың «Кешбэк ережелері…» бөлімінде басқа ұпайлар есеп-шотын таңдаңыз, басқа есеп-шотпен біріктіріңіз немесе мұрағатқа өткізіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул %lld эсептин кэшбэк упайларынын эсеби. Аны өчүрүүгө болбойт: алардын “Кэшбэк эрежелери…” бөлүмүндө башка упай эсебин тандаңыз, башка эсеп менен бириктириңиз же архивге жылдырыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto punktowe dla cashbacku %lld kont. Nie można go usunąć. Wybierz inne konto punktowe w ich „Zasadach cashbacku…”, połącz je z innym kontem lub przenieś do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela é a conta de pontos do cashback de %lld contas e não pode ser apagada. Escolha outra conta de pontos em “Regras de cashback…” dessas contas, una-a a outra conta ou arquive-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это счёт для баллов кэшбэка у счетов: %lld. Удалить его нельзя: выберите другой счёт для баллов в их «Правилах кэшбэка…», объедините его с другим счётом или уберите в архив."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Он суратҳисоби холҳои кешбэки %lld суратҳисоб аст. Онро нест кардан мумкин нест: дар “Қоидаҳои кешбэк…”-и онҳо суратҳисоби дигари холҳоро интихоб кунед, онро бо суратҳисоби дигар якҷоя кунед ё ба бойгонӣ баред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hesabın para iadesi için puan hesabı olarak kullanılıyor. Silinemez; bu hesapların “Para İadesi Kuralları…” bölümünde başka bir puan hesabı seçin, hesabı başka bir hesapla birleştirin veya arşive kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він є рахунком для балів кешбеку %lld рахунків. Його не можна видалити: оберіть інший рахунок для балів у їхніх «Правилах кешбеку…», злийте його з іншим рахунком або перенесіть в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hisob %lld ta hisob keshbekining ballar hisobi sifatida ishlatiladi. Uni o‘chirib bo‘lmaydi: ularning “Keshbek qoidalari…” bo‘limida boshqa ballar hisobini tanlang, bu hisobni boshqa hisob bilan birlashtiring yoki arxivga o‘tkazing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶是 %lld 個帳戶的現金回饋點數帳戶，無法刪除。請在這些帳戶的「現金回饋規則…」中選擇其他點數帳戶，或將此帳戶與其他帳戶合併或封存。"
          }
        }
      }
    },
    "account.refusal.lastLiveAccount": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта апошні рахунак, яго нельга архіваваць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist das letzte Konto und kann nicht ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the last account and cannot go to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la última cuenta y no puede pasar al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le dernier compte : il ne peut pas partir aux archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È l’ultimo conto e non può essere archiviato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл соңғы есеп-шот, мұрағатқа өткізілмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул акыркы эсеп болгондуктан, аны архивге жылдырууга болбойт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ostatnie konto i nie można przenieść go do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a última conta e não pode ser arquivada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это последний счёт — в архив его не убрать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин суратҳисоби охирин аст ва онро ба бойгонӣ бурдан мумкин нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu son hesap olduğundan arşive kaldırılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це останній рахунок, і його не можна перенести в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oxirgi hisob, uni arxivga o‘tkazib bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是最後一個帳戶，無法封存。"
          }
        }
      }
    },
    "account.refusal.mainInExcludedGroup": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак не можа быць у групе па-за зводкай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto kann nicht in einer Gruppe stehen, die aus der Übersicht herausgenommen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be in a group left out of the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal no puede estar en un grupo fuera del resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal ne peut pas se trouver dans un groupe exclu du récapitulatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale non può trovarsi in un gruppo escluso dal riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот қорытындыдан шығарылған топта бола алмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги эсеп жыйынтыкка кирбеген топто боло албайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto główne nie może należeć do grupy wyłączonej z podsumowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal não pode estar em um grupo excluído do resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не может быть в группе вне общей сводки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисоби асосӣ дар гурӯҳе, ки аз ҷамъбаст хориҷ шудааст, буда наметавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana hesap, özete dahil edilmeyen bir grupta olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок не може бути в групі, яку вилучено з підсумку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy hisob umumiy ko‘rinishdan chiqarilgan guruhda bo‘lishi mumkin emas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要帳戶不能位於不納入摘要的群組中。"
          }
        }
      }
    },
    "account.refusal.nameTaken": {
