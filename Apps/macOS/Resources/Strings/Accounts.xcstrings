          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия пойдёт в «%1$@» — она вернётся из архива вместе с «%2$@»."
          }
        }
      }
    },
    "transfer.refusal.amountsDiffer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Währung kommt derselbe Betrag an, der abgeht; tragen Sie als Gebühr ein, was die Bank einbehalten hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one currency the same amount arrives as leaves; write what the bank kept as the fee."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір валютада бірдей сома келеді де кетеді; банк ұстап қалғанын комиссия ретінде жазыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В одной валюте зачисляется столько же, сколько списано; то, что удержал банк, запишите комиссией."
          }
        }
      }
    },
    "transfer.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto ist im Archiv: Holen Sie es zurück, um darauf oder davon zu überweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in the archive: bring it back to transfer to or from it."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот мұрағатта: оған немесе одан аудару үшін оны қайтарыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт в архиве — верните его, чтобы переводить на него или с него."
          }
        }
      }
    },
    "transfer.refusal.feeMoneyBack": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Gebühr dieser Überweisung wurde bereits Geld zurückgegeben: Betrag und Währung lassen sich nicht ändern, und sie kann nicht entfernt werden. Löschen Sie zuerst diese Rückzahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money was already given back for this transfer's fee: its amount and currency can't change, and it can't be taken off. Delete that money back first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл аударымның комиссиясына ақша қайтарылған: оның сомасы мен валютасы өзгере алмайды, және ол алынып тасталмайды. Алдымен сол қайтарылған ақшаны жойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За комиссию этого перевода уже вернули деньги: её сумму и валюту не изменить, а саму комиссию не убрать. Сначала удалите этот возврат денег."
          }
        }
      }
    },
    "transfer.refusal.feeRefunded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Gebühr dieser Überweisung ist eine Erstattung erfasst: Die Gebühr lässt sich nicht entfernen, nicht kleiner machen als die Erstattung oder in eine andere Währung verschieben, und die Überweisung lässt sich mit ihr nicht löschen. Löschen Sie zuerst die Erstattung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund was recorded against this transfer's fee: the fee can't be taken off, made smaller than what was refunded or moved to another currency, and the transfer can't be deleted with it. Delete the refund first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл аударымның комиссиясына қайтару жазылған: комиссияны алып тастауға, қайтарылғаннан кіші етуге немесе басқа валютаға көшіруге болмайды, және аударымды онымен бірге жою мүмкін емес. Алдымен қайтаруды жойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На комиссию этого перевода оформлен возврат: её нельзя убрать, сделать меньше возвращённого или перевести в другую валюту, а перевод — удалить вместе с ней. Сначала удалите возврат."
          }
        }
      }
    },
    "transfer.refusal.fromCurrency": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto, von dem das Geld abgeht, führt diese Währung nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account the money leaves does not hold this currency."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша кететін есеп-шотта бұл валюта жоқ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт, откуда уходят деньги, не держит эту валюту."
          }
        }
      }
    },
    "transfer.refusal.negativeFee": {
      "extractionState": "manual",
      "localizations": {
        "de": {
