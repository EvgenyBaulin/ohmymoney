    "card.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge von „%1$@“ (auch im Papierkorb) und ihre geplanten Zahlungen wandern zu „%2$@“, und ihr Name sowie ihre weiteren Namen werden weitere Namen von „%2$@“. Die Karte „%1$@“ wird gelöscht. Es wird kein Geld bewegt: Beide Karten gehören zu einem Konto, daher bleiben Salden und Abgleiche, wie sie sind. ⌘Z holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations of “%1$@” (in the bin too) and its scheduled payments move to “%2$@”, and its name and other names become other names of “%2$@”. The card “%1$@” is deleted. No money moves: both cards are of one account, so balances and reconciliations stay as they are. ⌘Z brings everything back."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” операциялары (себетте жатқандары да) және оның жоспарланған төлемдері “%2$@” картасына көшеді, ал оның атауы мен басқа атаулары “%2$@” картасының басқа атаулары болады. “%1$@” картасы жойылады. Ақша қозғалмайды: екі карта да бір есеп-шотқа тиесілі, сондықтан теңгерімдер мен салыстырулар өзгермейді. ⌘Z бәрін қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции карты «%1$@» (и в корзине) и её платежи перейдут на «%2$@», а её название и другие названия станут другими названиями «%2$@». Карта «%1$@» удалится. Деньги не двигаются: обе карты одного счёта, остатки и сверки не меняются. ⌘Z вернёт всё."
          }
        }
      }
    },
    "card.merge.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge von „%1$@“ (auch im Papierkorb) und ihre geplanten Zahlungen wandern zu „%2$@“, und ihr Name sowie ihre weiteren Namen werden weitere Namen von „%2$@“. Die Karte „%1$@“ wird gelöscht. Es wird kein Geld bewegt: Beide Karten gehören zu einem Konto, daher bleiben Salden und Abgleiche, wie sie sind. „Rückgängig“ holt alles zurück."
          }
        },
        "en": {
