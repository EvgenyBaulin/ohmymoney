    "account.interest.refusal.endBeforeOpening": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əmanətin bağlanma tarixi açılma tarixindən əvvəldir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уклад закрываецца раней, чым адкрываецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklad končí před svým začátkem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Festgeld endet, bevor es beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deposit closes before it opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El depósito se cierra antes de abrirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt est clôturé avant d'être ouvert."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավանդի փակման ամսաթիվը բացման ամսաթվից առաջ է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il deposito si chiude prima dell’apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "預金の終了日が開始日より前です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანაბარი გახსნამდე იხურება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салым ашылғанға дейін жабылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예금 만기일이 개설일보다 빠릅니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аманат ачыла электе жабылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het deposito eindigt voordat het begint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokata kończy się przed jej otwarciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O depósito termina antes de começar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O depósito termina antes de começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклад закрывается раньше, чем открыт."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасандоз пеш аз кушода шуданаш баста мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevduat, açılmadan önce kapanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Депозит закривається раніше, ніж відкривається."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Omonat ochilishidan oldin yopiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存款结束日期早于开始日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存款結束日期早於開立日期。"
          }
        }
      }
    },
    "account.interest.refusal.endNeeded": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Müddətin sonunda ödənilən faiz üçün əmanətin bağlanma tarixi lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выплаты працэнтаў у канцы тэрміну патрэбны дзень закрыцця ўкладу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro výplatu úroku na konci období je potřeba datum ukončení vkladu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen, die am Ende der Laufzeit gezahlt werden, brauchen den Tag, an dem das Festgeld endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest paid at the end of the term needs the day the deposit closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses pagados al final del plazo necesitan el día en que se cierra el depósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des intérêts versés à l'échéance demandent la date de clôture du dépôt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամկետի վերջում տոկոսները վճարելու համար նշեք ավանդի փակման օրը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per gli interessi pagati a scadenza serve la data di chiusura del deposito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "満期時に利息を受け取るには、預金の終了日が必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვადის ბოლოს პროცენტის ჩასარიცხად მიუთითეთ ანაბრის დახურვის თარიღი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзім аяқталғанда төленетін пайызға салым жабылатын күн керек."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만기 시 이자를 지급하려면 예금 만기일이 필요합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөөнөт аягында пайыз төлөө үчүн аманат жабыла турган күн керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor rente die aan het einde van de looptijd wordt uitbetaald, is de einddatum van het deposito nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wypłacić odsetki na koniec okresu, podaj datę zakończenia lokaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para juros pagos no vencimento, informe a data de vencimento do depósito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pagar os juros no fim do prazo, indique a data de vencimento do depósito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выплаты в конце срока укажите, когда вклад закрывается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои пардохти фоиз дар охири муҳлат санаи бастани пасандоз лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vade sonunda ödenen faiz için mevduatın kapanış tarihi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки, що виплачуються наприкінці строку, потребують дня закриття депозиту."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Muddat oxirida to‘lanadigan foiz uchun omonat yopiladigan sanani kiriting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到期付息需要填写存款结束日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到期支付利息需要設定存款結束日期。"
          }
        }
      }
    },
    "account.interest.refusal.nextRate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая стаўка павінна быць большай за 0% і не большай за 100%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der neue Zinssatz muss größer als 0 und höchstens 100 Prozent sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new rate must be a percent above zero and up to 100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo tipo debe ser mayor que cero y no superar el 100 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau taux doit être supérieur à zéro et inférieur ou égal à 100."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nuovo tasso deve essere superiore a zero e non oltre il 100%."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа мөлшерлеме нөлден жоғары және 100 пайыздан аспауы керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe oprocentowanie musi być większe od zera i nie może przekraczać 100%."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova taxa deve ser maior que zero e de até 100%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая ставка — процент больше нуля и до 100."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni oran, sıfırdan büyük ve en fazla 100 olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нова ставка має бути більшою за нуль і не перевищувати 100%."
          }
        }
      }
    },
    "account.interest.refusal.nextRateNeedsDay": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажыце дату пачатку новай стаўкі або ачысціце яе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Startdatum für den neuen Zinssatz ein oder entferne ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say the day the new rate starts, or clear it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la fecha de entrada en vigor o bórrala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez la date du nouveau taux ou effacez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la data di decorrenza del nuovo tasso oppure rimuovilo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа мөлшерлеме басталатын күнді көрсетіңіз немесе оны өшіріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj datę wejścia w życie nowego oprocentowania lub je usuń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe a data de início da nova taxa ou apague-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите день, с которого действует новая ставка, или очистите её."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni oranın başlangıç tarihini girin veya oranı temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть дату початку нової ставки або очистьте її."
          }
        }
      }
    },
    "account.interest.refusal.payoutAccount": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz yalnız arxivdə olmayan başqa hesaba köçürülə bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнты могуць паступаць толькі на іншы рахунак па-за архівам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrok lze vyplatit jen na jiný účet, který není v archivu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen können nur auf ein anderes Konto gehen, das nicht im Archiv liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest can go only to another account that is not in the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses solo pueden ir a otra cuenta que no esté archivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts ne peuvent aller que vers un autre compte qui n'est pas dans les archives."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տոկոսները կարող են փոխանցվել միայն արխիվում չգտնվող այլ հաշվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli interessi possono essere versati solo su un altro conto non archiviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利息の入金先には、アーカイブされていない別の口座のみを指定できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პროცენტი მხოლოდ სხვა, არაარქივირებულ ანგარიშზე შეიძლება ჩაირიცხოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз тек мұрағатта жоқ басқа есеп-шотқа ғана жазылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이자는 보관함에 없는 다른 계좌로만 받을 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайызды архивде эмес башка эсепке гана которсо болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rente kan alleen naar een andere rekening die niet in het archief staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsetki można przelać tylko na inne konto, które nie jest w archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros só podem ser enviados para outra conta que não esteja arquivada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros só podem ser pagos noutra conta que não esteja no arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты можно перечислять только на другой счёт не из архива."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоизро танҳо ба суратҳисоби дигаре, ки дар бойгонӣ нест, гузаронидан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz yalnızca arşivde olmayan başka bir hesaba aktarılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки можна направити лише на інший рахунок, який не в архіві."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Foizni faqat arxivda bo‘lmagan boshqa hisobga o‘tkazish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利息只能转入其他未归档的账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "利息只能存入其他未封存的帳戶。"
          }
        }
      }
    },
    "account.interest.refusal.rate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İllik faiz dərəcəsini daxil edin: 0-dan çox və ən çox 100."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце стаўку ў працэнтах гадавых: больш за 0 і да 100."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte roční sazbu v procentech: více než 0 a nejvýše 100."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie den Zinssatz in Prozent pro Jahr ein: über 0 und bis 100."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the rate in percent a year: above 0 and up to 100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba el tipo en porcentaje anual: mayor que 0 y de hasta 100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le taux en pourcentage par an : supérieur à 0 et jusqu'à 100."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք տարեկան տոկոսադրույքը՝ 0-ից բարձր և մինչև 100։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tasso annuo in percentuale: maggiore di 0 e fino a 100."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年利をパーセントで入力してください。0より大きく、100以下の値を指定できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ წლიური განაკვეთი პროცენტებში: 0-ზე მეტი და არაუმეტეს 100-ისა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөлшерлемені жылдық пайызбен теріңіз: 0-ден жоғары және 100-ге дейін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연이율을 퍼센트로 입력하세요. 0보다 크고 100 이하여야 합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылдык ченди пайыз менен киргизиңиз: 0дөн жогору, 100гө чейин."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul het rentepercentage per jaar in: hoger dan 0 en maximaal 100."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj oprocentowanie w procentach rocznie: powyżej 0 i maksymalnie 100."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a taxa em porcentagem ao ano: acima de 0 e até 100."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique a taxa em percentagem ao ano: superior a 0 e até 100."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите ставку в процентах годовых: больше 0 и не больше 100."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Меъёри фоизи солонаро аз 0 зиёд ва то 100 ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık faiz oranını yüzde olarak girin: 0'dan büyük ve en fazla 100."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ставку у відсотках на рік: більше 0 і до 100."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yillik foiz stavkasini kiriting: 0 dan katta va 100 gacha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入年利率，须大于 0 且不超过 100。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入年利率百分比，須大於 0 且不超過 100。"
          }
        }
      }
    },
