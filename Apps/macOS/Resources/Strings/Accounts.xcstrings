    "cashback.refusal.category": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaydada Məqsədlər və tutuşdurma xaricində bir xərc kateqoriyası göstərilməlidir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У правіле патрэбна катэгорыя выдаткаў, акрамя Мэт і зверкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidlo musí určovat kategorii výdajů mimo Cíle a odsouhlasení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel nennt eine Ausgabenkategorie außerhalb von Zielen und Abgleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rule names an expense category outside Goals and the reconciliation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla cita una categoría de gasto fuera de Objetivos y de la conciliación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle nomme une catégorie de dépenses hors Objectifs et rapprochement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանոնը պետք է նշի ծախսի կատեգորիա՝ բացի «Նպատակներ»-ից և համադրումից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola deve indicare una categoria di spesa diversa da Obiettivi e dalla riconciliazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールには、目標と残高照合を除く支出カテゴリを指定してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წესში მიუთითეთ ხარჯის კატეგორია, გარდა მიზნებისა და შეჯერებისა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ереже Мақсаттар мен салыстыруға кірмейтін шығыс санатын көрсетеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙에 목표와 잔액 확인을 제외한 지출 카테고리를 지정하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эреже Максаттардан жана салыштыруудан тышкары чыгаша категориясын көрсөтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een regel verwijst naar een uitgavencategorie buiten Doelen en de afstemming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasada musi wskazywać kategorię wydatków inną niż Cele i uzgodnienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A regra deve usar uma categoria de despesa fora de Metas e da conciliação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra tem de indicar uma categoria de despesa fora de Objetivos e da reconciliação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило задаётся для категории расходов, кроме «Целей» и «Сверки»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоида категорияи хароҷотро берун аз Ҳадафҳо ва муқоисаи бақия муайян мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural, Hedefler ve mutabakat dışındaki bir gider kategorisini belirtmelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило називає категорію витрат поза «Цілями» і звіркою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoidada Maqsadlar va solishtirishdan tashqari xarajat toifasi ko‘rsatilishi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则须指定支出类别，且不能是目标或对账类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則須指定「目標」和對帳以外的支出類別。"
          }
        }
      }
    },
