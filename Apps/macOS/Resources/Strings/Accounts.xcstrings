          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 은행에 속한 계좌가 없습니다. “실행 취소”로 복원할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Анын алдында эсептер жок. “Артка кайтаруу” аны калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen rekeningen bij deze bank. Met “Herstel” zet je deze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma w nim żadnych kont. „Cofnij” przywróci go."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há contas neste banco. “Desfazer” o restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há contas neste banco. Use “Desfazer” para o recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под ним нет ни одного счёта. «Отменить» вернёт его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар он ҳисобе нест. “Бекор кардан” онро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bankaya bağlı hesap yok. “Geri Al” ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під ним немає жодного рахунку. «Скасувати» поверне його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bankda hisob yo‘q. “Bekor qilish” uni qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此银行下没有账户。点按“撤销”可将其恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此銀行沒有帳戶。使用「復原」可還原。"
          }
        }
      }
    },
