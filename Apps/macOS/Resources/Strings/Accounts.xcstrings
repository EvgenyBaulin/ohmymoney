    "archived.leftover.leg.back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am %1$@ — eine Überweisung von %2$@ von „%3$@“ zurück auf „%4$@“, um das vorab Erfasste zu decken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %1$@ — a transfer of %2$@ from «%3$@» back to «%4$@», to cover what is typed ahead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — перевод %2$@ с «%3$@» обратно на «%4$@», чтобы покрыть записанное вперёд."
          }
        }
      }
    },
    "archived.leftover.leg.back.and": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und am %1$@ — eine Überweisung von %2$@ von „%3$@“ zurück auf „%4$@“, um das vorab Erfasste zu decken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And on %1$@ — a transfer of %2$@ from «%3$@» back to «%4$@», to cover what is typed ahead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И %1$@ — перевод %2$@ с «%3$@» обратно на «%4$@», чтобы покрыть записанное вперёд."
          }
        }
      }
    },
    "archived.leftover.leg.earlier": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am %1$@ — eine Überweisung von %2$@ von „%3$@“ auf „%4$@“, direkt nach dem letzten Geldbewegung auf dem archivierten Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %1$@ — a transfer of %2$@ from «%3$@» to «%4$@», right after the last money that moved on the archived account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — перевод %2$@ с «%3$@» на «%4$@», сразу после последнего движения денег по счёту в архиве."
          }
        }
      }
    },
    "archived.leftover.leg.later": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am %1$@ — eine Überweisung von %2$@ von „%3$@“ auf „%4$@“, für das vorab erfasste Geld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %1$@ — a transfer of %2$@ from «%3$@» to «%4$@», for the money typed ahead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — перевод %2$@ с «%3$@» на «%4$@»: так записаны деньги вперёд."
          }
        }
      }
    },
    "archived.leftover.leg.later.and": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und am %1$@ — eine Überweisung von %2$@ von „%3$@“ auf „%4$@“, für das vorab erfasste Geld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And on %1$@ — a transfer of %2$@ from «%3$@» to «%4$@», for the money typed ahead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И %1$@ — перевод %2$@ с «%3$@» на «%4$@»: так записаны деньги вперёд."
          }
        }
      }
    },
    "archived.leftover.leg.now": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt — eine Überweisung von %1$@ von „%2$@“ auf „%3$@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now — a transfer of %1$@ from «%2$@» to «%3$@»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас — перевод %1$@ с «%2$@» на «%3$@»."
          }
        }
      }
    },
