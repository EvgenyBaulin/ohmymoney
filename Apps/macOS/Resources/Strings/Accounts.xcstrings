    "account.refusal.nameTakenByCard": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ёсць карта “%@” — выберыце іншую назву."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte heißt „%@“ — wählen Sie einen anderen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card is called “%@” — choose another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta se llama «%@»: elija otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte s'appelle « %@ » — choisissez un autre nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta si chiama “%@”: scegli un altro nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” деп аталған карта бар — басқа атау таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” аттуу карта бар — башка ат тандаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta ma nazwę „%@” — wybierz inną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão se chama “%@”. Escolha outro nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так называется карта «%@» — выберите другое название."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Корте бо номи “%@” вуҷуд дорад — номи дигар интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adlı bir kart var. Başka bir ad seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка має назву «%@» — виберіть іншу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” nomli karta bor — boshqa nom tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有名為「%@」的卡片，請選擇其他名稱。"
          }
        }
      }
    },
    "account.refusal.needsNewMain": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку выберыце рахунак, які стане асноўным."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie zuerst das Konto, das Hauptkonto wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account that becomes main first."
          }
        },
        "es": {
