    "transfer.sheet.sameAmount": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Betrag kommt an: Ein Abzug, den die Bank nimmt, ist die Gebühr."
          }
        },
        "en": {
