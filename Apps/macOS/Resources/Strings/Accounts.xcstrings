    "account.group.holdsMain": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas hesab bu qrupdadır, ona görə də qrup həmişə yekuna daxil edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак у гэтай групе, таму яна заўсёды ўлічваецца ў зводцы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V této skupině je hlavní účet, proto se vždy započítává do přehledu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto ist in dieser Gruppe, deshalb zählt sie immer in der Übersicht mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is in this group, so it always counts in the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal está en este grupo, así que siempre cuenta en el resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal se trouve dans ce groupe, il compte donc toujours dans le récapitulatif."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնական հաշիվն այս խմբում է, ուստի այն միշտ ներառվում է ամփոփագրում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale è in questo gruppo, quindi è sempre incluso nel riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループにはメイン口座があるため、常に集計に含まれます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ჯგუფში მთავარი ანგარიშია, ამიტომ ის ყოველთვის შედის შეჯამებაში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот осы топта, сондықтан ол қорытындыда әрқашан есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 계좌가 이 그룹에 있으므로 항상 합계에 포함됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги эсеп ушул топто, ошондуктан ал жалпы жыйынтыкка дайыма кирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoofdrekening zit in deze groep en telt daarom altijd mee in het overzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto główne jest w tej grupie, więc zawsze jest uwzględniane w podsumowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal está neste grupo, por isso ele sempre entra no resumo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal está neste grupo, pelo que conta sempre no resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе основной счёт, поэтому она всегда в общей сводке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби асосӣ дар ин гурӯҳ аст, бинобар ин ҳамеша дар ҷамъбаст ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana hesap bu grupta olduğundan grup her zaman özete dahil edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок є в цій групі, тому він завжди враховується в підсумку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy hisob shu guruhda, shuning uchun u doim umumiy hisobga kiradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主账户位于此分组，因此始终计入汇总。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要帳戶在此群組中，因此一律計入總覽。"
          }
        }
      }
    },
    "account.group.inSummary": {
