        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi unire solo carte dello stesso conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ口座のカードのみ結合できます。"
