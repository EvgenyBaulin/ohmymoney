    "transfer.beforeCount.dontAsk": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu üzləşdirmə üçün bir daha soruşma"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш не пытацца для гэтай зверкі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při tomto ověření se znovu neptat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Abgleich nicht mehr fragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask again for this reconciliation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No volver a preguntar para esta conciliación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne plus demander pour ce rapprochement"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս համադրման համար այլևս չհարցնել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non chiedere più per questa riconciliazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回の残高確認では再度確認しない"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ შეჯერებისთვის აღარ მკითხო"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы салыстыру үшін енді сұрама"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 잔액 확인에 대해 다시 묻지 않기"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул тактоо үчүн кайра сураба"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag niet opnieuw voor deze controle"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie pytaj ponownie dla tego sprawdzenia salda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não perguntar novamente para esta conciliação"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não voltar a perguntar nesta reconciliação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не спрашивать для этой сверки"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ин мувофиқасозӣ дигар напурсед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mutabakat için bir daha sorma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не запитувати для цієї звірки"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tekshiruv uchun boshqa so‘ralmasin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次对账不再询问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此次對帳不再詢問"
          }
        }
      }
    },
    "transfer.beforeCount.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmin günün balansı o vaxt hesablanıb. Köçürmə hesablamadan əvvəl edilibsə, artıq hesablanmış balansa daxildir: balans deyil, hesablama fərqi dəyişir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс таго дня ўжо быў падлічаны. Перавод да падліку ўжо ўваходзіць у падлічаны баланс: зменіцца розніца зверкі, а не баланс."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek k tomuto dni byl ověřen. Pokud převod proběhl před ověřením, je již v ověřeném zůstatku zahrnut: změní se rozdíl při ověření, nikoli zůstatek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo dieses Tages wurde damals gezählt. Wurde die Überweisung vor dem Zählen gemacht, steckt sie bereits im gezählten Saldo: Es ändert sich die Differenz der Zählung, nicht der Saldo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That day's balance was counted then. Made before the count, the transfer is already inside the balance counted: the difference of the count changes, not the balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de ese día se contó entonces. Si la transferencia se hizo antes del recuento, ya está dentro del saldo contado: cambia la diferencia del recuento, no el saldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde de ce jour a été compté à ce moment-là. Fait avant le comptage, le virement est déjà dans le solde compté : c'est l'écart du comptage qui change, pas le solde."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ օրվա մնացորդն արդեն հաշվված էր։ Եթե փոխանցումը կատարվել է հաշվումից առաջ, այն արդեն ներառված է հաշվված մնացորդում․ կփոխվի համադրման տարբերությունը, ոչ թե մնացորդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo di quel giorno è stato conteggiato a quell'ora. Se il trasferimento è precedente, è già incluso nel saldo conteggiato: cambia la differenza di riconciliazione, non il saldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日の残高は確認済みです。振替が残高確認前に行われた場合、確認した残高に含まれているため、残高ではなく確認差額が変わります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იმ დღის ნაშთი მაშინ უკვე შეჯერებული იყო. თუ გადარიცხვა შეჯერებამდე მოხდა, ის უკვე შეჯერებულ ნაშთში შედის: იცვლება შეჯერების სხვაობა და არა ნაშთი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сол күнгі теңгерім сол кезде есептелген. Санаудан бұрын жасалған болса, аударым есептелген теңгерімнің ішінде бар: өзгеретіні — санаудағы айырма, теңгерім емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 날짜의 잔액이 이미 확인되었습니다. 잔액 확인 전에 이체했다면 확인된 잔액에 이미 반영되어 있으므로 잔액이 아닌 확인 차액이 변경됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошол күндүн калдыгы такталган. Эгер которуу тактоого чейин жасалса, ал такталган калдыкка кирген: калдык эмес, тактоонун айырмасы өзгөрөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo van die dag is toen gecontroleerd. Als de overboeking vóór de controle is gedaan, zit deze al in het gecontroleerde saldo: het verschil bij de controle verandert, niet het saldo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo w tym dniu zostało już sprawdzone. Jeśli przelew nastąpił wcześniej, jest już uwzględniony w sprawdzonym saldzie: zmieni się różnica przy sprawdzeniu, a nie saldo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo desse dia já foi conferido. Se a transferência foi feita antes da conferência, ela já está incluída no saldo conferido: a diferença da conferência muda, mas o saldo não."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo desse dia foi contado nessa altura. Se a transferência foi feita antes da contagem, já está incluída no saldo contado: a diferença da contagem muda, mas o saldo não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В это время в тот день был сверен остаток. Если перевод был до сверки, он уже внутри сверенного остатка: изменится разница сверки, а не остаток."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи он рӯз дар ҳамон вақт ҳисоб шудааст. Агар интиқол пеш аз ҳисоб анҷом шуда бошад, он аллакай ба бақияи ҳисобшуда дохил аст: фарқи ҳисоб тағйир меёбад, на бақия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O günün bakiyesi o sırada sayıldı. Sayımdan önce yapılan transfer, sayılan bakiyeye zaten dahildir: bakiye değil, sayım farkı değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок того дня тоді вже був порахований. Якщо переказ зроблено до звірки, він уже входить до порахованого залишку: змінюється різниця звірки, а не залишок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘sha kunning qoldig‘i tekshirilgan. Agar o‘tkazma tekshiruvdan oldin qilingan bo‘lsa, u tekshirilgan qoldiqqa kiritilgan: qoldiq emas, tekshiruv farqi o‘zgaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当天的余额已对账。如果转账发生在对账前，则已计入对账余额：对账差额会改变，余额不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天的餘額已在該時間點核對。若轉帳發生在核對之前，已包含在核對的餘額中：對帳差額會改變，餘額則不變。"
          }
        }
      }
    },
    "transfer.beforeCount.no": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xeyr, sonra"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не, пасля"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne, až po ověření"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein, danach"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, After It"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No, después"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non, après"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչ, դրանից հետո"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No, dopo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいえ、確認後"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არა, შემდეგ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоқ, одан кейін"
          }
        },
        "ko": {
