    "account.savings.foreign": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пераводы ў іншай валюце не ўлічаны: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
