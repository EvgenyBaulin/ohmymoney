    "account.group.inSummaryHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söndürüldükdə qrupun vəsaiti «Cəmi» və sərbəst məbləğə daxil edilmir, ayrıca göstərilir; gəlir və xərcləri isə hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі выключана, грошы групы не ўваходзяць ва «Усяго» і свабодную суму ды паказваюцца асобна; яе даходы і выдаткі ўлічваюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po vypnutí se peníze skupiny nezahrnují do položek «Celkem» a částky k dispozici a zobrazují se zvlášť. Příjmy a výdaje se nadále započítávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet bleibt das Geld der Gruppe aus „Gesamt“ und dem freien Betrag heraus und wird separat angezeigt; ihre Einnahmen und Ausgaben zählen weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switched off, the money of the group stays out of «Total» and the free sum and is shown apart; its income and spending still count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, el dinero del grupo queda fuera de «Total» y de la suma libre y se muestra aparte; sus ingresos y gastos siguen contando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, l'argent du groupe reste hors de « Total » et de la somme libre et s'affiche à part ; ses revenus et dépenses comptent toujours."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անջատելու դեպքում խմբի գումարը չի ներառվում «Ընդամենը» և ազատ գումարի մեջ ու ցուցադրվում է առանձին․ եկամուտներն ու ծախսերը շարունակում են հաշվարկվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, il denaro del gruppo è escluso da «Totale» e dall’importo disponibile e viene mostrato a parte. Le entrate e le spese restano incluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、このグループの資金は「合計」と使える金額に含まれず、別に表示されます。収入と支出は引き続き集計されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამორთვისას ჯგუფის თანხა არ შედის «სულ» და თავისუფალ თანხაში და ცალკე ჩანს. მისი შემოსავალი და ხარჯი კვლავ ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өшірулі болса, топтың ақшасы «Барлығына» және бос қаржыға кірмейді, бөлек көрсетіледі; оның табысы мен шығысы әлі есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 그룹의 자금이 «총액»과 사용 가능 금액에서 제외되고 별도로 표시됩니다. 수입과 지출은 계속 집계됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өчүрүлсө, топтун акчасы «Жалпы суммага» жана эркин суммага кошулбай, өзүнчө көрсөтүлөт. Киреше менен чыгымдар эсепке алына берет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit uitstaat, blijft het geld van de groep buiten «Totaal» en het vrij te besteden bedrag en wordt het apart getoond. Inkomsten en uitgaven tellen wel mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wyłączeniu środki grupy nie są uwzględniane w «Razem» ani w kwocie dostępnej do wydania i są wyświetlane osobno; przychody i wydatki nadal są uwzględniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, o dinheiro do grupo fica fora de «Total» e do valor livre e é exibido à parte; suas receitas e despesas continuam sendo contabilizadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desativar esta opção, o dinheiro do grupo fica de fora de «Total» e do montante disponível e é apresentado à parte. Os rendimentos e as despesas continuam a ser contabilizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить, деньги группы не входят во «Всего» и в свободную сумму и показываются отдельно; её доходы и траты учитываются как раньше."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Агар хомӯш бошад, маблағи гурӯҳ ба «Total» ва маблағи озод дохил намешавад ва алоҳида нишон дода мешавад; даромад ва хароҷоти он ҳамоно ҳисоб мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatıldığında grubun parası «Toplam» ve kullanılabilir tutara dahil edilmez, ayrı gösterilir. Gelir ve harcamaları yine hesaba katılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнені, кошти групи не входять до «Усього» і вільної суми та показуються окремо; її доходи й витрати все одно враховуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘chirilsa, guruh mablag‘i «Jami» va sarflash mumkin bo‘lgan summaga kirmaydi va alohida ko‘rsatiladi; uning daromad va xarajatlari hisobga olinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，此分组的资金不会计入「总计」和可支配金额，并会单独显示；其收入和支出仍会计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，此群組的資金不計入「總額」和可用金額，並會另外顯示；收入和支出仍會計入。"
          }
        }
      }
    },
