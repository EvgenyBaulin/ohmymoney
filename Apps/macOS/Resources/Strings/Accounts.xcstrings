            "value": "Акысыз тейлөө үчүн %2$@ чейин дагы %1$@ коротуңуз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby prowadzenie było bezpłatne, wydaj jeszcze %1$@ do %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para obter serviços gratuitos, gaste mais %1$@ até %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До бесплатного обслуживания осталось потратить %1$@ до %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz hizmet için %2$@ tarihine kadar %1$@ daha harcayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб отримати безкоштовне обслуговування, витратьте ще %1$@ до %2$@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepul xizmat uchun %2$@ gacha yana %1$@ sarflang"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %2$@ 前再消費 %1$@ 即可免服務費"
          }
        }
      }
    },
