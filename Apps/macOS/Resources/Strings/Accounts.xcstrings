    "transfer.sheet.creditNoGrace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash and transfers from this credit card have no grace period: interest runs at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El efectivo y las transferencias desde esta tarjeta de crédito no tienen periodo de gracia: los intereses corren de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les retraits et virements depuis cette carte de crédit n'ont pas de période de grâce : les intérêts courent tout de suite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие и переводы с этой кредитки — без льготного периода: проценты пойдут сразу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готівка й перекази з цієї кредитної картки не мають пільгового періоду: відсотки нараховуються одразу."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prelievi e i trasferimenti da questa carta di credito non hanno un periodo di grazia: gli interessi maturano subito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кредиттік картадан қолма-қол ақша мен аударымдарда кейінге қалдыру кезеңі жоқ: пайыз бірден есептеледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На наяўныя і пераводы з гэтай крэдытнай карты льготны перыяд не дзейнічае: працэнты налічваюцца адразу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargeld und Überweisungen von dieser Kreditkarte haben keine zinsfreie Frist: Die Zinsen laufen sofort."
          }
        }
      }
    },
