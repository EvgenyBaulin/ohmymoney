    "account.credit.refusal.rate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rate is a percent above zero and up to 100."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка — процент больше нуля и не больше 100."
          }
        }
      }
    },
    "account.credit.statementDay": {
