    "account.merge.cardsMove": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” kartları “%2$@” hesabına köçürüləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карты з “%1$@” пераходзяць у “%2$@”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty účtu “%1$@” se přesunou k účtu “%2$@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karten von „%1$@“ wechseln zu „%2$@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cards of “%1$@” move to “%2$@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas de «%1$@» pasan a «%2$@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes de « %1$@ » passent à « %2$@ »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” հաշվի քարտերը կտեղափոխվեն “%2$@”։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le carte di “%1$@” passano a “%2$@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”のカードは“%2$@”に移動します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ანგარიშის ბარათები გადავა ანგარიშზე “%2$@”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” карталары “%2$@” есеп-шотына өтеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”의 카드가 “%2$@”(으)로 이동합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” карталары “%2$@” эсебине өтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaarten van “%1$@” gaan naar “%2$@”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty z „%1$@” zostaną przeniesione do „%2$@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cartões de “%1$@” passam para “%2$@”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cartões de “%1$@” passam para “%2$@”."
          }
        },
        "ru": {
