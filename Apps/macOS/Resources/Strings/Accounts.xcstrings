          "stringUnit": {
            "state": "translated",
            "value": "Non specificato: il giorno di apertura, altrimenti l’ultimo giorno del mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айтылмаған — ашылған күн, әйтпесе айдың соңғы күні"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зададзены — дзень адкрыцця, інакш апошні дзень месяца"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht angegeben — der Eröffnungstag, sonst der letzte Tag des Monats"
          }
        }
      }
    },
