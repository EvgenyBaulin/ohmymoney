    "account.editor.mainHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto steht in jeder Liste an erster Stelle; ein Vorgang ohne eigenes Konto wird ihm zugeordnet. Nur ein Konto ist das Hauptkonto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is first in every list; an operation with no account of its own goes to it. Only one account is main."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот әр тізімде бірінші тұрады; өз есеп-шоты жоқ операция соған жазылады. Негізгі бір ғана есеп-шот болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт — первый во всех списках; операция без своего счёта попадает на него. Основной счёт один."
          }
        }
      }
    },
    "account.editor.mainStays": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto lässt sich nicht ausschalten: Machen Sie ein anderes Konto zum Hauptkonto, dann ist dieses nicht mehr das Hauptkonto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be switched off: make another account main, and this one stops being main."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шотты өшіру мүмкін емес: басқа есеп-шотты негізгі етіңіз, осы есеп-шот негізгі болудан қалады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не выключается: сделайте основным другой счёт — этот перестанет им быть."
          }
        }
      }
    },
