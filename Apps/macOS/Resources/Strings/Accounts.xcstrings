            "state": "translated",
            "value": "Não foi possível ler um valor nas condições"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма в условиях не читается"
          }
        },
        "tr": {
          "stringUnit": {
