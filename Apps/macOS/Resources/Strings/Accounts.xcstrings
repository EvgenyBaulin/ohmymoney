    "bank.editor.newHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank kommt mit ihrem ersten Konto und ihrer ersten Karte, beide heißen wie sie, in der Standardwährung. Art, Währungen und Saldo des Kontos lassen sich danach ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank comes with its first account and card, both called like it, in the default currency. The kind, the currencies and the balance of the account can be changed afterwards."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк өзінің алғашқы есеп-шотымен және картасымен келеді, екеуі де банк атымен, әдепкі валютада. Есеп-шоттың түрін, валюталарын және теңгерімін кейін өзгертуге болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с банком появятся первый счёт и карта с тем же названием, в валюте по умолчанию. Вид, валюты и остаток счёта можно поправить потом."
          }
        }
      }
    },
