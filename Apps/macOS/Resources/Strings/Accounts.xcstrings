    "account.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі, пераводы, плацяжы і запісы пазык пяройдуць у «%1$@», а «%2$@» — у архіў з нулявым балансам; яго назва стане іншай назвай «%1$@». ⌘Z усё верне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, Überweisungen, Zahlungen und Schuldeneinträge wandern zu „%1$@“, und „%2$@“ kommt mit Saldo null ins Archiv; sein Name wird ein weiterer Name von „%1$@“. ⌘Z holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations, transfers, payments and debt entries move to «%1$@», and «%2$@» goes to the archive with a zero balance; its name becomes another name of «%1$@». ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones, transferencias, pagos y apuntes de deuda pasan a «%1$@», y «%2$@» va al archivo con saldo cero; su nombre pasa a ser otro nombre de «%1$@». ⌘Z devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations, virements, paiements et dettes passent sur « %1$@ », et « %2$@ » part aux archives avec un solde nul ; son nom devient un autre nom de « %1$@ ». ⌘Z rétablit tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Operazioni, trasferimenti, pagamenti e voci di debito passano a «%1$@» e «%2$@» viene archiviato con saldo zero; il suo nome diventa un altro nome di «%1$@». ⌘Z ripristina tutto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар, аударымдар, төлемдер және берешек жазбалары «%1$@» есеп-шотына көшеді, ал «%2$@» нөлдік теңгерімімен мұрағатқа өтеді; оның атауы «%1$@» басқа атына айналады. ⌘Z бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар, которуулар, төлөмдөр жана карыз жазуулары «%1$@» эсебине өтөт, ал эми «%2$@» нөл калдык менен архивге жылдырылат; анын аталышы «%1$@» эсебинин кошумча аталышы болот. ⌘Z баарын калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje, przelewy, płatności i wpisy dotyczące długów zostaną przeniesione do «%1$@», a «%2$@» trafi do archiwum z zerowym saldem. Jego nazwa stanie się drugą nazwą «%1$@». Naciśnij ⌘Z, aby cofnąć zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Operações, transferências, pagamentos e lançamentos de dívidas passam para «%1$@», e «%2$@» é arquivada com saldo zero; seu nome passa a ser outro nome de «%1$@». Use ⌘Z para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции, переводы, платежи и записи долгов перейдут на «%1$@», а «%2$@» уйдёт в архив с нулевым остатком; его название станет другим названием «%1$@». ⌘Z вернёт всё как было."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёт, интиқолҳо, пардохтҳо ва сабтҳои қарз ба «%1$@» мегузаранд ва «%2$@» бо бақияи сифр ба бойгонӣ меравад; номи он номи дигари «%1$@» мешавад. ⌘Z ҳама чизро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler, transferler, ödemeler ve borç kayıtları «%1$@» hesabına taşınır; «%2$@» sıfır bakiyeyle arşive kaldırılır ve adı «%1$@» hesabının diğer adı olur. ⌘Z ile tümü geri alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції, перекази, платежі та записи боргів переходять на «%1$@», а «%2$@» іде в архів з нульовим залишком; його назва стає ще однією назвою «%1$@». ⌘Z повертає все назад."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaliyotlar, o‘tkazmalar, to‘lovlar va qarz yozuvlari «%1$@» hisobiga o‘tadi, «%2$@» esa nol qoldiq bilan arxivga o‘tkaziladi; uning nomi «%1$@» hisobining boshqa nomiga aylanadi. ⌘Z hammasini tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易、轉帳、付款和債務記錄將移至 «%1$@»，而 «%2$@» 將以零餘額封存；其名稱將成為 «%1$@» 的別名。按 ⌘Z 可還原所有變更。"
          }
        }
      }
    },
