        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mało danych: szeroki zakres prognozy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco histórico: a faixa é ampla"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda há pouco histórico: o intervalo é amplo"
