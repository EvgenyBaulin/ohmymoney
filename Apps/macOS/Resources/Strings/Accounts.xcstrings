    "account.editor.otherNamesHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entry line knows the account by any of them. For example: Т-Банк — тинькофф, тинек."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea de entrada reconoce la cuenta por cualquiera de ellos. Por ejemplo: Т-Банк — тинькофф, тинек."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne de saisie reconnaît le compte par l'un d'eux. Par exemple : Т-Банк — тинькофф, тинек."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка ввода узнаёт счёт по любому из них. Например: Т-Банк — тинькофф, тинек."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок введення знає рахунок за будь-якою з них. Наприклад: Т-Банк — тинькофф, тинек."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi usare uno qualsiasi di questi nomi nella riga di inserimento. Ad esempio: Т-Банк — тинькофф, тинек."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енгізу жолы есеп-шотты кез келген атымен таниды. Мысалы: Т-Банк — тинькофф, тинек."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Радок уводу пазнае рахунак па любой з іх. Напрыклад: Т-Банк — тинькофф, тинек."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingabezeile erkennt das Konto an jedem dieser Namen. Zum Beispiel: Т-Банк — тинькофф, тинек."
          }
        }
      }
    },
