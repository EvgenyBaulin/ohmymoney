        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарих әлі аз: ауқым кең"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록이 아직 적어 예상 범위가 넓습니다"
