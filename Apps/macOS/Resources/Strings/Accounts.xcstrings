            "value": "Wprowadź kwotę większą od zera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um valor maior que zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите сумму больше нуля."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırdan büyük bir tutar girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть суму більше нуля."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Noldan katta summa kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入大於零的金額。"
          }
        }
      }
    },
    "transfer.refusal.rateMissing": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На той дзень няма курсу %@: нельга вылічыць камісію ў рублях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es keinen Kurs für %@: Die Gebühr lässt sich nicht in Rubel umrechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for that day: the fee cannot be told in rubles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tipo de %@ para ese día: la comisión no se puede expresar en rublos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de taux %@ pour ce jour : les frais ne peuvent pas être exprimés en roubles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è disponibile il tasso %@ per quel giorno: la commissione non può essere calcolata in rubli."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол күн үшін %@ мөлшерлемесі жоқ: комиссияны рубльмен санау мүмкін емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ал күнгө %@ курсу жок: комиссияны рубль менен эсептөөгө болбойт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu %@ w tym dniu. Nie można przeliczyć opłaty na ruble."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há cotação de %@ para esse dia. Não é possível calcular a tarifa em rublos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса %@ на этот день: комиссию не перевести в рубли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O gün için %@ kuru yok: ücret ruble cinsinden hesaplanamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день немає курсу %@: комісію не можна перерахувати в рублі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘sha kun uchun %@ kursi yo‘q: komissiyani rublda hisoblab bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有當天的 %@ 匯率，無法將手續費換算為盧布。"
          }
        }
      }
    },
    "transfer.refusal.sameKey": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак і валюта адпраўлення і атрымання супадаюць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von und nach ist dasselbe Konto in derselben Währung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From and to are the same account in the same currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Origen y destino son la misma cuenta en la misma divisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De et vers sont le même compte, dans la même devise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Origine e destinazione sono lo stesso conto nella stessa valuta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайдан және қайда бірдей есеп-шот, бірдей валюта."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жөнөтүүчү жана алуучу эсеп менен валюта бирдей."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto źródłowe i docelowe są takie same i mają tę samą walutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A origem e o destino são a mesma conta na mesma moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откуда и куда — один и тот же счёт в одной валюте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak ve hedef, aynı para birimindeki aynı hesap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звідки і куди — той самий рахунок у тій самій валюті."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul bir hisobning bir xil valyutasiga o‘tkazilmoqda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉出和轉入為同一帳戶的相同貨幣。"
          }
        }
      }
    },
    "transfer.refusal.toCurrency": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку атрымання няма гэтай валюты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto, zu dem das Geld geht, führt diese Währung nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account the money goes to does not hold this currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta a la que va el dinero no tiene esta divisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte qui reçoit l'argent ne détient pas cette devise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto di destinazione non contiene questa valuta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша баратын есеп-шотта бұл валюта жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча которулуучу эсепте бул валюта жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto docelowe nie obsługuje tej waluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta de destino não aceita esta moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт, куда приходят деньги, не держит эту валюту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranın gideceği hesapta bu para birimi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок, на який ідуть гроші, не має цієї валюти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul o‘tkaziladigan hisobda bu valyuta yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉入帳戶不支援此貨幣。"
          }
        }
      }
    },
