    "bank.min.below": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Balans minimum %1$@ məbləğindən %2$@ azdır: ay üzrə faiz itirilə bilər"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс на %2$@ ніжэйшы за мінімум %1$@: месячная стаўка можа быць страчана"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek je o %2$@ nižší než minimum %1$@: můžete přijít o úrok za tento měsíc"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo liegt um %2$@ unter dem Mindestsaldo von %1$@: Der Zinssatz für den Monat könnte verloren gehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance is below the minimum %1$@ by %2$@: the rate for the month may be lost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo está por debajo del mínimo %1$@ en %2$@: el tipo del mes puede perderse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde est inférieur de %2$@ au minimum de %1$@ : le taux du mois peut être perdu"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մնացորդը %1$@ նվազագույնից պակաս է %2$@-ով․ ամսվա տոկոսադրույքը կարող է կորչել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo è inferiore al minimo di %1$@ di %2$@: potresti perdere il tasso del mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高が最低額%1$@を%2$@下回っています。今月の金利が適用されない場合があります"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაშთი მინიმუმზე %1$@ ნაკლებია %2$@-ით: თვის სარგებელი შეიძლება დაიკარგოს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теңгерім ең аз %1$@ мөлшерінен %2$@ төмен: айдың мөлшерлемесі жоғалуы мүмкін"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액이 최소 잔액 %1$@보다 %2$@ 부족하여 이번 달 금리를 적용받지 못할 수 있습니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Калдык эң аз %1$@ суммасынан %2$@ аз: айлык пайыз жоголушу мүмкүн"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo ligt %2$@ onder het minimum van %1$@: de rente voor deze maand kan vervallen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo jest o %2$@ niższe od minimum %1$@: możesz stracić oprocentowanie za miesiąc"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo está %2$@ abaixo do mínimo de %1$@: a taxa do mês pode ser perdida"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo está %2$@ abaixo do mínimo de %1$@: pode perder os juros do mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток ниже неснижаемого %1$@ на %2$@: ставка за месяц может пропасть"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақия аз ҳадди ақали %1$@ ба андозаи %2$@ камтар аст: фоизи моҳона метавонад аз даст равад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiye, %1$@ minimumunun %2$@ altında: aylık faiz kaybedilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок нижче мінімуму %1$@ на %2$@: ставка за місяць може бути втрачена"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoldiq eng kam %1$@ miqdordan %2$@ kam: oylik foiz yo‘qolishi mumkin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额低于最低要求 %1$@，相差 %2$@：可能无法获得本月利率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額比最低限額 %1$@ 少 %2$@，可能無法享有本月利率"
          }
        }
      }
    },
