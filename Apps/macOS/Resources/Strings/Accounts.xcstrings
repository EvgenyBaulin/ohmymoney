    "bank.service.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şərtləri bankdan dəqiqləşdirin: bu rəqəmlər daxil etdiyiniz məlumatlara əsaslanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праверце ўмовы ў банку: гэтыя лічбы ўзяты з вашых запісаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřte si podmínky u banky: tyto údaje vycházejí z vašeho zadání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie die Bedingungen bei der Bank: Diese Zahlen stammen aus dem, was Sie eingetragen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the terms with the bank: these figures come from what you typed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise las condiciones con el banco: estas cifras salen de lo que escribió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les conditions auprès de la banque : ces chiffres viennent de ce que vous avez saisi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պայմանները ճշտեք բանկում․ այս թվերը ձեր մուտքագրած տվյալներից են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica le condizioni con la banca: questi importi si basano sui dati inseriti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この数値は入力内容に基づいています。条件は銀行にご確認ください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პირობები ბანკში გადაამოწმეთ: ეს მონაცემები თქვენ მიერ შეყვანილ ინფორმაციას ეფუძნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шарттарды банкпен тексеріңіз: бұл сандар сіз енгізгеннен шығады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
