    "archived.leftover.leg.back": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — перавод %2$@ з «%3$@» назад у «%4$@», каб пакрыць уведзенае на будучыню."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am %1$@ — eine Überweisung von %2$@ von „%3$@“ zurück auf „%4$@“, um das vorab Erfasste zu decken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %1$@ — a transfer of %2$@ from «%3$@» back to «%4$@», to cover what is typed ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$@ — una transferencia de %2$@ de «%3$@» a «%4$@», para cubrir lo que se introdujo por adelantado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %1$@ — un virement de %2$@ de « %3$@ » vers « %4$@ », pour couvrir ce qui est saisi d'avance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il %1$@ — trasferimento di %2$@ da «%3$@» a «%4$@», per coprire le operazioni future inserite."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күні — %2$@ аударымы, «%3$@» → «%4$@», алдын ала енгізілгенді жабу үшін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күнү — кийинчерээк киргизилген сумманы жабуу үчүн «%3$@» эсебинен «%4$@» эсебине %2$@ кайра которулат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — przelew %2$@ z «%3$@» z powrotem na «%4$@», aby pokryć kwoty wpisane z wyprzedzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$@ — uma transferência de %2$@ de «%3$@» de volta para «%4$@», para cobrir os valores lançados para datas futuras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — перевод %2$@ с «%3$@» обратно на «%4$@», чтобы покрыть записанное вперёд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarihinde, ileri tarihli girişleri karşılamak için «%3$@» hesabından «%4$@» hesabına %2$@ geri aktarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — переказ %2$@ з «%3$@» назад на «%4$@», щоб покрити введене наперед."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sanasida — keyingi kiritilgan amallarni qoplash uchun «%3$@»dan «%4$@»ga %2$@ qaytariladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：從 «%3$@» 轉回 %2$@ 至 «%4$@」，以支付預先輸入的款項。"
