    "account.editor.cushionHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın balansı ehtiyat fondudur. Neçə ay yetəcəyi «Kapital» bölməsində göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс рахунку — падушка: на колькі месяцаў яе хопіць, паказана ў «Капітале»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervu tvoří zůstatek účtu. Na kolik měsíců vystačí, najdete v části «Kapitál»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo des Kontos ist das Polster: Wie viele Monate es reicht, steht unter „Kapital“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance of the account is the cushion: how many months it lasts is on «Capital»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de la cuenta es el colchón: cuántos meses dura se ve en «Capital»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde du compte est le matelas : le nombre de mois qu'il couvre se trouve dans « Capital »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվի մնացորդը բարձիկն է․ քանի ամիս այն կբավականացնի՝ տես «Կապիտալ» բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo del conto costituisce il fondo di emergenza: in «Capital» puoi vedere per quanti mesi basta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座の残高を生活防衛資金とします。何か月分に相当するかは「資産」で確認できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უსაფრთხოების ბალიში ანგარიშის ნაშთია. რამდენ თვეს გასწვდება, იხილეთ «კაპიტალში»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттың теңгерімі — жастық: ол неше айға жететіні «Капиталда» көрсетіледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌 잔액이 비상 자금입니다. 몇 개월을 버틸 수 있는지는 «자산»에서 확인할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептин калдыгы — коопсуздук жаздыгы. Канча айга жетери «Капиталда» көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo van de rekening is de buffer. Bij «Kapitaal» zie je hoeveel maanden die meegaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo konta stanowi poduszkę: liczbę miesięcy, na które wystarczy, zobaczysz w «Kapitał»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo da conta é a reserva: veja quantos meses ela dura em «Capital»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo da conta é o fundo de emergência. Em «Capital» pode ver quantos meses dura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток счёта — подушка: на сколько месяцев её хватит, видно в «Капитале»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи ҳисоб захираи эҳтиётӣ аст: чанд моҳ басанда будани он дар «Capital» нишон дода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap bakiyesi güvence birikimidir. Kaç ay yeteceğini «Sermaye» bölümünde görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок рахунку і є подушкою: на «Капіталі» видно, на скільки місяців її вистачає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob qoldig‘i zaxira hisoblanadi. Uning necha oyga yetishi «Kapital»da ko‘rsatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户余额即为应急储备金；可在「资产」中查看能维持多少个月。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶餘額即為緊急預備金；可在「資產」查看能支應幾個月。"
          }
        }
      }
    },
