    "bank.fees.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu il komissiya və faiz yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэты год няма камісій ці працэнтаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto roce žádné poplatky ani úroky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Jahr keine Gebühren oder Zinsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No fees or interest in this year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay comisiones ni intereses en este año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucuns frais ni intérêts cette année."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս տարի միջնորդավճարներ կամ տոկոսներ չկան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna commissione o interesse in quest’anno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今年の手数料や利息はありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ წელს საკომისიო ან პროცენტი არ დარიცხულა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы жылы комиссия немесе пайыз жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올해 수수료 또는 이자가 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул жылы комиссиялар же пайыздар жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen kosten of rente in dit jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak opłat i odsetek w tym roku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarifa ou juro neste ano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem comissões ou juros neste ano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом году комиссий и процентов нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имсол комиссия ё фоизе нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yıl ücret veya faiz yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому році комісій чи відсотків немає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yilda komissiya yoki foizlar yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本年度无手续费或利息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今年沒有手續費或利息。"
          }
        }
      }
    },
