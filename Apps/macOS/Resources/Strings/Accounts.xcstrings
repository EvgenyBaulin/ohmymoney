    "bank.fees.summary": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выплачана банкам за год: %1$@ камісій + %2$@ працэнтаў па крэдытах"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Banken gezahlt im Jahr: %1$@ an Gebühren + %2$@ an Zinsen auf Kredite"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid to banks in the year: %1$@ in fees + %2$@ in interest on credits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagado a bancos en el año: %1$@ en comisiones + %2$@ en intereses de créditos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Versé aux banques dans l'année : %1$@ de frais + %2$@ d'intérêts sur crédits"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagato alle banche nell’anno: %1$@ di commissioni + %2$@ di interessi sui crediti"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жыл ішінде банктерге төленді: комиссияға %1$@ + несиеге пайызға %2$@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктарга жыл ичинде төлөндү: %1$@ комиссия + %2$@ насыя пайызы"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłacono bankom w roku: %1$@ opłat + %2$@ odsetek od kredytów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago aos bancos no ano: %1$@ em tarifas + %2$@ em juros de crédito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкам за год: %1$@ комиссий + %2$@ процентов по кредитам"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıl içinde bankalara ödenen: %1$@ ücret + %2$@ kredi faizi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплачено банкам за рік: %1$@ комісій + %2$@ відсотків за кредитами"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yil davomida banklarga to‘langan: %1$@ komissiya + %2$@ kredit foizlari"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "年度銀行支出：手續費 %1$@ + 信貸利息 %2$@"
          }
        }
      }
    },
