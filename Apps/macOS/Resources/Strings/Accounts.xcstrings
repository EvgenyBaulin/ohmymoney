    "transfer.sheet.creditNoGrace": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredit kartından nağdlaşdırma və köçürmələr üçün güzəşt müddəti yoxdur: faiz dərhal hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На наяўныя і пераводы з гэтай крэдытнай карты льготны перыяд не дзейнічае: працэнты налічваюцца адразу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na výběry a převody z této kreditní karty se nevztahuje bezúročné období. Úroky nabíhají ihned."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargeld und Überweisungen von dieser Kreditkarte haben keine zinsfreie Frist: Die Zinsen laufen sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash and transfers from this credit card have no grace period: interest runs at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El efectivo y las transferencias desde esta tarjeta de crédito no tienen periodo de gracia: los intereses corren de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les retraits et virements depuis cette carte de crédit n'ont pas de période de grâce : les intérêts courent tout de suite."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս վարկային քարտից կանխիկացման և փոխանցումների համար արտոնյալ ժամկետ չկա․ տոկոսները հաշվարկվում են անմիջապես։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prelievi e i trasferimenti da questa carta di credito non hanno un periodo di grazia: gli interessi maturano subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このクレジットカードからの現金引き出しと振替には無利息期間がなく、すぐに利息が発生します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ საკრედიტო ბარათიდან ნაღდი ფულის გატანასა და გადარიცხვებს საშეღავათო პერიოდი არ აქვს: პროცენტი მაშინვე ირიცხება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кредиттік картадан қолма-қол ақша мен аударымдарда кейінге қалдыру кезеңі жоқ: пайыз бірден есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 신용카드의 현금 인출과 이체에는 유예 기간이 없어 이자가 바로 발생합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул кредиттик картадан накталай акча алууга жана которууларга жеңилдетилген мөөнөт жок: пайыз дароо эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor contant geld en overboekingen met deze creditcard geldt geen rentevrije periode: rente gaat direct in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypłaty gotówki i przelewy z tej karty kredytowej nie mają okresu bezodsetkowego: odsetki są naliczane od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saques e transferências deste cartão de crédito não têm período de carência: os juros começam imediatamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantamentos e transferências deste cartão de crédito não têm período sem juros: os juros contam de imediato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие и переводы с этой кредитки — без льготного периода: проценты пойдут сразу."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои нақд ва интиқол аз ин корти кредитӣ давраи имтиёзнок нест: фоиз фавран ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredi kartından yapılan nakit çekim ve transferlerde faizsiz dönem yoktur; faiz hemen işlemeye başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готівка й перекази з цієї кредитної картки не мають пільгового періоду: відсотки нараховуються одразу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredit kartadan naqd pul yechish va oʻtkazmalarga imtiyozli davr qoʻllanmaydi: foizlar darhol hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此信用卡的取现和转账不享受免息期，将立即计息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此信用卡的提款和轉帳沒有寬限期，會立即計息。"
          }
        }
      }
    },
