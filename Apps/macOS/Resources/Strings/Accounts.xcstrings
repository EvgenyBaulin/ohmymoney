        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditní účet se zakládá spolu s první kartou. Necháte-li pole prázdné, karta se bude jmenovat jako účet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte wird zusammen mit ihrer ersten Karte eröffnet. Leer: Die Karte heißt wie das Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is opened together with its first card. Empty: the card is named like the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito se abre junto con su primera tarjeta. Si está vacío, la tarjeta se llama como la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit s'ouvre avec sa première carte. Vide : la carte porte le nom du compte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վարկային հաշիվը բացվում է առաջին քարտի հետ միասին։ Եթե դաշտը դատարկ է, քարտը կկոչվի հաշվի անունով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta di credito viene aperta insieme alla sua prima carta. Se lasci vuoto, la carta prende il nome del conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットカード口座と最初のカードが同時に作成されます。空欄の場合、カードには口座と同じ名前が付けられます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკრედიტო ანგარიში პირველ ბარათთან ერთად იხსნება. თუ ცარიელს დატოვებთ, ბარათს ანგარიშის სახელი დაერქმევა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта алғашқы картасымен бірге ашылады. Бос болса: карта есеп-шот атауымен аталады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신용카드 계좌와 첫 카드가 함께 생성됩니다. 비워 두면 계좌 이름이 카드 이름으로 사용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттик эсеп биринчи картасы менен ачылат. Бош калтырсаңыз, карта эсептин аталышын алат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een creditcardrekening wordt samen met de eerste kaart geopend. Laat leeg om de kaart dezelfde naam als de rekening te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto karty kredytowej jest otwierane wraz z pierwszą kartą. Jeśli pole jest puste, karta otrzyma nazwę konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta de cartão de crédito é aberta com seu primeiro cartão. Se deixar em branco, o cartão terá o nome da conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta de crédito é criada com o primeiro cartão. Se deixar em branco, o cartão terá o nome da conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитная карта открывается вместе с первой картой. Пусто: карта называется как счёт."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби кредитӣ ҳамроҳи корти аввал кушода мешавад. Агар холӣ гузоред, номи корт бо номи ҳисоб яксон мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi kartı, ilk kartıyla birlikte açılır. Boş bırakılırsa karta hesap adı verilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитний рахунок відкривається разом із його першою карткою. Якщо поле порожнє, картка називається так само, як рахунок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit hisobi birinchi kartasi bilan ochiladi. Bo‘sh qoldirilsa, karta hisob nomi bilan nomlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开立信用卡账户时会同时创建第一张卡。留空则使用账户名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開立信用卡帳戶時會一併新增第一張卡片。留白時，卡片名稱與帳戶相同。"
          }
        }
      }
    },
