    "bank.fees.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiyalara “Komissiyalar” kateqoriyası və alt kateqoriyaları, o cümlədən xidmət haqları daxildir; faizlər isə kredit və kredit kartları üzrə hesablanan məbləğlərdir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камісіі — катэгорыя “Камісіі” з падкатэгорыямі (таксама за абслугоўванне); працэнты — налічэнні па крэдытах і крэдытных картах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatky zahrnují kategorii „Poplatky“ a její podkategorie včetně poplatků za vedení. Úroky jsou částky účtované za úvěry a kreditní karty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebühren sind die Kategorie „Gebühren“ mit ihren Unterkategorien (auch Kontoführungsgebühren); Zinsen sind das, was Kredite und Kreditkarten berechnet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fees are the category “Fees” with its subcategories (service fees too); interest is what loans and credit cards charged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las comisiones son la categoría «Comisiones» con sus subcategorías (también las de servicio); los intereses son lo que cobraron los préstamos y las tarjetas de crédito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais sont la catégorie « Frais » avec ses sous-catégories (y compris les frais de service) ; les intérêts sont ce que facturent les crédits et cartes de crédit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միջնորդավճարները ներառում են «Միջնորդավճարներ» կատեգորիան և դրա ենթակատեգորիաները, այդ թվում՝ սպասարկման վճարները։ Տոկոսները վարկերի և վարկային քարտերի գանձած տոկոսներն են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le commissioni includono la categoria “Commissioni” e le sue sottocategorie, anche per il servizio. Gli interessi sono quelli addebitati su prestiti e carte di credito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手数料は「手数料」カテゴリとそのサブカテゴリ（口座維持手数料を含む）、利息はローンとクレジットカードにかかった利息です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკომისიო მოიცავს კატეგორიას „საკომისიო“ და მის ქვეკატეგორიებს, მათ შორის მომსახურების საფასურს; პროცენტი კი სესხებსა და საკრედიტო ბარათებზე დარიცხული პროცენტია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссиялар — «Комиссиялар» санаты мен оның ішкі санаттары (қызмет комиссиялары да); пайыз — несие мен кредиттік карталар алған."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수수료에는 “수수료” 카테고리와 하위 카테고리의 금액이 포함됩니다. 이자는 대출 및 신용카드에 부과된 금액입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссиялар — «Комиссиялар» категориясы жана анын ички категориялары, анын ичинде тейлөө акысы. Пайыздар — насыялар жана кредиттик карталар боюнча төлөмдөр."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosten zijn de categorie ‘Kosten’ en de subcategorieën, waaronder rekeningkosten. Rente is wat voor leningen en creditcards in rekening is gebracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłaty to kategoria „Opłaty” wraz z podkategoriami, w tym opłatami za prowadzenie. Odsetki to koszty kredytów i kart kredytowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarifas incluem a categoria “Tarifas” e suas subcategorias, inclusive tarifas de serviço. Juros são os cobrados em empréstimos e cartões de crédito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As comissões incluem a categoria “Comissões” e as respetivas subcategorias, incluindo manutenção; os juros são os cobrados em empréstimos e cartões de crédito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссии — категория «Комиссии» с подкатегориями (в том числе плата за обслуживание); проценты — то, что взяли кредиты и кредитные карты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссияҳо аз гурӯҳи «Комиссияҳо» ва зергурӯҳҳои он, аз ҷумла ҳаққи хизматрасонӣ, иборатанд; фоизҳо аз рӯйи қарзҳо ва кортҳои қарзӣ ҳисоб шудаанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretler, “Ücretler” kategorisini ve alt kategorilerini (hizmet ücretleri dahil) kapsar; faiz, kredi ve kredi kartlarına uygulanan faizdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісії — це категорія «Комісії» з її підкатегоріями (у тому числі комісії за обслуговування); відсотки — це те, що стягнули кредити й кредитні картки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiyalar — “Komissiyalar” toifasi va uning kichik toifalari, jumladan xizmat haqi; foizlar — kreditlar va kredit kartalari bo‘yicha hisoblangan foizlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手续费包括“手续费”类别及其子类别（包括服务费）；利息为贷款和信用卡收取的利息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手續費包括「手續費」類別及其子類別中的項目（包括服務費）；利息則是貸款和信用卡收取的利息。"
          }
        }
      }
    },
