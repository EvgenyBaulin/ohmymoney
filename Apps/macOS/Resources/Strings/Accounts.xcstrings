    "account.interest.notCounted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count the account — without a balance there is no interest to work out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuente la cuenta: sin saldo no hay intereses que calcular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez le compte — sans solde, il n'y a pas d'intérêts à calculer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверьте счёт — без остатка проценты не посчитать"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порахуйте рахунок — без залишку відсотків не розрахувати"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi il conto: senza saldo non è possibile calcolare gli interessi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотты есептеңіз — теңгерімсіз пайызды есептеу мүмкін емес"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падлічыце рахунак — без балансу нельга разлічыць працэнты"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählen Sie das Konto mit — ohne Saldo gibt es keine Zinsen zu berechnen"
          }
        }
      }
    },
    "account.interest.offHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a deposit or a savings account: the account screen then shows the interest expected and asks when a payout does not come."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un depósito o una cuenta de ahorro: la pantalla de la cuenta mostrará entonces los intereses previstos y preguntará cuando un abono no llegue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un dépôt ou un compte d'épargne : l'écran du compte affiche alors les intérêts attendus et demande quand un versement n'arrive pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вклада или накопительного счёта: экран счёта покажет ожидаемые проценты и спросит, если выплата не пришла."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для депозиту або накопичувального рахунку: екран рахунку тоді покаже очікувані відсотки й запитає, коли виплата не надійшла."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un deposito o un conto di risparmio: la schermata del conto mostra gli interessi previsti e segnala gli accrediti mancati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салым немесе жинақ шоты үшін: есеп-шот экраны күтілетін пайызды көрсетеді және төлем келмесе, сұрайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ўкладу ці ашчаднага рахунку: на экране з'явяцца чаканыя працэнты і пытанне, калі выплата не паступіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein Festgeld oder Sparkonto: Der Bildschirm des Kontos zeigt dann die erwarteten Zinsen und fragt nach, wenn eine Auszahlung ausbleibt."
          }
        }
      }
    },
