    "card.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartın öz keşbek qaydaları da silinəcək. ⌘Z ilə hər şeyi geri qaytara bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уласныя правілы кэшбэку выдаляюцца разам з ёй. ⌘Z усё адновіць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smažou se i vlastní pravidla cashbacku. Stisknutím ⌘Z vše obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigenen Cashback-Regeln gehen mit ihr. ⌘Z holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its own cashback rules go with it. ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus reglas propias de cashback se eliminan con ella. ⌘Z lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses règles de cashback propres partent avec elle. ⌘Z rétablit tout."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քարտի սեփական քեշբեքի կանոնները նույնպես կջնջվեն։ ⌘Z-ը կվերականգնի ամեն ինչ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le sue regole cashback verranno eliminate. Premi ⌘Z per ripristinare tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のキャッシュバックルールも削除されます。⌘Zですべて元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარათთან ერთად მისი ქეშბექის წესებიც წაიშლება. ყველაფრის აღდგენა ⌘Z-ით შეგიძლიათ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның өз кешбэк ережелері де бірге кетеді. ⌘Z бәрін қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드의 캐시백 규칙도 삭제됩니다. ⌘Z를 눌러 모두 복원할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Анын өз кэшбэк эрежелери да өчүрүлөт. ⌘Z баарын калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eigen cashbackregels worden ook verwijderd. Met ⌘Z maak je dit ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własne zasady cashbacku karty też zostaną usunięte. ⌘Z przywróci wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras próprias de cashback também serão apagadas. Use ⌘Z para restaurar tudo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras de cashback próprias também serão apagadas. Prima ⌘Z para repor tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её собственные правила кэшбэка удалятся вместе с ней. ⌘Z вернёт всё."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоидаҳои кешбэки он низ нест мешаванд. ⌘Z ҳама чизро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta ait para iadesi kuralları da silinir. ⌘Z ile tümünü geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Разом із нею зникають її власні правила кешбеку. ⌘Z поверне все."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartaning o‘z keshbek qoidalari ham o‘chiriladi. ⌘Z hammasini tiklaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片的自定返现规则也会被删除。按 ⌘Z 可全部恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片的專屬現金回饋規則也會一併刪除。按下 ⌘Z 可還原所有內容。"
          }
        }
      }
    },
    "card.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartın öz keşbek qaydaları da silinəcək. “Geri al” ilə hər şeyi geri qaytara bilərsiniz."
          }
