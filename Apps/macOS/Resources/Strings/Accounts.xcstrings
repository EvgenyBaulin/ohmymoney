    "bank.merge.undo": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z bankı əvvəlki vəziyyətinə qaytarır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z адновіць банк у ранейшым стане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stisknutím ⌘Z obnovíte původní stav banky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z holt die Bank so zurück, wie sie war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z brings the bank back as it was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z devuelve el banco tal como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ramène la banque telle qu'elle était."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z-ը կվերականգնի բանկի նախկին վիճակը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ripristina la banca com’era."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Zで銀行を元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ბანკს პირვანდელ მდგომარეობაში დააბრუნებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z банкті бұрынғыдай қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z를 누르면 은행이 원래대로 복원됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z банкты мурунку абалына кайтарат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ⌘Z herstel je de bank zoals deze was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z przywraca bank do poprzedniego stanu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z restaura o banco como estava."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z repõe o banco como estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z вернёт банк как был."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z бонкро ба ҳолати пешина бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z bankayı eski haline getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z поверне банк таким, яким він був."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z bankni avvalgi holatiga qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌘Z 可将银行恢复原状。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 ⌘Z 即可還原銀行。"
          }
        }
      }
    },
