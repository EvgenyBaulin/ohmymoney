    "card.merge.rulesDropped": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saxlanılan kartda eyni ay və kateqoriya üçün artıq qayda var: onun qaydası saxlanılacaq, bu qaydalar silinəcək: %lld"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правілы на месяц і катэгорыю, для якіх захаваная карта ўжо мае правіла — яе застанецца, гэтыя выдаляюцца: %lld"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidla pro měsíc a kategorii, pro které už zachovaná karta pravidlo má, se smažou. Jejich počet: %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln für einen Monat und eine Kategorie, für die die behaltene Karte schon eine Regel hat — ihre eigene bleibt, diese werden gelöscht: %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules for a month and category the kept card already has a rule for — its own stays, these are deleted: %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglas de un mes y categoría para las que la tarjeta que se conserva ya tiene regla — se queda la suya propia, estas se eliminan: %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles pour un mois et une catégorie pour lesquels la carte conservée a déjà une règle — la sienne reste, celles-ci sont supprimées : %lld"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա և կատեգորիայի կանոններից, որոնց համար պահպանվող քարտն արդեն կանոն ունի, կմնան դրա կանոնները, իսկ սրանք կջնջվեն՝ %lld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i mesi e le categorie con una regola sulla carta mantenuta, la sua regola resta e queste vengono eliminate: %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ月とカテゴリに結合先のルールがある場合は、そのルールを残して以下を削除します: %lld"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წესები თვისა და კატეგორიისთვის, რომლებზეც დარჩენილ ბარათს უკვე აქვს წესი — მისი წესი დარჩება, ეს წესები კი წაიშლება: %lld"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалатын картада ережесі бар ай мен санат үшін ережелер — оның өз ережесі қалады, мыналар жойылады: %lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지할 카드에 이미 규칙이 있는 월과 카테고리는 기존 규칙이 유지되고 다음 규칙은 삭제됩니다: %lld개"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сакталган картада ошол ай жана категория үчүн эреже бар болсо, ал сакталып, бул эрежелер өчүрүлөт: %lld"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor maand en categorie met al een regel op de behouden kaart blijft die regel staan. Verwijderd: %lld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasady dla miesiąca i kategorii, dla których zachowana karta ma już zasadę — jej zasada pozostanie, a te zostaną usunięte: %lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regras de mês e categoria que já existem no cartão mantido — as regras dele serão mantidas e estas serão apagadas: %lld"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Regras para um mês e categoria para os quais o cartão mantido já tem uma regra: a regra existente mantém-se e estas são apagadas: %lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил на месяц и категорию, для которых у оставшейся карты уже есть своё правило, — остаётся её, эти удалятся: %lld"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Агар корти боқимонда барои ҳамон моҳ ва категория қоида дошта бошад, қоидаи он мемонад ва инҳо нест мешаванд: %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunacak kartta aynı ay ve kategori için kural varsa o kural korunur, diğerleri silinir: %lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила на місяць і категорію, для яких у картки, що лишається, уже є правило, — її власне лишається, а ці видаляються: %lld"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Saqlanadigan kartada shu oy va toifa uchun qoida bor bo‘lsa, uning qoidasi qoladi, bu qoidalar esa o‘chiriladi: %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的卡片在相同月份和类别已有规则时，将保留原有规则并删除以下规则：%lld 条"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的卡片在相同月份和類別已有規則，將保留原有規則並刪除這些規則：%lld"
          }
        }
      }
    },
