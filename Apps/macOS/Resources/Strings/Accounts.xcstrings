    "accounts.delete.messageMoney": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance %@ leaves every total with it. Nothing refers to the account. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo %@ sale de todos los totales con ella. Nada hace referencia a la cuenta. ⌘Z la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde %@ sort de tous les totaux avec lui. Rien ne s'y réfère. ⌘Z le rétablit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток %@ пропадёт из итогов. На счёт ничто не ссылается. ⌘Z вернёт его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок %@ разом із ним зникає з усіх підсумків. Ніщо на рахунок не посилається. ⌘Z поверне його."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo %@ verrà rimosso da tutti i totali. Nessun elemento fa riferimento al conto. Premi ⌘Z per ripristinarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімі оның бірге барлық жиынтықтан шығады. Есеп-шотқа ештеңе сілтемейді. ⌘Z қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс %@ знікне з усіх вынікаў разам з рахункам. Нішто на рахунак не спасылаецца. ⌘Z адновіць яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo %@ verschwindet mit ihm aus allen Summen. Nichts verweist auf das Konto. ⌘Z holt es zurück."
          }
        }
      }
    },
