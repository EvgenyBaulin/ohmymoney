    "bank.cond.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type what the bank's own app says. The app learns nothing from the bank and does not give advice: check the terms with the bank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba lo que dice la propia app del banco. La app no recibe nada del banco y no da consejos: revise las condiciones con el banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ce qu'indique l'application de la banque. L'application n'apprend rien de la banque et ne donne aucun conseil : vérifiez les conditions auprès de la banque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите то, что написано в приложении банка. Приложение ничего не узнаёт у банка и не даёт советов: уточните условия в банке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть те, що написано в застосунку самого банку. Застосунок нічого не отримує від банку й не дає порад: умови уточнюйте в банку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci i dati indicati nell’app della banca. L’app non riceve dati dalla banca e non fornisce consigli: verifica le condizioni con la banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктің өз қолданбасы не көрсетсе, соны теріңіз. Қолданба банктен ештеңе үйренбейді және кеңес бермейді: шарттарды банкпен тексеріңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце ўмовы з праграмы банка. Праграма не атрымлівае даных ад банка і не дае парад: правярайце ўмовы ў банку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie ein, was die eigene App der Bank anzeigt. Die App erfährt nichts von der Bank und gibt keine Empfehlungen: Prüfen Sie die Bedingungen bei der Bank."
          }
        }
      }
    },
