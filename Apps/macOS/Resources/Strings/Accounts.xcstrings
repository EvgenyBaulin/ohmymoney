    "transfer.sheet.creditNoGrace": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На наяўныя і пераводы з гэтай крэдытнай карты льготны перыяд не дзейнічае: працэнты налічваюцца адразу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargeld und Überweisungen von dieser Kreditkarte haben keine zinsfreie Frist: Die Zinsen laufen sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash and transfers from this credit card have no grace period: interest runs at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El efectivo y las transferencias desde esta tarjeta de crédito no tienen periodo de gracia: los intereses corren de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les retraits et virements depuis cette carte de crédit n'ont pas de période de grâce : les intérêts courent tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prelievi e i trasferimenti da questa carta di credito non hanno un periodo di grazia: gli interessi maturano subito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кредиттік картадан қолма-қол ақша мен аударымдарда кейінге қалдыру кезеңі жоқ: пайыз бірден есептеледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул кредиттик картадан накталай акча алууга жана которууларга жеңилдетилген мөөнөт жок: пайыз дароо эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypłaty gotówki i przelewy z tej karty kredytowej nie mają okresu bezodsetkowego: odsetki są naliczane od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saques e transferências deste cartão de crédito não têm período de carência: os juros começam imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снятие и переводы с этой кредитки — без льготного периода: проценты пойдут сразу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredi kartından yapılan nakit çekim ve transferlerde faizsiz dönem yoktur; faiz hemen işlemeye başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готівка й перекази з цієї кредитної картки не мають пільгового періоду: відсотки нараховуються одразу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredit kartadan naqd pul yechish va oʻtkazmalarga imtiyozli davr qoʻllanmaydi: foizlar darhol hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此信用卡的提款和轉帳沒有寬限期，會立即計息。"
          }
        }
      }
    },
