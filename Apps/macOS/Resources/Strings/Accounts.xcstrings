    "account.editor.currenciesHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk valyuta əsas valyutadır: hesabda olmayan valyuta ilə əməliyyatlar onunla tutulur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Першая валюта — асноўная: аперацыі ў валютах, якіх няма на рахунку, спісваюцца ў ёй."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První měna je hlavní. V ní se zaúčtuje operace v měně, kterou účet neobsahuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Währung ist die Hauptwährung: Ein Vorgang in einer Währung, die das Konto nicht führt, wird in dieser Währung belastet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first currency is the main one: an operation in a currency the account does not hold is charged in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera divisa es la principal: una operación en una divisa que la cuenta no tiene se cobra en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première devise est la principale : une opération dans une devise que le compte ne détient pas est débitée dans celle-ci."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առաջին արժույթը հիմնականն է․ հաշվին չպահվող արժույթով գործարքները գանձվում են դրանով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima valuta è quella principale: le operazioni in una valuta non presente nel conto vengono addebitate in questa valuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の通貨がメイン通貨です。口座にない通貨での取引は、メイン通貨で引き落とされます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პირველი ვალუტა მთავარია: ანგარიშზე არარსებულ ვალუტაში ოპერაცია მასში ჩამოიჭრება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірінші валюта — негізгі: есеп-шотта жоқ валютамен жасалған операция соның бойынша есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 통화가 기본 통화입니다. 계좌에 없는 통화로 거래하면 기본 통화로 결제됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Биринчи валюта — негизги валюта: эсепте жок валютадагы операция ошол валютада алынат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste valuta is de hoofdvaluta: transacties in een andere valuta worden hierin verrekend als de rekening die valuta niet heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza waluta jest główna: w niej rozliczane są operacje w walutach, których nie ma na koncie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira moeda é a principal: operações em moedas que a conta não possui são cobradas nela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira moeda é a principal: as operações numa moeda que a conta não tem são cobradas nesta moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая валюта — основная: операция в валюте, которой у счёта нет, списывается в ней."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Асъори аввал асосӣ аст: амалиёт бо асъоре, ки дар ҳисоб нест, бо он ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk para birimi ana para birimidir. Hesapta bulunmayan bir para birimindeki işlem bu birimden düşülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перша валюта — основна: операція у валюті, якої немає на рахунку, списується в ній."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinchi valyuta asosiy hisoblanadi: hisobda bo‘lmagan valyutadagi operatsiyalar undan yechiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一种货币为主要货币：账户未持有的货币交易将以该货币扣款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
