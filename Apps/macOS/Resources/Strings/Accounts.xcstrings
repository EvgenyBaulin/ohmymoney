    "account.editor.pointsHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце дату і колькасць балаў, якія згараюць, паводле даных банка. Кошт бала роўны курсу валюты гэтага рахунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Datum und die Anzahl der Punkte ein, die laut Bank verfallen. Ein Punkt entspricht dem Kurs der Währung dieses Kontos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type what the bank says: the day and how many points burn. A point is worth the rate of the currency of this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la fecha y los puntos que caducan según el banco. El valor de un punto depende del tipo de cambio de la moneda de esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la date et le nombre de points qui expirent selon votre banque. Un point vaut le taux de la devise de ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la data e il numero di punti in scadenza indicati dalla banca. Un punto vale il tasso della valuta di questo conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк көрсеткен күн мен күйіп кететін ұпай санын енгізіңіз. Ұпай құны осы шот валютасының бағамына тең."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj datę i liczbę wygasających punktów zgodnie z informacją banku. Wartość punktu określa kurs waluty tego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe a data e a quantidade de pontos que expiram, conforme o banco. Cada ponto vale a cotação da moeda desta conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите то, что говорит банк: день и сколько баллов сгорит. Балл стоит столько, сколько курс валюты этого счёта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankanın belirttiği tarihi ve süresi dolacak puan miktarını girin. Bir puanın değeri, bu hesabın para biriminin kuruna eşittir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть дату й кількість балів, які згорять, за даними банку. Вартість бала дорівнює курсу валюти цього рахунку."
          }
        }
      }
    },
