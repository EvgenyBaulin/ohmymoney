    "bank.settings.forgottenDays.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts and cards nothing moves on this long, with money or a charge on them, are listed as forgotten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas y tarjetas sin movimientos durante este tiempo, con dinero o un cargo, aparecen como olvidadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes et cartes sans aucun mouvement pendant ce délai, avec de l'argent ou des frais, sont listés comme oubliés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета и карты, на которых столько дней нет движения, а деньги или плата есть, попадают в «Забытые деньги»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки й картки, за якими стільки часу нічого не рухається, а на них є гроші або плата, потрапляють до списку забутих."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I conti e le carte senza movimenti per questo periodo, con un saldo o un costo, sono elencati come dimenticati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осыншама күн қозғалыссыз тұрған, ақшасы немесе ақы алуы бар есеп-шоттар мен карталар ұмытылғандар тізіміне қосылады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахункі і карты без руху такі час, з грашыма ці платай за абслугоўванне, паказваюцца як забытыя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten und Karten, auf denen so lange nichts bewegt wird und mit Geld oder einer Gebühr darauf, werden als vergessen aufgeführt."
          }
        }
      }
    },
