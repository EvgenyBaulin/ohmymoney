        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія за готівку та перекази, %"
          }
        }
      }
    },
    "account.credit.firstCard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card name"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название карты"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва картки"
          }
        }
      }
    },
    "account.credit.firstCardHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is opened together with its first card. Empty: the card is named like the account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитная карта открывается вместе с первой картой. Пусто: карта называется как счёт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитний рахунок відкривається разом із його першою карткою. Якщо поле порожнє, картка називається так само, як рахунок."
          }
        }
      }
    },
    "account.credit.grace": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
