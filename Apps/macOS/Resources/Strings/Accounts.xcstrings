    "account.merge.unknownHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга вылічыць баланс гэтай валюты. Увядзіце яго, калі ведаеце, або пакіньце пустым і зверце пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo dieser Währung lässt sich nicht berechnen. Tragen Sie ihn ein, wenn Sie ihn kennen, oder lassen Sie das Feld leer und gleichen später ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance of this currency cannot be worked out. Enter it if you know it, or leave it empty and reconcile later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de esta divisa no se puede calcular. Introdúzcalo si lo conoce, o déjelo vacío y concilie más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde de cette devise ne peut pas être calculé. Saisissez-le si vous le connaissez, ou laissez vide et rapprochez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile calcolare il saldo di questa valuta. Inseriscilo se lo conosci oppure lascia il campo vuoto e riconcilia più tardi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл валютаның теңгерімін есептеу мүмкін емес. Білсеңіз, енгізіңіз, әйтпесе бос қалдырып, кейін салыстырыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул валютанын калдыгын эсептөө мүмкүн эмес. Билсеңиз киргизиңиз же бош калтырып, кийин тактаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można ustalić salda tej waluty. Wpisz je, jeśli je znasz, lub zostaw pole puste i uzgodnij saldo później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível calcular o saldo nesta moeda. Informe-o se souber ou deixe em branco e concilie depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в этой валюте не посчитать. Введите его, если знаете, или оставьте пустым и сверьте позже."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи ин асъорро ҳисоб кардан намешавад. Агар медонед, ворид кунед ё холӣ монед ва баъдтар муқоиса кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu para biriminin bakiyesi hesaplanamıyor. Biliyorsanız girin veya boş bırakıp daha sonra mutabakat yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок цієї валюти не можна розрахувати. Введіть його, якщо знаєте, або залиште порожнім і звірте пізніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu valyuta qoldig‘ini hisoblab bo‘lmaydi. Bilsangiz, kiriting yoki bo‘sh qoldirib, keyinroq solishtiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法計算此貨幣的餘額。若知道餘額，請輸入；也可留空，稍後再對帳。"
          }
        }
      }
    },
    "account.refusal.balanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс рахунку невядомы: на ім быў рух грошай, але ён ніколі не звяраўся. Зверце яго; пры нулявым балансе можна архіваваць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo des Kontos ist niemandem bekannt: Auf dem Konto wurde Geld bewegt, es wurde aber nie abgeglichen. Gleichen Sie es ab; bei null kann es ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance of the account: money moved on it, but it was never reconciled. Reconcile it; at zero it can go to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie conoce el saldo de la cuenta: se movió dinero en ella, pero nunca se conció. Concíliela; con saldo cero puede pasar al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne connaît le solde du compte : de l'argent y a bougé, mais il n'a jamais été rapproché. Rapprochez-le ; à zéro, il peut aller aux archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo del conto è sconosciuto: ci sono stati movimenti, ma non è mai stato riconciliato. Riconcilialo; se il saldo è zero, puoi archiviarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттың теңгерімі ешкімге белгісіз: онда ақша қозғалды, бірақ ешқашан салыстырылмаған. Салыстырыңыз; нөлде ол мұрағатқа өтуі мүмкін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсепте акча кыймылы болгон, бирок калдык эч качан такталган эмес. Калдыгын тактаңыз; нөл болсо, эсепти архивге жылдырса болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo konta jest nieznane: były na nim operacje, ale nigdy nie uzgodniono salda. Uzgodnij saldo. Gdy wyniesie zero, konto będzie można przenieść do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo da conta é desconhecido: houve movimentações, mas ela nunca foi conciliada. Concilie a conta; com saldo zero, ela pode ser arquivada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток счёта неизвестен: по нему были движения, но его ни разу не сверяли. Сверьте счёт — с нулём его можно убрать в архив."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи суратҳисоб номаълум аст: дар он гардиши пул буд, аммо бақияаш ҳеҷ гоҳ муқоиса нашудааст. Бақияро муқоиса кунед; агар сифр бошад, онро ба бойгонӣ бурдан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın bakiyesi bilinmiyor: hesapta para hareketi var ancak hiç mutabakat yapılmamış. Mutabakat yapın; bakiye sıfırken hesap arşive kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок рахунку ніхто не знає: кошти на ньому рухалися, але його ніколи не звіряли. Звірте його; з нульовим залишком він може піти в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob qoldig‘i noma’lum: unda pul harakati bo‘lgan, lekin qoldiq hech qachon solishtirilmagan. Qoldiqni solishtiring; u nol bo‘lsa, hisobni arxivga o‘tkazish mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶餘額未知：此帳戶有資金往來，但從未對帳。請先對帳，餘額為零時即可封存。"
          }
        }
      }
    },
    "account.refusal.bankHasLiveAccounts": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка яшчэ ёсць рахункі па-за архівам: спачатку архівуйце іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat noch Konten außerhalb des Archivs: Verschieben Sie diese zuerst ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank still has accounts outside the archive: move them to the archive first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco aún tiene cuentas fuera del archivo: pásalas antes al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque a encore des comptes hors des archives : mettez-les d'abord aux archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca ha ancora conti non archiviati: archiviali prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкте әлі мұрағатта жоқ есеп-шоттар бар: алдымен оларды мұрағатқа өткізіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын архивден тышкары эсептери бар. Адегенде аларды архивге жылдырыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank nadal ma konta poza archiwum. Najpierw przenieś je do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco ainda tem contas ativas. Arquive-as primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка есть счета не в архиве — сначала уберите в архив их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк то ҳол суратҳисобҳои берун аз бойгонӣ дорад: аввал онҳоро ба бойгонӣ баред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankanın arşiv dışında hesapları var. Önce bunları arşive kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У банку ще є рахунки поза архівом: спершу перенесіть їх в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankda hali arxivga o‘tkazilmagan hisoblar bor: avval ularni arxivga o‘tkazing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此銀行仍有未封存的帳戶，請先將這些帳戶封存。"
          }
        }
      }
    },
    "account.refusal.bankInUse": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да банка адносяцца рахункі, у тым ліку архіўныя: яго можна архіваваць, але не выдаліць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Bank stehen Konten, auch archivierte: Sie kann ins Archiv, nicht gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, archived ones too, are under the bank: it can go to the archive, not be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cuentas, también archivadas, bajo el banco: puede pasar al archivo, pero no eliminarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des comptes, même archivés, sont rattachés à la banque : elle peut aller aux archives, mais non être supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca contiene conti, anche archiviati: puoi archiviarla, ma non eliminarla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк астында есеп-шоттар бар, мұрағаттағылар да: ол мұрағатқа өтуі мүмкін, бірақ жойылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкка эсептер, анын ичинде архивдегилери да таандык. Аны архивге жылдырса болот, бирок өчүрүүгө болбойт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do banku są przypisane konta, również te w archiwum. Można go przenieść do archiwum, ale nie można go usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há contas vinculadas ao banco, inclusive arquivadas. Ele pode ser arquivado, mas não apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под банком есть счета, в том числе архивные: его можно убрать в архив, но не удалить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисобҳо, аз ҷумла суратҳисобҳои бойгонӣ, ба ин бонк тааллуқ доранд: онро ба бойгонӣ бурдан мумкин аст, аммо нест кардан не."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bankaya bağlı hesaplar var; arşivdekiler de dahil. Banka silinemez, ancak arşive kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під банком є рахунки, в тому числі архівні: він може піти в архів, але не видалитися."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankka hisoblar, jumladan arxivdagilari ham bog‘langan: bankni arxivga o‘tkazish mumkin, ammo o‘chirib bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此銀行下仍有帳戶，包括已封存的帳戶；只能封存，無法刪除。"
          }
        }
      }
    },
    "account.refusal.bankNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк з такой назвай ужо ёсць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank mit diesem Namen gibt es bereits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank with this name already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un banco con este nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une banque portant ce nom existe déjà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già una banca con questo nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен банк бұрыннан бар."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мындай аталыштагы банк мурунтан бар."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank o tej nazwie już istnieje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um banco com este nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк с таким названием уже есть."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк бо ин ном аллакай вуҷуд дорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ada sahip bir banka zaten var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк із такою назвою вже є."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunday nomli bank allaqachon mavjud."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名的銀行。"
          }
        }
      }
    },
    "account.refusal.creditCardNeedsCard": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крэдытны рахунак нельга захаваць без карты. Дайце карце ўнікальную назву."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte lässt sich nicht ohne Karte speichern. Geben Sie der Karte einen Namen, den noch nichts anderes hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card cannot be saved without a card. Give the card a name that nothing else has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito no se puede guardar sin tarjeta. Dé a la tarjeta un nombre que no use nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit ne peut pas être enregistrée sans carte. Donnez à la carte un nom qu'aucune autre n'a."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi salvare una carta di credito senza una carta. Assegna alla carta un nome non ancora utilizzato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік картаны карта жоқ сақтау мүмкін емес. Картаға басқа ешкімде жоқ атау беріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттик картаны картасыз сактоого болбойт. Картага кайталангыс ат бериңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać konta karty kredytowej bez karty. Nadaj karcie niepowtarzalną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta de cartão de crédito precisa ter um cartão. Dê ao cartão um nome que ainda não esteja em uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитную карту нельзя сохранить без карты. Назовите карту так, как не называется ничего другого."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Корти кредитиро бе корт нигоҳ доштан мумкин нест. Ба корт номи такрорнашаванда диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi kartı, kart olmadan kaydedilemez. Karta benzersiz bir ad verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитну картку не можна зберегти без картки. Дайте картці назву, якої ні в кого немає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit hisobini kartasiz saqlab bo‘lmaydi. Kartaga takrorlanmas nom bering."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡帳戶必須有卡片才能儲存。請為卡片輸入不重複的名稱。"
          }
        }
      }
    },
    "account.refusal.currencyBalanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс у %@ невядомы: быў рух грошай, але зверак не было. Зверце рахунак; пры нулявым балансе валюту можна прыбраць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo in %@ ist niemandem bekannt: Darin wurde Geld bewegt, es wurde aber nie abgeglichen. Gleichen Sie das Konto ab; bei null kann die Währung entfernt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance in %@: money moved in it, but it was never reconciled. Reconcile the account; at zero the currency can go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie conoce el saldo en %@: se movió dinero en ella, pero nunca se conció. Concilie la cuenta; con saldo cero la divisa puede quitarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne connaît le solde en %@ : de l'argent y a bougé, mais il n'a jamais été rapproché. Rapprochez le compte ; à zéro, la devise peut partir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo in %@ è sconosciuto: ci sono stati movimenti, ma non è mai stato riconciliato. Riconcilia il conto; se il saldo è zero, puoi rimuovere la valuta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ валютасындағы теңгерім ешкімге белгісіз: онда ақша қозғалды, бірақ ешқашан салыстырылмаған. Есеп-шотты салыстырыңыз; нөлде валюта жойылуы мүмкін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ боюнча акча кыймылы болгон, бирок калдык эч качан такталган эмес. Эсептин калдыгын тактаңыз; нөл болсо, валютаны алып салса болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo w walucie %@ jest nieznane: były w niej operacje, ale nigdy nie uzgodniono salda. Uzgodnij saldo konta. Gdy wyniesie zero, walutę będzie można usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo em %@ é desconhecido: houve movimentações nessa moeda, mas a conta nunca foi conciliada. Concilie a conta; com saldo zero, a moeda pode ser removida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в %@ неизвестен: движения были, но валюту ни разу не сверяли. Сверьте счёт — с нулём валюту можно убрать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақия бо %@ номаълум аст: бо ин асъор гардиши пул буд, аммо бақияаш ҳеҷ гоҳ муқоиса нашудааст. Бақияи суратҳисобро муқоиса кунед; агар сифр бошад, асъорро хориҷ кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyesi bilinmiyor: bu para biriminde hareket var ancak hiç mutabakat yapılmamış. Hesapta mutabakat yapın; bakiye sıfırken para birimi kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок у %@ ніхто не знає: кошти в ній рухалися, але їх ніколи не звіряли. Звірте рахунок; з нульовим залишком валюту можна прибрати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qoldig‘i noma’lum: bu valyutada pul harakati bo‘lgan, lekin qoldiq hech qachon solishtirilmagan. Hisobni solishtiring; qoldiq nol bo‘lsa, valyutani olib tashlash mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 餘額未知：此貨幣有資金往來，但從未對帳。請先為帳戶對帳，餘額為零時即可移除此貨幣。"
          }
        }
      }
    },
    "account.refusal.currencyNotEnabled": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выключана ў Наладах → Валюты."
          }
        },
        "de": {
