    "cashback.sheet.problemOn": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” üçün qayda oxunmur və ya başqa qaydanı təkrarlayır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правіла “%@” не распазнана або паўтарае іншае."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidlo pro „%@“ nelze přečíst nebo se opakuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel von „%@“ ist nicht lesbar oder wiederholt eine andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rule of “%@” can’t be read or repeats another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla de «%@» no se puede leer o repite otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle de « %@ » ne se lit pas ou répète une autre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»-ի կանոնը հնարավոր չէ կարդալ կամ այն կրկնում է մեկ այլ կանոն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola di «%@» non può essere letta o è duplicata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のルールを読み取れないか、ほかのルールと重複しています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“-ის წესი ვერ იკითხება ან იმეორებს სხვა წესს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ережесі оқылмайды немесе басқа ережені қайталайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’의 규칙을 읽을 수 없거나 다른 규칙과 중복됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» эрежесин окууга болбойт же ал башка эрежени кайталайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een regel van ‘%@’ kan niet worden gelezen of bestaat al."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać zasady „%@” lub powtarza ona inną zasadę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra de «%@» não pode ser lida ou está duplicada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra de «%@» não pode ser lida ou repete outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%@» есть правило, которое не читается или повторяется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоидаи «%@» хонда намешавад ё қоидаи дигарро такрор мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” için bir kural okunamıyor veya başka bir kuralla aynı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило «%@» не вдалося прочитати або воно повторює інше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» qoidasi o‘qilmadi yoki boshqa qoidani takrorlaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”的一条规则无法读取或与其他规则重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取「%@」的規則，或該規則與其他規則重複。"
          }
        }
      }
    },
