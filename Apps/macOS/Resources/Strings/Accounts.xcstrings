    "accounts.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona heç nə bağlı deyil. ⌘Z ilə bərpa etmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нішто на яго не спасылаецца. ⌘Z адновіць яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na něj neodkazuje. Zkratkou ⌘Z ho obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist darauf. ⌘Z holt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada hace referencia a ella. ⌘Z la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'y réfère. ⌘Z le rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն այլ տեղ չի օգտագործվում։ ⌘Z-ը կվերականգնի այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento vi fa riferimento. Premi ⌘Z per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照している項目はありません。⌘Zで元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მას არაფერი უკავშირდება. ⌘Z აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған ештеңе сілтемейді. ⌘Z қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이를 참조하는 항목이 없습니다. ⌘Z로 복원할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ага эч нерсе байланышкан эмес. ⌘Z аны калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt nergens naar verwezen. Met ⌘Z zet je dit terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się do niego nie odwołuje. ⌘Z przywróci je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada faz referência a ela. ⌘Z a restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada faz referência a este elemento. Prima ⌘Z para o recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На него ничто не ссылается. ⌘Z вернёт его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳеҷ чиз ба он ишора намекунад. ⌘Z онро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buna bağlı bir öğe yok. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо на нього не посилається. ⌘Z поверне його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Unga hech narsa bog‘lanmagan. ⌘Z uni qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有项目引用它。按 ⌘Z 可将其恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有項目參照此帳戶。按下 ⌘Z 可還原。"
          }
        }
      }
    },
    "accounts.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona heç nə bağlı deyil. “Geri al” ilə bərpa etmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нішто на яго не спасылаецца. “Адмяніць” адновіць яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na něj neodkazuje. Pomocí „Zpět“ ho obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist darauf. „Rückgängig“ holt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it. “Undo” brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada hace referencia a ella. «Deshacer» la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'y réfère. « Annuler » le rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն այլ տեղ չի օգտագործվում։ “Հետարկել”-ը կվերականգնի այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento vi fa riferimento. Tocca “Annulla” per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照している項目はありません。「取り消す」で元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მას არაფერი უკავშირდება. “გაუქმება” აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған ештеңе сілтемейді. «Болдырмау» қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이를 참조하는 항목이 없습니다. “실행 취소”로 복원할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ага эч нерсе байланышкан эмес. “Артка кайтаруу” аны калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt nergens naar verwezen. Met “Herstel” zet je dit terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się do niego nie odwołuje. „Cofnij” przywróci je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada faz referência a ela. “Desfazer” a restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada faz referência a este elemento. Use “Desfazer” para o recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На него ничто не ссылается. «Отменить» вернёт его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳеҷ чиз ба он ишора намекунад. “Бекор кардан” онро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buna bağlı bir öğe yok. “Geri Al” ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо на нього не посилається. «Скасувати» поверне його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Unga hech narsa bog‘lanmagan. “Bekor qilish” uni qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有项目引用它。点按“撤销”可将其恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有項目參照此帳戶。使用「復原」可還原。"
          }
        }
      }
    },
