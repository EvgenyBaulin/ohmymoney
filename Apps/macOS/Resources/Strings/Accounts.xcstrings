    "account.credit.refusal.fee": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gebühr ist nicht lesbar: ein Prozentsatz bis 100 und ein Betrag nicht unter null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee does not read: a percent up to 100 and an amount not below zero."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия оқылмады: пайыз — 100-ге дейін, сома — нөлден кем емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия не читается: процент до 100 и сумма не меньше нуля."
          }
        }
      }
    },
