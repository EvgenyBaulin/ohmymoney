    "account.group.inSummaryHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switched off, the money of the group stays out of «Total» and the free sum and is shown apart; its income and spending still count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, el dinero del grupo queda fuera de «Total» y de la suma libre y se muestra aparte; sus ingresos y gastos siguen contando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить, деньги группы не входят во «Всего» и в свободную сумму и показываются отдельно; её доходы и траты учитываются как раньше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнені, кошти групи не входять до «Усього» і вільної суми та показуються окремо; її доходи й витрати все одно враховуються."
          }
        }
      }
    },
