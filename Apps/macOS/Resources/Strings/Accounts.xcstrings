        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela também é a conta de pontos do cashback de %lld contas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É também a conta de pontos do cashback de %lld contas."
          }
        },
        "ru": {
