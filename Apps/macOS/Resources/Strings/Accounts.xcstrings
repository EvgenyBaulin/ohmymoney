    "account.editor.cushionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance of the account is the cushion: how many months it lasts is on «Capital»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de la cuenta es el colchón: cuántos meses dura se ve en «Capital»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde du compte est le matelas : le nombre de mois qu'il couvre se trouve dans « Capital »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток счёта — подушка: на сколько месяцев её хватит, видно в «Капитале»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок рахунку і є подушкою: на «Капіталі» видно, на скільки місяців її вистачає."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo del conto costituisce il fondo di emergenza: in «Capital» puoi vedere per quanti mesi basta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттың теңгерімі — жастық: ол неше айға жететіні «Капиталда» көрсетіледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс рахунку — падушка: на колькі месяцаў яе хопіць, паказана ў «Капітале»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo des Kontos ist das Polster: Wie viele Monate es reicht, steht unter „Kapital“."
          }
        }
      }
    },
