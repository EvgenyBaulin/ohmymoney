    "account.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations, transfers, payments and debt entries move to «%1$@», and «%2$@» goes to the archive with a zero balance; its name becomes another name of «%1$@». ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones, transferencias, pagos y apuntes de deuda pasan a «%1$@», y «%2$@» va al archivo con saldo cero; su nombre pasa a ser otro nombre de «%1$@». ⌘Z devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations, virements, paiements et dettes passent sur « %1$@ », et « %2$@ » part aux archives avec un solde nul ; son nom devient un autre nom de « %1$@ ». ⌘Z rétablit tout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции, переводы, платежи и записи долгов перейдут на «%1$@», а «%2$@» уйдёт в архив с нулевым остатком; его название станет другим названием «%1$@». ⌘Z вернёт всё как было."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції, перекази, платежі та записи боргів переходять на «%1$@», а «%2$@» іде в архів з нульовим залишком; його назва стає ще однією назвою «%1$@». ⌘Z повертає все назад."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Operazioni, trasferimenti, pagamenti e voci di debito passano a «%1$@» e «%2$@» viene archiviato con saldo zero; il suo nome diventa un altro nome di «%1$@». ⌘Z ripristina tutto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар, аударымдар, төлемдер және берешек жазбалары «%1$@» есеп-шотына көшеді, ал «%2$@» нөлдік теңгерімімен мұрағатқа өтеді; оның атауы «%1$@» басқа атына айналады. ⌘Z бәрін қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі, пераводы, плацяжы і запісы пазык пяройдуць у «%1$@», а «%2$@» — у архіў з нулявым балансам; яго назва стане іншай назвай «%1$@». ⌘Z усё верне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, Überweisungen, Zahlungen und Schuldeneinträge wandern zu „%1$@“, und „%2$@“ kommt mit Saldo null ins Archiv; sein Name wird ein weiterer Name von „%1$@“. ⌘Z holt alles zurück."
          }
        }
      }
    },
