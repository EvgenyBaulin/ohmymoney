    "bank.forgotten.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto und keine Karte stand mit Geld untätig herum"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account or card has stood idle with money on it"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақшасы бар, ұзақ бос тұрған есеп-шот немесе карта жоқ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет счетов и карт, на которых лежат деньги без движения"
          }
        }
      }
    },
    "bank.forgotten.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten und Karten, auf denen seit %1$@ Tagen oder länger nichts bewegt wurde und die Geld halten oder für die Führung berechnen könnten. Ein laufendes Festgeld gilt nicht als vergessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts and cards nothing has moved on for %1$@ days or more that hold money or may charge for service. A deposit that is still running is not forgotten."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күн және одан көп қозғалыссыз тұрған, ақшасы бар немесе қызмет үшін ақы алуы мүмкін есеп-шоттар мен карталар. Әлі жұмыс істеп тұрған салым ұмытылған саналмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета и карты без движения %1$@ дней и больше, на которых есть деньги или может быть плата за обслуживание. Вклад до конца срока не считается забытым."
          }
        }
      }
    },
