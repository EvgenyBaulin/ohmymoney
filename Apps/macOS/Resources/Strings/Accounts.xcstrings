    "group.screen.excluded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group is left out of the summary: its money is not in «Total» nor in the free sum; its income and spending still count everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo está fuera del resumen: su dinero no entra en «Total» ni en la suma libre; sus ingresos y gastos siguen contando en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe est exclu du récapitulatif : son argent n'est ni dans « Total » ni dans la somme libre ; ses revenus et dépenses comptent toujours partout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа не в общей сводке: её деньги не входят во «Всего» и в свободную сумму; доходы и траты учитываются везде."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групу вилучено з підсумку: її гроші не входять ані до «Усього», ані до вільної суми; її доходи й витрати всюди враховуються."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gruppo è escluso dal riepilogo: il suo saldo non è incluso né in «Totale» né nella somma disponibile; le sue entrate e uscite vengono comunque conteggiate ovunque."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топ қорытындыдан шығарылған: оның ақшасы «Барлығына» да, бос қаржыға да кірмейді; табысы мен шығысы әр жерде әлі есептеледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Група па-за зводкай: яе грошы не ўваходзяць ва «Усяго» ці свабодную суму; даходы і выдаткі ўлічваюцца ўсюды."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe ist aus der Übersicht herausgenommen: Ihr Geld zählt weder in „Gesamt“ noch im freien Betrag; ihre Einnahmen und Ausgaben zählen überall weiterhin."
          }
        }
      }
    },
