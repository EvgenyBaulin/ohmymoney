    "archived.leftover.leg.back": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarixində — sonrakı tarixə daxil edilmiş məbləği qarşılamaq üçün «%3$@» hesabından «%4$@» hesabına %2$@ geri köçürülür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — перавод %2$@ з «%3$@» назад у «%4$@», каб пакрыць уведзенае на будучыню."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — převod %2$@ z «%3$@» zpět na «%4$@» k pokrytí předem zadaných operací."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am %1$@ — eine Überweisung von %2$@ von „%3$@“ zurück auf „%4$@“, um das vorab Erfasste zu decken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %1$@ — a transfer of %2$@ from «%3$@» back to «%4$@», to cover what is typed ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$@ — una transferencia de %2$@ de «%3$@» a «%4$@», para cubrir lo que se introdujo por adelantado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %1$@ — un virement de %2$@ de « %3$@ » vers « %4$@ », pour couvrir ce qui est saisi d'avance."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@՝ %2$@ փոխանցում «%3$@» հաշվից հետ՝ «%4$@» հաշիվ՝ ապագա մուտքագրումները ծածկելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il %1$@ — trasferimento di %2$@ da «%3$@» a «%4$@», per coprire le operazioni future inserite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に、先の日付で入力された取引に備えて、「%3$@」から「%4$@」へ%2$@を戻します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@-ის გადარიცხვა «%3$@»-დან უკან, «%4$@»-ზე, წინასწარ შეყვანილი ოპერაციების დასაფარად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күні — %2$@ аударымы, «%3$@» → «%4$@», алдын ала енгізілгенді жабу үшін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — 미리 입력한 거래에 충당할 수 있도록 «%3$@»에서 «%4$@»(으)로 %2$@을(를) 다시 이체합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күнү — кийинчерээк киргизилген сумманы жабуу үчүн «%3$@» эсебинен «%4$@» эсебине %2$@ кайра которулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op %1$@: een overboeking van %2$@ van «%3$@» terug naar «%4$@», om de toekomstige invoer te dekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — przelew %2$@ z «%3$@» z powrotem na «%4$@», aby pokryć kwoty wpisane z wyprzedzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$@ — uma transferência de %2$@ de «%3$@» de volta para «%4$@», para cobrir os valores lançados para datas futuras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$@ — transferência de %2$@ de «%3$@» para «%4$@», para cobrir os valores introduzidos para datas futuras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — перевод %2$@ с «%3$@» обратно на «%4$@», чтобы покрыть записанное вперёд."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар %1$@ — интиқоли %2$@ аз «%3$@» ба «%4$@», барои пӯшонидани маблағҳои пешакӣ воридшуда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarihinde, ileri tarihli girişleri karşılamak için «%3$@» hesabından «%4$@» hesabına %2$@ geri aktarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — переказ %2$@ з «%3$@» назад на «%4$@», щоб покрити введене наперед."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sanasida — keyingi kiritilgan amallarni qoplash uchun «%3$@»dan «%4$@»ga %2$@ qaytariladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：从«%3$@»转回 %2$@ 至«%4$@》，以支付预先输入的交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：從 «%3$@» 轉回 %2$@ 至 «%4$@」，以支付預先輸入的款項。"
          }
        }
      }
    },
