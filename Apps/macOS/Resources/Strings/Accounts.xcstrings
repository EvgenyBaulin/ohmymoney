    "transfer.sheet.sameAmount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same amount arrives: a cut the bank takes is the fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega el mismo importe: el descuento que cobra el banco es la comisión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачисляется столько же: то, что удержал банк, — комиссия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Та сама сума приходить: відрахування, яке бере банк, — це комісія."
          }
        }
