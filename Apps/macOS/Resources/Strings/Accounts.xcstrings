    "cashback.refusal.loan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A payment on a debt earns no cashback, so there is no rule for “Loans”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pago de deuda no genera cashback, así que no hay regla para «Préstamos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paiement de dette ne rapporte aucun cashback : il n'y a donc pas de règle pour « Crédits »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За платёж по долгу кэшбэк не платят, поэтому правила для «Кредитов» нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж за боргом кешбеку не приносить, тому правила для «Кредитів» немає."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento di un debito non genera cashback, quindi non esiste una regola per “Prestiti”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек бойынша төлем кешбэк бермейді, сондықтан “Несие” үшін ереже жоқ."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацеж па пазыцы не дае кэшбэку, таму для “Пазык” няма правіла."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahlung auf eine Schuld bringt keinen Cashback, deshalb gibt es für „Kredite“ keine Regel."
          }
        }
      }
    },
    "cashback.refusal.percent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The percent is from 0 to 100, with at most four digits after the point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje va de 0 a 100, con cuatro cifras decimales como máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pourcentage va de 0 à 100, avec au plus quatre chiffres après la virgule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процент — от 0 до 100, не больше четырёх знаков после точки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсоток — від 0 до 100, не більше чотирьох знаків після коми."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale deve essere compresa tra 0 e 100, con un massimo di quattro cifre decimali."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз 0-ден 100-ге дейін, үтірден кейін ең көбі төрт таңба."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнт ад 0 да 100, не больш за чатыры знакі пасля кропкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozentsatz liegt zwischen 0 und 100, mit höchstens vier Nachkommastellen."
          }
        }
      }
    },
    "cashback.refusal.pointsArchived": {
      "extractionState": "manual",
      "localizations": {
