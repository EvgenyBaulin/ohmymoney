    "account.balance.creditHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a credit card, type what you owe the bank with a minus: −30,000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para una tarjeta de crédito, escriba con signo menos lo que debe al banco: −30.000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une carte de crédit, saisissez ce que vous devez à la banque avec un moins : −30 000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кредитной карты впишите долг банку со знаком минус: −30,000."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кредитної картки введіть, скільки ви винні банку, з мінусом: −30 000."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per una carta di credito, inserisci l’importo dovuto alla banca con un meno: −30,000."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік картада банкке берешегіңізді минуспен теріңіз: −30,000."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для крэдытнай карты ўвядзіце доўг банку са знакам мінус: −30 000."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine Kreditkarte tippen Sie den Betrag, den Sie der Bank schulden, mit einem Minus: −30.000."
          }
        }
      }
    },
    "account.credit.available": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available %1$@ of %2$@"
          }
        },
