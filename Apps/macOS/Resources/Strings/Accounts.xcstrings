    "account.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyatlar, köçürmələr, ödənişlər və borc qeydləri «%1$@» hesabına köçürüləcək, «%2$@» isə sıfır balansla arxivə göndəriləcək; onun adı «%1$@» hesabının digər adı olacaq. ⌘Z hər şeyi geri qaytarır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі, пераводы, плацяжы і запісы пазык пяройдуць у «%1$@», а «%2$@» — у архіў з нулявым балансам; яго назва стане іншай назвай «%1$@». ⌘Z усё верне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace, převody, platby a záznamy dluhů se přesunou na «%1$@» a «%2$@» se přesune do archivu s nulovým zůstatkem; jeho název se stane dalším názvem účtu «%1$@». Stisknutím ⌘Z vše vrátíte zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, Überweisungen, Zahlungen und Schuldeneinträge wandern zu „%1$@“, und „%2$@“ kommt mit Saldo null ins Archiv; sein Name wird ein weiterer Name von „%1$@“. ⌘Z holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations, transfers, payments and debt entries move to «%1$@», and «%2$@» goes to the archive with a zero balance; its name becomes another name of «%1$@». ⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones, transferencias, pagos y apuntes de deuda pasan a «%1$@», y «%2$@» va al archivo con saldo cero; su nombre pasa a ser otro nombre de «%1$@». ⌘Z devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations, virements, paiements et dettes passent sur « %1$@ », et « %2$@ » part aux archives avec un solde nul ; son nom devient un autre nom de « %1$@ ». ⌘Z rétablit tout."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարքները, փոխանցումները, վճարումները և պարտքի գրառումները կտեղափոխվեն «%1$@», իսկ «%2$@» կտեղափոխվի արխիվ՝ զրոյական մնացորդով․ դրա անունը կդառնա «%1$@» հաշվի այլընտրանքային անուն։ ⌘Z-ը կվերադարձնի ամեն ինչ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Operazioni, trasferimenti, pagamenti e voci di debito passano a «%1$@» e «%2$@» viene archiviato con saldo zero; il suo nome diventa un altro nome di «%1$@». ⌘Z ripristina tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引、振替、支払い、債務の記録は«%1$@»に移動し、«%2$@»は残高ゼロでアーカイブされます。その名前は«%1$@»の別名になります。⌘Zですべて元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაციები, გადარიცხვები, გადახდები და ვალის ჩანაწერები გადავა ანგარიშზე «%1$@», ხოლო «%2$@» ნულოვანი ნაშთით დაარქივდება; მისი სახელი «%1$@» ანგარიშის დამატებითი სახელი გახდება. ⌘Z ყველაფერს აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар, аударымдар, төлемдер және берешек жазбалары «%1$@» есеп-шотына көшеді, ал «%2$@» нөлдік теңгерімімен мұрағатқа өтеді; оның атауы «%1$@» басқа атына айналады. ⌘Z бәрін қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래, 이체, 결제 및 부채 항목이 «%1$@»(으)로 이동하고 «%2$@»은(는) 잔액이 0인 상태로 보관함에 이동합니다. 해당 이름은 «%1$@»의 다른 이름이 됩니다. ⌘Z를 누르면 모두 되돌릴 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар, которуулар, төлөмдөр жана карыз жазуулары «%1$@» эсебине өтөт, ал эми «%2$@» нөл калдык менен архивге жылдырылат; анын аталышы «%1$@» эсебинин кошумча аталышы болот. ⌘Z баарын калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boekingen, overboekingen, betalingen en schuldboekingen gaan naar «%1$@» en «%2$@» gaat met een nulsaldo naar het archief; de naam wordt een andere naam van «%1$@». Met ⌘Z maak je alles ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje, przelewy, płatności i wpisy dotyczące długów zostaną przeniesione do «%1$@», a «%2$@» trafi do archiwum z zerowym saldem. Jego nazwa stanie się drugą nazwą «%1$@». Naciśnij ⌘Z, aby cofnąć zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Operações, transferências, pagamentos e lançamentos de dívidas passam para «%1$@», e «%2$@» é arquivada com saldo zero; seu nome passa a ser outro nome de «%1$@». Use ⌘Z para desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações, transferências, pagamentos e registos de dívida passam para «%1$@», e «%2$@» vai para o arquivo com saldo zero; o seu nome passa a ser outro nome de «%1$@». ⌘Z repõe tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции, переводы, платежи и записи долгов перейдут на «%1$@», а «%2$@» уйдёт в архив с нулевым остатком; его название станет другим названием «%1$@». ⌘Z вернёт всё как было."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёт, интиқолҳо, пардохтҳо ва сабтҳои қарз ба «%1$@» мегузаранд ва «%2$@» бо бақияи сифр ба бойгонӣ меравад; номи он номи дигари «%1$@» мешавад. ⌘Z ҳама чизро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler, transferler, ödemeler ve borç kayıtları «%1$@» hesabına taşınır; «%2$@» sıfır bakiyeyle arşive kaldırılır ve adı «%1$@» hesabının diğer adı olur. ⌘Z ile tümü geri alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції, перекази, платежі та записи боргів переходять на «%1$@», а «%2$@» іде в архів з нульовим залишком; його назва стає ще однією назвою «%1$@». ⌘Z повертає все назад."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaliyotlar, o‘tkazmalar, to‘lovlar va qarz yozuvlari «%1$@» hisobiga o‘tadi, «%2$@» esa nol qoldiq bilan arxivga o‘tkaziladi; uning nomi «%1$@» hisobining boshqa nomiga aylanadi. ⌘Z hammasini tiklaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收支、转账、付款和债务记录将移至 «%1$@»，«%2$@» 将以零余额归档；其名称将成为 «%1$@» 的别名。按 ⌘Z 可撤销所有更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易、轉帳、付款和債務記錄將移至 «%1$@»，而 «%2$@» 將以零餘額封存；其名稱將成為 «%1$@» 的別名。按 ⌘Z 可還原所有變更。"
          }
        }
      }
    },
    "account.merge.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyatlar, köçürmələr, ödənişlər və borc qeydləri «%1$@» hesabına köçürüləcək, «%2$@» isə sıfır balansla arxivə göndəriləcək; onun adı «%1$@» hesabının digər adı olacaq. “Geri al” hər şeyi geri qaytarır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі, пераводы, плацяжы і запісы пазык пяройдуць у «%1$@», а «%2$@» — у архіў з нулявым балансам; яго назва стане іншай назвай «%1$@». “Адмяніць” усё верне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace, převody, platby a záznamy dluhů se přesunou na «%1$@» a «%2$@» se přesune do archivu s nulovým zůstatkem; jeho název se stane dalším názvem účtu «%1$@». Volbou “Zpět” vše vrátíte zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, Überweisungen, Zahlungen und Schuldeneinträge wandern zu „%1$@“, und „%2$@“ kommt mit Saldo null ins Archiv; sein Name wird ein weiterer Name von „%1$@“. „Rückgängig“ holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations, transfers, payments and debt entries move to «%1$@», and «%2$@» goes to the archive with a zero balance; its name becomes another name of «%1$@». “Undo” brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones, transferencias, pagos y apuntes de deuda pasan a «%1$@», y «%2$@» va al archivo con saldo cero; su nombre pasa a ser otro nombre de «%1$@». «Deshacer» devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations, virements, paiements et dettes passent sur « %1$@ », et « %2$@ » part aux archives avec un solde nul ; son nom devient un autre nom de « %1$@ ». « Annuler » rétablit tout."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարքները, փոխանցումները, վճարումները և պարտքի գրառումները կտեղափոխվեն «%1$@», իսկ «%2$@» կտեղափոխվի արխիվ՝ զրոյական մնացորդով․ դրա անունը կդառնա «%1$@» հաշվի այլընտրանքային անուն։ “Հետարկել”-ը կվերադարձնի ամեն ինչ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Operazioni, trasferimenti, pagamenti e voci di debito passano a «%1$@» e «%2$@» viene archiviato con saldo zero; il suo nome diventa un altro nome di «%1$@». “Annulla” ripristina tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引、振替、支払い、債務の記録は«%1$@»に移動し、«%2$@»は残高ゼロでアーカイブされます。その名前は«%1$@»の別名になります。“元に戻す”ですべて元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაციები, გადარიცხვები, გადახდები და ვალის ჩანაწერები გადავა ანგარიშზე «%1$@», ხოლო «%2$@» ნულოვანი ნაშთით დაარქივდება; მისი სახელი «%1$@» ანგარიშის დამატებითი სახელი გახდება. “გაუქმება” ყველაფერს აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар, аударымдар, төлемдер және берешек жазбалары «%1$@» есеп-шотына көшеді, ал «%2$@» нөлдік теңгерімімен мұрағатқа өтеді; оның атауы «%1$@» басқа атына айналады. «Болдырмау» бәрін қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래, 이체, 결제 및 부채 항목이 «%1$@»(으)로 이동하고 «%2$@»은(는) 잔액이 0인 상태로 보관함에 이동합니다. 해당 이름은 «%1$@»의 다른 이름이 됩니다. “실행 취소”를 누르면 모두 되돌릴 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар, которуулар, төлөмдөр жана карыз жазуулары «%1$@» эсебине өтөт, ал эми «%2$@» нөл калдык менен архивге жылдырылат; анын аталышы «%1$@» эсебинин кошумча аталышы болот. “Артка кайтаруу” баарын калыбына келтирет."
          }
        },
        "nl": {
