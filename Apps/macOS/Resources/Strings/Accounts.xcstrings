    "cashback.sheet.expectationHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözlənilən keşbek gəlir deyil, yalnız proqnozdur. Aldığınız məbləği keşbek kateqoriyasında gəlir kimi qeyd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканы кэшбэк — толькі чаканне, а не даход. Запішыце атрыманае як даход у катэгорыі кэшбэку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Očekávaný cashback je pouze odhad, nikoli příjem. Přijatou částku zaznamenejte jako příjem v kategorii cashbacku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erwartete Cashback ist nur eine Erwartung, nie Einnahme. Erfassen Sie, was Sie erhalten, als Einnahme in der Kategorie Cashback."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected cashback is only an expectation, never income. Record what you receive as income in the cashback category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cashback previsto es solo una expectativa, nunca un ingreso. Registre lo que reciba como ingreso en la categoría de cashback."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback attendu n'est qu'une attente, jamais un revenu. Notez ce que vous recevez comme revenu dans la catégorie cashback."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասվող քեշբեքը միայն կանխատեսում է, ոչ թե եկամուտ։ Ստացված գումարը գրանցեք որպես եկամուտ՝ քեշբեքի կատեգորիայում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cashback previsto è solo una stima, mai un'entrata. Registra ciò che ricevi come entrata nella categoria cashback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュバック予定額は見込みであり、収入には含まれません。受け取った金額はキャッシュバックカテゴリの収入として記録してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოსალოდნელი ქეშბექი მხოლოდ ვარაუდია და არა შემოსავალი. მიღებული თანხა ქეშბექის კატეგორიაში შემოსავლად ჩაწერეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтілетін кешбэк — тек күту, табыс емес. Алғанды кешбэк санатында табыс ретінде жазыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 캐시백은 수입으로 계산되지 않습니다. 실제로 받은 금액을 캐시백 카테고리에 수입으로 기록하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтүлгөн кэшбэк — божомол гана, киреше эмес. Алынган сумманы кэшбэк категориясына киреше катары жазыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwachte cashback is alleen een verwachting, geen inkomen. Registreer ontvangen cashback als inkomen in de categorie Cashback."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwany cashback jest tylko prognozą, a nie przychodem. Otrzymaną kwotę zapisz jako przychód w kategorii cashbacku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback previsto é apenas uma estimativa, nunca uma receita. Registre o valor recebido como receita na categoria de cashback."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback previsto é apenas uma previsão, nunca um rendimento. Registe o valor recebido como rendimento na categoria de cashback."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемый кэшбэк — только ожидание, не доход. Полученный записывайте доходом в категории кэшбэка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешбэки пешбинишуда даромад нест. Маблағи гирифташударо ҳамчун даромад дар категорияи кешбэк сабт кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenen para iadesi gelir değildir. Aldığınız tutarı para iadesi kategorisine gelir olarak kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний кешбек — це лише очікування, а не дохід. Записуйте те, що ви отримали, як дохід у категорії кешбеку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutilayotgan keshbek daromad emas. Olingan keshbekni keshbek toifasida daromad sifatida qayd eting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计返现仅供参考，不计为收入。收到返现后，请在返现类别中记为收入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預計回饋僅供參考，不計為收入。請將實際收到的回饋記為現金回饋類別的收入。"
          }
        }
      }
    },
    "cashback.sheet.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay qaydası “həmişə” qaydasından, alt kateqoriya isə kateqoriyadan üstündür; “Qalan hər şey” digər qaydalar uyğun gəlmədikdə tətbiq edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правіла месяца мае перавагу над “заўсёды”, а падкатэгорыя — над катэгорыяй; “Усё астатняе” дзейнічае, калі іншае не падыходзіць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidlo pro měsíc má přednost před pravidlem „vždy“ a podkategorie před kategorií. „Vše ostatní“ platí, když se neuplatní žádné jiné pravidlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel für einen Monat schlägt eine Regel „immer“, und eine Unterkategorie schlägt ihre Kategorie; „Alles Übrige“ gilt, wenn nichts anderes zutrifft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A month rule beats an “always” rule, and a subcategory beats its category; “Everything else” applies when nothing else does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla de mes gana a una regla «siempre», y una subcategoría gana a su categoría; «Todo lo demás» se aplica cuando nada más se aplica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle de mois l'emporte sur une règle « toujours », et une sous-catégorie sur sa catégorie ; « Tout le reste » s'applique quand rien d'autre ne s'applique."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա կանոնը գերակայում է «միշտ» կանոնին, իսկ ենթակատեգորիայի կանոնը՝ կատեգորիայի կանոնին։ «Մնացածը» կիրառվում է, երբ այլ կանոն չի գործում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola mensile prevale su una regola «Sempre» e una sottocategoria prevale sulla sua categoria; «Tutto il resto» si applica quando non valgono altre regole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月別のルールは「常に」のルールより優先され、サブカテゴリはカテゴリより優先されます。ほかに該当しない場合は「その他」が適用されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვის წესს უპირატესობა აქვს მუდმივ წესთან, ხოლო ქვეკატეგორიის წესს — კატეგორიის წესთან; „ყველაფერი დანარჩენი“ მოქმედებს, როცა სხვა წესი არ ვრცელდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай ережесі “әрқашан” ережесінен басым, ал ішкі санат — өз санатынан; “Қалғанның бәрі” басқа ешбір ереже болмаған жағдайда қолданылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월별 규칙은 ‘항상’ 규칙보다 우선하고, 하위 카테고리는 상위 카테고리보다 우선합니다. 다른 규칙이 없으면 ‘기타 모두’가 적용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдын эрежеси «ар дайым» эрежесинен, ал эми ички категориянын эрежеси категорияныкынан артык. Башка эреже жок болсо, «Калганынын баары» колдонулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een maandregel gaat boven een regel voor ‘altijd’ en een subcategorie boven de categorie. ‘Al het overige’ geldt als geen andere regel van toepassing is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasada dla miesiąca ma pierwszeństwo przed zasadą „zawsze”, a podkategoria przed kategorią. „Wszystko inne” obowiązuje, gdy żadna inna zasada nie pasuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra mensal prevalece sobre uma regra «sempre», e uma subcategoria prevalece sobre sua categoria; «Todo o resto» se aplica quando nenhuma outra regra se aplica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra mensal prevalece sobre uma regra «sempre» e uma subcategoria prevalece sobre a sua categoria; «Tudo o resto» aplica-se quando não há outra regra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило месяца важнее правила «всегда», подкатегория — важнее категории; «Всё остальное» — когда ничего не подошло."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоидаи моҳона аз қоидаи «ҳамеша» ва зеркатегория аз категорияи худ бартарӣ дорад. «Ҳамаи дигар» вақте амал мекунад, ки ягон қоидаи дигар мувофиқ набошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık kural, “her zaman” kuralından; alt kategori de kategorisinden önceliklidir. Başka bir kural geçerli değilse “Diğer her şey” uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило на місяць важить більше за правило «завжди», а підкатегорія — більше за категорію; «Усе інше» діє, коли нічого іншого немає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oy qoidasi «har doim» qoidasidan, kichik toifa qoidasi esa toifa qoidasidan ustun. Boshqa qoida mos kelmasa, «Qolgan hammasi» qo‘llanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月份规则优先于“始终”规则，子类别规则优先于类别规则；没有其他适用规则时使用“其他所有”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "月份規則優先於「一律」規則，子類別規則優先於其類別規則；沒有其他適用規則時使用「其他所有項目」。"
          }
        }
      }
    },
