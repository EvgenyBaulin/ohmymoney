            "value": "Бо бонки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirilecek banka"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З банком"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank bilan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并到银行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併至銀行"
          }
        }
      }
    },
    "bank.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” bankının bütün hesabları, o cümlədən arxivdəkilər “%2$@” bankına köçürülür və “%1$@” silinir. “%2$@” öz adını saxlayır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе рахункі “%1$@”, у тым ліку архіўныя, пяройдуць у “%2$@”, а “%1$@” будзе выдалены. “%2$@” захавае назву."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny účty banky „%1$@“ včetně archivovaných se přesunou pod banku „%2$@“ a banka „%1$@“ se smaže. Bance „%2$@“ zůstane její název."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Konto von „%1$@“, auch archivierte, wandert unter „%2$@“, und „%1$@“ wird gelöscht. „%2$@“ behält seinen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every account of “%1$@”, archived ones too, moves under “%2$@”, and “%1$@” is deleted. “%2$@” keeps its name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cuenta de «%1$@», también las archivadas, pasa a estar bajo «%2$@», y «%1$@» se elimina. «%2$@» conserva su nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque compte de « %1$@ », y compris les archivés, passe sous « %2$@ », et « %1$@ » est supprimée. « %2$@ » garde son nom."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”-ի բոլոր հաշիվները, այդ թվում՝ արխիվացվածները, կտեղափոխվեն “%2$@”, իսկ “%1$@”-ը կջնջվի։ “%2$@”-ը կպահպանի իր անունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i conti di “%1$@”, inclusi quelli archiviati, vengono spostati in “%2$@” e “%1$@” viene eliminata. “%2$@” mantiene il proprio nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”のすべての口座がアーカイブ済みの口座も含めて“%2$@”に移動し、“%1$@”は削除されます。“%2$@”の名前は変わりません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“-ის ყველა ანგარიში, მათ შორის არქივში არსებული, გადავა „%2$@“-ში, ხოლო „%1$@“ წაიშლება. „%2$@“ თავის სახელს შეინარჩუნებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” банкінің барлық есеп-шоты, мұрағаттағылары да, “%2$@” астына көшеді, ал “%1$@” жойылады. “%2$@” өз атын сақтайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”의 보관된 계좌를 포함한 모든 계좌가 “%2$@”(으)로 이동하고 “%1$@”은(는) 삭제됩니다. “%2$@”의 이름은 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” банкынын бардык эсептери, анын ичинде архивдегилери да, “%2$@” банкына өтөт жана “%1$@” өчүрүлөт. “%2$@” өз атын сактайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle rekeningen van “%1$@”, ook de gearchiveerde, worden ondergebracht bij “%2$@” en “%1$@” wordt verwijderd. “%2$@” behoudt zijn naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie konta banku „%1$@”, także te w archiwum, zostaną przeniesione do banku „%2$@”, a bank „%1$@” zostanie usunięty. Bank „%2$@” zachowa swoją nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as contas de “%1$@”, inclusive as arquivadas, serão movidas para “%2$@”, e “%1$@” será apagado. “%2$@” manterá seu nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as contas de “%1$@”, incluindo as arquivadas, passam para “%2$@” e “%1$@” é apagado. “%2$@” mantém o nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все счета банка «%1$@», и архивные тоже, перейдут в банк «%2$@», а банк «%1$@» будет удалён. Название «%2$@» останется прежним."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳамаи суратҳисобҳои «%1$@», аз ҷумла бойгонишудаҳо, ба «%2$@» мегузаранд ва «%1$@» нест карда мешавад. Номи «%2$@» боқӣ мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” bankasının arşivdekiler dahil tüm hesapları “%2$@” bankasına taşınır ve “%1$@” silinir. “%2$@” adını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рахунок «%1$@», в тому числі архівні, переходить під «%2$@», а «%1$@» видаляється. «%2$@» зберігає свою назву."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”ning barcha hisoblari, jumladan arxivdagilari ham “%2$@”ga o‘tkaziladi va “%1$@” o‘chiriladi. “%2$@” o‘z nomini saqlab qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”的所有账户（包括已归档账户）都将移至“%2$@”，然后删除“%1$@”。“%2$@”保留其名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」的所有帳戶（包括已封存的帳戶）都會移至「%2$@」，然後刪除「%1$@」。「%2$@」會保留原有名稱。"
          }
        }
      }
    },
    "bank.merge.money": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vəsait köçürülmür və hər hesab öz adını və balansını saxlayır. Sonra eyni bankın hesablarını birləşdirmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы не перамяшчаюцца, кожны рахунак захавае назву і баланс. Затым можна аб'яднаць рахункі аднаго банка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné peníze se nepřesunou a všem účtům zůstanou jejich názvy i zůstatky. Účty jedné banky pak lze sloučit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Geld wird bewegt, und jedes Konto behält seinen Namen und seinen Saldo. Konten einer Bank lassen sich danach untereinander zusammenführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No money moves and every account keeps its name and its balance. Accounts of one bank can then be merged with each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se mueve dinero y cada cuenta conserva su nombre y su saldo. Después se pueden fusionar entre sí las cuentas de un mismo banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun argent ne bouge et chaque compte garde son nom et son solde. Les comptes d'une même banque peuvent ensuite être fusionnés entre eux."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը չի տեղափոխվի, և յուրաքանչյուր հաշիվ կպահպանի իր անունն ու մնացորդը։ Այնուհետև նույն բանկի հաշիվները կարելի է միավորել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun denaro viene spostato e ogni conto mantiene il proprio nome e saldo. I conti della stessa banca possono poi essere uniti tra loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お金の移動はなく、各口座の名前と残高は変わりません。統合後、同じ銀行の口座同士を統合できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა არ გადაირიცხება და ყველა ანგარიში შეინარჩუნებს სახელსა და ნაშთს. შემდეგ ერთი ბანკის ანგარიშების ერთმანეთთან გაერთიანებაც შესაძლებელი იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша қозғалмайды, әр есеп-шот өз атын және теңгерімін сақтайды. Осыдан кейін бір банктің есеп-шоттарын өзара біріктіруге болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돈은 이동하지 않으며 모든 계좌의 이름과 잔액이 유지됩니다. 이후 같은 은행의 계좌끼리 병합할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча которулбайт, ар бир эсеп өз атын жана калдыгын сактайт. Андан кийин бир банктын эсептерин өз ара бириктирсе болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt geen geld overgeboekt en elke rekening behoudt haar naam en saldo. Rekeningen van dezelfde bank kunnen daarna worden samengevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne środki nie zostaną przeniesione, a każde konto zachowa swoją nazwę i saldo. Konta jednego banku można następnie połączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dinheiro será movido, e cada conta manterá seu nome e saldo. Depois, as contas de um mesmo banco poderão ser mescladas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dinheiro é transferido e cada conta mantém o nome e o saldo. Depois, pode unir contas do mesmo banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги никуда не переходят, у каждого счёта остаются его название и остаток. После этого счета одного банка можно объединять между собой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағ интиқол намеёбад ва ҳар суратҳисоб ном ва бақияи худро нигоҳ медорад. Сипас суратҳисобҳои як бонкро бо ҳам муттаҳид кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para aktarılmaz; her hesap adını ve bakiyesini korur. Aynı bankanın hesapları daha sonra birbiriyle birleştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші не рухаються, і кожен рахунок зберігає свою назву та залишок. Рахунки одного банку потім можна зливати між собою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul ko‘chirilmaydi, har bir hisob o‘z nomi va balansini saqlaydi. Keyin bir bankning hisoblarini o‘zaro birlashtirish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资金不会转移，各账户保留原有名称和余额。之后可以合并同一银行的账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資金不會移動，所有帳戶都會保留原有名稱和餘額。之後可合併同一銀行的帳戶。"
          }
        }
      }
    },
    "bank.merge.noAccounts": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankın hesabı yoxdur: yalnız bank silinir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка няма рахункаў: ён толькі выдаляецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka nemá žádné účty, pouze se smaže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat keine Konten: Sie wird nur gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank has no accounts: it is only deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco no tiene cuentas: solo se elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque n'a aucun compte : elle est seulement supprimée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկը հաշիվներ չունի և պարզապես կջնջվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca non ha conti: viene solo eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この銀行に口座はありません。銀行のみが削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკს ანგარიშები არ აქვს: ის უბრალოდ წაიშლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкте есеп-шот жоқ: ол тек жойылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌가 없는 은행은 삭제만 됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын эсептери жок: ал жөн гана өчүрүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bank heeft geen rekeningen en wordt alleen verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank nie ma kont i zostanie usunięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco não tem contas e será apenas apagado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco não tem contas: será apenas apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В банке нет счетов: он будет просто удалён."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк суратҳисоб надорад: танҳо нест карда мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankanın hesabı yok; yalnızca banka silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У банку немає рахунків: його лише видаляють."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankda hisoblar yo‘q: u faqat o‘chiriladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此银行没有账户，将直接删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此銀行沒有帳戶，只會將其刪除。"
          }
        }
      }
    },
    "bank.merge.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdəki bank birləşdirilmir: əvvəlcə onu arxivdən çıxarın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк у архіве нельга аб'яднаць: спачатку аднавіце яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivovanou banku nelze sloučit. Nejprve ji obnovte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank im Archiv wird nicht zusammengeführt: Holen Sie sie zuerst zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank in the archive is not merged: bring it back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banco del archivo no se fusiona: recupérelo antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une banque aux archives ne se fusionne pas : ramenez-la d'abord."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվացված բանկը հնարավոր չէ միավորել. նախ վերականգնեք այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una banca archiviata non può essere unita: prima ripristinala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済みの銀行は統合できません。先にアーカイブから戻してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივში არსებული ბანკის გაერთიანება შეუძლებელია: ჯერ დააბრუნეთ ის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы банк біріктірілмейді: алдымен оны қайтарыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 은행은 병합할 수 없습니다. 먼저 복원하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивдеги банк бириктирилбейт: адегенде аны архивден чыгарыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gearchiveerde bank kan niet worden samengevoegd. Haal deze eerst uit het archief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć banku w archiwum. Najpierw go przywróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um banco arquivado não pode ser mesclado: restaure-o primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível unir um banco arquivado: retire-o primeiro do arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк в архиве не объединяется: сначала верните его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонки бойгонишударо муттаҳид кардан мумкин нест: аввал онро баргардонед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivdeki bir banka birleştirilemez; önce arşivden çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк в архіві не зливається: спершу поверніть його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdagi bankni birlashtirib bo‘lmaydi: avval uni qaytaring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法合并已归档的银行，请先恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法合併已封存的銀行，請先將其還原。"
          }
        }
      }
    },
