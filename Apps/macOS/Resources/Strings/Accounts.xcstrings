    "transfer.fee.fromArchive": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камісія трапіць у «%@», што адновіцца з архіва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gebühr geht auf „%@“, das aus dem Archiv zurückkommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee goes to «%@», which comes back from the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión va a «%@», que vuelve del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais vont sur « %@ », qui revient des archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La commissione viene assegnata a «%@», che viene ripristinato dall'archivio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия мұрағаттан қайтатын «%@» есеп-шотына түседі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия «%@» категориясына жазылат, ал архивден кайтарылат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłata trafi do «%@», która zostanie przywrócona z archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarifa vai para «%@», que será restaurada do arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия пойдёт в «%@» — она вернётся из архива."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücret, arşivden geri getirilecek «%@» kategorisine kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія йде на «%@», який повертається з архіву."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya «%@»ga yoziladi va u arxivdan qaytariladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手續費會記入「%@」，該類別將從封存中恢復。"
          }
        }
      }
    },
    "transfer.fee.fromArchiveWithParent": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камісія трапіць у «%1$@», што адновіцца з архіва разам з «%2$@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gebühr geht auf „%1$@“, das zusammen mit „%2$@“ aus dem Archiv zurückkommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee goes to «%1$@», which comes back from the archive with «%2$@»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión va a «%1$@», que vuelve del archivo junto con «%2$@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais vont sur « %1$@ », qui revient des archives avec « %2$@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La commissione viene assegnata a «%1$@», che viene ripristinato dall'archivio insieme a «%2$@»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия «%2$@» есеп-шотымен бірге мұрағаттан қайтатын «%1$@» есеп-шотына түседі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия «%1$@» категориясына жазылат, ал «%2$@» менен бирге архивден кайтарылат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłata trafi do «%1$@», która zostanie przywrócona z archiwum wraz z «%2$@»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarifa vai para «%1$@», que será restaurada do arquivo junto com «%2$@»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия пойдёт в «%1$@» — она вернётся из архива вместе с «%2$@»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücret, «%2$@» ile birlikte arşivden geri getirilecek «%1$@» kategorisine kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія йде на «%1$@», який повертається з архіву разом із «%2$@»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya «%1$@»ga yoziladi va u «%2$@» bilan birga arxivdan qaytariladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手續費會記入「%1$@」，該類別將與「%2$@」一併從封存中恢復。"
          }
        }
      }
    },
    "transfer.refusal.amountsDiffer": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У адной валюце паступае столькі ж, колькі спісваецца; утрыманае банкам запішыце як камісію."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Währung kommt derselbe Betrag an, der abgeht; tragen Sie als Gebühr ein, was die Bank einbehalten hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one currency the same amount arrives as leaves; write what the bank kept as the fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una misma divisa, llega el mismo importe que sale; escriba lo que se quedó el banco como comisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans une même devise, le même montant arrive tel qu'il part ; notez ce que la banque a retenu comme frais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella stessa valuta, l'importo ricevuto deve essere uguale a quello inviato; inserisci ciò che la banca ha trattenuto come commissione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір валютада бірдей сома келеді де кетеді; банк ұстап қалғанын комиссия ретінде жазыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир валютада жөнөтүлгөн жана алынган сумма бирдей болот; банк кармап калган сумманы комиссия катары жазыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej samej walucie kwota wychodząca i przychodząca musi być taka sama. Kwotę pobraną przez bank wpisz jako opłatę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na mesma moeda, o valor recebido deve ser igual ao enviado; informe como tarifa o valor retido pelo banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В одной валюте зачисляется столько же, сколько списано; то, что удержал банк, запишите комиссией."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı para biriminde gönderilen ve alınan tutar eşittir; bankanın kestiği tutarı ücret olarak girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В одній валюті на іншу сторону приходить та сама сума; запишіть, що банк утримав, як комісію."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir xil valyutada yuborilgan va olingan summa teng bo‘ladi; bank ushlab qolgan summani komissiya sifatida kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同貨幣的轉入和轉出金額必須一致；請將銀行扣除的金額記為手續費。"
          }
        }
      }
    },
    "transfer.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак у архіве: аднавіце яго для пераводаў з яго ці на яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto ist im Archiv: Holen Sie es zurück, um darauf oder davon zu überweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in the archive: bring it back to transfer to or from it."
          }
        },
        "es": {
          "stringUnit": {
