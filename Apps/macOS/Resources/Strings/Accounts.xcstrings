    "account.editor.bank.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesab bu banka aiddir; seçim siyahılarında bankın adı göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак знаходзіцца ў гэтым банку; у спісах выбару пазначаны яго назвай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet patří k této bance. Ve výběrech ho označuje název banky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto steht unter dieser Bank; in Auswahllisten nennt die Bank es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account stands under this bank; in lists of choices the bank names it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta figura bajo este banco; en las listas de opciones aparece el nombre del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte est rattaché à cette banque ; dans les listes de choix, c'est elle qui le nomme."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշիվը պատկանում է այս բանկին․ ընտրության ցանկերում ցուցադրվում է բանկի անունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto è associato a questa banca; negli elenchi di scelta è indicato con il nome della banca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座の所属する銀行です。選択リストには銀行名が表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიში ამ ბანკს ეკუთვნის; სიებში ის ბანკის სახელით ჩანს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот осы банк астында тұрады; таңдау тізімдерінде банк оның атауын береді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계좌가 속한 은행입니다. 선택 목록에는 은행 이름이 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсеп ушул банкка таандык; тандоо тизмелеринде банктын аты көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rekening hoort bij deze bank; in keuzelijsten wordt de banknaam gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto należy do tego banku; na listach wyboru jest wyświetlane pod jego nazwą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta pertence a este banco; nas listas, ela aparece com o nome do banco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta pertence a este banco; nas listas, é identificada pelo nome do banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт стоит под этим банком; в списках выбора его называет банк."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоб ба ин бонк тааллуқ дорад; дар рӯйхати интихобҳо номи бонк нишон дода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap bu bankaya bağlıdır; seçim listelerinde banka adı gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок належить цьому банку; у списках вибору його називає банк."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob shu bankka tegishli; tanlash ro‘yxatlarida bank nomi ko‘rsatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户归属此银行；选择列表中显示银行名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶隸屬於這家銀行；選擇帳戶時會顯示銀行名稱。"
          }
        }
      }
    },
