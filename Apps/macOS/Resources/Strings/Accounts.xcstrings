    "account.credit.refusal.fee": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya yanlışdır: faiz 100-ə qədər, məbləğ isə sıfırdan az olmamalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Незразумелая камісія: працэнт да 100 і сума не меншая за нуль."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neplatný poplatek. Zadejte procento nejvýše 100 a nezápornou částku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gebühr ist nicht lesbar: ein Prozentsatz bis 100 und ein Betrag nicht unter null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee does not read: a percent up to 100 and an amount not below zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión no es válida: un porcentaje de hasta 100 y una cantidad no menor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais ne sont pas lisibles : un pourcentage jusqu'à 100 et un montant non négatif."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվավեր միջնորդավճար․ տոկոսը պետք է լինի մինչև 100, իսկ գումարը՝ զրոյից ոչ պակաս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Commissione non valida: inserisci una percentuale fino a 100 e un importo non inferiore a zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手数料が正しくありません。割合は100%以下、金額は0以上で入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკომისიო არასწორია: პროცენტი უნდა იყოს 100-მდე, თანხა კი — არანაკლებ ნულისა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия оқылмады: пайыз — 100-ге дейін, сома — нөлден кем емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수수료를 확인하세요. 비율은 100 이하여야 하며 금액은 0 이상이어야 합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссияны текшериңиз: пайыз 100дөн ашпашы, сумма нөлдөн кем болбошу керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kosten zijn ongeldig: vul een percentage tot en met 100 en een bedrag van minimaal nul in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowa opłata. Procent nie może przekraczać 100, a kwota nie może być ujemna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarifa inválida: use uma porcentagem de até 100 e um valor igual ou maior que zero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Comissão inválida: introduza uma percentagem até 100 e um valor igual ou superior a zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия не читается: процент до 100 и сумма не меньше нуля."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия нодуруст аст: фоиз то 100 ва маблағ на камтар аз сифр бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücret okunamıyor: Yüzde 100'ü aşmamalı ve tutar sıfırdan küçük olmamalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісію не вдалося прочитати: відсоток до 100 і сума не менше нуля."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya noto‘g‘ri: foiz 100 dan oshmasligi, summa esa noldan kam bo‘lmasligi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手续费格式有误：百分比不能超过 100，金额不能小于零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手續費無效：百分比不得超過 100，金額不得低於零。"
          }
        }
      }
    },
    "account.credit.refusal.inTheBin": {
      "extractionState": "manual",
      "localizations": {
        "az": {
