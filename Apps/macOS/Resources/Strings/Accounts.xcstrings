    "account.credit.feeFixed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus eine feste Gebühr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus a fixed fee"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тұрақты комиссиямен қоса"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плюс фиксированная сумма"
          }
        }
      }
    },
    "account.credit.feePercent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebühr für Bargeld und Überweisungen, %"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fee for cash and transfers, %"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолма-қол ақша мен аударым үшін комиссия, %"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия за снятие и переводы, %"
          }
        }
      }
    },
    "account.credit.firstCard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartenname"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card name"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта атауы"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название карты"
          }
        }
      }
    },
    "account.credit.firstCardHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte wird zusammen mit ihrer ersten Karte eröffnet. Leer: Die Karte heißt wie das Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is opened together with its first card. Empty: the card is named like the account."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта алғашқы картасымен бірге ашылады. Бос болса: карта есеп-шот атауымен аталады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитная карта открывается вместе с первой картой. Пусто: карта называется как счёт."
          }
        }
      }
    },
    "account.credit.grace": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
