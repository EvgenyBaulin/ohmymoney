    "account.refusal.emptyName": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце назву."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte název."
          }
        },
        "de": {
          "stringUnit": {
