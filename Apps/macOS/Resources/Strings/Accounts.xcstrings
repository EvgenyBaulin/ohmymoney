    "bank.forgotten.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vəsaiti olan, istifadə edilməyən hesab və ya kart yoxdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма рахункаў ці карт з грашыма без руху"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný účet ani karta s penězi nezůstaly nečinné"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto und keine Karte stand mit Geld untätig herum"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account or card has stood idle with money on it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna cuenta ni tarjeta lleva parada con dinero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte ni carte n'est resté dormant avec de l'argent dessus"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարով չօգտագործվող հաշիվներ կամ քարտեր չկան"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conto o carta con denaro è rimasto inattivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高があり、使われていない口座やカードはありません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უმოქმედო ანგარიში ან ბარათი თანხით არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақшасы бар, ұзақ бос тұрған есеп-шот немесе карта жоқ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돈이 남은 채 사용하지 않은 계좌나 카드가 없습니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акчасы бар бош турган эсептер же карталар жок"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen ongebruikte rekeningen of kaarten met geld erop"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak nieużywanych kont i kart ze środkami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta ou cartão ficou sem uso com dinheiro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta ou cartão ficou sem movimentos com dinheiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет счетов и карт, на которых лежат деньги без движения"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисоб ё корти бефаъолият бо маблағ ёфт нашуд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçinde para olan ve kullanılmayan hesap veya kart yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден рахунок або картка не простоювали з грошима"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul saqlanadigan faoliyatsiz hisob yoki kartalar yo‘q"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有闲置且存有资金的账户或卡"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有閒置且存有款項的帳戶或卡片"
          }
        }
      }
    },
    "bank.forgotten.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gün və ya daha çox hərəkət olmayan, vəsaiti qalan və ya xidmət haqqı tutula bilən hesab və kartlar. Müddəti bitməmiş əmanət unudulmuş sayılmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахункі і карты без руху не менш за %1$@ дзён, дзе ёсць грошы ці магчымая плата за абслугоўванне. Дзейны ўклад не лічыцца забытым."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účty a karty bez pohybu po dobu alespoň %1$@ dnů, na kterých jsou peníze nebo za jejichž vedení může banka účtovat poplatek. Dosud běžící vklad se za zapomenutý nepovažuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten und Karten, auf denen seit %1$@ Tagen oder länger nichts bewegt wurde und die Geld halten oder für die Führung berechnen könnten. Ein laufendes Festgeld gilt nicht als vergessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts and cards nothing has moved on for %1$@ days or more that hold money or may charge for service. A deposit that is still running is not forgotten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentas y tarjetas sin movimientos desde hace %1$@ días o más, que tienen dinero o pueden cobrar por el servicio. Un depósito que sigue vigente no se considera olvidado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptes et cartes sans aucun mouvement depuis %1$@ jours ou plus, qui détiennent de l'argent ou peuvent facturer un service. Un dépôt encore en cours n'est pas oublié."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշիվներ և քարտեր, որոնցով %1$@ օր կամ ավելի շարժ չի եղել, և որոնցում գումար կա կամ որոնց սպասարկումը կարող է վճարովի լինել։ Դեռ գործող ավանդը մոռացված չի համարվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conti e carte senza movimenti da almeno %1$@ giorni, con denaro o possibili costi di servizio. Un deposito ancora in corso non è considerato dimenticato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@日以上取引がなく、残高があるか、口座維持手数料がかかる可能性のある口座とカードです。運用中の定期預金は含まれません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშები და ბარათები, რომლებზეც %1$@ დღე ან მეტია მოძრაობა არ ყოფილა და რომლებზეც თანხაა ან შესაძლოა მომსახურების საფასური დაერიცხოს. მოქმედი დეპოზიტი მივიწყებულად არ ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күн және одан көп қозғалыссыз тұрған, ақшасы бар немесе қызмет үшін ақы алуы мүмкін есеп-шоттар мен карталар. Әлі жұмыс істеп тұрған салым ұмытылған саналмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@일 이상 거래가 없고 돈이 남아 있거나 수수료가 부과될 수 있는 계좌와 카드입니다. 만기 전 예금은 포함되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ күн же андан көп кыймыл болбогон, акчасы бар же тейлөө акысы алынышы мүмкүн болгон эсептер жана карталар. Мөөнөтү бүтө элек депозит унутулган деп эсептелбейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekeningen en kaarten waarop %1$@ dagen of langer geen transacties zijn geweest en die geld bevatten of waarvoor kosten in rekening kunnen worden gebracht. Een lopend deposito geldt niet als vergeten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konta i karty bez operacji przez co najmniej %1$@ dni, na których są środki lub za których prowadzenie mogą być pobierane opłaty. Trwające lokaty nie są uznawane za zapomniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas e cartões sem movimentação há %1$@ dias ou mais que têm dinheiro ou podem cobrar tarifas de serviço. Um depósito ainda em vigor não é considerado esquecido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas e cartões sem movimentos há %1$@ dias ou mais, com dinheiro ou sujeitos a comissões de manutenção. Um depósito ainda em curso não é considerado esquecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета и карты без движения %1$@ дней и больше, на которых есть деньги или может быть плата за обслуживание. Вклад до конца срока не считается забытым."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисобҳо ва кортҳое, ки дар онҳо %1$@ рӯз ё бештар амалиёт набуд ва маблағ доранд ё барои хизматрасонӣ ҳақ ситонида мешавад. Амонати муҳлаташ нотамом фаромӯшшуда ҳисоб намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gün veya daha uzun süredir işlem yapılmayan, içinde para olan veya hizmet ücreti alınabilecek hesap ve kartlar. Vadesi dolmamış mevduat unutulmuş sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки й картки, за якими жодного руху не було %1$@ днів і більше, а на них є гроші або банк може брати плату за обслуговування. Депозит, що ще триває, не вважається забутим."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kun yoki undan ko‘proq vaqt harakat bo‘lmagan, pul saqlanadigan yoki xizmat haqi olinishi mumkin bo‘lgan hisob va kartalar. Muddati tugamagan omonat unutilgan hisoblanmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示至少 %1$@ 天没有交易，且存有资金或可能收取服务费的账户和卡。尚未到期的存款不计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列出 %1$@ 天以上沒有交易，且存有款項或可能收取服務費的帳戶和卡片。尚未到期的定期存款不會列入。"
          }
        }
      }
    },
