            "value": "Остаток"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок"
          }
        }
      }
    },
    "account.screen.cashback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback · %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback · %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк · %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешбек · %@"
          }
        }
      }
    },
    "account.screen.cashbackAccountLine": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок"
          }
        }
      }
    },
    "account.screen.cashbackApproximate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate income: ≈ %1$@, of it by the rules and unconfirmed — %2$@. Nothing to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingreso aproximado: ≈ %1$@, de ello por reglas y sin confirmar — %2$@. Nada que confirmar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерный доход: ≈ %1$@, из них по правилам, без подтверждения, — %2$@. Подтверждать не нужно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орієнтовний дохід: ≈ %1$@, з них за правилами й не підтверджено — %2$@. Нічого підтверджувати не потрібно."
          }
        }
      }
    },
    "account.screen.cashbackApproximateTyped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate income: ≈ %1$@, all of it the figures you typed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingreso aproximado: ≈ %1$@, todo ello son las cifras que escribió."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерный доход: ≈ %1$@ — по суммам, которые вы вписали."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орієнтовний дохід: ≈ %1$@, усе це цифри, які ви ввели."
          }
        }
      }
    },
    "account.screen.cashbackExpected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "expected ≈ %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "previsto ≈ %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ожидается ≈ %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "очікується ≈ %@"
          }
        }
      }
    },
    "account.screen.cashbackLate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback for the purchases %1$@ has not come: expected ≈ %2$@, due by %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cashback de las compras %1$@ no ha llegado: previsto ≈ %2$@, vence el %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк за покупки %1$@ не пришёл: ждали ≈ %2$@, срок был %3$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешбек за покупки %1$@ не надійшов: очікувався ≈ %2$@, мав прийти до %3$@."
          }
        }
      }
    },
    "account.screen.cashbackNone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules, and no cashback this month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay reglas ni cashback este mes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил нет, и кэшбэка в этом месяце не было."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил немає, і кешбеку цього місяця немає."
          }
        }
      }
    },
    "account.screen.cashbackPayoutDue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank pays this month’s cashback by %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco abona el cashback de este mes antes del %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк платит кэшбэк за этот месяц до %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк нараховує кешбек за цей місяць до %@."
          }
        }
      }
    },
    "account.screen.cashbackPayoutImmediately": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank pays the cashback with the purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco abona el cashback junto con la compra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк платит кэшбэк сразу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк нараховує кешбек одразу з покупкою."
          }
        }
      }
    },
    "account.screen.cashbackPoints": {
      "extractionState": "manual",
      "localizations": {
        "en": {
