        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wybierz konto, które stanie się główne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, escolha a nova conta principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите счёт, который станет основным."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аввал суратҳисоберо, ки асосӣ мешавад, интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
