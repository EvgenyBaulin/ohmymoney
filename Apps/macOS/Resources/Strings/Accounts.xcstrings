    "account.editor.mainHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas hesab bütün siyahılarda birinci göstərilir; hesabı seçilməyən əməliyyatlar ona yazılır. Yalnız bir əsas hesab ola bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак першы ва ўсіх спісах; аперацыя без свайго рахунку трапляе на яго. Асноўным можа быць толькі адзін рахунак."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní účet je první v každém seznamu. Přiřadí se k němu operace bez vlastního účtu. Hlavní může být jen jeden účet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto steht in jeder Liste an erster Stelle; ein Vorgang ohne eigenes Konto wird ihm zugeordnet. Nur ein Konto ist das Hauptkonto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is first in every list; an operation with no account of its own goes to it. Only one account is main."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal va primera en todas las listas; una operación sin cuenta propia va a ella. Solo una cuenta es la principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal est en tête de chaque liste ; une opération sans compte propre lui est affectée. Un seul compte est principal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնական հաշիվն առաջինն է բոլոր ցանկերում․ առանց հաշվի գործարքները գրանցվում են դրանում։ Հիմնական կարող է լինել միայն մեկ հաշիվ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale è il primo in ogni elenco. Le operazioni senza un conto assegnato vengono registrate su questo conto. Un solo conto può essere principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイン口座はすべてのリストの先頭に表示されます。口座が指定されていない取引にも使われます。メイン口座は1つだけです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავარი ანგარიში ყველა სიაში პირველია. ოპერაცია, რომელსაც ანგარიში არ აქვს მითითებული, მას მიეწერება. მთავარი მხოლოდ ერთი ანგარიშია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот әр тізімде бірінші тұрады; өз есеп-шоты жоқ операция соған жазылады. Негізгі бір ғана есеп-шот болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 계좌는 모든 목록의 맨 위에 표시됩니다. 계좌를 지정하지 않은 거래는 기본 계좌에 기록됩니다. 기본 계좌는 하나만 설정할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги эсеп бардык тизмелерде биринчи турат. Эсеби көрсөтүлбөгөн операциялар ага жазылат. Бир гана эсеп негизги боло алат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoofdrekening staat bovenaan in elke lijst. Transacties zonder rekening worden eraan toegewezen. Er kan maar één hoofdrekening zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto główne jest pierwsze na każdej liście; trafiają na nie operacje bez przypisanego konta. Tylko jedno konto może być główne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal aparece primeiro em todas as listas e recebe operações sem conta definida. Apenas uma conta pode ser a principal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal aparece primeiro em todas as listas. As operações sem conta atribuída são registadas nela. Só pode haver uma conta principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт — первый во всех списках; операция без своего счёта попадает на него. Основной счёт один."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби асосӣ дар ҳамаи рӯйхатҳо аввал меояд; амалиёти беҳисоб ба он дохил мешавад. Танҳо як ҳисоб асосӣ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana hesap tüm listelerde ilk sıradadır. Hesap belirtilmeyen işlemler bu hesaba eklenir. Yalnızca bir ana hesap olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок стоїть першим у кожному списку; операція без власного рахунку йде на нього. Основний рахунок один."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy hisob barcha ro‘yxatlarda birinchi turadi. Hisobi ko‘rsatilmagan operatsiyalar unga yoziladi. Faqat bitta hisob asosiy bo‘lishi mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主账户在所有列表中置顶；未指定账户的交易会归入主账户。只能有一个主账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要帳戶會顯示在所有列表的最前面；未指定帳戶的交易會歸入此帳戶。只能有一個主要帳戶。"
          }
        }
      }
    },
    "account.editor.mainStays": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas hesabı söndürmək olmaz. Başqa hesabı əsas edin, bu hesab əsas olmaqdan çıxacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак нельга адключыць: зрабіце асноўным іншы, і гэты перастане ім быць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní účet nelze vypnout. Nastavte jako hlavní jiný účet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto lässt sich nicht ausschalten: Machen Sie ein anderes Konto zum Hauptkonto, dann ist dieses nicht mehr das Hauptkonto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be switched off: make another account main, and this one stops being main."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal no se puede desactivar: haga principal otra cuenta y esta dejará de serlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal ne peut pas être désactivé : désignez un autre compte comme principal, et celui-ci cessera de l'être."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնական հաշիվը հնարավոր չէ անջատել․ հիմնական դարձրեք մեկ այլ հաշիվ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale non può essere disattivato. Imposta un altro conto come principale per sostituirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイン口座はオフにできません。別の口座をメインにすると、この口座はメインではなくなります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავარ ანგარიშს ვერ გამორთავთ. მთავარ ანგარიშად სხვა აირჩიეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шотты өшіру мүмкін емес: басқа есеп-шотты негізгі етіңіз, осы есеп-шот негізгі болудан қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 계좌는 끌 수 없습니다. 다른 계좌를 기본 계좌로 설정하면 이 계좌는 기본 계좌에서 해제됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги эсепти өчүрүүгө болбойт. Башка эсепти негизги кылсаңыз, бул эсеп негизги болбой калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de hoofdrekening niet uitschakelen. Maak een andere rekening de hoofdrekening om deze te vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wyłączyć konta głównego: ustaw inne konto jako główne, aby to przestało nim być."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal não pode ser desativada. Defina outra conta como principal para substituí-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível desativar a conta principal. Defina outra conta como principal para que esta deixe de o ser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не выключается: сделайте основным другой счёт — этот перестанет им быть."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби асосиро хомӯш карда намешавад: ҳисоби дигарро асосӣ кунед, то ин ҳисоб асосӣ набошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana hesap kapatılamaz. Başka bir hesabı ana hesap yaparsanız bu hesap ana hesap olmaktan çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок не можна вимкнути: зробіть основним інший рахунок, і цей перестане бути основним."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy hisobni o‘chirib bo‘lmaydi. Boshqa hisobni asosiy qilsangiz, bu hisob asosiy bo‘lmay qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法关闭主账户：将其他账户设为主账户后，此账户将不再是主账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法直接關閉主要帳戶。將其他帳戶設為主要帳戶即可。"
          }
        }
      }
    },
