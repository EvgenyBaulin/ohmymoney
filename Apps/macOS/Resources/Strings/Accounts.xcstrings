    "account.handOver.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце рахунак, які стане асноўным. Прапанаваны самы ўжываны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie stattdessen das Konto, das Hauptkonto wird. Das am meisten genutzte wird vorgeschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account that becomes main instead. The most used one is picked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la cuenta que pasará a ser la principal. Se propone la más usada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le compte qui deviendra principal à la place. Le plus utilisé est proposé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il nuovo conto principale. È selezionato quello più usato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның орнына негізгі болатын есеп-шотты таңдаңыз. Ең көп қолданылаты таңдалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Анын ордуна негизги боло турган эсепти тандаңыз. Эң көп колдонулганы тандалды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz konto, które stanie się główne. Wybrano najczęściej używane konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a conta que será a nova principal. A mais usada já está selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите счёт, который станет основным вместо него. Предложен самый используемый."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоберо интихоб кунед, ки асосӣ мешавад. Ҳисоби бештар истифодашуда интихоб шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerine geçecek ana hesabı seçin. En çok kullanılan hesap seçilidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть рахунок, який стане основним. Вибрано найчастіше використовуваний."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘rniga asosiy bo‘ladigan hisobni tanlang. Eng ko‘p ishlatiladigani tanlangan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要設為主要帳戶的帳戶。已選取最常使用的帳戶。"
          }
        }
      }
    },
