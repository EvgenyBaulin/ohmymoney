    "account.handOver.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onun əvəzinə əsas olacaq hesabı seçin. Ən çox istifadə edilən hesab seçilib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце рахунак, які стане асноўным. Прапанаваны самы ўжываны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte účet, který bude nově hlavní. Předvybrán je nejpoužívanější účet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie stattdessen das Konto, das Hauptkonto wird. Das am meisten genutzte wird vorgeschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account that becomes main instead. The most used one is picked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la cuenta que pasará a ser la principal. Se propone la más usada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le compte qui deviendra principal à la place. Le plus utilisé est proposé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք նոր հիմնական հաշիվը։ Ամենաշատ օգտագործվողն արդեն ընտրված է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il nuovo conto principale. È selezionato quello più usato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりにメインにする口座を選択してください。最もよく使う口座が選択されています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ ანგარიში, რომელიც მთავარი გახდება. წინასწარ არჩეულია ყველაზე ხშირად გამოყენებული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның орнына негізгі болатын есеп-шотты таңдаңыз. Ең көп қолданылаты таңдалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 기본 계좌로 설정할 계좌를 선택하세요. 가장 자주 사용하는 계좌가 선택되어 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Анын ордуна негизги боло турган эсепти тандаңыз. Эң көп колдонулганы тандалды."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de nieuwe hoofdrekening. De meest gebruikte rekening is geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz konto, które stanie się główne. Wybrano najczęściej używane konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a conta que será a nova principal. A mais usada já está selecionada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a conta que passará a ser a principal. A mais usada está selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите счёт, который станет основным вместо него. Предложен самый используемый."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоберо интихоб кунед, ки асосӣ мешавад. Ҳисоби бештар истифодашуда интихоб шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerine geçecek ana hesabı seçin. En çok kullanılan hesap seçilidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть рахунок, який стане основним. Вибрано найчастіше використовуваний."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘rniga asosiy bo‘ladigan hisobni tanlang. Eng ko‘p ishlatiladigani tanlangan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择接替的主账户。已选中最常用的账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要設為主要帳戶的帳戶。已選取最常使用的帳戶。"
          }
        }
      }
    },
