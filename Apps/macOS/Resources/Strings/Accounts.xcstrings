            "state": "translated",
            "value": "Il saldo minimo del mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдағы ең төмен қалдыққа"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najniższego salda w miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O menor saldo do mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "минимальный остаток месяца"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın en düşük bakiyesi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найменший залишок за місяць"
          }
        }
      }
    },
    "account.interest.base.minBalanceNote": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнты налічваюцца на мінімальны астатак за месяц: зняцце грошай нават на дзень зніжае ўсю суму працэнтаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen werden auf den niedrigsten Kontostand des Monats berechnet. Auch eine Abhebung für einen Tag senkt die Zinsen für den ganzen Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest is counted on the lowest balance of each month: money taken out for a day lowers all of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses se calculan sobre el saldo mínimo de cada mes: retirar dinero un solo día reduce todos los intereses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts sont calculés sur le solde le plus bas de chaque mois. Un retrait, même d’un jour, réduit tous les intérêts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli interessi sono calcolati sul saldo minimo di ogni mese: un prelievo anche di un solo giorno li riduce per tutto il mese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыйақы айдың ең төмен қалдығына есептеледі: ақшаны бір күнге алсаңыз да, сыйақы азаяды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsetki są naliczane od najniższego salda w miesiącu. Wypłata nawet na jeden dzień zmniejsza całą kwotę odsetek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros são calculados sobre o menor saldo de cada mês: retirar dinheiro por um dia reduz o rendimento de todo o mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты считаются на минимальный остаток каждого месяца: деньги, снятые хотя бы на день, снижают проценты за весь месяц."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz, her ayın en düşük bakiyesi üzerinden hesaplanır. Bir günlüğüne para çekmek, tüm ayın faizini düşürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки нараховуються на найменший залишок за місяць: зняття грошей навіть на день зменшує всю суму відсотків."
          }
        }
      }
    },
