          "stringUnit": {
            "state": "translated",
            "value": "У кашальку лічбавага рубля захоўваюцца толькі рублі. Працэнты і кэшбэк для яго выключаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wallet enthält nur Rubel. Zinsen und Cashback sind dafür deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A digital ruble wallet holds rubles only and has no interest and no cashback: they are switched off for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un monedero de rublos digitales solo admite rublos y no ofrece intereses ni devolución. Estas opciones están desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce portefeuille contient uniquement des roubles. Les intérêts et le cashback y sont désactivés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio in rubli digitali contiene solo rubli e non prevede interessi né cashback: sono disattivati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цифрлық рубль әмиянында тек рубль сақталады. Сыйақы мен кешбэк өшірілген."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel cyfrowego rubla służy tylko do przechowywania rubli. Oprocentowanie i cashback są wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira de rublo digital aceita apenas rublos e não oferece juros nem cashback: eles ficam desativados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В кошельке цифрового рубля только рубли, без процентов и кэшбэка: они для него отключены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijital ruble cüzdanında yalnızca ruble tutulur. Faiz ve para iadesi uygulanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець цифрового рубля містить лише рублі. Відсотки й кешбек для нього вимкнено."
          }
        }
      }
    },
