    "cashback.refusal.pointsItself": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account cannot be its own points account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta no puede ser su propia cuenta de puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte ne peut pas être son propre compte de points."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт не может быть своим счётом для баллов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок не може бути рахунком для власних балів."
