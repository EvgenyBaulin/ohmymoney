    "account.interest.dayNotSaid": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Göstərilməyib — açılış günü, o da yoxdursa, ayın son günü"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зададзены — дзень адкрыцця, інакш апошні дзень месяца"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuvedeno — den založení, jinak poslední den v měsíci"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht angegeben — der Eröffnungstag, sonst der letzte Tag des Monats"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not said — the opening day, else the last day of the month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No indicado: el día de apertura, si no, el último día del mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non précisé — le jour d'ouverture, sinon le dernier jour du mois"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշված չէ՝ բացման օրը, իսկ եթե հայտնի չէ՝ ամսվա վերջին օրը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non specificato: il giorno di apertura, altrimenti l’ultimo giorno del mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未指定 — 開設日、または月末"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიუთითებლისას — გახსნის დღე, ან თვის ბოლო დღე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айтылмаған — ашылған күн, әйтпесе айдың соңғы күні"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정하지 않음 — 개설일 또는 매월 말일"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрсөтүлбөсө — ачылган күн, болбосо айдын акыркы күнү"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet opgegeven — de openingsdag, anders de laatste dag van de maand"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie podano — dzień otwarcia lub ostatni dzień miesiąca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não informado — dia da abertura ou último dia do mês"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não indicado — dia de abertura ou, se desconhecido, último dia do mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не указан — день открытия, иначе последний день месяца"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Номуайян — рӯзи кушодан, вагарна рӯзи охири моҳ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirtilmedi — açılış günü, yoksa ayın son günü"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вказано — день відкриття, інакше останній день місяця"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘rsatilmagan — ochilgan kun, aks holda oyning oxirgi kuni"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未指定 — 开户日，否则为每月最后一天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未指定 — 開戶日，否則為每月最後一天"
          }
        }
      }
    },
