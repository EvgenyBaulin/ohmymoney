        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվավեր նվազագույն վճար․ տոկոսը պետք է լինի մինչև 100, իսկ գումարը՝ զրոյից ոչ պակաս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento minimo non valido: inserisci una percentuale fino a 100 e un importo non inferiore a zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最低支払額が正しくありません。割合は100%以下、金額は0以上で入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მინიმალური გადასახდელი არასწორია: პროცენტი უნდა იყოს 100-მდე, თანხა კი — არანაკლებ ნულისა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең аз төлем оқылмады: пайыз — 100-ге дейін, сома — нөлден кем емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소 결제 금액을 확인하세요. 비율은 100 이하여야 하며 금액은 0 이상이어야 합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эң аз төлөмдү текшериңиз: пайыз 100дөн ашпашы, сумма нөлдөн кем болбошу керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De minimumbetaling is ongeldig: vul een percentage tot en met 100 en een bedrag van minimaal nul in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowa minimalna spłata. Procent nie może przekraczać 100, a kwota nie może być ujemna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento mínimo inválido: use uma porcentagem de até 100 e um valor igual ou maior que zero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento mínimo inválido: introduza uma percentagem até 100 e um valor igual ou superior a zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимальный платёж не читается: процент до 100 и сумма не меньше нуля."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пардохти ҳадди ақал нодуруст аст: фоиз то 100 ва маблағ на камтар аз сифр бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asgari ödeme okunamıyor: Yüzde 100'ü aşmamalı ve tutar sıfırdan küçük olmamalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мінімальний платіж не вдалося прочитати: відсоток до 100 і сума не менше нуля."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eng kam to‘lov noto‘g‘ri: foiz 100 dan oshmasligi, summa esa noldan kam bo‘lmasligi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最低还款额格式有误：百分比不能超过 100，金额不能小于零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最低應繳金額無效：百分比不得超過 100，金額不得低於零。"
          }
        }
      }
    },
