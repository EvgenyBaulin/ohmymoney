        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto ist archiviert — stellen Sie es zuerst wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is archived — restore it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta está archivada: recupérela primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte est archivé — ramenez-le d'abord."
