    "bank.cond.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type what the bank's own app says. The app learns nothing from the bank and does not give advice: check the terms with the bank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba lo que dice la propia app del banco. La app no recibe nada del banco y no da consejos: revise las condiciones con el banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите то, что написано в приложении банка. Приложение ничего не узнаёт у банка и не даёт советов: уточните условия в банке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть те, що написано в застосунку самого банку. Застосунок нічого не отримує від банку й не дає порад: умови уточнюйте в банку."
          }
        }
      }
    },
