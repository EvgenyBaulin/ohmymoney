    "account.editor.bank.newHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асобны банк з назвай рахунку, калі вы не задасце іншую. Рахунак з назвай наяўнага банка далучыцца да яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine eigene Bank, benannt wie das Konto, sofern Sie keinen anderen Namen angeben. Ein Konto, das wie eine bereits vorhandene Bank heißt, wird dieser Bank zugeordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank of its own, called like the account unless you name it. An account called like a bank that is there already joins that bank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banco propio, con el nombre de la cuenta salvo que indique otro. Una cuenta con el nombre de un banco que ya existe se añade a ese banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une banque à part, nommée comme le compte si vous ne la nommez pas autrement. Un compte nommé comme une banque déjà présente rejoint cette banque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una banca separata, con lo stesso nome del conto se non ne inserisci uno. Un conto con il nome di una banca esistente viene associato a quella banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз банкі, атауы басқа атау енгізілмесе, есеп-шотпен бірдей. Бұрыннан бар банктің атымен аталған есеп-шот сол банкке қосылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсеп үчүн өзүнчө банк. Ат бербесеңиз, эсептин аты колдонулат. Эсептин аты бар банктын атына дал келсе, ошол банкка кошулат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osobny bank o nazwie konta, chyba że podasz inną. Konto o nazwie istniejącego banku zostanie do niego przypisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um banco próprio, com o nome da conta, a menos que você escolha outro. Se a conta tiver o nome de um banco existente, ela será vinculada a ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк под своим именем — как у счёта, если не назвать иначе. Счёт, названный как уже существующий банк, встаёт под него."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонки алоҳида бо номи ҳисоб сохта мешавад, агар номи дигар надиҳед. Ҳисоб бо номи бонки мавҷуда ба он бонк пайваст мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrı bir banka oluşturulur. Ad vermezseniz hesap adı kullanılır. Hesap adı mevcut bir bankayla aynıysa hesap o bankaya bağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк окремо, називається так само, як рахунок, якщо ви не назвете інакше. Рахунок, названий як уже наявний банк, приєднується до нього."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Alohida bank. Nom kiritilmasa, hisob nomi beriladi. Hisob nomi mavjud bank nomiga mos kelsa, u shu bankka qo‘shiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立專屬銀行，預設使用帳戶名稱。若帳戶名稱與現有銀行相同，則會歸入該銀行。"
          }
        }
      }
    },
