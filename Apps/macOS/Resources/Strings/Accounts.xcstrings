          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyeleri tüm toplamlarından çıkarılır. Hesaplara bağlı öğe yok. “Geri Al” ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки %@ разом із ними зникають з усіх підсумків. Ніщо на рахунки не посилається. «Скасувати» поверне їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qoldiqlar barcha jami summalardan chiqariladi. Hisoblarga hech narsa bog‘lanmagan. “Bekor qilish” ularni qaytaradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額 %@ 也會從所有總計中移除。沒有項目參照這些帳戶。使用「復原」可還原。"
          }
        }
      }
    },
