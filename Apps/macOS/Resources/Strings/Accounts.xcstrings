    "account.credit.notCounted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile the account — without a balance there are no statements to work out"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверьте счёт — без остатка выписки не посчитать"
          }
        }
      }
    },
    "account.credit.offHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on for a card with a credit limit: the screen of the account will say what to pay by when not to pay interest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите для карты с кредитным лимитом: экран счёта подскажет, сколько и до какого дня внести, чтобы не платить проценты."
          }
        }
      }
    },
    "account.credit.payDays": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay within %@ days of the statement"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплатить за %@ дн. после выписки"
          }
        }
      }
    },
    "account.credit.purchaseDays": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No interest for %@ days from a purchase"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без процентов %@ дн. с покупки"
