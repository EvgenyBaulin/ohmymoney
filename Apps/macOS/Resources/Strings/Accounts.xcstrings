    "account.credit.graceLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grace period is lost: pay the whole debt, %@, and interest stops"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pierde el periodo de gracia: pague la deuda completa, %@, y los intereses dejan de correr"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La période de grâce est perdue : remboursez toute la dette, %@, et les intérêts s'arrêtent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Льготный период потерян: внесите весь долг %@, и проценты перестанут начисляться"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пільговий період втрачено: сплатіть весь борг, %@, і відсотки припиняться"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il periodo senza interessi è scaduto: paga l’intero debito, %@, per fermare gli interessi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейінге қалдыру кезеңі жойылды: бүкіл берешекті төлеңіз, %@, пайыз тоқтайды"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Льготны перыяд страчаны: пагасіце ўвесь доўг, %@, каб спыніць працэнты"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zinsfreie Frist ist verloren: Zahlen Sie die ganze Schuld, %@, dann hören die Zinsen auf"
          }
        }
      }
    },
    "account.credit.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is an account whose balance goes below zero; it is not a debt. Every term is in %@. Interest is shown as an estimate until you record it from the statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta de crédito es una cuenta cuyo saldo baja de cero; no es una deuda. Todas las condiciones están en %@. Los intereses se muestran como estimación hasta que los registre según el extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit est un compte dont le solde passe sous zéro ; ce n'est pas une dette. Toutes les conditions sont en %@. Les intérêts sont affichés comme une estimation jusqu'à ce que vous les notiez d'après le relevé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитная карта — это счёт, остаток которого уходит в минус, а не долг. Все условия — в %@. Проценты видны как оценка, пока вы не запишете их по выписке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитна картка — це рахунок, баланс якого опускається нижче нуля; це не борг. Усі умови вказано в %@. Відсотки показано як оцінку, доки ви не запишете їх із виписки."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta di credito è un conto il cui saldo può scendere sotto zero; non è un debito. Tutti gli importi sono in %@. Gli interessi sono una stima finché non li registri dall’estratto conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта — теңгерімі нөлден төмен болатын есеп-шот; ол берешек емес. Барлық шарттар: %@ валютасында. Пайыз үзіндіден жазылғанша болжам ретінде көрсетіледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крэдытная карта — рахунак з адмоўным балансам, а не пазыка. Усе ўмовы ў %@. Працэнты прыблізныя, пакуль вы не запішаце іх з выпіскі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte ist ein Konto, dessen Saldo unter null fällt; sie ist keine Schuld. Alle Bedingungen stehen in %@. Zinsen werden als Schätzung angezeigt, bis Sie sie aus der Abrechnung erfassen."
          }
        }
      }
    },
