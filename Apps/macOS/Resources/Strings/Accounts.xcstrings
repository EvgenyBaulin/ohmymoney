    "bank.limit.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şəxslərə və digər banklara köçürmələr limitə daxildir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пераводы людзям і ў іншыя банкі ўлічваюцца ў ліміце."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do limitu se započítávají převody lidem a do jiných bank."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überweisungen an Personen und an andere Banken zählen auf das Limit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers to people and to other banks count against the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias a personas y a otros bancos cuentan contra el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les virements aux particuliers et vers d'autres banques comptent dans le plafond."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանաչափում հաշվվում են մարդկանց և այլ բանկեր փոխանցումները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trasferimenti a persone e altre banche concorrono al limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人への送金と他行振込が上限に算入されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლიმიტში ითვლება გადარიცხვები ფიზიკურ პირებთან და სხვა ბანკებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адамдарға және басқа банктерге аударымдар лимитке есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 및 타행 이체가 한도에 포함됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жеке адамдарга жана башка банктарга которуулар лимитке кирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overboekingen naar personen en andere banken tellen mee voor de limiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelewy do osób i innych banków są wliczane do limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências para pessoas e outros bancos contam para o limite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As transferências para pessoas e outros bancos contam para o limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы людям и в другие банки считаются в лимит."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Интиқолҳо ба шахсон ва бонкҳои дигар ба ҳадд дохил мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişilere ve diğer bankalara yapılan transferler limite sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекази людям і в інші банки враховуються в ліміті."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jismoniy shaxslarga va boshqa banklarga o‘tkazmalar limitga kiritiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向个人和其他银行转账均计入限额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉帳給個人及跨行轉帳都會計入限額。"
          }
        }
      }
    },
