    "accounts.orderHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto steht immer an erster Stelle, in jeder Liste und jedem Menü. Ziehen Sie die anderen in die gewünschte Reihenfolge oder sortieren Sie sie alphabetisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is always first, in every list and menu. Drag the others into the order you like, or sort them alphabetically."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот әр тізімде және мәзірде әрқашан бірінші тұрады. Басқаларын қалаған тәртіпке сүйреңіз немесе әліпби бойынша сұрыптаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт всегда первый — во всех списках и меню. Остальные перетащите в удобном порядке или отсортируйте по алфавиту."
          }
        }
      }
    },
