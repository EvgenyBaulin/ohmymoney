            "state": "translated",
            "value": "%@ Жөндөөлөр → Валюталар бөлүмүндө өчүрүлгөн."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waluta %@ jest wyłączona w Ustawienia → Waluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desativada em Ajustes → Moedas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта %@ выключена в Настройках → Валюты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ дар Танзимот → Асъорҳо хомӯш аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Ayarlar → Para Birimleri bölümünde kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вимкнено в «Налаштування → Валюти»."
          }
        },
        "uz": {
          "stringUnit": {
