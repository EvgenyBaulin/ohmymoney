        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия пойдёт в «%1$@» — она вернётся из архива вместе с «%2$@»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия ба «%1$@» меравад, ки бо «%2$@» аз бойгонӣ баргардонда мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücret, «%2$@» ile birlikte arşivden geri getirilecek «%1$@» kategorisine kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія йде на «%1$@», який повертається з архіву разом із «%2$@»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya «%1$@»ga yoziladi va u «%2$@» bilan birga arxivdan qaytariladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手续费将记入«%1$@»，该类别将与«%2$@»一起从归档中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手續費會記入「%1$@」，該類別將與「%2$@」一併從封存中恢復。"
          }
        }
      }
    },
    "transfer.refusal.amountsDiffer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyni valyutada göndərilən və alınan məbləğ eyni olmalıdır; bankın tutduğu məbləği komissiya kimi qeyd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У адной валюце паступае столькі ж, колькі спісваецца; утрыманае банкам запішыце як камісію."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při převodu ve stejné měně musí být odeslaná a přijatá částka stejná. Částku, kterou si banka ponechala, zadejte jako poplatek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Währung kommt derselbe Betrag an, der abgeht; tragen Sie als Gebühr ein, was die Bank einbehalten hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one currency the same amount arrives as leaves; write what the bank kept as the fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una misma divisa, llega el mismo importe que sale; escriba lo que se quedó el banco como comisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans une même devise, le même montant arrive tel qu'il part ; notez ce que la banque a retenu comme frais."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նույն արժույթով փոխանցման դեպքում ստացվող և ուղարկվող գումարները նույնն են։ Բանկի պահած գումարը նշեք որպես միջնորդավճար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella stessa valuta, l'importo ricevuto deve essere uguale a quello inviato; inserisci ciò che la banca ha trattenuto come commissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ通貨では振替元と振替先の金額は同じになります。銀行が差し引いた金額は手数料として入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთი ვალუტით გადარიცხვისას გაგზავნილი და მიღებული თანხა თანაბარია; ბანკის მიერ დაკავებული თანხა საკომისიოდ მიუთითეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір валютада бірдей сома келеді де кетеді; банк ұстап қалғанын комиссия ретінде жазыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 통화로 이체할 때는 출금액과 입금액이 같아야 합니다. 은행에서 차감한 금액은 수수료로 입력하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир валютада жөнөтүлгөн жана алынган сумма бирдей болот; банк кармап калган сумманы комиссия катары жазыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij dezelfde valuta komt hetzelfde bedrag aan als er vertrekt. Vul wat de bank heeft ingehouden in als kosten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej samej walucie kwota wychodząca i przychodząca musi być taka sama. Kwotę pobraną przez bank wpisz jako opłatę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na mesma moeda, o valor recebido deve ser igual ao enviado; informe como tarifa o valor retido pelo banco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa transferência na mesma moeda, o montante recebido é igual ao enviado; indique como comissão o que o banco reteve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В одной валюте зачисляется столько же, сколько списано; то, что удержал банк, запишите комиссией."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар як асъор маблағи воридшуда ва хориҷшуда бояд яксон бошад; маблағи нигоҳдоштаи бонкро ҳамчун комиссия ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı para biriminde gönderilen ve alınan tutar eşittir; bankanın kestiği tutarı ücret olarak girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В одній валюті на іншу сторону приходить та сама сума; запишіть, що банк утримав, як комісію."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir xil valyutada yuborilgan va olingan summa teng bo‘ladi; bank ushlab qolgan summani komissiya sifatida kiriting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同币种转账的转入和转出金额应相同；银行扣留的金额请记为手续费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同貨幣的轉入和轉出金額必須一致；請將銀行扣除的金額記為手續費。"
          }
        }
      }
    },
    "transfer.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesab arxivdədir: köçürmə etmək və ya almaq üçün onu bərpa edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак у архіве: аднавіце яго для пераводаў з яго ці на яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet je v archivu. Chcete-li z něj nebo na něj převádět peníze, obnovte ho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto ist im Archiv: Holen Sie es zurück, um darauf oder davon zu überweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in the archive: bring it back to transfer to or from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta está en el archivo: recupérela para transferir desde ella o hacia ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte est aux archives : ramenez-le pour y virer ou en virer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշիվն արխիվացված է․ վերականգնեք այն՝ փոխանցում կատարելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto è archiviato: ripristinalo per effettuare trasferimenti da o verso di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座はアーカイブされています。振替を行うには復元してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიში არქივშია: გადარიცხვისთვის ჯერ დააბრუნეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот мұрағатта: оған немесе одан аудару үшін оны қайтарыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌가 보관함에 있습니다. 이체하려면 계좌를 복원하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсеп архивде: ага же андан которуу үчүн аны архивден кайтарыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rekening staat in het archief. Haal deze terug om geld over te boeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto jest w archiwum. Przywróć je, aby wykonać przelew z tego konta lub na nie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta está arquivada. Restaure-a para fazer transferências."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta está arquivada: restaure-a para transferir dinheiro de ou para ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт в архиве — верните его, чтобы переводить на него или с него."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоб дар бойгонӣ аст. Барои интиқол ба он ё аз он аввал ҳисобро баргардонед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap arşivde. Transfer yapmak için hesabı geri getirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок в архіві: поверніть його, щоб переказувати на нього або з нього."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob arxivda: undan yoki unga o‘tkazma qilish uchun uni qaytaring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已归档。请先恢复账户，再进行转账。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶已封存；請先恢復帳戶，再轉入或轉出。"
          }
        }
      }
    },
    "transfer.refusal.feeMoneyBack": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu köçürmənin komissiyası üçün artıq pul geri alınıb: komissiyanın məbləğini və valyutasını dəyişmək, onu silmək mümkün deyil. Əvvəlcə geri alınan pulu silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За камісію гэтага пераводу ўжо вярнулі грошы: нельга змяняць суму, валюту ці прыбіраць яе. Спачатку выдаліце вяртанне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za poplatek tohoto převodu již byly vráceny peníze. Nelze změnit jeho částku ani měnu ani ho odstranit. Nejprve smažte vrácení peněz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Gebühr dieser Überweisung wurde bereits Geld zurückgegeben: Betrag und Währung lassen sich nicht ändern, und sie kann nicht entfernt werden. Löschen Sie zuerst diese Rückzahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money was already given back for this transfer's fee: its amount and currency can't change, and it can't be taken off. Delete that money back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se devolvió dinero por la comisión de esta transferencia: su importe y divisa no pueden cambiar, y no puede quitarse. Primero elimine esa devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement a déjà été fait sur les frais de ce virement : son montant et sa devise ne peuvent plus changer, et il ne peut pas être retiré. Supprimez d'abord ce remboursement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս փոխանցման միջնորդավճարի համար գումարն արդեն հետ է ստացվել․ դրա գումարն ու արժույթը հնարավոր չէ փոխել, իսկ միջնորդավճարը՝ հեռացնել։ Նախ ջնջեք գումարի վերադարձը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già stato restituito denaro per la commissione di questo trasferimento: non puoi modificarne l'importo o la valuta, né rimuoverla. Elimina prima la restituzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この振替の手数料はすでに払い戻されています。手数料の金額や通貨の変更、削除はできません。先に払い戻しを削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ გადარიცხვის საკომისიოს თანხა უკვე დაბრუნებულია: მისი ოდენობის ან ვალუტის შეცვლა და საკომისიოს წაშლა შეუძლებელია. ჯერ დაბრუნება წაშალეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл аударымның комиссиясына ақша қайтарылған: оның сомасы мен валютасы өзгере алмайды, және ол алынып тасталмайды. Алдымен сол қайтарылған ақшаны жойыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이체의 수수료에 대해 이미 환급이 기록되어 수수료의 금액과 통화를 변경하거나 수수료를 제거할 수 없습니다. 먼저 환급을 삭제하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул которуунун комиссиясы үчүн акча кайтарылып берилген: анын суммасын же валютасын өзгөртүүгө жана аны алып салууга болбойт. Адегенде кайтарылган акчаны өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de kosten van deze overboeking is al geld teruggegeven. Het bedrag en de valuta kunnen niet worden gewijzigd en de kosten kunnen niet worden verwijderd. Verwijder eerst de teruggave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot opłaty za ten przelew został już wypłacony. Nie można zmienić jej kwoty ani waluty ani jej usunąć. Najpierw usuń zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já houve devolução de dinheiro para a tarifa desta transferência. O valor e a moeda da tarifa não podem ser alterados, e ela não pode ser removida. Apague a devolução primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já foi devolvido dinheiro relativo à comissão desta transferência: não é possível alterar o montante ou a moeda da comissão, nem removê-la. Apague primeiro a devolução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За комиссию этого перевода уже вернули деньги: её сумму и валюту не изменить, а саму комиссию не убрать. Сначала удалите этот возврат денег."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои комиссияи ин интиқол аллакай маблағ баргардонда шудааст: тағйири маблағ ва асъори комиссия ё ҳазфи он имкон надорад. Аввал маблағи баргардондашударо ҳазф кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu transferin ücreti için para iadesi zaten yapıldı: ücretin tutarı ve para birimi değiştirilemez veya ücret kaldırılamaz. Önce para iadesini silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За комісію цього переказу вже повернуто гроші: її суму й валюту не можна змінити, і її не можна зняти. Спершу видаліть це повернення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu o‘tkazma komissiyasi uchun pul allaqachon qaytarilgan: komissiya summasi va valyutasini o‘zgartirib yoki uni olib tashlab bo‘lmaydi. Avval qaytarilgan pulni o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此转账的手续费已有返还，因此无法更改手续费的金额或货币，也无法移除手续费。请先删除该返还。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此轉帳的手續費已有退款，其金額和貨幣無法更改，也無法移除。請先刪除該退款。"
          }
        }
      }
    },
    "transfer.refusal.feeRefunded": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu köçürmənin komissiyası üçün qaytarma qeydə alınıb: komissiyanı silmək, qaytarılan məbləğdən azaltmaq və ya valyutasını dəyişmək, həmçinin köçürməni silmək mümkün deyil. Əvvəlcə qaytarmanı silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На камісію гэтага пераводу запісана вяртанне: нельга прыбіраць камісію, памяншаць ніжэй за вернутае, змяняць валюту ці выдаляць перавод разам з ёй. Спачатку выдаліце вяртанне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K poplatku tohoto převodu již bylo zaznamenáno vrácení peněz. Poplatek nelze odstranit, snížit pod vrácenou částku ani změnit jeho měnu. Nelze s ním ani smazat převod. Nejprve smažte vrácení peněz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Gebühr dieser Überweisung ist eine Erstattung erfasst: Die Gebühr lässt sich nicht entfernen, nicht kleiner machen als die Erstattung oder in eine andere Währung verschieben, und die Überweisung lässt sich mit ihr nicht löschen. Löschen Sie zuerst die Erstattung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund was recorded against this transfer's fee: the fee can't be taken off, made smaller than what was refunded or moved to another currency, and the transfer can't be deleted with it. Delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una devolución registrada sobre la comisión de esta transferencia: la comisión no puede quitarse, reducirse por debajo de lo devuelto ni pasar a otra divisa, y la transferencia no puede eliminarse con ella. Elimine antes la devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement a été noté sur les frais de ce virement : les frais ne peuvent pas être retirés, ramenés sous le montant remboursé ni passés dans une autre devise, et le virement ne peut pas être supprimé avec eux. Supprimez d'abord le remboursement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս փոխանցման միջնորդավճարի համար վերադարձ է գրանցվել․ միջնորդավճարը հնարավոր չէ հեռացնել, վերադարձված գումարից փոքր դարձնել կամ փոխել դրա արժույթը։ Փոխանցումը նույնպես հնարավոր չէ ջնջել։ Նախ ջնջեք վերադարձը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già stato registrato un rimborso per la commissione di questo trasferimento: non puoi rimuoverla, ridurla sotto l'importo rimborsato o cambiarne la valuta, né eliminare il trasferimento. Elimina prima il rimborso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この振替の手数料に返金が記録されています。手数料の削除、返金額を下回る金額への変更、通貨の変更、および手数料を含む振替の削除はできません。先に返金を削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ გადარიცხვის საკომისიოზე დაბრუნება უკვე ჩაწერილია: საკომისიოს წაშლა, დაბრუნებულ თანხაზე მეტად შემცირება ან სხვა ვალუტაში გადატანა შეუძლებელია. მასთან ერთად ვერც გადარიცხვა წაიშლება. ჯერ დაბრუნება წაშალეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл аударымның комиссиясына қайтару жазылған: комиссияны алып тастауға, қайтарылғаннан кіші етуге немесе басқа валютаға көшіруге болмайды, және аударымды онымен бірге жою мүмкін емес. Алдымен қайтаруды жойыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이체의 수수료에 대해 환불이 기록되어 있습니다. 수수료를 제거하거나 환불액보다 적게 변경하거나 다른 통화로 바꿀 수 없으며, 이체도 삭제할 수 없습니다. 먼저 환불을 삭제하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул которуунун комиссиясы боюнча кайтарым жазылган: комиссияны алып салууга, кайтарылган суммадан азайтууга же валютасын өзгөртүүгө болбойт. Комиссиясы бар которууну да өчүрүүгө болбойт. Адегенде кайтарымды өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de kosten van deze overboeking is een terugbetaling geregistreerd. De kosten kunnen niet worden verwijderd, lager worden gemaakt dan de terugbetaling of naar een andere valuta worden gewijzigd. Ook kan de overboeking niet met de kosten worden verwijderd. Verwijder eerst de terugbetaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano zwrot opłaty za ten przelew. Nie można jej usunąć, zmniejszyć poniżej zwróconej kwoty ani zmienić jej waluty. Nie można też usunąć przelewu wraz z opłatą. Najpierw usuń zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um reembolso registrado para a tarifa desta transferência. A tarifa não pode ser removida, reduzida abaixo do valor reembolsado ou alterada para outra moeda, e a transferência não pode ser apagada enquanto a tarifa existir. Apague o reembolso primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi registado um reembolso da comissão desta transferência: não é possível remover a comissão, reduzi-la abaixo do valor reembolsado ou alterar a sua moeda, nem apagar a transferência com a comissão. Apague primeiro o reembolso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На комиссию этого перевода оформлен возврат: её нельзя убрать, сделать меньше возвращённого или перевести в другую валюту, а перевод — удалить вместе с ней. Сначала удалите возврат."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои комиссияи ин интиқол баргардонидани маблағ сабт шудааст: ҳазфи комиссия, кам кардани он аз маблағи баргардондашуда ё тағйири асъори он имкон надорад. Интиқолро ҳам бо он ҳазф кардан мумкин нест. Аввал баргардонидани маблағро ҳазф кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu transferin ücreti için bir iade kaydedildi: ücret kaldırılamaz, iade edilen tutarın altına düşürülemez veya para birimi değiştirilemez; transfer de ücretiyle birlikte silinemez. Önce iadeyi silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За комісію цього переказу записано повернення: її не можна зняти, зменшити нижче повернутої суми чи перенести в іншу валюту, і переказ разом із нею не видаляється. Спершу видаліть повернення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu o‘tkazma komissiyasi uchun qaytim qayd etilgan: komissiyani olib tashlab, qaytarilgan summadan kamaytirib yoki boshqa valyutaga o‘tkazib bo‘lmaydi. O‘tkazmani ham o‘chirib bo‘lmaydi. Avval qaytimni o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此转账的手续费已有退款，因此无法移除手续费、将其减至退款金额以下或更改其货币，也无法删除此转账。请先删除退款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此轉帳的手續費已有退款記錄：無法移除手續費、將其調低至退款金額以下或更改貨幣，也無法刪除此轉帳。請先刪除退款。"
          }
        }
      }
    },
    "transfer.refusal.fromCurrency": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vəsaitin çıxarıldığı hesabda bu valyuta yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку спісання няма гэтай валюты."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet, ze kterého peníze odcházejí, tuto měnu neobsahuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto, von dem das Geld abgeht, führt diese Währung nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account the money leaves does not hold this currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de la que sale el dinero no tiene esta divisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte d'où part l'argent ne détient pas cette devise."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ելքային հաշվում այս արժույթը չկա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto di origine non contiene questa valuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振替元の口座はこの通貨に対応していません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშს, საიდანაც თანხა გადის, ეს ვალუტა არ აქვს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша кететін есеп-шотта бұл валюта жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출금 계좌에 이 통화가 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча алынуучу эсепте бул валюта жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rekening waarvan het geld vertrekt, bevat deze valuta niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto źródłowe nie obsługuje tej waluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta de origem não aceita esta moeda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta de origem não tem esta moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт, откуда уходят деньги, не держит эту валюту."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби ирсолкунанда ин асъорро надорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranın çıktığı hesapta bu para birimi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок, з якого йдуть гроші, не має цієї валюти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul olinadigan hisobda bu valyuta yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转出账户不支持此货币。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉出帳戶不支援此貨幣。"
          }
        }
      }
    },
    "transfer.refusal.negativeFee": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya sıfırdan az ola bilməz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камісія не можа быць меншай за нуль."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poplatek nemůže být záporný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gebühr kann nicht unter null liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fee cannot be below zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión no puede ser menor que cero."
          }
        },
        "fr": {
