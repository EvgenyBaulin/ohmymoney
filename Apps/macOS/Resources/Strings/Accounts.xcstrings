    "bank.editor.newHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank comes with its first account and card, both called like it, in the default currency. The kind, the currencies and the balance of the account can be changed afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco llega con su primera cuenta y tarjeta, ambas con su nombre, en la divisa principal. El tipo, las divisas y el saldo de la cuenta se pueden cambiar después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque arrive avec son premier compte et sa carte, nommés comme elle, dans la devise par défaut. Le type, les devises et le solde du compte peuvent être modifiés ensuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с банком появятся первый счёт и карта с тем же названием, в валюте по умолчанию. Вид, валюты и остаток счёта можно поправить потом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк створюється з першим рахунком і карткою, які називаються так само, у валюті за замовчуванням. Тип, валюти й залишок рахунку можна змінити згодом."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca viene creata con un primo conto e una prima carta, entrambi con lo stesso nome e nella valuta predefinita. Il tipo, le valute e il saldo del conto possono essere modificati in seguito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк өзінің алғашқы есеп-шотымен және картасымен келеді, екеуі де банк атымен, әдепкі валютада. Есеп-шоттың түрін, валюталарын және теңгерімін кейін өзгертуге болады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ствараецца з першым рахункам і картай, абодва з яго назвай, у прадвызначанай валюце. Тып, валюты і баланс рахунку можна змяніць пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank kommt mit ihrem ersten Konto und ihrer ersten Karte, beide heißen wie sie, in der Standardwährung. Art, Währungen und Saldo des Kontos lassen sich danach ändern."
          }
        }
      }
    },
