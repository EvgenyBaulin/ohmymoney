    "account.interest.recordHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце выплату банка: сума тут прыблізная."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie ein, was die Bank ausgezahlt hat: Die Summe hier ist eine Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type what the bank paid: the sum here is an estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba lo que pagó el banco: la suma aquí es una estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ce que la banque a versé : la somme ici est une estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci l’importo pagato dalla banca: quello indicato è una stima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк төлегенін теріңіз: мұнда көрсетілген сома — болжам."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк төлөгөн сумманы киргизиңиз: бул жердеги сумма болжолдуу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kwotę wypłaconą przez bank. Podana tutaj kwota jest szacunkowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o valor pago pelo banco: o valor exibido é uma estimativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впишите, сколько заплатил банк: здесь сумма — оценка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи пардохткардаи бонкро ворид кунед: маблағи ин ҷо тахминӣ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankanın ödediği tutarı girin; buradaki tutar tahminidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть, скільки виплатив банк: сума тут є оцінкою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank to‘lagan summani kiriting: bu yerdagi summa taxminiy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入銀行實際支付的金額；此處顯示的是預估值。"
          }
        }
      }
    },
