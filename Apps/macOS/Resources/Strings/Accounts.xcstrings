    "transfer.sheet.feeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Written as an expense in «Fees» from the account the money left; it is deleted and undone with the transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Se anota como gasto en «Comisiones» desde la cuenta de la que salió el dinero; se elimina y se deshace junto con la transferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Noté comme dépense dans « Frais » depuis le compte d'où part l'argent ; il est supprimé et annulé avec le virement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Запишется расходом в «Комиссии» со счёта, откуда ушли деньги; удаляется и отменяется вместе с переводом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов'язково. Записується як витрата в «Комісіях» з рахунку, з якого пішли гроші; видаляється і скасовується разом із переказом."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativa. Registrata come uscita in «Commissioni» dal conto di origine; viene eliminata e annullata con il trasferimento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міндетті емес. Ақша кеткен есеп-шоттан «Комиссияларға» шығыс ретінде жазылады; аударыммен бірге жойылады және болдырылмайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Неабавязкова. Запісваецца як выдатак у «Камісіі» з рахунку спісання; выдаляецца і адмяняецца разам з пераводам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Wird als Ausgabe in „Gebühren“ vom Konto eingetragen, von dem das Geld abging; sie wird mit der Überweisung gelöscht und rückgängig gemacht."
          }
        }
      }
    },
