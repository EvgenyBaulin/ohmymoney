    "account.merge.emptyKeepsCount": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş — «%@» son qalığını saxlayacaq; digər hesabın keçmişi tarixçəyə keçəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуста — «%@» захавае апошні падлік; мінулае іншага рахунку стане гісторыяй."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdné — «%@» si ponechá poslední zůstatek; minulost druhého účtu se stane historií."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer — „%@“ behält ihren letzten Stand; die Vergangenheit des anderen Kontos wird zur Historie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty — «%@» keeps its latest count; the other account's past becomes history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía: «%@» conserva su último recuento; el pasado de la otra cuenta pasa al historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide — « %@ » garde son dernier relevé ; le passé de l'autre compte devient l'historique."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դատարկ՝ «%@» կպահի իր վերջին մնացորդը, իսկ մյուս հաշվի անցյալը կդառնա պատմություն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoto: «%@» mantiene l’ultima riconciliazione; il passato dell’altro conto rimane nello storico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の場合、«%@»の最新の実残高が保持され、もう一方の口座の過去の記録は履歴になります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცარიელია — «%@» შეინარჩუნებს ბოლოს დადასტურებულ ნაშთს; მეორე ანგარიშის წარსული ისტორიაში დარჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бос — «%@» соңғы санауын сақтайды; басқа есеп-шоттың өткені тарихқа айналады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 «%@»의 최근 실사 잔액이 유지되고 다른 계좌의 과거 내역은 기록으로 남습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бош — «%@» акыркы такталган калдыгын сактайт; башка эсептин өткөнү тарыхта калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeg — «%@» behoudt het laatst getelde saldo; het verleden van de andere rekening wordt geschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puste — «%@» zachowa ostatnio ustalone saldo; wcześniejsze operacje drugiego konta trafią do historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio — «%@» mantém seu último saldo registrado; o histórico da outra conta é preservado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio — «%@» mantém o saldo mais recente; o passado da outra conta fica no histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусто — «%@» останется со своей последней сверкой, прошлое второго счёта станет историей."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Холӣ — «%@» бақияи охирини худро нигоҳ медорад; гузаштаи суратҳисоби дигар дар таърих мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş bırakılırsa «%@» son sayımını korur; diğer hesabın geçmişi saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожній — «%@» зберігає свою останню звірку, минуле іншого рахунку стає історією."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo‘sh qoldirilsa, «%@» so‘nggi qoldig‘ini saqlaydi; boshqa hisobning o‘tmishi tarixda qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空 — «%@» 将保留最近核对的余额；另一个账户的过往记录将保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空時，«%@» 保留最近一次盤點的餘額；另一帳戶的過往記錄將保留。"
          }
        }
      }
    },
