          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartaning o‘z keshbek qoidalari ham o‘chiriladi. “Bekor qilish” hammasini tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片的專屬現金回饋規則也會一併刪除。使用「復原」可還原所有內容。"
          }
        }
      }
    },
