    "card.merge.cashback": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Keçmiş əməliyyatların gözlənilən keşbeki “%@” qaydalarına əsasən yenidən hesablanacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканы кэшбэк мінулых аперацый пералічыцца паводле правілаў “%@”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Očekávaný cashback minulých operací se znovu vypočítá podle pravidel karty „%@“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erwartete Cashback vergangener Vorgänge wird nach den Regeln von „%@“ neu berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expected cashback of past operations is worked out again by the rules of “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cashback previsto de las operaciones pasadas se vuelve a calcular con las reglas de «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback attendu des opérations passées est recalculé selon les règles de « %@ »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախորդ գործարքների սպասվող քեշբեքը վերահաշվարկվում է ըստ “%@” քարտի կանոնների։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cashback previsto delle operazioni passate viene ricalcolato secondo le regole di “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の取引の予定キャッシュバックは、“%@”のルールで再計算されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წარსული ოპერაციების მოსალოდნელი ქეშბექი „%@“-ის წესებით ხელახლა გამოითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен операциялардың күтілетін кешбэгі “%@” ережелері бойынша қайта есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 거래의 예상 캐시백을 “%@”의 규칙에 따라 다시 계산합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мурунку операциялардын күтүлгөн кэшбэги “%@” эрежелери боюнча кайра эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verwachte cashback van eerdere transacties wordt opnieuw berekend volgens de regels van ‘%@’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwany cashback z poprzednich operacji zostanie przeliczony według zasad karty „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback esperado das operações anteriores será recalculado pelas regras de “%@”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback previsto das operações anteriores é recalculado segundo as regras de “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемый кэшбэк прошлых операций пересчитается по правилам «%@»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешбэки пешбинишудаи амалиёти гузашта аз рӯи қоидаҳои “%@” аз нав ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş işlemlerin beklenen para iadesi, “%@” kurallarına göre yeniden hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний кешбек минулих операцій перераховується за правилами «%@»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan operatsiyalarning kutilayotgan keshbeki “%@” qoidalari bo‘yicha qayta hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去交易的预计返现将按“%@”的规则重新计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去交易的預期現金回饋會依「%@」的規則重新計算。"
          }
        }
      }
    },
