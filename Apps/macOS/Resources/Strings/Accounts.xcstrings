    "account.merge.mainMoves": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird das Hauptkonto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» becomes the main account"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» негізгі есеп-шот болады"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основным станет «%@»"
          }
        }
      }
    },
    "account.merge.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, Überweisungen, Zahlungen und Schuldeneinträge wandern zu „%1$@“, und „%2$@“ kommt mit Saldo null ins Archiv; sein Name wird ein weiterer Name von „%1$@“. ⌘Z holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations, transfers, payments and debt entries move to «%1$@», and «%2$@» goes to the archive with a zero balance; its name becomes another name of «%1$@». ⌘Z brings everything back."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар, аударымдар, төлемдер және берешек жазбалары «%1$@» есеп-шотына көшеді, ал «%2$@» нөлдік теңгерімімен мұрағатқа өтеді; оның атауы «%1$@» басқа атына айналады. ⌘Z бәрін қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции, переводы, платежи и записи долгов перейдут на «%1$@», а «%2$@» уйдёт в архив с нулевым остатком; его название станет другим названием «%1$@». ⌘Z вернёт всё как было."
          }
        }
      }
    },
    "account.merge.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, Überweisungen, Zahlungen und Schuldeneinträge wandern zu „%1$@“, und „%2$@“ kommt mit Saldo null ins Archiv; sein Name wird ein weiterer Name von „%1$@“. „Rückgängig“ holt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations, transfers, payments and debt entries move to «%1$@», and «%2$@» goes to the archive with a zero balance; its name becomes another name of «%1$@». “Undo” brings everything back."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар, аударымдар, төлемдер және берешек жазбалары «%1$@» есеп-шотына көшеді, ал «%2$@» нөлдік теңгерімімен мұрағатқа өтеді; оның атауы «%1$@» басқа атына айналады. «Болдырмау» бәрін қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции, переводы, платежи и записи долгов перейдут на «%1$@», а «%2$@» уйдёт в архив с нулевым остатком; его название станет другим названием «%1$@». «Отменить» вернёт всё как было."
          }
        }
      }
    },
    "account.merge.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ zusammenführen mit…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge «%@» with…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» мынамен біріктіру…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединить «%@» с…"
          }
        }
      }
    },
    "account.merge.transfers": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Überweisung zwischen den beiden Konten in einer Währung wird gelöscht"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Überweisungen zwischen den beiden Konten in einer Währung werden gelöscht"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transfer between the two accounts in one currency will be deleted"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transfers between the two accounts in one currency will be deleted"
                }
              }
            }
          }
        },
        "kk": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Екі есеп-шот арасындағы бір валютадағы %lld аударым жойылады"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Екі есеп-шот арасындағы бір валютадағы %lld аударым жойылады"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Будут удалены %lld перевода между этими счетами в одной валюте"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Будут удалены %lld переводов между этими счетами в одной валюте"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Будет удалён %lld перевод между этими счетами в одной валюте"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Будут удалены %lld перевода между этими счетами в одной валюте"
                }
              }
            }
          }
        }
      }
    },
    "account.merge.unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo unbekannt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "balance unknown"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "теңгерім белгісіз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "остаток неизвестен"
          }
        }
      }
    },
    "account.merge.unknownHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo dieser Währung lässt sich nicht berechnen. Tragen Sie ihn ein, wenn Sie ihn kennen, oder lassen Sie das Feld leer und gleichen später ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance of this currency cannot be worked out. Enter it if you know it, or leave it empty and reconcile later."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл валютаның теңгерімін есептеу мүмкін емес. Білсеңіз, енгізіңіз, әйтпесе бос қалдырып, кейін салыстырыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в этой валюте не посчитать. Введите его, если знаете, или оставьте пустым и сверьте позже."
          }
        }
      }
    },
    "account.refusal.balanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo des Kontos ist niemandem bekannt: Auf dem Konto wurde Geld bewegt, es wurde aber nie abgeglichen. Gleichen Sie es ab; bei null kann es ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance of the account: money moved on it, but it was never reconciled. Reconcile it; at zero it can go to the archive."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттың теңгерімі ешкімге белгісіз: онда ақша қозғалды, бірақ ешқашан салыстырылмаған. Салыстырыңыз; нөлде ол мұрағатқа өтуі мүмкін."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток счёта неизвестен: по нему были движения, но его ни разу не сверяли. Сверьте счёт — с нулём его можно убрать в архив."
          }
        }
      }
    },
    "account.refusal.bankHasLiveAccounts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat noch Konten außerhalb des Archivs: Verschieben Sie diese zuerst ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank still has accounts outside the archive: move them to the archive first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкте әлі мұрағатта жоқ есеп-шоттар бар: алдымен оларды мұрағатқа өткізіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка есть счета не в архиве — сначала уберите в архив их."
          }
        }
      }
    },
    "account.refusal.bankInUse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Bank stehen Konten, auch archivierte: Sie kann ins Archiv, nicht gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, archived ones too, are under the bank: it can go to the archive, not be deleted."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк астында есеп-шоттар бар, мұрағаттағылар да: ол мұрағатқа өтуі мүмкін, бірақ жойылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под банком есть счета, в том числе архивные: его можно убрать в архив, но не удалить."
          }
        }
      }
    },
    "account.refusal.bankNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank mit diesem Namen gibt es bereits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank with this name already exists."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен банк бұрыннан бар."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк с таким названием уже есть."
          }
        }
      }
    },
    "account.refusal.creditCardNeedsCard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte lässt sich nicht ohne Karte speichern. Geben Sie der Karte einen Namen, den noch nichts anderes hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card cannot be saved without a card. Give the card a name that nothing else has."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік картаны карта жоқ сақтау мүмкін емес. Картаға басқа ешкімде жоқ атау беріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитную карту нельзя сохранить без карты. Назовите карту так, как не называется ничего другого."
          }
        }
      }
    },
    "account.refusal.currencyBalanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo in %@ ist niemandem bekannt: Darin wurde Geld bewegt, es wurde aber nie abgeglichen. Gleichen Sie das Konto ab; bei null kann die Währung entfernt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance in %@: money moved in it, but it was never reconciled. Reconcile the account; at zero the currency can go."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ валютасындағы теңгерім ешкімге белгісіз: онда ақша қозғалды, бірақ ешқашан салыстырылмаған. Есеп-шотты салыстырыңыз; нөлде валюта жойылуы мүмкін."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в %@ неизвестен: движения были, но валюту ни разу не сверяли. Сверьте счёт — с нулём валюту можно убрать."
          }
        }
      }
    },
    "account.refusal.currencyNotEnabled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist in den Einstellungen unter „Währungen“ ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is switched off in Settings → Currencies."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ «Параметрлер → Валюталар» ішінде өшірулі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта %@ выключена в Настройках → Валюты."
          }
        }
      }
    },
    "account.refusal.deletesWithMoney": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Konto liegt Geld. Übertragen Sie den Saldo auf ein anderes Konto und archivieren Sie dieses oder gleichen Sie es auf null ab, ohne die Differenz zu erfassen, und löschen Sie es dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has money on it. Transfer the balance to another account and archive this one, or reconcile it to zero without recording the difference and then delete it."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шотта ақша бар. Теңгерімді басқа есеп-шотқа аударыңыз да, осы есеп-шотты мұрағатқа өткізіңіз; немесе айырманы жазбай нөлге дейін салыстырып, содан кейін жойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги. Переведите остаток на другой счёт и уберите этот в архив — или сверьте его до нуля без записи разницы, тогда его можно удалить."
          }
        }
      }
    },
    "account.refusal.duplicateCurrency": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Währung ist doppelt aufgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A currency is listed twice."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір валюта екі рет тізімделген."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта указана дважды."
          }
        }
      }
    },
    "account.refusal.emptyName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Namen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a name."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атауын беріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите название."
          }
        }
      }
    },
    "account.refusal.groupHasLiveAccounts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gruppe hat noch Konten außerhalb des Archivs: Verschieben Sie diese zuerst ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group still has accounts outside the archive: move them to the archive first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топта әлі мұрағатта жоқ есеп-шоттар бар: алдымен оларды мұрағатқа өткізіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе есть счета не в архиве — сначала уберите в архив их."
          }
        }
      }
    },
    "account.refusal.groupHoldsMain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto ist in dieser Gruppe, deshalb bleibt sie in der Übersicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is in this group, so it stays in the summary."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот осы топта, сондықтан ол қорытындыда қалады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе основной счёт, поэтому она остаётся в общей сводке."
          }
        }
      }
    },
    "account.refusal.groupInUse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Gruppe sind Konten abgelegt, auch archivierte: Sie kann ins Archiv, nicht gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, archived ones too, are filed under the group: it can go to the archive, not be deleted."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топ астында есеп-шоттар тізімделген, мұрағаттағылар да: ол мұрағатқа өтуі мүмкін, бірақ жойылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К группе отнесены счета, в том числе архивные: её можно убрать в архив, но не удалить."
          }
        }
      }
    },
    "account.refusal.groupNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe mit diesem Namen gibt es bereits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group with this name already exists."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен топ бұрыннан бар."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа с таким названием уже есть."
          }
        }
      }
    },
    "account.refusal.hasMoney": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Konto liegt Geld. Übertragen Sie den Saldo auf ein anderes Konto oder gleichen Sie es auf null ab und verschieben Sie es dann ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is money on the account. Transfer the balance to another account or reconcile it to zero, then move it to the archive."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотта ақша бар. Теңгерімді басқа есеп-шотқа аударыңыз немесе нөлге дейін салыстырыңыз, содан кейін мұрағатқа өткізіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги. Переведите остаток на другой счёт или сверьте счёт до нуля, а потом уберите в архив."
          }
        }
      }
    },
    "account.refusal.inArchive": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name ist im Archiv: Holen Sie jenes Konto zurück, statt ein zweites anzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name is in the archive: bring that one back instead of making a second one."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл атау мұрағатта бар: екінші есеп-шот жасаудың орнына сол есеп-шотты қайтарыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое название есть в архиве: верните его, а не заводите второе."
          }
        }
      }
    },
    "account.refusal.inUse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto wird verwendet — Vorgänge: %1$lld, Überweisungen: %2$lld, geplante Zahlungen: %3$lld, Schuldeneinträge: %4$lld. Es kann nicht gelöscht werden: Führen Sie es mit einem anderen Konto zusammen oder verschieben Sie es ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in use — operations: %1$lld, transfers: %2$lld, scheduled payments: %3$lld, debt entries: %4$lld. It cannot be deleted: merge it with another account or move it to the archive."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шот қолданыста — операциялар: %1$lld, аударымдар: %2$lld, жоспарланған төлемдер: %3$lld, берешек жазбалары: %4$lld. Оны жою мүмкін емес: басқа есеп-шотпен біріктіріңіз немесе мұрағатқа өткізіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт используется — операций: %1$lld, переводов: %2$lld, платежей: %3$lld, записей долгов: %4$lld. Удалить его нельзя: объедините с другим счётом или уберите в архив."
          }
        }
      }
    },
    "account.refusal.inUseAlsoPoints": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist außerdem das Punktekonto für den Cashback von %lld Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is also the points account of the cashback of %lld accounts."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол сонымен қатар %lld есеп-шоттың кешбэк ұпайларының есеп-шоты."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он же — счёт для баллов кэшбэка у счетов: %lld."
          }
        }
      }
    },
    "account.refusal.inUsePoints": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist das Punktekonto für den Cashback von %lld Konten. Es kann nicht gelöscht werden: Wählen Sie in deren „Cashback-Regeln…“ ein anderes Punktekonto, führen Sie es mit einem anderen Konto zusammen oder verschieben Sie es ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the points account of the cashback of %lld accounts. It cannot be deleted: choose another points account in their “Cashback rules…”, merge it with another account or move it to the archive."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол %lld есеп-шоттың кешбэк ұпайларының есеп-шоты. Оны жою мүмкін емес: олардың «Кешбэк ережелері…» бөлімінде басқа ұпайлар есеп-шотын таңдаңыз, басқа есеп-шотпен біріктіріңіз немесе мұрағатқа өткізіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это счёт для баллов кэшбэка у счетов: %lld. Удалить его нельзя: выберите другой счёт для баллов в их «Правилах кэшбэка…», объедините его с другим счётом или уберите в архив."
          }
        }
      }
    },
    "account.refusal.lastLiveAccount": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist das letzte Konto und kann nicht ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the last account and cannot go to the archive."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл соңғы есеп-шот, мұрағатқа өткізілмейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это последний счёт — в архив его не убрать."
          }
        }
      }
    },
    "account.refusal.mainInExcludedGroup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto kann nicht in einer Gruppe stehen, die aus der Übersicht herausgenommen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be in a group left out of the summary."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот қорытындыдан шығарылған топта бола алмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не может быть в группе вне общей сводки."
          }
        }
      }
    },
    "account.refusal.nameTaken": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konto mit diesem Namen gibt es bereits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with this name already exists."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен есеп-шот бұрыннан бар."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт с таким названием уже есть."
          }
        }
      }
    },
    "account.refusal.nameTakenByCard": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte heißt „%@“ — wählen Sie einen anderen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card is called “%@” — choose another name."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” деп аталған карта бар — басқа атау таңдаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так называется карта «%@» — выберите другое название."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка має назву «%@» — виберіть іншу."
          }
        }
      }
    },
    "account.refusal.needsNewMain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie zuerst das Konto, das Hauptkonto wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account that becomes main first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдымен негізгі болатын есеп-шотты таңдаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите счёт, который станет основным."
          }
        }
      }
    },
    "account.refusal.noCurrency": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie mindestens eine Währung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose at least one currency."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кем дегенде бір валюта таңдаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите хотя бы одну валюту."
          }
        }
      }
    },
    "account.refusal.noSuccessor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein anderes Konto in der Übersicht kann Hauptkonto werden. Legen Sie zuerst ein Konto an oder nehmen Sie eines in die Übersicht auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other account in the summary can become main. Add an account or bring one into the summary first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы басқа есеп-шот негізгі бола алмайды. Алдымен есеп-шот қосыңыз немесе қорытындыға бірін енгізіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основным стать некому: нужен другой счёт в общей сводке. Сначала добавьте счёт или включите его группу в сводку."
          }
        }
      }
    },
    "account.refusal.notFound": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht mehr vorhanden — vielleicht wurde es gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not there any more — it may have been deleted."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол енді жоқ — жойылған болуы мүмкін."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого больше нет — возможно, уже удалено."
          }
        }
      }
    },
    "account.refusal.otherBank": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammengeführt werden nur Konten einer Bank. Um zwei Banken zusammenzuführen, führen Sie zuerst die Banken in den Einstellungen unter „Konten“ zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only accounts of one bank are merged. To bring two banks together, merge the banks first in Settings → Accounts."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек бір банктің есеп-шоттары біріктіріледі. Екі банкті біріктіру үшін алдымен «Параметрлер → Есеп-шоттар» бөлімінде банктерді біріктіріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяются только счета одного банка. Чтобы свести два банка вместе, сначала объедините банки в «Настройки → Счета»."
          }
        }
      }
    },
    "account.refusal.otherNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits ein Name eines anderen Kontos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» is already a name of another account."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» басқа есеп-шоттың атауы болып тұр."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — уже название другого счёта."
          }
        }
      }
    },
    "account.refusal.removesCurrencyWithMoney": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Konto liegt Geld in %@: Die Währung bleibt, bis ihr Saldo null ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is money in %@ on this account: the currency stays until its balance is zero."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шотта %@ валютасында ақша бар: теңгерім нөлге тең болғанша валюта қалады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги в %@: валюта останется, пока её остаток не станет нулём."
          }
        }
      }
