          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřte zůstatky účtů a zobrazí se zde jejich součet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichen Sie die Konten einmal ab, dann erscheint hier ihre Summe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile the accounts once, and their total appears here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie las cuentas una vez y aquí aparecerá su total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez les comptes une fois, et leur total apparaît ici."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համադրեք հաշիվները, և դրանց ընդհանուր գումարը կհայտնվի այստեղ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconcilia i conti per visualizzare qui il totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座の残高を確認すると、ここに合計が表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთხელ შეაჯერეთ ანგარიშები და მათი ჯამი აქ გამოჩნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттарды бір рет салыстырыңыз — сонда олардың жиыны осында көрінеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌 잔액을 확인하면 여기에 합계가 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептерди бир жолу тактаңыз, алардын жалпы суммасы бул жерде көрүнөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de rekeningen eenmaal om het totaal hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź saldo kont, aby zobaczyć tutaj ich sumę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie as contas uma vez para que o total apareça aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcilie as contas uma vez para ver aqui o total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверьте счета один раз — и здесь появится их сумма."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобҳоро як бор мувофиқа кунед, то маблағи умумии онҳо дар ин ҷо пайдо шавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplarla mutabakat yapıldığında toplamları burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звірте рахунки один раз, і тут з'явиться їхній підсумок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblar qoldig‘ini bir marta tekshiring, shunda jami summa shu yerda ko‘rinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对账户进行一次对账后，总额会显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對帳後，帳戶總額便會顯示於此。"
          }
        }
      }
    },
