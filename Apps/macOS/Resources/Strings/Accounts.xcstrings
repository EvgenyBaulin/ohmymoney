    "cashback.sheet.expectationHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected cashback is only an expectation, never income. Record what you receive as income in the cashback category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cashback previsto es solo una expectativa, nunca un ingreso. Registre lo que reciba como ingreso en la categoría de cashback."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback attendu n'est qu'une attente, jamais un revenu. Notez ce que vous recevez comme revenu dans la catégorie cashback."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемый кэшбэк — только ожидание, не доход. Полученный записывайте доходом в категории кэшбэка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний кешбек — це лише очікування, а не дохід. Записуйте те, що ви отримали, як дохід у категорії кешбеку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cashback previsto è solo una stima, mai un'entrata. Registra ciò che ricevi come entrata nella categoria cashback."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтілетін кешбэк — тек күту, табыс емес. Алғанды кешбэк санатында табыс ретінде жазыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканы кэшбэк — толькі чаканне, а не даход. Запішыце атрыманае як даход у катэгорыі кэшбэку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erwartete Cashback ist nur eine Erwartung, nie Einnahme. Erfassen Sie, was Sie erhalten, als Einnahme in der Kategorie Cashback."
          }
        }
      }
    },
    "cashback.sheet.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A month rule beats an “always” rule, and a subcategory beats its category; “Everything else” applies when nothing else does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla de mes gana a una regla «siempre», y una subcategoría gana a su categoría; «Todo lo demás» se aplica cuando nada más se aplica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle de mois l'emporte sur une règle « toujours », et une sous-catégorie sur sa catégorie ; « Tout le reste » s'applique quand rien d'autre ne s'applique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило месяца важнее правила «всегда», подкатегория — важнее категории; «Всё остальное» — когда ничего не подошло."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило на місяць важить більше за правило «завжди», а підкатегорія — більше за категорію; «Усе інше» діє, коли нічого іншого немає."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola mensile prevale su una regola «Sempre» e una sottocategoria prevale sulla sua categoria; «Tutto il resto» si applica quando non valgono altre regole."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай ережесі “әрқашан” ережесінен басым, ал ішкі санат — өз санатынан; “Қалғанның бәрі” басқа ешбір ереже болмаған жағдайда қолданылады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правіла месяца мае перавагу над “заўсёды”, а падкатэгорыя — над катэгорыяй; “Усё астатняе” дзейнічае, калі іншае не падыходзіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel für einen Monat schlägt eine Regel „immer“, und eine Unterkategorie schlägt ihre Kategorie; „Alles Übrige“ gilt, wenn nichts anderes zutrifft."
          }
        }
      }
    },
