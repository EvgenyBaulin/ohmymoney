              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Будуць выдалены %lld пераводаў паміж двума рахункамі ў адной валюце"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Будзе выдалены %lld перавод паміж двума рахункамі ў адной валюце"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Будзе выдалена %lld пераводу паміж двума рахункамі ў адной валюце"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Überweisung zwischen den beiden Konten in einer Währung wird gelöscht"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Überweisungen zwischen den beiden Konten in einer Währung werden gelöscht"
                }
              }
            }
          }
        }
      }
    },
    "account.merge.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "balance unknown"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "saldo desconocido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "solde inconnu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "остаток неизвестен"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "залишок невідомий"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "saldo sconosciuto"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "теңгерім белгісіз"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "баланс невядомы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo unbekannt"
          }
        }
      }
    },
    "account.merge.unknownHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance of this currency cannot be worked out. Enter it if you know it, or leave it empty and reconcile later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de esta divisa no se puede calcular. Introdúzcalo si lo conoce, o déjelo vacío y concilie más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde de cette devise ne peut pas être calculé. Saisissez-le si vous le connaissez, ou laissez vide et rapprochez plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в этой валюте не посчитать. Введите его, если знаете, или оставьте пустым и сверьте позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок цієї валюти не можна розрахувати. Введіть його, якщо знаєте, або залиште порожнім і звірте пізніше."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile calcolare il saldo di questa valuta. Inseriscilo se lo conosci oppure lascia il campo vuoto e riconcilia più tardi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл валютаның теңгерімін есептеу мүмкін емес. Білсеңіз, енгізіңіз, әйтпесе бос қалдырып, кейін салыстырыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга вылічыць баланс гэтай валюты. Увядзіце яго, калі ведаеце, або пакіньце пустым і зверце пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo dieser Währung lässt sich nicht berechnen. Tragen Sie ihn ein, wenn Sie ihn kennen, oder lassen Sie das Feld leer und gleichen später ab."
          }
        }
      }
    },
    "account.refusal.balanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance of the account: money moved on it, but it was never reconciled. Reconcile it; at zero it can go to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie conoce el saldo de la cuenta: se movió dinero en ella, pero nunca se conció. Concíliela; con saldo cero puede pasar al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne connaît le solde du compte : de l'argent y a bougé, mais il n'a jamais été rapproché. Rapprochez-le ; à zéro, il peut aller aux archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток счёта неизвестен: по нему были движения, но его ни разу не сверяли. Сверьте счёт — с нулём его можно убрать в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок рахунку ніхто не знає: кошти на ньому рухалися, але його ніколи не звіряли. Звірте його; з нульовим залишком він може піти в архів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo del conto è sconosciuto: ci sono stati movimenti, ma non è mai stato riconciliato. Riconcilialo; se il saldo è zero, puoi archiviarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттың теңгерімі ешкімге белгісіз: онда ақша қозғалды, бірақ ешқашан салыстырылмаған. Салыстырыңыз; нөлде ол мұрағатқа өтуі мүмкін."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс рахунку невядомы: на ім быў рух грошай, але ён ніколі не звяраўся. Зверце яго; пры нулявым балансе можна архіваваць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo des Kontos ist niemandem bekannt: Auf dem Konto wurde Geld bewegt, es wurde aber nie abgeglichen. Gleichen Sie es ab; bei null kann es ins Archiv."
          }
        }
      }
    },
    "account.refusal.bankHasLiveAccounts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank still has accounts outside the archive: move them to the archive first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco aún tiene cuentas fuera del archivo: pásalas antes al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque a encore des comptes hors des archives : mettez-les d'abord aux archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка есть счета не в архиве — сначала уберите в архив их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У банку ще є рахунки поза архівом: спершу перенесіть їх в архів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca ha ancora conti non archiviati: archiviali prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкте әлі мұрағатта жоқ есеп-шоттар бар: алдымен оларды мұрағатқа өткізіңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У банка яшчэ ёсць рахункі па-за архівам: спачатку архівуйце іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat noch Konten außerhalb des Archivs: Verschieben Sie diese zuerst ins Archiv."
          }
        }
      }
    },
    "account.refusal.bankInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, archived ones too, are under the bank: it can go to the archive, not be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cuentas, también archivadas, bajo el banco: puede pasar al archivo, pero no eliminarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des comptes, même archivés, sont rattachés à la banque : elle peut aller aux archives, mais non être supprimée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под банком есть счета, в том числе архивные: его можно убрать в архив, но не удалить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під банком є рахунки, в тому числі архівні: він може піти в архів, але не видалитися."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca contiene conti, anche archiviati: puoi archiviarla, ma non eliminarla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк астында есеп-шоттар бар, мұрағаттағылар да: ол мұрағатқа өтуі мүмкін, бірақ жойылмайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да банка адносяцца рахункі, у тым ліку архіўныя: яго можна архіваваць, але не выдаліць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Bank stehen Konten, auch archivierte: Sie kann ins Archiv, nicht gelöscht werden."
          }
        }
      }
    },
    "account.refusal.bankNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank with this name already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un banco con este nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une banque portant ce nom existe déjà."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк с таким названием уже есть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк із такою назвою вже є."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già una banca con questo nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен банк бұрыннан бар."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк з такой назвай ужо ёсць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank mit diesem Namen gibt es bereits."
          }
        }
      }
    },
    "account.refusal.creditCardNeedsCard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card cannot be saved without a card. Give the card a name that nothing else has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito no se puede guardar sin tarjeta. Dé a la tarjeta un nombre que no use nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit ne peut pas être enregistrée sans carte. Donnez à la carte un nom qu'aucune autre n'a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитную карту нельзя сохранить без карты. Назовите карту так, как не называется ничего другого."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитну картку не можна зберегти без картки. Дайте картці назву, якої ні в кого немає."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi salvare una carta di credito senza una carta. Assegna alla carta un nome non ancora utilizzato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік картаны карта жоқ сақтау мүмкін емес. Картаға басқа ешкімде жоқ атау беріңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крэдытны рахунак нельга захаваць без карты. Дайце карце ўнікальную назву."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte lässt sich nicht ohne Karte speichern. Geben Sie der Karte einen Namen, den noch nichts anderes hat."
          }
        }
      }
    },
    "account.refusal.currencyBalanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance in %@: money moved in it, but it was never reconciled. Reconcile the account; at zero the currency can go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie conoce el saldo en %@: se movió dinero en ella, pero nunca se conció. Concilie la cuenta; con saldo cero la divisa puede quitarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne connaît le solde en %@ : de l'argent y a bougé, mais il n'a jamais été rapproché. Rapprochez le compte ; à zéro, la devise peut partir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в %@ неизвестен: движения были, но валюту ни разу не сверяли. Сверьте счёт — с нулём валюту можно убрать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок у %@ ніхто не знає: кошти в ній рухалися, але їх ніколи не звіряли. Звірте рахунок; з нульовим залишком валюту можна прибрати."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo in %@ è sconosciuto: ci sono stati movimenti, ma non è mai stato riconciliato. Riconcilia il conto; se il saldo è zero, puoi rimuovere la valuta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ валютасындағы теңгерім ешкімге белгісіз: онда ақша қозғалды, бірақ ешқашан салыстырылмаған. Есеп-шотты салыстырыңыз; нөлде валюта жойылуы мүмкін."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс у %@ невядомы: быў рух грошай, але зверак не было. Зверце рахунак; пры нулявым балансе валюту можна прыбраць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo in %@ ist niemandem bekannt: Darin wurde Geld bewegt, es wurde aber nie abgeglichen. Gleichen Sie das Konto ab; bei null kann die Währung entfernt werden."
          }
        }
      }
    },
    "account.refusal.currencyNotEnabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is switched off in Settings → Currencies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desactivada en Ajustes → Divisas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est désactivée dans Réglages → Devises."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта %@ выключена в Настройках → Валюты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вимкнено в «Налаштування → Валюти»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è disattivata in Impostazioni → Valute."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ «Параметрлер → Валюталар» ішінде өшірулі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выключана ў Наладах → Валюты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist in den Einstellungen unter „Währungen“ ausgeschaltet."
          }
        }
      }
    },
    "account.refusal.deletesWithMoney": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has money on it. Transfer the balance to another account and archive this one, or reconcile it to zero without recording the difference and then delete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta cuenta hay dinero. Transfiera el saldo a otra cuenta y archive esta, o concíliela a cero sin registrar la diferencia y después elimínela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a de l'argent sur ce compte. Virez le solde sur un autre compte et archivez celui-ci, ou rapprochez-le à zéro sans noter l'écart, puis supprimez-le."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёте есть деньги. Переведите остаток на другой счёт и уберите этот в архив — или сверьте его до нуля без записи разницы, тогда его можно удалить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку є гроші. Перекажіть залишок на інший рахунок і перенесіть цей в архів або звірте його з нульовим залишком без запису різниці, а потім видаліть."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo conto contiene denaro. Trasferisci il saldo su un altro conto e archivia questo, oppure riconcilialo a zero senza registrare la differenza, poi eliminalo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл есеп-шотта ақша бар. Теңгерімді басқа есеп-шотқа аударыңыз да, осы есеп-шотты мұрағатқа өткізіңіз; немесе айырманы жазбай нөлге дейін салыстырып, содан кейін жойыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку ёсць грошы. Перавядзіце рэшту на іншы рахунак і архівуйце гэты, або зверце яго да нуля без запісу розніцы і тады выдаліце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Konto liegt Geld. Übertragen Sie den Saldo auf ein anderes Konto und archivieren Sie dieses oder gleichen Sie es auf null ab, ohne die Differenz zu erfassen, und löschen Sie es dann."
          }
        }
      }
    },
    "account.refusal.duplicateCurrency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A currency is listed twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una divisa aparece dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une devise figure deux fois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта указана дважды."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одну валюту вказано двічі."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valuta compare due volte."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір валюта екі рет тізімделген."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта пазначана двойчы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Währung ist doppelt aufgeführt."
          }
        }
      }
    },
    "account.refusal.emptyName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponga un nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez-lui un nom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите название."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте назву."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атауын беріңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце назву."
          }
        },
        "de": {
