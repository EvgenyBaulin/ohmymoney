          "stringUnit": {
            "state": "translated",
            "value": "Դրանք այլ տեղ չեն օգտագործվում։ ⌘Z-ը կվերականգնի դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento vi fa riferimento. Premi ⌘Z per ripristinarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照している項目はありません。⌘Zで元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მათ არაფერი უკავშირდება. ⌘Z აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оларға ештеңе сілтемейді. ⌘Z оларды қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이를 참조하는 항목이 없습니다. ⌘Z로 복원할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аларга эч нерсе байланышкан эмес. ⌘Z аларды калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt nergens naar verwezen. Met ⌘Z zet je deze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się do nich nie odwołuje. ⌘Z przywróci je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada faz referência a elas. ⌘Z as restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada faz referência a estes elementos. Prima ⌘Z para os recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На них ничто не ссылается. ⌘Z вернёт их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳеҷ чиз ба онҳо ишора намекунад. ⌘Z онҳоро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlara bağlı öğe yok. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо на них не посилається. ⌘Z поверне їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ularga hech narsa bog‘lanmagan. ⌘Z ularni qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有项目引用它们。按 ⌘Z 可将其恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有項目參照這些帳戶。按下 ⌘Z 可還原。"
          }
        }
      }
    },
    "accounts.delete.messageMany.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlara heç nə bağlı deyil. “Geri al” ilə bərpa etmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нішто на іх не спасылаецца. “Адмяніць” адновіць іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na ně neodkazuje. Pomocí „Zpět“ je obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist auf sie. „Rückgängig“ holt sie zurück."
