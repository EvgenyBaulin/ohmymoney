        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ереже қосу"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить правило"
          }
        }
      }
    },
    "cashback.sheet.always": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
