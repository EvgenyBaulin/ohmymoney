    "account.interest.endsOn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endet am"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жабылады"
