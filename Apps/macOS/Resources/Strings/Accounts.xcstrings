    "transfer.sheet.receivedHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both amounts as the bank shows them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos importes tal como los muestra el banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux montants tels que la banque les affiche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обе суммы — как в выписке банка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидві суми так, як їх показує банк."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi gli importi come indicati dalla banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екі сома да банк көрсеткендей."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Абедзве сумы, як іх паказвае банк."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Beträge so, wie die Bank sie anzeigt."
          }
        }
      }
    },
    "transfer.sheet.sameAmount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same amount arrives: a cut the bank takes is the fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega el mismo importe: el descuento que cobra el banco es la comisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même montant arrive : la retenue prise par la banque est le frais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачисляется столько же: то, что удержал банк, — комиссия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Та сама сума приходить: відрахування, яке бере банк, — це комісія."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo ricevuto è lo stesso: ciò che la banca trattiene è la commissione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірдей сома келеді: банк ұстап алған үлес — комиссия."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паступае тая ж сума: утрыманае банкам — камісія."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Betrag kommt an: Ein Abzug, den die Bank nimmt, ist die Gebühr."
          }
        }
      }
    },
