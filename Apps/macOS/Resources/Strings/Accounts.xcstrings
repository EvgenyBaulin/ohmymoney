    "bank.editor.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankın adını dəyişmək hesab və kartların adını dəyişmir: daxiletmə sətrində onlar öz adları ilə qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змена назвы банка не змяняе назвы яго рахункаў і карт: радок уводу па-ранейшаму ведае іх па ўласных назвах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejmenováním banky se její účty ani karty nepřejmenují. Při zadávání je nadále najdete pod jejich vlastními názvy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie die Bank umbenennen, werden ihre Konten und Karten nicht umbenannt: Die Eingabezeile kennt sie weiterhin unter ihren eigenen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming the bank does not rename its accounts and cards: the entry line still knows them by their own names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cambia el nombre del banco, sus cuentas y tarjetas no cambian de nombre: la línea de entrada las sigue reconociendo por sus propios nombres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renommer la banque ne renomme pas ses comptes et cartes : la ligne de saisie les reconnaît toujours par leur propre nom."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկի անունը փոխելիս հաշիվների և քարտերի անունները չեն փոխվում. մուտքագրման տողում դրանք շարունակում են ճանաչվել իրենց անուններով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinominare la banca non cambia i nomi dei suoi conti e delle sue carte: la riga di inserimento continua a riconoscerli con i propri nomi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行名を変更しても口座やカードの名前は変わりません。入力欄ではそれぞれの名前で指定できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკისთვის სახელის შეცვლა მის ანგარიშებსა და ბარათებს სახელებს არ შეუცვლის: შეყვანის ველში ისინი კვლავ საკუთარი სახელებით იძებნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкті қайта атағанда оның есеп-шоттары мен карталары атауы өзгермейді: енгізу жолы оларды әлі өз атымен таниды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 이름을 변경해도 계좌와 카드 이름은 변경되지 않습니다. 입력란에서는 각각의 이름으로 계속 찾을 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын атын өзгөртүү анын эсептери менен карталарынын аттарын өзгөртпөйт: киргизүү сабы аларды өз аттары менен тааныйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de bank hernoemt, behouden de rekeningen en kaarten hun naam. Je kunt ze nog steeds onder hun eigen naam invoeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana nazwy banku nie zmienia nazw jego kont i kart. W polu wpisywania nadal rozpoznawane są ich własne nazwy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomear o banco não altera o nome das contas e dos cartões: eles continuam identificados pelos próprios nomes no campo de lançamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o nome do banco não altera o nome das contas e dos cartões: pode continuar a encontrá-los pelos respetivos nomes na linha de introdução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименование банка не переименовывает его счета и карты: строка ввода по-прежнему знает их по их названиям."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйири номи бонк номи суратҳисобҳо ва кортҳои онро тағйир намедиҳад: сатри воридкунӣ онҳоро бо номҳои худашон мешиносад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankanın adını değiştirmek hesap ve kartlarının adını değiştirmez; giriş satırında bunlar kendi adlarıyla tanınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейменування банку не перейменовує його рахунки й картки: рядок введення знає їх за їхніми власними назвами."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank nomini o‘zgartirish uning hisob va kartalari nomini o‘zgartirmaydi: kiritish qatorida ular o‘z nomi bilan topiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改银行名称不会更改其账户和卡的名称；输入时仍使用各自的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改銀行名稱不會更改其帳戶和卡片的名稱；輸入欄仍會使用它們各自的名稱。"
          }
        }
      }
    },
    "bank.editor.name": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
