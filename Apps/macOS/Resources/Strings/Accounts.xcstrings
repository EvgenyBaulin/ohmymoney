    "card.refusal.inUse": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kart əməliyyatlarda və ya ödənişlərdə istifadə olunur — yalnız arxivlənə bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта пазначана ў аперацыях ці плацяжах — яе можна толькі архіваваць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu používají operace nebo platby, proto ji lze jen archivovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge oder Zahlungen nennen diese Karte — sie kann nur archiviert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations or payments name this card — it can only be archived."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Operaciones o pagos citan esta tarjeta: solo puede archivarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des opérations ou paiements portent ce nom de carte — elle ne peut qu'être archivée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս քարտը նշված է գործարքներում կամ վճարումներում․ այն կարելի է միայն արխիվացնել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La carta è associata a operazioni o pagamenti: puoi solo archiviarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードを使用する取引または支払いがあるため、アーカイブのみできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ბარათი მითითებულია ოპერაციებში ან გადახდებში — შესაძლებელია მხოლოდ მისი არქივში გადატანა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар немесе төлемдер бұл картаны көрсетеді — оны тек мұрағатқа өткізуге болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카드가 지정된 거래 또는 결제가 있어 보관만 할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул карта операцияларда же төлөмдөрдө колдонулат — аны архивге гана которууга болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze kaart wordt gebruikt bij transacties of betalingen en kan alleen worden gearchiveerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje lub płatności odwołują się do tej karty — można ją tylko zarchiwizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há operações ou pagamentos associados a este cartão. Ele só pode ser arquivado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cartão é usado em operações ou pagamentos — só pode ser arquivado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По карте есть операции или платежи — её можно только убрать в архив."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин корт дар амалиёт ё пардохтҳо истифода шудааст — онро танҳо бойгонӣ кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kart işlemlerde veya ödemelerde kullanılıyor; yalnızca arşivlenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції або платежі називають цю картку — її можна лише перенести в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu karta operatsiya yoki to‘lovlarda ko‘rsatilgan — uni faqat arxivlash mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有交易或付款使用此卡片，只能将其归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有交易或付款使用此卡片，只能封存。"
          }
        }
      }
    },
    "card.refusal.lastCardOfCreditCard": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kredit hesabının yeganə kartıdır. Kredit hesabı kartsız qala bilməz. Əvvəlcə başqa kart əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта адзіная карта крэдытнага рахунку, які не можа застацца без карты. Спачатку дадайце іншую."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je jediná karta kreditního účtu, který musí mít vždy alespoň jednu kartu. Nejprve přidejte další."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die einzige Karte einer Kreditkarte, und eine Kreditkarte bleibt nie ohne Karte. Fügen Sie zuerst eine andere Karte hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the only card of a credit card, and a credit card is never left without one. Add another card first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la única tarjeta de una tarjeta de crédito, y una tarjeta de crédito nunca se queda sin ninguna. Añada antes otra tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la seule carte d'une carte de crédit, et une carte de crédit n'est jamais sans carte. Ajoutez d'abord une autre carte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա վարկային հաշվի միակ քարտն է․ վարկային հաշիվը չի կարող առանց քարտի մնալ։ Նախ ավելացրեք ևս մեկ քարտ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è l’unica carta associata alla carta di credito, che deve averne sempre almeno una. Aggiungine prima un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはクレジットカード口座の唯一のカードです。カードが必要なため、先に別のカードを追加してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს საკრედიტო ანგარიშის ერთადერთი ბარათია. ჯერ დაამატეთ სხვა ბარათი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кредиттік картаның жалғыз картасы, ал кредиттік картада карта болмай қалмайды. Алдымен басқа карта қосыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신용카드 계좌의 유일한 카드입니다. 먼저 다른 카드를 추가하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул кредиттик эсептин жалгыз картасы. Адегенде башка карта кошуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de enige kaart van de creditcardrekening. Voeg eerst een andere kaart toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jedyna karta tego konta kredytowego. Konto kredytowe musi mieć co najmniej jedną kartę. Najpierw dodaj kolejną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o único cartão da conta de crédito, que não pode ficar sem cartão. Adicione outro cartão primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o único cartão da conta de crédito, que não pode ficar sem cartão. Adicione outro primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это единственная карта кредитной карты, а без карты она не остаётся. Сначала добавьте другую карту."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ягона корти ҳисоби кредитӣ аст; ҳисоб бе корт монда наметавонад. Аввал корти дигар илова кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kredi hesabının tek kartı. Kredi hesabı kartsız bırakılamaz. Önce başka bir kart ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це єдина картка кредитного рахунку, а кредитний рахунок ніколи не лишається без картки. Спершу додайте ще одну картку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredit hisobining yagona kartasi. Kredit hisobi kartasiz qolishi mumkin emas. Avval boshqa karta qo‘shing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是此信用卡账户的唯一卡片，信用卡账户必须至少有一张卡片。请先添加另一张卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是信用卡帳戶的唯一卡片，無法刪除。請先加入另一張卡片。"
          }
        }
      }
    },
