    "transfer.refusal.notPositive": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце суму большую за нуль."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Betrag über null ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an amount above zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba un importe mayor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un montant supérieur à zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un importo superiore a zero."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөлден жоғары сома енгізіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөлдөн чоң сумма киргизиңиз."
          }
        },
        "pl": {
          "stringUnit": {
