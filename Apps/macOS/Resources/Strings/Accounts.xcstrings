    "transfer.sheet.receivedHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər iki məbləğ bankda göstərildiyi kimi."
          }
        },
        "be": {
