    "account.credit.grace.statement": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrechnung jeden Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Statement every month"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр ай сайын үзінді"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выписка каждый месяц"
          }
        }
      }
    },
    "account.credit.graceLost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zinsfreie Frist ist verloren: Zahlen Sie die ganze Schuld, %@, dann hören die Zinsen auf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grace period is lost: pay the whole debt, %@, and interest stops"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейінге қалдыру кезеңі жойылды: бүкіл берешекті төлеңіз, %@, пайыз тоқтайды"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Льготный период потерян: внесите весь долг %@, и проценты перестанут начисляться"
          }
        }
      }
    },
    "account.credit.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte ist ein Konto, dessen Saldo unter null fällt; sie ist keine Schuld. Alle Bedingungen stehen in %@. Zinsen werden als Schätzung angezeigt, bis Sie sie aus der Abrechnung erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is an account whose balance goes below zero; it is not a debt. Every term is in %@. Interest is shown as an estimate until you record it from the statement."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта — теңгерімі нөлден төмен болатын есеп-шот; ол берешек емес. Барлық шарттар: %@ валютасында. Пайыз үзіндіден жазылғанша болжам ретінде көрсетіледі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитная карта — это счёт, остаток которого уходит в минус, а не долг. Все условия — в %@. Проценты видны как оценка, пока вы не запишете их по выписке."
          }
        }
