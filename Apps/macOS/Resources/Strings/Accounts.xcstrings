    "account.credit.notCounted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconcile the account — without a balance there are no statements to work out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concilie la cuenta: sin saldo no hay extractos que calcular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez le compte — sans solde, il n'y a pas de relevés à calculer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверьте счёт — без остатка выписки не посчитать"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звіріть рахунок — без залишку немає виписок для розрахунку"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconcilia il conto: senza un saldo non è possibile calcolare gli estratti conto"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотты салыстырыңыз — теңгерімсіз үзінділерді есептеу мүмкін емес"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверце рахунак — без балансу нельга разлічыць выпіскі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichen Sie das Konto ab — ohne Saldo gibt es keine Abrechnungen zu berechnen"
          }
        }
      }
    },
    "account.credit.offHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on for a card with a credit limit: the screen of the account will say what to pay by when not to pay interest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívelo para una tarjeta con límite de crédito: la pantalla de la cuenta indicará hasta cuándo pagar para no pagar intereses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le pour une carte avec un plafond de crédit : l'écran du compte indiquera jusqu'à quand payer pour ne pas payer d'intérêts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите для карты с кредитным лимитом: экран счёта подскажет, сколько и до какого дня внести, чтобы не платить проценты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть для картки з кредитним лімітом: екран рахунку скаже, що і до якого дня сплатити, щоб не платити відсотків."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva per una carta con limite di credito: la schermata del conto indicherà quanto e quando pagare per evitare interessi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредит лимиті бар карта үшін қосыңыз: есеп-шот экраны қашан және не төлеу керектігін, пайыз төленбеуі үшін көрсетеді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце для карты з крэдытным лімітам: на экране рахунку будзе бачна, колькі і калі заплаціць, каб пазбегнуць працэнтаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie es für eine Karte mit Kreditlimit ein: Der Bildschirm des Kontos zeigt dann, bis wann gezahlt werden muss, um keine Zinsen zu zahlen."
          }
        }
      }
    },
