    "account.refusal.mainInExcludedGroup": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas hesab xülasəyə daxil edilməyən qrupda ola bilməz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак не можа быць у групе па-за зводкай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní účet nemůže být ve skupině vynechané z přehledu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto kann nicht in einer Gruppe stehen, die aus der Übersicht herausgenommen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be in a group left out of the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal no puede estar en un grupo fuera del resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal ne peut pas se trouver dans un groupe exclu du récapitulatif."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնական հաշիվը չի կարող լինել ամփոփագրից դուրս մնացած խմբում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale non può trovarsi in un gruppo escluso dal riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイン口座を集計から除外されたグループに入れることはできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავარი ანგარიში ვერ იქნება ჯგუფში, რომელიც მიმოხილვაში არ შედის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот қорытындыдан шығарылған топта бола алмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 계좌는 요약에서 제외된 그룹에 둘 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги эсеп жыйынтыкка кирбеген топто боло албайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoofdrekening kan niet in een groep staan die buiten het overzicht valt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto główne nie może należeć do grupy wyłączonej z podsumowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal não pode estar em um grupo excluído do resumo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal não pode estar num grupo excluído do resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не может быть в группе вне общей сводки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисоби асосӣ дар гурӯҳе, ки аз ҷамъбаст хориҷ шудааст, буда наметавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana hesap, özete dahil edilmeyen bir grupta olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок не може бути в групі, яку вилучено з підсумку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy hisob umumiy ko‘rinishdan chiqarilgan guruhda bo‘lishi mumkin emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主账户不能位于未计入汇总的分组中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要帳戶不能位於不納入摘要的群組中。"
          }
        }
      }
    },
