    "account.screen.cashbackApproximate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate income: ≈ %1$@, of it by the rules and unconfirmed — %2$@. Nothing to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingreso aproximado: ≈ %1$@, de ello por reglas y sin confirmar — %2$@. Nada que confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenu approximatif : ≈ %1$@, dont selon les règles et non confirmé — %2$@. Rien à confirmer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерный доход: ≈ %1$@, из них по правилам, без подтверждения, — %2$@. Подтверждать не нужно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орієнтовний дохід: ≈ %1$@, з них за правилами й не підтверджено — %2$@. Нічого підтверджувати не потрібно."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrate stimate: ≈ %1$@, di cui calcolate secondo le regole e non confermate: %2$@. Nulla da confermare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шамамен табыс: ≈ %1$@, оның ережелер бойынша және расталмаған бөлігі — %2$@. Растайтын ештеңе жоқ."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прыблізны даход: ≈ %1$@, з яго па правілах і без пацвярджэння — %2$@. Няма чаго пацвярджаць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefähre Einnahmen: ≈ %1$@, davon nach den Regeln und unbestätigt — %2$@. Nichts zu bestätigen."
          }
        }
      }
    },
