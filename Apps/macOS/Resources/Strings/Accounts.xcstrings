    "transfer.fee.fromArchive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee goes to «%@», which comes back from the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión va a «%@», que vuelve del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais vont sur « %@ », qui revient des archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия пойдёт в «%@» — она вернётся из архива."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія йде на «%@», який повертається з архіву."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La commissione viene assegnata a «%@», che viene ripristinato dall'archivio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия мұрағаттан қайтатын «%@» есеп-шотына түседі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камісія трапіць у «%@», што адновіцца з архіва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gebühr geht auf „%@“, das aus dem Archiv zurückkommt."
          }
        }
      }
    },
