    "bank.forgotten.mayCharge": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank xidmət haqqı tuta bilər"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк можа браць плату за абслугоўванне"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka může účtovat poplatek za vedení"
          }
