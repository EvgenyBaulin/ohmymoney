    "account.refusal.creditCardNeedsCard": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit kartını kartsız saxlamaq olmaz. Karta təkrarlanmayan ad verin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крэдытны рахунак нельга захаваць без карты. Дайце карце ўнікальную назву."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditní účet nelze uložit bez karty. Zadejte kartě jedinečný název."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte lässt sich nicht ohne Karte speichern. Geben Sie der Karte einen Namen, den noch nichts anderes hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card cannot be saved without a card. Give the card a name that nothing else has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito no se puede guardar sin tarjeta. Dé a la tarjeta un nombre que no use nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit ne peut pas être enregistrée sans carte. Donnez à la carte un nom qu'aucune autre n'a."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վարկային քարտը հնարավոր չէ պահել առանց քարտի։ Տվեք քարտին եզակի անուն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi salvare una carta di credito senza una carta. Assegna alla carta un nome non ancora utilizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットカードを保存するにはカードが必要です。他で使われていない名前をカードに付けてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკრედიტო ანგარიშის შენახვა ბარათის გარეშე შეუძლებელია. ბარათს უნიკალური სახელი მიანიჭეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік картаны карта жоқ сақтау мүмкін емес. Картаға басқа ешкімде жоқ атау беріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신용카드 계좌를 저장하려면 카드가 필요합니다. 다른 항목과 겹치지 않는 카드 이름을 입력하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттик картаны картасыз сактоого болбойт. Картага кайталангыс ат бериңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een creditcard kan niet zonder kaart worden bewaard. Geef de kaart een unieke naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać konta karty kredytowej bez karty. Nadaj karcie niepowtarzalną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta de cartão de crédito precisa ter um cartão. Dê ao cartão um nome que ainda não esteja em uso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível guardar uma conta de crédito sem um cartão. Dê ao cartão um nome único."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитную карту нельзя сохранить без карты. Назовите карту так, как не называется ничего другого."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Корти кредитиро бе корт нигоҳ доштан мумкин нест. Ба корт номи такрорнашаванда диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi kartı, kart olmadan kaydedilemez. Karta benzersiz bir ad verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитну картку не можна зберегти без картки. Дайте картці назву, якої ні в кого немає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit hisobini kartasiz saqlab bo‘lmaydi. Kartaga takrorlanmas nom bering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡账户必须关联一张卡才能保存。请为卡取一个不重复的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡帳戶必須有卡片才能儲存。請為卡片輸入不重複的名稱。"
          }
        }
      }
    },
    "account.refusal.currencyBalanceUnknown": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ balansı məlum deyil: bu valyutada pul hərəkəti olub, amma balans heç vaxt yoxlanılmayıb. Hesabı yoxlayın; balans sıfır olduqda valyutanı silmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс у %@ невядомы: быў рух грошай, але зверак не было. Зверце рахунак; пры нулявым балансе валюту можна прыбраць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek v měně %@ není známý: proběhly v ní pohyby, ale zůstatek nebyl nikdy upraven. Upravte zůstatek účtu; při nulovém zůstatku lze měnu odebrat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo in %@ ist niemandem bekannt: Darin wurde Geld bewegt, es wurde aber nie abgeglichen. Gleichen Sie das Konto ab; bei null kann die Währung entfernt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows the balance in %@: money moved in it, but it was never reconciled. Reconcile the account; at zero the currency can go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie conoce el saldo en %@: se movió dinero en ella, pero nunca se conció. Concilie la cuenta; con saldo cero la divisa puede quitarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne connaît le solde en %@ : de l'argent y a bougé, mais il n'a jamais été rapproché. Rapprochez le compte ; à zéro, la devise peut partir."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ արժույթով մնացորդն անհայտ է․ այս արժույթով շարժ է եղել, բայց մնացորդը երբեք չի ճշգրտվել։ Ճշգրտեք հաշիվը․ զրոյական մնացորդի դեպքում արժույթը կարելի է հեռացնել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo in %@ è sconosciuto: ci sono stati movimenti, ma non è mai stato riconciliato. Riconcilia il conto; se il saldo è zero, puoi rimuovere la valuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@では入出金がありましたが、残高が照合されていないため不明です。口座の残高を照合してください。ゼロになれば通貨を削除できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ვალუტაში ნაშთი უცნობია: თანხა მოძრაობდა, მაგრამ ნაშთი არასოდეს შეჯერებულა. შეაჯერეთ ანგარიში; ნულოვანი ნაშთისას ვალუტის წაშლა შესაძლებელი იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ валютасындағы теңгерім ешкімге белгісіз: онда ақша қозғалды, бірақ ешқашан салыстырылмаған. Есеп-шотты салыстырыңыз; нөлде валюта жойылуы мүмкін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 거래가 있었지만 잔액을 맞춘 적이 없어 잔액을 알 수 없습니다. 계좌 잔액을 맞춘 후 0이 되면 해당 통화를 제거할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ боюнча акча кыймылы болгон, бирок калдык эч качан такталган эмес. Эсептин калдыгын тактаңыз; нөл болсо, валютаны алып салса болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo in %@ is onbekend: er zijn transacties geweest, maar het saldo is nooit gecontroleerd. Controleer de rekening; bij een nulsaldo kan de valuta worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo w walucie %@ jest nieznane: były w niej operacje, ale nigdy nie uzgodniono salda. Uzgodnij saldo konta. Gdy wyniesie zero, walutę będzie można usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo em %@ é desconhecido: houve movimentações nessa moeda, mas a conta nunca foi conciliada. Concilie a conta; com saldo zero, a moeda pode ser removida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo em %@ é desconhecido: houve movimentos nesta moeda, mas nunca foi reconciliada. Reconcilie a conta; com saldo zero, pode remover a moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в %@ неизвестен: движения были, но валюту ни разу не сверяли. Сверьте счёт — с нулём валюту можно убрать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақия бо %@ номаълум аст: бо ин асъор гардиши пул буд, аммо бақияаш ҳеҷ гоҳ муқоиса нашудааст. Бақияи суратҳисобро муқоиса кунед; агар сифр бошад, асъорро хориҷ кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyesi bilinmiyor: bu para biriminde hareket var ancak hiç mutabakat yapılmamış. Hesapta mutabakat yapın; bakiye sıfırken para birimi kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок у %@ ніхто не знає: кошти в ній рухалися, але їх ніколи не звіряли. Звірте рахунок; з нульовим залишком валюту можна прибрати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qoldig‘i noma’lum: bu valyutada pul harakati bo‘lgan, lekin qoldiq hech qachon solishtirilmagan. Hisobni solishtiring; qoldiq nol bo‘lsa, valyutani olib tashlash mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 余额未知：此币种有资金变动，但从未核对余额。请先核对账户；余额为零时可移除此币种。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 餘額未知：此貨幣有資金往來，但從未對帳。請先為帳戶對帳，餘額為零時即可移除此貨幣。"
          }
        }
      }
    },
    "account.refusal.currencyNotEnabled": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Parametrlər → Valyutalar bölməsində söndürülüb."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выключана ў Наладах → Валюты."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je vypnutá v Nastavení → Měny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist in den Einstellungen unter „Währungen“ ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is switched off in Settings → Currencies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desactivada en Ajustes → Divisas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est désactivée dans Réglages → Devises."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ն անջատված է Կարգավորումներ → Արժույթներ բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è disattivata in Impostazioni → Valute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は「設定」→「通貨」でオフになっています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ გამორთულია განყოფილებაში პარამეტრები → ვალუტები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ «Параметрлер → Валюталар» ішінде өшірулі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 통화에서 %@이(가) 꺼져 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Жөндөөлөр → Валюталар бөлүмүндө өчүрүлгөн."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is uitgeschakeld in Instellingen → Valuta's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waluta %@ jest wyłączona w Ustawienia → Waluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desativada em Ajustes → Moedas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desativada em Definições → Moedas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта %@ выключена в Настройках → Валюты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ дар Танзимот → Асъорҳо хомӯш аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Ayarlar → Para Birimleri bölümünde kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вимкнено в «Налаштування → Валюти»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sozlamalar → Valyutalar bo‘limida o‘chirilgan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在“设置 → 币种”中关闭。"
          }
        },
        "zh-Hant": {
