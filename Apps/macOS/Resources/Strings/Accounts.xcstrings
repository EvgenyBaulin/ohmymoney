          }
        }
      }
    },
    "transfer.refusal.amountsDiffer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one currency the same amount arrives as leaves; write what the bank kept as the fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una misma divisa, llega el mismo importe que sale; escriba lo que se quedó el banco como comisión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В одной валюте зачисляется столько же, сколько списано; то, что удержал банк, запишите комиссией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В одній валюті на іншу сторону приходить та сама сума; запишіть, що банк утримав, як комісію."
          }
        }
      }
    },
    "transfer.refusal.archived": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is in the archive: bring it back to transfer to or from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta está en el archivo: recupérela para transferir desde ella o hacia ella."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт в архиве — верните его, чтобы переводить на него или с него."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок в архіві: поверніть його, щоб переказувати на нього або з нього."
          }
        }
      }
    },
    "transfer.refusal.feeMoneyBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money was already given back for this transfer's fee: its amount and currency can't change, and it can't be taken off. Delete that money back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se devolvió dinero por la comisión de esta transferencia: su importe y divisa no pueden cambiar, y no puede quitarse. Primero elimine esa devolución."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За комиссию этого перевода уже вернули деньги: её сумму и валюту не изменить, а саму комиссию не убрать. Сначала удалите этот возврат денег."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За комісію цього переказу вже повернуто гроші: її суму й валюту не можна змінити, і її не можна зняти. Спершу видаліть це повернення."
          }
        }
      }
    },
    "transfer.refusal.feeRefunded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund was recorded against this transfer's fee: the fee can't be taken off, made smaller than what was refunded or moved to another currency, and the transfer can't be deleted with it. Delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una devolución registrada sobre la comisión de esta transferencia: la comisión no puede quitarse, reducirse por debajo de lo devuelto ni pasar a otra divisa, y la transferencia no puede eliminarse con ella. Elimine antes la devolución."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На комиссию этого перевода оформлен возврат: её нельзя убрать, сделать меньше возвращённого или перевести в другую валюту, а перевод — удалить вместе с ней. Сначала удалите возврат."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За комісію цього переказу записано повернення: її не можна зняти, зменшити нижче повернутої суми чи перенести в іншу валюту, і переказ разом із нею не видаляється. Спершу видаліть повернення."
          }
        }
      }
    },
    "transfer.refusal.fromCurrency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account the money leaves does not hold this currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
