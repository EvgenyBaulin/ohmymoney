    "bank.editor.newHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank comes with its first account and card, both called like it, in the default currency. The kind, the currencies and the balance of the account can be changed afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco llega con su primera cuenta y tarjeta, ambas con su nombre, en la divisa principal. El tipo, las divisas y el saldo de la cuenta se pueden cambiar después."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с банком появятся первый счёт и карта с тем же названием, в валюте по умолчанию. Вид, валюты и остаток счёта можно поправить потом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк створюється з першим рахунком і карткою, які називаються так само, у валюті за замовчуванням. Тип, валюти й залишок рахунку можна змінити згодом."
          }
        }
      }
    },
