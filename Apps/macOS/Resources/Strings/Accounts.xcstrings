    "account.merge.emptyKeepsCount": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуста — «%@» захавае апошні падлік; мінулае іншага рахунку стане гісторыяй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer — „%@“ behält ihren letzten Stand; die Vergangenheit des anderen Kontos wird zur Historie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty — «%@» keeps its latest count; the other account's past becomes history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía: «%@» conserva su último recuento; el pasado de la otra cuenta pasa al historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide — « %@ » garde son dernier relevé ; le passé de l'autre compte devient l'historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoto: «%@» mantiene l’ultima riconciliazione; il passato dell’altro conto rimane nello storico."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бос — «%@» соңғы санауын сақтайды; басқа есеп-шоттың өткені тарихқа айналады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бош — «%@» акыркы такталган калдыгын сактайт; башка эсептин өткөнү тарыхта калат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puste — «%@» zachowa ostatnio ustalone saldo; wcześniejsze operacje drugiego konta trafią do historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio — «%@» mantém seu último saldo registrado; o histórico da outra conta é preservado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусто — «%@» останется со своей последней сверкой, прошлое второго счёта станет историей."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Холӣ — «%@» бақияи охирини худро нигоҳ медорад; гузаштаи суратҳисоби дигар дар таърих мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş bırakılırsa «%@» son sayımını korur; diğer hesabın geçmişi saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожній — «%@» зберігає свою останню звірку, минуле іншого рахунку стає історією."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo‘sh qoldirilsa, «%@» so‘nggi qoldig‘ini saqlaydi; boshqa hisobning o‘tmishi tarixda qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空時，«%@» 保留最近一次盤點的餘額；另一帳戶的過往記錄將保留。"
          }
        }
      }
    },
