    "account.mainCard.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A purchase on the account is made with this card unless the entry names another card or says «from account»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra de la cuenta se hace con esta tarjeta, salvo que el apunte indique otra tarjeta o diga «desde la cuenta»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un achat sur le compte se fait avec cette carte, sauf si la saisie nomme une autre carte ou indique « depuis le compte »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка по счёту записывается с этой карты, если в записи не названа другая карта или «со счёта»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка з рахунку оформлюється цією карткою, якщо запис не називає іншу картку або не каже «з рахунку»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti sul conto vengono effettuati con questa carta, a meno che la voce non indichi un’altra carta o «dal conto»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттан жасалған сатып алу осы картамен жасалады, енгізуде басқа карта аталмаса немесе «есеп-шоттан» делінбесе."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакупка з рахунку аплачваецца гэтай картай, калі ва ўводзе не пазначана іншая карта ці «з рахунку»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf auf dem Konto wird mit dieser Karte getätigt, sofern der Eintrag keine andere Karte nennt oder „von Konto“ sagt."
          }
        }
      }
    },
