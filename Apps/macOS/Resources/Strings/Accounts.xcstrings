        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үзінді көшірмені сақтау мүмкін болмады. Қайталап көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명세서를 저장할 수 없습니다. 다시 시도하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көчүрмө сакталган жок. Кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het afschrift kon niet worden bewaard. Probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zachować wyciągu. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a fatura. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o extrato. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить выписку. Повторите попытку."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Суратҳисобро нигоҳ доштан нашуд. Бори дигар кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstre kaydedilemedi. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти виписку. Спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘chirmani saqlab bo‘lmadi. Qayta urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存账单。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存帳單。請再試一次。"
          }
        }
      }
    },
