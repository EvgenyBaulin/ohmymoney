        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул топто эсептер жок. “Артка кайтаруу” аны калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen rekeningen in deze groep. Met “Herstel” zet je deze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma w niej żadnych kont. „Cofnij” przywróci ją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há contas neste grupo. “Desfazer” o restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há contas neste grupo. Use “Desfazer” para o recuperar."
