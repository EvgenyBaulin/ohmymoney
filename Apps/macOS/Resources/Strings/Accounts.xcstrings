          "stringUnit": {
            "state": "translated",
            "value": "The minimum payment does not read: a percent up to 100 and an amount not below zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимальный платёж не читается: процент до 100 и сумма не меньше нуля."
