    "accounts.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нішто на яго не спасылаецца. ⌘Z адновіць яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist darauf. ⌘Z holt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada hace referencia a ella. ⌘Z la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'y réfère. ⌘Z le rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento vi fa riferimento. Premi ⌘Z per ripristinarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған ештеңе сілтемейді. ⌘Z қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ага эч нерсе байланышкан эмес. ⌘Z аны калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się do niego nie odwołuje. ⌘Z przywróci je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada faz referência a ela. ⌘Z a restaura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На него ничто не ссылается. ⌘Z вернёт его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buna bağlı bir öğe yok. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо на нього не посилається. ⌘Z поверне його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Unga hech narsa bog‘lanmagan. ⌘Z uni qaytaradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有項目參照此帳戶。按下 ⌘Z 可還原。"
          }
        }
      }
    },
    "accounts.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нішто на яго не спасылаецца. “Адмяніць” адновіць яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist darauf. „Rückgängig“ holt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it. “Undo” brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada hace referencia a ella. «Deshacer» la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'y réfère. « Annuler » le rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento vi fa riferimento. Tocca “Annulla” per ripristinarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған ештеңе сілтемейді. «Болдырмау» қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ага эч нерсе байланышкан эмес. “Артка кайтаруу” аны калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się do niego nie odwołuje. „Cofnij” przywróci je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada faz referência a ela. “Desfazer” a restaura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На него ничто не ссылается. «Отменить» вернёт его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buna bağlı bir öğe yok. “Geri Al” ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо на нього не посилається. «Скасувати» поверне його."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Unga hech narsa bog‘lanmagan. “Bekor qilish” uni qaytaradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有項目參照此帳戶。使用「復原」可還原。"
          }
        }
      }
    },
