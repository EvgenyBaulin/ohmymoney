    "accounts.deleteBank.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account is under it. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cuenta bajo él. ⌘Z lo devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte n'y est rattaché. ⌘Z la rétablit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под ним нет ни одного счёта. ⌘Z вернёт его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під ним немає жодного рахунку. ⌘Z поверне його."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non contiene conti. Premi ⌘Z per ripristinarla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Астында ешбір есеп-шот жоқ. ⌘Z қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У ім няма рахункаў. ⌘Z адновіць яго."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darunter steht kein Konto. ⌘Z holt sie zurück."
          }
        }
      }
    },
