    "archived.leftover.leg.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %1$@ — a transfer of %2$@ from «%3$@» back to «%4$@», to cover what is typed ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$@ — una transferencia de %2$@ de «%3$@» a «%4$@», para cubrir lo que se introdujo por adelantado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — перевод %2$@ с «%3$@» обратно на «%4$@», чтобы покрыть записанное вперёд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — переказ %2$@ з «%3$@» назад на «%4$@», щоб покрити введене наперед."
          }
        }
      }
    },
    "archived.leftover.leg.back.and": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And on %1$@ — a transfer of %2$@ from «%3$@» back to «%4$@», to cover what is typed ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y el %1$@ — una transferencia de %2$@ de «%3$@» a «%4$@», para cubrir lo que se introdujo por adelantado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И %1$@ — перевод %2$@ с «%3$@» обратно на «%4$@», чтобы покрыть записанное вперёд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "А також %1$@ — переказ %2$@ з «%3$@» назад на «%4$@», щоб покрити введене наперед."
          }
        }
      }
    },
    "archived.leftover.leg.earlier": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %1$@ — a transfer of %2$@ from «%3$@» to «%4$@», right after the last money that moved on the archived account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$@ — una transferencia de %2$@ de «%3$@» a «%4$@», justo después del último movimiento de la cuenta archivada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — перевод %2$@ с «%3$@» на «%4$@», сразу после последнего движения денег по счёту в архиве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — переказ %2$@ з «%3$@» на «%4$@», одразу після останніх грошей, що рухалися на архівному рахунку."
          }
        }
      }
    },
    "archived.leftover.leg.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %1$@ — a transfer of %2$@ from «%3$@» to «%4$@», for the money typed ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
