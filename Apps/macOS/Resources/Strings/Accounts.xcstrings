        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli interessi di questo estratto conto sono nel cestino: ripristinali da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この明細の利息はゴミ箱にあります。ゴミ箱から戻してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ამონაწერის პროცენტი სანაგვეშია — აღადგინეთ იქიდან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл үзіндінің пайызы себетте — оны сол жерден қайтарыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 명세서의 이자가 휴지통에 있습니다. 휴지통에서 복원하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул көчүрмөнүн пайызы таштандыда — аны ошол жерден калыбына келтириңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rente van dit afschrift staat in de prullenmand. Zet deze eerst terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsetki z tego wyciągu są w koszu — przywróć je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros desta fatura estão na lixeira. Restaure-os para continuar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros deste extrato estão no Lixo — restaure-os a partir daí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты этой выписки лежат в корзине — верните их оттуда."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоизи ин суратҳисоб дар сабад аст — онро аз он ҷо барқарор кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekstrenin faizi çöp kutusunda. Oradan geri getirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки цієї виписки в кошику — поверніть їх звідти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ko‘chirmaning foizi savatda — uni u yerdan tiklang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账单的利息在废纸篓中，请先恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳單的利息位於垃圾桶中，請先將其還原。"
          }
        }
      }
    },
