    "account.group.inSummaryHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switched off, the money of the group stays out of «Total» and the free sum and is shown apart; its income and spending still count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado, el dinero del grupo queda fuera de «Total» y de la suma libre y se muestra aparte; sus ingresos y gastos siguen contando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, l'argent du groupe reste hors de « Total » et de la somme libre et s'affiche à part ; ses revenus et dépenses comptent toujours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить, деньги группы не входят во «Всего» и в свободную сумму и показываются отдельно; её доходы и траты учитываются как раньше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнені, кошти групи не входять до «Усього» і вільної суми та показуються окремо; її доходи й витрати все одно враховуються."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, il denaro del gruppo è escluso da «Totale» e dall’importo disponibile e viene mostrato a parte. Le entrate e le spese restano incluse."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өшірулі болса, топтың ақшасы «Барлығына» және бос қаржыға кірмейді, бөлек көрсетіледі; оның табысы мен шығысы әлі есептеледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі выключана, грошы групы не ўваходзяць ва «Усяго» і свабодную суму ды паказваюцца асобна; яе даходы і выдаткі ўлічваюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet bleibt das Geld der Gruppe aus „Gesamt“ und dem freien Betrag heraus und wird separat angezeigt; ihre Einnahmen und Ausgaben zählen weiterhin."
          }
        }
      }
    },
