    "account.editor.hiddenHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq örtülü olduqda gizli hesab siyahılarda görünmür. Vəsaiti ümumi məbləğə daxildir və «bir hissəsi gizlidir» göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Схаваны рахунак не паказваецца ў спісах, пакуль праграма ў рэжыме прыватнасці. Яго грошы ўлічваюцца ў выніках з пазнакай «частка схавана»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrytý účet se při zakryté aplikaci nezobrazuje v seznamech. Jeho peníze se stále započítávají do součtů, které jsou označené «část skryta»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgeblendetes Konto steht nicht in den Listen, solange die App verdeckt ist. Die Summen enthalten sein Geld weiterhin und zeigen „teilweise ausgeblendet“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden account is not in the lists while the app is covered. The totals still hold its money and say «part hidden»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta oculta no aparece en las listas mientras la app está tapada. Los totales siguen teniendo su dinero y dicen «parte oculta»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte masqué n'apparaît pas dans les listes tant que l'app est couverte. Les totaux comptent toujours son argent et indiquent « partie masquée »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածը ծածկված լինելու դեպքում թաքցված հաշիվը ցանկերում չի երևում։ Գումարը ներառվում է ընդհանուրի մեջ՝ «մասը թաքցված է» նշումով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto nascosto non compare negli elenchi quando l’app è protetta. Il suo saldo è incluso nei totali, indicati come «parte nascosta»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを覆っている間、非表示の口座はリストに表示されません。残高は合計に含まれ、「一部非表示」と表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაფარულ აპში დამალული ანგარიში სიებში არ ჩანს. მისი თანხა ჯამში შედის და ნაჩვენებია „ნაწილი დამალულია“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасырын есеп-шот экран жабылған кезде тізімдерде болмайды. Жиындар оның ақшасын әлі санайды және «бөлігі жасырын» деп көрсетеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 가려져 있는 동안 숨긴 계좌는 목록에 표시되지 않습니다. 합계에는 숨긴 계좌의 금액이 포함되며 «일부 숨김»이 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмо корголуп турганда жашырылган эсеп тизмелерде көрүнбөйт. Анын каражаты жалпы суммага кошулуп, «бир бөлүгү жашырылган» деп көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verborgen rekening staat niet in de lijsten zolang de app is afgeschermd. Het saldo telt wel mee in de totalen, met de aanduiding ‘deels verborgen’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte konto nie jest widoczne na listach, gdy aplikacja jest zasłonięta. Jego środki są nadal uwzględniane w sumach, które są oznaczone jako «częściowo ukryte»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta oculta não aparece nas listas enquanto o app está protegido. Os totais ainda incluem seu dinheiro e mostram «parte oculta»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta oculta não aparece nas listas quando a app está protegida. O seu saldo continua incluído nos totais, que indicam «parte oculta»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытого счёта нет в списках, пока приложение закрыто. Итоги считают и его деньги и пишут «часть скрыта»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вақте барнома пӯшида аст, ҳисоби пинҳон дар рӯйхатҳо нишон дода намешавад. Маблағи он дар ҷамъбаст мемонад ва «қисман пинҳон» нишон дода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama örtülüyken gizli hesap listelerde görünmez. Bakiyesi toplamlara dahil edilir ve «kısmen gizli» gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прихований рахунок не відображається в списках, поки дані застосунку приховано. Підсумки враховують його гроші з позначкою «частину приховано»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova himoyalanganda yashirin hisob ro‘yxatlarda ko‘rinmaydi. Uning mablag‘i umumiy summaga kiritiladi va «qisman yashirilgan» deb ko‘rsatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用处于遮挡状态时，隐藏账户不会显示在列表中。总额仍包含其资金，并显示「部分隐藏」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 處於遮蔽狀態時，隱藏的帳戶不會顯示在列表中。總額仍包含其金額，並顯示「部分隱藏」。"
          }
        }
      }
    },
