{
  "sourceLanguage": "en",
  "strings": {
    "account.editor.hidden": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta oculta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte masqué"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытый счёт"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прихований рахунок"
          }
        }
      }
    },
    "account.editor.hiddenHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden account is not in the lists while the app is covered. The totals still hold its money and say «part hidden»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta oculta no aparece en las listas mientras la app está tapada. Los totales siguen teniendo su dinero y dicen «parte oculta»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte masqué n'apparaît pas dans les listes tant que l'app est couverte. Les totaux comptent toujours son argent et indiquent « partie masquée »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытого счёта нет в списках, пока приложение закрыто. Итоги считают и его деньги и пишут «часть скрыта»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прихований рахунок не відображається в списках, поки дані застосунку приховано. Підсумки враховують його гроші з позначкою «частину приховано»."
          }
        }
      }
    },
