    "privacy.readOnly.banner": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız oxuma: heç nə dəyişdirilə bilməz"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі чытанне: змены немагчымыя"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen pro čtení: nic nelze měnit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ansehen: Nichts kann geändert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only: nothing can be changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura: no se puede cambiar nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule : rien ne peut être modifié"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն դիտում․ փոփոխություններն անհասանելի են"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sola lettura: non puoi apportare modifiche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用：変更できません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ კითხვა: შეცვლა შეუძლებელია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек оқу: ештеңені өзгертуге болмайды"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용: 변경할 수 없음"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Окуу гана: өзгөртүү мүмкүн эмес"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen lezen: er kan niets worden gewijzigd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko do odczytu: nie można wprowadzać zmian"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente leitura: nada pode ser alterado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só de leitura: não é possível fazer alterações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр: ничего нельзя изменить"
