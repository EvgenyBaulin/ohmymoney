    "privacy.readOnly.banner": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only: nothing can be changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura: no se puede cambiar nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule : rien ne peut être modifié"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр: ничего нельзя изменить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише перегляд: нічого не можна змінити"
          }
        }
      }
    },
