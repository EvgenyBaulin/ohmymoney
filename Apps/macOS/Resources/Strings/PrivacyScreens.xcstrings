        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо барои хондан: тағйир додан мумкин нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur: hiçbir şey değiştirilemez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише перегляд: нічого не можна змінити"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat o‘qish: o‘zgartirish kiritib bo‘lmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
