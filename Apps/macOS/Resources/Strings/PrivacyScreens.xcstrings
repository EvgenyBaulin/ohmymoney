    "privacy.readOnly.banner": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі чытанне: змены немагчымыя"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ansehen: Nichts kann geändert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only: nothing can be changed"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек оқу: ештеңені өзгертуге болмайды"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр: ничего нельзя изменить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише перегляд: нічого не можна змінити"
          }
        }
      }
    },
