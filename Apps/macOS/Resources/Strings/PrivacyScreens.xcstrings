{
  "sourceLanguage": "en",
  "strings": {
    "account.editor.hidden": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытый счёт"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прихований рахунок"
          }
        }
      }
    },
    "account.editor.hiddenHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden account is not in the lists while the app is covered. The totals still hold its money and say «part hidden»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытого счёта нет в списках, пока приложение закрыто. Итоги считают и его деньги и пишут «часть скрыта»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прихований рахунок не відображається в списках, поки дані застосунку приховано. Підсумки враховують його гроші з позначкою «частину приховано»."
          }
        }
      }
    },
    "privacy.hidden.hide": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховати"
          }
        }
      }
    },
