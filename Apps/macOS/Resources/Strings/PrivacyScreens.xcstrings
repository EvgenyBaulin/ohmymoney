{
  "sourceLanguage": "en",
  "strings": {
    "account.editor.hidden": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Схаваны рахунак"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendetes Konto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden account"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасырын есеп-шот"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытый счёт"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прихований рахунок"
          }
        }
      }
    },
    "account.editor.hiddenHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Схаваны рахунак не паказваецца ў спісах, пакуль праграма ў рэжыме прыватнасці. Яго грошы ўлічваюцца ў выніках з пазнакай «частка схавана»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgeblendetes Konto steht nicht in den Listen, solange die App verdeckt ist. Die Summen enthalten sein Geld weiterhin und zeigen „teilweise ausgeblendet“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden account is not in the lists while the app is covered. The totals still hold its money and say «part hidden»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасырын есеп-шот экран жабылған кезде тізімдерде болмайды. Жиындар оның ақшасын әлі санайды және «бөлігі жасырын» деп көрсетеді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытого счёта нет в списках, пока приложение закрыто. Итоги считают и его деньги и пишут «часть скрыта»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прихований рахунок не відображається в списках, поки дані застосунку приховано. Підсумки враховують його гроші з позначкою «частину приховано»."
          }
        }
      }
    },
