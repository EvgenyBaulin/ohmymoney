    "privacy.readOnly.banner": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі чытанне: змены немагчымыя"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ansehen: Nichts kann geändert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only: nothing can be changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura: no se puede cambiar nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule : rien ne peut être modifié"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sola lettura: non puoi apportare modifiche"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек оқу: ештеңені өзгертуге болмайды"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko do odczytu: nie można wprowadzać zmian"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente leitura: nada pode ser alterado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр: ничего нельзя изменить"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur: hiçbir şey değiştirilemez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише перегляд: нічого не можна змінити"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat o‘qish: o‘zgartirish kiritib bo‘lmaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀：無法更改任何內容"
          }
        }
      }
    },
