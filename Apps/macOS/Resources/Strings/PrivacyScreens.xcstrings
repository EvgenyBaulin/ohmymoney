{
  "sourceLanguage": "en",
  "strings": {
    "account.editor.hidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытый счёт"
          }
        }
      }
    },
    "account.editor.hiddenHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden account is not in the lists while the app is covered. The totals still hold its money and say «part hidden»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытого счёта нет в списках, пока приложение закрыто. Итоги считают и его деньги и пишут «часть скрыта»."
          }
        }
      }
    },
    "privacy.hidden.hide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть"
          }
        }
      }
    },
    "privacy.hidden.show": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show hidden"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать скрытые"
          }
        }
      }
    },
    "privacy.partHidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "part hidden"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "часть скрыта"
          }
        }
      }
    },
    "privacy.readOnly.banner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only: nothing can be changed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр: ничего нельзя изменить"
          }
        }
      }
    },
    "privacy.readOnly.exit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти…"
          }
        }
      }
    },
