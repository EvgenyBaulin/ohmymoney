    "privacy.readOnly.banner": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only: nothing can be changed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр: ничего нельзя изменить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише перегляд: нічого не можна змінити"
          }
        }
      }
    },
