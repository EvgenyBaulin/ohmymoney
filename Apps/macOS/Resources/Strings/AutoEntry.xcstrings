    "autoEntry.notify.mismatch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka görə %1$@, tətbiqə görə %2$@ — hesabı saymaq vaxtıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У банку %1$@, у праграме %2$@ — час пералічыць рахунак."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka uvádí %1$@, aplikace %2$@ — je čas přepočítat účet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank meldet %1$@, die App %2$@ — Zeit, das Konto zu zählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank says %1$@, the app %2$@ — time to count the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco dice %1$@, la app %2$@: es hora de contar la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque indique %1$@, l'application %2$@ — il est temps de compter le compte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկում՝ %1$@, հավելվածում՝ %2$@․ ժամանակն է հաշվել հաշվի մնացորդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca indica %1$@, l’app %2$@. È ora di verificare il conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行の残高は%1$@、アプリの残高は%2$@です。口座の残高を確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკის ნაშთია %1$@, აპის — %2$@. დროა, ანგარიში გადაამოწმოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк %1$@ дейді, қолданба — %2$@ — есеп-шотты санайтын уақыт."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 잔액은 %1$@, 앱 잔액은 %2$@입니다. 계좌를 점검하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банкта %1$@, колдонмодо %2$@ — эсепти саноого убакыт келди."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgens de bank is het saldo %1$@, volgens de app %2$@. Tel de rekening na."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank podaje %1$@, aplikacja %2$@ — czas przeliczyć konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco informa %1$@, e o app, %2$@. Hora de conferir a conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco indica %1$@ e a app %2$@. É altura de conferir a conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В банке %1$@, в приложении %2$@ — стоит сверить счёт."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк %1$@, барнома %2$@ нишон медиҳад — вақти ҳисоб кардани бақияи ҳисоб расид."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankadaki bakiye %1$@, uygulamadaki %2$@. Hesabı sayma zamanı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За даними банку %1$@, у застосунку %2$@ — час звірити рахунок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankda %1$@, ilovada %2$@ — hisobni tekshirish vaqti keldi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行显示 %1$@，App 显示 %2$@，该盘点账户了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行餘額為 %1$@，App 餘額為 %2$@，請核對帳戶。"
          }
        }
      }
    },
    "autoEntry.notify.mismatchHidden": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankın balansı tətbiqdəki ilə fərqlənir — hesabı saymaq vaxtıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс у банку адрозніваецца ад балансу ў праграме — час пералічыць рахунак."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek banky se liší od aplikace — je čas přepočítat účet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo der Bank weicht vom Saldo der App ab — Zeit, das Konto zu zählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank's balance differs from the app's — time to count the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo del banco no coincide con el de la app: es hora de contar la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde de la banque diffère de celui de l'application — il est temps de compter le compte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկի մնացորդը տարբերվում է հավելվածի մնացորդից․ ժամանակն է հաշվել հաշվի մնացորդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo della banca è diverso da quello dell’app. È ora di verificare il conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行とアプリの残高が一致しません。口座の残高を確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკის ნაშთი აპის ნაშთს არ ემთხვევა. დროა, ანგარიში გადაამოწმოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктің теңгерімі қолданбадағыдан өзгеше — есеп-шотты санайтын уақыт."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 잔액과 앱 잔액이 다릅니다. 계좌를 점검하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын калдыгы колдонмодогудан айырмаланат — эсепти саноого убакыт келди."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo van de bank wijkt af van dat in de app. Tel de rekening na."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo banku różni się od salda w aplikacji — czas przeliczyć konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo do banco difere do saldo no app. Hora de conferir a conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo do banco difere do da app. É altura de conferir a conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток в банке не сходится с приложением — стоит сверить счёт."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи бонк аз бақияи барнома фарқ мекунад — вақти ҳисоб кардани бақияи ҳисоб расид."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankadaki bakiye uygulamadakinden farklı. Hesabı sayma zamanı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок у банку відрізняється від залишку в застосунку — час звірити рахунок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankdagi balans ilovadagidan farq qiladi — hisobni tekshirish vaqti keldi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行余额与 App 中的余额不符，该盘点账户了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行餘額與 App 餘額不符，請核對帳戶。"
          }
        }
      }
    },
