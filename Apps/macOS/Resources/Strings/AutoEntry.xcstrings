    "autoEntry.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“View only” is on: nothing is recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo ver» está activado: no se registra nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено «Только просмотр»: ничего не записывается."
