    "autoEntry.phoneOff": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-da bank mesajlarının ötürülməsi tətbiq App Store-a gələndə Siri ilə birlikdə aktiv ediləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перадача паведамленняў банка на iPhone уключыцца разам з Siri, калі праграма з'явіцца ў App Store."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předávání bankovních zpráv na iPhonu se zapne společně se Siri, až bude aplikace v App Storu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weitergabe von Bank-Nachrichten auf dem iPhone wird zusammen mit Siri eingeschaltet, sobald die App in den App Store kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passing bank messages on the iPhone will be switched on together with Siri, when the app comes to the App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar los mensajes del banco en el iPhone se activará junto con Siri, cuando la app llegue a App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transmission des messages de banque sur iPhone sera activée avec Siri, lorsque l'application arrivera sur l'App Store."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ում բանկի հաղորդագրությունների փոխանցումը կմիանա Siri-ի հետ միասին, երբ հավելվածը հայտնվի App Store-ում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inoltro dei messaggi bancari su iPhone sarà attivato insieme a Siri, quando l’app arriverà sull’App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで銀行からのメッセージを渡す機能は、アプリのApp Store公開時にSiriとともに有効になります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ზე საბანკო შეტყობინებების გადაცემა Siri-სთან ერთად ჩაირთვება, როცა აპი App Store-ში გამოჩნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-да банк хабарламаларын өткізу App Store-ға шыққанда, Siri-мен бірге қосылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 App Store에 출시되면 Siri와 함께 iPhone의 은행 메시지 전달 기능이 켜집니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'до банк билдирүүлөрүн өткөрүү колдонмо App Store'го чыкканда Siri менен кошо иштетилет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het doorgeven van bankberichten op de iPhone wordt samen met Siri ingeschakeld zodra de app in de App Store verschijnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazywanie wiadomości bankowych na iPhonie zostanie włączone wraz z Siri, gdy aplikacja pojawi się w App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O encaminhamento de mensagens bancárias no iPhone será ativado junto com a Siri quando o app chegar à App Store."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transmissão de mensagens bancárias no iPhone será ativada juntamente com a Siri, quando a app chegar à App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача сообщений банка на iPhone включится вместе с Siri — к выходу в App Store."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Интиқоли паёмҳои бонк дар iPhone ҳамроҳ бо Siri, вақте ки барнома дар App Store пайдо мешавад, фаъол мегардад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da banka mesajlarını iletme, uygulama App Store’a geldiğinde Siri ile birlikte açılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передавання повідомлень банку на iPhone буде ввімкнено разом із Siri, коли застосунок з'явиться в App Store."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da bank xabarlarini uzatish ilova App Store’da paydo bo‘lgach, Siri bilan birga yoqiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 上架 App Store 后，iPhone 上的银行信息传入功能将与 Siri 一同启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 上架 App Store 後，iPhone 上傳送銀行訊息的功能將隨 Siri 一併啟用。"
          }
        }
      }
    },
    "autoEntry.proposed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sonra qeyd et” bölməsində gözləyir: %@"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чакае ў «Запісаць пазней»: %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeká v „Zapsat později“: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet unter „Später erfassen“: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting in “Record later”: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En espera en «Registrar más tarde»: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente dans « Noter plus tard » : %@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասում է «Գրանցել ավելի ուշ» բաժնում․ %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa in “Registra più tardi”: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「あとで記録」で待機中: %@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ელოდება „მოგვიანებით ჩაწერაში“: %@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Кейін жазу» ішінде күтуде: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“나중에 기록”에서 대기 중: %@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“Кийин жазууда” күтүп жатат: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht in ‘Boek later’: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czeka w „Zapisz później”: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando em “Registrar depois”: %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em espera em “Registar mais tarde”: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждёт в «Запишу потом»: %@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар «Баъдтар сабт кунед» интизор аст: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sonra Kaydet”te bekliyor: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікує в «Записати пізніше»: %@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Keyinroq qayd etish”da kutmoqda: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“稍后记账”中等待处理：%@"
          }
        },
        "zh-Hant": {
