    "autoEntry.duplicate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Artıq qeyd edilib: bu əməliyyat kitablardadır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ужо запісана: гэтая аперацыя ёсць ва ўліку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už zapsáno: tato operace je v účetnictví."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon erfasst: Dieser Vorgang steht bereits in den Büchern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already recorded: this operation is in the books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya registrado: esta operación ya está en las cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà noté : cette opération est dans les comptes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արդեն գրանցված է․ այս գործարքը գրանցամատյանում է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già registrata: questa operazione è già nei conti."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უკვე ჩაწერილია: ეს ოპერაცია აღრიცხვაშია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұрын жазылған: бұл операция кітапта бар."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Буга чейин жазылган: бул операция эсепте бар."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al geboekt: deze transactie staat in de administratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już zapisano: ta operacja jest w księgach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já registrada: esta operação está nos registros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já registada: esta operação já está nas contas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже записано: эта операция есть в учёте."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аллакай сабт шудааст: ин амалиёт дар дафтар аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten kaydedilmiş: Bu işlem kayıtlarda var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже записано: ця операція є в обліку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu operatsiya allaqachon qayd etilgan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已記錄：此交易已入帳。"
          }
        }
      }
    },
    "autoEntry.locked": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney kilidlidir: mesajı ötürmək üçün kilidi açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney заблакавана: разблакіруйце праграму, каб перадаць паведамленне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney je zamčené: pro předání zprávy ho odemkněte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ist gesperrt: Entsperren Sie es, um die Nachricht zu übergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney is locked: unlock it to pass the message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney está bloqueada: desbloquéela para pasar el mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney est verrouillée : déverrouillez-la pour transmettre le message."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն կողպված է․ ապակողպեք այն՝ հաղորդագրությունը փոխանցելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney è bloccato: sbloccalo per inoltrare il messaggio."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ჩაკეტილია: შეტყობინების გადასაცემად განბლოკეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney құлыптаулы: хабарламаны өткізу үшін ашыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney кулпуланган: билдирүүнү өткөрүү үчүн кулпусун ачыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney is vergrendeld: ontgrendel de app om het bericht door te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney jest zablokowane. Odblokuj aplikację, aby przekazać wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney está bloqueado: desbloqueie-o para encaminhar a mensagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney está bloqueada: desbloqueie-a para transmitir a mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney заблокировано: разблокируйте, чтобы передать сообщение."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney қулф аст: барои интиқоли паём онро кушоед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney kilitli: Mesajı iletmek için kilidi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney заблоковано: розблокуйте, щоб передати повідомлення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney qulflangan. Xabarni uzatish uchun uni qulfdan chiqaring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 已鎖定：請解鎖以傳送訊息。"
          }
        }
      }
    },
    "autoEntry.notBank": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bank mesajına bənzəmir: əməliyyat, məbləğ və kart və ya balans yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта не падобна да паведамлення банка: няма аперацыі, сумы і карты або балансу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle nevypadá jako zpráva od banky: chybí operace, částka a karta nebo zůstatek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einer Bank-Nachricht aus: Es fehlen Vorgang, Betrag und Karte oder Saldo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This doesn't look like a bank message: no operation, amount and card or balance in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no parece un mensaje del banco: no hay operación, importe ni tarjeta o saldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à un message de banque : ni opération, ni montant, ni carte ou solde."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա բանկի հաղորդագրության նման չէ․ այն չի պարունակում գործարք, գումար և քարտ կամ մնացորդ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sembra un messaggio bancario: mancano operazione, importo e carta o saldo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს საბანკო შეტყობინებას არ ჰგავს: მასში არ არის ოპერაცია, თანხა და ბარათი ან ნაშთი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл банк хабарламасына ұқсамайды: онда операция, сома, карта немесе теңгерім жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул банк билдирүүсүнө окшобойт: операция, сумма жана карта же калдык жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit lijkt geen bankbericht: een transactie, bedrag en kaart of saldo ontbreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie wygląda na wiadomość z banku: brakuje operacji, kwoty i karty lub salda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta não parece ser uma mensagem bancária: faltam a operação, o valor e o cartão ou saldo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não parece ser uma mensagem bancária: faltam a operação, o valor e o cartão ou saldo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не похоже на сообщение банка: в нём нет операции, суммы и карты или остатка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ба паёми бонк монанд нест: амалиёт, маблағ ва корт ё бақия дар он нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir banka mesajına benzemiyor: İşlem, tutar ve kart veya bakiye bilgisi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не схоже на повідомлення банку: немає операції, суми та картки або залишку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bank xabariga o‘xshamaydi: unda operatsiya, summa va karta yoki balans yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這似乎不是銀行訊息：其中沒有交易、金額及卡片或餘額資訊。"
          }
        }
      }
    },
    "autoEntry.notReady": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney hələ kitabları açır — bir az sonra yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney яшчэ адкрывае ўлік — паспрабуйце праз хвіліну."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney se ještě otevírá — zkuste to za chvíli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney öffnet noch die Bücher — versuchen Sie es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney is still opening the books — try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney todavía está abriendo las cuentas: inténtelo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ouvre encore les comptes — réessayez dans un instant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն դեռ բացում է գրանցամատյանը․ մի փոքր հետո կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney sta ancora aprendo i conti. Riprova tra poco."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ჯერ კიდევ ხსნის აღრიცხვას — სცადეთ ცოტა ხანში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney әлі кітаптарды ашып жатыр — сәлден соң қайталап көріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney эсептерди ачып жатат — бир аздан кийин кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney wordt nog geopend. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney otwiera księgi. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ainda está abrindo os registros. Tente novamente em instantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ainda está a abrir as contas. Tente novamente daqui a pouco."
