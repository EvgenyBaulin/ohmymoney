    "autoEntry.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключаны рэжым «Толькі прагляд»: нічога не запісана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur ansehen“ ist eingeschaltet: Nichts wird erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“View only” is on: nothing is recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo ver» está activado: no se registra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Consultation seule » est activé : rien n'est noté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Solo visualizzazione” è attivo: non viene registrato nulla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Тек көру» қосулы: ештеңе жазылмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączono „Tylko do odczytu”. Nic nie jest zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Somente visualização” está ativado: nada é registrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено «Только просмотр»: ничего не записывается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yalnızca Görüntüle” açık: Hiçbir şey kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено «Лише перегляд»: нічого не записується."
          }
        }
      }
    },
    "autoEntry.settings.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паведамленне, перададзенае праз Shortcuts («Перадаць паведамленне банка»), становіцца аперацыяй. Пры прапанове запісу апавяшчэнне пытаецца «Запісаць?», а аперацыя чакае ў «Запісаць пазней». Пры імгненным запісе аперацыя запісваецца як праз радок уводу; калі радок запытаў бы ўдакладненне, прапануецца запіс. Захоўваюцца толькі сума, крама, карта і баланс — само паведамленне ніколі не захоўваецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Nachricht, die über den Kurzbefehl „Bank-Nachricht übergeben“ weitergereicht wird, wird zu einem Vorgang. Vorschlagen: Eine Mitteilung fragt „Erfassen?“, und der Vorgang wartet unter „Später erfassen“. Sofort: Er wird so erfasst, wie die Eingabezeile ihn erfasst; würde die Zeile etwas nachfragen, wird stattdessen vorgeschlagen. Behalten werden nur Betrag, Geschäft, Karte und Saldo — nie die Nachricht selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A message passed on by Shortcuts (“Pass a bank message”) becomes an operation. Offered: a notification asks “Record?” and the operation waits in “Record later”. At once: it is recorded the way the entry line records it; if the line would ask something, it is offered instead. Only the amount, the shop, the card and the balance are kept — never the message itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mensaje que pasa Atajos («Pasar un mensaje del banco») se convierte en una operación. Ofrecer: una notificación pregunta «¿Registrar?» y la operación espera en «Registrar más tarde». Al momento: se registra como lo registraría la línea de entrada; si la línea preguntaría algo, se ofrece en su lugar. Solo se guardan el importe, la tienda, la tarjeta y el saldo, nunca el mensaje en sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un message transmis par Raccourcis (« Transmettre un message de banque ») devient une opération. Proposé : une notification demande « Noter ? » et l'opération attend dans « Noter plus tard ». Tout de suite : elle est notée comme la ligne de saisie la note ; si la ligne demanderait une précision, elle est proposée à la place. Seuls le montant, le magasin, la carte et le solde sont conservés — jamais le message lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un messaggio inoltrato da Comandi Rapidi (“Inoltra un messaggio bancario”) diventa un’operazione. Con conferma: una notifica chiede se registrarla e l’operazione resta in “Registra più tardi”. Subito: viene registrata come dalla riga di inserimento; se sono necessarie altre informazioni, viene richiesta conferma. Vengono conservati solo importo, negozio, carta e saldo, mai il messaggio stesso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Жылдам команда» арқылы берілген хабарлама («Банк хабарламасын өткізу») операцияға айналады. Ұсынылса: хабарландыру «Жазайын ба?» деп сұрайды, ал операция «Кейін жазу» ішінде күтеді. Бірден: енгізу жолы сияқты жазылады; жол бірдеңе сұраса, оның орнына ұсынылады. Тек сома, дүкен, карта және теңгерім сақталады — хабарламаның өзі ешқашан сақталмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomość przekazana przez Skróty („Przekaż wiadomość bankową”) staje się operacją. Propozycja: powiadomienie pyta „Zapisać?”, a operacja czeka w „Zapisz później”. Od razu: operacja jest zapisywana tak jak w wierszu wpisu; jeśli wymaga dodatkowych informacji, pojawia się propozycja zapisu. Zachowywane są tylko kwota, sklep, karta i saldo — nigdy sama wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mensagem encaminhada pelo Atalhos (“Encaminhar mensagem bancária”) se torna uma operação. Ao oferecer, uma notificação pergunta “Registrar?” e a operação aguarda em “Registrar depois”. Ao registrar imediatamente, ela é registrada como na linha de lançamento; se a linha precisar de mais informações, a operação será oferecida. Apenas o valor, a loja, o cartão e o saldo são mantidos — nunca a mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение, переданное «Быстрыми командами» («Передать сообщение банка»), становится операцией. «Предлагать»: уведомление спрашивает «Записать?», операция ждёт в «Запишу потом». «Сразу»: записывается, как строка ввода; если строка что-то спросила бы — предлагается. Хранятся только сумма, место, карта и остаток — сам текст сообщения нигде не хранится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler ile iletilen bir mesaj (“Banka Mesajını İlet”) işleme dönüşür. Kaydetmeyi öner: Bir bildirim “Kaydedilsin mi?” diye sorar ve işlem “Sonra Kaydet”te bekler. Hemen kaydet: İşlem, giriş satırındaki gibi kaydedilir; giriş satırı bir soru soracaksa bunun yerine kaydetme önerilir. Yalnızca tutar, mağaza, kart ve bakiye saklanır; mesajın kendisi asla saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення, передане через Команди («Передати повідомлення банку»), стає операцією. З пропозицією: сповіщення запитує «Записати?», а операція чекає в «Записати пізніше». Одразу: записується так само, як із рядка вводу; якщо рядок поставив би запитання, натомість буде пропозиція. Зберігаються лише сума, магазин, картка та залишок — ніколи саме повідомлення."
          }
        }
      }
    },
