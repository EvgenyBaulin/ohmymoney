        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция по скрытому счёту — записать?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція прихованого рахунку — записати?"
          }
        }
      }
    },
