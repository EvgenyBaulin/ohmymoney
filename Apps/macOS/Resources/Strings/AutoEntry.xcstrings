    "autoEntry.notify.fromBank": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З паведамлення банка"
          }
        },
        "de": {
