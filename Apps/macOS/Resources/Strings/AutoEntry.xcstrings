    "intent.bankPasteboard.description": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bank mesajını ötür” kimi, mübadilə buferinə kopyalanmış bank mesajını oxuyur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чытае паведамленне банка, скапіяванае ў буфер абмену, як дзеянне «Перадаць паведамленне банка»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přečte bankovní zprávu zkopírovanou do schránky stejně jako „Předat bankovní zprávu“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest eine Bank-Nachricht aus der Zwischenablage, wie „Bank-Nachricht übergeben“ es tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads a bank message copied to the clipboard, as “Pass a Bank Message” does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee un mensaje del banco copiado al portapapeles, igual que «Pasar un mensaje del banco»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit un message de banque copié dans le presse-papiers, comme le fait « Transmettre un message de banque »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարդում է clipboard-ում պատճենված բանկի հաղորդագրությունը՝ ինչպես «Փոխանցել բանկի հաղորդագրությունը» գործողությունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge un messaggio bancario copiato negli appunti, come “Inoltra un messaggio bancario”."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კითხულობს გაცვლის ბუფერში დაკოპირებულ საბანკო შეტყობინებას, ისევე როგორც „საბანკო შეტყობინების გადაცემა“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшіру буферіне көшірілген банк хабарламасын «Банк хабарламасын өткізу» сияқты оқиды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“Банк билдирүүсүн өткөрүү” сыяктуу, алмашуу буферине көчүрүлгөн банк билдирүүсүн окуйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest een bankbericht dat naar het klembord is gekopieerd, net als ‘Geef een bankbericht door’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje wiadomość bankową skopiowaną do schowka, tak jak „Przekaż wiadomość bankową”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê uma mensagem bancária copiada para a área de transferência, como em “Encaminhar Mensagem Bancária”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê uma mensagem bancária copiada para a área de transferência, tal como “Transmitir mensagem bancária”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает скопированное сообщение банка, как «Передать сообщение банка»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паёми бонки ба буфери мубодила нусхашударо мисли «Интиқоли паёми бонк» мехонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panoya kopyalanan bir banka mesajını, “Banka Mesajını İlet” gibi okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає повідомлення банку, скопійоване в буфер обміну, як команда «Передати повідомлення банку»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Almashish buferiga nusxalangan bank xabarini “Bank xabarini uzatish” kabi o‘qiydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取拷貝到剪貼簿的銀行訊息，作用與「傳送銀行訊息」相同。"
          }
        }
      }
    },
