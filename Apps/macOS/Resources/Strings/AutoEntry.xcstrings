{
  "sourceLanguage": "en",
  "strings": {
    "autoEntry.action.edit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить"
          }
        }
      }
    },
    "autoEntry.action.record": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать"
          }
        }
      }
    },
    "autoEntry.duplicate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already recorded: this operation is in the books."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже записано: эта операция есть в учёте."
          }
        }
      }
    },
    "autoEntry.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney is locked: unlock it to pass the message."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney заблокировано: разблокируйте, чтобы передать сообщение."
          }
        }
      }
    },
    "autoEntry.notBank": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This doesn't look like a bank message: no operation, amount and card or balance in it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не похоже на сообщение банка: в нём нет операции, суммы и карты или остатка."
          }
        }
      }
    },
    "autoEntry.notReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney is still opening the books — try again in a moment."
