    "autoEntry.formats.offers.footer": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Фармат прапануецца на аснове выпраўленага вамі тэксту. У прыкладзе выкарыстоўваюцца выдуманыя лічбы і назва крамы; сам тэкст не захоўваецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einem korrigierten Text wird ein Format vorgeschlagen. Das Beispiel enthält erfundene Zahlen und ein erfundenes Geschäft. Der Text selbst wird nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A format is proposed from a text you corrected. The example holds made-up figures and a made-up shop; the text itself is not kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se propone un formato a partir de un texto que corregiste. El ejemplo contiene cifras y una tienda ficticias; el texto no se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un format est proposé à partir d’un texte que vous avez corrigé. L’exemple contient des montants et un commerce fictifs ; le texte lui-même n’est pas conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato viene proposto da un testo che hai corretto. L’esempio contiene cifre e un negozio inventati; il testo originale non viene salvato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат сіз түзеткен мәтін негізінде ұсынылады. Мысалдағы сандар мен дүкен ойдан шығарылған; мәтіннің өзі сақталмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Format jest proponowany na podstawie poprawionego tekstu. Przykład zawiera fikcyjne kwoty i nazwę sklepu. Sam tekst nie jest zachowywany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um formato é sugerido com base em um texto que você corrigiu. O exemplo contém valores e uma loja fictícios; o texto não é salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат предложен по тексту, который вы поправили. В примере выдуманные суммы и место; сам текст не хранится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzelttiğiniz bir metinden biçim önerilir. Örnekteki tutarlar ve mağaza uydurmadır; metnin kendisi saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат запропоновано на основі виправленого вами тексту. Приклад містить вигадані суми й назву магазину; сам текст не зберігається."
          }
        }
      }
    },
