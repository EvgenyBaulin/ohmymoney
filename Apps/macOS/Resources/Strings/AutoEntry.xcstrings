        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасырын есеп-шоттың операциясы — жазайын ба?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция по скрытому счёту — записать?"
