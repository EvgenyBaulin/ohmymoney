    "autoEntry.phoneOff": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перадача паведамленняў банка на iPhone уключыцца разам з Siri, калі праграма з'явіцца ў App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weitergabe von Bank-Nachrichten auf dem iPhone wird zusammen mit Siri eingeschaltet, sobald die App in den App Store kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passing bank messages on the iPhone will be switched on together with Siri, when the app comes to the App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar los mensajes del banco en el iPhone se activará junto con Siri, cuando la app llegue a App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transmission des messages de banque sur iPhone sera activée avec Siri, lorsque l'application arrivera sur l'App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inoltro dei messaggi bancari su iPhone sarà attivato insieme a Siri, quando l’app arriverà sull’App Store."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-да банк хабарламаларын өткізу App Store-ға шыққанда, Siri-мен бірге қосылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazywanie wiadomości bankowych na iPhonie zostanie włączone wraz z Siri, gdy aplikacja pojawi się w App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O encaminhamento de mensagens bancárias no iPhone será ativado junto com a Siri quando o app chegar à App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача сообщений банка на iPhone включится вместе с Siri — к выходу в App Store."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da banka mesajlarını iletme, uygulama App Store’a geldiğinde Siri ile birlikte açılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передавання повідомлень банку на iPhone буде ввімкнено разом із Siri, коли застосунок з'явиться в App Store."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da bank xabarlarini uzatish ilova App Store’da paydo bo‘lgach, Siri bilan birga yoqiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 上架 App Store 後，iPhone 上傳送銀行訊息的功能將隨 Siri 一併啟用。"
          }
        }
      }
    },
    "autoEntry.proposed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чакае ў «Запісаць пазней»: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet unter „Später erfassen“: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting in “Record later”: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En espera en «Registrar más tarde»: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente dans « Noter plus tard » : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa in “Registra più tardi”: %@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Кейін жазу» ішінде күтуде: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czeka w „Zapisz później”: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando em “Registrar depois”: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждёт в «Запишу потом»: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sonra Kaydet”te bekliyor: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікує в «Записати пізніше»: %@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Keyinroq qayd etish”da kutmoqda: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待在「稍後記錄」中處理：%@"
          }
        }
      }
    },
    "autoEntry.proposed.hidden": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыя чакае ў «Запісаць пазней»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorgang wartet unter „Später erfassen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation is waiting in “Record later”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una operación en espera en «Registrar más tarde»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération attend dans « Noter plus tard »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’operazione è in attesa in “Registra più tardi”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Кейін жазу» ішінде бір операция күтуде."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja czeka w „Zapisz później”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma operação aguarda em “Registrar depois”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция ждёт в «Запишу потом»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sonra Kaydet”te bir işlem bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція очікує в «Записати пізніше»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiya “Keyinroq qayd etish”da kutmoqda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「稍後記錄」中有一筆交易待處理。"
          }
        }
      }
    },
    "autoEntry.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключаны рэжым «Толькі прагляд»: нічога не запісана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur ansehen“ ist eingeschaltet: Nichts wird erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“View only” is on: nothing is recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo ver» está activado: no se registra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Consultation seule » est activé : rien n'est noté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Solo visualizzazione” è attivo: non viene registrato nulla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Тек көру» қосулы: ештеңе жазылмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączono „Tylko do odczytu”. Nic nie jest zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Somente visualização” está ativado: nada é registrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено «Только просмотр»: ничего не записывается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yalnızca Görüntüle” açık: Hiçbir şey kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено «Лише перегляд»: нічого не записується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Faqat ko‘rish” yoqilgan: hech narsa qayd etilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟「僅供檢視」：不會記錄任何交易。"
          }
        }
      }
    },
    "autoEntry.settings.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паведамленне, перададзенае праз Shortcuts («Перадаць паведамленне банка»), становіцца аперацыяй. Пры прапанове запісу апавяшчэнне пытаецца «Запісаць?», а аперацыя чакае ў «Запісаць пазней». Пры імгненным запісе аперацыя запісваецца як праз радок уводу; калі радок запытаў бы ўдакладненне, прапануецца запіс. Захоўваюцца толькі сума, крама, карта і баланс — само паведамленне ніколі не захоўваецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Nachricht, die über den Kurzbefehl „Bank-Nachricht übergeben“ weitergereicht wird, wird zu einem Vorgang. Vorschlagen: Eine Mitteilung fragt „Erfassen?“, und der Vorgang wartet unter „Später erfassen“. Sofort: Er wird so erfasst, wie die Eingabezeile ihn erfasst; würde die Zeile etwas nachfragen, wird stattdessen vorgeschlagen. Behalten werden nur Betrag, Geschäft, Karte und Saldo — nie die Nachricht selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A message passed on by Shortcuts (“Pass a bank message”) becomes an operation. Offered: a notification asks “Record?” and the operation waits in “Record later”. At once: it is recorded the way the entry line records it; if the line would ask something, it is offered instead. Only the amount, the shop, the card and the balance are kept — never the message itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mensaje que pasa Atajos («Pasar un mensaje del banco») se convierte en una operación. Ofrecer: una notificación pregunta «¿Registrar?» y la operación espera en «Registrar más tarde». Al momento: se registra como lo registraría la línea de entrada; si la línea preguntaría algo, se ofrece en su lugar. Solo se guardan el importe, la tienda, la tarjeta y el saldo, nunca el mensaje en sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un message transmis par Raccourcis (« Transmettre un message de banque ») devient une opération. Proposé : une notification demande « Noter ? » et l'opération attend dans « Noter plus tard ». Tout de suite : elle est notée comme la ligne de saisie la note ; si la ligne demanderait une précision, elle est proposée à la place. Seuls le montant, le magasin, la carte et le solde sont conservés — jamais le message lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un messaggio inoltrato da Comandi Rapidi (“Inoltra un messaggio bancario”) diventa un’operazione. Con conferma: una notifica chiede se registrarla e l’operazione resta in “Registra più tardi”. Subito: viene registrata come dalla riga di inserimento; se sono necessarie altre informazioni, viene richiesta conferma. Vengono conservati solo importo, negozio, carta e saldo, mai il messaggio stesso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Жылдам команда» арқылы берілген хабарлама («Банк хабарламасын өткізу») операцияға айналады. Ұсынылса: хабарландыру «Жазайын ба?» деп сұрайды, ал операция «Кейін жазу» ішінде күтеді. Бірден: енгізу жолы сияқты жазылады; жол бірдеңе сұраса, оның орнына ұсынылады. Тек сома, дүкен, карта және теңгерім сақталады — хабарламаның өзі ешқашан сақталмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomość przekazana przez Skróty („Przekaż wiadomość bankową”) staje się operacją. Propozycja: powiadomienie pyta „Zapisać?”, a operacja czeka w „Zapisz później”. Od razu: operacja jest zapisywana tak jak w wierszu wpisu; jeśli wymaga dodatkowych informacji, pojawia się propozycja zapisu. Zachowywane są tylko kwota, sklep, karta i saldo — nigdy sama wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mensagem encaminhada pelo Atalhos (“Encaminhar mensagem bancária”) se torna uma operação. Ao oferecer, uma notificação pergunta “Registrar?” e a operação aguarda em “Registrar depois”. Ao registrar imediatamente, ela é registrada como na linha de lançamento; se a linha precisar de mais informações, a operação será oferecida. Apenas o valor, a loja, o cartão e o saldo são mantidos — nunca a mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение, переданное «Быстрыми командами» («Передать сообщение банка»), становится операцией. «Предлагать»: уведомление спрашивает «Записать?», операция ждёт в «Запишу потом». «Сразу»: записывается, как строка ввода; если строка что-то спросила бы — предлагается. Хранятся только сумма, место, карта и остаток — сам текст сообщения нигде не хранится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler ile iletilen bir mesaj (“Banka Mesajını İlet”) işleme dönüşür. Kaydetmeyi öner: Bir bildirim “Kaydedilsin mi?” diye sorar ve işlem “Sonra Kaydet”te bekler. Hemen kaydet: İşlem, giriş satırındaki gibi kaydedilir; giriş satırı bir soru soracaksa bunun yerine kaydetme önerilir. Yalnızca tutar, mağaza, kart ve bakiye saklanır; mesajın kendisi asla saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення, передане через Команди («Передати повідомлення банку»), стає операцією. З пропозицією: сповіщення запитує «Записати?», а операція чекає в «Записати пізніше». Одразу: записується так само, як із рядка вводу; якщо рядок поставив би запитання, натомість буде пропозиція. Зберігаються лише сума, магазин, картка та залишок — ніколи саме повідомлення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts orqali uzatilgan xabar (“Bank xabarini uzatish”) operatsiyaga aylanadi. Taklif etish: bildirishnomada “Qayd etilsinmi?” deb so‘raladi va operatsiya “Keyinroq qayd etish”da kutadi. Darhol: operatsiya kiritish qatoridagi kabi qayd etiladi; agar qatorda biror savol tug‘ilsa, uni qayd etish taklif qilinadi. Faqat summa, do‘kon, karta va balans saqlanadi — xabarning o‘zi saqlanmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑「傳送銀行訊息」傳送的訊息會轉為交易。選擇「建議記錄」時，通知會詢問「要記錄嗎？」，交易會在「稍後記錄」中等待。選擇「立即記錄」時，交易會以輸入列的方式記錄；若輸入列需要詢問，則改為建議記錄。只會保留金額、商店、卡片和餘額，不會保留訊息本身。"
          }
        }
      }
    },
