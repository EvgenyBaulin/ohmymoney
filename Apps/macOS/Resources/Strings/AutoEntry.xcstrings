    "intent.bankMessage.description": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankdan gələn SMS və ya push bildirişini oxuyur və OhMyMoney-dəki ayara uyğun olaraq əməliyyatı qeyd edir və ya qeyd etməyi təklif edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чытае SMS або push-апавяшчэнне ад банка і запісвае аперацыю або прапануе яе запісаць паводле налад OhMyMoney."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přečte SMS nebo oznámení od banky a operaci zapíše nebo nabídne k zápisu podle nastavení v OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest eine SMS oder Mitteilung einer Bank und erfasst den Vorgang oder schlägt vor, ihn zu erfassen, wie in OhMyMoney eingestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads an SMS or a push from a bank and records the operation or offers to record it, as set in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee un SMS o una notificación de un banco y registra la operación o la ofrece para registrar, según lo configurado en OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit un SMS ou une notification d'une banque et note l'opération, ou propose de la noter, selon le réglage dans OhMyMoney."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարդում է բանկի SMS-ը կամ push ծանուցումը և գրանցում գործարքը կամ առաջարկում գրանցել այն՝ ըստ OhMyMoney-ի կարգավորումների։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge un SMS o una notifica push della banca e registra l’operazione o chiede conferma, in base alle impostazioni di OhMyMoney."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行からのSMSまたはプッシュ通知を読み取り、OhMyMoneyの設定に従って取引を記録するか、記録を提案します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კითხულობს ბანკის SMS-ს ან push-შეტყობინებას და წერს ოპერაციას ან გთავაზობთ მის ჩაწერას, OhMyMoney-ის პარამეტრების მიხედვით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктен келген SMS немесе push-хабарламаны оқиды және OhMyMoney-де белгіленгеніндей операцияны жазады не жазуды ұсынады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행의 SMS 또는 푸시 메시지를 읽고 OhMyMoney 설정에 따라 거래를 기록하거나 기록을 제안합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын SMS же push билдирүүсүн окуп, OhMyMoney жөндөөлөрүнө жараша операцияны жазат же жазууну сунуштайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest een sms of pushbericht van een bank en boekt de transactie of stelt voor deze te boeken, volgens de instellingen in OhMyMoney."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje SMS lub powiadomienie z banku i zapisuje operację albo proponuje jej zapis, zgodnie z ustawieniami OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê um SMS ou uma notificação de um banco e registra a operação ou oferece seu registro, conforme definido no OhMyMoney."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê um SMS ou uma notificação de um banco e regista a operação ou propõe o seu registo, conforme definido em OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает СМС или пуш банка и записывает операцию или предлагает её записать — как выбрано в настройках OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS ё огоҳиномаи бонкро мехонад ва мувофиқи танзимоти OhMyMoney амалиётро сабт мекунад ё сабти онро пешниҳод мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankadan gelen bir SMS’i veya anlık bildirimi okur ve OhMyMoney ayarlarına göre işlemi kaydeder ya da kaydetmeyi önerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає SMS або push-повідомлення банку та записує операцію або пропонує записати її відповідно до налаштувань OhMyMoney."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankdan kelgan SMS yoki push-xabarni o‘qiydi va OhMyMoney sozlamalariga ko‘ra operatsiyani qayd etadi yoki qayd etishni taklif qiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取银行短信或推送，并根据 OhMyMoney 中的设置记录交易或提议记账。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取銀行簡訊或推播通知，並依 OhMyMoney 中的設定記錄交易或建議記錄。"
          }
        }
      }
    },
