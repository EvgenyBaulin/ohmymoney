        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-да банк хабарламаларын өткізу App Store-ға шыққанда, Siri-мен бірге қосылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazywanie wiadomości bankowych na iPhonie zostanie włączone wraz z Siri, gdy aplikacja pojawi się w App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O encaminhamento de mensagens bancárias no iPhone será ativado junto com a Siri quando o app chegar à App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача сообщений банка на iPhone включится вместе с Siri — к выходу в App Store."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da banka mesajlarını iletme, uygulama App Store’a geldiğinde Siri ile birlikte açılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передавання повідомлень банку на iPhone буде ввімкнено разом із Siri, коли застосунок з'явиться в App Store."
          }
        }
      }
    },
