    "intent.bankMessage.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank mesajını ötür"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перадаць паведамленне банка"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předat bankovní zprávu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank-Nachricht übergeben"
          }
        },
        "en": {
