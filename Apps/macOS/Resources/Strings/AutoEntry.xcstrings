        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorgang eines ausgeblendeten Kontos — erfassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation of a hidden account — record it?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’operazione di un conto nascosto: vuoi registrarla?"
