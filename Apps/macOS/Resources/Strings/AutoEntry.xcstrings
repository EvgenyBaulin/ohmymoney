    "autoEntry.duplicate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ужо запісана: гэтая аперацыя ёсць ва ўліку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon erfasst: Dieser Vorgang steht bereits in den Büchern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already recorded: this operation is in the books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya registrado: esta operación ya está en las cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà noté : cette opération est dans les comptes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già registrata: questa operazione è già nei conti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұрын жазылған: бұл операция кітапта бар."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już zapisano: ta operacja jest w księgach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já registrada: esta operação está nos registros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже записано: эта операция есть в учёте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten kaydedilmiş: Bu işlem kayıtlarda var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже записано: ця операція є в обліку."
          }
        }
      }
    },
    "autoEntry.formats.conflicts.footer": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбар запамінаецца, і пытанне больш не задаецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl wird gespeichert und die Frage nicht erneut gestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The choice is remembered and the question is not asked again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La elección se recordará y no se volverá a preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce choix est mémorisé et la question ne sera plus posée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scelta viene salvata e la domanda non verrà più mostrata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдау есте сақталады және сұрақ қайта қойылмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybór zostanie zapamiętany, a pytanie nie pojawi się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escolha é salva e a pergunta não será feita novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор запоминается, вопрос больше не повторится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim hatırlanır ve soru tekrar sorulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір буде збережено, і запитання більше не з’явиться."
          }
        }
      }
    },
