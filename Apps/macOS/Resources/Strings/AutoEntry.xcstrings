    "intent.bankMessage.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads an SMS or a push from a bank and records the operation or offers to record it, as set in OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает СМС или пуш банка и записывает операцию или предлагает её записать — как выбрано в настройках OhMyMoney."
          }
        }
      }
    },
    "intent.bankMessage.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение"
          }
        }
      }
    },
    "intent.bankMessage.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass a Bank Message"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передать сообщение банка"
          }
        }
      }
    },
    "intent.bankPasteboard.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads a bank message copied to the clipboard, as “Pass a Bank Message” does."
