    "intent.bankMessage.description": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чытае SMS або push-апавяшчэнне ад банка і запісвае аперацыю або прапануе яе запісаць паводле налад OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest eine SMS oder Mitteilung einer Bank und erfasst den Vorgang oder schlägt vor, ihn zu erfassen, wie in OhMyMoney eingestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads an SMS or a push from a bank and records the operation or offers to record it, as set in OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee un SMS o una notificación de un banco y registra la operación o la ofrece para registrar, según lo configurado en OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit un SMS ou une notification d'une banque et note l'opération, ou propose de la noter, selon le réglage dans OhMyMoney."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge un SMS o una notifica push della banca e registra l’operazione o chiede conferma, in base alle impostazioni di OhMyMoney."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктен келген SMS немесе push-хабарламаны оқиды және OhMyMoney-де белгіленгеніндей операцияны жазады не жазуды ұсынады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje SMS lub powiadomienie z banku i zapisuje operację albo proponuje jej zapis, zgodnie z ustawieniami OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê um SMS ou uma notificação de um banco e registra a operação ou oferece seu registro, conforme definido no OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает СМС или пуш банка и записывает операцию или предлагает её записать — как выбрано в настройках OhMyMoney."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankadan gelen bir SMS’i veya anlık bildirimi okur ve OhMyMoney ayarlarına göre işlemi kaydeder ya da kaydetmeyi önerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає SMS або push-повідомлення банку та записує операцію або пропонує записати її відповідно до налаштувань OhMyMoney."
          }
        }
      }
    },
