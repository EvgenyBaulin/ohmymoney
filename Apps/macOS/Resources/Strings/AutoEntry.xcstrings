    "intent.bankMessage.description": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest eine SMS oder Mitteilung einer Bank und erfasst den Vorgang oder schlägt vor, ihn zu erfassen, wie in OhMyMoney eingestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads an SMS or a push from a bank and records the operation or offers to record it, as set in OhMyMoney."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктен келген SMS немесе push-хабарламаны оқиды және OhMyMoney-де белгіленгеніндей операцияны жазады не жазуды ұсынады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает СМС или пуш банка и записывает операцию или предлагает её записать — как выбрано в настройках OhMyMoney."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає SMS або push-повідомлення банку та записує операцію або пропонує записати її відповідно до налаштувань OhMyMoney."
          }
        }
      }
    },
