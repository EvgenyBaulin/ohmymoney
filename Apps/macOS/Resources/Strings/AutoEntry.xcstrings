          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引が「あとで記録」で待機中です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაცია ელოდება „მოგვიანებით ჩაწერაში“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Кейін жазу» ішінде бір операция күтуде."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 “나중에 기록”에서 대기 중입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“Кийин жазууда” операция күтүп жатат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wacht een transactie in ‘Boek later’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja czeka w „Zapisz później”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma operação aguarda em “Registrar depois”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma operação está em espera em “Registar mais tarde”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция ждёт в «Запишу потом»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёт дар «Баъдтар сабт кунед» интизор аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sonra Kaydet”te bir işlem bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція очікує в «Записати пізніше»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiya “Keyinroq qayd etish”da kutmoqda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“稍后记账”中有一笔交易等待处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「稍後記錄」中有一筆交易待處理。"
          }
        }
      }
    },
    "autoEntry.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yalnız baxış” aktivdir: heç nə qeyd edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключаны рэжым «Толькі прагляд»: нічога не запісана."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zapnuto „Pouze prohlížení“: nic se nezapisuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur ansehen“ ist eingeschaltet: Nichts wird erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“View only” is on: nothing is recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo ver» está activado: no se registra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Consultation seule » est activé : rien n'est noté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացված է «Միայն դիտում» ռեժիմը․ ոչինչ չի գրանցվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Solo visualizzazione” è attivo: non viene registrato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「表示のみ」がオンのため、記録されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართულია „მხოლოდ ნახვა“: არაფერი ჩაიწერება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Тек көру» қосулы: ештеңе жазылмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“보기 전용”이 켜져 있어 기록되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“Көрүү гана” күйгүзүлгөн: эч нерсе жазылбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Alleen bekijken’ staat aan: er wordt niets geboekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączono „Tylko do odczytu”. Nic nie jest zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Somente visualização” está ativado: nada é registrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Apenas visualização” está ativado: nada é registado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено «Только просмотр»: ничего не записывается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«Танҳо дидан» фаъол аст: чизе сабт намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yalnızca Görüntüle” açık: Hiçbir şey kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено «Лише перегляд»: нічого не записується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Faqat ko‘rish” yoqilgan: hech narsa qayd etilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启“仅查看”，不会记录任何交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟「僅供檢視」：不會記錄任何交易。"
          }
        }
      }
    },
    "autoEntry.settings.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qısayollar vasitəsilə ötürülən mesaj (“Bank mesajını ötür”) əməliyyata çevrilir. Təklif et: bildiriş “Qeyd edilsin?” deyə soruşur və əməliyyat “Sonra qeyd et” bölməsində gözləyir. Dərhal: əməliyyat daxiletmə sətrindəki kimi qeyd edilir; sətir əlavə məlumat soruşardısa, əməliyyat təklif edilir. Yalnız məbləğ, mağaza, kart və balans saxlanılır — mesajın özü heç vaxt saxlanılmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паведамленне, перададзенае праз Shortcuts («Перадаць паведамленне банка»), становіцца аперацыяй. Пры прапанове запісу апавяшчэнне пытаецца «Запісаць?», а аперацыя чакае ў «Запісаць пазней». Пры імгненным запісе аперацыя запісваецца як праз радок уводу; калі радок запытаў бы ўдакладненне, прапануецца запіс. Захоўваюцца толькі сума, крама, карта і баланс — само паведамленне ніколі не захоўваецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpráva předaná aplikací Zkratky („Předat bankovní zprávu“) se změní na operaci. Nabídnout: oznámení se zeptá „Zapsat?“ a operace počká v „Zapsat později“. Ihned: zapíše se stejně jako při zadání do řádku; pokud by se řádek na něco zeptal, nabídne se místo toho k zápisu. Ukládá se jen částka, obchod, karta a zůstatek — nikdy samotná zpráva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Nachricht, die über den Kurzbefehl „Bank-Nachricht übergeben“ weitergereicht wird, wird zu einem Vorgang. Vorschlagen: Eine Mitteilung fragt „Erfassen?“, und der Vorgang wartet unter „Später erfassen“. Sofort: Er wird so erfasst, wie die Eingabezeile ihn erfasst; würde die Zeile etwas nachfragen, wird stattdessen vorgeschlagen. Behalten werden nur Betrag, Geschäft, Karte und Saldo — nie die Nachricht selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A message passed on by Shortcuts (“Pass a bank message”) becomes an operation. Offered: a notification asks “Record?” and the operation waits in “Record later”. At once: it is recorded the way the entry line records it; if the line would ask something, it is offered instead. Only the amount, the shop, the card and the balance are kept — never the message itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mensaje que pasa Atajos («Pasar un mensaje del banco») se convierte en una operación. Ofrecer: una notificación pregunta «¿Registrar?» y la operación espera en «Registrar más tarde». Al momento: se registra como lo registraría la línea de entrada; si la línea preguntaría algo, se ofrece en su lugar. Solo se guardan el importe, la tienda, la tarjeta y el saldo, nunca el mensaje en sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un message transmis par Raccourcis (« Transmettre un message de banque ») devient une opération. Proposé : une notification demande « Noter ? » et l'opération attend dans « Noter plus tard ». Tout de suite : elle est notée comme la ligne de saisie la note ; si la ligne demanderait une précision, elle est proposée à la place. Seuls le montant, le magasin, la carte et le solde sont conservés — jamais le message lui-même."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts-ով փոխանցված հաղորդագրությունը («Փոխանցել բանկի հաղորդագրությունը») դառնում է գործարք։ Առաջարկելիս ծանուցումը հարցնում է «Գրանցե՞լ», իսկ գործարքը սպասում է «Գրանցել ավելի ուշ» բաժնում։ Անմիջապես գրանցելիս այն գրանցվում է այնպես, ինչպես մուտքագրման տողում․ եթե տողում լրացուցիչ հարց առաջանար, գործարքն առաջարկվում է գրանցել ավելի ուշ։ Պահվում են միայն գումարը, խանութը, քարտը և մնացորդը․ հաղորդագրությունը երբեք չի պահվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un messaggio inoltrato da Comandi Rapidi (“Inoltra un messaggio bancario”) diventa un’operazione. Con conferma: una notifica chiede se registrarla e l’operazione resta in “Registra più tardi”. Subito: viene registrata come dalla riga di inserimento; se sono necessarie altre informazioni, viene richiesta conferma. Vengono conservati solo importo, negozio, carta e saldo, mai il messaggio stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット（「銀行からのメッセージを渡す」）で渡されたメッセージから取引を作成します。「記録を提案」では、通知で記録するか確認し、取引を「あとで記録」に追加します。「すぐに記録」では、入力欄と同じ方法で記録します。入力欄で確認が必要な場合は、記録を提案します。保存されるのは金額、店舗、カード、残高のみで、メッセージ自体は保存されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts-ით გადაცემული შეტყობინება („საბანკო შეტყობინების გადაცემა“) ოპერაციად იქცევა. შეთავაზებისას შეტყობინება გკითხავთ „ჩაიწეროს?“ და ოპერაცია დაელოდება „მოგვიანებით ჩაწერაში“. მყისიერი ჩაწერისას ოპერაცია ისე ჩაიწერება, როგორც შეყვანის ველით ჩაწერისას; თუ ველი დამატებით კითხვას დასვამდა, ჩაწერა შემოგეთავაზებათ. ინახება მხოლოდ თანხა, მაღაზია, ბარათი და ნაშთი — თავად შეტყობინება არასოდეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Жылдам команда» арқылы берілген хабарлама («Банк хабарламасын өткізу») операцияға айналады. Ұсынылса: хабарландыру «Жазайын ба?» деп сұрайды, ал операция «Кейін жазу» ішінде күтеді. Бірден: енгізу жолы сияқты жазылады; жол бірдеңе сұраса, оның орнына ұсынылады. Тек сома, дүкен, карта және теңгерім сақталады — хабарламаның өзі ешқашан сақталмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어의 “은행 메시지 전달”로 전달된 메시지가 거래가 됩니다. 기록 제안: 알림에서 기록 여부를 묻고 거래는 “나중에 기록”에서 대기합니다. 바로 기록: 입력란과 같은 방식으로 기록하며, 추가 확인이 필요한 경우 기록을 제안합니다. 금액, 가맹점, 카드, 잔액만 보관하며 메시지 자체는 보관하지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts аркылуу өткөрүлгөн билдирүү (“Банк билдирүүсүн өткөрүү”) операцияга айланат. Сунуштоо: эскертме “Жазылсынбы?” деп сурайт, операция “Кийин жазууда” күтөт. Дароо: операция киргизүү сабындагыдай жазылат; сабы суроо бере турган болсо, операция сунушталат. Сумма, дүкөн, карта жана калдык гана сакталат — билдирүүнүн өзү сакталбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bericht dat via Opdrachten wordt doorgegeven (‘Geef een bankbericht door’) wordt een transactie. Bij voorstellen vraagt een melding ‘Boeken?’ en wacht de transactie in ‘Boek later’. Bij direct boeken wordt de transactie geboekt zoals via de invoerregel. Als de invoerregel om meer informatie zou vragen, wordt de transactie alsnog voorgesteld. Alleen het bedrag, de winkel, de kaart en het saldo worden bewaard, nooit het bericht zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomość przekazana przez Skróty („Przekaż wiadomość bankową”) staje się operacją. Propozycja: powiadomienie pyta „Zapisać?”, a operacja czeka w „Zapisz później”. Od razu: operacja jest zapisywana tak jak w wierszu wpisu; jeśli wymaga dodatkowych informacji, pojawia się propozycja zapisu. Zachowywane są tylko kwota, sklep, karta i saldo — nigdy sama wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mensagem encaminhada pelo Atalhos (“Encaminhar mensagem bancária”) se torna uma operação. Ao oferecer, uma notificação pergunta “Registrar?” e a operação aguarda em “Registrar depois”. Ao registrar imediatamente, ela é registrada como na linha de lançamento; se a linha precisar de mais informações, a operação será oferecida. Apenas o valor, a loja, o cartão e o saldo são mantidos — nunca a mensagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mensagem transmitida pela app Atalhos (“Transmitir mensagem bancária”) torna-se numa operação. Ao propor o registo, uma notificação pergunta “Registar?” e a operação fica em “Registar mais tarde”. Ao registar de imediato, a operação é registada como na linha de introdução; se for necessário pedir mais informações, é proposta para registo. Apenas são guardados o valor, a loja, o cartão e o saldo, nunca a mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение, переданное «Быстрыми командами» («Передать сообщение банка»), становится операцией. «Предлагать»: уведомление спрашивает «Записать?», операция ждёт в «Запишу потом». «Сразу»: записывается, как строка ввода; если строка что-то спросила бы — предлагается. Хранятся только сумма, место, карта и остаток — сам текст сообщения нигде не хранится."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паёме, ки Shortcuts («Интиқоли паёми бонк») мефиристад, ба амалиёт табдил меёбад. Бо пешниҳод: огоҳинома мепурсад «Сабт шавад?» ва амалиёт дар «Баъдтар сабт кунед» интизор мемонад. Дарҳол: он мисли сатри сабт сабт мешавад; агар сатр саволе диҳад, сабт пешниҳод мешавад. Танҳо маблағ, мағоза, корт ва бақия нигоҳ дошта мешаванд — худи паём ҳеҷ гоҳ нигоҳ дошта намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler ile iletilen bir mesaj (“Banka Mesajını İlet”) işleme dönüşür. Kaydetmeyi öner: Bir bildirim “Kaydedilsin mi?” diye sorar ve işlem “Sonra Kaydet”te bekler. Hemen kaydet: İşlem, giriş satırındaki gibi kaydedilir; giriş satırı bir soru soracaksa bunun yerine kaydetme önerilir. Yalnızca tutar, mağaza, kart ve bakiye saklanır; mesajın kendisi asla saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення, передане через Команди («Передати повідомлення банку»), стає операцією. З пропозицією: сповіщення запитує «Записати?», а операція чекає в «Записати пізніше». Одразу: записується так само, як із рядка вводу; якщо рядок поставив би запитання, натомість буде пропозиція. Зберігаються лише сума, магазин, картка та залишок — ніколи саме повідомлення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts orqali uzatilgan xabar (“Bank xabarini uzatish”) operatsiyaga aylanadi. Taklif etish: bildirishnomada “Qayd etilsinmi?” deb so‘raladi va operatsiya “Keyinroq qayd etish”da kutadi. Darhol: operatsiya kiritish qatoridagi kabi qayd etiladi; agar qatorda biror savol tug‘ilsa, uni qayd etish taklif qilinadi. Faqat summa, do‘kon, karta va balans saqlanadi — xabarning o‘zi saqlanmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过“快捷指令”（“传入银行信息”）传入的信息会转换为交易。提议记账：通知会询问“记账吗？”，交易将在“稍后记账”中等待处理。立即记账：按照记账栏的方式记录；如果记账栏需要询问，会改为提议记账。仅保留金额、商家、卡片和余额，绝不保留信息本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑「傳送銀行訊息」傳送的訊息會轉為交易。選擇「建議記錄」時，通知會詢問「要記錄嗎？」，交易會在「稍後記錄」中等待。選擇「立即記錄」時，交易會以輸入列的方式記錄；若輸入列需要詢問，則改為建議記錄。只會保留金額、商店、卡片和餘額，不會保留訊息本身。"
          }
        }
      }
    },
