    "autoEntry.formats.folder.footer": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney не змяшчае файлаў фарматаў і нічога не спампоўвае: праграма чытае выбраную папку. Папка запамінаецца толькі на гэтай прыладзе і не ўваходзіць у архіў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney enthält keine Formatdateien und lädt nichts herunter. Die Dateien werden aus dem ausgewählten Ordner gelesen. Der Ordner wird nur auf diesem Gerät gespeichert und ist nicht Teil des Archivs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ships no format files and downloads nothing: it reads the folder you chose. The folder is remembered on this device only and is not part of the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney no incluye archivos de formato ni descarga nada: lee la carpeta que elijas. La carpeta solo se recuerda en este dispositivo y no forma parte del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ne fournit aucun fichier de format et ne télécharge rien : l’app lit le dossier choisi. Ce dossier est mémorisé sur cet appareil uniquement et ne fait pas partie de l’archive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney non include file di formato e non scarica nulla: legge la cartella scelta. La cartella viene salvata solo su questo dispositivo e non fa parte dell’archivio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney формат файлдарын қамтымайды және ештеңе жүктемейді: ол сіз таңдаған қалтаны оқиды. Қалта тек осы құрылғыда есте сақталады және архивке кірмейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney nie zawiera plików formatów i niczego nie pobiera. Odczytuje wybrany folder. Wybór jest zapamiętywany tylko na tym urządzeniu i nie jest częścią archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney não inclui arquivos de formato nem baixa nada: ele lê a pasta que você escolheu. A pasta é lembrada apenas neste dispositivo e não faz parte do arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney не поставляет файлы форматов и ничего не скачивает: читается папка, которую вы выбрали. Она запоминается только на этом Mac и в архив не попадает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney biçim dosyaları içermez ve hiçbir şey indirmez; seçtiğiniz klasörü okur. Klasör yalnızca bu aygıtta hatırlanır ve arşive dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney не містить файлів форматів і нічого не завантажує: програма читає вибрану вами папку. Папка запам’ятовується лише на цьому пристрої та не входить до архіву."
          }
        }
      }
    },
