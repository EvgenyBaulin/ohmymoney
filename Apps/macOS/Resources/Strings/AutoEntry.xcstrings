    "autoEntry.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключаны рэжым «Толькі прагляд»: нічога не запісана."
          }
        },
        "de": {
