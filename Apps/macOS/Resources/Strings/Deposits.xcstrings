{
  "sourceLanguage": "en",
  "strings": {
    "crypto.coin.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name CoinGecko knows the coin by: bitcoin, ethereum, tether. No more than 4 digits after the point: money is kept to 1/10,000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так монету называет CoinGecko: bitcoin, ethereum, tether. Знаков после запятой — не больше 4: деньги хранятся с точностью до 1/10 000."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва, під якою CoinGecko знає монету: bitcoin, ethereum, tether. Не більше 4 знаків після коми: гроші зберігаються з точністю до 1/10 000."
          }
        }
      }
    },
    "crypto.coin.id": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coin id"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор монеты"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідентифікатор монети"
          }
        }
      }
    },
    "crypto.coin.refusal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coin id is lower-case Latin letters, digits and hyphens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор монеты — строчные латинские буквы, цифры и дефис."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідентифікатор монети — малі латинські літери, цифри й дефіси."
          }
        }
      }
    },
