    "crypto.source.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "api.coingecko.com ünvanına yalnız sikkənin ID-si və valyuta (rubl) göndərilir. İnternet olmayanda son məzənnə tarixi ilə saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На api.coingecko.com адпраўляюцца толькі ID манеты і валюта (рублі). Без сеткі захоўваецца апошні курс з датай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An api.coingecko.com werden nur die ID der Münze und die Währung (Rubel) gesendet. Ohne Netz bleibt der letzte Kurs mit seinem Datum stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the id of the coin and the currency (rubles) are sent to api.coingecko.com. Without a network the last rate stays, with its date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A api.coingecko.com solo se envían el id de la moneda y la divisa (rublos). Sin red se conserva el último tipo, con su fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls l'identifiant de la pièce et la devise (roubles) sont envoyés à api.coingecko.com. Sans réseau, le dernier cours reste, avec sa date."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "api.coingecko.com-ին ուղարկվում են միայն մետաղադրամի ID-ն և արժույթը (ռուբլի)։ Առանց ցանցի պահպանվում է վերջին փոխարժեքն ու դրա ամսաթիվը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A api.coingecko.com vengono inviati solo l’ID della valuta e la valuta di riferimento (rubli). Senza rete resta l’ultimo cambio, con la relativa data."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "api.coingecko.com-ს მხოლოდ მონეტის ID და ვალუტა (რუბლი) გადაეცემა. ქსელის გარეშე ბოლო კურსი თარიღთან ერთად ინახება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "api.coingecko.com-ға тек монетаның id-сі мен валюта (рубль) жіберіледі. Желі жоқ болса, соңғы бағам күнімен бірге қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "api.coingecko.com дарегине монетанын ID'си жана валюта (рубль) гана жөнөтүлөт. Тармак жок болсо, акыркы курс датасы менен сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do api.coingecko.com wysyłane są tylko identyfikator monety i waluta (ruble). Bez połączenia zachowywany jest ostatni kurs wraz z datą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o ID da moeda e a divisa (rublos) são enviados a api.coingecko.com. Sem rede, a última cotação e sua data são mantidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На api.coingecko.com уходит только идентификатор монеты и валюта (рубли). Без сети остаётся последний курс с его датой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба api.coingecko.com танҳо ID-и асъор ва воҳиди пулӣ (рубл) фиристода мешаванд. Бе шабака қурби охирин бо санааш мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "api.coingecko.com adresine yalnızca coin kimliği ve para birimi (ruble) gönderilir. Bağlantı olmadığında son kur ve tarihi korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На api.coingecko.com надсилаються лише ідентифікатор монети та валюта (рублі). Без мережі лишається останній курс із його датою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "api.coingecko.com saytiga faqat tanga IDsi va valyuta (rubl) yuboriladi. Tarmoqsiz oxirgi kurs va uning sanasi saqlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅將幣種 ID 和貨幣（盧布）傳送至 api.coingecko.com。無網路連線時，會保留上次的匯率及日期。"
          }
        }
      }
    },
