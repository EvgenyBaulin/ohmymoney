    "dep.diverge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates differ: %1$@ — %2$@%%, %3$@ — %4$@%%. Worth checking on the bank's site."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tipos difieren: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Conviene comprobarlo en la web del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux diffèrent : %1$@ — %2$@ %%, %3$@ — %4$@ %%. À vérifier sur le site de la banque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки расходятся: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Стоит проверить на сайте банка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки відрізняються: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Варто перевірити на сайті банку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tassi differiscono: %1$@ — %2$@%%, %3$@ — %4$@%%. Verifica sul sito della banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөлшерлемелер өзгеше: %1$@ — %2$@%%, %3$@ — %4$@%%. Банктің сайтында тексеру керек."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стаўкі адрозніваюцца: %1$@ — %2$@%%, %3$@ — %4$@%%. Праверце на сайце банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sätze weichen ab: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Lohnt einen Blick auf die Seite der Bank."
          }
        }
      }
    },
