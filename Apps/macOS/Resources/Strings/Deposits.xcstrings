    "crypto.source.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An api.coingecko.com werden nur die ID der Münze und die Währung (Rubel) gesendet. Ohne Netz bleibt der letzte Kurs mit seinem Datum stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the id of the coin and the currency (rubles) are sent to api.coingecko.com. Without a network the last rate stays, with its date."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "api.coingecko.com-ға тек монетаның id-сі мен валюта (рубль) жіберіледі. Желі жоқ болса, соңғы бағам күнімен бірге қалады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На api.coingecko.com уходит только идентификатор монеты и валюта (рубли). Без сети остаётся последний курс с его датой."
          }
        }
      }
    },
