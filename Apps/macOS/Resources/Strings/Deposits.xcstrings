          }
        }
      }
    },
    "crypto.coin.refusal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coin id is lower-case Latin letters, digits and hyphens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El id de la moneda son letras latinas minúsculas, cifras y guiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identifiant de la pièce : lettres latines minuscules, chiffres et tirets."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор монеты — строчные латинские буквы, цифры и дефис."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідентифікатор монети — малі латинські літери, цифри й дефіси."
          }
        }
      }
    },
