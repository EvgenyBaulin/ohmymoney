    "dep.cbr.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchschnittlich höchster Satz auf Rubel-Einlagen der zehn Banken mit den meisten Einlagen: %1$@ %% pro Jahr, Stand %2$@. Ein Anhaltspunkt für den Markt, nicht der Satz einer Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average highest rate on rouble deposits of the ten banks with the most deposits: %1$@%% a year, from %2$@. A guide to the market, not the rate of any bank."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең көп салымы бар он банктің рубль салымдары бойынша орташа ең жоғары мөлшерлеме: жылына %1$@%%, %2$@ бастап. Нарыққа бағдар, кез келген банктің мөлшерлемесі емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средняя максимальная ставка по вкладам в рублях десяти банков с наибольшим объёмом вкладов: %1$@ %% годовых, с %2$@. Это ориентир рынка, а не ставка какого-либо банка."
          }
        }
      }
    },
    "dep.cbr.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Bank of Russia"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "According to the Bank of Russia"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресей Банкі бойынша"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По данным Банка России"
          }
        }
      }
    },
    "dep.diverge": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sätze weichen ab: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Lohnt einen Blick auf die Seite der Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates differ: %1$@ — %2$@%%, %3$@ — %4$@%%. Worth checking on the bank's site."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөлшерлемелер өзгеше: %1$@ — %2$@%%, %3$@ — %4$@%%. Банктің сайтында тексеру керек."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки расходятся: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Стоит проверить на сайте банка."
          }
        }
      }
    },
