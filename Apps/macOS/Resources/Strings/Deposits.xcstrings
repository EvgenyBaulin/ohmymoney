{
  "sourceLanguage": "en",
  "strings": {
    "crypto.coin.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name, unter dem CoinGecko die Münze kennt: bitcoin, ethereum, tether. Höchstens 4 Stellen nach dem Komma: Geld wird auf 1/10.000 genau geführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name CoinGecko knows the coin by: bitcoin, ethereum, tether. No more than 4 digits after the point: money is kept to 1/10,000."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "CoinGecko монетаны қалай таниды: bitcoin, ethereum, tether. Үтірден кейін 4 таңбадан көп емес: ақша 1/10 000-ге дейін сақталады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так монету называет CoinGecko: bitcoin, ethereum, tether. Знаков после запятой — не больше 4: деньги хранятся с точностью до 1/10 000."
          }
        }
      }
    },
    "crypto.coin.id": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Münzen-ID"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coin id"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Монета id"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор монеты"
          }
        }
      }
    },
    "crypto.coin.refusal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Münzen-ID besteht aus Kleinbuchstaben, Ziffern und Bindestrichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coin id is lower-case Latin letters, digits and hyphens."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Монета id — кіші латын әріптері, сандар және дефис."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор монеты — строчные латинские буквы, цифры и дефис."
          }
        }
      }
    },
