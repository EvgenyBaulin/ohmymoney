    "dep.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankların hazırkı təklifləri, faiz sırası ilə. Maliyyə məsləhəti deyil: şərtləri bankın saytında yoxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуальныя прапановы банкаў па стаўцы. Гэта не фінансавая парада: праверце ўмовы на сайце банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Banken jetzt veröffentlichen, nach Satz. Keine Finanzberatung: Prüfen Sie die Bedingungen auf der Website der Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What banks publish now, by rate. Not financial advice: check the terms on the bank's website."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que publican los bancos ahora, por tipo. No es asesoramiento financiero: revise las condiciones en la web del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que publient les banques aujourd'hui, par taux. Ce n'est pas un conseil financier : vérifiez les conditions sur le site de la banque."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկերի ընթացիկ առաջարկները՝ ըստ տոկոսադրույքի։ Ֆինանսական խորհուրդ չէ. ստուգեք պայմանները բանկի կայքում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le offerte attuali delle banche, ordinate per tasso. Non è una consulenza finanziaria: verifica le condizioni sul sito della banca."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკების მიმდინარე შეთავაზებები განაკვეთის მიხედვით. ეს არ არის ფინანსური რჩევა: პირობები ბანკის საიტზე გადაამოწმეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктер қазір мөлшерлеме бойынша не жариялап отыр. Қаржылық кеңес емес: шарттарды банктің сайтында тексеріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктардын учурдагы сунуштары, чен боюнча. Бул каржылык кеңеш эмес: шарттарды банктын сайтынан текшериңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualne oferty banków według oprocentowania. To nie jest porada finansowa: sprawdź warunki na stronie banku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofertas atuais dos bancos, por taxa. Não é aconselhamento financeiro: confira as condições no site do banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что банки публикуют сейчас, по ставке. Не финансовая консультация: условия проверяйте на сайте банка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пешниҳодҳои ҷории бонкҳо аз рӯи меъёр. Маслиҳати молиявӣ нест: шартҳоро дар сомонаи бонк санҷед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankaların güncel teklifleri, faize göre sıralanmıştır. Yatırım tavsiyesi değildir; koşulları bankanın sitesinden kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що банки публікують зараз, за ставкою. Це не фінансова порада: умови перевіряйте на сайті банку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Banklarning joriy takliflari, stavka bo‘yicha. Bu moliyaviy maslahat emas: shartlarni bank saytida tekshiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依利率排列的銀行目前公布方案。這不是財務建議，請至銀行網站確認條款。"
          }
        }
      }
    },
