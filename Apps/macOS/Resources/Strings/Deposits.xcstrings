    "dep.diverge": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faizlər fərqlənir: %1$@ — %2$@%%, %3$@ — %4$@%%. Bankın saytında yoxlamağa dəyər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стаўкі адрозніваюцца: %1$@ — %2$@%%, %3$@ — %4$@%%. Праверце на сайце банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sätze weichen ab: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Lohnt einen Blick auf die Seite der Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates differ: %1$@ — %2$@%%, %3$@ — %4$@%%. Worth checking on the bank's site."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tipos difieren: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Conviene comprobarlo en la web del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux diffèrent : %1$@ — %2$@ %%, %3$@ — %4$@ %%. À vérifier sur le site de la banque."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տոկոսադրույքները տարբերվում են՝ %1$@՝ %2$@%%, %3$@՝ %4$@%%։ Ստուգեք բանկի կայքում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tassi differiscono: %1$@ — %2$@%%, %3$@ — %4$@%%. Verifica sul sito della banca."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განაკვეთები განსხვავდება: %1$@ — %2$@%%, %3$@ — %4$@%%. გადაამოწმეთ ბანკის საიტზე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөлшерлемелер өзгеше: %1$@ — %2$@%%, %3$@ — %4$@%%. Банктің сайтында тексеру керек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чендер айырмаланат: %1$@ — %2$@%%, %3$@ — %4$@%%. Банктын сайтынан текшериңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprocentowanie się różni: %1$@ — %2$@%%, %3$@ — %4$@%%. Warto sprawdzić na stronie banku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As taxas diferem: %1$@ — %2$@%%, %3$@ — %4$@%%. Confira no site do banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки расходятся: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Стоит проверить на сайте банка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Меъёрҳо фарқ мекунанд: %1$@ — %2$@%%, %3$@ — %4$@%%. Дар сомонаи бонк санҷед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faizler farklı: %1$@ — %2$@%%, %3$@ — %4$@%%. Bankanın sitesinden kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки відрізняються: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Варто перевірити на сайті банку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavkalar farq qiladi: %1$@ — %2$@%%, %3$@ — %4$@%%. Bank saytida tekshirib ko‘ring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "利率有差異：%1$@ — %2$@%%、%3$@ — %4$@%%。建議前往銀行網站確認。"
          }
        }
      }
    },
