          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ավանդի ժամկետն ավարտվում է %2$@։ Այժմ ցուցափեղկում են (ֆինանսական խորհուրդ չէ)՝"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il deposito “%1$@” scade il %2$@. Offerte attuali (non è una consulenza finanziaria):"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანაბრის „%1$@“ ვადა იწურება %2$@. მიმდინარე შეთავაზებები (ეს არ არის ფინანსური რჩევა):"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” салымының мерзімі %2$@ аяқталады. Қазір витринада (қаржылық кеңес емес):"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» депозитинин мөөнөтү %2$@ күнү бүтөт. Витринадагы учурдагы сунуштар (каржылык кеңеш эмес):"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokata „%1$@” kończy się %2$@. Aktualne oferty (to nie jest porada finansowa):"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O depósito “%1$@” vence em %2$@. Ofertas atuais (não é aconselhamento financeiro):"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклад «%1$@» кончится %2$@. Сейчас в витрине (не финансовая консультация):"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муҳлати пасандози “%1$@” дар %2$@ ба охир мерасад. Пешниҳодҳои ҷорӣ (маслиҳати молиявӣ нест):"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” mevduatının vadesi %2$@ tarihinde doluyor. Güncel teklifler (yatırım tavsiyesi değildir):"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Депозит «%1$@» закінчується %2$@. Зараз на вітрині (це не фінансова порада):"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” omonati %2$@ sanasida tugaydi. Hozirgi takliflar (moliyaviy maslahat emas):"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存款「%1$@」將於 %2$@ 到期。目前的存款方案如下（非財務建議）："
          }
        }
      }
    },
