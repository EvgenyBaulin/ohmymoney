    "dep.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What banks publish now, by rate. Not financial advice: check the terms on the bank's website."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que publican los bancos ahora, por tipo. No es asesoramiento financiero: revise las condiciones en la web del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que publient les banques aujourd'hui, par taux. Ce n'est pas un conseil financier : vérifiez les conditions sur le site de la banque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что банки публикуют сейчас, по ставке. Не финансовая консультация: условия проверяйте на сайте банка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що банки публікують зараз, за ставкою. Це не фінансова порада: умови перевіряйте на сайті банку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le offerte attuali delle banche, ordinate per tasso. Non è una consulenza finanziaria: verifica le condizioni sul sito della banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктер қазір мөлшерлеме бойынша не жариялап отыр. Қаржылық кеңес емес: шарттарды банктің сайтында тексеріңіз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуальныя прапановы банкаў па стаўцы. Гэта не фінансавая парада: праверце ўмовы на сайце банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Banken jetzt veröffentlichen, nach Satz. Keine Finanzberatung: Prüfen Sie die Bedingungen auf der Website der Bank."
          }
        }
      }
    },
