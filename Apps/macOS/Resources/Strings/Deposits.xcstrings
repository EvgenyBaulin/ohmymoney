    "payout.noAssets": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapital bölməsində hələ investisiya yoxdur: orada əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У раздзеле «Капітал» пакуль няма інвестыцый. Дадайце іх там."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Kapital gibt es noch keine Geldanlagen: Legen Sie dort eine an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No investments in Capital yet: add one there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay inversiones en Capital: añada una allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de placement dans « Capital » : ajoutez-en un là-bas."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կապիտալում դեռ ներդրումներ չկան. ավելացրեք այնտեղ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun investimento in Capitale. Aggiungine uno lì."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კაპიტალში ინვესტიციები ჯერ არ არის: დაამატეთ იქ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Капиталда» әлі инвестиция жоқ: сол жерден қосыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Капиталда» азырынча инвестиция жок: ал жакка кошуңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak inwestycji w Kapitale. Dodaj tam inwestycję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há investimentos em Capital. Adicione um lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Капитале» ещё нет вложений: добавьте там."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар «Сармоя» ҳанӯз сармоягузорӣ нест: онро дар он ҷо илова кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sermaye'de henüz yatırım yok. Önce bir yatırım ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Капіталі» інвестицій поки немає: додайте їх там."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapitalda hali investitsiyalar yo‘q. Avval u yerga qo‘shing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「資產」中尚無投資，請先加入。"
          }
        }
      }
    },
    "payout.none": {
