    "dep.cbr.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average highest rate on rouble deposits of the ten banks with the most deposits: %1$@%% a year, from %2$@. A guide to the market, not the rate of any bank."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средняя максимальная ставка по вкладам в рублях десяти банков с наибольшим объёмом вкладов: %1$@ %% годовых, с %2$@. Это ориентир рынка, а не ставка какого-либо банка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середня найвища ставка за рублевими депозитами десяти банків з найбільшою кількістю вкладів: %1$@ %% на рік, станом на %2$@. Орієнтир для ринку, а не ставка жодного банку."
          }
        }
      }
    },
    "dep.cbr.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "According to the Bank of Russia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По данным Банка России"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За даними Банку Росії"
          }
        }
      }
    },
    "dep.diverge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates differ: %1$@ — %2$@%%, %3$@ — %4$@%%. Worth checking on the bank's site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки расходятся: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Стоит проверить на сайте банка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки відрізняються: %1$@ — %2$@ %%, %3$@ — %4$@ %%. Варто перевірити на сайті банку."
          }
        }
      }
