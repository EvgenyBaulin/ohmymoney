    "payout.recurringHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər altı aydan bir alınan kupon müntəzəm gəlirdir: yuxarıda “Müntəzəm” seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Купон кожныя паўгода — гэта рэгулярны даход: выберыце “Рэгулярны” вышэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kupon, der alle halbe Jahre kommt, ist eine regelmäßige Einnahme: Wählen Sie oben „Regelmäßig“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A coupon that comes every half-year is a regular income: pick “Regular” above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cupón que llega cada medio año es un ingreso periódico: elija «Periódico» arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coupon qui revient chaque semestre est un revenu régulier : choisissez « Régulier » ci-dessus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կես տարին մեկ ստացվող կտրոնը կանոնավոր եկամուտ է. վերևում ընտրեք «Կանոնավոր»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cedola semestrale è un’entrata regolare: scegli “Regolare” sopra."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნახევარ წელიწადში ერთხელ მიღებული კუპონი რეგულარული შემოსავალია: ზემოთ აირჩიეთ „რეგულარული“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жарты жылда бір келетін купон — тұрақты табыс: жоғарыдан «Тұрақты» таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар жарым жылда түшкөн купон — туруктуу киреше: жогорудан «Туруктуу» дегенди тандаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupon wypłacany co pół roku to regularny przychód: wybierz powyżej „Regularny”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cupom semestral é uma receita recorrente: selecione “Regular” acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Купон раз в полгода — регулярное поступление: выберите «Регулярный» выше."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Купоне, ки ҳар нимсола пардохт мешавад, даромади мунтазам аст: дар боло “Мунтазам”-ро интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altı ayda bir gelen kupon düzenli gelirdir: Yukarıdan “Düzenli”yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Купон, що приходить раз на півроку, — регулярний дохід: оберіть вище «Регулярний»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har yarim yilda tushadigan kupon muntazam daromad hisoblanadi: yuqorida “Muntazam”ni tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每半年支付的債券利息屬於定期收入：請在上方選擇「定期」。"
          }
        }
      }
    },
