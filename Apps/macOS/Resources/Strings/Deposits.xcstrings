    "dep.version": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank siyahısı %@ tarixində oxunub; hər buraxılışda yenilənir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спіс банкаў ад %@; ён абнаўляецца з кожным выпускам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankliste gelesen am %@; sie wird mit jeder Version aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank list read on %@; it is updated with each release."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de bancos leída el %@; se actualiza con cada versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste des banques lue le %@ ; elle est mise à jour à chaque version."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկերի ցանկը՝ %@ դրությամբ. թարմացվում է յուրաքանչյուր թողարկման հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenco delle banche consultato il %@; viene aggiornato a ogni versione."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკების სიის თარიღი: %@; სია ყოველი გამოშვებისას ახლდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк тізімі %@ күні оқылды; әр шығарылымда жаңартылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктардын тизмеси %@ күнү алынган; ал ар бир чыгарылышта жаңыртылат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista banków z dnia %@; jest uaktualniana z każdym wydaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de bancos consultada em %@; atualizada a cada versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список банков прочитан %@; обновляется с выпуском приложения."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рӯйхати бонкҳо то %@; бо ҳар нашр нав мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka listesi %@ tarihinde alındı; her sürümde güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список банків прочитано %@; оновлюється з кожним випуском."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Banklar ro‘yxati %@ sanasida olingan; har bir versiyada yangilanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行列表讀取於 %@；每次發行新版本時更新。"
          }
        }
      }
    },
    "look.depositEnds": {
      "extractionState": "manual",
      "localizations": {
