    "crypto.coin.refusal": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkə ID-si kiçik latın hərflərindən, rəqəmlərdən və defislərdən ibarətdir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "ID манеты складаецца з малых лацінскіх літар, лічбаў і злучкоў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Münzen-ID besteht aus Kleinbuchstaben, Ziffern und Bindestrichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coin id is lower-case Latin letters, digits and hyphens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El id de la moneda son letras latinas minúsculas, cifras y guiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identifiant de la pièce : lettres latines minuscules, chiffres et tirets."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մետաղադրամի ID-ն պարունակում է լատինական փոքրատառեր, թվեր և գծիկներ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ID valuta contiene lettere latine minuscole, cifre e trattini."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონეტის ID შეიცავს ლათინურ პატარა ასოებს, ციფრებსა და დეფისებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Монета id — кіші латын әріптері, сандар және дефис."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Монетанын ID'си кичине латын тамгаларынан, сандардан жана дефистерден турат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identyfikator monety może zawierać małe litery łacińskie, cyfry i łączniki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID da moeda contém letras latinas minúsculas, números e hífens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор монеты — строчные латинские буквы, цифры и дефис."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "ID-и асъор аз ҳарфҳои хурди лотинӣ, рақамҳо ва дефис иборат аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coin kimliği küçük Latin harfleri, rakamlar ve kısa çizgilerden oluşur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідентифікатор монети — малі латинські літери, цифри й дефіси."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanga IDsi kichik lotin harflari, raqamlar va defislardan iborat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幣種 ID 只能包含小寫英文字母、數字和連字號。"
          }
        }
      }
    },
