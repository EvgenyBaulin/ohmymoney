          "stringUnit": {
            "state": "translated",
            "value": "Ստանալ տոկոսադրույքները բաց աղբյուրներից (Mac-ից ուղարկվում է միայն էջի հարցումը)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni i tassi da fonti pubbliche (dal Mac viene inviata solo la richiesta della pagina)"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განაკვეთების მიღება ღია წყაროებიდან (Mac-იდან მხოლოდ გვერდის მოთხოვნა იგზავნება)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашық көздерден мөлшерлемелерді алу (Mac-тан тек бетке сұрау шығады)"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чендерди ачык булактардан алуу (Mac'тен баракка сурам гана жөнөтүлөт)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieraj oprocentowanie z publicznych źródeł (z Maca wysyłane jest tylko żądanie strony)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obter taxas de fontes públicas (apenas a solicitação da página sai do Mac)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Брать ставки из открытых источников (в сеть уходит только запрос страницы)"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гирифтани меъёрҳо аз манбаъҳои кушод (аз Mac танҳо дархости саҳифа фиристода мешавад)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faizleri açık kaynaklardan al (Mac'ten yalnızca sayfa isteği gönderilir)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Брати ставки з відкритих джерел (з Mac іде лише запит сторінки)"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavkalarni ochiq manbalardan olish (Mac'dan faqat sahifa so‘rovi yuboriladi)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從公開來源取得利率（僅從 Mac 傳送頁面請求）"
          }
        }
      }
    },
