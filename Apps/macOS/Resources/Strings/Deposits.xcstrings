    "dep.cbr.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən çox əmanəti olan on bankın rubl əmanətləri üzrə orta maksimal faizi: illik %1$@%%, %2$@ tarixindən. Bu, bazar göstəricisidir və konkret banka aid deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сярэдняя максімальная стаўка па рублёвых укладах дзесяці банкаў з найбольшым аб’ёмам укладаў: %1$@%% гадавых на %2$@. Гэта арыенцір па рынку, а не стаўка канкрэтнага банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchschnittlich höchster Satz auf Rubel-Einlagen der zehn Banken mit den meisten Einlagen: %1$@ %% pro Jahr, Stand %2$@. Ein Anhaltspunkt für den Markt, nicht der Satz einer Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average highest rate on rouble deposits of the ten banks with the most deposits: %1$@%% a year, from %2$@. A guide to the market, not the rate of any bank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo máximo medio de los depósitos en rublos de los diez bancos con más depósitos: %1$@ %% anual, a %2$@. Una guía del mercado, no el tipo de ningún banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux maximal moyen sur les dépôts en roubles des dix banques qui en ont le plus : %1$@ %% par an, au %2$@. Un repère pour le marché, pas le taux d'une banque."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավանդների ամենամեծ ծավալն ունեցող տասը բանկերի ռուբլային ավանդների առավելագույն տոկոսադրույքների միջինը՝ տարեկան %1$@%%, %2$@ դրությամբ։ Շուկայի ցուցանիշ է, ոչ թե որևէ բանկի տոկոսադրույք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Media dei tassi massimi sui depositi in rubli delle dieci banche con più depositi: %1$@%% annuo, dal %2$@. È un indicatore di mercato, non il tasso di una banca."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანაბრების მოცულობით ათი უმსხვილესი ბანკის რუბლის ანაბრების საშუალო მაქსიმალური განაკვეთი: %1$@%% წელიწადში, %2$@-ის მდგომარეობით. ბაზრის ორიენტირია და არა რომელიმე ბანკის განაკვეთი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең көп салымы бар он банктің рубль салымдары бойынша орташа ең жоғары мөлшерлеме: жылына %1$@%%, %2$@ бастап. Нарыққа бағдар, кез келген банктің мөлшерлемесі емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Депозити эң көп он банктын рублдик депозиттери боюнча орточо максималдуу чен: жылына %1$@%%, %2$@ карата. Бул — рыноктун көрсөткүчү, банктын чени эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnia najwyższych oprocentowań lokat w rublach w dziesięciu bankach z największą wartością depozytów: %1$@%% rocznie, z dnia %2$@. Wskaźnik rynku, a nie oprocentowanie konkretnego banku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Média das maiores taxas de depósitos em rublos dos dez bancos com mais depósitos: %1$@%% ao ano, em %2$@. Uma referência do mercado, não a taxa de um banco específico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средняя максимальная ставка по вкладам в рублях десяти банков с наибольшим объёмом вкладов: %1$@ %% годовых, с %2$@. Это ориентир рынка, а не ставка какого-либо банка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Миёнаи қурби баландтарини пасандозҳои рублӣ дар даҳ бонки дорои пасандозҳои бештар: %1$@%% солона, аз %2$@. Нишондиҳандаи бозор аст, на қурби бонк."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok mevduata sahip on bankanın ruble mevduatlarına uyguladığı en yüksek faizlerin ortalaması: %2$@ itibarıyla yıllık %1$@%%. Piyasa hakkında fikir verir; herhangi bir bankanın faizi değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середня найвища ставка за рублевими депозитами десяти банків з найбільшою кількістю вкладів: %1$@ %% на рік, станом на %2$@. Орієнтир для ринку, а не ставка жодного банку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eng ko‘p omonatga ega o‘nta bankdagi rubl omonatlari bo‘yicha o‘rtacha eng yuqori stavka: yiliga %1$@%%, %2$@ holatiga. Bu bozor ko‘rsatkichi, biror bankning stavkasi emas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存款總額最高的十家銀行的盧布存款最高利率平均值：年利率 %1$@%%，資料日期為 %2$@。此數值僅供參考，並非任何銀行的利率。"
          }
        }
      }
    },
