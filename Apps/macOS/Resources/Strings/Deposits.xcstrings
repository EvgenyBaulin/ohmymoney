    "crypto.source.coingecko": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the network (CoinGecko)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из сети (CoinGecko)"
          }
        },
        "uk": {
