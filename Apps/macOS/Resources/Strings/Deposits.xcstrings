{
  "sourceLanguage": "en",
  "strings": {
    "crypto.coin.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name CoinGecko knows the coin by: bitcoin, ethereum, tether. No more than 4 digits after the point: money is kept to 1/10,000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre con el que CoinGecko conoce la moneda: bitcoin, ethereum, tether. No más de 4 cifras decimales: el dinero se guarda con precisión de 1/10 000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom sous lequel CoinGecko connaît la pièce : bitcoin, ethereum, tether. Pas plus de 4 chiffres après la virgule : l'argent est gardé au 1/10 000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так монету называет CoinGecko: bitcoin, ethereum, tether. Знаков после запятой — не больше 4: деньги хранятся с точностью до 1/10 000."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва, під якою CoinGecko знає монету: bitcoin, ethereum, tether. Не більше 4 знаків після коми: гроші зберігаються з точністю до 1/10 000."
          }
        }
      }
    },
    "crypto.coin.id": {
      "extractionState": "manual",
      "localizations": {
        "en": {
