    "crypto.source.coingecko": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the network (CoinGecko)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la red (CoinGecko)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis le réseau (CoinGecko)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из сети (CoinGecko)"
          }
        },
        "uk": {
