    "recovery.sheet.once": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vərəq bir dəfə göstərilir. Onu indi çap edin və ya sözləri qeyd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аркуш паказваецца адзін раз. Раздрукуйце яго або запішыце словы зараз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Blatt wird nur einmal gezeigt. Drucken Sie es aus oder schreiben Sie die Wörter jetzt auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sheet is shown once. Print it or write the words down now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hoja se muestra una sola vez. Imprímala o anote las palabras ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La feuille ne s'affiche qu'une fois. Imprimez-la ou notez les mots maintenant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թերթիկը ցուցադրվում է մեկ անգամ։ Տպեք այն կամ գրի առեք բառերը հիմա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il foglio viene mostrato una sola volta. Stampalo o annota subito le parole."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფურცელი მხოლოდ ერთხელ გამოჩნდება. დაბეჭდეთ ან ჩაიწერეთ სიტყვები ახლავე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Парақ бір рет көрсетіледі. Қазір басып шығарыңыз немесе сөздерді жазып алыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Барак бир жолу көрсөтүлөт. Азыр басып чыгарыңыз же сөздөрдү жазып алыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkusz jest wyświetlany tylko raz. Wydrukuj go lub zapisz teraz słowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta folha é exibida uma vez. Imprima-a ou anote as palavras agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A folha é apresentada uma só vez. Imprima-a ou anote as palavras agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лист показывается один раз. Распечатайте его или перепишите слова сейчас."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Варақа як бор нишон дода мешавад. Ҳозир онро чоп кунед ё калимаҳоро нависед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sayfa bir kez gösterilir. Şimdi yazdırın veya sözcükleri bir yere yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аркуш показується один раз. Надрукуйте його або запишіть слова зараз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Varaq bir marta ko‘rsatiladi. Uni hozir chop eting yoki so‘zlarni yozib oling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原表只會顯示一次。請立即列印或抄下復原詞。"
          }
        }
      }
    },
