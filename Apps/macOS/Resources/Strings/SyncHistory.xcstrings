    "recovery.key.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni mübadilə faylları şifrələnir. İlk cihazınızda mübadilədən əvvəl bərpa açarı yaradın. Digər cihazlarda eyni 24 sözü daxil edin. Şifrələmədən əvvəl yazılmış fayllar oxunaqlı qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Новыя файлы абмену шыфруюцца. На першай прыладзе стварыце ключ аднаўлення перад абменам. На іншых прыладах увядзіце тыя ж 24 словы. Файлы, створаныя да ўключэння шыфравання, застануцца даступнымі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Austauschdateien werden verschlüsselt. Erstellen Sie auf Ihrem ersten Gerät vor dem Austausch einen Wiederherstellungsschlüssel. Auf anderen Geräten geben Sie dieselben 24 Wörter ein. Vor der Verschlüsselung geschriebene Dateien bleiben lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New exchange files are encrypted. On your first device, create a recovery key before exchanging. On other devices, enter the same 24 words. Files written before encryption remain readable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos archivos de intercambio se cifran. En su primer dispositivo, cree una clave de recuperación antes de intercambiar. En los demás dispositivos, introduzca las mismas 24 palabras. Los archivos escritos antes del cifrado siguen siendo legibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux fichiers d'échange sont chiffrés. Sur votre premier appareil, créez une clé de récupération avant tout échange. Sur les autres appareils, saisissez les mêmes 24 mots. Les fichiers écrits avant le chiffrement restent lisibles."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխանակման նոր ֆայլերը գաղտնագրվում են։ Առաջին սարքում փոխանակումից առաջ ստեղծեք վերականգնման բանալի։ Մյուս սարքերում մուտքագրեք նույն 24 բառը։ Մինչ գաղտնագրումը ստեղծված ֆայլերը մնում են ընթեռնելի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi file di scambio sono crittografati. Sul primo dispositivo, crea una chiave di recupero prima di scambiare i file. Sugli altri dispositivi, inserisci le stesse 24 parole. I file scritti prima della crittografia restano leggibili."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალი გაცვლის ფაილები დაშიფრულია. გაცვლამდე პირველ მოწყობილობაზე შექმენით აღდგენის გასაღები. სხვა მოწყობილობებზე შეიყვანეთ იგივე 24 სიტყვა. დაშიფვრამდე შექმნილი ფაილები კვლავ იკითხება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа алмасу файлдары шифрланады. Бірінші құрылғыда алмасудан бұрын қалпына келтіру кілтін жасаңыз. Басқа құрылғыларда сол 24 сөзді енгізіңіз. Шифрлауға дейін жазылған файлдар оқыла береді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңы алмашуу файлдары шифрленет. Алмашуудан мурун биринчи түзмөгүңүздө калыбына келтирүү ачкычын түзүңүз. Башка түзмөктөргө ошол эле 24 сөздү киргизиңиз. Шифрлөөгө чейин жазылган файлдарды окууга болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe pliki wymiany są szyfrowane. Przed wymianą utwórz klucz odzyskiwania na pierwszym urządzeniu. Na pozostałych urządzeniach wpisz te same 24 słowa. Pliki zapisane przed włączeniem szyfrowania nadal można odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos arquivos de troca são criptografados. No primeiro dispositivo, crie uma chave de recuperação antes de fazer a troca. Nos outros dispositivos, digite as mesmas 24 palavras. Os arquivos criados antes da criptografia continuam legíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos ficheiros de troca são cifrados. No primeiro dispositivo, crie uma chave de recuperação antes de trocar ficheiros. Nos outros dispositivos, introduza as mesmas 24 palavras. Os ficheiros criados antes da cifragem continuam legíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые файлы обмена зашифрованы. На первом устройстве перед обменом создайте ключ восстановления. На других введите те же 24 слова. Файлы, записанные до шифрования, по-прежнему читаются."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлҳои нави мубодила рамзгузорӣ мешаванд. Дар дастгоҳи аввал пеш аз мубодила калиди барқарорсозӣ созед. Дар дастгоҳҳои дигар ҳамон 24 калимаро ворид кунед. Файлҳои пеш аз рамзгузорӣ сабтшуда хондашаванда мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni aktarım dosyaları şifrelenir. İlk aygıtınızda aktarımdan önce bir kurtarma anahtarı oluşturun. Diğer aygıtlarda aynı 24 sözcüğü girin. Şifrelemeden önce yazılan dosyalar okunabilir kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові файли обміну шифруються. На першому пристрої створіть ключ відновлення перед обміном. На інших введіть ті самі 24 слова. Файли, записані до шифрування, залишаються читабельними."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi almashuv fayllari shifrlanadi. Birinchi qurilmangizda almashishdan oldin tiklash kalitini yarating. Boshqa qurilmalarda shu 24 ta so‘zni kiriting. Shifrlashdan oldin yozilgan fayllarni o‘qish mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新的交換檔案會加密。在第一部裝置上，請先建立復原密鑰再交換資料。在其他裝置上，請輸入相同的 24 個復原詞。加密前寫入的檔案仍可讀取。"
          }
        }
      }
    },
