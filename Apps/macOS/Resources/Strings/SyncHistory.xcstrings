    "history.empty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змены гэтай аперацыі пакуль не запісаны. Гісторыя захоўваецца пачынаючы з версіі 2.9."
          }
        },
        "de": {
          "stringUnit": {
