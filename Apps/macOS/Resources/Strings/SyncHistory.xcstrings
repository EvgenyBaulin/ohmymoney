    "recovery.page.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 24 words are the key of the exchange between your devices. Keep the sheet as you keep a key: whoever has it can read the exchange's files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las 24 palabras son la clave del intercambio entre sus dispositivos. Guarde la hoja como guarda una llave: quien la tenga puede leer los archivos del intercambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 24 mots sont la clé de l'échange entre vos appareils. Conservez la feuille comme une clé : celui qui la possède peut lire les fichiers de l'échange."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "24 слова — это ключ обмена между вашими устройствами. Храните лист как ключ: тот, у кого он есть, может прочитать файлы обмена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "24 слова — ключ обміну між вашими пристроями. Зберігайте аркуш як ключ: кожен, хто має його, може читати файли обміну."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "24 сөз — құрылғыларыңыз арасындағы алмасу кілті. Парақты кілт сияқты сақтаңыз: қолына алған адам алмасу файлдарын оқи алады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 24 Wörter sind der Schlüssel für den Austausch zwischen Ihren Geräten. Bewahren Sie das Blatt wie einen Schlüssel auf: Wer es hat, kann die Austauschdateien lesen."
          }
        }
      }
    },
