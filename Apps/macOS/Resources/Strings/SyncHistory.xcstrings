    "cashback.choice.bestHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана паводле вашых пакупак за апошнія тры месяцы з улікам месячнага ліміту рахунку. Толькі ацэнка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt nach Ihren Käufen der letzten drei Monate, mit dem Monatslimit des Kontos. Nur eine Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted by your purchases of the last three months, the account's monthly limit included. Only an estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado con sus compras de los últimos tres meses, incluido el límite mensual de la cuenta. Solo es una estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé d'après vos achats des trois derniers mois, plafond mensuel du compte compris. Seulement une estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolata sugli acquisti degli ultimi tre mesi, tenendo conto del limite mensile del conto. È solo una stima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы үш айдағы сатып алуларыңызбен, шоттың айлық лимитін ескеріп есептелді. Тек шамалау."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczono na podstawie zakupów z ostatnich trzech miesięcy, z uwzględnieniem miesięcznego limitu konta. To tylko szacunek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado com base nas suas compras dos últimos três meses e no limite mensal da conta. Apenas uma estimativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитано по вашим покупкам за три последних месяца с учётом потолка счёта. Это только оценка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç aydaki harcamalarınıza ve hesabın aylık sınırına göre hesaplanır. Yalnızca bir tahmindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислено за покупками за останні три місяці з урахуванням місячного ліміту рахунку. Лише оцінка."
          }
        }
      }
    },
