    "cashback.cap.unreadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly limit should be an amount in rubles, or empty for no limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite mensual debe ser un importe en rublos, o vacío para no tener límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plafond mensuel doit être un montant en roubles, ou vide pour aucun plafond."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потолок в месяц — сумма в рублях или пусто, если потолка нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місячний ліміт має бути сумою в рублях або порожнім полем без ліміту."
          }
        }
      }
    },
