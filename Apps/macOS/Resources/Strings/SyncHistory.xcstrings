          "stringUnit": {
            "state": "translated",
            "value": "Varaq bir marta ko‘rsatiladi. Uni hozir chop eting yoki so‘zlarni yozib oling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复表仅显示一次。请立即打印或记下这些词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原表只會顯示一次。請立即列印或抄下復原詞。"
          }
        }
