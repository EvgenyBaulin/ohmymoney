          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктің осы айдағы ұсынысы"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктын бул айдагы сунуштары"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta banku w tym miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofertas do banco neste mês"
          }
        },
        "pt-PT": {
