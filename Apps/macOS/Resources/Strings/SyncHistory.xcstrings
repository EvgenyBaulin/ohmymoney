    "recovery.sheet.once": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аркуш паказваецца адзін раз. Раздрукуйце яго або запішыце словы зараз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Blatt wird nur einmal gezeigt. Drucken Sie es aus oder schreiben Sie die Wörter jetzt auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sheet is shown once. Print it or write the words down now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hoja se muestra una sola vez. Imprímala o anote las palabras ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La feuille ne s'affiche qu'une fois. Imprimez-la ou notez les mots maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il foglio viene mostrato una sola volta. Stampalo o annota subito le parole."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Парақ бір рет көрсетіледі. Қазір басып шығарыңыз немесе сөздерді жазып алыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkusz jest wyświetlany tylko raz. Wydrukuj go lub zapisz teraz słowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta folha é exibida uma vez. Imprima-a ou anote as palavras agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лист показывается один раз. Распечатайте его или перепишите слова сейчас."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sayfa bir kez gösterilir. Şimdi yazdırın veya sözcükleri bir yere yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аркуш показується один раз. Надрукуйте його або запишіть слова зараз."
          }
        }
      }
    },
