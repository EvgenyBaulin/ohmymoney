    "recovery.key.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bərpa sözləri yanlışdır və ya açarı saxlamaq mümkün olmadı."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Словы аднаўлення несапраўдныя або не ўдалося захаваць ключ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellungswörter sind ungültig oder der Schlüssel konnte nicht gespeichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery words are invalid or the key could not be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras de recuperación no son válidas o la clave no se pudo guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de récupération sont invalides ou la clé n'a pas pu être enregistrée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերականգնման բառերը սխալ են, կամ չհաջողվեց պահել բանալին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole di recupero non sono valide oppure non è stato possibile salvare la chiave."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აღდგენის სიტყვები არასწორია ან გასაღების შენახვა ვერ მოხერხდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалпына келтіру сөздері жарамсыз немесе кілтті сақтау мүмкін болмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Калыбына келтирүү сөздөрү жараксыз же ачкычты сактоо мүмкүн болгон жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa odzyskiwania są nieprawidłowe lub nie udało się zachować klucza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras de recuperação são inválidas ou não foi possível salvar a chave."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras de recuperação são inválidas ou não foi possível guardar a chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова восстановления неверны или ключ не удалось сохранить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Калимаҳои барқарорсозӣ нодурустанд ё калидро захира кардан нашуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma sözcükleri geçersiz veya anahtar kaydedilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова відновлення неправильні або ключ не вдалося зберегти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiklash so‘zlari noto‘g‘ri yoki kalitni saqlab bo‘lmadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原詞無效，或無法儲存密鑰。"
          }
        }
      }
    },
