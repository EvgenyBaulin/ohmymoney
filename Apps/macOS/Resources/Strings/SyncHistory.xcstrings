    "cashback.choice.bestHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted by your purchases of the last three months, the account's monthly limit included. Only an estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado con sus compras de los últimos tres meses, incluido el límite mensual de la cuenta. Solo es una estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé d'après vos achats des trois derniers mois, plafond mensuel du compte compris. Seulement une estimation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитано по вашим покупкам за три последних месяца с учётом потолка счёта. Это только оценка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислено за покупками за останні три місяці з урахуванням місячного ліміту рахунку. Лише оцінка."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы үш айдағы сатып алуларыңызбен, шоттың айлық лимитін ескеріп есептелді. Тек шамалау."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt nach Ihren Käufen der letzten drei Monate, mit dem Monatslimit des Kontos. Nur eine Schätzung."
          }
        }
      }
    },
