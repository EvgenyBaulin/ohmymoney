    "cashback.missed.none": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç ayda keşbek itkisi yoxdur: hər alış üçün ən sərfəli kartınızdan istifadə edilib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За апошнія тры месяцы вы нічога не страцілі: для кожнай пакупкі была выбрана найлепшая з вашых картак."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za poslední tři měsíce vám nic neuniklo. Každý nákup jste zaplatili nejvýhodnější kartou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten drei Monaten nichts verpasst: Jeder Kauf ging auf die beste Ihrer Karten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing missed in the last three months: every purchase went to the best of your cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los últimos tres meses no se perdió nada: cada compra fue con la mejor de sus tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien manqué sur les trois derniers mois : chaque achat est allé à la meilleure de vos cartes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին երեք ամսում բացթողումներ չկան․ յուրաքանչյուր գնում արվել է ձեր լավագույն քարտով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna occasione persa negli ultimi tre mesi: hai usato la carta migliore per ogni acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去3か月の還元漏れはありません。すべての購入で最もお得なカードが使われました。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო სამ თვეში არაფერი დაგიკარგავთ: ყველა შენაძენი საუკეთესო ბარათით გადაიხადეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы үш айда жоғалған кешбэк жоқ: әр сатып алу ең тиімді картаңызбен жасалған."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы үч айда эч нерсе жоготкон жоксуз: ар бир сатып алууга эң пайдалуу картаңызды колдондуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afgelopen drie maanden niets misgelopen: je gebruikte voor elke aankoop je beste kaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ostatnich trzech miesiącach nic Ci nie umknęło: za każdy zakup zapłacono najlepszą z Twoich kart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma perda nos últimos três meses: todas as compras foram feitas com o melhor dos seus cartões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não perdeu cashback nos últimos três meses: usou o melhor dos seus cartões em cada compra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За три месяца ничего не упущено: каждая покупка прошла по лучшей из ваших карт."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар се моҳи охир чизе аз даст нарафтааст: ҳар харид бо беҳтарин корти шумо анҷом шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç ayda kaçırılan para iadesi yok. Her alışverişte en iyi kartınızı kullandınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За останні три місяці нічого не втрачено: кожну покупку оплачено найкращою з ваших карток."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi uch oyda keshbek yo‘qotilmagan: har bir xarid eng foydali kartangiz bilan qilingan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去三个月没有错过返现：每笔消费都使用了最佳卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去三個月沒有錯過回饋，每筆消費都使用了最佳卡片。"
          }
        }
      }
    },
