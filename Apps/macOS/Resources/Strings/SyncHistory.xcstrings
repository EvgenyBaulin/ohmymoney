    "cashback.missed.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər alış günündə qüvvədə olan qaydalara və aylıq limitlərə əsasən hesablanıb. Yalnız alışın valyutasındakı hesabların kartları müqayisə edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана паводле правілаў і месячных лімітаў на дзень кожнай пакупкі. Параўноўваюцца толькі карткі рахункаў у валюце пакупкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výpočet vychází z pravidel a měsíčních limitů platných v den každého nákupu. Porovnávají se pouze karty účtů v měně nákupu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt nach den Regeln und Monatslimits, wie sie am Tag jedes Kaufs galten. Verglichen werden nur Karten von Konten in der Währung des Kaufs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted by the rules and monthly limits as they stood on the day of each purchase. Only cards of accounts in the purchase's currency are compared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado con las reglas y los límites mensuales tal como estaban el día de cada compra. Solo se comparan tarjetas de cuentas en la divisa de la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé d'après les règles et les plafonds mensuels tels qu'ils étaient le jour de chaque achat. Seules les cartes des comptes dans la devise de l'achat sont comparées."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվարկված է յուրաքանչյուր գնման օրվա կանոններով և ամսական սահմանաչափերով։ Համեմատվում են միայն գնման արժույթով հաշիվների քարտերը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato in base alle regole e ai limiti mensili in vigore il giorno di ogni acquisto. Vengono confrontate solo le carte dei conti nella valuta dell’acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各購入日時点のルールと月間上限に基づいて計算しています。購入時の通貨と同じ通貨の口座のカードのみを比較します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დათვლილია თითოეული შენაძენის დღეს მოქმედი წესებისა და თვიური ლიმიტების მიხედვით. შედარებულია მხოლოდ შენაძენის ვალუტაში არსებული ანგარიშების ბარათები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр сатып алу күніндегі ережелер мен айлық лимиттер бойынша есептелді. Тек сатып алу валютасындағы шот карталары салыстырылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир сатып алуу күнүндөгү эрежелер жана айлык чектер боюнча эсептелди. Сатып алуунун валютасындагы эсептердин карталары гана салыштырылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berekend volgens de regels en maandlimieten op de dag van elke aankoop. Alleen kaarten van rekeningen in de valuta van de aankoop worden vergeleken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczono według reguł i limitów miesięcznych obowiązujących w dniu każdego zakupu. Porównywane są tylko karty kont w walucie zakupu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado com as regras e os limites mensais vigentes no dia de cada compra. Apenas cartões de contas na moeda da compra são comparados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado com as regras e os limites mensais em vigor no dia de cada compra. Só são comparados cartões de contas na moeda da compra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитано по правилам и потолкам, какими они были в день каждой покупки. Сравниваются только карты счетов в валюте покупки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз рӯи қоидаҳо ва маҳдудиятҳои моҳонаи рӯзи ҳар харид ҳисоб шудааст. Танҳо кортҳои ҳисобҳо бо асъори харид муқоиса мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her alışverişin yapıldığı gün geçerli olan kurallara ve aylık sınırlara göre hesaplanır. Yalnızca alışverişle aynı para birimindeki hesapların kartları karşılaştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислено за правилами й місячними лімітами на день кожної покупки. Порівнюються лише картки рахунків у валюті покупки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir xarid kunidagi qoidalar va oylik limitlar asosida hisoblangan. Faqat xarid valyutasidagi hisoblar kartalari taqqoslanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据每笔消费当天的规则和月限额计算。仅比较与消费币种相同的账户中的卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依每筆消費當日的規則和每月上限計算，僅比較與消費幣別相同的帳戶卡片。"
          }
        }
      }
    },
