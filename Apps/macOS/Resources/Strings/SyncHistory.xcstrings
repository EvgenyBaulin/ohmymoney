    "history.empty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu əməliyyatın dəyişiklikləri hələ qeydə alınmayıb. Tarixçə 2.9 versiyasından etibarən saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змены гэтай аперацыі пакуль не запісаны. Гісторыя захоўваецца пачынаючы з версіі 2.9."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nejsou zaznamenány žádné změny této operace. Historie se ukládá od verze 2.9."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Änderungen dieses Vorgangs erfasst. Der Verlauf wird ab Version 2.9 geführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No changes of this operation are recorded yet. The history is kept from version 2.9 on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se registra ningún cambio de esta operación. El historial se guarda desde la versión 2.9."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune modification de cette opération n'est encore enregistrée. L'historique est gardé à partir de la version 2.9."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գործարքի փոփոխությունները դեռ գրանցված չեն։ Պատմությունը պահվում է 2.9 տարբերակից սկսած։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono ancora registrate modifiche a questa operazione. La cronologia viene conservata dalla versione 2.9."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取引の変更履歴はまだありません。履歴はバージョン2.9以降で記録されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ოპერაციის ცვლილებები ჯერ არ აღრიცხულა. ისტორია ინახება 2.9 ვერსიიდან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы операцияның өзгерістері әлі жазылмаған. Тарих 2.9 нұсқасынан бастап сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул операциянын өзгөрүүлөрү азырынча катталган эмес. Тарых 2.9 версиясынан баштап сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog geen wijzigingen voor deze transactie vastgelegd. De geschiedenis wordt vanaf versie 2.9 bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano jeszcze żadnych zmian tej operacji. Historia jest zapisywana od wersji 2.9."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há alterações registradas para esta operação. O histórico é mantido a partir da versão 2.9."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há alterações registadas para esta operação. O histórico é guardado a partir da versão 2.9."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменений этой операции пока нет. История ведётся с версии 2.9."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйироти ин амалиёт ҳанӯз сабт нашудаанд. Таърих аз версияи 2.9 нигоҳ дошта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemin henüz kaydedilmiş bir değişikliği yok. Geçmiş 2.9 sürümünden itibaren tutulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змін цієї операції ще не записано. Історія ведеться з версії 2.9."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu operatsiya o‘zgarishlari hali qayd etilmagan. Tarix 2.9-versiyadan boshlab saqlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未记录此交易的更改。历史记录从 2.9 版开始保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無此筆交易的變更記錄。記錄自 2.9 版起保留。"
          }
        }
      }
    },
    "history.empty.dataSet": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişiklik tarixçəsi yalnız real məlumatlarınız üçün saxlanılır, demo və ya nümunə məlumatlar üçün deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гісторыя змен захоўваецца толькі для вашых сапраўдных даных, а не для дэма або прыкладу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie změn se ukládá pouze pro vaše skutečná data, nikoli pro ukázková data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf der Änderungen wird nur für Ihre echten Daten geführt, nicht für eine Demo oder einen Beispieldatensatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The history of changes is kept only for your real data, not for a demo or a sample set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de cambios se guarda solo para sus datos reales, no para una demo ni un conjunto de ejemplo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique des modifications n'est gardé que pour vos vraies données, pas pour une démo ni un jeu d'exemple."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոփոխությունների պատմությունը պահվում է միայն ձեր իրական տվյալների համար, ոչ թե ցուցադրական կամ օրինակային տվյալների։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia delle modifiche viene conservata solo per i tuoi dati reali, non per demo o dati di esempio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更履歴は実際のデータにのみ記録されます。デモやサンプルデータには記録されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცვლილებების ისტორია ინახება მხოლოდ თქვენი რეალური მონაცემებისთვის და არა დემო ან სანიმუშო ნაკრებისთვის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгерістер тарихы тек нақты деректеріңіз үшін сақталады, демо не мысал жиындары үшін сақталмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзгөрүүлөрдүн тарыхы демо же үлгү маалыматтар үчүн эмес, чыныгы маалыматтарыңыз үчүн гана сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijzigingsgeschiedenis wordt alleen bewaard voor je eigen gegevens, niet voor een demo of voorbeeldset."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia zmian jest zapisywana tylko dla Twoich rzeczywistych danych, nie dla danych demonstracyjnych ani przykładowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de alterações é mantido apenas para seus dados reais, não para dados de demonstração ou de exemplo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de alterações só é guardado para os seus dados reais, não para dados de demonstração ou de exemplo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История правок ведётся только для ваших настоящих данных, не для демо и учебного набора."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таърихи тағйирот танҳо барои маълумоти воқеии шумо нигоҳ дошта мешавад, на барои маҷмӯи намоишӣ ё намунавӣ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik geçmişi yalnızca gerçek verileriniz için tutulur; demo veya örnek veri kümesi için tutulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія змін ведеться лише для справжніх даних, не для демонстрації чи навчального набору."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarishlar tarixi faqat haqiqiy ma’lumotlaringiz uchun saqlanadi, demo yoki namunaviy ma’lumotlar uchun emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存真实数据的更改历史，不保存演示或样本数据的历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅保留真實資料的變更記錄，示範或範例資料集不會保留。"
          }
        }
      }
    },
