    "cashback.missed.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана паводле правілаў і месячных лімітаў на дзень кожнай пакупкі. Параўноўваюцца толькі карткі рахункаў у валюце пакупкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt nach den Regeln und Monatslimits, wie sie am Tag jedes Kaufs galten. Verglichen werden nur Karten von Konten in der Währung des Kaufs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted by the rules and monthly limits as they stood on the day of each purchase. Only cards of accounts in the purchase's currency are compared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado con las reglas y los límites mensuales tal como estaban el día de cada compra. Solo se comparan tarjetas de cuentas en la divisa de la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé d'après les règles et les plafonds mensuels tels qu'ils étaient le jour de chaque achat. Seules les cartes des comptes dans la devise de l'achat sont comparées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato in base alle regole e ai limiti mensili in vigore il giorno di ogni acquisto. Vengono confrontate solo le carte dei conti nella valuta dell’acquisto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр сатып алу күніндегі ережелер мен айлық лимиттер бойынша есептелді. Тек сатып алу валютасындағы шот карталары салыстырылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитано по правилам и потолкам, какими они были в день каждой покупки. Сравниваются только карты счетов в валюте покупки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислено за правилами й місячними лімітами на день кожної покупки. Порівнюються лише картки рахунків у валюті покупки."
          }
        }
      }
    },
