    "recovery.key.newMessage": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old sheet stops working: every other device will need the new sheet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hoja anterior deja de funcionar: cada otro dispositivo necesitará la hoja nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancienne feuille cesse de fonctionner : chaque autre appareil aura besoin de la nouvelle feuille."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старый лист перестанет подходить: другим устройствам понадобится новый лист."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старий аркуш перестане працювати: кожному іншому пристрою знадобиться новий."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ескі парақ жұмысын тоқтатады: барлық басқа құрылғыға жаңа парақ қажет болады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
