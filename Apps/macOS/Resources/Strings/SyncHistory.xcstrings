      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu 24 söz cihazlarınız arasındakı mübadilənin açarıdır. Vərəqi açar kimi qoruyun: onu əldə edən hər kəs mübadilə fayllarını oxuya bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя 24 словы — ключ да абмену паміж вашымі прыладамі. Захоўвайце аркуш як ключ: кожны, хто яго мае, можа прачытаць файлы абмену."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Těchto 24 slov je klíčem k výměně dat mezi vašimi zařízeními. List uchovávejte jako klíč: každý, kdo ho má, může číst soubory pro výměnu dat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 24 Wörter sind der Schlüssel für den Austausch zwischen Ihren Geräten. Bewahren Sie das Blatt wie einen Schlüssel auf: Wer es hat, kann die Austauschdateien lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 24 words are the key of the exchange between your devices. Keep the sheet as you keep a key: whoever has it can read the exchange's files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las 24 palabras son la clave del intercambio entre sus dispositivos. Guarde la hoja como guarda una llave: quien la tenga puede leer los archivos del intercambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 24 mots sont la clé de l'échange entre vos appareils. Conservez la feuille comme une clé : celui qui la possède peut lire les fichiers de l'échange."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս 24 բառը ձեր սարքերի միջև փոխանակման բանալին է։ Պահեք թերթիկը բանալիի պես․ այն ունեցողը կարող է կարդալ փոխանակման ֆայլերը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 24 parole sono la chiave per lo scambio tra i tuoi dispositivi. Custodisci il foglio come una chiave: chiunque lo possieda può leggere i file di scambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この24個の単語は、デバイス間で交換するためのキーです。シートは鍵と同じように保管してください。シートを持っている人は、交換ファイルを読み取れます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს 24 სიტყვა თქვენი მოწყობილობებს შორის მონაცემთა გაცვლის გასაღებია. შეინახეთ ფურცელი ისე, როგორც გასაღებს შეინახავდით: ვისაც ის ექნება, გაცვლის ფაილების წაკითხვას შეძლებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "24 сөз — құрылғыларыңыз арасындағы алмасу кілті. Парақты кілт сияқты сақтаңыз: қолына алған адам алмасу файлдарын оқи алады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул 24 сөз түзмөктөрүңүздүн ортосундагы алмашуунун ачкычы. Баракты ачкычтай сактаңыз: ал кимде болсо, алмашуу файлдарын окуй алат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De 24 woorden zijn de sleutel voor de uitwisseling tussen je apparaten. Bewaar het blad zoals je een sleutel bewaart: iedereen die het heeft, kan de uitwisselingsbestanden lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te 24 słowa są kluczem do wymiany między Twoimi urządzeniami. Przechowuj arkusz jak klucz: każdy, kto go ma, może odczytać pliki wymiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As 24 palavras são a chave para a troca entre seus dispositivos. Guarde esta folha como uma chave: quem a tiver poderá ler os arquivos de troca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As 24 palavras são a chave para a troca de dados entre os seus dispositivos. Guarde a folha como guardaria uma chave: quem a tiver pode ler os ficheiros trocados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "24 слова — это ключ обмена между вашими устройствами. Храните лист как ключ: тот, у кого он есть, может прочитать файлы обмена."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин 24 калима калиди мубодилаи байни дастгоҳҳои шумост. Варақаро мисли калид нигоҳ доред: ҳар касе, ки онро дорад, метавонад файлҳои мубодиларо хонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu 24 sözcük, aygıtlarınız arasındaki aktarımın anahtarıdır. Sayfayı bir anahtar gibi saklayın: sayfaya sahip olan herkes aktarım dosyalarını okuyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "24 слова — ключ обміну між вашими пристроями. Зберігайте аркуш як ключ: кожен, хто має його, може читати файли обміну."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu 24 ta so‘z qurilmalaringiz orasidagi almashuv kalitidir. Varaqni kalit kabi saqlang: unga ega bo‘lgan har kim almashuv fayllarini o‘qiy oladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这 24 个词是设备间交换数据的密钥。请像保管钥匙一样保管此表：任何持有此表的人都能读取交换文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這 24 個復原詞是裝置間交換資料的密鑰。請像保管鑰匙一樣保管這份復原表：任何取得復原表的人都能讀取交換檔案。"
          }
        }
      }
    },
