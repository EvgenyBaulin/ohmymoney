        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba las categorías tal como las muestra la app del banco. Cada banco y cada mes tienen las suyas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les catégories telles que l'application de la banque les affiche. Chaque banque et chaque mois ont les leurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите категории так, как их показывает приложение банка. У каждого банка и в каждом месяце они свои."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть категорії так, як у застосунку банку. У кожного банку та місяця — свої."
          }
        }
