    "recovery.key.newMessage": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Köhnə vərəq artıq işləməyəcək. Bütün digər cihazlarda yeni vərəq tələb olunacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стары аркуш перастане дзейнічаць: для ўсіх астатніх прылад спатрэбіцца новы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das alte Blatt funktioniert nicht mehr: Jedes andere Gerät braucht das neue Blatt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old sheet stops working: every other device will need the new sheet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hoja anterior deja de funcionar: cada otro dispositivo necesitará la hoja nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancienne feuille cesse de fonctionner : chaque autre appareil aura besoin de la nouvelle feuille."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հին թերթիկն այլևս չի գործի․ մյուս բոլոր սարքերին պետք կգա նոր թերթիկը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vecchio foglio non funzionerà più: servirà il nuovo foglio su tutti gli altri dispositivi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ძველი ფურცელი აღარ იმუშავებს: ყველა სხვა მოწყობილობას ახალი ფურცელი დასჭირდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ескі парақ жұмысын тоқтатады: барлық басқа құрылғыға жаңа парақ қажет болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эски барак жараксыз болот. Башка түзмөктөрдүн баарына жаңы барак керек болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzedni arkusz przestanie działać. Na każdym pozostałym urządzeniu będzie potrzebny nowy arkusz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A folha antiga deixará de funcionar. Todos os outros dispositivos precisarão da nova folha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A folha antiga deixará de funcionar: todos os outros dispositivos precisarão da nova folha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старый лист перестанет подходить: другим устройствам понадобится новый лист."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Варақаи кӯҳна дигар кор намекунад: ба ҳамаи дастгоҳҳои дигар варақаи нав лозим мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski sayfa artık çalışmaz: diğer tüm aygıtlar için yeni sayfa gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старий аркуш перестане працювати: кожному іншому пристрою знадобиться новий."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski varaq ishlamay qoladi: boshqa barcha qurilmalarga yangi varaq kerak bo‘ladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊的復原表將失效，所有其他裝置都需要新的復原表。"
          }
        }
      }
    },
