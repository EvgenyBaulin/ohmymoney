    "cashback.missed.total": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç ayda: ən sərfəli kartlarınızla alacağınızdan %@ az"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За тры месяцы: на %@ менш, чым дала б найлепшая з вашых картак"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In drei Monaten: %@ weniger, als die beste Ihrer Karten gegeben hätte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In three months: %@ less than the best of your cards would have given"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tres meses: %@ menos de lo que habría dado la mejor de sus tarjetas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En trois mois : %@ de moins que n'aurait donné la meilleure de vos cartes"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երեք ամսում՝ %@-ով պակաս, քան կտար ձեր լավագույն քարտը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In tre mesi: %@ in meno rispetto alla migliore delle tue carte"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სამ თვეში: %@-ით ნაკლები, ვიდრე თქვენი საუკეთესო ბარათით მიიღებდით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үш айда: ең тиімді картаңыз беретін сомадан %@ аз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Үч айда: эң пайдалуу картаңыз бермек болгон суммадан %@ аз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciągu trzech miesięcy: o %@ mniej, niż dałyby najlepsze z Twoich kart"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em três meses: %@ a menos do que o melhor dos seus cartões daria"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em três meses: menos %@ do que teria recebido com os seus melhores cartões"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За три месяца: на %@ меньше, чем дала бы лучшая из ваших карт"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар се моҳ: %@ камтар аз он ки беҳтарин корти шумо медод"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç ayda: En iyi kartlarınızla kazanabileceğinizden %@ daha az"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За три місяці: на %@ менше, ніж дала б найкраща з ваших карток"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uch oyda: eng foydali kartalaringiz bergan summadan %@ kam"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三個月內：比使用最佳卡片少獲得 %@"
          }
        }
      }
    },
