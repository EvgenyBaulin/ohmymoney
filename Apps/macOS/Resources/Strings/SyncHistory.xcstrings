    "cashback.choice.offeredHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie die Kategorien so ein, wie die App der Bank sie zeigt. Jede Bank und jeder Monat hat seine eigenen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the categories as the bank's app shows them. Each bank and each month has its own."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санаттарды банк қолданбасындағыдай жазыңыз. Әр банк пен айдың өз санаттары бар."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите категории так, как их показывает приложение банка. У каждого банка и в каждом месяце они свои."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть категорії так, як у застосунку банку. У кожного банку та місяця — свої."
          }
        }
      }
    },
