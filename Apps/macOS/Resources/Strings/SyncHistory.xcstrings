    "cashback.cap.account": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün hesab üzrə, ən çox"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь рахунак, не больш за"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Konto, nicht mehr als"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole account, not more than"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la cuenta, sin superar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le compte, sans dépasser"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամբողջ հաշվի համար՝ ոչ ավելի, քան"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intero conto, massimo"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთელ ანგარიშზე, არაუმეტეს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүкіл шотқа, ең көбі"
