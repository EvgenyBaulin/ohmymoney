    "cashback.cap.unreadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце месячны ліміт у рублях або пакіньце поле пустым."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Monatslimit sollte ein Betrag in Rubel sein oder leer, für kein Limit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly limit should be an amount in rubles, or empty for no limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite mensual debe ser un importe en rublos, o vacío para no tener límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plafond mensuel doit être un montant en roubles, ou vide pour aucun plafond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite mensile deve essere un importo in rubli. Lascia vuoto per non impostare limiti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлық лимит рубльдегі сома болуы керек, шектеусіз болса бос қалдырыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потолок в месяц — сумма в рублях или пусто, если потолка нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місячний ліміт має бути сумою в рублях або порожнім полем без ліміту."
          }
        }
      }
    },
