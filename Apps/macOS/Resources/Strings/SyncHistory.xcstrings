    "cashback.choice.unmapped": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» heç bir kateqoriyanıza uyğun deyil: qayda əlavə edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не звязана з вашымі катэгорыямі, таму правіла не дадаецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ steht für keine Ihrer Kategorien: Es ergibt keine Regel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» stands for none of your categories: it adds no rule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no corresponde a ninguna de sus categorías: no añade ninguna regla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne correspond à aucune de vos catégories : cela n'ajoute aucune règle."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»-ը կապված չէ ձեր կատեգորիաներից որևէ մեկին․ կանոն չի ավելացվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non corrisponde a nessuna delle tue categorie: non aggiunge alcuna regola."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» თქვენს არცერთ კატეგორიას არ შეესაბამება: წესი არ დაემატება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ешбір санатыңызға сәйкес емес: ереже қосылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» категорияларыңыздын бирине да дал келбейт: эреже кошулбайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» nie pasuje do żadnej z Twoich kategorii, więc nie dodaje reguły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» não está associada a nenhuma das suas categorias: nenhuma regra será adicionada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» não corresponde a nenhuma das suas categorias: não adiciona nenhuma regra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не сопоставлена с вашей категорией: правило для неё не появится."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ба ягон категорияи шумо пайваст нест: қоида илова намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» hiçbir kategorinizle eşleşmiyor. Kural eklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не відповідає жодній вашій категорії: правило не додається."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» hech bir kategoriyangizga mos kelmaydi: qoida qo‘shilmaydi."
