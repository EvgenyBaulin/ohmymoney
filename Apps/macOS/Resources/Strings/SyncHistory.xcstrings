    "cashback.choice.mappingHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered for this bank: next month the same names find your categories by themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recuerda para este banco: el mes siguiente, los mismos nombres encuentran sus categorías solos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запоминается для этого банка: в следующем месяце те же названия найдут ваши категории сами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запам'ятовується для цього банку: наступного місяця ті самі назви самі знайдуть ваші категорії."
          }
        }
      }
    },
    "cashback.choice.noBank": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
