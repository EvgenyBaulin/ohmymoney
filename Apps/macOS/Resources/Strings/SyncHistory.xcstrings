    "cashback.choice.bestHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç aydakı alışlarınıza və hesabın aylıq limitinə əsasən hesablanıb. Təxmini göstəricidir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана паводле вашых пакупак за апошнія тры месяцы з улікам месячнага ліміту рахунку. Толькі ацэнка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt nach Ihren Käufen der letzten drei Monate, mit dem Monatslimit des Kontos. Nur eine Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted by your purchases of the last three months, the account's monthly limit included. Only an estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado con sus compras de los últimos tres meses, incluido el límite mensual de la cuenta. Solo es una estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé d'après vos achats des trois derniers mois, plafond mensuel du compte compris. Seulement une estimation."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվարկված է վերջին երեք ամսվա գնումներով՝ հաշվի առնելով ամսական սահմանաչափը։ Մոտավոր գնահատական է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolata sugli acquisti degli ultimi tre mesi, tenendo conto del limite mensile del conto. È solo una stima."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დათვლილია ბოლო სამი თვის შენაძენების მიხედვით, ანგარიშის თვიური ლიმიტის გათვალისწინებით. მიახლოებითი შეფასებაა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы үш айдағы сатып алуларыңызбен, шоттың айлық лимитін ескеріп есептелді. Тек шамалау."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы үч айдагы сатып алууларыңыз жана эсептин айлык чеги боюнча эсептелди. Болжолдуу гана."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczono na podstawie zakupów z ostatnich trzech miesięcy, z uwzględnieniem miesięcznego limitu konta. To tylko szacunek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado com base nas suas compras dos últimos três meses e no limite mensal da conta. Apenas uma estimativa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado com base nas compras dos últimos três meses, incluindo o limite mensal da conta. É apenas uma estimativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитано по вашим покупкам за три последних месяца с учётом потолка счёта. Это только оценка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз рӯи харидҳои се моҳи охир бо назардошти маҳдудияти моҳонаи ҳисоб ҳисоб шудааст. Танҳо тахмин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç aydaki harcamalarınıza ve hesabın aylık sınırına göre hesaplanır. Yalnızca bir tahmindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислено за покупками за останні три місяці з урахуванням місячного ліміту рахунку. Лише оцінка."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi uch oydagi xaridlaringiz va hisobning oylik limiti asosida hisoblangan. Taxminiy qiymat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依過去三個月的消費計算，並計入帳戶每月上限。僅供參考。"
          }
        }
      }
    },
