    "cashback.choice.mappingHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bank üçün yadda saxlanılır: gələn ay eyni adlı kateqoriyalar avtomatik uyğunlaşdırılacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоўваецца для гэтага банка: у наступным месяцы тыя ж назвы аўтаматычна знойдуць вашы катэгорыі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Bank gemerkt: Im nächsten Monat finden dieselben Namen Ihre Kategorien von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered for this bank: next month the same names find your categories by themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recuerda para este banco: el mes siguiente, los mismos nombres encuentran sus categorías solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenu pour cette banque : le mois suivant, les mêmes noms trouvent vos catégories tout seuls."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահվում է այս բանկի համար․ հաջորդ ամիս նույն անուններն ինքնաշխատ կգտնեն ձեր կատեգորիաները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato per questa banca: il mese prossimo gli stessi nomi saranno associati automaticamente alle tue categorie."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დამახსოვრებულია ამ ბანკისთვის: შემდეგ თვეში იგივე სახელები თქვენს კატეგორიებს ავტომატურად დაუკავშირდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы банк үшін есте сақталады: келесі айда сол атаулар санаттарыңызды өзі табады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул банк үчүн сакталат: кийинки айда ошол эле аттар категорияларыңызга автоматтык түрдө дал келет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane dla tego banku: w następnym miesiącu kategorie o tych samych nazwach zostaną dopasowane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo para este banco: no próximo mês, os mesmos nomes serão associados automaticamente às suas categorias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado para este banco: no próximo mês, os mesmos nomes serão associados automaticamente às suas categorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запоминается для этого банка: в следующем месяце те же названия найдут ваши категории сами."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ин бонк нигоҳ дошта мешавад: моҳи оянда номҳои якхела категорияҳои шуморо худкор меёбанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu banka için kaydedilir. Gelecek ay aynı adlar kategorilerinizle otomatik eşleşir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запам'ятовується для цього банку: наступного місяця ті самі назви самі знайдуть ваші категорії."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bank uchun saqlanadi: keyingi oy bir xil nomlar kategoriyalaringizga avtomatik moslanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此銀行會記住對應關係，下個月自動對應相同名稱的類別。"
          }
        }
      }
    },
    "cashback.choice.noBank": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın bankı yoxdur. Kateqoriyaları yadda saxlamaq üçün hesabda bank seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для рахунку не выбраны банк. Выберыце яго ў наладах рахунку, каб захаваць катэгорыі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto hat keine Bank: Wählen Sie sie im Konto, um die Kategorien zu merken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account has no bank: choose it in the account to remember the categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta no tiene banco: elíjalo en la cuenta para recordar las categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte n'a pas de banque : choisissez-la dans le compte pour retenir les catégories."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշիվը բանկ չունի․ կատեգորիաները հիշելու համար ընտրեք բանկը հաշվի կարգավորումներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto non ha una banca: sceglila nel conto per salvare le categorie."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშს ბანკი არ აქვს მითითებული. კატეგორიების დასამახსოვრებლად აირჩიეთ ის ანგარიშში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шоттың банкі жоқ: санаттарды есте сақтау үшін шотта банкті таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсепке банк көрсөтүлгөн эмес: категорияларды сактоо үчүн эсептен банкты тандаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto nie ma przypisanego banku. Wybierz go w ustawieniach konta, aby zapamiętać kategorie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta não tem um banco: escolha um na conta para salvar as categorias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta não tem banco: escolha um na conta para guardar as categorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У счёта не указан банк: укажите его в счёте, чтобы сопоставление запоминалось."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ҳисоб бонк интихоб нашудааст. Барои нигоҳ доштани категорияҳо онро дар ҳисоб интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın bankası yok. Kategorileri kaydetmek için hesapta bir banka seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У рахунку немає банку: виберіть його, щоб запам'ятати категорії."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobga bank biriktirilmagan: kategoriyalarni saqlash uchun hisobda bankni tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶未設定銀行。請在帳戶中選擇銀行以記住類別。"
          }
        }
      }
    },
    "cashback.choice.noBest": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ hesablanacaq məlumat yoxdur. Aşağıda bankın kateqoriyalarını öz kateqoriyalarınıza uyğunlaşdırın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма чаго разлічваць: звяжыце катэгорыі банка са сваімі ніжэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zu zählen: Ordnen Sie unten die Kategorien der Bank Ihren zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to count yet: map the bank's categories to yours below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que calcular: relacione abajo las categorías del banco con las suyas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à calculer encore : associez ci-dessous les catégories de la banque aux vôtres."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ հաշվարկելու բան չկա․ ստորև կապեք բանկի կատեգորիաները ձեր կատեգորիաներին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente da calcolare: associa le categorie della banca alle tue qui sotto."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ დასათვლელი არაფერია: ქვემოთ დაუკავშირეთ ბანკის კატეგორიები თქვენსას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге есептейтін ештеңе жоқ: төменде банк санаттарын өзіңіздікімен сәйкестендіріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча эсептей турган эч нерсе жок: төмөндө банктын категорияларын өзүңүздүкүнө дал келтириңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze czego obliczyć. Dopasuj poniżej kategorie banku do swoich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há o que calcular: associe as categorias do banco às suas abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada a calcular: associe abaixo as categorias do banco às suas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего считать: сопоставьте категории банка с вашими ниже."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз чизе барои ҳисоб нест: категорияҳои бонкро дар поён ба категорияҳои худ пайваст кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hesaplanacak bir şey yok. Bankanın kategorilerini aşağıda kendi kategorilerinizle eşleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає що обчислити: зіставте категорії банку зі своїми нижче."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha hisoblash uchun ma’lumot yo‘q: quyida bank kategoriyalarini o‘zingiznikiga moslang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無可計算的資料。請在下方對應銀行類別。"
          }
        }
      }
    },
