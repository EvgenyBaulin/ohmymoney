    "cashback.choice.offeredHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kateqoriyaları bankın tətbiqində göstərildiyi kimi yazın. Onlar hər bank və ay üçün fərqlidir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце катэгорыі так, як яны паказаны ў праграме банка. У кожнага банка і месяца яны свае."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie die Kategorien so ein, wie die App der Bank sie zeigt. Jede Bank und jeder Monat hat seine eigenen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the categories as the bank's app shows them. Each bank and each month has its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba las categorías tal como las muestra la app del banco. Cada banco y cada mes tienen las suyas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les catégories telles que l'application de la banque les affiche. Chaque banque et chaque mois ont les leurs."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք կատեգորիաներն այնպես, ինչպես ցույց է տալիս բանկի հավելվածը։ Դրանք տարբեր են յուրաքանչյուր բանկի և ամսվա համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci le categorie come appaiono nell’app della banca. Ogni banca e ogni mese hanno le proprie."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ კატეგორიები ისე, როგორც ბანკის აპშია ნაჩვენები. ისინი განსხვავდება ბანკისა და თვის მიხედვით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санаттарды банк қолданбасындағыдай жазыңыз. Әр банк пен айдың өз санаттары бар."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияларды банктын колдонмосунда көрсөтүлгөндөй жазыңыз. Алар ар бир банкта жана ай сайын ар башка."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kategorie tak, jak są widoczne w aplikacji banku. Zależą one od banku i miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite as categorias como aparecem no app do banco. Elas variam conforme o banco e o mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza as categorias tal como aparecem na app do banco. Variam consoante o banco e o mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите категории так, как их показывает приложение банка. У каждого банка и в каждом месяце они свои."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияҳоро тавре нависед, ки дар барномаи бонк нишон дода шудаанд. Онҳо барои ҳар бонк ва ҳар моҳ фарқ мекунанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorileri banka uygulamasında göründükleri gibi yazın. Her bankanın ve her ayın kategorileri farklıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть категорії так, як у застосунку банку. У кожного банку та місяця — свої."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoriyalarni bank ilovasida ko‘rsatilganidek kiriting. Ular har bir bank va oy uchun alohida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請依銀行 App 顯示的名稱輸入類別。各銀行每月提供的類別可能不同。"
          }
        }
      }
    },
