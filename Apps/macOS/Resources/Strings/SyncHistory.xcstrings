    "cashback.cap.unreadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylıq limit rublla məbləğ olmalıdır. Limitsiz üçün boş saxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце месячны ліміт у рублях або пакіньце поле пустым."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční limit musí být částka v rublech. Pro neomezený limit pole nechte prázdné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Monatslimit sollte ein Betrag in Rubel sein oder leer, für kein Limit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The monthly limit should be an amount in rubles, or empty for no limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite mensual debe ser un importe en rublos, o vacío para no tener límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plafond mensuel doit être un montant en roubles, ou vide pour aucun plafond."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսական սահմանաչափը պետք է լինի գումար՝ ռուբլով, կամ դատարկ՝ առանց սահմանափակման։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite mensile deve essere un importo in rubli. Lascia vuoto per non impostare limiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の上限をルーブルで入力してください。空欄の場合は上限なしになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვიური ლიმიტი მიუთითეთ რუბლებში, ან დატოვეთ ცარიელი ლიმიტის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлық лимит рубльдегі сома болуы керек, шектеусіз болса бос қалдырыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлык чекти рубль менен киргизиңиз же чексиз калтыруу үчүн бош коюңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maandlimiet moet een bedrag in roebels zijn. Laat leeg voor geen limiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit miesięczny musi być kwotą w rublach. Pozostaw puste, aby nie ustawiać limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite mensal deve ser um valor em rublos. Deixe em branco para não definir um limite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite mensal deve ser um valor em rublos ou ficar vazio para não haver limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потолок в месяц — сумма в рублях или пусто, если потолка нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маҳдудияти моҳона бояд маблағ бо рубл бошад. Барои беканор мондан, онро холӣ гузоред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık sınır ruble cinsinden bir tutar olmalı. Sınır olmaması için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місячний ліміт має бути сумою в рублях або порожнім полем без ліміту."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylik limitni rublda kiriting yoki cheklovsiz bo‘lishi uchun bo‘sh qoldiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月限额应为卢布金额，留空表示无限额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月上限須為盧布金額；留空則不設上限。"
          }
        }
      }
    },
