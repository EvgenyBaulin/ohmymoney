    "cashback.choice.mappingHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered for this bank: next month the same names find your categories by themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recuerda para este banco: el mes siguiente, los mismos nombres encuentran sus categorías solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenu pour cette banque : le mois suivant, les mêmes noms trouvent vos catégories tout seuls."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запоминается для этого банка: в следующем месяце те же названия найдут ваши категории сами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запам'ятовується для цього банку: наступного місяця ті самі назви самі знайдуть ваші категорії."
          }
        }
      }
    },
    "cashback.choice.noBank": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account has no bank: choose it in the account to remember the categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta no tiene banco: elíjalo en la cuenta para recordar las categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte n'a pas de banque : choisissez-la dans le compte pour retenir les catégories."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У счёта не указан банк: укажите его в счёте, чтобы сопоставление запоминалось."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У рахунку немає банку: виберіть його, щоб запам'ятати категорії."
          }
