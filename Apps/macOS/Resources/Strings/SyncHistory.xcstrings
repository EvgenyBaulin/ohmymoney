            "state": "translated",
            "value": "Весь счёт — не больше"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои тамоми ҳисоб, на бештар аз"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın tamamı için en fazla"
