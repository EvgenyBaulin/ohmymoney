          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Konto, nicht mehr als"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole account, not more than"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүкіл шотқа, ең көбі"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь счёт — не больше"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь рахунок, не більше ніж"
