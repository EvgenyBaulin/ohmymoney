        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь рахунок, не більше ніж"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Butun hisob uchun, ko‘pi bilan"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個帳戶，上限為"
