    "cashback.choice.mappingHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоўваецца для гэтага банка: у наступным месяцы тыя ж назвы аўтаматычна знойдуць вашы катэгорыі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Bank gemerkt: Im nächsten Monat finden dieselben Namen Ihre Kategorien von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered for this bank: next month the same names find your categories by themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recuerda para este banco: el mes siguiente, los mismos nombres encuentran sus categorías solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenu pour cette banque : le mois suivant, les mêmes noms trouvent vos catégories tout seuls."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato per questa banca: il mese prossimo gli stessi nomi saranno associati automaticamente alle tue categorie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы банк үшін есте сақталады: келесі айда сол атаулар санаттарыңызды өзі табады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запоминается для этого банка: в следующем месяце те же названия найдут ваши категории сами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запам'ятовується для цього банку: наступного місяця ті самі назви самі знайдуть ваші категорії."
          }
        }
      }
    },
    "cashback.choice.noBank": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для рахунку не выбраны банк. Выберыце яго ў наладах рахунку, каб захаваць катэгорыі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto hat keine Bank: Wählen Sie sie im Konto, um die Kategorien zu merken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account has no bank: choose it in the account to remember the categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta no tiene banco: elíjalo en la cuenta para recordar las categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte n'a pas de banque : choisissez-la dans le compte pour retenir les catégories."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto non ha una banca: sceglila nel conto per salvare le categorie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шоттың банкі жоқ: санаттарды есте сақтау үшін шотта банкті таңдаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У счёта не указан банк: укажите его в счёте, чтобы сопоставление запоминалось."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У рахунку немає банку: виберіть його, щоб запам'ятати категорії."
          }
        }
      }
    },
    "cashback.choice.noBest": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма чаго разлічваць: звяжыце катэгорыі банка са сваімі ніжэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zu zählen: Ordnen Sie unten die Kategorien der Bank Ihren zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to count yet: map the bank's categories to yours below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que calcular: relacione abajo las categorías del banco con las suyas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à calculer encore : associez ci-dessous les catégories de la banque aux vôtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente da calcolare: associa le categorie della banca alle tue qui sotto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге есептейтін ештеңе жоқ: төменде банк санаттарын өзіңіздікімен сәйкестендіріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего считать: сопоставьте категории банка с вашими ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає що обчислити: зіставте категорії банку зі своїми нижче."
          }
        }
      }
    },
