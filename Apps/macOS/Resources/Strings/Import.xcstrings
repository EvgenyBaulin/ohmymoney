            "value": "Імена"
          }
        }
      }
    },
    "import.identity.names.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The form banks print: name, patronymic and the first letter of the surname."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
