    "import.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічога не будзе запісана, пакуль вы не націснеце «Запісаць». ⌘Z адмяняе запіс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird geschrieben, bis Sie „Schreiben“ drücken. ⌘Z nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is written until you press Write. ⌘Z takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se escribe hasta que pulse Escribir. ⌘Z lo deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est noté tant que vous n'appuyez pas sur « Noter ». ⌘Z le reprend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene registrato nulla finché non premi Registra. Per annullare, premi ⌘Z."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Жазу» басылмайынша ештеңе жазылмайды. ⌘Z оны қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы не нажали «Записать», ничего не пишется. ⌘Z вернёт всё назад."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не записується, доки ви не натиснете «Записати». ⌘Z скасовує це."
          }
        }
      }
