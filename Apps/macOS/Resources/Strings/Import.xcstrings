    "import.attachment.failed": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося прачытаць файл. Выберыце файл CSV, PDF, Excel або выяву."
