    "import.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічога не будзе запісана, пакуль вы не націснеце «Запісаць». ⌘Z адмяняе запіс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird geschrieben, bis Sie „Schreiben“ drücken. ⌘Z nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is written until you press Write. ⌘Z takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se escribe hasta que pulse Escribir. ⌘Z lo deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est noté tant que vous n'appuyez pas sur « Noter ». ⌘Z le reprend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene registrato nulla finché non premi Registra. Per annullare, premi ⌘Z."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Жазу» басылмайынша ештеңе жазылмайды. ⌘Z оны қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie zapisane, dopóki nie naciśniesz „Zapisz”. Naciśnij ⌘Z, aby cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada será salvo até você clicar em Salvar. ⌘Z desfaz a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы не нажали «Записать», ничего не пишется. ⌘Z вернёт всё назад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaz’a basana kadar hiçbir şey kaydedilmez. ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не записується, доки ви не натиснете «Записати». ⌘Z скасовує це."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yozish tugmasi bosilmaguncha hech narsa yozilmaydi. ⌘Z o‘zgarishlarni bekor qiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下「寫入」前不會寫入任何資料。按下 ⌘Z 即可復原。"
          }
        }
      }
    },
    "import.subtitle.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічога не будзе запісана, пакуль вы не націснеце «Запісаць». “Адмяніць” адмяняе запіс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird geschrieben, bis Sie „Schreiben“ drücken. „Rückgängig“ nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is written until you press Write. “Undo” takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se escribe hasta que pulse Escribir. «Deshacer» lo deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est noté tant que vous n'appuyez pas sur « Noter ». « Annuler » le reprend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene registrato nulla finché non premi Registra. Per annullare, tocca “Annulla”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Жазу» басылмайынша ештеңе жазылмайды. «Болдырмау» оны қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie zapisane, dopóki nie naciśniesz „Zapisz”. Wybierz „Cofnij”, aby cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada será salvo até você tocar em Salvar. “Desfazer” reverte a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы не нажали «Записать», ничего не пишется. «Отменить» вернёт всё назад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaz’a basana kadar hiçbir şey kaydedilmez. “Geri Al” ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не записується, доки ви не натиснете «Записати». «Скасувати» скасовує це."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yozish tugmasi bosilmaguncha hech narsa yozilmaydi. “Bekor qilish” o‘zgarishlarni qaytaradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下「寫入」前不會寫入任何資料。點一下「復原」即可還原。"
          }
        }
      }
    },
