    "import.scan.body": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта скан або фота. Чытанне сканаў з'явіцца ў наступных версіях. Пакуль папрасіце ў банка выпіску ў выглядзе файла з тэкстам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein Scan oder ein Foto. Das Lesen von Scans kommt in einer späteren Version; bitten Sie die Bank vorerst um den Auszug als Datei mit Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is a scan or a photo. Reading scans arrives in a later release; for now ask the bank for the statement as a file with text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un escaneo o una foto. La lectura de escaneos llegará en una versión posterior; por ahora pida al banco el extracto como archivo con texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un scan ou une photo. La lecture des scans arrivera dans une version ultérieure ; pour l'instant, demandez à la banque le relevé sous forme de fichier avec du texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una scansione o una foto. La lettura delle scansioni sarà disponibile in una versione futura; per ora chiedi alla banca un estratto conto in formato testuale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл скан немесе фото. Сканерлерді оқу келесі шығарылымға келеді; қазірше банктен мәтіні бар файл ретінде үзінді сұраңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это скан или фото. Чтение сканов выйдет позже; пока запросите у банка выписку файлом с текстом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це скан або фото. Читання сканів з'явиться в одному з наступних випусків; поки що попросіть у банку виписку у вигляді файлу з текстом."
          }
        }
      }
    },
