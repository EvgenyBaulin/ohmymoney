    "import.done.undoHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі, якія з таго часу ніхто не змяняў, перамесцяцца ў кошык. Пераводы паміж вашымі рахункамі і вашы запісы, дапоўненыя банкам, застануцца. Выдаліць перавод можна ў «Аперацыях»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, die seither niemand bearbeitet hat, kommen in den Papierkorb. Überweisungen zwischen Ihren Konten und Ihre Einträge, die die Bank vervollständigt hat, bleiben; eine Überweisung löschen Sie unter „Vorgänge“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations nobody has edited since go to the bin. Transfers between your accounts and entries of yours that the bank completed stay; delete a transfer in «Operations»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni non modificate dopo l’importazione finiscono nel cestino. I trasferimenti tra i tuoi conti e le tue voci completate dalla banca rimangono; elimina i trasferimenti in «Operazioni»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ешкім өңдемеген операциялар себетке өтеді. Сіздің есеп-шоттарыңыз арасындағы аударымдар мен банк толықтырған жазбаларыңыз қалады; аударымды «Операциялар» ішінде жойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нетронутые операции уйдут в корзину. Переводы между вашими счетами и ваши записи, дополненные банком, останутся; перевод удалите в «Операциях»."
          }
        }
      }
    },
