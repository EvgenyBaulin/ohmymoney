    },
    "import.note.loadedBefore": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты файл быў загружаны %@. Існыя радкі будуць прапушчаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde am %@ geladen. Zeilen, die schon vorhanden sind, werden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file was loaded on %@. Lines already there are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo se cargó el %@. Las líneas que ya están se omiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier a été chargé le %@. Les lignes déjà présentes sont ignorées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file è stato importato il %@. Le righe già presenti vengono ignorate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл файл %@ күні жүктелген. Бұрыннан бар жолдар өткізіледі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл уже загружался %@. Строки, которые уже есть, пропускаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл завантажено %@. Рядки, що вже є, пропускаються."
          }
        }
      }
    },
    "import.note.unparsed": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не прачытана радкоў: %lld, на суму %@. Яны паказаны ў «Не прачытаны» і не будуць запісаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gelesene Zeilen: %lld, Summe %@. Sie stehen unter „Nicht gelesen“ und werden nicht geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines not read: %lld, carrying %@. They are listed under «Not read» and are not written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Líneas no leídas: %lld, por un total de %@. Están en «No leídas» y no se escriben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lignes non lues : %lld, avec %@. Elles sont listées sous « Non lus » et ne sont pas notées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Righe non lette: %lld, per un totale di %@. Sono elencate in «Non lette» e non vengono registrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оқылмаған жолдар: %lld, сомасы %@. Олар «Оқылмады» астында тізіледі және жазылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не разобрано строк: %lld, на %@. Они в списке «Не разобрано» и не записываются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядків не прочитано: %lld, на суму %@. Вони показані в «Не прочитано» і не записуються."
          }
        }
      }
    },
    "import.question.summary": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld радкоў, %@ – %@"
          }
        },
