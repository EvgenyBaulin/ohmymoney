    "import.unknown.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine bekannte Bank hat diese Datei geschrieben. Senden Sie die Anfrage an die Bank mit der ersten Zeile, dann kann ein Leser dafür gebaut werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No known bank wrote this file. Send the request for the bank, with the first line, and a reader for it can be made."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл файлды ешбір танымал банк жазбаған. Банкке сұрауды бірінші жолымен жіберіңіз — сонда оны оқитын құрал жасалуы мүмкін."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один из известных банков не пишет такой файл. Отправьте заявку на банк с первой строкой файла — читалку для него можно добавить."
