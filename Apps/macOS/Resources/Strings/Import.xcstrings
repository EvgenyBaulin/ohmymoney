    "import.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV з VTB або Raiffeisen ці PDF-даведка з T-Bank з тэкстам. Вы таксама можаце перацягнуць файлы ў гэта акно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV von VTB oder Raiffeisen oder eine PDF-Bescheinigung der T-Bank mit ihrem Text. Sie können die Dateien auch auf dieses Fenster ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV from VTB or Raiffeisen, or a PDF certificate from T-Bank with its text. You can also drop the files on this window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un CSV de VTB o Raiffeisen, o un certificado en PDF de T-Bank con su texto. También puede arrastrar los archivos a esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un CSV de VTB ou Raiffeisen, ou un certificat PDF de T-Bank avec son texte. Vous pouvez aussi déposer les fichiers sur cette fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un CSV di VTB o Raiffeisen oppure un certificato PDF di T-Bank contenente testo. Puoi anche trascinare i file su questa finestra."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "VTB немесе Raiffeisen-нен CSV, не T-Bank-тен мәтіні бар PDF анықтама. Файлдарды осы терезеге сүйреуге де болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV из ВТБ или Райффайзена, или справка о движении средств Т-Банка в PDF с текстом. Файлы можно и перетащить в это окно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV від ВТБ або Райффайзену чи PDF-довідку від Т-Банку з його текстом. Можна також перетягнути файли в це вікно."
          }
        }
      }
