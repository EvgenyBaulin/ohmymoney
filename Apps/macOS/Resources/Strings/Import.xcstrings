            "value": "Los totales del pie no coinciden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux en bas ne concordent pas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I totali in fondo non corrispondono"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Астындағы жиындар сәйкес келмейді"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги в конце файла не сходятся"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумки внизу не сходяться"
          }
        }
      }
    },
    "import.choose": {
      "extractionState": "manual",
      "localizations": {
        "be": {
