            "value": "Die Daten konnten nicht gespeichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data could not be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données n'ont pas pu être enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare i dati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректерді сақтау мүмкін болмады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar os dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler kaydedilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані не вдалося зберегти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlarni saqlab bo‘lmadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存資料。"
          }
        }
      }
    },
    "import.identity.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашы тэлефоны, імёны і дагаворы дапамогуць распазнаць перавод сабе як перамяшчэнне паміж вашымі рахункамі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Ihren Telefonnummern, Namen und Verträgen ist eine Überweisung an sich selbst eine Umbuchung zwischen Ihren eigenen Konten, keine Zahlung an einen Fremden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your phones, names and contracts a transfer to yourself is a move between your own accounts, not a gift to a stranger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con sus teléfonos, nombres y contratos, una transferencia a usted mismo es un traslado entre sus propias cuentas, no un regalo a un desconocido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec vos téléphones, vos noms et vos contrats, un virement à soi-même est un transfert entre vos propres comptes, et non un cadeau à un inconnu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con i tuoi numeri di telefono, nomi e contratti, un trasferimento a te stesso viene riconosciuto come trasferimento tra i tuoi conti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефондарыңызбен, аттарыңызбен және келісімшарттарыңызбен өзіңізге аударым — бұл бейтаныс адамға сый емес, өз есеп-шоттарыңыз арасындағы көшу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki Twoim numerom telefonów, imionom i numerom umów przelew do siebie zostanie rozpoznany jako przelew między Twoimi kontami, a nie prezent dla obcej osoby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com seus telefones, nomes e contratos, uma transferência para você mesmo é identificada como transferência entre suas contas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С вашими телефонами, именами и договорами перевод самому себе — это движение между своими счетами, а не подарок чужому."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonlarınız, adlarınız ve sözleşmeleriniz sayesinde kendinize yaptığınız transferler, hesaplarınız arasında para aktarımı olarak tanınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З вашими телефонами, іменами й договорами переказ собі — це переміщення між вашими рахунками, а не подарунок чужій людині."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon raqamlaringiz, ismlaringiz va shartnomalaringiz yordamida o‘zingizga o‘tkazma begona kishiga sovg‘a sifatida emas, hisoblaringiz orasidagi o‘tkazma sifatida aniqlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提供電話、姓名和合約資料後，轉給自己的款項會列為自有帳戶間的轉帳。"
          }
        }
      }
    },
