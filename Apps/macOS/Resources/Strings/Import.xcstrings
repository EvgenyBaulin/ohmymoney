          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'operazione in sospeso rifiutata scompare dall'estratto conto. Le righe vanno nel cestino e puoi ripristinarle con “Annulla”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қабылданбаған ұстау үзіндіден жоғалады. Жолдар себетке өтеді және «Болдырмау» оларды қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонённая блокировка пропадает из выписки. Строки уходят в корзину, «Отменить» вернёт их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхолонена утримана сума зникає з виписки. Рядки йдуть у кошик, і «Скасувати» їх повертає."
          }
        }
      }
