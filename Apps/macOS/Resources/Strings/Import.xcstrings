    "import.check.footer.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Difference between statement totals and its lines: income %@, expenses %@. The statement is still written as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferencia entre los totales del extracto y sus líneas: ingresos %@, gastos %@. El extracto se escribe igualmente tal como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écart entre les totaux du relevé et ses lignes : revenus %@, dépenses %@. Le relevé est noté tel quel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разница между итогами выписки и её строками: пополнения %@, расходы %@. Выписка всё равно записывается как есть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різниця між підсумками виписки та її рядками: доходи %@, витрати %@. Виписка все одно записується як є."
          }
        }
      }
    },
    "import.check.footer.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The statement totals could not be read. The operations can still be written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los totales del extracto. Las operaciones se pueden escribir igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux du relevé n'ont pas pu être lus. Les opérations peuvent tout de même être notées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги выписки не удалось прочитать. Операции всё равно можно записать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумки виписки не вдалося прочитати. Операції все одно можна записати."
          }
        }
      }
    },
