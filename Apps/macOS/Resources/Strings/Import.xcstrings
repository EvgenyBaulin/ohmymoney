      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі, якія з таго часу ніхто не змяняў, перамесцяцца ў кошык. Змененыя вамі аперацыі і пераводы паміж вашымі рахункамі застануцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, die seither niemand bearbeitet hat, kommen in den Papierkorb. Die, die Sie bearbeitet haben, bleiben und gehören Ihnen, ebenso Überweisungen zwischen Ihren Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations nobody has edited since go to the bin. The ones you edited stay and are yours, and so do transfers between your accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones que nadie ha editado desde entonces van a la papelera. Las que usted editó se quedan y son suyas, y también las transferencias entre sus cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations que personne n'a modifiées depuis partent à la corbeille. Celles que vous avez modifiées restent et vous appartiennent, de même que les virements entre vos comptes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni non modificate dopo l’importazione finiscono nel cestino. Quelle che hai modificato rimangono, così come i trasferimenti tra i tuoi conti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ешкім өңдемеген операциялар себетке өтеді. Сіз өңдегендері қалады және сіздікі болып қалады, сол сияқты сіздің есеп-шоттарыңыз арасындағы аударымдар да."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje, których nikt od tego czasu nie edytował, trafią do kosza. Edytowane przez Ciebie operacje i przelewy między Twoimi kontami pozostaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Operações que ninguém editou desde então vão para o lixo. As que você editou e as transferências entre suas contas permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нетронутые операции уйдут в корзину. Те, что вы правили, останутся — они ваши; переводы между вашими счетами тоже останутся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O zamandan beri düzenlenmemiş işlemler çöp kutusuna taşınır. Düzenlediğiniz kayıtlar ve hesaplarınız arasındaki transferler kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції, яких ніхто не редагував відтоді, потрапляють у кошик. Ті, які ви редагували, лишаються вашими, так само як перекази між вашими рахунками."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shundan beri tahrirlanmagan operatsiyalar savatga o‘tadi. Siz tahrirlagan operatsiyalar va hisoblaringiz orasidagi o‘tkazmalar qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此後未經編輯的交易會移至垃圾桶。你編輯過的交易及自有帳戶間的轉帳會保留。"
          }
        }
      }
    },
