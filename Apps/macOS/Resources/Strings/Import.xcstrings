    "import.attachment.chooseHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося вызначыць дакумент. Выберыце, як яго адкрыць."
          }
