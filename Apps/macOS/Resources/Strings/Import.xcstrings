    "import.note.encoding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei war nicht UTF-8 und wurde als Windows-1251 gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file was not UTF-8 and was read as Windows-1251."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл UTF-8 емес еді және Windows-1251 ретінде оқылды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл был не в UTF-8, прочитан как Windows-1251."
          }
        }
      }
    },
    "import.note.loadedBefore": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde am %@ geladen. Zeilen, die schon vorhanden sind, werden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file was loaded on %@. Lines already there are skipped."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл файл %@ күні жүктелген. Бұрыннан бар жолдар өткізіледі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл уже загружался %@. Строки, которые уже есть, пропускаются."
          }
        }
      }
    },
    "import.note.unparsed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gelesene Zeilen: %lld, Summe %@. Sie stehen unter „Nicht gelesen“ und werden nicht geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines not read: %lld, carrying %@. They are listed under «Not read» and are not written."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оқылмаған жолдар: %lld, сомасы %@. Олар «Оқылмады» астында тізіледі және жазылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не разобрано строк: %lld, на %@. Они в списке «Не разобрано» и не записываются."
          }
        }
      }
    },
    "import.question.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Zeilen, %@ – %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lines, %@ – %@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld жол, %1$@ – %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строк: %lld, %@ – %@"
          }
        }
      }
    },
    "import.questions.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese konnten weder durch eine Datei noch durch eine Ihrer Regeln zugeordnet werden. Beantworten Sie die Gruppe einmal; „Merken“ macht die Antwort zur Regel für den nächsten Auszug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These could not be placed by a file or a rule of yours. Answer the group once; «Remember» turns the answer into a rule for the next statement."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұны файл немесе сіздің ережеңіз орналастыра алмады. Топқа бір рет жауап беріңіз; «Есте сақтау» жауапты келесі үзіндіге арналған ережеге айналдырады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти строки не удалось разместить ни по файлу, ни по вашим правилам. Ответьте на группу один раз; «Запомнить» превратит ответ в правило для следующих выписок."
          }
        }
      }
