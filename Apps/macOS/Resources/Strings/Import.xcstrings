    "import.identity.names.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Як у выпісцы банка: імя, імя па бацьку і першая літара прозвішча."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Form, die Banken drucken: Name, Vatersname und der erste Buchstabe des Nachnamens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The form banks print: name, patronymic and the first letter of the surname."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come riportati dalla banca: nome, patronimico e iniziale del cognome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктер басып шығаратын пішім: аты, әкесінің аты және тегінің бірінші әрпі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В том виде, как печатают банки: имя, отчество и первая буква фамилии."
          }
        }
      }
    },
    "import.identity.open": {
      "extractionState": "manual",
