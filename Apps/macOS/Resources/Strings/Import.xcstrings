    "import.transfers.soft": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адпраўлена %@, паступіла %@ — адзначце, калі гэта адзін перавод"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesendet %@, angekommen %@ — ankreuzen, wenn es eine Überweisung ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent %@, arrived %@ — tick if it is one transfer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviada %1$@, llegó %2$@ — marque si es una sola transferencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé le %@, arrivé le %@ — cochez s'il s'agit d'un seul virement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviato %@, arrivato %@ — seleziona se è un unico trasferimento"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жіберілді %1$@, келді %2$@ — егер бұл бір аударым болса, белгілеңіз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłano %@, dotarło %@ — zaznacz, jeśli to jeden przelew"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado %@, recebido %@ — marque se for uma só transferência"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушёл %@, пришёл %@ — отметьте, если это один перевод"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gönderildi, %@ ulaştı — tek bir transferse işaretleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслано %@, надійшло %@ — позначте, якщо це один переказ"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuborilgan: %@, kelgan: %@ — bitta o‘tkazma bo‘lsa, belgilang"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉出 %@，轉入 %@。若為同一筆轉帳，請勾選"
          }
        }
      }
    },
