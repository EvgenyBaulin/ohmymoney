    "import.identity.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten konnten nicht gespeichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data could not be saved."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректерді сақтау мүмкін болмады."
          }
        },
        "ru": {
