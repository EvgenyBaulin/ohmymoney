    "import.history.undo.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, die seither niemand bearbeitet hat, kommen in den Papierkorb. Die, die Sie bearbeitet haben, bleiben und gehören Ihnen, ebenso Überweisungen zwischen Ihren Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations nobody has edited since go to the bin. The ones you edited stay and are yours, and so do transfers between your accounts."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ешкім өңдемеген операциялар себетке өтеді. Сіз өңдегендері қалады және сіздікі болып қалады, сол сияқты сіздің есеп-шоттарыңыз арасындағы аударымдар да."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нетронутые операции уйдут в корзину. Те, что вы правили, останутся — они ваши; переводы между вашими счетами тоже останутся."
          }
        }
      }
    },
    "import.history.undo.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Import zurücknehmen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take this loading back?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл жүктеу қайтарылсын ба?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить эту загрузку?"
          }
        }
      }
    },
