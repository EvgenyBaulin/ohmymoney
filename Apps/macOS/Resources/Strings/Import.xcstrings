    "import.identity.contracts.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нумары вашых дагавораў у іншых банках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
