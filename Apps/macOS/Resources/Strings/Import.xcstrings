    "import.transfers.soft": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адпраўлена %@, паступіла %@ — адзначце, калі гэта адзін перавод"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesendet %@, angekommen %@ — ankreuzen, wenn es eine Überweisung ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent %@, arrived %@ — tick if it is one transfer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviato %@, arrivato %@ — seleziona se è un unico trasferimento"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жіберілді %1$@, келді %2$@ — егер бұл бір аударым болса, белгілеңіз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушёл %@, пришёл %@ — отметьте, если это один перевод"
          }
        }
      }
    },
