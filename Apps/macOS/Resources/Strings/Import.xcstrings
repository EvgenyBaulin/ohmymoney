    "import.check.footer.body": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Розніца паміж вынікамі выпіскі і яе радкамі: даходы %@, выдаткі %@. Выпіска будзе запісана як ёсць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Differenz zwischen den Summen des Auszugs und seinen Zeilen: Einnahmen %@, Ausgaben %@. Der Auszug wird trotzdem so geschrieben, wie er ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Difference between statement totals and its lines: income %@, expenses %@. The statement is still written as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferencia entre los totales del extracto y sus líneas: ingresos %@, gastos %@. El extracto se escribe igualmente tal como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écart entre les totaux du relevé et ses lignes : revenus %@, dépenses %@. Le relevé est noté tel quel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Differenza tra i totali dell’estratto e le sue righe: entrate %@, uscite %@. L’estratto viene comunque registrato così com’è."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үзінді жиындары мен оның жолдарының айырмасы: табыс %@, шығыс %@. Үзінді әлі бұрынғыдай жазылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разница между итогами выписки и её строками: пополнения %@, расходы %@. Выписка всё равно записывается как есть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різниця між підсумками виписки та її рядками: доходи %@, витрати %@. Виписка все одно записується як є."
          }
        }
      }
    },
    "import.check.footer.missing": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося прачытаць вынікі выпіскі. Аперацыі ўсё роўна можна запісаць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Summen des Auszugs konnten nicht gelesen werden. Die Vorgänge können trotzdem geschrieben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The statement totals could not be read. The operations can still be written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los totales del extracto. Las operaciones se pueden escribir igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux du relevé n'ont pas pu être lus. Les opérations peuvent tout de même être notées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i totali dell’estratto. Le operazioni possono comunque essere registrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үзінді жиындарын оқу мүмкін болмады. Операцияларды әлі жазуға болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги выписки не удалось прочитать. Операции всё равно можно записать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумки виписки не вдалося прочитати. Операції все одно можна записати."
          }
        }
      }
    },
    "import.check.footer.title": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вынікі ў канцы не супадаюць"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Summen am Fuß stimmen nicht überein"
