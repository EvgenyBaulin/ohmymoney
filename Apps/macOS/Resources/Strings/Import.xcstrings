    "import.stale.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адхіленая блакіроўка знікае з выпіскі. Радкі трапяць у кошык; ⌘Z верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine abgelehnte Vormerkung verschwindet aus dem Auszug. Die Zeilen kommen in den Papierkorb, und ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refused hold disappears from the statement. The lines go to the bin and ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una retención rechazada desaparece del extracto. Las líneas van a la papelera y ⌘Z las devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une retenue refusée disparaît du relevé. Les lignes vont à la corbeille et ⌘Z les rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'operazione in sospeso rifiutata scompare dall'estratto conto. Le righe vanno nel cestino e puoi ripristinarle con ⌘Z."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қабылданбаған ұстау үзіндіден жоғалады. Жолдар себетке өтеді және ⌘Z оларды қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucona blokada znika z wyciągu. Pozycje trafią do kosza. Naciśnij ⌘Z, aby je przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma retenção recusada desaparece do extrato. As linhas vão para o Lixo e ⌘Z as recupera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонённая блокировка пропадает из выписки. Строки уходят в корзину, ⌘Z вернёт их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reddedilen provizyon ekstreden kaybolur. Satırlar çöp kutusuna taşınır; ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхолонена утримана сума зникає з виписки. Рядки йдуть у кошик, і ⌘Z їх повертає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rad etilgan operatsiya ko‘chirmadan yo‘qoladi. Qatorlar savatga o‘tadi, ⌘Z ularni tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遭拒的預授權會從對帳單中消失。明細會移到垃圾桶，按下 ⌘Z 即可復原。"
          }
        }
      }
    },
    "import.stale.hint.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адхіленая блакіроўка знікае з выпіскі. Радкі трапяць у кошык; “Адмяніць” верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine abgelehnte Vormerkung verschwindet aus dem Auszug. Die Zeilen kommen in den Papierkorb, und „Rückgängig“ holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refused hold disappears from the statement. The lines go to the bin and “Undo” brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una retención rechazada desaparece del extracto. Las líneas van a la papelera y «Deshacer» las devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une retenue refusée disparaît du relevé. Les lignes vont à la corbeille et « Annuler » les rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'operazione in sospeso rifiutata scompare dall'estratto conto. Le righe vanno nel cestino e puoi ripristinarle con “Annulla”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қабылданбаған ұстау үзіндіден жоғалады. Жолдар себетке өтеді және «Болдырмау» оларды қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucona blokada znika z wyciągu. Pozycje trafią do kosza. Wybierz „Cofnij”, aby je przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma retenção recusada desaparece do extrato. As linhas vão para o Lixo e “Desfazer” as recupera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонённая блокировка пропадает из выписки. Строки уходят в корзину, «Отменить» вернёт их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reddedilen provizyon ekstreden kaybolur. Satırlar çöp kutusuna taşınır; “Geri Al” ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхолонена утримана сума зникає з виписки. Рядки йдуть у кошик, і «Скасувати» їх повертає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rad etilgan operatsiya ko‘chirmadan yo‘qoladi. Qatorlar savatga o‘tadi, “Bekor qilish” ularni tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遭拒的預授權會從對帳單中消失。明細會移到垃圾桶，點一下「復原」即可還原。"
          }
        }
      }
    },
