    "import.done.undoHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі, якія з таго часу ніхто не змяняў, перамесцяцца ў кошык. Пераводы паміж вашымі рахункамі і вашы запісы, дапоўненыя банкам, застануцца. Выдаліць перавод можна ў «Аперацыях»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge, die seither niemand bearbeitet hat, kommen in den Papierkorb. Überweisungen zwischen Ihren Konten und Ihre Einträge, die die Bank vervollständigt hat, bleiben; eine Überweisung löschen Sie unter „Vorgänge“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations nobody has edited since go to the bin. Transfers between your accounts and entries of yours that the bank completed stay; delete a transfer in «Operations»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones que nadie ha editado desde entonces van a la papelera. Las transferencias entre sus cuentas y los apuntes suyos que completó el banco se quedan; elimine una transferencia en «Operaciones»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations que personne n'a modifiées depuis partent à la corbeille. Les virements entre vos comptes et les saisies à vous que la banque a complétées restent ; supprimez un virement dans « Opérations »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni non modificate dopo l’importazione finiscono nel cestino. I trasferimenti tra i tuoi conti e le tue voci completate dalla banca rimangono; elimina i trasferimenti in «Operazioni»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ешкім өңдемеген операциялар себетке өтеді. Сіздің есеп-шоттарыңыз арасындағы аударымдар мен банк толықтырған жазбаларыңыз қалады; аударымды «Операциялар» ішінде жойыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje, których nikt od tego czasu nie edytował, trafią do kosza. Przelewy między Twoimi kontami i Twoje wpisy uzupełnione przez bank pozostaną. Przelew możesz usunąć w «Operacjach»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Operações que ninguém editou desde então vão para o lixo. Transferências entre suas contas e lançamentos seus completados pelo banco permanecem; apague uma transferência em «Operações»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нетронутые операции уйдут в корзину. Переводы между вашими счетами и ваши записи, дополненные банком, останутся; перевод удалите в «Операциях»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O zamandan beri düzenlenmemiş işlemler çöp kutusuna taşınır. Hesaplarınız arasındaki transferler ve banka bilgileriyle tamamlanan kayıtlarınız kalır; transferleri «İşlemler» bölümünden silebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції, яких ніхто не редагував відтоді, потрапляють у кошик. Перекази між вашими рахунками та ваші записи, які банк доповнив, лишаються; переказ видаляють в «Операціях»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shundan beri tahrirlanmagan operatsiyalar savatga o‘tadi. Hisoblaringiz orasidagi o‘tkazmalar va bank to‘ldirgan yozuvlaringiz qoladi; o‘tkazmani «Operatsiyalar»da o‘chiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此後未經編輯的交易會移至垃圾桶。自有帳戶間的轉帳及由銀行資料補全的紀錄會保留；請在「交易」中刪除轉帳。"
          }
        }
      }
    },
