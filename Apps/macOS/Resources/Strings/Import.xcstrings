    "import.unknown.body": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты файл не належыць ніводнаму з вядомых банкаў. Адпраўце запыт з назвай банка і першым радком файла, каб можна было дадаць падтрымку фармату."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine bekannte Bank hat diese Datei geschrieben. Senden Sie die Anfrage an die Bank mit der ersten Zeile, dann kann ein Leser dafür gebaut werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No known bank wrote this file. Send the request for the bank, with the first line, and a reader for it can be made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún banco conocido escribió este archivo. Envíe la petición al banco, con la primera línea, y se puede crear un lector para él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune banque connue n'a écrit ce fichier. Envoyez la demande pour la banque, avec la première ligne ; un lecteur pourra alors être créé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non proviene da una banca riconosciuta. Invia la richiesta per la banca con la prima riga del file, così potremo aggiungere il supporto per questo formato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл файлды ешбір танымал банк жазбаған. Банкке сұрауды бірінші жолымен жіберіңіз — сонда оны оқитын құрал жасалуы мүмкін."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden znany bank nie utworzył tego pliku. Wyślij prośbę o dodanie banku wraz z pierwszym wierszem pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum banco conhecido gerou este arquivo. Envie a solicitação para o banco com a primeira linha, para que seja criado um leitor para ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один из известных банков не пишет такой файл. Отправьте заявку на банк с первой строкой файла — читалку для него можно добавить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya bilinen bir bankaya ait değil. İlk satırı içeren bir istek gönderin; banka için bir okuyucu hazırlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден відомий банк не писав цей файл. Надішліть запит банку з першим рядком — і для нього можна зробити читач."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu faylni ma’lum banklardan hech biri yaratmagan. Birinchi qator bilan bank uchun so‘rov yuboring, shunda bu formatni o‘qish qo‘shilishi mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案不符合已知銀行的格式。請傳送包含第一行內容的銀行支援請求，以便新增讀取功能。"
          }
        }
      }
    },
