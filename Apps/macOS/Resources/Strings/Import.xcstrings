    "import.note.encoding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file was not UTF-8 and was read as Windows-1251."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no estaba en UTF-8 y se leyó como Windows-1251."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'était pas en UTF-8 et a été lu en Windows-1251."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл был не в UTF-8, прочитан как Windows-1251."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл був не в UTF-8 і прочитаний як Windows-1251."
          }
        }
      }
    },
    "import.note.loadedBefore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file was loaded on %@. Lines already there are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo se cargó el %@. Las líneas que ya están se omiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier a été chargé le %@. Les lignes déjà présentes sont ignorées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл уже загружался %@. Строки, которые уже есть, пропускаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл завантажено %@. Рядки, що вже є, пропускаються."
          }
        }
      }
    },
    "import.note.unparsed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines not read: %lld, carrying %@. They are listed under «Not read» and are not written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Líneas no leídas: %lld, por un total de %@. Están en «No leídas» y no se escriben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lignes non lues : %lld, avec %@. Elles sont listées sous « Non lus » et ne sont pas notées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не разобрано строк: %lld, на %@. Они в списке «Не разобрано» и не записываются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядків не прочитано: %lld, на суму %@. Вони показані в «Не прочитано» і не записуються."
          }
        }
      }
    },
    "import.question.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lines, %@ – %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld líneas, %@ – %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lignes, %@ – %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строк: %lld, %@ – %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld рядків, %@ – %@"
          }
        }
      }
    },
    "import.questions.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These could not be placed by a file or a rule of yours. Answer the group once; «Remember» turns the answer into a rule for the next statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudieron colocarse con un archivo ni con una regla suya. Responda al grupo una vez; «Recordar» convierte la respuesta en una regla para el siguiente extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier ou une de vos règles ne peut pas les placer. Répondez une fois par groupe ; « Retenir » fait de la réponse une règle pour le prochain relevé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти строки не удалось разместить ни по файлу, ни по вашим правилам. Ответьте на группу один раз; «Запомнить» превратит ответ в правило для следующих выписок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх не може розмістити ні файл, ні ваше правило. Відповідайте на групу один раз; «Запам'ятати» перетворює відповідь на правило для наступної виписки."
          }
        }
      }
    },
    "import.questions.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to ask: every line has a place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que preguntar: cada línea tiene su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à demander : chaque ligne a sa place."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивать нечего: у каждой строки есть место."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Питати нічого: кожен рядок має місце."
          }
        }
      }
    },
