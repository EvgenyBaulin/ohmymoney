    "import.questions.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя радкі не ўдалося размеркаваць паводле файла або вашых правіл. Выберыце катэгорыю для ўсёй групы. «Запомніць» створыць правіла для наступнай выпіскі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese konnten weder durch eine Datei noch durch eine Ihrer Regeln zugeordnet werden. Beantworten Sie die Gruppe einmal; „Merken“ macht die Antwort zur Regel für den nächsten Auszug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These could not be placed by a file or a rule of yours. Answer the group once; «Remember» turns the answer into a rule for the next statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudieron colocarse con un archivo ni con una regla suya. Responda al grupo una vez; «Recordar» convierte la respuesta en una regla para el siguiente extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier ou une de vos règles ne peut pas les placer. Répondez une fois par groupe ; « Retenir » fait de la réponse une règle pour le prochain relevé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile assegnare queste righe in base al file o alle tue regole. Rispondi una volta per gruppo; «Ricorda» crea una regola per il prossimo estratto conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұны файл немесе сіздің ережеңіз орналастыра алмады. Топқа бір рет жауап беріңіз; «Есте сақтау» жауапты келесі үзіндіге арналған ережеге айналдырады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przypisać tych pozycji na podstawie pliku ani Twoich reguł. Wybierz odpowiedź dla całej grupy; «Zapamiętaj» utworzy regułę dla następnego wyciągu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível categorizar estas linhas pelo arquivo ou por uma regra sua. Responda uma vez para o grupo; «Memorizar» cria uma regra para o próximo extrato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти строки не удалось разместить ни по файлу, ни по вашим правилам. Ответьте на группу один раз; «Запомнить» превратит ответ в правило для следующих выписок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar dosya veya kurallarınız kullanılarak sınıflandırılamadı. Her grup için bir kez yanıt verin; «Anımsa» yanıtı sonraki ekstre için kurala dönüştürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх не може розмістити ні файл, ні ваше правило. Відповідайте на групу один раз; «Запам'ятати» перетворює відповідь на правило для наступної виписки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bularni fayl yoki qoidalaringiz asosida joylab bo‘lmadi. Har bir guruh uchun bir marta javob bering; «Eslab qolish» javobni keyingi ko‘chirma uchun qoidaga aylantiradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些明細無法依檔案或你的規則歸類。每組只需回答一次；選擇「記住」會將答案存為下次匯入對帳單時使用的規則。"
          }
        }
      }
    },
