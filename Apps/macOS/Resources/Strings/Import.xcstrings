    "import.done.undoHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations nobody has edited since go to the bin. Transfers between your accounts and entries of yours that the bank completed stay; delete a transfer in «Operations»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones que nadie ha editado desde entonces van a la papelera. Las transferencias entre sus cuentas y los apuntes suyos que completó el banco se quedan; elimine una transferencia en «Operaciones»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations que personne n'a modifiées depuis partent à la corbeille. Les virements entre vos comptes et les saisies à vous que la banque a complétées restent ; supprimez un virement dans « Opérations »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нетронутые операции уйдут в корзину. Переводы между вашими счетами и ваши записи, дополненные банком, останутся; перевод удалите в «Операциях»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції, яких ніхто не редагував відтоді, потрапляють у кошик. Перекази між вашими рахунками та ваші записи, які банк доповнив, лишаються; переказ видаляють в «Операціях»."
          }
        }
      }
    },
    "import.done.undone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
