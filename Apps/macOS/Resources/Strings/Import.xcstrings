    "import.note.encoding": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл быў не ў UTF-8 і прачытаны ў Windows-1251."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei war nicht UTF-8 und wurde als Windows-1251 gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file was not UTF-8 and was read as Windows-1251."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no estaba en UTF-8 y se leyó como Windows-1251."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'était pas en UTF-8 et a été lu en Windows-1251."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non era in UTF-8 ed è stato letto come Windows-1251."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл UTF-8 емес еді және Windows-1251 ретінде оқылды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik nie był w kodowaniu UTF-8 i został odczytany jako Windows-1251."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não estava em UTF-8 e foi lido como Windows-1251."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл был не в UTF-8, прочитан как Windows-1251."
          }
