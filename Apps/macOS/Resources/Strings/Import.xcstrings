    "import.identity.contracts.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nummern Ihrer eigenen Verträge bei anderen Banken."
          }
        },
