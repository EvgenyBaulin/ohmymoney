          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В том виде, как печатают банки: имя, отчество и первая буква фамилии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма, яку друкують банки: ім'я, по батькові та перша літера прізвища."
          }
        }
      }
    },
