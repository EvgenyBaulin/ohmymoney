    "import.account.needed": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце рахунак, да якога належыць выпіска. Радкі будуць параўнаны з яго запісамі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie das Konto, zu dem dieser Auszug gehört — die Zeilen werden mit dem verglichen, was es schon enthält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account this statement belongs to — the lines are compared with what it already holds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la cuenta a la que pertenece este extracto: las líneas se comparan con lo que ya contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le compte auquel appartient le relevé — les lignes sont comparées à ce qu'il contient déjà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il conto a cui appartiene questo estratto: le righe verranno confrontate con le operazioni già presenti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл үзінді қай есеп-шотқа тиесілі екенін таңдаңыз — жолдар онда бар нәрсемен салыстырылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz konto, którego dotyczy wyciąg — pozycje zostaną porównane z jego zawartością."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a conta deste extrato. As linhas serão comparadas com os lançamentos existentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите счёт этой выписки — строки сравниваются с тем, что в нём уже есть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekstrenin ait olduğu hesabı seçin. Satırlar, hesaptaki kayıtlarla karşılaştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть рахунок, якому належить ця виписка: рядки порівнюються з тим, що на ньому вже є."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘chirma qaysi hisobga tegishli ekanini tanlang — satrlar undagi mavjud ma’lumotlar bilan solishtiriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇此對帳單所屬的帳戶，系統會比對帳戶中已有的紀錄。"
          }
        }
      }
    },
