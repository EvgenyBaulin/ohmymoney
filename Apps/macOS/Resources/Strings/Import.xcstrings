    "import.stale.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адхіленая блакіроўка знікае з выпіскі. Радкі трапяць у кошык; ⌘Z верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine abgelehnte Vormerkung verschwindet aus dem Auszug. Die Zeilen kommen in den Papierkorb, und ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refused hold disappears from the statement. The lines go to the bin and ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una retención rechazada desaparece del extracto. Las líneas van a la papelera y ⌘Z las devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une retenue refusée disparaît du relevé. Les lignes vont à la corbeille et ⌘Z les rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'operazione in sospeso rifiutata scompare dall'estratto conto. Le righe vanno nel cestino e puoi ripristinarle con ⌘Z."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қабылданбаған ұстау үзіндіден жоғалады. Жолдар себетке өтеді және ⌘Z оларды қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонённая блокировка пропадает из выписки. Строки уходят в корзину, ⌘Z вернёт их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхолонена утримана сума зникає з виписки. Рядки йдуть у кошик, і ⌘Z їх повертає."
          }
        }
      }
    },
    "import.stale.hint.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адхіленая блакіроўка знікае з выпіскі. Радкі трапяць у кошык; “Адмяніць” верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine abgelehnte Vormerkung verschwindet aus dem Auszug. Die Zeilen kommen in den Papierkorb, und „Rückgängig“ holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refused hold disappears from the statement. The lines go to the bin and “Undo” brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una retención rechazada desaparece del extracto. Las líneas van a la papelera y «Deshacer» las devuelve."
