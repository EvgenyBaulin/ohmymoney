    "import.identity.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data could not be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données n'ont pas pu être enregistrées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить."
          }
        },
        "uk": {
