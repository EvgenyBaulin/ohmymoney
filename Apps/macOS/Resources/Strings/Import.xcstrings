    "import.attachment.chooseHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося вызначыць дакумент. Выберыце, як яго адкрыць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument konnte nicht erkannt werden. Wähle, wie es geöffnet werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document could not be identified. Choose how to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido identificar el documento. Elige cómo abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document n’a pas pu être identifié. Choisissez comment l’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile identificare il documento. Scegli come aprirlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құжатты анықтау мүмкін болмады. Оны ашу жолын таңдаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie rozpoznano dokumentu. Wybierz, jak go otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível identificar o documento. Escolha como abri-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить вид документа. Выберите, как его открыть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belge tanınamadı. Nasıl açılacağını seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити документ. Виберіть, як його відкрити."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hujjatni aniqlab bo‘lmadi. Uni qanday ochishni tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別文件，請選擇開啟方式。"
          }
        }
      }
    },
    "import.attachment.failed": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося прачытаць файл. Выберыце файл CSV, PDF, Excel або выяву."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gelesen werden. Wähle eine CSV-, PDF-, Excel-Datei oder ein Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read. Choose a CSV, PDF, Excel file or image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el archivo. Elige un archivo CSV, PDF, Excel o una imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’a pas pu être lu. Choisissez un fichier CSV, PDF, Excel ou une image."
          }
