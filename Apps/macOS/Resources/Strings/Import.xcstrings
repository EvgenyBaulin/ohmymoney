    "import.transfers.noStatement": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пераводы на ваш рахунак у «%@»: %lld, %@. Выпіскі для яго няма, таму яны застануцца звычайнымі аперацыямі ў «Не разабрана»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überweisungen auf Ihr Konto bei „%@“: %lld, %@. Dafür gibt es keinen Auszug, daher bleiben sie gewöhnliche Vorgänge unter „Unsortiert“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers to your account at «%@»: %lld, %@. There is no statement for it, so they stay ordinary operations in «Unsorted»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferencias a su cuenta en «%@»: %lld, %@. No hay extracto de esa cuenta, así que siguen siendo operaciones normales en «Sin clasificar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virements vers votre compte « %@ » : %lld, %@. Il n'y a pas de relevé pour lui, donc ils restent des opérations ordinaires dans « Non classées »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasferimenti al tuo conto presso «%@»: %lld, %@. Non c'è un estratto conto, quindi restano operazioni ordinarie in «Da classificare»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» банкіндегі сіздің есеп-шотыңызға аударымдар: %2$lld, %3$@. Оған үзінді жоқ, сондықтан олар «Сұрыпталмағанда» қарапайым операция болып қалады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelewy na Twoje konto w «%@»: %lld, %@. Brak wyciągu dla tego konta, więc pozostaną zwykłymi operacjami w kategorii «Nieuporządkowane»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências para sua conta em «%@»: %lld, %@. Não há extrato dessa conta, então elas permanecem como lançamentos comuns em «Sem categoria»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы на ваш счёт в «%@»: %lld на %@. Выписки по нему нет, поэтому они остаются обычными операциями в «Не разобрано»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» hesabınıza transferler: %lld, %@. Bu hesaba ait ekstre olmadığı için «Sınıflandırılmamış» bölümünde normal işlem olarak kalacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекази на ваш рахунок в «%@»: %lld, %@. Виписки для нього немає, тож вони лишаються звичайними операціями в «Нерозсортованих»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»dagi hisobingizga o‘tkazmalar: %lld, %@. Uning ko‘chirmasi yo‘q, shuning uchun ular «Saralanmagan»da oddiy operatsiya bo‘lib qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉入你在 «%@» 的帳戶：%lld 筆，%@。由於沒有該帳戶的對帳單，這些紀錄將保留為「未分類」中的一般交易。"
          }
        }
      }
    },
