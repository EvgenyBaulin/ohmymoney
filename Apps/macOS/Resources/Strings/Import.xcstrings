    "import.identity.body": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адно значэнне ў радку. Гэтыя даныя захоўваюцца ў базе даных і архіве пераносу, але не трапляюць у экспарт CSV або справаздачу аб праблеме."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wert pro Zeile. Das bleibt in der Datenbank und im Übertragungsarchiv; es steht nicht im CSV-Export und nicht in einem Problembericht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One value per line. This stays in the database and the transfer archive; it is not in the CSV export or in a report about a problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor por línea. Esto se queda en la base de datos y en el archivo de traslado; no está en la exportación CSV ni en un informe de problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une valeur par ligne. Cela reste dans la base et dans l'archive de transfert ; ce n'est ni dans l'export CSV ni dans un rapport de problème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valore per riga. Questi dati rimangono nel database e nell’archivio di trasferimento; non sono inclusi nell’esportazione CSV né nelle segnalazioni di problemi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр жолда бір мән. Бұл дерекқорда және аударым мұрағатында сақталады; CSV экспортында немесе мәселе туралы есепте жоқ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно значение на строке. Это хранится в базе и в архиве переноса; в CSV-выгрузке и в отчёте о проблеме этого нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне значення в рядку. Це лишається в базі та в архіві переказів; у CSV-експорті або звіті про проблему цього немає."
          }
        }
      }
    },
