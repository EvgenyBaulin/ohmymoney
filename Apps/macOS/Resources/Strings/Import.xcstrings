    "import.identity.names.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Як у выпісцы банка: імя, імя па бацьку і першая літара прозвішча."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Form, die Banken drucken: Name, Vatersname und der erste Buchstabe des Nachnamens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The form banks print: name, patronymic and the first letter of the surname."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma que imprimen los bancos: nombre, patronímico y la inicial del apellido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La forme que les banques impriment : nom, patronyme et l'initiale du nom de famille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come riportati dalla banca: nome, patronimico e iniziale del cognome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банктер басып шығаратын пішім: аты, әкесінің аты және тегінің бірінші әрпі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W formie podawanej przez banki: imię, imię odojcowskie i pierwsza litera nazwiska."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como aparecem nos bancos: nome, patronímico e inicial do sobrenome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В том виде, как печатают банки: имя, отчество и первая буква фамилии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankaların yazdığı biçimde: ad, baba adı ve soyadının ilk harfi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма, яку друкують банки: ім'я, по батькові та перша літера прізвища."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank yozadigan shaklda: ism, otasining ismi va familiyaning birinchi harfi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行列印的格式：名字、父名和姓氏首字母。"
          }
        }
      }
    },
    "import.identity.open": {
