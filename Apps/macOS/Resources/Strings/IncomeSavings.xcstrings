          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кирешеси бар кеминде бир ай керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is minstens één maand met inkomen nodig."
          }
        },
        "pl": {
