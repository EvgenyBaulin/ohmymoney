    "income.baskets.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay gəlir olmadığından payları hesablamaq mümkün deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы даходу не было, таму няма з чаго вылічыць долі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto měsíci nebyl žádný příjem, takže není z čeho počítat podíly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Monat gab es keine Einnahmen, daher gibt es keine Anteile zu nehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was no income in this month, so there is nothing to take shares of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este mes no hubo ingresos, así que no hay partes que repartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas eu de revenu ce mois-ci, donc il n'y a aucune part à prendre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս եկամուտ չի եղել, ուստի բաժիններ հաշվարկել հնարավոր չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo mese non ci sono entrate da suddividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月は収入がないため、割合を計算できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში შემოსავალი არ ყოფილა, ამიტომ წილების გამოთვლა შეუძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл айда табыс болмады, сондықтан үлес алатын ештеңе жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달에는 수입이 없어 비율을 계산할 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда киреше болгон жок, ошондуктан үлүштөрдү эсептөө мүмкүн эмес."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er was deze maand geen inkomen om te verdelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu nie było dochodu, więc nie można obliczyć udziałów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve renda neste mês para calcular as proporções."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve rendimentos neste mês, pelo que não há valores a repartir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце не было дохода, долям не от чего считаться."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин моҳ даромад набуд, бинобар ин ҳиссаҳоро ҳисоб кардан имкон надорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay gelir olmadığı için paylar hesaplanamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому місяці доходу не було, тож і частки брати нема з чого."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy daromad bo‘lmadi, shuning uchun ulushlarni hisoblab bo‘lmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月没有收入，无法计算占比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個月沒有收入，因此無法計算比例。"
          }
        }
      }
    },
    "income.baskets.partial": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay hələ bitməyib: paylar dəyişə bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц яшчэ не скончыўся: долі могуць змяніцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
