        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cuenta del colchón marcada: márquelas en la pantalla de Capital."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte de matelas n'est marqué : marquez-les sur l'écran « Capital »."
