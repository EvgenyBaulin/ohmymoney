            "value": "수입의 %1$@ 사용 · 여유 자금 %2$@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кирешенин %1$@ жумшалат · %2$@ эркин калат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van inkomen gaat op aan verplichtingen · %2$@ speelruimte"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatki obowiązkowe: %1$@ dochodu · do dyspozycji: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ da renda comprometida · %2$@ disponíveis"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dos rendimentos comprometidos · %2$@ de margem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занято %1$@ дохода · на манёвр %2$@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ аз даромад сарф мешавад · %2$@ озод мемонад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelirin %1$@ kadarı ayrılıyor · %2$@ kullanımınıza kalıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ доходу забирається · %2$@ на маневр"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Daromadning %1$@ qismi band · %2$@ ixtiyorda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收入的 %1$@ 用于必需支出 · %2$@ 可自由支配"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收入的 %1$@ 已用於必要支出 · %2$@ 可自由運用"
          }
        }
      }
    },
    "income.obligatory.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aylarda gəlir olmadığından payı hesablamaq mümkün deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэтыя месяцы даходу не было, таму няма з чаго вылічыць долю."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V těchto měsících nebyl žádný příjem, takže není z čeho počítat podíl."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Monaten gab es keine Einnahmen, daher gibt es keinen Anteil zu nehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These months brought no income, so there is nothing to take a share of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En estos meses no hubo ingresos, así que no hay partes que repartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces mois n'ont pas apporté de revenu, donc il n'y a aucune part à prendre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիսներին եկամուտ չի եղել, ուստի բաժին հաշվարկել հնարավոր չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questi mesi non ci sono entrate da suddividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの月は収入がないため、割合を計算できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეებში შემოსავალი არ ყოფილა, ამიტომ წილის გამოთვლა შეუძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл айларда табыс түспеді, сондықтан үлес алатын ештеңе жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간에는 수입이 없어 비율을 계산할 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айларда киреше болгон жок, ошондуктан үлүштү эсептөө мүмкүн эмес."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er was in deze maanden geen inkomen om mee te vergelijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tych miesiącach nie było dochodu, więc nie można obliczyć udziału."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve renda nesses meses para calcular a proporção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve rendimentos nestes meses, pelo que não há valores a repartir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За эти месяцы не было дохода, долю считать не от чего."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин моҳҳо даромад набуд, бинобар ин ҳиссаро ҳисоб кардан имкон надорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aylarda gelir olmadığı için pay hesaplanamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цих місяцях доходу не було, тож і частки брати нема з чого."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oylarda daromad bo‘lmadi, shuning uchun ulushni hisoblab bo‘lmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这几个月没有收入，无法计算占比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這幾個月沒有收入，因此無法計算比例。"
          }
        }
      }
    },
    "income.obligatory.noObligatory": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məcburi xərclər hələ məlum deyil: bir neçə tam ay və zəruri kimi işarələnmiş kateqoriyalar lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Абавязковыя выдаткі пакуль невядомыя: патрэбны некалькі поўных месяцаў і катэгорыі, пазначаныя як неабходныя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutné výdaje zatím nejsou známé: je potřeba několik celých měsíců a kategorie označené jako nutné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die notwendigen Ausgaben sind noch nicht bekannt: Dafür braucht es einige volle Monate und als notwendig markierte Kategorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The obligatory spending is not known yet: it needs a few full months and categories marked as necessary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se conoce el gasto obligatorio: hacen falta algunos meses completos y categorías marcadas como necesarias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses obligatoires ne sont pas encore connues : il faut quelques mois complets et des catégories marquées comme nécessaires."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պարտադիր ծախսերը դեռ հայտնի չեն. պետք են մի քանի ամբողջական ամիս և որպես անհրաժեշտ նշված կատեգորիաներ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese obbligatorie non sono ancora note: servono alcuni mesi completi e categorie contrassegnate come necessarie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必須支出はまだ不明です。終了した数か月分のデータと、必要として設定されたカテゴリが必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სავალდებულო ხარჯი ჯერ უცნობია: საჭიროა რამდენიმე სრული თვე და აუცილებელ ხარჯებად მონიშნული კატეგორიები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міндетті шығыс әлі белгісіз: оған бірнеше толық ай және қажет деп белгіленген санаттар керек."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필수 지출을 아직 알 수 없습니다. 몇 달간의 전체 데이터와 필수로 지정된 카테고리가 필요합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Милдеттүү чыгым азырынча белгисиз: бир нече толук ай жана зарыл деп белгиленген категориялар керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verplichte uitgaven zijn nog niet bekend. Hiervoor zijn enkele volledige maanden en categorieën gemarkeerd als noodzakelijk nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatki obowiązkowe nie są jeszcze znane. Potrzeba kilku pełnych miesięcy i kategorii oznaczonych jako niezbędne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gastos obrigatórios ainda não são conhecidos. São necessários alguns meses completos e categorias marcadas como necessárias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As despesas obrigatórias ainda não são conhecidas: são necessários alguns meses completos e categorias marcadas como necessárias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обязательные траты пока не известны: нужны несколько полных месяцев и категории с отметкой «Необходимая трата»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ҳатмӣ ҳанӯз маълум нест: чанд моҳи пурра ва категорияҳои ҳамчун зарурӣ нишондодашуда лозиманд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorunlu harcama henüz bilinmiyor: Tamamlanmış birkaç ay ve gerekli olarak işaretlenmiş kategoriler gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обов'язкові витрати ще невідомі: потрібно кілька повних місяців і категорії, позначені як необхідні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Majburiy xarajatlar hali noma’lum: buning uchun bir necha to‘liq oy va zarur deb belgilangan toifalar kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法确定必需支出：需要几个月的完整数据，并将相关类别标记为必需。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未得知必要支出：需要幾個完整月份的資料，並將類別標記為必要。"
          }
        }
      }
    },
