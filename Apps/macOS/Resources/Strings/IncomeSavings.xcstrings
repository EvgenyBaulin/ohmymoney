    "income.nudge.sixToSix": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlki 6 ayla müqayisədə son 6 ayda gəlir %1$@, xərclər %2$@"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 месяцаў даход %1$@, выдаткі %2$@ у параўнанні з папярэднімі 6 месяцамі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za 6 měsíců příjmy %1$@, výdaje %2$@ oproti předchozím 6 měsícům"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 6 Monaten Einnahmen %1$@, Ausgaben %2$@ gegenüber den 6 davor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 6 months income %1$@, spending %2$@ against the 6 before"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En 6 meses ingresos %1$@, gastos %2$@ frente a los 6 anteriores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur 6 mois, revenus %1$@, dépenses %2$@ contre les 6 précédents"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "6 ամսում եկամուտը՝ %1$@, ծախսերը՝ %2$@՝ նախորդ 6 ամիսների համեմատ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Negli ultimi 6 mesi entrate %1$@, spese %2$@ rispetto ai 6 mesi precedenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去6か月の収入 %1$@、支出 %2$@（その前の6か月との比較）"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "6 თვის შემოსავალი %1$@, ხარჯი %2$@ წინა 6 თვესთან შედარებით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 6 айда табыс %1$@, шығыс %2$@ — алдыңғы 6 айға қарағанда"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 6개월 대비 최근 6개월 수입 %1$@, 지출 %2$@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мурунку 6 айга салыштырмалуу акыркы 6 айда киреше %1$@, чыгым %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgelopen 6 maanden: inkomen %1$@, uitgaven %2$@ vergeleken met de 6 maanden ervoor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciągu 6 miesięcy dochód %1$@, wydatki %2$@ względem poprzednich 6 miesięcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 6 meses: renda %1$@, gastos %2$@ em relação aos 6 meses anteriores"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 6 meses, rendimentos %1$@, despesas %2$@ face aos 6 meses anteriores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 месяцев доход %1$@, траты %2$@ к 6 предыдущим"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар 6 моҳ даромад %1$@, хароҷот %2$@ нисбат ба 6 моҳи пешин"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki 6 aya göre son 6 ayda gelir %1$@, harcama %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 місяців дохід %1$@, витрати %2$@ проти 6 попередніх"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldingi 6 oyga nisbatan so‘nggi 6 oyda daromad %1$@, xarajatlar %2$@"
