        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs more than a year of history, or at least a year of months, and an income to compare with."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір жылдан артық тарих керек, немесе кем дегенде бір жыл айлары және салыстыратын табыс."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно больше года истории, хотя бы год с небольшим, и доход, с которым сравнивать."
          }
        }
      }
    },
    "income.trend.outpaces": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgaben wachsen schneller als die Einnahmen. Lohnt es, darauf zu achten, bevor es zur Gewohnheit wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending grows faster than income. Worth noticing before it becomes the habit."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығын табыстан тезірек өсіп жатыр. Әдетке айналмай тұрып байқаған жөн."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты растут быстрее дохода. Стоит заметить, пока это не стало привычкой."
          }
        }
      }
    },
    "income.trend.resume": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Lohnt einen Blick“ zeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show it in “Worth a look”"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Назар аударарлық» ішінде көрсету"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать в «Стоит посмотреть»"
          }
        }
      }
    },
    "income.trend.seasonNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verglichen mit den Monaten davor, nicht mit dem Vorjahr: Sommer gegen Winter ist kein fairer Vergleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compared with the months just before, not with last year: summer against winter is not a fair comparison."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен жылмен емес, дәл алдындағы айлармен салыстырылады: жазды қыспен салыстыру әділ емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнение с предыдущими месяцами, а не с прошлым годом: лето с зимой сравнивать нечестно."
          }
        }
      }
    },
    "income.trend.sixToSix": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 6 Monaten Einnahmen %1$@, Ausgaben %2$@ gegenüber den 6 davor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 6 months income %1$@, spending %2$@ against the 6 before"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 6 айда табыс %1$@, шығыс %2$@ — алдыңғы 6 айға қарағанда"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 месяцев доход %1$@, траты %2$@ к 6 предыдущим"
          }
        }
      }
    },
    "income.trend.stop": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht mehr unter „Lohnt einen Blick“ zeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop showing it in “Worth a look”"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Назар аударарлық» ішінде көрсетуді тоқтату"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не показывать в «Стоит посмотреть»"
          }
        }
      }
    },
    "income.trend.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgaben folgen den Einnahmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending follows income"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығын табысқа ілесе ме"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты вслед за доходом"
          }
        }
      }
    },
    "income.trend.yearOverYear": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 3 Monaten Einnahmen %1$@, Ausgaben %2$@ gegenüber denselben Monaten vor einem Jahr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 3 months income %1$@, spending %2$@ against the same months a year ago"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 3 айда табыс %1$@, шығыс %2$@ — бір жыл бұрынғы сол айлармен салыстырғанда"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 3 месяца доход %1$@, траты %2$@ к тем же месяцам год назад"
          }
        }
      }
    },
