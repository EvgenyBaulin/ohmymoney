        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Empréstimos, assinaturas e despesas necessárias face aos rendimentos habituais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиты, подписки и необходимые траты к обычному доходу"
