        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկ ցուցանիշ՝ հինգ բաղադրիչից, դրանց մանրամասներով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un indice basato su cinque fattori, con il dettaglio del calcolo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5つの項目から算出したスコアとその内訳"
