    "why.norm.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no income in this month yet, so there is no rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ingresos en este mes, así que no hay tasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de revenu ce mois-ci, donc pas de taux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце дохода ещё нет, нормы нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому місяці доходу ще немає, тож норми немає."
          }
        }
      }
    },
    "why.norm.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month is not over: spending is still to come, so the rate looks better than it will."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes no ha terminado: el gasto todavía está por llegar, así que la tasa parece mejor de lo que será."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mois n'est pas terminé : les dépenses sont encore à venir, donc le taux paraît meilleur qu'il ne sera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц не закончился: траты ещё впереди, и норма выглядит лучше, чем будет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць ще не закінчився: витрати ще попереду, тож норма виглядає краще, ніж буде."
          }
        }
      }
    },
