    "why.health.leftTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not counted, no data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No contado, sin datos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не учтено, нет данных"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не враховано, немає даних"
          }
        }
      }
