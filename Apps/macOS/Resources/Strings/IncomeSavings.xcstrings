      }
    },
    "income.obligatory.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of income is taken · %2$@ to manoeuvre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
