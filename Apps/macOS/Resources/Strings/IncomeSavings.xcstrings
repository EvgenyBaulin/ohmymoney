    "why.norm.fallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no “Earnings” category, so all income is counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay categoría «Ganancias», así que se cuentan todos los ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de catégorie « Gains », donc tous les revenus sont comptés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории «Заработок» нет, поэтому считается весь доход."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорії «Заробіток» немає, тож враховується весь дохід."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è una categoria “Guadagni”, quindi vengono conteggiate tutte le entrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Табыс» санаты жоқ, сондықтан барлық табыс есептеледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыі «Заробак» няма, таму ўлічваюцца ўсе даходы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Kategorie „Verdienst“, daher wird alle Einnahme gezählt."
          }
        }
      }
    },
