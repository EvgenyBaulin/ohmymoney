    "income.norm.partialNote": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "* Ay hələ bitməyib: qarşıda xərclər var, buna görə göstərici olduğundan yaxşı görünür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "* Месяц яшчэ не скончыўся: выдаткі наперадзе, таму паказчык выглядае лепшым, чым будзе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "* Měsíc ještě neskončil: další výdaje teprve přijdou, takže číslo vypadá lépe než nakonec bude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "* Der Monat ist nicht vorbei: Die Ausgaben kommen noch, daher sieht die Zahl besser aus, als sie am Ende sein wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* The month is not over: spending is still to come, so the figure looks better than it will."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "* El mes no ha terminado: el gasto todavía está por llegar, así que la cifra parece mejor de lo que será."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "* Le mois n'est pas terminé : les dépenses sont encore à venir, donc le chiffre paraît meilleur qu'il ne sera."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "* Ամիսը դեռ չի ավարտվել. ծախսերը դեռ առջևում են, ուստի ցուցանիշն ավելի լավ է երևում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "* Il mese non è finito: ci saranno altre spese, quindi il dato è più favorevole di quello finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "* 今月はまだ終わっていません。今後の支出により、割合は下がる可能性があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "* თვე ჯერ არ დასრულებულა: ხარჯები კიდევ იქნება, ამიტომ მაჩვენებელი საბოლოოზე უკეთესად გამოიყურება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "* Ай аяқталмаған: шығыс әлі алда, сондықтан сан шынайысынан жақсырақ көрінеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "* 이번 달이 끝나지 않아 앞으로의 지출에 따라 수치가 낮아질 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "* Ай бүтө элек: чыгымдар дагы болот, ошондуктан көрсөткүч азыр жакшыраак көрүнөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "* De maand is nog niet voorbij: er komen nog uitgaven, dus het cijfer lijkt gunstiger dan het wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "* Miesiąc jeszcze trwa i wydatki będą rosnąć, więc wynik jest zawyżony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "* O mês ainda não terminou: ainda haverá gastos, então o valor parece melhor do que será."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "* O mês ainda não terminou: ainda haverá despesas, pelo que o valor parece melhor do que será."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "* Месяц не закончился: траты ещё впереди, и число выглядит лучше, чем будет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "* Моҳ ҳанӯз ба охир нарасидааст: хароҷот идома меёбад, бинобар ин нишондиҳанда ҳоло беҳтар менамояд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "* Ay henüz bitmedi: Harcamalar devam edeceği için oran olduğundan iyi görünüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "* Місяць ще не закінчився: витрати ще попереду, тож цифра виглядає краще, ніж буде."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "* Oy hali tugamadi: xarajatlar davom etadi, shuning uchun ko‘rsatkich hozir yuqoriroq."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "* 本月尚未结束，后续仍有支出，因此当前数值偏高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "* 本月尚未結束，後續還會有支出，因此目前的數字偏高。"
          }
        }
      }
    },
