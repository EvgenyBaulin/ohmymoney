    "why.norm.spending": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məqsədlərə ayrılan vəsait olmadan xərclərim"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі без унёскаў на мэты"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje výdaje bez příspěvků na cíle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben ohne Zielbeiträge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending without goal contributions"
          }
        },
        "es": {
          "stringUnit": {
