    "income.health.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es braucht Daten für mindestens zwei der fünf Teile: Polster, Schuldenlast, Sparquote, überfällige Fälligkeiten, Stabilität der Einnahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs data for at least two of the five parts: cushion, debt load, savings rate, overdue dues, stability of income."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бес бөліктің кем дегенде екеуіне деректер керек: жастық, берешек жүктемесі, жинақ мөлшерлемесі, мерзімі өткен төлемдер, табыстың тұрақтылығы."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны данные хотя бы по двум из пяти частей: подушка, долговая нагрузка, норма сбережений, просрочки, стабильность дохода."
          }
        }
      }
    },
    "income.health.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal aus Ihren Daten berechnet, mit niemandem verglichen. Ein Anhaltspunkt, keine Note."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted from your data every time, compared with no one. A guide, not a mark."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр уақытта сіздің деректеріңізден санналады, ешкіммен салыстырылмайды. Бағдар, баға емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считается из ваших данных заново каждый раз и ни с кем не сравнивается. Это ориентир, а не оценка."
          }
        }
      }
    },
