    "income.trend.calm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending does not grow faster than income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto no crece más deprisa que los ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses ne croissent pas plus vite que les revenus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты растут не быстрее дохода."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати не ростуть швидше за доходи."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese non crescono più delle entrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығын табыстан тезірек өспейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаткі растуць не хутчэй за даходы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgaben wachsen nicht schneller als die Einnahmen."
          }
        }
      }
    },
    "income.trend.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs more than a year of history, or at least a year of months, and an income to compare with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita más de un año de historial, o al menos un año de meses, y unos ingresos con los que comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut plus d'un an d'historique, ou au moins un an de mois, et un revenu à comparer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно больше года истории, хотя бы год с небольшим, и доход, с которым сравнивать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібна понад рік історії або щонайменше рік місяців і дохід для порівняння."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono più di 12 mesi di dati, o almeno 12 mesi completi, e delle entrate con cui confrontarli."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір жылдан артық тарих керек, немесе кем дегенде бір жыл айлары және салыстыратын табыс."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбна больш за год гісторыі або даныя хаця б за год і даход для параўнання."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür braucht es mehr als ein Jahr Verlauf oder mindestens ein Jahr Monate und eine Einnahme zum Vergleich."
          }
        }
      }
    },
    "income.trend.outpaces": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending grows faster than income. Worth noticing before it becomes the habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto crece más deprisa que los ingresos. Conviene fijarse antes de que se convierta en costumbre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses croissent plus vite que les revenus. Mieux vaut le remarquer avant que cela devienne une habitude."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты растут быстрее дохода. Стоит заметить, пока это не стало привычкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати ростуть швидше за доходи. Варто помітити це, доки це не стало звичкою."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese crescono più delle entrate. Meglio accorgersene prima che diventi un’abitudine."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығын табыстан тезірек өсіп жатыр. Әдетке айналмай тұрып байқаған жөн."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаткі растуць хутчэй за даходы. Варта звярнуць увагу, пакуль гэта не ўвайшло ў звычку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgaben wachsen schneller als die Einnahmen. Lohnt es, darauf zu achten, bevor es zur Gewohnheit wird."
          }
        }
      }
    },
    "income.trend.resume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show it in “Worth a look”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrarlo en «Merece una mirada»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'afficher dans « À regarder de plus près »"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать в «Стоит посмотреть»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати в «Варто глянути»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra in “Da tenere d’occhio”"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Назар аударарлық» ішінде көрсету"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паказваць у «Варта ўвагі»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Lohnt einen Blick“ zeigen"
          }
        }
      }
    },
    "income.trend.seasonNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compared with the months just before, not with last year: summer against winter is not a fair comparison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado con los meses inmediatamente anteriores, no con el año pasado: verano frente a invierno no es una comparación justa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparé aux mois qui précèdent, pas à l'an dernier : l'été face à l'hiver n'est pas une comparaison équitable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнение с предыдущими месяцами, а не с прошлым годом: лето с зимой сравнивать нечестно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівнюється з попередніми місяцями, а не з минулим роком: літо проти зими — некоректне порівняння."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il confronto è con i mesi precedenti, non con l’anno scorso: l’estate e l’inverno non sono paragonabili."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен жылмен емес, дәл алдындағы айлармен салыстырылады: жазды қыспен салыстыру әділ емес."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Параўнанне з папярэднімі месяцамі, а не з мінулым годам: параўноўваць лета з зімой было б несправядліва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verglichen mit den Monaten davor, nicht mit dem Vorjahr: Sommer gegen Winter ist kein fairer Vergleich."
          }
        }
      }
    },
    "income.trend.sixToSix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 6 months income %1$@, spending %2$@ against the 6 before"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En 6 meses ingresos %1$@, gastos %2$@ frente a los 6 anteriores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur 6 mois, revenus %1$@, dépenses %2$@ contre les 6 précédents"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 месяцев доход %1$@, траты %2$@ к 6 предыдущим"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 місяців дохід %1$@, витрати %2$@ проти 6 попередніх"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In 6 mesi, entrate %1$@, spese %2$@ rispetto ai 6 mesi precedenti"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 6 айда табыс %1$@, шығыс %2$@ — алдыңғы 6 айға қарағанда"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 месяцаў даходы %1$@, выдаткі %2$@ у параўнанні з папярэднімі 6 месяцамі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 6 Monaten Einnahmen %1$@, Ausgaben %2$@ gegenüber den 6 davor"
          }
        }
      }
    },
