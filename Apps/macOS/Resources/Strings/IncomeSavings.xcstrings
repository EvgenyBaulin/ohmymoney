    "why.health.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too few parts can be counted to say a number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden contar muy pocas partes para dar un número."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком мало частей можно посчитать, чтобы назвать число."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занадто мало частин можна врахувати, щоб назвати число."
          }
        }
      }
    },
    "why.health.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parts left out are not scored zero: the rest are scaled to a hundred. The number is compared with no one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes no incluidas no puntúan cero: las demás se escalan a cien. El número no se compara con nadie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Части без данных не получают ноль: остальные пересчитываются на сто. Число ни с кем не сравнивается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частини, що не враховані, не оцінюються як нуль: решта масштабується до ста. Число ні з ким не порівнюється."
          }
        }
      }
    },
