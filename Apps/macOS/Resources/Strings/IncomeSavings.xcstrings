    "income.trend.calm": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xərclər gəlirdən daha sürətli artmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаткі растуць не хутчэй за даходы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výdaje nerostou rychleji než příjmy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgaben wachsen nicht schneller als die Einnahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending does not grow faster than income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto no crece más deprisa que los ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses ne croissent pas plus vite que les revenus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծախսերը եկամտից արագ չեն աճում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese non crescono più delle entrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出は収入より速く増えていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯები შემოსავალზე სწრაფად არ იზრდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығын табыстан тезірек өспейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출이 수입보다 빠르게 늘지 않고 있어요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чыгым кирешеден тез өспөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je uitgaven stijgen niet sneller dan je inkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatki nie rosną szybciej niż dochody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gastos não crescem mais rápido que a renda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As despesas não crescem mais depressa do que os rendimentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты растут не быстрее дохода."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷот аз даромад тезтар афзоиш намеёбад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcamalar gelirden daha hızlı artmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати не ростуть швидше за доходи."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajatlar daromaddan tezroq o‘sayotgani yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支出增长未超过收入增长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出的成長速度未超過收入。"
          }
        }
      }
    },
    "income.trend.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Müqayisə üçün bir ildən çox tarixçə və ya ən azı bir illik aylar və gəlir lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбна больш за год гісторыі або даныя хаця б за год і даход для параўнання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potřeba více než rok historie nebo alespoň rok měsíců a příjem pro srovnání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür braucht es mehr als ein Jahr Verlauf oder mindestens ein Jahr Monate und eine Einnahme zum Vergleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs more than a year of history, or at least a year of months, and an income to compare with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita más de un año de historial, o al menos un año de meses, y unos ingresos con los que comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut plus d'un an d'historique, ou au moins un an de mois, et un revenu à comparer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համեմատելու համար անհրաժեշտ է ավելի քան մեկ տարվա պատմություն կամ առնվազն մեկ տարվա ամիսների տվյալներ, ինչպես նաև եկամուտ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono più di 12 mesi di dati, o almeno 12 mesi completi, e delle entrate con cui confrontarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較するには、1年を超える履歴、または少なくとも12か月分のデータと収入が必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შესადარებლად საჭიროა წელზე მეტი ისტორია ან სულ მცირე 12 თვის მონაცემები და შემოსავალი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір жылдан артық тарих керек, немесе кем дегенде бір жыл айлары және салыстыратын табыс."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1년이 넘는 기록 또는 최소 12개월의 기록과 비교할 수입이 필요해요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыштыруу үчүн бир жылдан ашык тарых же кеминде бир жылдык айлык маалымат жана киреше керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiervoor is meer dan een jaar aan gegevens nodig, of minstens een jaar aan maanden, en inkomen om mee te vergelijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzeba ponad roku historii lub co najmniej roku danych miesięcznych oraz dochodu do porównania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso ter mais de um ano de histórico ou pelo menos 12 meses registrados, além de renda para comparar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário mais de um ano de histórico, ou pelo menos 12 meses com dados, e rendimentos para comparar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно больше года истории, хотя бы год с небольшим, и доход, с которым сравнивать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои муқоиса таърихи зиёда аз як сол ё маълумоти ҳадди ақал як сол ва даромад лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırma için bir yılı aşkın geçmiş veya en az bir yıllık aylık veri ve gelir gerekli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібна понад рік історії або щонайменше рік місяців і дохід для порівняння."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Buning uchun bir yildan ortiq tarix yoki kamida bir yillik oylik ma’lumotlar hamda taqqoslash uchun daromad kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要一年以上的记录，或至少一整年的月度记录，以及可供比较的收入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要超過一年的紀錄，或至少完整一年的月份，以及可供比較的收入。"
          }
        }
      }
    },
    "income.trend.outpaces": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xərclər gəlirdən daha sürətli artır. Bu, vərdişə çevrilməzdən əvvəl diqqət yetirin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаткі растуць хутчэй за даходы. Варта звярнуць увагу, пакуль гэта не ўвайшло ў звычку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výdaje rostou rychleji než příjmy. Je dobré si toho všimnout, než se z toho stane zvyk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgaben wachsen schneller als die Einnahmen. Lohnt es, darauf zu achten, bevor es zur Gewohnheit wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending grows faster than income. Worth noticing before it becomes the habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto crece más deprisa que los ingresos. Conviene fijarse antes de que se convierta en costumbre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses croissent plus vite que les revenus. Mieux vaut le remarquer avant que cela devienne une habitude."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծախսերն եկամտից արագ են աճում։ Արժե ուշադրություն դարձնել, քանի դեռ դա սովորություն չի դարձել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese crescono più delle entrate. Meglio accorgersene prima che diventi un’abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出が収入より速く増えています。習慣になる前に確認しましょう。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯები შემოსავალზე სწრაფად იზრდება. მიაქციეთ ყურადღება, სანამ ეს ჩვევად იქცევა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығын табыстан тезірек өсіп жатыр. Әдетке айналмай тұрып байқаған жөн."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출이 수입보다 빠르게 늘고 있어요. 습관이 되기 전에 살펴보세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чыгым кирешеден тез өсүүдө. Бул адатка айлана электе көңүл буруңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je uitgaven stijgen sneller dan je inkomen. Goed om op te letten voordat het een gewoonte wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatki rosną szybciej niż dochody. Warto to zauważyć, zanim stanie się nawykiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gastos crescem mais rápido que a renda. Vale ficar de olho antes que vire hábito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As despesas crescem mais depressa do que os rendimentos. Convém prestar atenção antes que se torne um hábito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты растут быстрее дохода. Стоит заметить, пока это не стало привычкой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷот аз даромад тезтар меафзояд. Пеш аз он ки ин ба одат табдил ёбад, ба он таваҷҷуҳ кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcamalar gelirden daha hızlı artıyor. Alışkanlık haline gelmeden fark etmekte fayda var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати ростуть швидше за доходи. Варто помітити це, доки це не стало звичкою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajatlar daromaddan tezroq o‘smoqda. Bu odatga aylanmasidan e’tibor berishga arziydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支出增长超过收入增长。值得留意，避免成为习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出的成長速度超過收入。趁它成為習慣前留意一下。"
          }
        }
      }
    },
    "income.trend.resume": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Diqqətə dəyər” bölməsində göstər"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паказваць у «Варта ўвагі»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazovat v „Stojí za pozornost“"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Lohnt einen Blick“ zeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show it in “Worth a look”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrarlo en «Merece una mirada»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'afficher dans « À regarder de plus près »"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցույց տալ «Արժե նայել» բաժնում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra in “Da tenere d’occhio”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「要チェック」に表示"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩვენება განყოფილებაში „საყურადღებო“"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Назар аударарлық» ішінде көрсету"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘살펴볼 항목’에 표시"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Көңүл бурууга арзыйт» бөлүмүндө көрсөтүү"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon in ‘Goed om te bekijken’"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj w „Warto sprawdzić”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar em “Vale conferir”"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar em “A rever”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать в «Стоит посмотреть»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар «Қобили таваҷҷуҳ» нишон додан"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Göz Atmaya Değer” bölümünde göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати в «Варто глянути»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“E’tiborga molik”da ko‘rsatish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“值得关注”中显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「值得看看」中顯示"
          }
        }
      }
    },
    "income.trend.seasonNote": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ötən illə deyil, əvvəlki aylarla müqayisə edilir: yayı qışla müqayisə etmək düzgün olmazdı."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Параўнанне з папярэднімі месяцамі, а не з мінулым годам: параўноўваць лета з зімой было б несправядліва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Srovnání s předchozími měsíci, ne s loňskem: srovnávat léto se zimou není fér."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verglichen mit den Monaten davor, nicht mit dem Vorjahr: Sommer gegen Winter ist kein fairer Vergleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compared with the months just before, not with last year: summer against winter is not a fair comparison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado con los meses inmediatamente anteriores, no con el año pasado: verano frente a invierno no es una comparación justa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparé aux mois qui précèdent, pas à l'an dernier : l'été face à l'hiver n'est pas une comparaison équitable."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համեմատությունը նախորդ ամիսների հետ է, ոչ թե անցյալ տարվա․ ամառն ու ձմեռը համեմատելի չեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il confronto è con i mesi precedenti, non con l’anno scorso: l’estate e l’inverno non sono paragonabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前年ではなく、直前の数か月と比較しています。夏と冬の比較は公平ではありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შედარებულია უშუალოდ წინა თვეებთან და არა გასულ წელთან: ზაფხულის ზამთართან შედარება სამართლიანი არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен жылмен емес, дәл алдындағы айлармен салыстырылады: жазды қыспен салыстыру әділ емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작년이 아닌 직전 몇 개월과 비교해요. 여름과 겨울을 비교하는 것은 공정하지 않으니까요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөн жылга эмес, мурунку айларга салыштырылды: жай менен кышты салыштыруу туура эмес."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeleken met de maanden ervoor, niet met vorig jaar: de zomer met de winter vergelijken geeft een vertekend beeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównanie z poprzednimi miesiącami, nie z ubiegłym rokiem: porównanie lata z zimą nie byłoby miarodajne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado aos meses anteriores, não ao ano passado: comparar verão e inverno não seria justo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado com os meses anteriores, não com o ano passado: comparar o verão com o inverno não seria justo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнение с предыдущими месяцами, а не с прошлым годом: лето с зимой сравнивать нечестно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муқоиса бо моҳҳои пешин аст, на бо соли гузашта: муқоисаи тобистон бо зимистон одилона нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen yılla değil, hemen önceki aylarla karşılaştırılır: Yazı kışla karşılaştırmak adil olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівнюється з попередніми місяцями, а не з минулим роком: літо проти зими — некоректне порівняння."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan yil bilan emas, avvalgi oylar bilan taqqoslangan: yozni qish bilan taqqoslash to‘g‘ri emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与之前几个月比较，而非去年同期：夏季与冬季不宜直接比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與最近幾個月比較，而非去年同期：夏天和冬天相比並不公平。"
          }
        }
      }
    },
    "income.trend.sixToSix": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlki 6 ayla müqayisədə son 6 ayda gəlir %1$@, xərclər %2$@"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 месяцаў даходы %1$@, выдаткі %2$@ у параўнанні з папярэднімі 6 месяцамі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za 6 měsíců příjmy %1$@, výdaje %2$@ oproti předchozím 6 měsícům"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 6 Monaten Einnahmen %1$@, Ausgaben %2$@ gegenüber den 6 davor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 6 months income %1$@, spending %2$@ against the 6 before"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En 6 meses ingresos %1$@, gastos %2$@ frente a los 6 anteriores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur 6 mois, revenus %1$@, dépenses %2$@ contre les 6 précédents"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "6 ամսում եկամուտը՝ %1$@, ծախսերը՝ %2$@՝ նախորդ 6 ամսվա համեմատ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In 6 mesi, entrate %1$@, spese %2$@ rispetto ai 6 mesi precedenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前の6か月との比較：収入%1$@、支出%2$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წინა 6 თვესთან შედარებით, 6 თვეში შემოსავალი %1$@, ხარჯები %2$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 6 айда табыс %1$@, шығыс %2$@ — алдыңғы 6 айға қарағанда"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직전 6개월 대비 최근 6개월 수입 %1$@, 지출 %2$@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мурунку 6 айга салыштырмалуу: киреше %1$@, чыгым %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In 6 maanden: inkomen %1$@, uitgaven %2$@ ten opzichte van de 6 maanden ervoor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciągu 6 miesięcy dochody %1$@, wydatki %2$@ względem poprzednich 6 miesięcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 6 meses, renda %1$@ e gastos %2$@ em relação aos 6 meses anteriores"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 6 meses, rendimentos %1$@, despesas %2$@ face aos 6 meses anteriores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 месяцев доход %1$@, траты %2$@ к 6 предыдущим"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар 6 моҳ даромад %1$@, хароҷот %2$@ нисбат ба 6 моҳи пешин"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki 6 aya göre son 6 ayda gelir %1$@, harcama %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 місяців дохід %1$@, витрати %2$@ проти 6 попередніх"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "So‘nggi 6 oyda daromad %1$@, xarajatlar %2$@ — avvalgi 6 oyga nisbatan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近6个月与前6个月相比，收入%1$@，支出%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近 6 個月與前 6 個月相比，收入 %1$@，支出 %2$@"
          }
        }
      }
    },
    "income.trend.stop": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
