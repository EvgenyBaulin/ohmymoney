        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай бүтө элек: үлүштөр дагы өзгөрөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maand is nog niet voorbij: de verdeling verandert nog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesiąc jeszcze trwa, więc udziały mogą się zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mês ainda não terminou: as proporções vão mudar."
