            "value": "Кредити, підписки й необхідні витрати проти звичайного доходу"
          }
        }
      }
    },
    "income.obligatory.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatory ≈ %1$@ a month, %2$@ is left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatorio ≈ %1$@ al mes, queda %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatoire ≈ %1$@ par mois, reste %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обязательно ≈ %1$@ в месяц, остаётся %2$@"
