        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қарзҳо, обунаҳо ва хароҷоти зарурӣ нисбат ба даромади маъмулӣ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
