            "value": "Mi gasto sin aportaciones a objetivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses hors contributions aux objectifs"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Իմ ծախսերը՝ առանց նպատակներին հատկացումների"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese, esclusi i contributi agli obiettivi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標への積立金を除く支出"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი ხარჯები მიზნებისთვის გადადებული თანხის გარეშე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат салымдарынсыз менің шығысым"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표에 모은 금액을 제외한 지출"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Максаттарга салымдарды кошпогондогу чыгымдарым"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn uitgaven zonder bijdragen aan doelen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki bez wpłat na cele"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos sem contribuições para metas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas sem contribuições para objetivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои траты без взносов в цели"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ман бе маблағҳои барои ҳадафҳо ҷудошуда"
          }
        },
