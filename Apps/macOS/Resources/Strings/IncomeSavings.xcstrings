        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სესხები, გამოწერები და აუცილებელი ხარჯები ჩვეულებრივ შემოსავალთან მიმართებით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Несиелер, жазылымдар және қажетті шығыс — әдеттегі табысқа қарсы"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 수입 대비 대출, 구독 및 필수 지출"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Насыялардын, жазылуулардын жана зарыл чыгымдардын кадимки кирешеге катышы"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leningen, abonnementen en noodzakelijke uitgaven vergeleken met het gebruikelijke inkomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredyty, subskrypcje i niezbędne wydatki względem typowego dochodu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empréstimos, assinaturas e gastos necessários em relação à renda habitual"
