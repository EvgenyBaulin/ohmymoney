        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conto contrassegnato per il fondo di emergenza. Contrassegnane uno nella schermata Capitale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "備えの口座がありません。「資産」画面で設定してください。"
