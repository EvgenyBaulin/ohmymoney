    "income.baskets.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was no income in this month, so there is nothing to take shares of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este mes no hubo ingresos, así que no hay partes que repartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas eu de revenu ce mois-ci, donc il n'y a aucune part à prendre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце не было дохода, долям не от чего считаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому місяці доходу не було, тож і частки брати нема з чого."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo mese non ci sono entrate da suddividere."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл айда табыс болмады, сондықтан үлес алатын ештеңе жоқ."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы даходу не было, таму няма з чаго вылічыць долі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Monat gab es keine Einnahmen, daher gibt es keine Anteile zu nehmen."
          }
        }
      }
    },
    "income.baskets.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month is not over: the shares will still change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes no ha terminado: las partes todavía cambiarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mois n'est pas terminé : les parts vont encore changer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц не закончился: доли ещё изменятся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць ще не закінчився: частки ще зміняться."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mese non è finito: le quote possono ancora cambiare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай аяқталмаған: үлестер әлі өзгереді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц яшчэ не скончыўся: долі могуць змяніцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monat ist nicht vorbei: Die Anteile ändern sich noch."
          }
        }
      }
    },
