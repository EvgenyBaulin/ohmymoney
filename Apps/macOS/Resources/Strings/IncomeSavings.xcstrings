    "why.health.leftTitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesablanmayıb, məlumat yoxdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўлічана: няма даных"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezapočítáno, chybí data"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gezählt, keine Daten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not counted, no data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No contado, sin datos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non compté, pas de données"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չեն հաշվարկվել՝ տվյալներ չկան"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non conteggiati, dati assenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データがないため対象外"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არ არის გათვალისწინებული — მონაცემები არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептелмеген, деректер жоқ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 없어 반영되지 않음"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептелген жок: маалымат жок"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet meegeteld, geen gegevens"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uwzględniono — brak danych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não considerados por falta de dados"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não considerados por falta de dados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не учтено, нет данных"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоб нашуд, маълумот нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplanmadı, veri yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не враховано, немає даних"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblanmadi, ma’lumot yo‘q"
