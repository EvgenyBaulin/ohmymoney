    "income.norm.basisAll": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xərclərdən sonra qalan gəlir payı · bütün gəlirlər"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля даходу пасля выдаткаў · увесь даход"
