    "income.cushion.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cushion holds %1$@, obligatory spending ≈ %2$@ a day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El colchón tiene %1$@, gasto obligatorio ≈ %2$@ al día"
