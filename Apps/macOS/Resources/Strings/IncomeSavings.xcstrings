    "income.norm.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one month with income is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta al menos un mes con ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut au moins un mois avec des revenus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен хотя бы один месяц с доходом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен хоча б один місяць із доходом."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve almeno un mese con entrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кем дегенде табысы бар бір ай керек."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбны прынамсі адзін месяц з даходам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens ein Monat mit Einnahmen ist nötig."
          }
        }
      }
    },
    "income.norm.partialNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* The month is not over: spending is still to come, so the figure looks better than it will."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "* El mes no ha terminado: el gasto todavía está por llegar, así que la cifra parece mejor de lo que será."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "* Le mois n'est pas terminé : les dépenses sont encore à venir, donc le chiffre paraît meilleur qu'il ne sera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "* Месяц не закончился: траты ещё впереди, и число выглядит лучше, чем будет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "* Місяць ще не закінчився: витрати ще попереду, тож цифра виглядає краще, ніж буде."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "* Il mese non è finito: ci saranno altre spese, quindi il dato è più favorevole di quello finale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "* Ай аяқталмаған: шығыс әлі алда, сондықтан сан шынайысынан жақсырақ көрінеді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "* Месяц яшчэ не скончыўся: выдаткі наперадзе, таму паказчык выглядае лепшым, чым будзе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "* Der Monat ist nicht vorbei: Die Ausgaben kommen noch, daher sieht die Zahl besser aus, als sie am Ende sein wird."
          }
        }
      }
    },
