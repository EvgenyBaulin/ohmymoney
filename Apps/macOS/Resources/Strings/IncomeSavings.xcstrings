    "income.obligatory.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These months brought no income, so there is nothing to take a share of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En estos meses no hubo ingresos, así que no hay partes que repartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces mois n'ont pas apporté de revenu, donc il n'y a aucune part à prendre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За эти месяцы не было дохода, долю считать не от чего."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цих місяцях доходу не було, тож і частки брати нема з чого."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questi mesi non ci sono entrate da suddividere."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл айларда табыс түспеді, сондықтан үлес алатын ештеңе жоқ."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэтыя месяцы даходу не было, таму няма з чаго вылічыць долю."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Monaten gab es keine Einnahmen, daher gibt es keinen Anteil zu nehmen."
          }
        }
      }
    },
    "income.obligatory.noObligatory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The obligatory spending is not known yet: it needs a few full months and categories marked as necessary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se conoce el gasto obligatorio: hacen falta algunos meses completos y categorías marcadas como necesarias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses obligatoires ne sont pas encore connues : il faut quelques mois complets et des catégories marquées comme nécessaires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обязательные траты пока не известны: нужны несколько полных месяцев и категории с отметкой «Необходимая трата»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обов'язкові витрати ще невідомі: потрібно кілька повних місяців і категорії, позначені як необхідні."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese obbligatorie non sono ancora note: servono alcuni mesi completi e categorie contrassegnate come necessarie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міндетті шығыс әлі белгісіз: оған бірнеше толық ай және қажет деп белгіленген санаттар керек."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Абавязковыя выдаткі пакуль невядомыя: патрэбны некалькі поўных месяцаў і катэгорыі, пазначаныя як неабходныя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die notwendigen Ausgaben sind noch nicht bekannt: Dafür braucht es einige volle Monate und als notwendig markierte Kategorien."
          }
        }
      }
    },
