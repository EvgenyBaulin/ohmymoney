        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվան նախորդող ամբողջական ամիսները՝ առավելագույնը 24"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesi completi precedenti a quello attuale, fino a 24"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月より前の終了した月（最大24か月）"
          }
