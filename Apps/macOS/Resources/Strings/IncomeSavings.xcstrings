    "income.norm.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gəliri olan ən azı bir ay lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбны прынамсі адзін месяц з даходам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potřeba alespoň jeden měsíc s příjmem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens ein Monat mit Einnahmen ist nötig."
          }
        },
        "en": {
