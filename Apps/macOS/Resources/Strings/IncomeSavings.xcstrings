        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық шоттарының ақшасы күнделікті міндетті шығысқа бөлінген"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
