    "why.norm.fallback": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Kategorie „Verdienst“, daher wird alle Einnahme gezählt."
          }
        },
        "en": {
