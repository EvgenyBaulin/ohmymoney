        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვემდე დასრულებული თვეები, არაუმეტეს 24-ისა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айға дейінгі толық айлар, ең көбі 24"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 이전의 완료된 달, 최대 24개월"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушул айга чейинки толук айлар, эң көбү 24"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige maanden vóór deze maand, maximaal 24"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełne miesiące przed bieżącym, maksymalnie 24"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meses completos anteriores a este, no máximo 24"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Meses completos anteriores a este, até 24"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полные месяцы до текущего, не больше 24"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моҳҳои пурраи пеш аз ин моҳ, ҳадди аксар 24 моҳ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aydan önceki tamamlanmış aylar, en fazla 24 ay"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повні місяці перед цим, не більше 24"
          }
