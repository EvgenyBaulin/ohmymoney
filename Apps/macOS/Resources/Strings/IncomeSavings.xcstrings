          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ par jour après un revenu, contre %2$@ un jour ordinaire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ в день после поступления против %2$@ в обычный день"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ на день після надходження проти %2$@ у звичайний день"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ al giorno dopo un’entrata rispetto a %2$@ in un giorno normale"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табыстан кейінгі күніне %1$@, әдеттегі күнде — %2$@"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ за дзень пасля даходу супраць %2$@ у звычайны дзень"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ am Tag nach einer Einnahme gegenüber %2$@ an einem üblichen Tag"
          }
        }
      }
    },
    "income.salary.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the first three days you spend %@× as much"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los tres primeros días gasta %@× más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trois premiers jours, vous dépensez %@× plus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В первые три дня тратите в %@ раза больше обычного"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перші три дні ви витрачаєте в %@ разів більше"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei primi tre giorni spendi %@ volte tanto"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алғашқы үш күнде сіз %@× көп жұмсайсыз"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У першыя тры дні вы траціце ў %@× больш"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den ersten drei Tagen geben Sie %@× so viel aus"
          }
        }
      }
    },
    "income.salary.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs at least two finished expected incomes and seven usual days to compare with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacen falta al menos dos ingresos previstos terminados y siete días habituales para comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut au moins deux revenus attendus terminés et sept jours ordinaires pour comparer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно хотя бы два завершённых ожидаемых поступления и семь обычных дней для сравнения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для порівняння потрібно щонайменше два завершені очікувані доходи і сім звичайних днів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono almeno due entrate previste già ricevute e sette giorni normali con cui confrontarle."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыстыру үшін кем дегенде екі аяқталған күтілетін табыс және жеті әдеттегі күн керек."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбны прынамсі два завершаныя чаканыя паступленні і сем звычайных дзён для параўнання."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es braucht mindestens zwei abgeschlossene erwartete Einnahmen und sieben übliche Tage zum Vergleich."
          }
        }
      }
    },
