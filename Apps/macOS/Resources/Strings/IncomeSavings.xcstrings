        }
      }
    },
    "income.cushion.noAccounts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cushion account is marked: mark them on the Capital screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cuenta del colchón marcada: márquelas en la pantalla de Capital."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отмечен ни один счёт подушки: отметьте их на экране «Капитал»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден рахунок подушки не позначено: позначте їх на екрані «Капітал»."
          }
        }
      }
    },
