    "income.baskets.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Monat gab es keine Einnahmen, daher gibt es keine Anteile zu nehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was no income in this month, so there is nothing to take shares of."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл айда табыс болмады, сондықтан үлес алатын ештеңе жоқ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце не было дохода, долям не от чего считаться."
          }
        }
      }
    },
    "income.baskets.partial": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monat ist nicht vorbei: Die Anteile ändern sich noch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month is not over: the shares will still change."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай аяқталмаған: үлестер әлі өзгереді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц не закончился: доли ещё изменятся."
          }
        }
      }
    },
