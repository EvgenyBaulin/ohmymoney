    "why.norm.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay hələ gəlir yoxdur, buna görə faiz hesablanmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы даходаў яшчэ няма, таму норма не разлічана."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto měsíci zatím nejsou žádné příjmy, míru úspor nelze vypočítat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Monat gibt es noch keine Einnahmen, daher gibt es keine Quote."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no income in this month yet, so there is no rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ingresos en este mes, así que no hay tasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de revenu ce mois-ci, donc pas de taux."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս դեռ եկամուտ չկա, ուստի տոկոսը չի հաշվարկվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora entrate questo mese, quindi non c’è un tasso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月はまだ収入がないため、貯蓄率はありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში შემოსავალი ჯერ არ არის, ამიტომ წილი არ გამოითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл айда әлі табыс жоқ, сондықтан мөлшерлеме жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 수입이 아직 없어 저축률을 표시할 수 없어요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда киреше боло элек, ошондуктан үлүш эсептелбейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn deze maand nog geen inkomsten, dus er is geen percentage."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu nie ma jeszcze dochodów, więc nie można obliczyć stopy oszczędzania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há renda neste mês, então não há taxa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há rendimentos neste mês, pelo que não há taxa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце дохода ещё нет, нормы нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин моҳ ҳоло даромад нест, бинобар ин меъёр ҳисоб намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay henüz gelir olmadığı için oran hesaplanamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому місяці доходу ще немає, тож норми немає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy hali daromad yo‘q, shuning uchun ulush hisoblanmagan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月暂无收入，因此无法计算储蓄率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月尚無收入，因此沒有儲蓄率。"
          }
        }
      }
    },
    "why.norm.partial": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay hələ bitməyib: qarşıda xərclər var, buna görə faiz yekun nəticədən yüksək görünür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц яшчэ не скончыўся: выдаткі яшчэ будуць, таму норма выглядае лепш, чым будзе ў выніку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíc ještě neskončil: další výdaje teprve přijdou, takže míra úspor zatím vypadá lépe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monat ist nicht vorbei: Die Ausgaben kommen noch, daher sieht die Quote besser aus, als sie am Ende sein wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month is not over: spending is still to come, so the rate looks better than it will."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes no ha terminado: el gasto todavía está por llegar, así que la tasa parece mejor de lo que será."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mois n'est pas terminé : les dépenses sont encore à venir, donc le taux paraît meilleur qu'il ne sera."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամիսը դեռ չի ավարտվել․ ծախսերը շարունակվելու են, ուստի տոկոսն առայժմ ավելի բարձր է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mese non è ancora finito: ci saranno altre spese, quindi il tasso sembra migliore di quello finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の途中のため、今後の支出がまだ含まれず、貯蓄率が高く見えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვე ჯერ არ დასრულებულა და ხარჯები მოსალოდნელია, ამიტომ წილი საბოლოოზე უკეთ გამოიყურება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай аяқталмаған: шығыс әлі алда, сондықтан мөлшерлеме шынайысынан жақсырақ көрінеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달이 아직 끝나지 않았어요. 앞으로 지출이 더해지면 저축률이 낮아질 수 있어요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай бүтө элек: чыгымдар дагы болот, ошондуктан үлүш азыр жогору көрүнөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maand is nog niet voorbij: er komen nog uitgaven, dus het percentage ziet er nu beter uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesiąc jeszcze się nie skończył. Dalsze wydatki mogą obniżyć stopę oszczędzania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mês ainda não acabou e ainda haverá gastos, então a taxa parece melhor do que será."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O mês ainda não terminou e ainda haverá despesas, pelo que a taxa parece melhor do que será."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяц не закончился: траты ещё впереди, и норма выглядит лучше, чем будет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моҳ ҳанӯз тамом нашудааст ва хароҷот дар пеш аст, бинобар ин меъёр ҳоло баландтар менамояд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay henüz bitmedi. Harcamalar devam edeceği için oran şu anda daha iyi görünüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяць ще не закінчився: витрати ще попереду, тож норма виглядає краще, ніж буде."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oy hali tugamadi: xarajatlar davom etadi, shuning uchun ulush hozir yuqoriroq ko‘rinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月尚未结束，后续仍有支出，因此当前储蓄率会偏高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月尚未結束，之後還會有支出，因此目前的儲蓄率較高。"
          }
        }
      }
    },
