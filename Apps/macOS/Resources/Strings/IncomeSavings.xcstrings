    "income.salary.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Müqayisə üçün tamamlanmış ən azı iki gözlənilən gəlir və yeddi adi gün lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбны прынамсі два завершаныя чаканыя паступленні і сем звычайных дзён для параўнання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro srovnání jsou potřeba alespoň dva dokončené očekávané příjmy a sedm běžných dní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es braucht mindestens zwei abgeschlossene erwartete Einnahmen und sieben übliche Tage zum Vergleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs at least two finished expected incomes and seven usual days to compare with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacen falta al menos dos ingresos previstos terminados y siete días habituales para comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut au moins deux revenus attendus terminés et sept jours ordinaires pour comparer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համեմատելու համար պետք են առնվազն երկու ավարտված սպասվող եկամուտ և յոթ սովորական օր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono almeno due entrate previste già ricevute e sette giorni normali con cui confrontarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較するには、予定された収入の完了が2回以上と、通常の日が7日以上必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შესადარებლად საჭიროა სულ მცირე ორი მიღებული მოსალოდნელი შემოსავალი და შვიდი ჩვეულებრივი დღე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыстыру үшін кем дегенде екі аяқталған күтілетін табыс және жеті әдеттегі күн керек."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교하려면 완료된 예상 수입 2건과 평소 지출 7일분이 필요합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыштыруу үчүн кеминде эки алынган күтүлгөн киреше жана жети кадимки күн керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn minstens twee afgeronde verwachte inkomsten en zeven gewone dagen nodig om te vergelijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do porównania potrzeba co najmniej dwóch zakończonych okresów po spodziewanym dochodzie i siedmiu zwykłych dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessárias pelo menos duas entradas de renda esperadas já concluídas e sete dias habituais para comparação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessários pelo menos dois recebimentos previstos concluídos e sete dias normais para comparação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно хотя бы два завершённых ожидаемых поступления и семь обычных дней для сравнения."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои муқоиса ҳадди ақал ду даромади интизоршудаи гирифташуда ва ҳафт рӯзи маъмулӣ лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırma için gerçekleşmiş en az iki beklenen gelir ve yedi olağan gün gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для порівняння потрібно щонайменше два завершені очікувані доходи і сім звичайних днів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Taqqoslash uchun kutilgan kamida ikkita daromad va yettita odatdagi kun kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要两笔已到账的预期收入和七天的日常数据作为对比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要兩筆已完成的預期收入，以及七天平常日的資料才能比較。"
          }
        }
      }
    },
