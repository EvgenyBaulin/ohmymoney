    "income.norm.partialNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* The month is not over: spending is still to come, so the figure looks better than it will."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "* El mes no ha terminado: el gasto todavía está por llegar, así que la cifra parece mejor de lo que será."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "* Le mois n'est pas terminé : les dépenses sont encore à venir, donc le chiffre paraît meilleur qu'il ne sera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "* Месяц не закончился: траты ещё впереди, и число выглядит лучше, чем будет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "* Місяць ще не закінчився: витрати ще попереду, тож цифра виглядає краще, ніж буде."
          }
        }
      }
    },
