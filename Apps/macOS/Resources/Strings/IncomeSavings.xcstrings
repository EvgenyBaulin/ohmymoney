    "income.salary.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gəlirdən sonrakı ilk üç günün ayın qalan günləri ilə müqayisəsi"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Першыя тры дні пасля даходу ў параўнанні з астатнімі днямі месяца"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První tři dny po příjmu oproti zbytku měsíce"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ersten drei Tage nach einer Einnahme gegenüber dem Rest des Monats"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first three days after an income against the rest of the month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tres primeros días tras un ingreso frente al resto del mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trois premiers jours après un revenu, comparés au reste du mois"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եկամտից հետո առաջին երեք օրը՝ ամսվա մնացած օրերի համեմատ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I primi tre giorni dopo un’entrata rispetto al resto del mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収入後の3日間と、月の残りの日を比較"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შემოსავლის მიღებიდან პირველი სამი დღე თვის დანარჩენ დღეებთან შედარებით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табыстан кейінгі алғашқы үш күн — айдың қалған бөлігіне қарсы"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수입이 들어온 후 3일과 그 외 기간 비교"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кирешеден кийинки алгачкы үч күндү айдын калган күндөрү менен салыштыруу"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste drie dagen na inkomen vergeleken met de rest van de maand"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsze trzy dni po otrzymaniu dochodu względem reszty miesiąca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os três primeiros dias após uma entrada de renda em relação ao restante do mês"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os primeiros três dias após um rendimento face ao resto do mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые три дня после поступления против остального месяца"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Се рӯзи аввали пас аз даромад нисбат ба рӯзҳои боқимондаи моҳ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelirden sonraki ilk üç günün ayın kalanıyla karşılaştırması"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
