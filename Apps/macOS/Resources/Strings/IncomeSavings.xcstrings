    "income.settings.trendNudge": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xərclər gəlirdən daha sürətlə artanda bildir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паведамляць, калі выдаткі растуць хутчэй за даход"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornit, když výdaje rostou rychleji než příjmy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagen, wenn die Ausgaben die Einnahmen überholen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say when spending outgrows income"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar cuando el gasto supere a los ingresos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler quand les dépenses dépassent les revenus"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հայտնել, երբ ծախսերն ավելի արագ են աճում, քան եկամուտը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisa quando le spese crescono più delle entrate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出が収入より速く増えたら通知"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შემატყობინე, როცა ხარჯები შემოსავალზე სწრაფად იზრდება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығын табыстан озған кезде айту"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출이 수입보다 빠르게 늘면 알리기"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чыгым кирешеден тез өссө кабарлоо"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld als uitgaven sneller stijgen dan inkomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuj, gdy wydatki rosną szybciej niż dochody"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar quando os gastos crescerem mais que a renda"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar quando as despesas crescem mais do que os rendimentos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорить, если траты растут быстрее дохода"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вақте хароҷот аз даромад тезтар меафзояд, хабар диҳед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcamalar geliri aştığında bildir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Казати, коли витрати переростають доходи"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajatlar daromaddan tezroq oshsa, xabar berish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支出增长超过收入时提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出增幅超過收入時提醒"
          }
        }
      }
    },
    "income.settings.trendNudgeHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Baxmağa dəyər” bölməsində, rübdə ən çox bir dəfə"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Радок у раздзеле «Варта паглядзець» не часцей за раз на квартал"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádek v části „Stojí za pozornost“, nejvýš jednou za čtvrtletí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile unter „Lohnt einen Blick“, höchstens einmal im Quartal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A line in “Worth a look”, no more than once a quarter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea en «Merece una mirada», como mucho una vez por trimestre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne dans « À regarder de plus près », au plus une fois par trimestre"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տող «Արժե նայել» բաժնում՝ եռամսյակը մեկից ոչ ավելի"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga in “Da vedere”, al massimo una volta a trimestre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「確認しましょう」に最大3か月に1回表示"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეტყობინება განყოფილებაში „ყურადღების ღირსია“, არა უმეტეს კვარტალში ერთხელ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Назар аударарлық» ішінде бір жол, тоқсанына бір реттен артық емес"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분기당 최대 한 번 ‘살펴보기’에 표시"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Көңүл буруңуз» бөлүмүндө чейрегине бир жолудан ашпаган эскертме"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding in ‘Bekijk ook’, maximaal eens per kwartaal"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacja w „Warto sprawdzić”, nie częściej niż raz na kwartał"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha em “Vale a pena ver”, no máximo uma vez por trimestre"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha em “A espreitar”, no máximo uma vez por trimestre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка в «Стоит посмотреть», не чаще раза в квартал"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатр дар «Ба назар гирифтан», на бештар аз як бор дар семоҳа"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Göz atmaya değer” bölümünde üç ayda en fazla bir kez gösterilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
