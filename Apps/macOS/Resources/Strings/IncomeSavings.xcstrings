    "income.stability.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aydan əvvəlki tamamlanmış aylar, ən çox 24 ay"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Поўныя месяцы да бягучага, не больш за 24"
