    "why.health.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rəqəm göstərmək üçün kifayət qədər hissə hesablana bilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова складнікаў для разліку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro výpočet čísla lze započítat příliš málo složek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es können zu wenige Teile gezählt werden, um eine Zahl zu nennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too few parts can be counted to say a number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden contar muy pocas partes para dar un número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop peu de parties peuvent être comptées pour donner un chiffre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թիվը հաշվարկելու համար բավարար բաղադրիչներ չկան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono abbastanza componenti da calcolare per mostrare un valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集計できる項目が少なすぎるため、数値を表示できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაჩვენებლის გამოსათვლელად საკმარისი მონაცემები არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санды айтуға есептелетін бөлік тым аз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반영할 수 있는 항목이 너무 적어 점수를 표시할 수 없어요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сан чыгаруу үчүн маалымат жетишсиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kunnen te weinig onderdelen worden meegeteld om een cijfer te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt mało składników do obliczenia wyniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há itens suficientes para calcular um número."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há dados suficientes para calcular apenas alguns componentes, pelo que não é possível apresentar um valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком мало частей можно посчитать, чтобы назвать число."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ҳисоб кардани нишондиҳанда қисмҳои кофӣ нестанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puan vermek için yeterli bileşen hesaplanamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занадто мало частин можна врахувати, щоб назвати число."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Natijani hisoblash uchun ma’lumot yetarli emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可计入的项目太少，无法计算分数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可計入的項目太少，無法計算分數。"
          }
        }
      }
    },
    "why.health.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nəzərə alınmayan hissələrə sıfır bal verilmir: qalanları 100 bala uyğunlaşdırılır. Nəticə heç kiminki ilə müqayisə edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Неўлічаныя складнікі не лічацца за нуль: астатнія пералічваюцца да ста. Паказчык ні з кім не параўноўваецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynechané složky nedostávají nulu: ostatní se přepočítají na sto. Číslo se s nikým nesrovnává."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fehlenden Teile werden nicht mit null bewertet: Die übrigen werden auf hundert hochgerechnet. Die Zahl wird mit niemandem verglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parts left out are not scored zero: the rest are scaled to a hundred. The number is compared with no one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes no incluidas no puntúan cero: las demás se escalan a cien. El número no se compara con nadie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parties non prises en compte ne valent pas zéro : les autres sont ramenées sur cent. Le chiffre n'est comparé à personne."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բաց թողնված բաղադրիչները զրո չեն գնահատվում․ մնացածների միավորները բերվում են հարյուրի։ Արդյունքը ոչ մեկի հետ չի համեմատվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai componenti esclusi non viene assegnato zero: gli altri sono riportati su una scala di 100. Il valore non viene confrontato con quello di altre persone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象外の項目は0点とはせず、残りの項目を100点満点に換算します。この数値は誰とも比較されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოტოვებული ნაწილები ნულით არ ფასდება: დანარჩენები 100-ქულიან სკალაზე გადადის. მაჩვენებელი სხვებს არ ედრება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығарылған бөліктер нөлге бағаланбайды: қалғандары жүзге дейін масштабталады. Сан ешкіммен салыстырылмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제외된 항목은 0점으로 처리하지 않아요. 나머지 항목을 100점 만점으로 환산하며, 다른 사람과 비교하지 않아요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Калтырылган бөлүктөргө нөл коюлбайт: калгандары жүз баллга ылайык эсептелет. Көрсөткүч эч кимдики менен салыштырылбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De onderdelen die niet meetellen krijgen geen nul: de rest wordt omgerekend naar honderd. Het cijfer wordt met niemand vergeleken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominiętym składnikom nie przypisano zera. Pozostałe przeliczono do stu punktów. Wynik nie jest porównywany z wynikami innych osób."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens excluídos não recebem zero: os demais são ajustados para somar cem. O número não é comparado ao de outras pessoas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os componentes excluídos não recebem zero: os restantes são ajustados para uma escala de 100. O valor não é comparado com o de outras pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Части без данных не получают ноль: остальные пересчитываются на сто. Число ни с кем не сравнивается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба қисмҳои берунмонда сифр дода намешавад: қисмҳои боқимонда то сад мутаносиб карда мешаванд. Нишондиҳанда бо касе муқоиса намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplanmayan bileşenlere sıfır puan verilmez; diğerleri yüz üzerinden ölçeklendirilir. Puan kimseyle karşılaştırılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частини, що не враховані, не оцінюються як нуль: решта масштабується до ста. Число ні з ким не порівнюється."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumot yo‘q qismlarga nol ball berilmaydi: qolganlari 100 ballik shkalaga moslanadi. Natija boshqalar bilan taqqoslanmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未计入的项目不会记为零分，其他项目会按比例折算为百分制。此分数不与他人比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未計入的項目不會以零分計算；其餘項目會換算為百分制。此分數不與他人比較。"
          }
        }
      }
    },
