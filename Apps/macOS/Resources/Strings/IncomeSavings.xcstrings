    "income.health.basis": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş göstərici üzrə ümumi nəticə və onun bölgüsü"
          }
        },
        "be": {
