    "income.baskets.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was no income in this month, so there is nothing to take shares of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este mes no hubo ingresos, así que no hay partes que repartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas eu de revenu ce mois-ci, donc il n'y a aucune part à prendre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце не было дохода, долям не от чего считаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому місяці доходу не було, тож і частки брати нема з чого."
          }
        }
      }
    },
