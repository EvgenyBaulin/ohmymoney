        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахункі падушкі не пазначаны. Пазначце іх на экране «Капітал»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není označen žádný účet rezervy. Označte ho na obrazovce Kapitál."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
