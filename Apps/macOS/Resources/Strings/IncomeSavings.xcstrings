    "income.salary.basis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first three days after an income against the rest of the month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tres primeros días tras un ingreso frente al resto del mes"
          }
