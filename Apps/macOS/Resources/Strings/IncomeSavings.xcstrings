      }
    },
    "income.cushion.noAccounts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Polster-Konto ist markiert: Markieren Sie sie auf dem Bildschirm „Kapital“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cushion account is marked: mark them on the Capital screen."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық есеп-шоты белгіленбеген: оларды «Капитал» экранында белгілеңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отмечен ни один счёт подушки: отметьте их на экране «Капитал»."
          }
        }
      }
    },
