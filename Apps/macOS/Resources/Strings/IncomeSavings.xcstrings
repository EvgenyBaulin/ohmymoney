    "income.cushion.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Polster hält %1$@, notwendige Ausgaben ≈ %2$@ am Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cushion holds %1$@, obligatory spending ≈ %2$@ a day"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастықта %1$@, міндетті шығыс ≈ күніне %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На подушке %1$@, обязательные траты ≈ %2$@ в день"
