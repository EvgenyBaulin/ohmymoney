          "stringUnit": {
            "state": "translated",
            "value": "Stopa oszczędzania tylko z zarobków"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxa de economia apenas sobre rendimentos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxa de poupança apenas dos rendimentos do trabalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Норма сбережений только от «Заработка»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Меъёри пасандоз танҳо аз музди кор"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birikim oranını yalnızca kazançlardan hesapla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Норма заощаджень лише з заробітку"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamg‘arma ulushi faqat ish daromadidan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用劳动收入计算储蓄率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲蓄率僅計工作收入"
          }
        }
      }
    },
    "income.settings.earningsOnlyHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu halda keşbek, faiz və artıqlar dərəcə üçün gəlir sayılmır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк, працэнты і лішкі не ўлічваюцца ў даходзе для разліку нормы"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback, úroky a přebytky se pak do příjmů pro výpočet nezapočítávají"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback, Zinsen und Überschüsse zählen dann nicht als Einnahmen für die Quote"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback, interest and surpluses are then not income for the rate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cashback, los intereses y los excedentes entonces no cuentan como ingreso para la tasa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback, les intérêts et les excédents ne sont alors pas des revenus pour le taux"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քեշբեքը, տոկոսներն ու ավելցուկներն այդ դեպքում եկամուտ չեն համարվում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback, interessi ed eccedenze sono esclusi dalle entrate per il calcolo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュバック、利息、余剰金は収入に含まれません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ქეშბექი, პროცენტი და ნამეტი ამ მაჩვენებელში შემოსავლად არ ჩაითვლება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сонда кешбэк, пайыз және артықшылықтар мөлшерлеме үшін табыс болмайды"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시백, 이자 및 잉여금은 저축률 계산 시 수입에서 제외됩니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Анда кэшбэк, пайыздар жана ашыкча каражаттар үлүштү эсептөөдө киреше катары саналбайт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback, rente en overschotten tellen dan niet mee als inkomen voor het percentage"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwroty, odsetki i nadwyżki nie są wtedy uwzględniane jako dochód"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback, juros e excedentes não entram no cálculo da taxa"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback, os juros e os excedentes não contam como rendimentos para a taxa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк, проценты и излишки тогда не считаются доходом для нормы"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк, фоизҳо ва маблағи изофӣ дар ҳисоб ба даромад дохил намешаванд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iadeleri, faiz ve fazlalar oran hesaplanırken gelire dahil edilmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тоді кешбек, відсотки й надлишки не є доходом для норми"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunda keshbek, foizlar va ortiqchalar ulushni hisoblashda daromadga kirmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算储蓄率时，返现、利息和盈余不计为收入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算儲蓄率時，不將現金回饋、利息和盈餘計入收入"
          }
        }
      }
    },
    "income.settings.footer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisbətlər və seçimlər verilənlər bazasında saxlanır və arxivə daxil edilir. Kateqoriyanın səbəti Kateqoriyalar bölməsində seçilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прапорцыі і налады захоўваюцца ў базе даных і пераносяцца разам з архівам. Кошык катэгорыі задаецца ў раздзеле «Катэгорыі»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podíly a nastavení se ukládají do databáze a přenášejí se s archivem. Koš kategorie nastavíte v kategoriích."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anteile und Schalter werden in der Datenbank aufbewahrt und wandern mit dem Archiv. Der Korb einer Kategorie wird unter „Kategorien“ festgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proportions and switches are kept in the database and travel with the archive. The basket of a category is set in Categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las proporciones y los interruptores se guardan en la base de datos y viajan con el archivo. La cesta de cada categoría se fija en Categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les proportions et les interrupteurs sont gardés dans la base et voyagent avec l'archive. Le panier d'une catégorie se règle dans « Catégories »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համամասնություններն ու կարգավորումները պահվում են տվյալների շտեմարանում և փոխանցվում արխիվի հետ։ Կատեգորիայի զամբյուղը սահմանվում է «Կատեգորիաներ» բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proporzioni e le impostazioni sono salvate nel database e incluse nell’archivio. Puoi impostare la quota di una categoria in Categorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割合と設定はデータベースに保存され、アーカイブに含まれます。カテゴリのバスケットは「カテゴリ」で設定します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პროპორციები და პარამეტრები ინახება მონაცემთა ბაზაში და გადადის არქივთან ერთად. კატეგორიის კალათა განისაზღვრება კატეგორიებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлестер мен ауыстырғыштар дерекқорда сақталады және мұрағатпен бірге жүреді. Санаттың себеті «Санаттарда» белгіленеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비율과 설정은 데이터베이스에 저장되며 아카이브에 포함됩니다. 카테고리의 바구니는 카테고리에서 설정합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлүштөр жана жөндөөлөр маалымат базасында сакталат жана архив менен кошо көчүрүлөт. Категориянын себети «Категориялар» бөлүмүндө коюлат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verdeling en instellingen worden in de database bewaard en gaan mee met het archief. Je stelt de budgetpot van een categorie in onder Categorieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporcje i ustawienia są zapisywane w bazie danych i przenoszone z archiwum. Koszyk kategorii ustawisz w Kategoriach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As proporções e opções são salvas no banco de dados e incluídas no arquivo. O grupo de cada categoria é definido em Categorias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As proporções e opções são guardadas na base de dados e incluídas no arquivo. A categoria do orçamento é definida em Categorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропорции и переключатели хранятся в базе и переезжают архивом. Корзину категории выбирают в «Категориях»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таносубҳо ва танзимот дар пойгоҳи додаҳо нигоҳ дошта шуда, бо бойгонӣ интиқол меёбанд. Сабади категория дар «Категорияҳо» таъин мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oranlar ve ayarlar veri tabanında saklanır ve arşivle birlikte taşınır. Bir kategorinin sepeti Kategoriler bölümünde ayarlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частки й перемикачі зберігаються в базі й переходять разом з архівом. Кошик категорії задається в «Категоріях»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisbatlar va sozlamalar ma’lumotlar bazasida saqlanadi va arxiv bilan birga ko‘chiriladi. Toifaning savati Toifalar bo‘limida belgilanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比例和开关设置保存在数据库中，并随归档文件一同保存。类别的预算分类可在“类别”中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比例和開關設定會儲存在資料庫中，並隨封存檔一併保存。可在「類別」中設定各類別的預算分配。"
          }
        }
      }
    },
