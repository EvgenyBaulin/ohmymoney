          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ du revenu est pris · %2$@ de marge"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занято %1$@ дохода · на манёвр %2$@"
