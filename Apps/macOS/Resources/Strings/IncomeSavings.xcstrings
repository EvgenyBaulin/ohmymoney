    "why.health.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es können zu wenige Teile gezählt werden, um eine Zahl zu nennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too few parts can be counted to say a number."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санды айтуға есептелетін бөлік тым аз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком мало частей можно посчитать, чтобы назвать число."
          }
        }
      }
    },
    "why.health.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fehlenden Teile werden nicht mit null bewertet: Die übrigen werden auf hundert hochgerechnet. Die Zahl wird mit niemandem verglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parts left out are not scored zero: the rest are scaled to a hundred. The number is compared with no one."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығарылған бөліктер нөлге бағаланбайды: қалғандары жүзге дейін масштабталады. Сан ешкіммен салыстырылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Части без данных не получают ноль: остальные пересчитываются на сто. Число ни с кем не сравнивается."
          }
        }
      }
    },
