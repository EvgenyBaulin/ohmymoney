    "income.health.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs data for at least two of the five parts: cushion, debt load, savings rate, overdue dues, stability of income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita datos de al menos dos de las cinco partes: colchón, carga de deudas, tasa de ahorro, vencimientos atrasados, estabilidad de los ingresos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны данные хотя бы по двум из пяти частей: подушка, долговая нагрузка, норма сбережений, просрочки, стабильность дохода."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібні дані щонайменше для двох із п'яти частин: подушка, навантаження боргами, норма заощаджень, прострочені платежі, стабільність доходу."
          }
        }
      }
    },
    "income.health.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted from your data every time, compared with no one. A guide, not a mark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se calcula cada vez con sus datos, sin compararse con nadie. Una guía, no una calificación."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считается из ваших данных заново каждый раз и ни с кем не сравнивается. Это ориентир, а не оценка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахується щоразу з ваших даних, ні з ким не порівнюючи. Орієнтир, а не оцінка."
          }
        }
      }
    },
