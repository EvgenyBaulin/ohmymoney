        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het deel van je inkomen dat overblijft na uitgaven · alle inkomsten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część dochodu pozostała po wydatkach · cały dochód"
