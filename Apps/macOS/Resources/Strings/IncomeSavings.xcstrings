    "income.health.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş göstəricidən ən azı ikisi üzrə məlumat lazımdır: ehtiyat, borc yükü, yığım dərəcəsi, vaxtı keçmiş ödənişlər, gəlirin sabitliyi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбны даныя прынамсі для дзвюх з пяці частак: падушка, даўгавая нагрузка, норма зберажэнняў, пратэрмінаваныя плацяжы, стабільнасць даходу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou potřeba data alespoň pro dvě z pěti oblastí: rezerva, dluhová zátěž, míra úspor, platby po splatnosti a stabilita příjmů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es braucht Daten für mindestens zwei der fünf Teile: Polster, Schuldenlast, Sparquote, überfällige Fälligkeiten, Stabilität der Einnahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs data for at least two of the five parts: cushion, debt load, savings rate, overdue dues, stability of income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita datos de al menos dos de las cinco partes: colchón, carga de deudas, tasa de ahorro, vencimientos atrasados, estabilidad de los ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut des données pour au moins deux des cinq parties : matelas, poids des dettes, taux d'épargne, échéances en retard, stabilité des revenus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պետք են տվյալներ հինգ բաղադրիչներից առնվազն երկուսի համար՝ պահուստ, պարտքային բեռ, խնայողության բաժին, ժամկետանց վճարումներ, եկամտի կայունություն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono dati per almeno due dei cinque fattori: fondo di emergenza, peso dei debiti, tasso di risparmio, pagamenti scaduti e stabilità delle entrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "備え、借入負担、貯蓄率、支払期限超過、収入の安定性のうち、2項目以上のデータが必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საჭიროა მონაცემები ხუთი ნაწილიდან სულ მცირე ორისთვის: უსაფრთხოების ბალიში, ვალის ტვირთი, დანაზოგის წილი, ვადაგადაცილებული გადასახდელები, შემოსავლის სტაბილურობა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бес бөліктің кем дегенде екеуіне деректер керек: жастық, берешек жүктемесі, жинақ мөлшерлемесі, мерзімі өткен төлемдер, табыстың тұрақтылығы."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비상금, 부채 부담, 저축률, 연체금, 수입 안정성 중 2개 이상의 데이터가 필요합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Беш бөлүктүн кеминде экөө боюнча маалымат керек: коопсуздук жаздыгы, карыз жүгү, топтоо үлүшү, мөөнөтү өткөн төлөмдөр, кирешенин туруктуулугу."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevens voor minstens twee van de vijf onderdelen zijn nodig: buffer, schuldenlast, spaarpercentage, achterstallige betalingen en inkomensstabiliteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzeba danych dla co najmniej dwóch z pięciu składników: poduszki, obciążenia długiem, stopy oszczędzania, zaległych płatności i stabilności dochodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessários dados de pelo menos duas das cinco partes: reserva, endividamento, taxa de economia, pagamentos em atraso e estabilidade da renda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessários dados para pelo menos dois dos cinco componentes: reserva, encargos com dívidas, taxa de poupança, pagamentos em atraso e estabilidade dos rendimentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны данные хотя бы по двум из пяти частей: подушка, долговая нагрузка, норма сбережений, просрочки, стабильность дохода."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумот барои ҳадди ақал ду қисм аз панҷ қисм лозим аст: захира, бори қарз, меъёри пасандоз, пардохтҳои муҳлатгузашта, устувории даромад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş bileşenden en az ikisi için veri gerekir: güvence, borç yükü, birikim oranı, gecikmiş ödemeler ve gelir istikrarı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібні дані щонайменше для двох із п'яти частин: подушка, навантаження боргами, норма заощаджень, прострочені платежі, стабільність доходу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Besh qismdan kamida ikkitasi uchun ma’lumot kerak: zaxira, qarz yuki, jamg‘arma ulushi, muddati o‘tgan to‘lovlar, daromad barqarorligi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五项中至少需要两项的数据：备用金、债务负担、储蓄率、逾期款项和收入稳定性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五個部分中至少需要兩項資料：預備金、債務負擔、儲蓄率、逾期款項及收入穩定度。"
          }
        }
      }
    },
    "income.health.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər dəfə məlumatlarınız əsasında hesablanır, heç kimlə müqayisə edilmir. Bu, qiymət deyil, bələdçidir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожны раз разлічваецца паводле вашых даных, без параўнання з іншымі. Арыенцір, а не адзнака."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy se počítá z vašich dat, bez srovnání s ostatními. Slouží pro orientaci, ne jako známka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal aus Ihren Daten berechnet, mit niemandem verglichen. Ein Anhaltspunkt, keine Note."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted from your data every time, compared with no one. A guide, not a mark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se calcula cada vez con sus datos, sin compararse con nadie. Una guía, no una calificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé à chaque fois à partir de vos données, sans comparaison avec personne. Un repère, pas une note."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն անգամ հաշվարկվում է ձեր տվյալներից՝ առանց ուրիշների հետ համեմատելու։ Ուղեցույց է, ոչ գնահատական։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato ogni volta dai tuoi dati, senza confronti con altri. Un’indicazione, non un voto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのデータから毎回計算され、他の人とは比較されません。評価ではなく、目安です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველ ჯერზე გამოითვლება თქვენი მონაცემებით, სხვებთან შედარების გარეშე. ეს ორიენტირია და არა შეფასება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр уақытта сіздің деректеріңізден санналады, ешкіммен салыстырылмайды. Бағдар, баға емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람과 비교하지 않고 내 데이터로 계산합니다. 평가가 아닌 참고 지표입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар дайым өз маалыматыңыздан эсептелет, эч ким менен салыштырылбайт. Бул баа эмес, багыт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telkens berekend op basis van je eigen gegevens, zonder vergelijking met anderen. Een richtlijn, geen beoordeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczane na podstawie Twoich danych, bez porównań z innymi. To wskazówka, nie ocena."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado sempre com seus dados, sem comparações. Uma orientação, não uma nota."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado sempre a partir dos seus dados, sem comparações. Uma orientação, não uma classificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считается из ваших данных заново каждый раз и ни с кем не сравнивается. Это ориентир, а не оценка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳар дафъа аз рӯи маълумоти шумо ҳисоб мешавад, бе муқоиса бо дигарон. Роҳнамо аст, на баҳо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seferinde verilerinizden hesaplanır, kimseyle karşılaştırılmaz. Bir not değil, yol göstericidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахується щоразу з ваших даних, ні з ким не порівнюючи. Орієнтир, а не оцінка."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har safar ma’lumotlaringiz asosida hisoblanadi, hech kim bilan taqqoslanmaydi. Bu baho emas, yo‘nalish ko‘rsatkichi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次根据你的数据计算，不与他人比较。仅供参考，不代表评价。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次根據你的資料計算，不與他人比較。僅供參考，並非評分。"
          }
        }
      }
    },
