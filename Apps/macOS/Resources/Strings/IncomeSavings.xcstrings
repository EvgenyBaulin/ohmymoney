    "income.cushion.basis": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld der Polster-Konten über die notwendigen Ausgaben eines Tages"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money of the cushion accounts over the obligatory spending of a day"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық шоттарының ақшасы күнделікті міндетті шығысқа бөлінген"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги на счетах подушки к обязательным тратам за день"
          }
        }
      }
    },
