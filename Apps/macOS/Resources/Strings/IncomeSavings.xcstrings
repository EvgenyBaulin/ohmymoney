    "income.health.basis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One number out of five parts, with the breakdown it adds up from"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número de cinco partes, con el desglose del que se compone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно число из пяти частей, всегда с разбором"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне число з п'яти частин, із розбивкою, з якої воно складається"
          }
        }
      }
    },
