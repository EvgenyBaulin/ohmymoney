    "income.trend.seasonNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compared with the months just before, not with last year: summer against winter is not a fair comparison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado con los meses inmediatamente anteriores, no con el año pasado: verano frente a invierno no es una comparación justa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнение с предыдущими месяцами, а не с прошлым годом: лето с зимой сравнивать нечестно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівнюється з попередніми місяцями, а не з минулим роком: літо проти зими — некоректне порівняння."
          }
        }
      }
    },
    "income.trend.sixToSix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 6 months income %1$@, spending %2$@ against the 6 before"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En 6 meses ingresos %1$@, gastos %2$@ frente a los 6 anteriores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 месяцев доход %1$@, траты %2$@ к 6 предыдущим"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За 6 місяців дохід %1$@, витрати %2$@ проти 6 попередніх"
          }
        }
      }
    },
    "income.trend.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop showing it in “Worth a look”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de mostrarlo en «Merece una mirada»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не показывать в «Стоит посмотреть»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не показувати в «Варто глянути»"
          }
        }
      }
    },
    "income.trend.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending follows income"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto sigue a los ingresos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты вслед за доходом"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати слідують за доходом"
          }
        }
      }
    },
    "income.trend.yearOverYear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 3 months income %1$@, spending %2$@ against the same months a year ago"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En 3 meses ingresos %1$@, gastos %2$@ frente a los mismos meses del año pasado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 3 месяца доход %1$@, траты %2$@ к тем же месяцам год назад"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За 3 місяці дохід %1$@, витрати %2$@ проти тих самих місяців рік тому"
          }
        }
      }
    },
