    "income.trend.yearOverYear": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ötən ilin eyni ayları ilə müqayisədə son 3 ayda gəlir %1$@, xərclər %2$@"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За 3 месяцы даходы %1$@, выдаткі %2$@ у параўнанні з тымі ж месяцамі год таму"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za 3 měsíce příjmy %1$@, výdaje %2$@ oproti stejným měsícům loni"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 3 Monaten Einnahmen %1$@, Ausgaben %2$@ gegenüber denselben Monaten vor einem Jahr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 3 months income %1$@, spending %2$@ against the same months a year ago"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En 3 meses ingresos %1$@, gastos %2$@ frente a los mismos meses del año pasado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur 3 mois, revenus %1$@, dépenses %2$@ contre les mêmes mois l'an dernier"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ամսում եկամուտը՝ %1$@, ծախսերը՝ %2$@՝ անցյալ տարվա նույն ամիսների համեմատ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In 3 mesi, entrate %1$@, spese %2$@ rispetto agli stessi mesi dell’anno scorso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前年の同じ3か月との比較：収入%1$@、支出%2$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წინა წლის იმავე თვეებთან შედარებით, 3 თვეში შემოსავალი %1$@, ხარჯები %2$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 3 айда табыс %1$@, шығыс %2$@ — бір жыл бұрынғы сол айлармен салыстырғанда"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작년 같은 기간 대비 최근 3개월 수입 %1$@, 지출 %2$@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөн жылдын ошол эле 3 айына салыштырмалуу: киреше %1$@, чыгым %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In 3 maanden: inkomen %1$@, uitgaven %2$@ ten opzichte van dezelfde maanden vorig jaar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciągu 3 miesięcy dochody %1$@, wydatki %2$@ względem tych samych miesięcy rok temu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 3 meses, renda %1$@ e gastos %2$@ em relação aos mesmos meses do ano passado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 3 meses, rendimentos %1$@, despesas %2$@ face aos mesmos meses do ano passado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 3 месяца доход %1$@, траты %2$@ к тем же месяцам год назад"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар 3 моҳ даромад %1$@, хароҷот %2$@ нисбат ба ҳамин моҳҳои соли гузашта"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen yılın aynı aylarına göre son 3 ayda gelir %1$@, harcama %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За 3 місяці дохід %1$@, витрати %2$@ проти тих самих місяців рік тому"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "So‘nggi 3 oyda daromad %1$@, xarajatlar %2$@ — o‘tgan yilning shu oylariga nisbatan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近3个月与去年同期相比，收入%1$@，支出%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近 3 個月與去年同期相比，收入 %1$@，支出 %2$@"
          }
        }
      }
    },
