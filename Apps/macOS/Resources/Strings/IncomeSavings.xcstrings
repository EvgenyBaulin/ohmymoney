        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditlar, obunalar va zarur xarajatlarning odatdagi daromadga nisbati"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
