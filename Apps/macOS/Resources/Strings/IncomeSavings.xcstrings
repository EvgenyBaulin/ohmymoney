    "why.health.leftTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gezählt, keine Daten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not counted, no data"
          }
        },
        "kk": {
          "stringUnit": {
