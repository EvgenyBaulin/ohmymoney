        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთი მაჩვენებელი ხუთი ნაწილისა და მათი განაწილების მიხედვით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бес бөліктен шыққан бір сан және оны құрайтын бөлшектер"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5가지 항목을 합산한 점수와 세부 내역"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Беш бөлүктөн турган жалпы көрсөткүч жана анын курамы"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén score op basis van vijf onderdelen, met uitsplitsing"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik z pięciu składników i jego szczegóły"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um indicador composto por cinco partes, com seus detalhes"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor calculado a partir de cinco componentes, com a respetiva distribuição"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно число из пяти частей, всегда с разбором"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Як нишондиҳанда аз панҷ қисм ва шарҳи ҳисоб"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş bileşenden oluşan tek bir değer ve dökümü"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне число з п'яти частин, із розбивкою, з якої воно складається"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Besh qismdan tuzilgan ko‘rsatkich va uning tarkibi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由五个部分组成的综合分数及其明细"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由五個部分算出的總分及其明細"
          }
        }
      }
    },
