        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահուստային հաշիվների գումարը՝ բաժանած օրվա պարտադիր ծախսերին"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro nei conti del fondo di emergenza rispetto alle spese obbligatorie giornaliere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "備えの口座の残高 ÷ 1日の必須支出"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უსაფრთხოების ბალიშის ანგარიშებზე არსებული თანხა გაყოფილი დღის სავალდებულო ხარჯზე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық шоттарының ақшасы күнделікті міндетті шығысқа бөлінген"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비상금 계좌의 잔액을 하루 필수 지출로 나눈 값"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Коопсуздук жаздыгынын эсептериндеги акчанын бир күндүк милдеттүү чыгымга катышы"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geld op je bufferrekeningen gedeeld door de verplichte uitgaven per dag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środki na kontach poduszki podzielone przez dzienne wydatki obowiązkowe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo das contas da reserva dividido pelos gastos obrigatórios diários"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo das contas de reserva a dividir pelas despesas obrigatórias diárias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
