          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не показывать в «Стоит посмотреть»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не показувати в «Варто глянути»"
          }
        }
