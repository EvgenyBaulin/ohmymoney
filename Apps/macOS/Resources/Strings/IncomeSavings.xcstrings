    "income.settings.earningsOnlyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback, interest and surpluses are then not income for the rate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cashback, los intereses y los excedentes entonces no cuentan como ingreso para la tasa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback, les intérêts et les excédents ne sont alors pas des revenus pour le taux"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк, проценты и излишки тогда не считаются доходом для нормы"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тоді кешбек, відсотки й надлишки не є доходом для норми"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback, interessi ed eccedenze sono esclusi dalle entrate per il calcolo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сонда кешбэк, пайыз және артықшылықтар мөлшерлеме үшін табыс болмайды"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк, працэнты і лішкі не ўлічваюцца ў даходзе для разліку нормы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback, Zinsen und Überschüsse zählen dann nicht als Einnahmen für die Quote"
          }
        }
      }
    },
    "income.settings.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proportions and switches are kept in the database and travel with the archive. The basket of a category is set in Categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las proporciones y los interruptores se guardan en la base de datos y viajan con el archivo. La cesta de cada categoría se fija en Categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les proportions et les interrupteurs sont gardés dans la base et voyagent avec l'archive. Le panier d'une catégorie se règle dans « Catégories »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропорции и переключатели хранятся в базе и переезжают архивом. Корзину категории выбирают в «Категориях»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частки й перемикачі зберігаються в базі й переходять разом з архівом. Кошик категорії задається в «Категоріях»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proporzioni e le impostazioni sono salvate nel database e incluse nell’archivio. Puoi impostare la quota di una categoria in Categorie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлестер мен ауыстырғыштар дерекқорда сақталады және мұрағатпен бірге жүреді. Санаттың себеті «Санаттарда» белгіленеді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прапорцыі і налады захоўваюцца ў базе даных і пераносяцца разам з архівам. Кошык катэгорыі задаецца ў раздзеле «Катэгорыі»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anteile und Schalter werden in der Datenbank aufbewahrt und wandern mit dem Archiv. Der Korb einer Kategorie wird unter „Kategorien“ festgelegt."
          }
        }
      }
    },
