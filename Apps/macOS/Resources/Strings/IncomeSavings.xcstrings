    },
    "income.salary.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs at least two finished expected incomes and seven usual days to compare with."
          }
        },
        "es": {
