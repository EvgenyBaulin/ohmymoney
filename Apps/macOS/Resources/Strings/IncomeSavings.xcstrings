    "income.health.basis": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahl aus fünf Teilen, mit der Aufschlüsselung, aus der sie sich ergibt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One number out of five parts, with the breakdown it adds up from"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бес бөліктен шыққан бір сан және оны құрайтын бөлшектер"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно число из пяти частей, всегда с разбором"
          }
        }
      }
    },
