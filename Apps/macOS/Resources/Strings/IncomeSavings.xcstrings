            "state": "translated",
            "value": "Over 3 months income %1$@, spending %2$@ against the same months a year ago"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En 3 meses ingresos %1$@, gastos %2$@ frente a los mismos meses del año pasado"
          }
        },
        "fr": {
          "stringUnit": {
