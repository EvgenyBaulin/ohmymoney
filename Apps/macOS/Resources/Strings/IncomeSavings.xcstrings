    "why.norm.fallback": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Qazanc” kateqoriyası yoxdur, buna görə bütün gəlir hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыі «Заробак» няма, таму ўлічваюцца ўсе даходы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie „Výdělky“ neexistuje, proto se počítají všechny příjmy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Kategorie „Verdienst“, daher wird alle Einnahme gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no “Earnings” category, so all income is counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay categoría «Ganancias», así que se cuentan todos los ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de catégorie « Gains », donc tous les revenus sont comptés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Վաստակ» կատեգորիա չկա, ուստի հաշվարկվում է ամբողջ եկամուտը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è una categoria “Guadagni”, quindi vengono conteggiate tutte le entrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「収入」カテゴリがないため、すべての収入を集計します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორია „გამომუშავებული“ არ არის, ამიტომ ითვლება მთელი შემოსავალი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Табыс» санаты жоқ, сондықтан барлық табыс есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘수입’ 카테고리가 없어 모든 수입을 반영해요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Иштеп тапкан акча» категориясы жок, ошондуктан бардык киреше эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen categorie ‘Inkomsten’, dus alle inkomsten tellen mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma kategorii „Zarobki”, więc uwzględniono wszystkie dochody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há categoria “Ganhos”, então toda a renda é considerada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não existe uma categoria “Rendimentos”, pelo que são considerados todos os rendimentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории «Заработок» нет, поэтому считается весь доход."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияи «Даромадҳо» нест, бинобар ин тамоми даромад ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kazançlar” kategorisi olmadığı için tüm gelirler hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорії «Заробіток» немає, тож враховується весь дохід."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ish haqi” toifasi yo‘q, shuning uchun barcha daromad hisobga olinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有“收入”类别，因此计入所有收入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有「所得」類別，因此計入所有收入。"
          }
        }
      }
    },
