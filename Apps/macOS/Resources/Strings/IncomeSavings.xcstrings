        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық есеп-шоты белгіленбеген: оларды «Капитал» экранында белгілеңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비상금 계좌가 없습니다. 자산 화면에서 지정하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Коопсуздук жаздыгынын эсеби белгиленген жок. Аларды «Капитал» экранында белгилеңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen bufferrekeningen gemarkeerd. Markeer ze onder Vermogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie oznaczono kont poduszki. Oznacz je na ekranie Kapitał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta de reserva foi marcada. Marque na tela Patrimônio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta de reserva selecionada: selecione-as no ecrã Património."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отмечен ни один счёт подушки: отметьте их на экране «Капитал»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ягон ҳисоби захиравӣ нишон нашудааст: онҳоро дар экрани «Сармоя» нишон диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvence hesabı işaretlenmemiş. Sermaye ekranında işaretleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден рахунок подушки не позначено: позначте їх на екрані «Капітал»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaxira hisobraqami belgilanmagan. Uni Kapital ekranida belgilang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未标记备用金账户，请在“资产”页面标记。"
