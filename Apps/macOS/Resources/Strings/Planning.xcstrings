    "form.goal.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Унёскі застануцца выдаткамі, а падкатэгорыя мэты пяройдзе ў архіў. Новая мэта пачнецца з нуля. ⌘Z адновіць мэту."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Beiträge bleiben Ausgaben, wie sie waren, und die Unterkategorie des Ziels wandert ins Archiv. Ein neues Ziel beginnt bei null. ⌘Z nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its contributions stay spending as they were, and the goal's subcategory goes to the archive. A new goal starts from zero. ⌘Z takes it back."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contributi rimangono tra le spese e la sottocategoria dell’obiettivo viene archiviata. Un nuovo obiettivo parte da zero. Premi ⌘Z per annullare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның салымдары бұрынғыдай шығын болып қалады, ал мақсаттың ішкі санаты мұрағатқа өтеді. Жаңа мақсат нөлден басталады. ⌘Z қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её взносы останутся расходами, как были, а подкатегория цели уйдёт в архив. Новая цель начнётся с нуля. Отменить можно через ⌘Z."
          }
        }
      }
    },
    "form.goal.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Унёскі застануцца выдаткамі, а падкатэгорыя мэты пяройдзе ў архіў. Новая мэта пачнецца з нуля. “Адмяніць” адновіць мэту."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Beiträge bleiben Ausgaben, wie sie waren, und die Unterkategorie des Ziels wandert ins Archiv. Ein neues Ziel beginnt bei null. „Rückgängig“ nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its contributions stay spending as they were, and the goal's subcategory goes to the archive. A new goal starts from zero. “Undo” takes it back."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contributi rimangono tra le spese e la sottocategoria dell’obiettivo viene archiviata. Un nuovo obiettivo parte da zero. Tocca “Annulla” per ripristinare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның салымдары бұрынғыдай шығын болып қалады, ал мақсаттың ішкі санаты мұрағатқа өтеді. Жаңа мақсат нөлден басталады. «Болдырмау» қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её взносы останутся расходами, как были, а подкатегория цели уйдёт в архив. Новая цель начнётся с нуля. «Отменить» вернёт цель."
          }
        }
      }
    },
    "form.goal.delete.outsideGoals": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Немагчыма выдаліць гэту мэту: некаторыя ўнёскі знаходзяцца па-за катэгорыяй мэт."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ziel kann nicht gelöscht werden: Einige seiner Beiträge sind außerhalb der Kategorie „Ziele“ abgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This goal cannot be deleted: some of its contributions are filed outside the goals category."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare questo obiettivo: alcuni contributi sono registrati fuori dalla categoria degli obiettivi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл мақсатты жою мүмкін емес: оның кейбір салымдары «Мақсаттар» санатынан тыс жазылған."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту цель не удалить: у неё есть взносы вне категории целей."
          }
        }
      }
    },
