    "reconcile.saveOnlyHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансы захаваюцца; розніца не будзе запісана як аперацыя ні цяпер, ні пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Salden bleiben erhalten; die Differenz wird weder jetzt noch später als Vorgang erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balances are kept; the difference is not recorded as an operation, now or later."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi vengono conservati; la differenza non viene registrata come operazione, né ora né in seguito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теңгерімдер сақталады; айырма қазір де, кейін де операция ретінде жазылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки запомнятся, а разница не запишется операцией — ни сейчас, ни потом."
          }
        }
      }
    },
