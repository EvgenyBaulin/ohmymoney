    "limits.suggest.none": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма прапаноў: усе катэгорыі з выдаткамі за апошнія тры месяцы ўжо маюць ліміт або гісторыі пакуль недастаткова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts vorzuschlagen: Jede Kategorie, in der Sie in den letzten drei Monaten ausgegeben haben, hat schon ein Limit, oder es gibt noch zu wenig Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to suggest: every category spent on in the last three months already has a limit, or there is too little history yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que sugerir: todas las categorías en las que gastó en los últimos tres meses ya tienen límite, o todavía hay poco historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à suggérer : chaque catégorie dépensée ces trois derniers mois a déjà un plafond, ou l'historique est encore trop court."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun suggerimento: tutte le categorie con spese negli ultimi tre mesi hanno già un limite oppure non ci sono ancora abbastanza dati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұсынатын ештеңе жоқ: соңғы үш айда шығын болған әр санатта лимит бар, не тарих әлі аз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak sugestii: każda kategoria z wydatkami w ostatnich trzech miesiącach ma już limit lub historia jest zbyt krótka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma sugestão: todas as categorias com gastos nos últimos três meses já têm limite ou ainda não há histórico suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить нечего: у всех категорий с тратами за последние три месяца уже есть лимит, или истории пока мало."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilecek bir şey yok: Son üç ayda harcama yapılan her kategorinin zaten bir limiti var veya henüz yeterli geçmiş yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонувати нічого: кожна категорія, на яку витрачали за останні три місяці, вже має ліміт, або історії ще замало."
          }
        }
      }
    },
    "limits.suggest.open": {
