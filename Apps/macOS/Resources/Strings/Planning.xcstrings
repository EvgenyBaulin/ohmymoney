    "form.event.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж уваходзіць у бюджэт падзеі: з вольнай сумы ён асобна не адымаецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung gehört zum Budget des Ereignisses: Der freie Betrag zieht sie nicht gesondert ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment is part of the event's budget: the free sum does not take it off separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago forma parte del presupuesto del evento: la suma libre no lo descuenta por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement fait partie du budget de l'événement : la somme libre ne le retire pas à part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento fa parte del budget dell’evento: non viene sottratto separatamente dalla somma disponibile."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлем іс-шара бюджетінің бөлігі: бос қаржыдан бөлек шегерілмейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność należy do budżetu wydarzenia: nie jest ponownie odejmowana od wolnej kwoty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento faz parte do orçamento do evento e não é descontado separadamente do saldo livre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёж войдёт в бюджет события: свободная сумма не вычтет его отдельно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme etkinlik bütçesine dahildir; serbest tutardan ayrıca düşülmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж входить до бюджету події: вільна сума окремо його не віднімає."
          }
        }
      }
    },
