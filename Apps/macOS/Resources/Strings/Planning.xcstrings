    "form.limit.rolloverHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new amount, or carrying over switched on, starts the carry again this month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un importe nuevo, o activar el traspaso, vuelve a empezar el traspaso este mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau montant, ou le report activé, relance le report dès ce mois-ci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая сумма, как и включённый перенос, начинает перенос остатка заново с этого месяца."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нова сума або увімкнене перенесення починають перенесення знову цього місяця."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo importo o l’attivazione del riporto fa ripartire il conteggio da questo mese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа сома немесе көшіру қосылса, көшіру осы айда қайта басталады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры змене сумы або ўключэнні пераносу назапашванне пачынаецца зноў у гэтым месяцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Betrag oder eingeschaltetes Übertragen beginnt die Übertragung in diesem Monat neu."
          }
        }
      }
    },
