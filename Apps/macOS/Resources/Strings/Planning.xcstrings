    "namesake.financial.unique": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv hesabların, kartların və bankların adları və ləqəbləri unikal olmalıdır. Arxivdə eyni adlı qeydin olması saxlamağa mane olmur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назвы і псеўданімы актыўных рахункаў, картак і банкаў не павінны паўтарацца. Аднайменны запіс у архіве не перашкаджае захаванню."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy a aliasy aktivních účtů, karet a bank musí být jedinečné. Stejný název v archivu nebrání uložení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und Aliasse aktiver Konten, Karten und Banken müssen eindeutig sein. Ein gleichnamiger archivierter Eintrag verhindert das Sichern nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and aliases of active accounts, cards and banks must stay unique. An archived namesake does not prevent saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres y alias de las cuentas, tarjetas y bancos activos deben ser únicos. Un registro archivado con el mismo nombre no impide guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms et alias des comptes, cartes et banques actifs doivent être uniques. Un homonyme archivé n’empêche pas l’enregistrement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ակտիվ հաշիվների, քարտերի և բանկերի անուններն ու այլանունները պետք է եզակի լինեն։ Արխիվացված նույնանուն գրառումը չի խանգարում պահպանելուն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi e gli alias di conti, carte e banche attivi devono essere univoci. Una voce archiviata con lo stesso nome non impedisce il salvataggio."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქტიური ანგარიშების, ბარათებისა და ბანკების სახელები და მეტსახელები უნიკალური უნდა იყოს. არქივში არსებული მოსახელე ჩანაწერი შენახვას ხელს არ უშლის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белсенді шоттардың, карталар мен банктердің атаулары мен бүркеншік аттары бірегей болуы керек. Мұрағаттағы аттас жазба сақтауға кедергі емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Активдүү эсептердин, карталардын жана банктардын аталыштары жана башка аталыштары кайталанбашы керек. Архивдеги аты окшош жазуу сактоого тоскоол болбойт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy i aliasy aktywnych kont, kart i banków muszą być unikalne. Taka sama nazwa w archiwum nie blokuje zapisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes e aliases de contas, cartões e bancos ativos não podem se repetir. Um registro arquivado com o mesmo nome não impede o salvamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes e alias de contas, cartões e bancos ativos têm de ser únicos. Um registo arquivado com o mesmo nome não impede a gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена и псевдонимы действующих счетов, карт и банков должны различаться. Архивный тёзка не мешает сохранить запись."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Номҳо ва номҳои алтернативии ҳисобҳо, кортҳо ва бонкҳои фаъол бояд такрор нашаванд. Номи якхела дар бойгонӣ ба захиракунӣ монеъ намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin hesapların, kartların ve bankaların adları ve takma adları benzersiz olmalıdır. Arşivde aynı ada sahip bir kayıt olması kaydetmeyi engellemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви та псевдоніми активних рахунків, карток і банків мають бути унікальними. Збіг з архівним записом не заважає збереженню."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faol hisoblar, kartalar va banklarning nomlari va taxalluslari takrorlanmasligi kerak. Arxivdagi bir xil nomli yozuv saqlashga to‘sqinlik qilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中的帳戶、卡片和銀行名稱及別名不得重複。封存中的同名記錄不影響儲存。"
          }
        }
      }
    },
