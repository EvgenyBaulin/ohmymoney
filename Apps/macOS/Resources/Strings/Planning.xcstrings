    "layout.empty.payments": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent, phone, internet — add them once, and Planning keeps their dates and takes them off the free sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alquiler, teléfono, internet — añádalos una vez, y Planificación guarda sus fechas y los descuenta de la suma libre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аренда, телефон, интернет — добавьте их один раз, и «Планирование» будет помнить сроки и вычитать их из свободной суммы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оренда, телефон, інтернет — додайте їх один раз, і «Планування» триматиме їхні дати та віднімати їх від вільної суми."
          }
        }
      }
    },
