    "limits.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, məbləğ deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта не сума"
          }
        },
        "cs": {
