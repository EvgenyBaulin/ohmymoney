    "form.rateMissing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen: Tragen Sie den Kurs im Feld „Kurs“ oben ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted: type the rate in the «Rate» field above."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес: жоғарыдағы «Бағам» өрісіне теріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать: введите курс в поле «Курс» выше."
          }
        }
      }
    },
    "form.rateMissing.debt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen. Er wird von der Bank of Russia geladen, sobald der Mac online ist — oder erfassen Sie die Zahlung in der Eingabezeile mit dem Kurs in deren Bedienfeld ↓."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. It loads from the Bank of Russia once the Mac is online — or enter the payment in the entry line with the rate in its ↓ panel."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес. Mac желіге қосылғанда Ресей Банкінен жүктеледі — не төлемді енгізу жолында, оның ↓ панелінде бағаммен енгізіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Он подгрузится из ЦБ, когда будет сеть, — или запишите платёж строкой ввода, указав курс в панели ↓."
          }
        }
      }
    },
    "form.rateMissing.goal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen. Er wird von der Bank of Russia geladen, sobald der Mac online ist — oder wählen Sie eine andere Währung oder ein anderes Datum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. It loads from the Bank of Russia once the Mac is online — or pick another currency or date."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес. Mac желіге қосылғанда Ресей Банкінен жүктеледі — не басқа валютаны немесе күнді таңдаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Он подгрузится из ЦБ, когда будет сеть, — или выберите другую валюту или дату."
          }
        }
      }
    },
    "form.rateMissing.reminder": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen. Markieren Sie es in der Planung als bezahlt — dort kann der Kurs von Hand eingetragen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. Mark it as paid from Planning — the rate can be typed by hand there."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес. Жоспарлаудан «төленді» деп белгілеңіз — бағамды сол жерде қолмен теруге болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Проведите платёж из раздела «Планирование» — там курс можно ввести вручную."
          }
        }
      }
    },
