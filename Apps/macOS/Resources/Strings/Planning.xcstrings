          "stringUnit": {
            "state": "translated",
            "value": "El dinero llega también en otro día del mes — por ejemplo el 15 y el último día: cada fecha es un ingreso propio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
