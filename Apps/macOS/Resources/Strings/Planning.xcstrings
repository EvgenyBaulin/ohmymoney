    "reconcile.saveOnlyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balances are kept; the difference is not recorded as an operation, now or later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos se conservan; la diferencia no se registra como operación, ni ahora ni después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes sont gardés ; l'écart n'est pas noté comme opération, ni maintenant ni plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки запомнятся, а разница не запишется операцией — ни сейчас, ни потом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки зберігаються; різниця не записується як операція ні зараз, ні пізніше."
          }
        }
      }
    },
