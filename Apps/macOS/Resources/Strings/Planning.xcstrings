    "limits.amount.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available this month. Click to change the monthly limit, the carry aside. Return saves, Esc puts it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible este mes. Haga clic para cambiar el límite mensual, el traspaso aparte. Intro guarda, Esc lo devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible ce mois-ci. Cliquez pour modifier le plafond mensuel, le report à part. Retour enregistre, Échap le remet en place."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно в этом месяце. Нажмите, чтобы изменить лимит в месяц, без переноса. Return — сохранить, Esc — вернуть как было."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно цього місяця. Клацніть, щоб змінити місячний ліміт, перенесення лишається. Return зберігає, Esc повертає як було."
          }
        }
      }
