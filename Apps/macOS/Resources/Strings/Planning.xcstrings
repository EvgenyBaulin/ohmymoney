    "scheduled.notThisHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu əməliyyat həmin ödəniş deyil: ödəniş tarixi onu yenidən gözləyəcək"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта аперацыя — іншы плацёж: чаканне плацяжу працягнецца"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato operace není touto platbou. Platba zůstane naplánovaná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Vorgang ist nicht diese Zahlung: Der Fälligkeitstermin wartet erneut darauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation is not this payment: the due date waits for it again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operación no es este pago: el vencimiento vuelve a esperar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération n'est pas ce paiement : l'échéance l'attend de nouveau"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գործարքը տվյալ վճարումը չէ․ վճարման օրը կրկին կսպասի դրան"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione non è il pagamento previsto: la scadenza torna in attesa"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ოპერაცია ამ გადახდას არ ეხება: ვადა კვლავ დაელოდება მას"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл операция осы төлем емес: мерзім оны қайтадан күтеді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул операция бул төлөмгө тиешелүү эмес: төлөмдүн мөөнөтү кайра күтүлөт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta operacja nie dotyczy tej płatności — termin znów będzie na nią oczekiwać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operação não corresponde ao pagamento: ele continuará agendado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operação não corresponde ao pagamento: a data de vencimento continua à espera do mesmo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта операция — не этот платёж: срок снова ждёт оплаты"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин амалиёт ба ин пардохт мувофиқ нест: муҳлати пардохт боз онро интизор мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem bu ödeme değil: ödeme vadesinde yeniden beklenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця операція — не цей платіж: строк знову чекає на свою"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu amal ushbu to‘lovga tegishli emas: to‘lov muddati uni yana kutadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆交易並非此付款，系統會繼續等待付款到期"
          }
        }
      }
    },
