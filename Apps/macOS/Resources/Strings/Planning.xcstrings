    "reconcile.rateMissing": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга запісаць розніцу ў валюце без курсу на сёння, таму нічога не захавана. Націсніце ⌘R або захавайце без запісу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Differenz in einer Währung ohne heutigen Kurs kann nicht erfasst werden, daher wurde nichts gespeichert. Drücken Sie ⌘R oder sichern Sie ohne Erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A difference in a currency without a rate today cannot be recorded, so nothing was saved. Press ⌘R, or save without recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una diferencia en una divisa sin tipo hoy no se puede registrar, así que no se guardó nada. Pulse ⌘R, o guarde sin registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écart dans une devise sans taux aujourd'hui ne peut pas être noté, donc rien n'a été enregistré. Appuyez sur ⌘R, ou enregistrez sans noter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare una differenza in una valuta senza un tasso di cambio per oggi. Non è stato salvato nulla. Premi ⌘R o salva senza registrare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін бағамы жоқ валютадағы айырманы жазу мүмкін емес, сондықтан ештеңе сақталмады. ⌘R басыңыз, не жазбай сақтаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać różnicy w walucie bez dzisiejszego kursu, więc nic nie zachowano. Naciśnij ⌘R lub zachowaj bez zapisywania różnicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível registrar uma diferença em uma moeda sem cotação para hoje, então nada foi salvo. Pressione ⌘R ou salve sem registrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу в валюте без курса на сегодня не записать, и ничего не сохранено. Нажмите ⌘R или сохраните без записи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün kuru olmayan bir para birimindeki fark işlenemez, bu yüzden hiçbir şey kaydedilmedi. ⌘R tuşlarına basın veya farkı işlemeden kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різницю в валюті, для якої сьогодні немає курсу, не можна записати, тож нічого не збережено. Натисніть ⌘R або збережіть без запису."
          }
        }
      }
    },
