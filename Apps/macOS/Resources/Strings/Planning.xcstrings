    "form.rateMissing": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу %@ на гэты дзень яшчэ няма, таму суму ў рублях нельга разлічыць. Увядзіце курс у полі «Курс» вышэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen: Tragen Sie den Kurs im Feld „Kurs“ oben ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted: type the rate in the «Rate» field above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular: escriba el tipo en el campo «Tipo» de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés : saisissez le taux dans le champ « Taux » ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora disponibile un tasso per %@ in questo giorno, quindi non è possibile calcolare i rubli: inserisci il tasso nel campo «Tasso» qui sopra."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес: жоғарыдағы «Бағам» өрісіне теріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu %@ na ten dzień, więc nie można przeliczyć kwoty na ruble. Wpisz kurs w polu «Kurs» powyżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há cotação de %@ para este dia, então não é possível calcular o valor em rublos. Digite a cotação no campo «Cotação» acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать: введите курс в поле «Курс» выше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için henüz %@ kuru yok, bu yüzden ruble tutarı hesaplanamıyor. Yukarıdaki «Kur» alanına kuru girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати: введіть курс у полі «Курс» вище."
          }
        }
      }
    },
    "form.rateMissing.debt": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу %@ на гэты дзень яшчэ няма, таму суму ў рублях нельга разлічыць. Курс загрузіцца з Банка Расіі, калі Mac падключыцца да інтэрнэту. Або ўвядзіце плацёж у радку ўводу, указаўшы курс на панэлі ↓."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen. Er wird von der Bank of Russia geladen, sobald der Mac online ist — oder erfassen Sie die Zahlung in der Eingabezeile mit dem Kurs in deren Bedienfeld ↓."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. It loads from the Bank of Russia once the Mac is online — or enter the payment in the entry line with the rate in its ↓ panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular. Se carga del Banco de Rusia cuando el Mac tenga conexión — o introduzca el pago en la línea de entrada con el tipo en su panel ↓."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés. Il se charge auprès de la Banque de Russie dès que le Mac est en ligne — ou saisissez le paiement dans la ligne de saisie avec le taux dans son panneau ↓."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora disponibile un tasso per %@ in questo giorno, quindi non è possibile calcolare i rubli. Verrà caricato dalla Banca di Russia quando il Mac sarà online. Oppure inserisci il pagamento nella riga di inserimento, con il tasso nel pannello ↓."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес. Mac желіге қосылғанда Ресей Банкінен жүктеледі — не төлемді енгізу жолында, оның ↓ панелінде бағаммен енгізіңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu %@ na ten dzień, więc nie można przeliczyć kwoty na ruble. Kurs zostanie pobrany z Banku Rosji, gdy Mac połączy się z internetem. Możesz też wpisać płatność w wierszu wpisu i podać kurs w panelu ↓."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há cotação de %@ para este dia, então não é possível calcular o valor em rublos. Ela será obtida do Bank of Russia quando o Mac estiver on-line — ou registre o pagamento na linha de entrada com a cotação no painel ↓."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Он подгрузится из ЦБ, когда будет сеть, — или запишите платёж строкой ввода, указав курс в панели ↓."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için henüz %@ kuru yok, bu yüzden ruble tutarı hesaplanamıyor. Mac internete bağlandığında kur Bank of Russia üzerinden yüklenir. Ya da ödemeyi giriş satırına, kuru da ↓ paneline girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати. Він завантажиться з Банку Росії, щойно Mac буде онлайн, — або введіть платіж у рядку вводу з курсом на його панелі ↓."
          }
        }
      }
    },
    "form.rateMissing.goal": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу %@ на гэты дзень яшчэ няма, таму суму ў рублях нельга разлічыць. Курс загрузіцца з Банка Расіі, калі Mac падключыцца да інтэрнэту. Або выберыце іншую валюту ці дату."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen. Er wird von der Bank of Russia geladen, sobald der Mac online ist — oder wählen Sie eine andere Währung oder ein anderes Datum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. It loads from the Bank of Russia once the Mac is online — or pick another currency or date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular. Se carga del Banco de Rusia cuando el Mac tenga conexión — o elija otra divisa o fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés. Il se charge auprès de la Banque de Russie dès que le Mac est en ligne — ou choisissez une autre devise ou date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora disponibile un tasso per %@ in questo giorno, quindi non è possibile calcolare i rubli. Verrà caricato dalla Banca di Russia quando il Mac sarà online. Oppure scegli un'altra valuta o data."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес. Mac желіге қосылғанда Ресей Банкінен жүктеледі — не басқа валютаны немесе күнді таңдаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu %@ na ten dzień, więc nie można przeliczyć kwoty na ruble. Kurs zostanie pobrany z Banku Rosji, gdy Mac połączy się z internetem. Możesz też wybrać inną walutę lub datę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há cotação de %@ para este dia, então não é possível calcular o valor em rublos. Ela será obtida do Bank of Russia quando o Mac estiver on-line — ou escolha outra moeda ou data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Он подгрузится из ЦБ, когда будет сеть, — или выберите другую валюту или дату."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için henüz %@ kuru yok, bu yüzden ruble tutarı hesaplanamıyor. Mac internete bağlandığında kur Bank of Russia üzerinden yüklenir. Ya da başka bir para birimi veya tarih seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати. Він завантажиться з Банку Росії, щойно Mac буде онлайн, — або оберіть іншу валюту чи дату."
          }
        }
      }
    },
    "form.rateMissing.reminder": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу %@ на гэты дзень яшчэ няма, таму суму ў рублях нельга разлічыць. Пазначце плацёж як аплачаны ў раздзеле «Планаванне» — там можна ўвесці курс уручную."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen. Markieren Sie es in der Planung als bezahlt — dort kann der Kurs von Hand eingetragen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. Mark it as paid from Planning — the rate can be typed by hand there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular. Márquelo como pagado desde Planificación — allí se puede escribir el tipo a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés. Marquez-le comme payé depuis « Planification » — le taux peut y être saisi à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora disponibile un tasso per %@ in questo giorno, quindi non è possibile calcolare i rubli. Segna come pagato da Pianificazione: lì puoi inserire il tasso manualmente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес. Жоспарлаудан «төленді» деп белгілеңіз — бағамды сол жерде қолмен теруге болады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu %@ na ten dzień, więc nie można przeliczyć kwoty na ruble. Oznacz płatność jako opłaconą w Planowaniu — tam możesz wpisać kurs ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há cotação de %@ para este dia, então não é possível calcular o valor em rublos. Marque como pago em Planejamento — lá você pode digitar a cotação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Проведите платёж из раздела «Планирование» — там курс можно ввести вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için henüz %@ kuru yok, bu yüzden ruble tutarı hesaplanamıyor. Ödemeyi Planlama'dan yapıldı olarak işaretleyin; kuru orada elle girebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати. Позначте це як сплачене в «Плануванні» — там курс можна ввести вручну."
          }
        }
      }
    },
    "form.reimbursable": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аплачана за таго, хто верне грошы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jemanden bezahlt, der es zurückgibt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid for someone who gives it back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagado por alguien que lo devuelve"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payé pour quelqu'un qui le rembourse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagato per qualcuno che rimborserà"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтаратын адам үшін төленді"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapłacono za kogoś, kto zwróci pieniądze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago para alguém que vai devolver"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плачу за другого, он вернёт"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri ödeyecek biri için ödendi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплачено за людину, яка поверне"
          }
        }
      }
    },
