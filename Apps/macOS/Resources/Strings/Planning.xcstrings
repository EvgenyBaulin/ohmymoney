        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "vadesi geçen ödemeler dahil: %@ — tutarları henüz ödenmemiş sayılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "з урахуванням прострочених дат: %@ — їхні гроші рахуються як ще не пішли"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
