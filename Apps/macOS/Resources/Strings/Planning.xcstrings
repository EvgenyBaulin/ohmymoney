    "layout.empty.subscriptions": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər ay və ya il ödənilən abunəliklər aylıq və illik qiymətləri ilə burada görünür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’явяцца штомесячныя і штогадовыя падпіскі з іх коштам за месяц і год."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazují měsíční a roční předplatná s cenou za měsíc a rok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos, die jeden Monat oder jedes Jahr abgebucht werden, erscheinen hier mit ihrem Preis im Monat und im Jahr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions charged every month or year show here, with their price a month and a year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones que se cobran cada mes o cada año aparecen aquí, con su precio al mes y al año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements prélevés chaque mois ou chaque année s'affichent ici, avec leur prix par mois et par an."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այստեղ երևում են ամսական կամ տարեկան գանձվող բաժանորդագրությունները՝ իրենց ամսական և տարեկան արժեքով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui trovi gli abbonamenti addebitati ogni mese o anno, con il costo mensile e annuale."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქ გამოჩნდება ყოველთვიური და წლიური გამოწერები, მათი თვიური და წლიური ფასით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай немесе жыл сайын төленетін жазылымдар осында көрінеді, айына және жылына бағасымен."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай сайын же жыл сайын төлөнүүчү жазылуулар бул жерде айлык жана жылдык баасы менен көрүнөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj zobaczysz subskrypcje rozliczane co miesiąc lub co rok oraz ich miesięczny i roczny koszt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinaturas cobradas todo mês ou ano aparecem aqui, com os valores mensais e anuais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas cobradas mensal ou anualmente aparecem aqui, com o respetivo custo mensal e anual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки, которые списываются каждый месяц или год, будут здесь — с ценой в месяц и в год."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обунаҳои моҳона ё солона бо арзиши моҳона ва солонаашон дар ин ҷо нишон дода мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ay veya yıl tahsil edilen abonelikler, aylık ve yıllık ücretleriyle burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписки, що списуються щомісяця чи щороку, з'являються тут, із ціною на місяць і на рік."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har oy yoki yil to‘lanadigan obunalar shu yerda oylik va yillik narxi bilan ko‘rinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月或每年收費的訂閱會顯示在這裡，並列出每月和每年的費用。"
          }
        }
      }
    },
