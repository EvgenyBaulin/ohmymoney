        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "ներառված են ժամկետանց վճարումները՝ %@․ դրանց գումարը դեռ ծախսված չի համարվում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
