    "reminders.overdue.skipHelp": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж не зроблены: тэрмін закрываецца без аперацыі, як пры выбары «Прапусціць» у планаванні"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wurde nicht geleistet: Der Termin wird ohne Vorgang geschlossen, wie „Überspringen“ in der Planung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment was not made: the due date is closed without an operation, as «Skip» in Planning does"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago no se hizo: el vencimiento se cierra sin operación, como hace «Omitir» en Planificación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement n'a pas été effectué : l'échéance est clôturée sans opération, comme le fait « Passer » dans la Planification"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento non è stato effettuato: la scadenza viene chiusa senza un’operazione, come con «Salta» in Pianificazione"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлем жасалмады: мерзім операциясыз жабылады, Жоспарлаудағы «Өткізу» сияқты"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność nie została dokonana: termin zostanie zamknięty bez operacji, tak jak po wybraniu «Pomiń» w planowaniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento não foi feito: o vencimento é encerrado sem uma operação, como em «Ignorar» no Planejamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежа не было: срок закрывается без операции, как «Пропустить» в «Планировании»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme yapılmadı: Planlama'daki «Atla» gibi vade işlem oluşturulmadan kapatılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж не було зроблено: строк закривається без операції, як «Пропустити» в «Плануванні»"
          }
        }
      }
    },
