    "limits.suggest.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təklif yoxdur: son üç ayda xərc etdiyiniz bütün kateqoriyaların artıq limiti var və ya tarixçə kifayət deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма прапаноў: усе катэгорыі з выдаткамі за апошнія тры месяцы ўжо маюць ліміт або гісторыі пакуль недастаткова."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné návrhy: všechny kategorie s výdaji za poslední tři měsíce už mají limit nebo zatím není dostatek historie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts vorzuschlagen: Jede Kategorie, in der Sie in den letzten drei Monaten ausgegeben haben, hat schon ein Limit, oder es gibt noch zu wenig Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to suggest: every category spent on in the last three months already has a limit, or there is too little history yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que sugerir: todas las categorías en las que gastó en los últimos tres meses ya tienen límite, o todavía hay poco historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à suggérer : chaque catégorie dépensée ces trois derniers mois a déjà un plafond, ou l'historique est encore trop court."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առաջարկներ չկան․ վերջին երեք ամսում ծախսեր ունեցող բոլոր կատեգորիաներն արդեն սահմանաչափ ունեն, կամ պատմությունը դեռ բավարար չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun suggerimento: tutte le categorie con spese negli ultimi tre mesi hanno già un limite oppure non ci sono ancora abbastanza dati."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შესათავაზებელი არაფერია: ბოლო სამ თვეში გამოყენებულ ყველა კატეგორიას უკვე აქვს ლიმიტი ან ისტორია ჯერ საკმარისი არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұсынатын ештеңе жоқ: соңғы үш айда шығын болған әр санатта лимит бар, не тарих әлі аз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сунуш жок: акыркы үч айда чыгым болгон бардык категорияларга лимит коюлган же тарых жетишсиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak sugestii: każda kategoria z wydatkami w ostatnich trzech miesiącach ma już limit lub historia jest zbyt krótka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma sugestão: todas as categorias com gastos nos últimos três meses já têm limite ou ainda não há histórico suficiente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a sugerir: todas as categorias com despesas nos últimos três meses já têm um limite ou ainda não há histórico suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить нечего: у всех категорий с тратами за последние три месяца уже есть лимит, или истории пока мало."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пешниҳоде нест: ҳамаи категорияҳое, ки дар се моҳи охир ба онҳо хароҷот шудааст, аллакай маҳдудият доранд ё таърих ҳанӯз кофӣ нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilecek bir şey yok: Son üç ayda harcama yapılan her kategorinin zaten bir limiti var veya henüz yeterli geçmiş yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонувати нічого: кожна категорія, на яку витрачали за останні три місяці, вже має ліміт, або історії ще замало."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Takliflar yo‘q: oxirgi uch oyda xarajat qilingan barcha turkumlarda limit bor yoki ma’lumot yetarli emas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有建議：過去三個月有支出的類別都已設有限額，或紀錄尚不足夠。"
          }
        }
      }
    },
