    "reconcile.recordHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every difference becomes an operation in «Reconciliation» on its account and in its currency. Add or fix an operation dated before this count later, and the difference follows by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada diferencia se convierte en una operación de «Conciliación» en su cuenta y en su divisa. Si después añade o corrige una operación fechada antes de este recuento, la diferencia se ajusta sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque écart devient une opération « Rapprochement » sur son compte et dans sa devise. Ajoutez ou corrigez plus tard une opération datée avant ce comptage, et l'écart suit tout seul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая разница — операция в «Сверке» на своём счёте и в своей валюте. Добавите или поправите потом операцию до этой сверки — разница пересчитается сама."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна різниця стає операцією «Звірка» на своєму рахунку і в його валюті. Додайте або виправте операцію з датою до цього обліку пізніше — і різниця піде за нею сама."
          }
        }
      }
    },
