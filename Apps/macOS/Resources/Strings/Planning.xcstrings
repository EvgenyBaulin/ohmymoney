    "reconcile.accountsQuestion": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İndi hər hesabda nə qədər pul var? Hər sahədə qeydlərə əsasən gözlənilən məbləğ göstərilir. Yalnız fərqlənənləri düzəldin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колькі грошай цяпер на кожным рахунку? У палях ужо пазначаны балансы паводле ўліку: выпраўце толькі тыя, што адрозніваюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik peněz je nyní na jednotlivých účtech? Každé pole obsahuje očekávaný zůstatek. Opravte jen ty, které se liší."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Geld ist jetzt auf jedem Konto? Jedes Feld enthält schon, was die Bücher erwarten: Korrigieren Sie nur die, die abweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much money is on each account now? Each field already holds what the books expect: fix only the ones that differ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto dinero hay ahora en cada cuenta? Cada campo ya contiene lo que dicen los registros: corrija solo los que difieran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien d'argent y a-t-il sur chaque compte maintenant ? Chaque champ contient déjà ce que les comptes attendent : corrigez seulement ceux qui diffèrent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որքա՞ն գումար կա այժմ յուրաքանչյուր հաշվում։ Դաշտերում արդեն նշված են հաշվառված գումարները․ ուղղեք միայն տարբերվողները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto denaro c'è ora su ogni conto? Ogni campo mostra già il saldo previsto dai registri: correggi solo quelli diversi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რამდენი თანხაა ახლა თითოეულ ანგარიშზე? ველებში უკვე მითითებულია აღრიცხვით მოსალოდნელი თანხები: შეასწორეთ მხოლოდ ისინი, რომლებიც განსხვავდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр есеп-шотта қазір қанша ақша бар? Әр өрісте кітаптар күткен сома тұр: тек айырмашылығы бар екеуін түзетіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азыр ар бир эсепте канча акча бар? Ар бир талаада эсеп боюнча күтүлгөн сумма турат: айырмалангандарын гана оңдоңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile pieniędzy jest teraz na każdym koncie? Pola zawierają przewidywane salda. Popraw tylko te, które się różnią."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto dinheiro há em cada conta agora? Cada campo já mostra o saldo previsto: corrija apenas os que forem diferentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto dinheiro está agora em cada conta? Cada campo já mostra o saldo previsto nos registos: corrija apenas os que forem diferentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько денег на каждом счёте сейчас? В каждом поле — сколько ожидает учёт: поправьте только то, что отличается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло дар ҳар ҳисоб чӣ қадар маблағ аст? Дар ҳар майдон бақияи ҳисобшуда нишон дода шудааст: танҳо маблағҳои фарқкунандаро ислоҳ кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda her hesapta ne kadar para var? Her alanda kayıtlara göre beklenen tutar yer alıyor. Yalnızca farklı olanları düzeltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки грошей зараз на кожному рахунку? Кожне поле вже містить те, що очікують книги: виправте лише ті, що відрізняються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozir har bir hisobda qancha pul bor? Maydonlarda hisob-kitobdagi kutilayotgan summalar ko‘rsatilgan. Faqat farq qilganlarini tuzating."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個帳戶目前有多少錢？各欄位已填入帳面預期金額，只需更正有差異的項目。"
          }
        }
      }
    },
