    "form.goal.account": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məqsədin vəsaiti haradadır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзе захоўваюцца грошы на мэту"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kde jsou peníze na cíl"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo das Geld des Ziels liegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the money of the goal is"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde está el dinero del objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où se trouve l'argent de l'objectif"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որտեղ է նպատակի գումարը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove si trova il denaro dell’obiettivo"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სად ინახება მიზნის თანხა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат ақшасы қайда"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Максаттын акчасы сакталган эсеп"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdzie są środki na cel"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde está o dinheiro da meta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde está o dinheiro do objetivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где лежат деньги цели"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули ҳадаф дар куҷост"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef parasının bulunduğu hesap"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Де гроші цілі"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maqsad puli qayerda"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標資金所在帳戶"
          }
        }
      }
    },
    "form.goal.account.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vəsait ayırmaq pulu köçürmür. Məqsədin vəsaiti ayrıca saxlanırsa, hesabı göstərin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Унёсак не перамяшчае грошы. Укажыце рахунак, калі грошы на мэту захоўваюцца асобна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvek peníze nepřesouvá. Pokud jsou peníze na cíl uloženy zvlášť, vyberte účet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Beitrag bewegt kein Geld. Nennen Sie das Konto, wenn das Geld des Ziels getrennt gehalten wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A contribution moves no money. Name the account if the money of the goal is kept apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una aportación no mueve dinero. Indique la cuenta si el dinero del objetivo se guarda aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une contribution ne déplace aucun argent. Nommez le compte si l'argent de l'objectif est gardé à part."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համալրումը գումար չի փոխանցում։ Նշեք հաշիվը, եթե նպատակի գումարը պահվում է առանձին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contributo non sposta denaro. Indica il conto se il denaro dell’obiettivo è tenuto da parte."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენატანი თანხას არ გადარიცხავს. მიუთითეთ ანგარიში, თუ მიზნის თანხა ცალკე ინახება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салым ақшаны аудармайды. Мақсат ақшасы бөлек сақталса, есеп-шотты атаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салым акчаны которбойт. Максаттын акчасы өзүнчө сакталса, эсепти көрсөтүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłata nie przenosi środków. Wskaż konto, jeśli środki na cel są przechowywane osobno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma contribuição não movimenta dinheiro. Indique a conta se o dinheiro da meta estiver separado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma contribuição não movimenta dinheiro. Indique a conta se o dinheiro do objetivo estiver guardado à parte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взнос в цель денег не двигает. Укажите счёт, если деньги цели лежат отдельно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гузоштани маблағ пулро интиқол намедиҳад. Агар пули ҳадаф ҷудо нигоҳ дошта шавад, ҳисобро нишон диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkı para aktarmaz. Hedefin parası ayrı tutuluyorsa hesabı belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Внесок не переміщує гроші. Назвіть рахунок, якщо гроші цілі лежать окремо."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mablag‘ ajratilganda pul ko‘chirilmaydi. Maqsad puli alohida saqlansa, hisobni ko‘rsating."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存入目標不會轉移資金。若目標資金另存，請指定帳戶。"
          }
        }
      }
    },
