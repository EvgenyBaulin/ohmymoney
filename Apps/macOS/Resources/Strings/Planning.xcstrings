        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Differenz auf einem archivierten Konto oder in einer Währung, die das Konto nicht führt, kann nicht erfasst werden: %@. Sichern Sie ohne Erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A difference on an archived account or in a currency the account does not hold cannot be recorded: %@. Save without recording."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы есеп-шоттағы немесе есеп-шот ұстамайтын валютадағы айырманы жазу мүмкін емес: %@. Жазбай сақтаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу на счёте в архиве или в валюте вне списка счёта не записать: %@. Сохраните без записи."
          }
        }
      }
    },
