    "free.salaryLate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaş gəlməyib? %@ tarixində gözlənilirdi — ayın yarısı davam edir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарплата не прыйшла? Яна чакалася %@ — палова месяца працягваецца"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výplata nepřišla? Očekávala se %@ — období do další výplaty pokračuje"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gehalt ist nicht gekommen? Erwartet war es am %@ — die Hälfte des Monats läuft weiter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The salary did not come? It was expected on %@ — the half of the month goes on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No llegó el sueldo? Se esperaba el %@ — la mitad del mes sigue corriendo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le salaire n'est pas arrivé ? Il était attendu le %@ — la moitié du mois continue de courir"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Աշխատավարձը չե՞ք ստացել։ Այն սպասվում էր %@-ին․ ամսվա կեսը շարունակվում է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stipendio non è arrivato? Era previsto per il %@ — la metà del mese continua"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხელფასი არ ჩარიცხულა? მოსალოდნელი იყო %@-ს — თვის ნახევარი გრძელდება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалақы келмеді ме? %@ күні күтілген еді — айдың жартысы өтеді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлык түшкөн жокпу? Ал %@ күнү күтүлгөн — жарым ай уланууда"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensja nie wpłynęła? Oczekiwano jej %@ — połowa miesiąca trwa dalej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O salário não caiu? Era esperado em %@ — a quinzena continua"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O salário não chegou? Era esperado a %@ — a quinzena continua"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарплата не пришла? Ждали %@ — половина месяца продлевается"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маош наомад? Он %@ интизор буд — нимаи моҳ идома дорад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaş yatmadı mı? %@ tarihinde bekleniyordu; ayın yarısı devam ediyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарплата не надійшла? Очікувалася %@ — половина місяця йде на витрати"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maosh kelmadimi? U %@ kuni kutilgan edi — oyning ikkinchi yarmi davom etmoqda"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "薪資尚未入帳？原定於 %@ 入帳，目前仍沿用上半月計算"
          }
