    "selfEmployed.offer.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is asked once: turn it on any time in Settings → Planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se pregunta una vez: actívelo cuando quiera en Ajustes → Planificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette question n'est posée qu'une fois : activez-le à tout moment dans Réglages → Planification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не спросим: включить можно в «Настройки → Планирование»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це питається один раз: увімкнути можна будь-коли в «Налаштування → Планування»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti verrà chiesto una sola volta: puoi attivarlo quando vuoi in Impostazioni → Pianificazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл бір рет сұралады: оны кез келген уақытта «Параметрлер → Жоспарлау» ішінде қосуға болады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтае пытанне задаецца адзін раз: уключыць можна ў любы час у Наладах → Планаванне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wird einmal gefragt: Schalten Sie es jederzeit unter Einstellungen → Planung ein."
          }
        }
      }
    },
