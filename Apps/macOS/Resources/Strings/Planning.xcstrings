    },
    "limits.suggest.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories without a limit that you spent on in at least two of the last three full months. The amount is a usual month of them, rounded up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorías sin límite en las que gastó en al menos dos de los últimos tres meses completos. El importe es un mes habitual de ellas, redondeado al alza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории без лимита, на которые вы тратили хотя бы в двух из трёх последних полных месяцев. Сумма — обычный месяц, округлённый вверх."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорії без ліміту, на які витрачали принаймні в двох із останніх трьох повних місяців. Сума — звичайний місяць для них, округлений вгору."
          }
        }
      }
    },
