    "reconcile.recordHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər fərq öz hesabında və valyutasında «Üzləşdirmə» əməliyyatına çevrilir. Sonradan bu sayımdan əvvəlki tarixə əməliyyat əlavə etsəniz və ya düzəltsəniz, fərq avtomatik yenilənəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожная розніца стане аперацыяй у «Зверцы» на сваім рахунку і ў сваёй валюце. Калі пазней дадаць або выправіць аперацыю да даты гэтага падліку, розніца зменіцца сама."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý rozdíl se zaznamená jako operace v kategorii «Odsouhlasení» na příslušném účtu a v jeho měně. Pokud později přidáte nebo opravíte operaci z doby před tímto zjištěním zůstatku, rozdíl se automaticky upraví."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Differenz wird zu einem Vorgang unter „Abgleich“ auf ihrem Konto und in ihrer Währung. Fügen Sie später einen Vorgang hinzu oder korrigieren Sie einen, der vor dieser Zählung datiert ist, dann folgt die Differenz von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every difference becomes an operation in «Reconciliation» on its account and in its currency. Add or fix an operation dated before this count later, and the difference follows by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada diferencia se convierte en una operación de «Conciliación» en su cuenta y en su divisa. Si después añade o corrige una operación fechada antes de este recuento, la diferencia se ajusta sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque écart devient une opération « Rapprochement » sur son compte et dans sa devise. Ajoutez ou corrigez plus tard une opération datée avant ce comptage, et l'écart suit tout seul."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր տարբերություն դառնում է «Համադրում» գործարք՝ իր հաշվում և արժույթով։ Եթե հետագայում ավելացնեք կամ ուղղեք այս հաշվարկից առաջ թվագրված գործարք, տարբերությունն ինքնաբերաբար կփոխվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni differenza diventa un’operazione in «Riconciliazione», sul relativo conto e nella relativa valuta. Se in seguito aggiungi o correggi un’operazione precedente a questo conteggio, la differenza si aggiorna automaticamente."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული სხვაობა ჩაიწერება ოპერაციად «შეჯერებაში», შესაბამის ანგარიშსა და ვალუტაში. თუ მოგვიანებით ამ დათვლამდე დათარიღებულ ოპერაციას დაამატებთ ან შეასწორებთ, სხვაობა ავტომატურად შეიცვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр айырма өз есеп-шотында және өз валютасында «Салыстыру» ішіндегі операцияға айналады. Осы санаудан бұрынғы күнге операция қосыңыз немесе түзетіңіз — айырма өзі соған ілесіп өзгереді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир айырма тиешелүү эсепте жана валютада «Салыштыруу» операциясы катары жазылат. Кийин бул санакка чейинки операцияны кошсоңуз же оңдосоңуз, айырма автоматтык түрдө өзгөрөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda różnica staje się operacją «Uzgodnienie» na danym koncie i w jego walucie. Jeśli później dodasz lub poprawisz operację sprzed tego sprawdzenia, różnica zmieni się automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada diferença se torna uma operação em «Conciliação», na conta e moeda correspondentes. Se você adicionar ou corrigir uma operação anterior a esta contagem, a diferença será atualizada automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada diferença cria uma operação em «Reconciliação», na respetiva conta e moeda. Se adicionar ou corrigir mais tarde uma operação anterior a esta contagem, a diferença é ajustada automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая разница — операция в «Сверке» на своём счёте и в своей валюте. Добавите или поправите потом операцию до этой сверки — разница пересчитается сама."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳар фарқ ҳамчун амалиёти «Муқоиса» дар суратҳисоб ва бо асъори он сабт мешавад. Агар баъдтар амалиёти пеш аз ин ҳисобкуниро илова ё ислоҳ кунед, фарқ худкор тағйир меёбад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her fark, ilgili hesapta ve para biriminde «Mutabakat» işlemi olarak kaydedilir. Daha sonra bu sayımdan önceki bir tarihe işlem ekler veya düzeltirseniz fark kendiliğinden güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна різниця стає операцією «Звірка» на своєму рахунку і в його валюті. Додайте або виправте операцію з датою до цього обліку пізніше — і різниця піде за нею сама."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir farq tegishli hisob va valyutada «Solishtirish» amali sifatida yoziladi. Keyinroq ushbu sanovdan oldingi sanaga amal qo‘shsangiz yoki uni tuzatsangiz, farq o‘z-o‘zidan yangilanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每筆差額都會在所屬帳戶中，以原貨幣記為「對帳」交易。日後新增或修正此次盤點前的交易時，差額會自動更新。"
          }
        }
      }
    },
