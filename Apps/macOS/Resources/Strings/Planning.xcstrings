    "expected.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Атрыманы даход застанецца; выдаляцца толькі чаканне і яго сувязі. ⌘Z верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bereits erhaltene Einnahme bleibt; nur die Erwartung und ihre Verknüpfungen gehen. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income already received stays; only the expectation and its links go. ⌘Z brings them back."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reddito già ricevuto rimane; vengono eliminati solo la previsione e i suoi collegamenti. Premi ⌘Z per ripristinarli."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алынған табыс қалады; тек күту мен оның сілтемелері кетеді. ⌘Z қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полученные доходы останутся, удалится только ожидание и привязки к нему. ⌘Z вернёт их."
          }
        }
      }
    },
