    "form.rateMissing": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün üçün %@ məzənnəsi hələ yoxdur, ona görə rubl məbləğini hesablamaq mümkün deyil. Məzənnəni yuxarıdakı «Məzənnə» sahəsinə daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу %@ на гэты дзень яшчэ няма, таму суму ў рублях нельга разлічыць. Увядзіце курс у полі «Курс» вышэй."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento den zatím není k dispozici kurz %@, takže nelze vypočítat částku v rublech. Zadejte kurz do pole «Kurz» výše."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen: Tragen Sie den Kurs im Feld „Kurs“ oben ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted: type the rate in the «Rate» field above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular: escriba el tipo en el campo «Tipo» de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés : saisissez le taux dans le champ « Taux » ci-dessus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս օրվա %@ փոխարժեքը դեռ չկա, ուստի ռուբլին հաշվել հնարավոր չէ։ Մուտքագրեք փոխարժեքը վերևի «Փոխարժեք» դաշտում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora disponibile un tasso per %@ in questo giorno, quindi non è possibile calcolare i rubli: inserisci il tasso nel campo «Tasso» qui sopra."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ დღისთვის %@-ის კურსი ჯერ არ არის, ამიტომ რუბლებში დათვლა შეუძლებელია: შეიყვანეთ კურსი ზემოთ, «კურსის» ველში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес: жоғарыдағы «Бағам» өрісіне теріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул күнгө %@ курсу азырынча жок, рублди эсептөө мүмкүн эмес. Курсту жогорудагы «Курс» талаасына киргизиңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu %@ na ten dzień, więc nie można przeliczyć kwoty na ruble. Wpisz kurs w polu «Kurs» powyżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há cotação de %@ para este dia, então não é possível calcular o valor em rublos. Digite a cotação no campo «Cotação» acima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há taxa de %@ para este dia, pelo que não é possível calcular os rublos. Introduza a taxa no campo «Taxa» acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать: введите курс в поле «Курс» выше."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби %@ барои ин рӯз ҳанӯз дастрас нест, бинобар ин маблағро бо рубл ҳисоб кардан намешавад. Қурбро дар майдони «Қурб» дар боло ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için henüz %@ kuru yok, bu yüzden ruble tutarı hesaplanamıyor. Yukarıdaki «Kur» alanına kuru girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати: введіть курс у полі «Курс» вище."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kun uchun %@ kursi hali yo‘q, shuning uchun rublni hisoblab bo‘lmaydi: kursni yuqoridagi «Kurs» maydoniga kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有當天的 %@ 匯率，無法換算盧布。請在上方「匯率」欄位輸入匯率。"
          }
        }
      }
    },
    "form.rateMissing.debt": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün üçün %@ məzənnəsi hələ yoxdur, ona görə rubl məbləğini hesablamaq mümkün deyil. Mac internetə qoşulduqda məzənnə Bank of Russia-dan yüklənəcək. Və ya ödənişi giriş sətrinə, məzənnəni isə onun ↓ panelinə daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу %@ на гэты дзень яшчэ няма, таму суму ў рублях нельга разлічыць. Курс загрузіцца з Банка Расіі, калі Mac падключыцца да інтэрнэту. Або ўвядзіце плацёж у радку ўводу, указаўшы курс на панэлі ↓."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento den zatím není k dispozici kurz %@, takže nelze vypočítat částku v rublech. Načte se z Bank of Russia, až bude Mac online. Nebo zadejte platbu do řádku pro zadání a kurz do jeho panelu ↓."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen. Er wird von der Bank of Russia geladen, sobald der Mac online ist — oder erfassen Sie die Zahlung in der Eingabezeile mit dem Kurs in deren Bedienfeld ↓."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. It loads from the Bank of Russia once the Mac is online — or enter the payment in the entry line with the rate in its ↓ panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular. Se carga del Banco de Rusia cuando el Mac tenga conexión — o introduzca el pago en la línea de entrada con el tipo en su panel ↓."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés. Il se charge auprès de la Banque de Russie dès que le Mac est en ligne — ou saisissez le paiement dans la ligne de saisie avec le taux dans son panneau ↓."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս օրվա %@ փոխարժեքը դեռ չկա, ուստի ռուբլին հաշվել հնարավոր չէ։ Այն կներբեռնվի Ռուսաստանի բանկից, երբ Mac-ը միանա համացանցին, կամ մուտքագրեք վճարումը գրանցման տողում՝ փոխարժեքը նշելով դրա ↓ վահանակում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora disponibile un tasso per %@ in questo giorno, quindi non è possibile calcolare i rubli. Verrà caricato dalla Banca di Russia quando il Mac sarà online. Oppure inserisci il pagamento nella riga di inserimento, con il tasso nel pannello ↓."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ დღისთვის %@-ის კურსი ჯერ არ არის, ამიტომ რუბლებში დათვლა შეუძლებელია. კურსი რუსეთის ბანკიდან ჩაიტვირთება, როცა Mac ინტერნეტს დაუკავშირდება — ან შეიყვანეთ გადახდა შეყვანის სტრიქონში და კურსი მის ↓ პანელში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес. Mac желіге қосылғанда Ресей Банкінен жүктеледі — не төлемді енгізу жолында, оның ↓ панелінде бағаммен енгізіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул күнгө %@ курсу азырынча жок, рублди эсептөө мүмкүн эмес. Mac интернетке туташканда курс Россия Банкынан жүктөлөт. Же төлөмдү киргизүү сабына жазып, курсун анын ↓ панелине киргизиңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu %@ na ten dzień, więc nie można przeliczyć kwoty na ruble. Kurs zostanie pobrany z Banku Rosji, gdy Mac połączy się z internetem. Możesz też wpisać płatność w wierszu wpisu i podać kurs w panelu ↓."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há cotação de %@ para este dia, então não é possível calcular o valor em rublos. Ela será obtida do Bank of Russia quando o Mac estiver on-line — ou registre o pagamento na linha de entrada com a cotação no painel ↓."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há taxa de %@ para este dia, pelo que não é possível calcular os rublos. É carregada do Bank of Russia quando o Mac estiver online. Em alternativa, introduza o pagamento na linha de registo com a taxa no painel ↓."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Он подгрузится из ЦБ, когда будет сеть, — или запишите платёж строкой ввода, указав курс в панели ↓."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби %@ барои ин рӯз ҳанӯз дастрас нест, бинобар ин маблағро бо рубл ҳисоб кардан намешавад. Вақте Mac ба интернет пайваст мешавад, қурб аз Бонки Русия бор мешавад — ё пардохтро дар сатри воридот бо қурб дар панели ↓ он ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için henüz %@ kuru yok, bu yüzden ruble tutarı hesaplanamıyor. Mac internete bağlandığında kur Bank of Russia üzerinden yüklenir. Ya da ödemeyi giriş satırına, kuru da ↓ paneline girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати. Він завантажиться з Банку Росії, щойно Mac буде онлайн, — або введіть платіж у рядку вводу з курсом на його панелі ↓."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kun uchun %@ kursi hali yo‘q, shuning uchun rublni hisoblab bo‘lmaydi. Mac internetga ulanganda kurs Rossiya bankidan yuklanadi — yoki to‘lovni kiritish satriga, kursni esa uning ↓ paneliga kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有當天的 %@ 匯率，無法換算盧布。Mac 上線後會從 Bank of Russia 載入；也可在輸入列輸入付款，並在其 ↓ 面板中輸入匯率。"
          }
        }
      }
    },
    "form.rateMissing.goal": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün üçün %@ məzənnəsi hələ yoxdur, ona görə rubl məbləğini hesablamaq mümkün deyil. Mac internetə qoşulduqda məzənnə Bank of Russia-dan yüklənəcək. Və ya başqa valyuta və ya tarix seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу %@ на гэты дзень яшчэ няма, таму суму ў рублях нельга разлічыць. Курс загрузіцца з Банка Расіі, калі Mac падключыцца да інтэрнэту. Або выберыце іншую валюту ці дату."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento den zatím není k dispozici kurz %@, takže nelze vypočítat částku v rublech. Načte se z Bank of Russia, až bude Mac online. Nebo vyberte jinou měnu či datum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen. Er wird von der Bank of Russia geladen, sobald der Mac online ist — oder wählen Sie eine andere Währung oder ein anderes Datum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. It loads from the Bank of Russia once the Mac is online — or pick another currency or date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular. Se carga del Banco de Rusia cuando el Mac tenga conexión — o elija otra divisa o fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés. Il se charge auprès de la Banque de Russie dès que le Mac est en ligne — ou choisissez une autre devise ou date."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս օրվա %@ փոխարժեքը դեռ չկա, ուստի ռուբլին հաշվել հնարավոր չէ։ Այն կներբեռնվի Ռուսաստանի բանկից, երբ Mac-ը միանա համացանցին, կամ ընտրեք այլ արժույթ կամ ամսաթիվ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora disponibile un tasso per %@ in questo giorno, quindi non è possibile calcolare i rubli. Verrà caricato dalla Banca di Russia quando il Mac sarà online. Oppure scegli un'altra valuta o data."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ დღისთვის %@-ის კურსი ჯერ არ არის, ამიტომ რუბლებში დათვლა შეუძლებელია. კურსი რუსეთის ბანკიდან ჩაიტვირთება, როცა Mac ინტერნეტს დაუკავშირდება — ან აირჩიეთ სხვა ვალუტა ან თარიღი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес. Mac желіге қосылғанда Ресей Банкінен жүктеледі — не басқа валютаны немесе күнді таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул күнгө %@ курсу азырынча жок, рублди эсептөө мүмкүн эмес. Mac интернетке туташканда курс Россия Банкынан жүктөлөт. Же башка валюта же күн тандаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu %@ na ten dzień, więc nie można przeliczyć kwoty na ruble. Kurs zostanie pobrany z Banku Rosji, gdy Mac połączy się z internetem. Możesz też wybrać inną walutę lub datę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há cotação de %@ para este dia, então não é possível calcular o valor em rublos. Ela será obtida do Bank of Russia quando o Mac estiver on-line — ou escolha outra moeda ou data."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há taxa de %@ para este dia, pelo que não é possível calcular os rublos. É carregada do Bank of Russia quando o Mac estiver online. Em alternativa, escolha outra moeda ou data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Он подгрузится из ЦБ, когда будет сеть, — или выберите другую валюту или дату."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби %@ барои ин рӯз ҳанӯз дастрас нест, бинобар ин маблағро бо рубл ҳисоб кардан намешавад. Вақте Mac ба интернет пайваст мешавад, қурб аз Бонки Русия бор мешавад — ё асъор ё санаи дигарро интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için henüz %@ kuru yok, bu yüzden ruble tutarı hesaplanamıyor. Mac internete bağlandığında kur Bank of Russia üzerinden yüklenir. Ya da başka bir para birimi veya tarih seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати. Він завантажиться з Банку Росії, щойно Mac буде онлайн, — або оберіть іншу валюту чи дату."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kun uchun %@ kursi hali yo‘q, shuning uchun rublni hisoblab bo‘lmaydi. Mac internetga ulanganda kurs Rossiya bankidan yuklanadi — yoki boshqa valyuta yoxud sanani tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有當天的 %@ 匯率，無法換算盧布。Mac 上線後會從 Bank of Russia 載入；也可選擇其他貨幣或日期。"
          }
        }
      }
    },
    "form.rateMissing.reminder": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün üçün %@ məzənnəsi hələ yoxdur, ona görə rubl məbləğini hesablamaq mümkün deyil. Planlaşdırmada ödənilib kimi işarələyin — orada məzənnəni əl ilə daxil etmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу %@ на гэты дзень яшчэ няма, таму суму ў рублях нельга разлічыць. Пазначце плацёж як аплачаны ў раздзеле «Планаванне» — там можна ўвесці курс уручную."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento den zatím není k dispozici kurz %@, takže nelze vypočítat částku v rublech. Označte položku jako zaplacenou v Plánování, kde můžete kurz zadat ručně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen. Markieren Sie es in der Planung als bezahlt — dort kann der Kurs von Hand eingetragen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. Mark it as paid from Planning — the rate can be typed by hand there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular. Márquelo como pagado desde Planificación — allí se puede escribir el tipo a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés. Marquez-le comme payé depuis « Planification » — le taux peut y être saisi à la main."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս օրվա %@ փոխարժեքը դեռ չկա, ուստի ռուբլին հաշվել հնարավոր չէ։ Նշեք որպես վճարված «Պլանավորում» բաժնում․ այնտեղ կարող եք ձեռքով մուտքագրել փոխարժեքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora disponibile un tasso per %@ in questo giorno, quindi non è possibile calcolare i rubli. Segna come pagato da Pianificazione: lì puoi inserire il tasso manualmente."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ დღისთვის %@-ის კურსი ჯერ არ არის, ამიტომ რუბლებში დათვლა შეუძლებელია. მონიშნეთ გადახდილად დაგეგმვაში — იქ კურსის ხელით შეყვანაა შესაძლებელი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %@ бағамы әлі жоқ, сондықтан рубльдерді санау мүмкін емес. Жоспарлаудан «төленді» деп белгілеңіз — бағамды сол жерде қолмен теруге болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул күнгө %@ курсу азырынча жок, рублди эсептөө мүмкүн эмес. Төлөмдү «Пландоо» бөлүмүнөн төлөндү деп белгилеңиз — ал жерге курсту кол менен киргизсеңиз болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu %@ na ten dzień, więc nie można przeliczyć kwoty na ruble. Oznacz płatność jako opłaconą w Planowaniu — tam możesz wpisać kurs ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há cotação de %@ para este dia, então não é possível calcular o valor em rublos. Marque como pago em Planejamento — lá você pode digitar a cotação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há taxa de %@ para este dia, pelo que não é possível calcular os rublos. Marque como pago em Planeamento, onde pode introduzir a taxa manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Проведите платёж из раздела «Планирование» — там курс можно ввести вручную."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби %@ барои ин рӯз ҳанӯз дастрас нест, бинобар ин маблағро бо рубл ҳисоб кардан намешавад. Онро дар «Банақшагирӣ» ҳамчун пардохтшуда қайд кунед — он ҷо қурбро дастӣ ворид кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için henüz %@ kuru yok, bu yüzden ruble tutarı hesaplanamıyor. Ödemeyi Planlama'dan yapıldı olarak işaretleyin; kuru orada elle girebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати. Позначте це як сплачене в «Плануванні» — там курс можна ввести вручну."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kun uchun %@ kursi hali yo‘q, shuning uchun rublni hisoblab bo‘lmaydi. Uni Rejalashtirish bo‘limida to‘langan deb belgilang — u yerda kursni qo‘lda kiritish mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有當天的 %@ 匯率，無法換算盧布。請從「規劃」標示為已付款，並在其中手動輸入匯率。"
          }
        }
      }
    },
    "form.reimbursable": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqası üçün ödənilib, geri qaytarılacaq"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аплачана за таго, хто верне грошы"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplaceno za někoho, kdo částku vrátí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jemanden bezahlt, der es zurückgibt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid for someone who gives it back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagado por alguien que lo devuelve"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payé pour quelqu'un qui le rembourse"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարված է մեկի փոխարեն, ով կվերադարձնի գումարը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagato per qualcuno che rimborserà"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადახდილია სხვის ნაცვლად, თანხა დაბრუნდება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтаратын адам үшін төленді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кайтарып бере турган адам үчүн төлөндү"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapłacono za kogoś, kto zwróci pieniądze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago para alguém que vai devolver"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago por alguém que devolve"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плачу за другого, он вернёт"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои касе пардохт шудааст, ки бармегардонад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri ödeyecek biri için ödendi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплачено за людину, яка поверне"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytarib beradigan odam uchun to‘langan"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代他人付款，對方會還款"
          }
        }
      }
    },
