    "form.goal.account.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Унёсак не перамяшчае грошы. Укажыце рахунак, калі грошы на мэту захоўваюцца асобна."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Beitrag bewegt kein Geld. Nennen Sie das Konto, wenn das Geld des Ziels getrennt gehalten wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A contribution moves no money. Name the account if the money of the goal is kept apart."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contributo non sposta denaro. Indica il conto se il denaro dell’obiettivo è tenuto da parte."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салым ақшаны аудармайды. Мақсат ақшасы бөлек сақталса, есеп-шотты атаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взнос в цель денег не двигает. Укажите счёт, если деньги цели лежат отдельно."
          }
        }
      }
    },
