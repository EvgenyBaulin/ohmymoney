    "form.goal.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its contributions stay spending as they were, and the goal's subcategory goes to the archive. A new goal starts from zero. ⌘Z takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus aportaciones siguen siendo gasto como estaban, y la subcategoría del objetivo pasa al archivo. Un objetivo nuevo empieza de cero. ⌘Z lo devuelve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её взносы останутся расходами, как были, а подкатегория цели уйдёт в архив. Новая цель начнётся с нуля. Отменить можно через ⌘Z."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її внески лишаються витратами, як були, а підкатегорія цілі переходить в архів. Нова ціль починається з нуля. ⌘Z її повертає."
          }
        }
      }
    },
    "form.goal.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its contributions stay spending as they were, and the goal's subcategory goes to the archive. A new goal starts from zero. “Undo” takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus aportaciones siguen siendo gasto como estaban, y la subcategoría del objetivo pasa al archivo. Un objetivo nuevo empieza de cero. «Deshacer» lo devuelve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её взносы останутся расходами, как были, а подкатегория цели уйдёт в архив. Новая цель начнётся с нуля. «Отменить» вернёт цель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її внески лишаються витратами, як були, а підкатегорія цілі переходить в архів. Нова ціль починається з нуля. «Скасувати» її повертає."
          }
        }
      }
    },
