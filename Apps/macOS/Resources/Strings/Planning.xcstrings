    "scheduled.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Artıq edilmiş əməliyyatlar qalır; yalnız cədvəl silinir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробленыя аперацыі застануцца; выдаліцца толькі расклад."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provedené operace zůstanou zachovány; odstraní se jen plán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bereits erfolgten Vorgänge bleiben; nur der Plan geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations already made stay; only the schedule goes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones ya hechas se quedan; solo se va el calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations déjà faites restent ; seul l'échéancier part."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կատարված գործարքները կմնան․ կհեռացվի միայն ժամանակացույցը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni già effettuate restano; viene eliminata solo la pianificazione."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შესრულებული ოპერაციები დარჩება; წაიშლება მხოლოდ განრიგი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұрын жасалған операциялар қалады; тек кесте жойылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасалган операциялар калат; график гана өчүрүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonane operacje pozostaną; usunięty zostanie tylko harmonogram."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações já realizadas serão mantidas; apenas o agendamento será removido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações efetuadas mantêm-se; apenas o agendamento é apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведённые операции останутся, удалится только расписание."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёти анҷомшуда мемонанд; танҳо ҷадвал нест мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılmış işlemler kalır; yalnızca ödeme planı silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вже зроблені операції лишаються; видаляється лише розклад."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajarilgan amallar saqlanadi; faqat jadval o‘chiriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已記錄的交易會保留，僅移除排程。"
          }
        }
      }
    },
