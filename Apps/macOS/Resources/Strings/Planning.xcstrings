    "scheduled.bindHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ödənilib kimi işarələ» seçimində olduğu kimi, əməliyyatı bu ödəniş tarixinə həmişəlik bağlayın"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назаўсёды звязаць аперацыю з гэтым тэрмінам плацяжу, як пры выбары «Пазначыць як аплачанае»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale přiřadit operaci k tomuto termínu, stejně jako při volbě «Označit jako zaplacené»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Vorgang dauerhaft mit diesem Fälligkeitstermin verknüpfen, wie „Als bezahlt markieren“ es täte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie the operation to this due date for good, as «Mark as paid» would"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une la operación a este vencimiento de forma definitiva, como haría «Marcar como pagado»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rattacher l'opération à cette échéance pour de bon, comme le ferait « Marquer comme payé »"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մշտապես կապել գործարքն այս ժամկետին՝ ինչպես «Նշել որպես վճարված» գործողությամբ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega definitivamente l’operazione a questa scadenza, come con «Segna come pagato»"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სამუდამოდ დაუკავშირეთ ოპერაცია ამ გადახდის ვადას, როგორც «გადახდილად მონიშვნისას»"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцияны осы мерзімге тұрақты байланыстыру, «Төленді деп белгілеу» сияқты"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Төлөндү деп белгилөө» сыяктуу, операцияны ушул төлөм мөөнөтүнө биротоло байлоо"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz operację z tym terminem na stałe, tak jak po wybraniu «Oznacz jako opłacone»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule a operação a este vencimento permanentemente, como em «Marcar como pago»"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Associar definitivamente a operação a este vencimento, como em «Marcar como pago»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навсегда связать операцию с этим сроком, как это сделал бы «Провести»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиётро ба ин муҳлати пардохт пайваста нигоҳ доред, мисли «Ҳамчун пардохтшуда қайд кардан»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemi «Ödendi olarak işaretle» seçeneğinde olduğu gibi bu vadeye kalıcı olarak bağlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назавжди прив'язати операцію до цього строку, як це зробила б «Позначити як сплачене»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«To‘langan deb belgilash» kabi amalni ushbu to‘lov muddatiga doimiy bog‘lash"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將交易永久連結至此到期項目，與「標示為已付款」相同"
          }
        }
      }
    },
