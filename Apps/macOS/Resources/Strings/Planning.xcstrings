    "reconcile.cannotRecord": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdəki hesabda və ya hesabda olmayan valyutada fərqi qeydə almaq mümkün deyil. Heç nə saxlanılmadı."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга запісаць розніцу на архіўным рахунку або ў валюце, якой няма на рахунку. Нічога не захавана."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdíl na archivovaném účtu nebo v měně, kterou účet neobsahuje, nelze zaznamenat. Nic nebylo uloženo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Differenz auf einem archivierten Konto oder in einer Währung, die das Konto nicht führt, kann nicht erfasst werden. Nichts wurde gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A difference on an archived account or in a currency the account does not hold cannot be recorded. Nothing was saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una diferencia en una cuenta archivada o en una divisa que la cuenta no tiene no se puede registrar. No se guardó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écart sur un compte archivé, ou dans une devise que le compte ne détient pas, ne peut pas être noté. Rien n'a été enregistré."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հնարավոր չէ գրանցել տարբերությունը արխիվացված հաշվի կամ հաշվին չպատկանող արժույթի համար։ Ոչինչ չի պահպանվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile registrare una differenza su un conto archiviato o in una valuta non presente sul conto. Nessuna modifica salvata."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივში არსებულ ანგარიშზე ან ანგარიშზე არარსებულ ვალუტაში სხვაობის აღრიცხვა შეუძლებელია. არაფერი შენახულა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы есеп-шоттағы немесе есеп-шотта жоқ валютадағы айырманы жазу мүмкін емес. Ештеңе сақталмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивдеги эсептеги же эсепте жок валютадагы айырманы жазууга болбойт. Эч нерсе сакталган жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać różnicy na koncie w archiwum ani w walucie, której konto nie obsługuje. Nic nie zapisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível registrar uma diferença em uma conta arquivada ou em uma moeda que a conta não possui. Nada foi salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível registar uma diferença numa conta arquivada ou numa moeda que a conta não possui. Nada foi guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу на счёте в архиве или в валюте вне списка счёта не записать. Ничего не сохранено."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фарқ дар ҳисоби бойгонӣ ё бо асъоре, ки дар ҳисоб нест, сабт намешавад. Ҳеҷ чиз захира нашуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenmiş bir hesaptaki veya hesapta bulunmayan bir para birimindeki fark kaydedilemez. Hiçbir şey kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різницю на архівному рахунку або в валюті, якої рахунок не містить, не можна записати. Нічого не збережено."
