    "planning.dueBeforeCount.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэрмін плацяжу быў %@. «Так» — аперацыя будзе датавана тэрмінам плацяжу, да зверкі: грошы ўжо ўлічаны ў зверным балансе. «Не» — аперацыя будзе датавана сённяшнім днём і паменшыць баланс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war fällig am %@. „Ja“ — der Vorgang ist auf den Fälligkeitstag datiert, vor dem Abgleich: Sein Geld steckt bereits im abgeglichenen Saldo. „Nein“ — er ist auf heute datiert und senkt den Saldo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was due %@. «Yes» — the operation is dated on the due date, before the reconciliation: its money is already in the reconciled balance. «No» — it is dated now and lowers the balance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scadenza era il %@. «Sì» — l'operazione è datata alla scadenza, prima della riconciliazione: l'importo è già incluso nel saldo riconciliato. «No» — l'operazione è datata ora e riduce il saldo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзімі %@ болған. «Иә» — операция мерзім күніне жазылады, салыстырудан бұрын: оның ақшасы салыстырылған теңгерімде бар. «Жоқ» — ол қазір жазылады және теңгерімді азайтады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок был %@. «Да» — операция встанет в день срока, до сверки: её деньги уже в сверенном остатке. «Нет» — операция запишется сейчас и уменьшит остаток."
          }
        }
      }
    },
    "planning.dueBeforeCount.title": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы за «%1$@» спісаліся да зверкі %2$@ а %3$@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das Geld für „%1$@“ vor dem Abgleich vom %2$@ am %3$@ abgegangen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the money for «%1$@» leave before the reconciliation of %2$@ at %3$@?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro per «%1$@» è uscito prima della riconciliazione del %2$@ alle %3$@?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» үшін ақша %2$@ салыстыруынан бұрын, %3$@ кетті ме?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги за «%1$@» ушли до сверки %2$@ в %3$@?"
          }
        }
      }
    },
