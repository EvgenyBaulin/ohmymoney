    "layout.empty.payments": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Арэнда, тэлефон, інтэрнэт — дадайце іх адзін раз, і Планаванне ўлічыць даты і адніме сумы ад свабодных грошай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miete, Telefon, Internet — tragen Sie sie einmal ein, und die Planung behält ihre Termine und zieht sie vom freien Betrag ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent, phone, internet — add them once, and Planning keeps their dates and takes them off the free sum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affitto, telefono, internet: aggiungili una volta e Pianificazione ne tiene traccia e li sottrae dalla somma disponibile."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пәтер, телефон, интернет — бір рет қосыңыз, Жоспарлау олардың күндерін сақтап, бос қаржыдан шегереді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аренда, телефон, интернет — добавьте их один раз, и «Планирование» будет помнить сроки и вычитать их из свободной суммы."
          }
        }
      }
    },
