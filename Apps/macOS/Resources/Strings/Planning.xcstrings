        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts vorzuschlagen: Jede Kategorie, in der Sie in den letzten drei Monaten ausgegeben haben, hat schon ein Limit, oder es gibt noch zu wenig Verlauf."
          }
        },
        "en": {
