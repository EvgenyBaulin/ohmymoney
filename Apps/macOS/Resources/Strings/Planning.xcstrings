    "namesake.financial.notSaved": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyatı tamamlamaq olmadı. Ad və ləqəblərin aktiv qeydlərdə istifadə olunmadığını yoxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося завяршыць дзеянне. Праверце, ці не занятыя назва і псеўданімы сярод актыўных запісаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akci se nepodařilo dokončit. Ověřte, zda název a aliasy nepoužívají aktivní záznamy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion konnte nicht abgeschlossen werden. Prüfe, ob der Name und die Aliasse unter den aktiven Einträgen verfügbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action could not be completed. Check that the name and aliases are available among active records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido completar la acción. Comprueba que el nombre y los alias estén disponibles entre los registros activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer l’action. Vérifiez que le nom et les alias sont disponibles parmi les entrées actives."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց ավարտել գործողությունը։ Ստուգեք, որ անունն ու այլանուններն ազատ են ակտիվ գրառումների շրջանում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l’azione. Verifica che il nome e gli alias siano disponibili tra le voci attive."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოქმედება ვერ დასრულდა. შეამოწმეთ, თავისუფალია თუ არა სახელი და მეტსახელები აქტიურ ჩანაწერებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әрекетті аяқтау мүмкін болмады. Атау мен бүркеншік аттардың белсенді жазбаларда бос екенін тексеріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аракет аткарылган жок. Аталыш жана башка аталыштар активдүү жазууларда колдонулбаганын текшериңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ukończyć operacji. Sprawdź, czy nazwa i aliasy nie są używane przez aktywne wpisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a ação. Verifique se o nome e os aliases estão disponíveis entre os registros ativos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a ação. Verifique se o nome e os alias estão disponíveis entre os registos ativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить действие. Проверьте, свободны ли имя и псевдонимы среди действующих записей."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амал иҷро нашуд. Санҷед, ки ном ва номҳои алтернативӣ дар сабтҳои фаъол банд нестанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem tamamlanamadı. Adın ve takma adların etkin kayıtlarda kullanılmadığından emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося виконати дію. Перевірте, чи назва та псевдоніми не зайняті активними записами."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Amalni bajarib bo‘lmadi. Nom va taxalluslar faol yozuvlarda band emasligini tekshiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成操作。請確認名稱和別名未被使用中的記錄佔用。"
          }
        }
      }
    },
