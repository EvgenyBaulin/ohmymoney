    "form.link.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 60 gündə əlaqələndirilməyi gözləyən gəlir yoxdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма даходаў за апошнія 60 дзён, якія можна звязаць"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný příjem z posledních 60 dnů nečeká na propojení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Einnahme der letzten 60 Tage wartet auf eine Verknüpfung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No income of the last 60 days waits to be linked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún ingreso de los últimos 60 días pendiente de vincular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun revenu des 60 derniers jours n'attend d'être lié"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին 60 օրում կապելու ենթակա եկամուտ չկա"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun reddito degli ultimi 60 giorni da collegare"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო 60 დღეში დასაკავშირებელი შემოსავალი არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 60 күнде байланыстыруды күтетін табыс жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы 60 күндө байланыштырыла элек киреше жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak przychodów z ostatnich 60 dni do powiązania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma receita dos últimos 60 dias disponível para vincular"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há rendimentos dos últimos 60 dias por associar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 60 дней нет непривязанных доходов"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади пайвастнашуда аз 60 рӯзи охир нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 60 gün içinde bağlanmayı bekleyen gelir yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доходів за останні 60 днів, які чекають на зв'язування"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi 60 kunda bog‘lash uchun daromad yo‘q"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 60 天內沒有可連結的收入"
          }
        }
      }
    },
