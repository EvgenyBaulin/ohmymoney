    "goals.screen.noRules": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ qayda yoxdur: qaydalar gəlirin adətən necə bölündüyünü göstərir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правілаў пакуль няма: яны вызначаюць, як звычайна размяркоўваецца даход."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádná pravidla. Určují, jak se příjem obvykle rozděluje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Regeln: Sie sagen, wie eine Einnahme üblicherweise aufgeteilt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules yet: they say how an income is usually split."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay reglas: indican cómo suele repartirse un ingreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de règle : elles disent comment un revenu est d'ordinaire réparti."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանոններ դեռ չկան․ դրանք սահմանում են եկամտի սովորական բաշխումը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna regola: indicano come ripartire di solito un’entrata."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წესები ჯერ არ არის: ისინი განსაზღვრავს, როგორ ნაწილდება შემოსავალი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер әлі жоқ: олар табыс әдетте қалай бөлінетінін айтады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча эрежелер жок: алар киреше адатта кантип бөлүштүрүлөрүн аныктайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak reguł podziału przychodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma regra ainda: elas definem como uma receita costuma ser dividida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há regras para a distribuição habitual dos rendimentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил пока нет: они говорят, как обычно делится доход."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз қоидае нест: онҳо тарзи тақсими даромадро нишон медиҳанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kural yok. Kurallar, bir gelirin genellikle nasıl dağıtıldığını belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил ще немає: вони показують, як зазвичай ділиться дохід."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha qoidalar yo‘q: ular daromad odatda qanday taqsimlanishini belgilaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無規則。規則可設定收入通常如何分配。"
          }
        }
      }
    },
