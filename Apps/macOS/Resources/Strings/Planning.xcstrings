    "reconcile.saveOnlyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balances are kept; the difference is not recorded as an operation, now or later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos se conservan; la diferencia no se registra como operación, ni ahora ni después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes sont gardés ; l'écart n'est pas noté comme opération, ni maintenant ni plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки запомнятся, а разница не запишется операцией — ни сейчас, ни потом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки зберігаються; різниця не записується як операція ні зараз, ні пізніше."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi vengono conservati; la differenza non viene registrata come operazione, né ora né in seguito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теңгерімдер сақталады; айырма қазір де, кейін де операция ретінде жазылмайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансы захаваюцца; розніца не будзе запісана як аперацыя ні цяпер, ні пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Salden bleiben erhalten; die Differenz wird weder jetzt noch später als Vorgang erfasst."
          }
        }
      }
    },
    "reconcile.saveStart": {
