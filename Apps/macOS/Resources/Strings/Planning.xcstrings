    "planning.dueBeforeCount.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was due %@. «Yes» — the operation is dated on the due date, before the reconciliation: its money is already in the reconciled balance. «No» — it is dated now and lowers the balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vencía el %@. «Sí» — la operación se fecha en el día de vencimiento, antes de la conciliación: su dinero ya está en el saldo conciliado. «No» — se fecha hoy y baja el saldo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок был %@. «Да» — операция встанет в день срока, до сверки: её деньги уже в сверенном остатке. «Нет» — операция запишется сейчас и уменьшит остаток."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його мали сплатити %@. «Так» — операція датується днем платежу, до звірки: її гроші вже в звіреному залишку. «Ні» — вона датується зараз і зменшує залишок."
          }
        }
      }
    },
    "planning.dueBeforeCount.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the money for «%1$@» leave before the reconciliation of %2$@ at %3$@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Salió el dinero de «%1$@» antes de la conciliación del %2$@ a las %3$@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги за «%1$@» ушли до сверки %2$@ в %3$@?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи пішли гроші за «%1$@» до звірки %2$@ о %3$@?"
          }
        }
      }
    },
