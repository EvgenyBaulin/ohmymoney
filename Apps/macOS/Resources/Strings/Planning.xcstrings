    "reconcile.notSaved": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверка не захавана, нічога не запісана. Паспрабуйце яшчэ раз."
          }
        },
        "de": {
