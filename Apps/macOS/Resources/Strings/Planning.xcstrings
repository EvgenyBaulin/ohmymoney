    "reconcile.firstCountToggle.on": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo %@ wird zum Ausgangspunkt: keine Einnahme, keine Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance %@ becomes the starting point: no income, no spending."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімі бастапқы нүкте болады: табыс та, шығын да жоқ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
