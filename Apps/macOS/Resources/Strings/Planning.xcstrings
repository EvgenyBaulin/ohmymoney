    "reminders.overdue.settledHelp": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыць тэрмін плацяжу без аперацыі: грошы спісаны да зверкі рахунку %@ і ўжо ўлічаны ў яго балансе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie den Termin ohne Vorgang: Das Geld ging vor dem Abgleich vom %@ ab, und sein Saldo enthält das bereits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the due date without an operation: the money left before the reconciliation of %@, and its balance already holds that."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi la scadenza senza un’operazione: il denaro è uscito prima della riconciliazione di %@ e il saldo ne tiene già conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзімді операциясыз жабыңыз: ақша %@ салыстыруынан бұрын кетті, ал теңгерімде ол бұрыннан бар."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть срок без операции: деньги ушли до сверки %@, и её остаток это уже учёл."
          }
        }
      }
    },
