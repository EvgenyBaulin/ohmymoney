    "form.expected.termHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul ayın başqa bir günü də daxil olur — məsələn, ayın 15-də və son günü: hər tarix ayrıca gəlirdir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы паступаюць і ў іншы дзень месяца — напрыклад, 15-га і ў апошні дзень. Кожнае паступленне лічыцца асобным даходам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze přicházejí i v jiný den v měsíci — například 15. a poslední den. Každý termín je samostatný příjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld kommt auch an einem anderen Tag des Monats — zum Beispiel am 15. und am letzten Tag: Jeder Termin ist eine eigene Einnahme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money comes on another day of the month too — for example on the 15th and on the last day: each term is an income of its own"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero llega también en otro día del mes — por ejemplo el 15 y el último día: cada fecha es un ingreso propio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent arrive aussi un autre jour du mois — par exemple le 15 et le dernier jour : chaque échéance est un revenu à part entière"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը ստացվում է նաև ամսվա մեկ այլ օր․ օրինակ՝ 15-ին և վերջին օրը։ Յուրաքանչյուր ամսաթիվ առանձին եկամուտ է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro arriva anche in un altro giorno del mese, per esempio il 15 e l’ultimo giorno: ogni scadenza è un reddito a sé"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა თვის სხვა დღესაც შემოდის — მაგალითად, 15 რიცხვში და ბოლო დღეს: თითოეული თარიღი ცალკე შემოსავალია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша айдың басқа күнінде де келеді — мысалы 15-інде және айдың соңғы күнінде: әр мерзім өз алдына табыс"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча айдын башка күнүндө да түшөт — мисалы, 15-күнү жана акыркы күнү: ар бири өзүнчө киреше катары эсептелет"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieniądze wpływają także w innym dniu miesiąca — na przykład 15. i ostatniego dnia. Każdy termin to osobny przychód."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro também chega em outro dia do mês — por exemplo, no dia 15 e no último dia. Cada data corresponde a uma receita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro também chega noutro dia do mês — por exemplo, no dia 15 e no último dia: cada data é um rendimento distinto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги приходят и в другой день месяца — например 15-го и в последний день: каждый срок — отдельное поступление"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пул дар рӯзи дигари моҳ низ ворид мешавад — масалан, рӯзи 15-ум ва рӯзи охир: ҳар пардохт даромади алоҳида аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ayın başka bir günü de gelir. Örneğin ayın 15'inde ve son gününde: her tarih ayrı bir gelirdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші приходять і в інший день місяця — наприклад, 15-го і в останній день: кожен строк є окремим доходом"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul oyning boshqa kunida ham tushadi — masalan, 15-kuni va oxirgi kuni: har bir sana alohida daromad hisoblanadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月其他日期也會入帳，例如 15 日和月底；每個日期各算一筆收入"
          }
        }
      }
    },
