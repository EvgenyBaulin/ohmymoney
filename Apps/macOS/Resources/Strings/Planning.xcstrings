    "selfEmployed.offer.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sieht nach Einnahmen eines Selbstständigen aus. Die App kann die Steuer berechnen, am 28. an ihren Fälligkeitstag erinnern und sie aus dem freien Betrag heraushalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like income of the self-employed. The app can count the tax, remind of its due day on the 28th and keep it out of the free sum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, у вас доход самозанятого. Приложение может считать налог НПД, напоминать о сроке 28-го числа и не считать налог свободными деньгами."
          }
        }
      }
    },
    "selfEmployed.offer.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie selbstständig?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you self-employed?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы самозанятый?"
          }
        }
      }
    }
