    "reconcile.notRecorded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Differenz konnte nicht erfasst werden, daher wurde der Abgleich nicht gespeichert. Versuchen Sie es erneut oder sichern Sie ihn ohne Erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The difference could not be recorded, so the reconciliation was not saved. Try again, or save it without recording."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айырманы жазу мүмкін болмады, сондықтан салыстыру сақталмады. Қайталап көріңіз, не жазбай сақтаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу записать не удалось, и сверка не сохранена. Попробуйте ещё раз или сохраните её без записи."
          }
        }
      }
    },
    "reconcile.notRecordedMark": {
