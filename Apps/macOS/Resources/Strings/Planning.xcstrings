    "form.goal.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrılmış vəsaitlər əvvəlki kimi xərc olaraq qalır, məqsədin alt kateqoriyası isə arxivə köçürülür. Yeni məqsəd sıfırdan başlayır. ⌘Z bunu geri qaytarır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Унёскі застануцца выдаткамі, а падкатэгорыя мэты пяройдзе ў архіў. Новая мэта пачнецца з нуля. ⌘Z адновіць мэту."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvky zůstanou jako výdaje a podkategorie cíle se přesune do archivu. Nový cíl začíná od nuly. Pomocí ⌘Z smazání vrátíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Beiträge bleiben Ausgaben, wie sie waren, und die Unterkategorie des Ziels wandert ins Archiv. Ein neues Ziel beginnt bei null. ⌘Z nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its contributions stay spending as they were, and the goal's subcategory goes to the archive. A new goal starts from zero. ⌘Z takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus aportaciones siguen siendo gasto como estaban, y la subcategoría del objetivo pasa al archivo. Un objetivo nuevo empieza de cero. ⌘Z lo devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses contributions restent des dépenses comme avant, et la sous-catégorie de l'objectif part aux archives. Un nouvel objectif repart de zéro. ⌘Z le rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համալրումները կմնան որպես ծախս, իսկ նպատակի ենթակատեգորիան կտեղափոխվի արխիվ։ Նոր նպատակը կսկսվի զրոյից։ ⌘Z-ը կհետարկի գործողությունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contributi rimangono tra le spese e la sottocategoria dell’obiettivo viene archiviata. Un nuovo obiettivo parte da zero. Premi ⌘Z per annullare."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენატანები ხარჯებად დარჩება, ხოლო მიზნის ქვეკატეგორია არქივში გადავა. ახალი მიზანი ნულიდან დაიწყება. ⌘Z აღადგენს მას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның салымдары бұрынғыдай шығын болып қалады, ал мақсаттың ішкі санаты мұрағатқа өтеді. Жаңа мақсат нөлден басталады. ⌘Z қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салымдар мурдагыдай чыгаша бойдон калат, ал эми максаттын ички санаты архивге өтөт. Жаңы максат нөлдөн башталат. ⌘Z өзгөртүүнү артка кайтарат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłaty pozostaną wydatkami, a podkategoria celu trafi do archiwum. Nowy cel zacznie się od zera. Naciśnij ⌘Z, aby cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As contribuições continuam registradas como despesas, e a subcategoria da meta vai para o arquivo. Uma nova meta começa do zero. Use ⌘Z para desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As contribuições mantêm-se como despesas e a subcategoria do objetivo é arquivada. Um novo objetivo começa do zero. Prima ⌘Z para repor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её взносы останутся расходами, как были, а подкатегория цели уйдёт в архив. Новая цель начнётся с нуля. Отменить можно через ⌘Z."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағҳои гузошташуда ҳамчун хароҷот боқӣ мемонанд ва зеркатегорияи ҳадаф ба бойгонӣ меравад. Ҳадафи нав аз сифр оғоз мешавад. ⌘Z онро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkılar harcama olarak kalır ve hedefin alt kategorisi arşivlenir. Yeni bir hedef sıfırdan başlar. ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її внески лишаються витратами, як були, а підкатегорія цілі переходить в архів. Нова ціль починається з нуля. ⌘Z її повертає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajratilgan mablag‘lar xarajat sifatida qoladi, maqsadning kichik toifasi esa arxivga o‘tadi. Yangi maqsad noldan boshlanadi. ⌘Z bilan tiklash mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存入的金額仍會保留為支出，目標的子類別會移至封存。新目標將從零開始。按 ⌘Z 可還原。"
          }
        }
      }
    },
    "form.goal.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrılmış vəsaitlər əvvəlki kimi xərc olaraq qalır, məqsədin alt kateqoriyası isə arxivə köçürülür. Yeni məqsəd sıfırdan başlayır. “Geri al” bunu geri qaytarır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Унёскі застануцца выдаткамі, а падкатэгорыя мэты пяройдзе ў архіў. Новая мэта пачнецца з нуля. “Адмяніць” адновіць мэту."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvky zůstanou jako výdaje a podkategorie cíle se přesune do archivu. Nový cíl začíná od nuly. Pomocí „Zpět“ smazání vrátíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Beiträge bleiben Ausgaben, wie sie waren, und die Unterkategorie des Ziels wandert ins Archiv. Ein neues Ziel beginnt bei null. „Rückgängig“ nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its contributions stay spending as they were, and the goal's subcategory goes to the archive. A new goal starts from zero. “Undo” takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus aportaciones siguen siendo gasto como estaban, y la subcategoría del objetivo pasa al archivo. Un objetivo nuevo empieza de cero. «Deshacer» lo devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses contributions restent des dépenses comme avant, et la sous-catégorie de l'objectif part aux archives. Un nouvel objectif repart de zéro. « Annuler » le rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համալրումները կմնան որպես ծախս, իսկ նպատակի ենթակատեգորիան կտեղափոխվի արխիվ։ Նոր նպատակը կսկսվի զրոյից։ “Հետարկել”-ը կհետարկի գործողությունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contributi rimangono tra le spese e la sottocategoria dell’obiettivo viene archiviata. Un nuovo obiettivo parte da zero. Tocca “Annulla” per ripristinare."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენატანები ხარჯებად დარჩება, ხოლო მიზნის ქვეკატეგორია არქივში გადავა. ახალი მიზანი ნულიდან დაიწყება. „გაუქმება“ აღადგენს მას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның салымдары бұрынғыдай шығын болып қалады, ал мақсаттың ішкі санаты мұрағатқа өтеді. Жаңа мақсат нөлден басталады. «Болдырмау» қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салымдар мурдагыдай чыгаша бойдон калат, ал эми максаттын ички санаты архивге өтөт. Жаңы максат нөлдөн башталат. “Артка кайтаруу” өзгөртүүнү жокко чыгарат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłaty pozostaną wydatkami, a podkategoria celu trafi do archiwum. Nowy cel zacznie się od zera. Wybierz „Cofnij”, aby cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As contribuições continuam registradas como despesas, e a subcategoria da meta vai para o arquivo. Uma nova meta começa do zero. Use “Desfazer” para restaurá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As contribuições mantêm-se como despesas e a subcategoria do objetivo é arquivada. Um novo objetivo começa do zero. Toque em “Desfazer” para repor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её взносы останутся расходами, как были, а подкатегория цели уйдёт в архив. Новая цель начнётся с нуля. «Отменить» вернёт цель."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағҳои гузошташуда ҳамчун хароҷот боқӣ мемонанд ва зеркатегорияи ҳадаф ба бойгонӣ меравад. Ҳадафи нав аз сифр оғоз мешавад. “Бекор кардан” онро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkılar harcama olarak kalır ve hedefin alt kategorisi arşivlenir. Yeni bir hedef sıfırdan başlar. “Geri Al” ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її внески лишаються витратами, як були, а підкатегорія цілі переходить в архів. Нова ціль починається з нуля. «Скасувати» її повертає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajratilgan mablag‘lar xarajat sifatida qoladi, maqsadning kichik toifasi esa arxivga o‘tadi. Yangi maqsad noldan boshlanadi. “Bekor qilish” bilan tiklash mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存入的金額仍會保留為支出，目標的子類別會移至封存。新目標將從零開始。點一下「復原」可還原。"
          }
        }
      }
    },
    "form.goal.delete.outsideGoals": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu məqsədi silmək mümkün deyil: ayrılmış vəsaitlərin bəziləri məqsədlər kateqoriyasından kənarda qeyd edilib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Немагчыма выдаліць гэту мэту: некаторыя ўнёскі знаходзяцца па-за катэгорыяй мэт."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento cíl nelze smazat: některé příspěvky jsou zařazeny mimo kategorii cílů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ziel kann nicht gelöscht werden: Einige seiner Beiträge sind außerhalb der Kategorie „Ziele“ abgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This goal cannot be deleted: some of its contributions are filed outside the goals category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este objetivo no se puede eliminar: parte de sus aportaciones están archivadas fuera de la categoría de objetivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet objectif ne peut pas être supprimé : certaines de ses contributions sont classées hors de la catégorie des objectifs."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս նպատակը հնարավոր չէ ջնջել․ դրա որոշ համալրումներ գրանցված են նպատակների կատեգորիայից դուրս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare questo obiettivo: alcuni contributi sono registrati fuori dalla categoria degli obiettivi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ მიზნის წაშლა შეუძლებელია: ზოგიერთი შენატანი მიზნების კატეგორიის გარეთაა აღრიცხული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл мақсатты жою мүмкін емес: оның кейбір салымдары «Мақсаттар» санатынан тыс жазылған."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул максатты өчүрүү мүмкүн эмес: айрым салымдары максаттар санатынан тышкары катталган."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można usunąć tego celu: niektóre wpłaty są przypisane poza kategorią celów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta meta não pode ser apagada: algumas contribuições estão fora da categoria de metas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este objetivo não pode ser apagado: algumas contribuições estão noutra categoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту цель не удалить: у неё есть взносы вне категории целей."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ҳадафро нест кардан мумкин нест: баъзе маблағҳои гузошташуда берун аз категорияи ҳадафҳо сабт шудаанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hedef silinemez: Bazı katkıları hedefler kategorisinin dışında yer alıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю ціль не можна видалити: частина її внесків записана поза категорією цілей."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu maqsadni o‘chirib bo‘lmaydi: ayrim ajratmalar maqsadlar toifasidan tashqarida qayd etilgan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除此目標：部分存入金額記錄在目標類別以外。"
          }
        }
      }
    },
    "form.goal.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
