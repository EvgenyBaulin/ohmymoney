    "reminders.overdue.skipHelp": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж не зроблены: тэрмін закрываецца без аперацыі, як пры выбары «Прапусціць» у планаванні"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wurde nicht geleistet: Der Termin wird ohne Vorgang geschlossen, wie „Überspringen“ in der Planung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment was not made: the due date is closed without an operation, as «Skip» in Planning does"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento non è stato effettuato: la scadenza viene chiusa senza un’operazione, come con «Salta» in Pianificazione"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлем жасалмады: мерзім операциясыз жабылады, Жоспарлаудағы «Өткізу» сияқты"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежа не было: срок закрывается без операции, как «Пропустить» в «Планировании»"
          }
        }
      }
    },
    "reminders.overdue.title": {
      "extractionState": "manual",
