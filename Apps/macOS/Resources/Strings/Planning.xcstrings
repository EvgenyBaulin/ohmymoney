    "limits.amount.help": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даступна ў гэтым месяцы. Націсніце, каб змяніць месячны ліміт без уліку пераносу. Return захоўвае, Esc вяртае ранейшае значэнне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar in diesem Monat. Klicken, um das monatliche Limit zu ändern, die Übertragung daneben. Return speichert, Esc setzt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available this month. Click to change the monthly limit, the carry aside. Return saves, Esc puts it back."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile questo mese. Fai clic per modificare il limite mensile, escluso il riporto. Invio salva, Esc annulla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда қолжетімді. Айлық лимитті өзгерту үшін басыңыз, көшіру бөлек. Return сақтайды, Esc қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно в этом месяце. Нажмите, чтобы изменить лимит в месяц, без переноса. Return — сохранить, Esc — вернуть как было."
          }
        }
      }
    },
