    "form.toAccount.auto": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuncu dəfəki hesab, yoxdursa əsas hesab"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Як мінулым разам, інакш на асноўны"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako minule, jinak hlavní účet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wie beim letzten Mal, sonst das Hauptkonto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As last time, else the main one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como la última vez, si no la principal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme la fois précédente, sinon le principal"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչպես նախորդ անգամ, հակառակ դեպքում՝ հիմնականը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come l'ultima volta, altrimenti il principale"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როგორც ბოლოს, ან მთავარ ანგარიშზე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "өткен жолдағыдай, әйтпесе негізгісіне"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөн жолку эсепке же негизги эсепке"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak ostatnio, a jeśli brak — główne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesma da última vez ou a principal"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A última utilizada ou a principal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в последний раз, иначе основной"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мисли дафъаи гузашта, вагарна ба ҳисоби асосӣ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kullanılan hesap, yoksa ana hesap"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як минулого разу, інакше основний"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan safargidek, aks holda asosiy hisobga"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次使用的帳戶，否則使用主要帳戶"
          }
        }
      }
    },
