          "stringUnit": {
            "state": "translated",
            "value": "When an income is allocated: the contribution and a transfer to this account, one step; the sheet can untick it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al distribuir un ingreso: la aportación y una transferencia a esta cuenta, en un solo paso; la hoja permite desmarcarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de la répartition d'un revenu : la contribution et un virement vers ce compte, en une étape ; la feuille peut le décocher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При распределении дохода — взнос и перевод на этот счёт одним шагом; в листе галочку можно снять."
          }
        },
        "uk": {
          "stringUnit": {
