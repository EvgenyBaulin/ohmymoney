    "events.form.budgetHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş buraxın — büdcə olmayacaq. Büdcədən qalan məbləğ sərbəst məbləğdə ehtiyatda saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуста — без бюджэту. Рэшта бюджэту рэзервуецца ў свабоднай суме."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdné pole znamená žádný rozpočet. Zbytek rozpočtu zůstává ve volné částce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer — kein Budget. Was von einem Budget übrig ist, bleibt im freien Betrag zurückgehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty — no budget. What is left of a budget is kept back in the free sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacío — sin presupuesto. Lo que queda de un presupuesto se guarda en la suma libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide — pas de budget. Ce qui reste d'un budget est réservé dans la somme libre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դատարկ՝ առանց բյուջեի։ Բյուջեի մնացորդը պահուստավորվում է ազատ գումարից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per non impostare un budget. La parte inutilizzata del budget resta riservata nell’importo disponibile."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცარიელი — ბიუჯეტის გარეშე. ბიუჯეტის ნაშთი თავისუფალი თანხიდან გადაიდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бос — бюджет жоқ. Бюджеттің қалғаны бос қаржыда бөлініп қойылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бош калса — бюджет жок. Бюджеттин калдыгы эркин суммадан бөлүнүп сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby nie ustawiać budżetu. Pozostała kwota budżetu jest zarezerwowana w wolnych środkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em branco — sem orçamento. O valor restante do orçamento fica reservado no saldo livre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para não definir um orçamento. O valor restante do orçamento fica reservado e não é incluído no montante disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусто — без бюджета. Остаток бюджета придерживается в свободной сумме."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Холӣ — бе буҷет. Бақияи буҷет дар маблағи озод нигоҳ дошта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş bırakılırsa bütçe belirlenmez. Bütçeden kalan tutar, kullanılabilir tutardan ayrı tutulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожньо — без бюджету. Залишок бюджету відкладається у вільній сумі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo‘sh qoldirilsa, budjet belgilanmaydi. Budjetning qoldig‘i erkin summada saqlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空表示不設定預算。預算餘額會從可用金額中保留。"
          }
        }
      }
    },
