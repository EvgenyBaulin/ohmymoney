    "selfEmployed.offer.later": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wird einmal gefragt: Schalten Sie es jederzeit unter Einstellungen → Planung ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is asked once: turn it on any time in Settings → Planning."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл бір рет сұралады: оны кез келген уақытта «Параметрлер → Жоспарлау» ішінде қосуға болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не спросим: включить можно в «Настройки → Планирование»."
          }
        }
      }
    },
    "selfEmployed.offer.notNow": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht jetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір емес"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зараз"
          }
        }
      }
    },
    "selfEmployed.offer.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sieht nach Einnahmen eines Selbstständigen aus. Die App kann die Steuer berechnen, am 28. an ihren Fälligkeitstag erinnern und sie aus dem freien Betrag heraushalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like income of the self-employed. The app can count the tax, remind of its due day on the 28th and keep it out of the free sum."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл өзін-өзі жұмыспен қамтығандардың табысына ұқсайды. Қолданба салықты санай алады, оның мерзімі 28-і туралы еске салады және оны бос қаржыдан бөлек ұстайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, у вас доход самозанятого. Приложение может считать налог НПД, напоминать о сроке 28-го числа и не считать налог свободными деньгами."
          }
        }
      }
    },
    "selfEmployed.offer.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie selbstständig?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you self-employed?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіз өзін-өзі жұмыспен қамтыған адамсыз ба?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы самозанятый?"
          }
        }
      }
    }
  },
  "version": "1.0"
}
