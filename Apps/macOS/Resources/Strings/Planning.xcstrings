    "reconcile.saveOnlyHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qalıqlar saxlanılır; fərq nə indi, nə də sonradan əməliyyat kimi qeydə alınır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансы захаваюцца; розніца не будзе запісана як аперацыя ні цяпер, ні пазней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatky se uloží; rozdíl se nezaznamená jako operace nyní ani později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Salden bleiben erhalten; die Differenz wird weder jetzt noch später als Vorgang erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balances are kept; the difference is not recorded as an operation, now or later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos se conservan; la diferencia no se registra como operación, ni ahora ni después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes sont gardés ; l'écart n'est pas noté comme opération, ni maintenant ni plus tard."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մնացորդները պահպանվում են, իսկ տարբերությունը չի գրանցվում որպես գործարք՝ ոչ հիմա, ոչ էլ հետագայում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi vengono conservati; la differenza non viene registrata come operazione, né ora né in seguito."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაშთები შეინახება; სხვაობა ოპერაციად არც ახლა ჩაიწერება და არც მოგვიანებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теңгерімдер сақталады; айырма қазір де, кейін де операция ретінде жазылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Калдыктар сакталат; айырма азыр да, кийин да операция катары жазылбайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salda zostaną zachowane, a różnica nie zostanie zapisana jako operacja ani teraz, ani później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos são mantidos; a diferença não é registrada como operação, agora nem depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos são guardados; a diferença não é registada como operação, agora nem mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки запомнятся, а разница не запишется операцией — ни сейчас, ни потом."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияҳо нигоҳ дошта мешаванд; фарқ ҳоло ё баъдтар ҳамчун амалиёт сабт намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiyeler saklanır; fark şimdi veya daha sonra işlem olarak kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки зберігаються; різниця не записується як операція ні зараз, ні пізніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoldiqlar saqlanadi; farq hozir ham, keyin ham amal sifatida yozilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留餘額，但不會將差額記為交易，日後也不會。"
          }
        }
      }
    },
    "reconcile.saveStart": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
