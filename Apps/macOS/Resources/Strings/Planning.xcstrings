        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importo approssimativo nella valuta predefinita, al tasso CBR di oggi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі валютада шамамен осыншама, бүгінгі ҚР Банкінің бағамы бойынша"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przybliżona kwota w walucie domyślnej, według dzisiejszego kursu CBR"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor aproximado na moeda padrão, pela cotação de hoje do CBR"
