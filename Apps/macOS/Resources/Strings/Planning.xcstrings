    "reconcile.firstCount.total": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падчас агульнага падліку %2$@ запісана %1$@; папярэдніх падлікаў не было. Калі гэта быў першы падлік грошай, сума не з'яўляецца ні даходам, ні расходам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gesamtzählung von %1$@ hat %2$@ ohne vorherige Zählung erfasst. Wenn Sie das Geld zum ersten Mal gezählt haben, ist es weder Einnahme noch Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one-total count of %1$@ recorded %2$@ with no count before it. If that was the first time you counted the money, it is neither income nor spending."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conteggio totale di %1$@ ha registrato %2$@ senza alcun conteggio precedente. Se era la prima volta che contavi il denaro, non è né un'entrata né una spesa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ бір жиынды санауы %2$@ жазды, оның алдында санау болмаған. Ақшаны алғаш рет санаған болсаңыз, ол табыс та, шығын да емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверка одной суммой %1$@ записала %2$@, а до неё сверок не было. Если это был первый пересчёт денег, это не доход и не расход."
          }
        }
      }
    },
