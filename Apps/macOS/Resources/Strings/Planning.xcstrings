    "reconcile.recordHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Differenz wird zu einem Vorgang unter „Abgleich“ auf ihrem Konto und in ihrer Währung. Fügen Sie später einen Vorgang hinzu oder korrigieren Sie einen, der vor dieser Zählung datiert ist, dann folgt die Differenz von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every difference becomes an operation in «Reconciliation» on its account and in its currency. Add or fix an operation dated before this count later, and the difference follows by itself."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр айырма өз есеп-шотында және өз валютасында «Салыстыру» ішіндегі операцияға айналады. Осы санаудан бұрынғы күнге операция қосыңыз немесе түзетіңіз — айырма өзі соған ілесіп өзгереді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая разница — операция в «Сверке» на своём счёте и в своей валюте. Добавите или поправите потом операцию до этой сверки — разница пересчитается сама."
          }
        }
      }
    },
