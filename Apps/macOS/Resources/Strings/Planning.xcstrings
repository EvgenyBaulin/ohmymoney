            "state": "translated",
            "value": "Are you self-employed?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei un lavoratore autonomo?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіз өзін-өзі жұмыспен қамтыған адамсыз ба?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы самозанятый?"
          }
        }
      }
    }
