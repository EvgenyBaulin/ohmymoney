    "layout.empty.subscriptions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions charged every month or year show here, with their price a month and a year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones que se cobran cada mes o cada año aparecen aquí, con su precio al mes y al año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements prélevés chaque mois ou chaque année s'affichent ici, avec leur prix par mois et par an."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки, которые списываются каждый месяц или год, будут здесь — с ценой в месяц и в год."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписки, що списуються щомісяця чи щороку, з'являються тут, із ціною на місяць і на рік."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui trovi gli abbonamenti addebitati ogni mese o anno, con il costo mensile e annuale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай немесе жыл сайын төленетін жазылымдар осында көрінеді, айына және жылына бағасымен."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’явяцца штомесячныя і штогадовыя падпіскі з іх коштам за месяц і год."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos, die jeden Monat oder jedes Jahr abgebucht werden, erscheinen hier mit ihrem Preis im Monat und im Jahr."
          }
        }
      }
    },
