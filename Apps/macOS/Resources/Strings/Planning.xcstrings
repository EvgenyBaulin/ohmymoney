        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվարկվում է նպատակի %@ արժույթով՝ տվյալ օրվա փոխարժեքով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteggiato in %@ dell’obiettivo al tasso del giorno"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ითვლება მიზნის ვალუტაში (%@), იმ დღის კურსით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсаттың %@ валютасында, күнінің бағамы бойынша есептеледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Максаттын %@ валютасында ошол күндүн курсу менен эсептелет"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeliczane na %@ celu po kursie z danego dnia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertido para %@ da meta pela cotação do dia"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertido para %@ do objetivo à taxa desse dia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В цель пойдёт в %@ по курсу своего дня"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо %@-и ҳадаф аз рӯйи қурби ҳамон рӯз ҳисоб мешавад"
          }
        },
        "tr": {
          "stringUnit": {
