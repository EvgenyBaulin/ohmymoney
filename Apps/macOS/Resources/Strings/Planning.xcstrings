            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. It loads from the Bank of Russia once the Mac is online — or pick another currency or date."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
