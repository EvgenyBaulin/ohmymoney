    "reminders.overdue.settledHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the due date without an operation: the money left before the reconciliation of %@, and its balance already holds that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra el vencimiento sin operación: el dinero salió antes de la conciliación del %@, y su saldo ya lo contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturer l'échéance sans opération : l'argent est parti avant le rapprochement du %@, et son solde le contient déjà."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть срок без операции: деньги ушли до сверки %@, и её остаток это уже учёл."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити строк без операції: гроші пішли до звірки %@, і її залишок їх уже містить."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi la scadenza senza un’operazione: il denaro è uscito prima della riconciliazione di %@ e il saldo ne tiene già conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзімді операциясыз жабыңыз: ақша %@ салыстыруынан бұрын кетті, ал теңгерімде ол бұрыннан бар."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыць тэрмін плацяжу без аперацыі: грошы спісаны да зверкі рахунку %@ і ўжо ўлічаны ў яго балансе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
