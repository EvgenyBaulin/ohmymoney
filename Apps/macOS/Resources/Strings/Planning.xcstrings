    "selfEmployed.offer.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is asked once: turn it on any time in Settings → Planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se pregunta una vez: actívelo cuando quiera en Ajustes → Planificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette question n'est posée qu'une fois : activez-le à tout moment dans Réglages → Planification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не спросим: включить можно в «Настройки → Планирование»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це питається один раз: увімкнути можна будь-коли в «Налаштування → Планування»."
          }
        }
      }
    },
    "selfEmployed.offer.notNow": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas maintenant"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зараз"
          }
        }
      }
    },
    "selfEmployed.offer.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like income of the self-employed. The app can count the tax, remind of its due day on the 28th and keep it out of the free sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece un ingreso de actividad propia. La app puede calcular el impuesto, recordar su día de pago el 28 y dejarlo fuera de la suma libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ressemble à des revenus d'indépendant. L'app peut calculer l'impôt, rappeler son échéance le 28 et le garder hors de la somme libre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, у вас доход самозанятого. Приложение может считать налог НПД, напоминать о сроке 28-го числа и не считать налог свободными деньгами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже на дохід самозайнятих. Застосунок може порахувати податок, нагадати про його день — 28-го — і не враховувати його у вільній сумі."
          }
        }
      }
    },
    "selfEmployed.offer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you self-employed?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es usted autónomo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous indépendant ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы самозанятый?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви самозайнятий?"
          }
        }
      }
    }
