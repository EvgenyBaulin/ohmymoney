    "reconcile.firstCountToggle.on": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qalığı başlanğıc nöqtəsi olur: nə gəlir, nə də xərc."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс %@ становіцца пачатковым: без даходу і расходу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek %@ bude výchozím stavem: bez příjmu i výdaje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo %@ wird zum Ausgangspunkt: keine Einnahme, keine Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance %@ becomes the starting point: no income, no spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo %@ pasa a ser el punto de partida: ni ingreso ni gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde %@ devient le point de départ : ni revenu ni dépense."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ մնացորդը դառնում է ելակետ՝ առանց եկամտի կամ ծախսի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo di %@ diventa il punto di partenza: nessuna entrata, nessuna spesa."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაშთი %@ ხდება საწყისი წერტილი: შემოსავლისა და ხარჯის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімі бастапқы нүкте болады: табыс та, шығын да жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ калдыгы баштапкы чекит болот: киреше да, чыгаша да жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo %@ staje się punktem początkowym: bez przychodu i wydatku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de %@ será o ponto de partida: sem receita nem despesa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de %@ passa a ser o ponto de partida: sem receita nem despesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток %@ — точка отсчёта, без дохода и расхода."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи %@ нуқтаи оғоз мешавад: бе даромад ва хароҷот."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyesi başlangıç noktası olur: gelir veya gider oluşmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок %@ стає точкою відліку: ні доходу, ні витрати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qoldiq boshlang‘ich nuqtaga aylanadi: daromad ham, xarajat ham yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額 %@ 將成為起始點，不計為收入或支出。"
          }
        }
      }
    },
    "reconcile.firstCountToggleHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 versiyasından əvvəl boş qalıq sıfır kimi yazılırdı. Buna görə bu, çox güman ki, pulun ilk real sayımıdır və başlanğıc nöqtəsi olur. Yalnız sıfır real idisə, seçimi ləğv edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да версіі 1.2 пусты баланс запісваўся як нуль, таму гэта, хутчэй за ўсё, першы сапраўдны падлік грошай. Ён стане пачатковым балансам. Зніміце сцяжок, толькі калі той нуль быў сапраўдным."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před verzí 1.2 se prázdný zůstatek ukládal jako nula. Nejspíš tedy jde o první skutečné zjištění zůstatku, které se stane výchozím stavem. Zaškrtnutí zrušte jen tehdy, pokud byla nula skutečná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor Version 1.2 wurde ein leerer Saldo als null geschrieben; deshalb ist dies sehr wahrscheinlich die erste echte Zählung des Geldes, und sie wird zum Ausgangspunkt. Wählen Sie es nur ab, wenn diese Null echt war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before 1.2 an empty balance was written as zero, so this is most likely the first real count of the money, and it becomes the starting point. Untick it only if that zero was real."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de la 1.2 un saldo vacío se anotaba como cero, así que lo más probable es que este sea el primer recuento real de ese dinero, y pasa a ser el punto de partida. Desmárquelo solo si ese cero era real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant la 1.2, un solde vide était noté comme zéro : c'est donc très probablement le premier comptage réel de cet argent, qui devient le point de départ. Ne la décochez que si ce zéro était réel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչև 1.2 տարբերակը դատարկ մնացորդը գրանցվում էր որպես զրո, ուստի սա, ամենայն հավանականությամբ, գումարի առաջին իրական հաշվարկն է և դառնում է ելակետ։ Հանեք նշումը միայն եթե այդ զրոն իրական էր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima della versione 1.2 un saldo vuoto veniva registrato come zero. Questo è quindi probabilmente il primo conteggio effettivo e diventa il punto di partenza. Deseleziona solo se lo zero era reale."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 ვერსიამდე ცარიელი ნაშთი ნულად იწერებოდა, ამიტომ ეს, სავარაუდოდ, ფულის პირველი რეალური დათვლაა და ის საწყის წერტილად იქცევა. გამორთეთ მხოლოდ მაშინ, თუ ნულოვანი ნაშთი რეალური იყო."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 нұсқасына дейін бос теңгерім нөл ретінде жазылатын, сондықтан бұл көбіне ақшаның алғашқы нақты санауы және ол бастапқы нүкте болады. Нөл нақты болса ғана белгіні алып тастаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 версиясына чейин бош калдык нөл катары жазылчу. Демек, бул акчанын биринчи чыныгы санаагы болушу мүмкүн жана ал баштапкы чекит болот. Нөл чыныгы болсо гана белгини алыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed wersją 1.2 brak salda zapisywano jako zero. To najpewniej pierwsze sprawdzenie stanu środków, które stanie się punktem początkowym. Odznacz tę opcję tylko wtedy, gdy saldo rzeczywiście wynosiło zero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes da versão 1.2, um saldo vazio era registrado como zero. Provavelmente, esta é a primeira contagem real do dinheiro e será o ponto de partida. Desmarque apenas se o saldo zero era real."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes da versão 1.2, um saldo vazio era registado como zero. Esta é provavelmente a primeira contagem real do dinheiro e passa a ser o ponto de partida. Desative apenas se o saldo zero era real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 1.2 пустое поле остатка записывалось нулём, поэтому это, скорее всего, первый настоящий пересчёт денег, и он станет точкой отсчёта. Снимите отметку, только если тот ноль был настоящим."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То версияи 1.2 бақияи холӣ ҳамчун сифр сабт мешуд. Эҳтимол ин ҳисобкунии аввалини воқеии пул аст ва он нуқтаи оғоз мешавад. Танҳо агар сифр воқеӣ буд, аломатро гиред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 sürümünden önce boş bakiye sıfır olarak kaydediliyordu. Bu nedenle bu büyük olasılıkla paranın ilk gerçek sayımıdır ve başlangıç noktası olur. Seçimi yalnızca sıfır bakiyesi gerçekse kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До версії 1.2 порожній залишок записувався як нуль, тож, найімовірніше, це перший справжній облік грошей, і він стає точкою відліку. Знімайте позначку, лише якщо той нуль був справжнім."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 versiyasidan oldin bo‘sh qoldiq nol deb yozilgan, shuning uchun bu, ehtimol, pulning birinchi haqiqiy sanovi va u boshlang‘ich nuqtaga aylanadi. Belgini faqat o‘sha nol haqiqiy bo‘lgan bo‘lsa olib tashlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 版之前，空白餘額會記為零，因此這很可能是首次實際盤點，將成為起始點。只有在零餘額確實正確時才取消勾選。"
          }
        }
      }
    },
    "reconcile.help": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əlinizdəki pulu uçotdakı məbləğlə müqayisə edin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Параўнайце наяўныя грошы з балансам паводле ўліку"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnejte skutečný stav peněz s evidencí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleichen Sie das Geld, das Sie haben, mit dem, was die Bücher erwarten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the money you have with what the books expect"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare el dinero que tiene con lo que esperan los registros"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparer l'argent que vous avez avec ce qu'attendent les comptes"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համեմատեք առկա գումարը հաշվառման սպասվող մնացորդի հետ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta il denaro che hai con il saldo previsto dai registri"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეადარეთ არსებული ფული აღრიცხვით მოსალოდნელ თანხას"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақшаңыз бен кітаптар күткен соманы салыстырыңыз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колуңуздагы акчаны эсептеги сумма менен салыштырыңыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównaj stan środków ze stanem według ewidencji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare o dinheiro que você tem com o saldo registrado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare o dinheiro que tem com o valor registado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнить деньги на руках с тем, что ожидает учёт"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули мавҷударо бо бақияи интизорӣ муқоиса кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elinizdeki parayı kayıtlardaki beklenen tutarla karşılaştırın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівняйте гроші, які у вас є, з тим, що очікують книги"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavjud pulni hisob bo‘yicha qoldiq bilan solishtiring"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將實際金額與帳面預期金額比較"
          }
        }
      }
    },
