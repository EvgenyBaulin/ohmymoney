    "scheduled.bindHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie the operation to this due date for good, as «Mark as paid» would"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une la operación a este vencimiento de forma definitiva, como haría «Marcar como pagado»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rattacher l'opération à cette échéance pour de bon, comme le ferait « Marquer comme payé »"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навсегда связать операцию с этим сроком, как это сделал бы «Провести»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назавжди прив'язати операцію до цього строку, як це зробила б «Позначити як сплачене»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega definitivamente l’operazione a questa scadenza, come con «Segna come pagato»"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцияны осы мерзімге тұрақты байланыстыру, «Төленді деп белгілеу» сияқты"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назаўсёды звязаць аперацыю з гэтым тэрмінам плацяжу, як пры выбары «Пазначыць як аплачанае»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Vorgang dauerhaft mit diesem Fälligkeitstermin verknüpfen, wie „Als bezahlt markieren“ es täte"
          }
        }
      }
    },
