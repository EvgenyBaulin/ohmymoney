          "stringUnit": {
            "state": "translated",
            "value": "Ein Feiertag oder ein Geburtstag mit Budget: Die Planung hält das Geld dafür zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A holiday or a birthday with a budget: Planning keeps its money back."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una festa o un compleanno con un budget: Pianificazione mette da parte la somma necessaria."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бюджеті бар демалыс немесе туған күн: Жоспарлау оның ақшасын бөліп ұстайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпуск или день рождения с бюджетом: «Планирование» придержит на него деньги."
          }
        }
      }
    },
