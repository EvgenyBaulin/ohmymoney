    "reminders.overdue.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until a due date is closed, the free sum counts its money as still on the account. If the bank took it before the reconciliation, press «Taken before the reconciliation»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que un vencimiento se cierre, la suma libre cuenta su dinero como todavía en la cuenta. Si el banco lo cobró antes de la conciliación, pulse «Cobrado antes de la conciliación»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant qu'une échéance n'est pas clôturée, la somme libre compte son argent comme encore sur le compte. Si la banque l'a prélevé avant le rapprochement, appuyez sur « Prélevé avant le rapprochement »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока срок не закрыт, свободная сумма считает, что деньги ещё не ушли. Если банк списал их до сверки, нажмите «Уже списано до сверки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доки строк платежу не закрито, вільна сума рахує його гроші як ще на рахунку. Якщо банк списав їх до звірки, натисніть «Списано до звірки»."
          }
        }
      }
    },
