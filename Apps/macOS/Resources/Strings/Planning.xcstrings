    "planning.dueBeforeCount.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödənişin vaxtı %@ idi. «Bəli» — əməliyyat tutuşdurmadan əvvəlki ödəniş tarixi ilə qeydə alınır: məbləğ artıq tutuşdurulmuş balansdadır. «Xeyr» — əməliyyat indiki tarixlə qeydə alınır və balansı azaldır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэрмін плацяжу быў %@. «Так» — аперацыя будзе датавана тэрмінам плацяжу, да зверкі: грошы ўжо ўлічаны ў зверным балансе. «Не» — аперацыя будзе датавана сённяшнім днём і паменшыць баланс."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Splatnost byla %@. «Ano» — operace bude datována ke dni splatnosti před kontrolou zůstatku a částka je již v něm zahrnuta. «Ne» — operace bude datována dneškem a sníží zůstatek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war fällig am %@. „Ja“ — der Vorgang ist auf den Fälligkeitstag datiert, vor dem Abgleich: Sein Geld steckt bereits im abgeglichenen Saldo. „Nein“ — er ist auf heute datiert und senkt den Saldo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was due %@. «Yes» — the operation is dated on the due date, before the reconciliation: its money is already in the reconciled balance. «No» — it is dated now and lowers the balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vencía el %@. «Sí» — la operación se fecha en el día de vencimiento, antes de la conciliación: su dinero ya está en el saldo conciliado. «No» — se fecha hoy y baja el saldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il était dû le %@. « Oui » — l'opération est datée de l'échéance, avant le rapprochement : son argent est déjà dans le solde rapproché. « Non » — elle est datée d'aujourd'hui et fait baisser le solde."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարման ժամկետն էր %@։ «Այո»՝ գործարքը կգրանցվի վճարման օրը՝ մնացորդի ստուգումից առաջ․ գումարն արդեն հաշվառված է ստուգված մնացորդում։ «Ոչ»՝ գործարքը կգրանցվի այժմ և կնվազեցնի մնացորդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scadenza era il %@. «Sì» — l'operazione è datata alla scadenza, prima della riconciliazione: l'importo è già incluso nel saldo riconciliato. «No» — l'operazione è datata ora e riduce il saldo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადახდის თარიღი იყო %@. «დიახ» — ოპერაცია დათარიღდება გადახდის თარიღით, შეჯერებამდე: მისი თანხა უკვე ასახულია შეჯერებულ ნაშთში. «არა» — ოპერაცია დათარიღდება დღევანდელი დღით და შეამცირებს ნაშთს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзімі %@ болған. «Иә» — операция мерзім күніне жазылады, салыстырудан бұрын: оның ақшасы салыстырылған теңгерімде бар. «Жоқ» — ол қазір жазылады және теңгерімді азайтады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлөмдүн мөөнөтү %@ болгон. «Ооба» — операция төлөө мөөнөтү менен, салыштырууга чейин белгиленет: акча салыштырылган калдыкта эске алынган. «Жок» — операция азыркы күн менен белгиленип, калдыкты азайтат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Termin płatności: %@. «Tak» — operacja zostanie zapisana z datą terminu, przed uzgodnieniem salda. Jej kwota jest już uwzględniona w uzgodnionym saldzie. «Nie» — operacja zostanie zapisana z bieżącą datą i obniży saldo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vencimento foi em %@. «Sim» — a operação é registrada na data de vencimento, antes da conferência: o valor já está no saldo conferido. «Não» — ela é registrada agora e reduz o saldo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vencia em %@. «Sim» — a operação fica datada do vencimento, antes da reconciliação: o valor já está incluído no saldo reconciliado. «Não» — fica datada de agora e reduz o saldo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок был %@. «Да» — операция встанет в день срока, до сверки: её деньги уже в сверенном остатке. «Нет» — операция запишется сейчас и уменьшит остаток."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муҳлати пардохт %@ буд. «Ҳа» — амалиёт бо санаи пардохт, пеш аз муқоиса сабт мешавад: маблағаш аллакай дар бақияи муқоисашуда аст. «Не» — амалиёт бо санаи ҳозира сабт шуда, бақияро кам мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadesi %@ tarihindeydi. «Evet» — işlem, mutabakattan önceki vade tarihine kaydedilir; tutarı mutabık kalınan bakiyeye zaten dahildir. «Hayır» — işlem bugüne kaydedilir ve bakiyeyi azaltır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його мали сплатити %@. «Так» — операція датується днем платежу, до звірки: її гроші вже в звіреному залишку. «Ні» — вона датується зараз і зменшує залишок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘lov muddati %@ edi. «Ha» — operatsiya solishtirishdan oldingi to‘lov muddati sanasi bilan yoziladi: uning summasi solishtirilgan balansda allaqachon hisobga olingan. «Yo‘q» — operatsiya hozirgi sana bilan yoziladi va balansni kamaytiradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到期日為 %@。選擇「是」會將交易日期設為到期日，早於對帳時間；款項已計入對帳餘額。選擇「否」會將交易日期設為現在，並減少餘額。"
          }
        }
      }
    },
    "planning.dueBeforeCount.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» üçün pul %2$@ tarixində, %3$@ vaxtında aparılan tutuşdurmadan əvvəl çıxmışdı?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы за «%1$@» спісаліся да зверкі %2$@ а %3$@?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešly peníze za «%1$@» před kontrolou zůstatku %2$@ na účtu %3$@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das Geld für „%1$@“ vor dem Abgleich vom %2$@ am %3$@ abgegangen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the money for «%1$@» leave before the reconciliation of %2$@ at %3$@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Salió el dinero de «%1$@» antes de la conciliación del %2$@ a las %3$@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent de « %1$@ » est-il parti avant le rapprochement du %2$@ à %3$@ ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» վճարման գումարը դուրս եկե՞լ է մինչև %2$@-ի մնացորդի ստուգումը՝ %3$@-ին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro per «%1$@» è uscito prima della riconciliazione del %2$@ alle %3$@?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩამოიჭრა თუ არა «%1$@»-ის თანხა %2$@-ის %3$@-ზე შეჯერებამდე?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» үшін ақша %2$@ салыстыруынан бұрын, %3$@ кетті ме?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» үчүн акча %2$@ күнкү, саат %3$@ болгон салыштырууга чейин кеткенби?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy środki na «%1$@» wyszły przed uzgodnieniem salda %2$@ o %3$@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro de «%1$@» saiu antes da conferência de %2$@ às %3$@?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro de «%1$@» saiu antes da reconciliação de %2$@ às %3$@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги за «%1$@» ушли до сверки %2$@ в %3$@?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оё маблағи «%1$@» пеш аз муқоисаи %2$@ соати %3$@ аз ҳисоб баромада буд?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» için para, %2$@ tarihinde saat %3$@ itibarıyla yapılan mutabakattan önce mi çıktı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи пішли гроші за «%1$@» до звірки %2$@ о %3$@?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» uchun pul %2$@ kuni %3$@ da solishtirishdan oldin yechilganmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」的款項是否在 %2$@ %3$@ 對帳前已支出？"
          }
        }
      }
    },
