      }
    },
    "reconcile.firstCountToggleHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor Version 1.2 wurde ein leerer Saldo als null geschrieben; deshalb ist dies sehr wahrscheinlich die erste echte Zählung des Geldes, und sie wird zum Ausgangspunkt. Wählen Sie es nur ab, wenn diese Null echt war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before 1.2 an empty balance was written as zero, so this is most likely the first real count of the money, and it becomes the starting point. Untick it only if that zero was real."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 нұсқасына дейін бос теңгерім нөл ретінде жазылатын, сондықтан бұл көбіне ақшаның алғашқы нақты санауы және ол бастапқы нүкте болады. Нөл нақты болса ғана белгіні алып тастаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 1.2 пустое поле остатка записывалось нулём, поэтому это, скорее всего, первый настоящий пересчёт денег, и он станет точкой отсчёта. Снимите отметку, только если тот ноль был настоящим."
          }
        }
      }
    },
