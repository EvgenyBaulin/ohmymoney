    "reconcile.firstCount.total": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one-total count of %1$@ recorded %2$@ with no count before it. If that was the first time you counted the money, it is neither income nor spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recuento de un solo total de %1$@ registrado el %2$@ sin ningún recuento antes. Si era la primera vez que contaba ese dinero, no es ni ingreso ni gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le comptage d'un seul total de %1$@ noté le %2$@, sans comptage avant. Si c'était la première fois que vous comptiez cet argent, il n'est ni revenu ni dépense."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверка одной суммой %1$@ записала %2$@, а до неё сверок не было. Если это был первый пересчёт денег, это не доход и не расход."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумковий облік %1$@ записав %2$@ без жодного обліку перед ним. Якщо це був перший раз, коли ви порахували гроші, це не дохід і не витрата."
          }
        }
      }
    },
