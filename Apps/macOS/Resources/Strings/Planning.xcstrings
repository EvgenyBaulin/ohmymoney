    "namesake.noHistory": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ əlaqəli tarixçə yoxdur. Arxivdəki qeyd üçün başqa ad seçə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Звязанай гісторыі пакуль няма. Можна выбраць іншую назву для архіўнага запісу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádná související historie. Archivovanému záznamu můžete zvolit jiný název."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein verknüpfter Verlauf. Du kannst einen anderen Namen für den archivierten Eintrag wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No linked history yet. You can choose a different name for the archived record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay historial vinculado. Puedes elegir otro nombre para el registro archivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun historique associé pour le moment. Vous pouvez choisir un autre nom pour l’entrée archivée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կապակցված պատմություն դեռ չկա։ Կարող եք այլ անուն ընտրել արխիվացված գրառման համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna cronologia collegata. Puoi scegliere un altro nome per la voce archiviata."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაკავშირებული ისტორია ჯერ არ არის. შეგიძლიათ არქივში არსებული ჩანაწერისთვის სხვა სახელი აირჩიოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Байланыстырылған тарих әлі жоқ. Мұрағаттағы жазбаға басқа атау таңдауға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Байланышкан тарых азырынча жок. Архивдеги жазууга башка ат тандасаңыз болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak powiązanej historii. Możesz zmienić nazwę wpisu w archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há histórico associado. Você pode escolher outro nome para o registro arquivado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não existe histórico associado. Pode escolher outro nome para o registo arquivado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связанной истории пока нет. Для архивной записи можно выбрать другое имя."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло таърихи алоқаманд нест. Метавонед барои сабти бойгонӣ номи дигар интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bağlantılı bir geçmiş yok. Arşivlenmiş kayıt için başka bir ad seçebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пов’язаної історії ще немає. Можна вибрати іншу назву для архівного запису."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali bog‘langan tarix yo‘q. Arxivdagi yozuv uchun boshqa nom tanlashingiz mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無關聯記錄。你可以為封存的記錄選擇其他名稱。"
          }
        }
      }
    },
