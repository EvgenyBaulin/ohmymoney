    "form.expected.termHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы паступаюць і ў іншы дзень месяца — напрыклад, 15-га і ў апошні дзень. Кожнае паступленне лічыцца асобным даходам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld kommt auch an einem anderen Tag des Monats — zum Beispiel am 15. und am letzten Tag: Jeder Termin ist eine eigene Einnahme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money comes on another day of the month too — for example on the 15th and on the last day: each term is an income of its own"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro arriva anche in un altro giorno del mese, per esempio il 15 e l’ultimo giorno: ogni scadenza è un reddito a sé"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша айдың басқа күнінде де келеді — мысалы 15-інде және айдың соңғы күнінде: әр мерзім өз алдына табыс"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги приходят и в другой день месяца — например 15-го и в последний день: каждый срок — отдельное поступление"
          }
        }
      }
    },
