    "reconcile.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first count of an account in a currency is its starting point: there is nothing to compare it with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer recuento de una cuenta en una divisa es su punto de partida: no hay con qué compararlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier comptage d'un compte dans une devise est son point de départ : il n'y a rien à comparer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая сверка счёта в валюте — точка отсчёта: сравнивать не с чем."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перша звірка рахунку в валюті — це точка відліку: порівнювати її ні з чим."
          }
        }
      }
    },
    "reconcile.firstCount.card": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The count of %1$@ recorded %2$@ on «%3$@», while before it the account had only a zero opening balance. If that was the first time you counted the money, it is neither income nor spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recuento de %1$@ registrado el %2$@ en «%3$@», mientras antes la cuenta solo tenía un saldo inicial de cero. Si era la primera vez que contaba ese dinero, no es ni ingreso ni gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le comptage de %1$@ noté le %2$@ sur « %3$@ », alors que jusque-là le compte n'avait qu'un solde d'ouverture nul. Si c'était la première fois que vous comptiez cet argent, il n'est ni revenu ni dépense."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверка %1$@ записала %2$@ на «%3$@», хотя до неё у счёта был только нулевой начальный остаток. Если тогда вы впервые пересчитали деньги, это не доход и не расход."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Облік %1$@ записав %2$@ на «%3$@», тоді як раніше на рахунку був лише нульовий початковий залишок. Якщо це був перший раз, коли ви порахували гроші, це не дохід і не витрата."
          }
        }
      }
    },
    "reconcile.firstCount.fix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
