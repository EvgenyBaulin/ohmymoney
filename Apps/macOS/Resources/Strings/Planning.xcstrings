    "form.rateMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted: type the rate in the «Rate» field above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular: escriba el tipo en el campo «Tipo» de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés : saisissez le taux dans le champ « Taux » ci-dessus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать: введите курс в поле «Курс» выше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати: введіть курс у полі «Курс» вище."
          }
        }
      }
    },
    "form.rateMissing.debt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. It loads from the Bank of Russia once the Mac is online — or enter the payment in the entry line with the rate in its ↓ panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular. Se carga del Banco de Rusia cuando el Mac tenga conexión — o introduzca el pago en la línea de entrada con el tipo en su panel ↓."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés. Il se charge auprès de la Banque de Russie dès que le Mac est en ligne — ou saisissez le paiement dans la ligne de saisie avec le taux dans son panneau ↓."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Он подгрузится из ЦБ, когда будет сеть, — или запишите платёж строкой ввода, указав курс в панели ↓."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати. Він завантажиться з Банку Росії, щойно Mac буде онлайн, — або введіть платіж у рядку вводу з курсом на його панелі ↓."
          }
        }
      }
    },
    "form.rateMissing.goal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. It loads from the Bank of Russia once the Mac is online — or pick another currency or date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipo de %@ para este día, así que los rublos no se pueden calcular. Se carga del Banco de Rusia cuando el Mac tenga conexión — o elija otra divisa o fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de taux %@ pour ce jour, donc les roubles ne peuvent pas être calculés. Il se charge auprès de la Banque de Russie dès que le Mac est en ligne — ou choisissez une autre devise ou date."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курса %@ на этот день ещё нет, и рубли не посчитать. Он подгрузится из ЦБ, когда будет сеть, — или выберите другую валюту или дату."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день курсу %@ ще немає, тож рублі не порахувати. Він завантажиться з Банку Росії, щойно Mac буде онлайн, — або оберіть іншу валюту чи дату."
          }
        }
      }
    },
    "form.rateMissing.reminder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no %@ rate for this day yet, so the rubles cannot be counted. Mark it as paid from Planning — the rate can be typed by hand there."
