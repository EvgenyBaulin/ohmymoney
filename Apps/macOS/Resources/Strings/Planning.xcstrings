    "form.limit.rolloverHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni məbləğ təyin edildikdə və ya qalıq köçürülməsi aktiv edildikdə, köçürmə bu aydan yenidən başlayır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры змене сумы або ўключэнні пераносу назапашванне пачынаецца зноў у гэтым месяцы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nová částka nebo zapnutí převodu zůstatku zahájí převádění znovu od tohoto měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Betrag oder eingeschaltetes Übertragen beginnt die Übertragung in diesem Monat neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new amount, or carrying over switched on, starts the carry again this month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un importe nuevo, o activar el traspaso, vuelve a empezar el traspaso este mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau montant, ou le report activé, relance le report dès ce mois-ci."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նոր գումար սահմանելու կամ մնացորդի փոխանցումը միացնելու դեպքում փոխանցումը վերսկսվում է այս ամսից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo importo o l’attivazione del riporto fa ripartire il conteggio da questo mese."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალი თანხის მითითებისას ან ნაშთის გადატანის ჩართვისას გადატანა ამ თვიდან თავიდან იწყება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа сома немесе көшіру қосылса, көшіру осы айда қайта басталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумманы өзгөртүү же калдыкты өткөрүүнү күйгүзүү ушул айдан тартып эсептөөнү кайра баштайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa kwota lub włączenie przenoszenia rozpoczyna naliczanie od nowa w tym miesiącu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo valor ou a ativação do acúmulo reinicia o saldo acumulado neste mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo montante ou a ativação da transição reinicia o saldo transitado neste mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая сумма, как и включённый перенос, начинает перенос остатка заново с этого месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи нав ё фаъол кардани гузаронидани бақия ҳисобро аз ҳамин моҳ аз нав оғоз мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir tutar belirlendiğinde veya devir açıldığında, devir bu ay yeniden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нова сума або увімкнене перенесення починають перенесення знову цього місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi summa belgilansa yoki qoldiqni o‘tkazish yoqilsa, hisoblash shu oydan yangidan boshlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定新金額或開啟結轉後，將從本月重新開始結轉。"
          }
        }
      }
    },
