    "form.event.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödəniş tədbirin büdcəsinə daxildir: sərbəst məbləğdən ayrıca çıxılmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж уваходзіць у бюджэт падзеі: з вольнай сумы ён асобна не адымаецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba je součástí rozpočtu události: od volné částky se samostatně neodečítá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung gehört zum Budget des Ereignisses: Der freie Betrag zieht sie nicht gesondert ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment is part of the event's budget: the free sum does not take it off separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago forma parte del presupuesto del evento: la suma libre no lo descuenta por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement fait partie du budget de l'événement : la somme libre ne le retire pas à part."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարումը միջոցառման բյուջեի մաս է․ այն ազատ գումարից առանձին չի հանվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento fa parte del budget dell’evento: non viene sottratto separatamente dalla somma disponibile."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადახდა მოვლენის ბიუჯეტის ნაწილია: თავისუფალ თანხას ის ცალკე არ აკლდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлем іс-шара бюджетінің бөлігі: бос қаржыдан бөлек шегерілмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлөм окуянын бюджетине кирет: бош суммадан өзүнчө алынбайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność należy do budżetu wydarzenia: nie jest ponownie odejmowana od wolnej kwoty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento faz parte do orçamento do evento e não é descontado separadamente do saldo livre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento faz parte do orçamento do evento e não é descontado separadamente do montante disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёж войдёт в бюджет события: свободная сумма не вычтет его отдельно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пардохт қисми буҷети чорабинӣ аст: аз маблағи озод алоҳида тарҳ намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme etkinlik bütçesine dahildir; serbest tutardan ayrıca düşülmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж входить до бюджету події: вільна сума окремо його не віднімає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘lov tadbir byudjetiga kiradi: u erkin summadan alohida ayirilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此付款屬於活動預算，可用金額不會另行扣除。"
          }
        }
      }
    },
