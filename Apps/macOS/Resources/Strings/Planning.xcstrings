    "layout.empty.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit says how much a category may take in a month, and warns when it runs out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un límite indica cuánto puede gastar una categoría en un mes, y avisa cuando se agota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plafond indique combien une catégorie peut prendre par mois, et prévient quand il s'épuise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит говорит, сколько категория может забрать за месяц, и предупреждает, когда он кончается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт показує, скільки категорія може взяти за місяць, і попереджає, коли він закінчується."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un limite indica quanto puoi spendere in una categoria ogni mese e ti avvisa quando lo raggiungi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит санат айына қанша ала алатынын айтады және оған жеткенде ескертеді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт вызначае месячныя выдаткі на катэгорыю і папярэджвае, калі ён заканчваецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Limit sagt, wie viel eine Kategorie im Monat ausgeben darf, und warnt, wenn es aufgebraucht ist."
          }
        }
      }
    },
