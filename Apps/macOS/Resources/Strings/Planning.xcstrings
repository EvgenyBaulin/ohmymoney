    "form.goal.planHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "План пачынаецца ў %@. Усё, што звыш месячнага плана, залічваецца ў наступныя месяцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan beginnt im %@. Was über den Monatsplan hinaus eingelegt wird, zählt für die folgenden Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan starts in %@. What goes in above a month's plan counts towards the following months."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano inizia a %@. Gli importi che superano il piano mensile valgono per i mesi successivi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоспар %@ басталады. Айлық жоспардан артық салынғаны келесі айларға есептеледі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начало плана — %@. Внесённое сверх плана месяца засчитывается в следующие месяцы."
          }
        }
      }
    },
