    "expected.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income already received stays; only the expectation and its links go. ⌘Z brings them back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полученные доходы останутся, удалится только ожидание и привязки к нему. ⌘Z вернёт их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід, який уже надійшов, лишається; видаляються лише очікування та їхні зв'язки. ⌘Z їх повертає."
          }
        }
      }
