          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入限額"
          }
        }
      }
    },
    "layout.empty.payments": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirayə, telefon, internet — bir dəfə əlavə edin, Planlaşdırma tarixləri izləsin və məbləğləri sərbəst vəsaitdən çıxsın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Арэнда, тэлефон, інтэрнэт — дадайце іх адзін раз, і Планаванне ўлічыць даты і адніме сумы ад свабодных грошай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nájem, telefon, internet — přidejte je jednou a Plánování pohlídá termíny a odečte je od volných peněz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miete, Telefon, Internet — tragen Sie sie einmal ein, und die Planung behält ihre Termine und zieht sie vom freien Betrag ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent, phone, internet — add them once, and Planning keeps their dates and takes them off the free sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alquiler, teléfono, internet — añádalos una vez, y Planificación guarda sus fechas y los descuenta de la suma libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loyer, téléphone, internet — ajoutez-les une fois : la Planification garde leurs dates et les retire de la somme libre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վարձ, հեռախոս, ինտերնետ․ ավելացրեք մեկ անգամ, և Պլանավորումը կհիշի ժամկետները ու կհաներ դրանք ազատ գումարից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affitto, telefono, internet: aggiungili una volta e Pianificazione ne tiene traccia e li sottrae dalla somma disponibile."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ქირა, ტელეფონი, ინტერნეტი — დაამატეთ ერთხელ და დაგეგმვა დაიმახსოვრებს თარიღებს და თანხებს თავისუფალ ნაშთს გამოაკლებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пәтер, телефон, интернет — бір рет қосыңыз, Жоспарлау олардың күндерін сақтап, бос қаржыдан шегереді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ижара, телефон, интернет — аларды бир жолу кошуңуз, Пландоо мөөнөттөрүн сактап, суммасын бош акчадан кемитет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czynsz, telefon, internet — dodaj je raz, a Planowanie przypilnuje terminów i odliczy je od dostępnej kwoty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aluguel, telefone, internet — adicione uma vez e o Planejamento acompanha as datas e desconta os valores do saldo livre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Renda, telefone, internet — adicione-os uma vez e o Planeamento guarda as datas e desconta-os do valor disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аренда, телефон, интернет — добавьте их один раз, и «Планирование» будет помнить сроки и вычитать их из свободной суммы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Иҷора, телефон, интернет — онҳоро як бор илова кунед ва Банақшагирӣ санаҳояшонро нигоҳ дошта, маблағашонро аз маблағи озод кам мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kira, telefon, internet: bir kez ekleyin; Planlama tarihlerini takip edip tutarlarını harcanabilir paradan düşsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оренда, телефон, інтернет — додайте їх один раз, і «Планування» триматиме їхні дати та віднімати їх від вільної суми."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ijara, telefon, internet — ularni bir marta qo‘shing, Rejalashtirish sanalarini saqlaydi va bo‘sh summadan ayiradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "房租、電話、網路費用只需加入一次，規劃會記住付款日期，並從可用金額中扣除。"
          }
        }
      }
    },
