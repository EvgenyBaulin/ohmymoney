    "planning.dueBeforeCount.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war fällig am %@. „Ja“ — der Vorgang ist auf den Fälligkeitstag datiert, vor dem Abgleich: Sein Geld steckt bereits im abgeglichenen Saldo. „Nein“ — er ist auf heute datiert und senkt den Saldo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was due %@. «Yes» — the operation is dated on the due date, before the reconciliation: its money is already in the reconciled balance. «No» — it is dated now and lowers the balance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок был %@. «Да» — операция встанет в день срока, до сверки: её деньги уже в сверенном остатке. «Нет» — операция запишется сейчас и уменьшит остаток."
          }
        }
      }
    },
    "planning.dueBeforeCount.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das Geld für „%1$@“ vor dem Abgleich vom %2$@ am %3$@ abgegangen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the money for «%1$@» leave before the reconciliation of %2$@ at %3$@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги за «%1$@» ушли до сверки %2$@ в %3$@?"
          }
        }
      }
    },
