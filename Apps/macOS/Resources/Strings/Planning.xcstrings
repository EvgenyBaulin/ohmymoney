    "reconcile.first": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Першы падлік рахунку ў валюце становіцца пачатковым балансам: параўноўваць яго няма з чым."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Zählung eines Kontos in einer Währung ist sein Ausgangspunkt: Es gibt nichts, womit man sie vergleichen könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first count of an account in a currency is its starting point: there is nothing to compare it with."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo conteggio di un conto in una valuta è il suo punto di partenza: non c'è nulla con cui confrontarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Валютадағы есеп-шоттың алғашқы санауы — оның бастапқы нүктесі: салыстыратын ештеңе жоқ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая сверка счёта в валюте — точка отсчёта: сравнивать не с чем."
          }
        }
      }
    },
    "reconcile.firstCount.card": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падчас падліку %2$@ на рахунку «%3$@» запісана %1$@, а да гэтага на рахунку быў толькі нулявы пачатковы баланс. Калі гэта быў першы падлік грошай, сума не з'яўляецца ні даходам, ні расходам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zählung von %1$@ hat %2$@ auf „%3$@“ erfasst, während das Konto vorher nur einen Anfangssaldo von null hatte. Wenn Sie das Geld zum ersten Mal gezählt haben, ist es weder Einnahme noch Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The count of %1$@ recorded %2$@ on «%3$@», while before it the account had only a zero opening balance. If that was the first time you counted the money, it is neither income nor spending."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conteggio di %1$@ ha registrato %2$@ su «%3$@», mentre prima il conto aveva solo un saldo iniziale pari a zero. Se era la prima volta che contavi il denaro, non è né un'entrata né una spesa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ санауы «%3$@» есеп-шотында %2$@ жазды, ал бұрын онда тек нөлдік бастапқы теңгерім болған. Бұл ақшаны алғаш рет санаған болсаңыз, ол табыс та, шығын да емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверка %1$@ записала %2$@ на «%3$@», хотя до неё у счёта был только нулевой начальный остаток. Если тогда вы впервые пересчитали деньги, это не доход и не расход."
          }
        }
      }
    },
    "reconcile.firstCount.fix": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта быў першы падлік — зрабіць яго пачатковым балансам"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war die erste Zählung — machen Sie sie zum Ausgangspunkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was the first count — make it the starting point"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Era il primo conteggio — usa come punto di partenza"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл алғашқы санау болды — оны бастапқы нүкте етіңіз"
          }
