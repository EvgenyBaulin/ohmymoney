    "form.goal.transfers.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры размеркаванні даходу ўнёсак і перавод на гэты рахунак робяцца разам. Перавод можна выключыць у форме."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Einnahme verteilt wird: der Beitrag und eine Überweisung auf dieses Konto in einem Schritt; das Blatt kann es abwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an income is allocated: the contribution and a transfer to this account, one step; the sheet can untick it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando assegni un reddito, il contributo e il trasferimento su questo conto avvengono insieme; puoi deselezionare l’opzione nel pannello."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табыс бөлінгенде: салым және осы есеп-шотқа аударым бір қадамда; парақта оны алып тастауға болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При распределении дохода — взнос и перевод на этот счёт одним шагом; в листе галочку можно снять."
          }
        }
      }
    },
