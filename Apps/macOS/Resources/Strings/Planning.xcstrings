    "limits.suggest.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç tam ayın ən azı ikisində xərc etdiyiniz, limiti olmayan kateqoriyalar. Məbləğ adi aylıq xərc əsasında yuxarı yuvarlaqlaşdırılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыі без ліміту, у якіх былі выдаткі як мінімум за два з апошніх трох поўных месяцаў. Сума адпавядае звычайным месячным выдаткам, акругленым уверх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie bez limitu, ve kterých jste utráceli alespoň ve dvou z posledních tří celých měsíců. Částka odpovídá běžnému měsíci a je zaokrouhlena nahoru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien ohne Limit, in denen Sie in mindestens zwei der letzten drei vollen Monate ausgegeben haben. Der Betrag ist ein üblicher Monat davon, aufgerundet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories without a limit that you spent on in at least two of the last three full months. The amount is a usual month of them, rounded up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorías sin límite en las que gastó en al menos dos de los últimos tres meses completos. El importe es un mes habitual de ellas, redondeado al alza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catégories sans plafond sur lesquelles vous avez dépensé dans au moins deux des trois derniers mois complets. Le montant est un mois habituel d'entre elles, arrondi au supérieur."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց սահմանաչափի կատեգորիաներ, որոնց վրա ծախսել եք վերջին երեք ամբողջական ամիսներից առնվազն երկուսում։ Գումարը սովորական ամսվա ծախսն է՝ կլորացված դեպի վեր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorie senza limite con spese in almeno due degli ultimi tre mesi completi. L’importo è la spesa mensile abituale, arrotondata per eccesso."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორიები ლიმიტის გარეშე, რომლებშიც ბოლო სამი სრული თვიდან სულ მცირე ორში დახარჯეთ თანხა. თანხა მათი ჩვეულებრივი თვის ხარჯია, ზემოთ დამრგვალებული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы үш толық айдың кемінде екеуінде шығын болған, лимиті жоқ санаттар. Сома — олардың әдеттегі айы, жоғары дөңгелектенген."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы үч толук айдын кеминде экөөндө чыгым болгон, лимити жок категориялар. Сумма адаттагы айлык чыгымга негизделип, жогору тегеректелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie bez limitu, w których wydatki pojawiły się w co najmniej dwóch z ostatnich trzech pełnych miesięcy. Kwota to typowy miesięczny wydatek, zaokrąglony w górę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorias sem limite nas quais você gastou em pelo menos dois dos últimos três meses completos. O valor corresponde a um mês típico, arredondado para cima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorias sem limite com despesas em pelo menos dois dos últimos três meses completos. O valor corresponde a um mês habitual, arredondado por excesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории без лимита, на которые вы тратили хотя бы в двух из трёх последних полных месяцев. Сумма — обычный месяц, округлённый вверх."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияҳои бемаҳдудияте, ки дар камаш ду моҳи се моҳи пурраи охир ба онҳо хароҷот шудааст. Маблағ хароҷоти як моҳи маъмулист, ки ба боло яклухт шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç tam ayın en az ikisinde harcama yaptığınız, limiti olmayan kategoriler. Tutar, bu kategorilerdeki olağan aylık harcamanın yukarı yuvarlanmış hâlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорії без ліміту, на які витрачали принаймні в двох із останніх трьох повних місяців. Сума — звичайний місяць для них, округлений вгору."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi uch to‘liq oyning kamida ikkitasida xarajat qilingan, limiti yo‘q turkumlar. Summa odatdagi oylik xarajatdan yuqoriga yaxlitlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去三個完整月份中，至少有兩個月有支出且尚未設定限額的類別。金額依一般月份的支出向上取整。"
          }
        }
      }
    },
