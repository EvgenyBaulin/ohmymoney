      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the due date without an operation: the money left before the reconciliation of %@, and its balance already holds that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra el vencimiento sin operación: el dinero salió antes de la conciliación del %@, y su saldo ya lo contiene."
