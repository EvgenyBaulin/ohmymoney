    "form.accountArchived": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» hesabı arxivləşdirilib — başqa hesab seçin, əks halda ödəniş əsas hesabdan çıxılacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак «%@» у архіве — выберыце іншы, інакш плацёж будзе спісаны з асноўнага рахунку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet «%@» je archivován — vyberte jiný, jinak se platba odečte z hlavního účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto „%@“ ist archiviert — wählen Sie ein anderes, sonst wird die Zahlung vom Hauptkonto abgebucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account «%@» is archived — pick another, or the payment is taken from the main account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta «%@» está archivada — elija otra, o el pago sale de la cuenta principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte « %@ » est aux archives — choisissez-en un autre, ou le paiement sera prélevé sur le compte principal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» հաշիվն արխիվացված է․ ընտրեք այլ հաշիվ, հակառակ դեպքում վճարումը կկատարվի հիմնական հաշվից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto «%@» è archiviato: scegline un altro oppure il pagamento verrà prelevato dal conto principale."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიში «%@» არქივშია — აირჩიეთ სხვა, ან გადახდა ძირითადი ანგარიშიდან ჩამოიჭრება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” есеп-шоты мұрағатта — басқасын таңдаңыз, әйтпесе төлем негізгі есеп-шоттан алынады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» эсеби архивде — башкасын тандаңыз, болбосо төлөм негизги эсептен алынат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto «%@» jest zarchiwizowane — wybierz inne. W przeciwnym razie płatność zostanie pobrana z konta głównego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta «%@» está arquivada. Escolha outra ou o pagamento será debitado da conta principal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta «%@» está arquivada — escolha outra, caso contrário o pagamento será feito a partir da conta principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт «%@» в архиве — выберите другой, иначе платёж спишется с основного."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби «%@» дар бойгонӣ аст — ҳисоби дигарро интихоб кунед, вагарна пардохт аз ҳисоби асосӣ гирифта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» hesabı arşivlenmiş. Başka bir hesap seçin; yoksa ödeme ana hesaptan alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок «%@» в архіві — оберіть інший, або платіж списується з основного рахунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» hisobi arxivlangan — boshqasini tanlang yoki to‘lov asosiy hisobdan olinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶 «%@» 已封存，請選擇其他帳戶，否則將從主要帳戶付款。"
          }
        }
      }
    },
