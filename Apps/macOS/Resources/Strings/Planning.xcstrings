    "limits.suggest.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts vorzuschlagen: Jede Kategorie, in der Sie in den letzten drei Monaten ausgegeben haben, hat schon ein Limit, oder es gibt noch zu wenig Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to suggest: every category spent on in the last three months already has a limit, or there is too little history yet."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұсынатын ештеңе жоқ: соңғы үш айда шығын болған әр санатта лимит бар, не тарих әлі аз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить нечего: у всех категорий с тратами за последние три месяца уже есть лимит, или истории пока мало."
          }
        }
      }
    },
    "limits.suggest.open": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits vorschlagen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest Limits…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимиттерді ұсыну…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить лимиты…"
          }
        }
      }
    },
    "limits.suggest.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien ohne Limit, in denen Sie in mindestens zwei der letzten drei vollen Monate ausgegeben haben. Der Betrag ist ein üblicher Monat davon, aufgerundet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories without a limit that you spent on in at least two of the last three full months. The amount is a usual month of them, rounded up."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы үш толық айдың кемінде екеуінде шығын болған, лимиті жоқ санаттар. Сома — олардың әдеттегі айы, жоғары дөңгелектенген."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории без лимита, на которые вы тратили хотя бы в двух из трёх последних полных месяцев. Сумма — обычный месяц, округлённый вверх."
          }
        }
      }
    },
    "limits.suggest.title": {
