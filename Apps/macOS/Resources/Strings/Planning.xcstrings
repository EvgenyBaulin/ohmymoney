    "layout.empty.goals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving for a trip or a new laptop? A goal counts how much to put aside a month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ahorra para un viaje o un portátil nuevo? Un objetivo calcula cuánto apartar al mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous épargnez pour un voyage ou un nouvel ordinateur ? Un objectif calcule ce qu'il faut mettre de côté par mois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копите на поездку или новый ноутбук? Цель посчитает, сколько откладывать в месяц."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладаєте на поїздку чи новий ноутбук? Ціль покаже, скільки відкладати на місяць."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmi per un viaggio o un nuovo portatile? Un obiettivo calcola quanto mettere da parte ogni mese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саяхатқа немесе жаңа ноутбукке жинап жүрсіз бе? Мақсат айына қанша бөлу керектігін есептейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкладваеце на падарожжа або новы ноўтбук? Мэта падкажа, колькі адкладаць штомесяц."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparen für eine Reise oder einen neuen Laptop? Ein Ziel zeigt, wie viel Sie im Monat beiseitelegen sollten."
          }
        }
      }
    },
