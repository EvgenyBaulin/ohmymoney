            "value": "That is not an amount"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es un importe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un montant"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա գումար չէ"
          }
        },
        "it": {
          "stringUnit": {
