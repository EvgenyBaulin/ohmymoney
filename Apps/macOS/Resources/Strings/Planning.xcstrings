    "reconcile.notRecorded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The difference could not be recorded, so the reconciliation was not saved. Try again, or save it without recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La diferencia no se pudo registrar, así que la conciliación no se guardó. Inténtelo de nuevo, o guárdela sin registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écart n'a pas pu être noté, donc le rapprochement n'a pas été enregistré. Réessayez, ou enregistrez-le sans noter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу записать не удалось, и сверка не сохранена. Попробуйте ещё раз или сохраните её без записи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різницю не вдалося записати, тож звірку не збережено. Спробуйте ще раз або збережіть без запису."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare la differenza. La riconciliazione non è stata salvata. Riprova o salva senza registrare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айырманы жазу мүмкін болмады, сондықтан салыстыру сақталмады. Қайталап көріңіз, не жазбай сақтаңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць розніцу, таму зверка не захавана. Паспрабуйце яшчэ раз або захавайце без запісу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Differenz konnte nicht erfasst werden, daher wurde der Abgleich nicht gespeichert. Versuchen Sie es erneut oder sichern Sie ihn ohne Erfassen."
          }
        }
      }
    },
    "reconcile.notRecordedMark": {
