          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы «%@» мақсатын жою керек пе?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивдеги «%@» максаты өчүрүлсүнбү?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
