    "layout.summary.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until %1$@ the plans ask %2$@ more than there is"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta el %1$@ los planes piden %2$@ más de lo que hay"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'au %1$@, les plans demandent %2$@ de plus qu'il n'y a"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %1$@ на планы не хватает %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До %1$@ плани вимагають на %2$@ більше, ніж є"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino al %1$@ i piani richiedono %2$@ in più rispetto al disponibile"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ дейін жоспарлар бар нәрседен %2$@ көп сұрайды"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да %1$@ для планаў не хапае %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis %1$@ verlangen die Pläne %2$@ mehr, als da ist"
          }
        }
      }
    },
