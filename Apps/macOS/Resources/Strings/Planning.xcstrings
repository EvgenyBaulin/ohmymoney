    "form.markAsPaid.forOther": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ qaytaracaq: bu məbləğ «Mənə borcludurlar» bölməsində gözləyir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ верне %@: гэтая частка чакае ў «Мне вінныя»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vrátí %@: tato část čeká v «Dluží mi»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zahlt %@ zurück: Dieser Teil wartet unter „Mir geschuldet“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gives back %@: that part waits in «Owed to me»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ devuelve %2$@: esa parte espera en «Me deben»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rend %@ : cette part attend dans « Me doivent »"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ը վերադարձնում է %@․ այդ մասը սպասում է «Ինձ պարտք են» բաժնում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restituisce %@: questa parte resta in «Mi devono»"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ აბრუნებს %@-ს: ეს ნაწილი დარჩება «ჩემთვის ვალი»-ში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ қайтарады: бұл бөлік «Маған берілген» ішінде күтеді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ кайтарат: бул бөлүк «Мага карыздар» бөлүмүндө күтөт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zwróci %@: ta część czeka w «Należne mi»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devolve %@: essa parte fica em «A receber»"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devolve %@: essa parte fica em «Devem-me»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вернёт %@: эта часть будет ждать в «Мне должны»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ бармегардонад: ин қисм дар «Аз дигарон» мемонад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ geri öder: bu tutar «Alacaklarım»da bekler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ повертає %2$@: ця частина чекає в «Винні мені»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ qaytaradi: bu qism «Menga qarzdor»da kutilmoqda"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會還款 %@：這部分會留在「應收款」"
          }
        }
      }
    },
