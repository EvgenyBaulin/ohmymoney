    "reconcile.nothingCounted": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль нічога не падлічана: увядзіце баланс хаця б аднаго рахунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist noch nichts gezählt: Tragen Sie den Saldo mindestens eines Kontos ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is counted yet: type the balance of at least one account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se cuenta nada: escriba el saldo de al menos una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore compté : saisissez le solde d'au moins un compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora inserito nulla: inserisci il saldo di almeno un conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге ештеңе санамадыңыз: кем дегенде бір есеп-шоттың теңгерімін теріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie sprawdzono jeszcze żadnego stanu: wpisz saldo co najmniej jednego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi contado ainda: digite o saldo de pelo menos uma conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не сосчитано: введите остаток хотя бы одного счёта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sayım yapılmadı: en az bir hesabın bakiyesini girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще нічого не порахувано: введіть залишок хоча б одного рахунку."
          }
        }
      }
    },
