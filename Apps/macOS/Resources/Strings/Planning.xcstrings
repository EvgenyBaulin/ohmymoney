    "selfEmployed.offer.later": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтае пытанне задаецца адзін раз: уключыць можна ў любы час у Наладах → Планаванне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wird einmal gefragt: Schalten Sie es jederzeit unter Einstellungen → Planung ein."
