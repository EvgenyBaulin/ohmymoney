    "layout.empty.expected": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaş, avans, dostunuzun qaytaracağı pul — gözlədiyiniz gəlirlər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарплата, аванс, грошы, якія верне сябар, — усё, што вы чакаеце."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výplata, záloha nebo peníze, které vám vrátí přítel — vše, na co čekáte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gehalt, ein Vorschuss, Geld, das ein Freund zurückgibt — worauf Sie warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A salary, an advance, money a friend returns — what you are waiting for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sueldo, un anticipo, dinero que devuelve un amigo — lo que está esperando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salaire, une avance, l'argent qu'un ami rend — ce que vous attendez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Աշխատավարձ, կանխավճար, ընկերոջ վերադարձելիք գումար՝ այն, ինչին սպասում եք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno stipendio, un anticipo, un rimborso da un amico: le entrate che aspetti."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხელფასი, ავანსი, მეგობრისგან დასაბრუნებელი ფული — რასაც ელოდებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалақы, аванс, досыңыз қайтаратын ақша — күткеніңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлык, аванс же досуңуз кайтара турган акча — сиз күтүп жаткан киреше."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensja, zaliczka lub zwrot pożyczki od znajomego — pieniądze, na które czekasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um salário, um adiantamento, dinheiro que um amigo vai devolver — o que você está esperando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um salário, um adiantamento ou dinheiro que um amigo vai devolver — o que espera receber."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарплата, аванс, деньги, которые вернёт друг, — то, чего вы ждёте."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маош, пешпардохт ё қарзе, ки дӯстатон бармегардонад — он чизе ки интизоред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaş, avans, bir arkadaşınızın geri ödeyeceği para: beklediğiniz gelirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарплата, аванс, гроші, які поверне друг, — те, на що ви чекаєте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maosh, avans, do‘stingiz qaytaradigan pul — kutayotgan daromadingiz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "薪水、預付款或朋友的還款，記下你預期收到的款項。"
          }
        }
      }
    },
    "layout.empty.expected.add": {
      "extractionState": "manual",
      "localizations": {
