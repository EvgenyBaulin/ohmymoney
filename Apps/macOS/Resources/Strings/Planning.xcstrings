            "value": "Registrar diferença"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать разницу"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farkı işle"
          }
        },
        "uk": {
          "stringUnit": {
