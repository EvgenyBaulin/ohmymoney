    "selfEmployed.offer.text": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, özünüməşğulluq gəlirinə bənzəyir. Tətbiq vergini hesablaya, ayın 28-də ödənişi xatırlada və onu sərbəst məbləğdən çıxa bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падобна на даход самазанятага. Праграма можа падлічваць падатак, нагадваць пра яго выплату 28-га чысла і не ўлічваць яго ў свабоднай суме."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypadá to jako příjem ze samostatné činnosti. Aplikace může vypočítat daň, připomenout její splatnost 28. dne a odečíst ji od volné částky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sieht nach Einnahmen eines Selbstständigen aus. Die App kann die Steuer berechnen, am 28. an ihren Fälligkeitstag erinnern und sie aus dem freien Betrag heraushalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like income of the self-employed. The app can count the tax, remind of its due day on the 28th and keep it out of the free sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece un ingreso de actividad propia. La app puede calcular el impuesto, recordar su día de pago el 28 y dejarlo fuera de la suma libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ressemble à des revenus d'indépendant. L'app peut calculer l'impôt, rappeler son échéance le 28 et le garder hors de la somme libre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա նման է ինքնազբաղվածի եկամտի։ Հավելվածը կարող է հաշվել հարկը, հիշեցնել վճարման մասին ամսի 28-ին և հանել այն ազատ գումարից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra un reddito da lavoro autonomo. L’app può calcolare l’imposta, ricordarti la scadenza del 28 ed escluderla dall’importo libero."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს თვითდასაქმებით მიღებულ შემოსავალს ჰგავს. აპს შეუძლია გადასახადის დათვლა, 28 რიცხვში გადახდის შეხსენება და მისი თავისუფალი თანხიდან გამოკლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл өзін-өзі жұмыспен қамтығандардың табысына ұқсайды. Қолданба салықты санай алады, оның мерзімі 28-і туралы еске салады және оны бос қаржыдан бөлек ұстайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул өз алдынча иштеген адамдын кирешесине окшойт. Колдонмо салыкты эсептеп, 28индеги төлөө мөөнөтүн эскертип, аны жеткиликтүү суммадан алып коё алат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że uzyskujesz dochód z samozatrudnienia. Aplikacja może obliczać podatek, przypominać o terminie płatności 28. dnia miesiąca i odliczać go od dostępnej kwoty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece ser renda de trabalho autônomo. O app pode calcular o imposto, lembrar do vencimento no dia 28 e descontá-lo do saldo livre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece ser rendimento de trabalho independente. A app pode calcular o imposto, lembrar o pagamento no dia 28 e excluí-lo do montante disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, у вас доход самозанятого. Приложение может считать налог НПД, напоминать о сроке 28-го числа и не считать налог свободными деньгами."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ба даромади худмашғулӣ монанд аст. Барнома метавонад андозро ҳисоб кунад, муҳлати пардохти онро дар рӯзи 28-ум ёдрас кунад ва онро аз маблағи озод ҷудо нигоҳ дорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, serbest çalışma geliri gibi görünüyor. Uygulama vergiyi hesaplayabilir, ayın 28’indeki son ödeme gününü hatırlatabilir ve vergiyi kullanılabilir tutardan düşebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже на дохід самозайнятих. Застосунок може порахувати податок, нагадати про його день — 28-го — і не враховувати його у вільній сумі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu o‘zini o‘zi band qilgan shaxs daromadiga o‘xshaydi. Ilova soliqni hisoblaydi, 28-kun to‘lovni eslatadi va uni erkin mablag‘dan ayiradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來是自僱收入。App 可以計算稅款、在每月 28 日提醒你繳稅，並將稅款從可用金額中扣除。"
          }
        }
      }
    },
