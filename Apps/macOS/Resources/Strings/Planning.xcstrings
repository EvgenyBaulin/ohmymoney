    "form.rateMissing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es noch keinen Kurs für %@, daher lassen sich die Rubel nicht berechnen: Tragen Sie den Kurs im Feld „Kurs“ oben ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
