    "reconcile.firstCountToggle.on": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс %@ становіцца пачатковым: без даходу і расходу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo %@ wird zum Ausgangspunkt: keine Einnahme, keine Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance %@ becomes the starting point: no income, no spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo %@ pasa a ser el punto de partida: ni ingreso ni gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde %@ devient le point de départ : ni revenu ni dépense."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo di %@ diventa il punto di partenza: nessuna entrata, nessuna spesa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімі бастапқы нүкте болады: табыс та, шығын да жоқ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo %@ staje się punktem początkowym: bez przychodu i wydatku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de %@ será o ponto de partida: sem receita nem despesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток %@ — точка отсчёта, без дохода и расхода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyesi başlangıç noktası olur: gelir veya gider oluşmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок %@ стає точкою відліку: ні доходу, ні витрати."
          }
        }
      }
    },
    "reconcile.firstCountToggleHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да версіі 1.2 пусты баланс запісваўся як нуль, таму гэта, хутчэй за ўсё, першы сапраўдны падлік грошай. Ён стане пачатковым балансам. Зніміце сцяжок, толькі калі той нуль быў сапраўдным."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor Version 1.2 wurde ein leerer Saldo als null geschrieben; deshalb ist dies sehr wahrscheinlich die erste echte Zählung des Geldes, und sie wird zum Ausgangspunkt. Wählen Sie es nur ab, wenn diese Null echt war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before 1.2 an empty balance was written as zero, so this is most likely the first real count of the money, and it becomes the starting point. Untick it only if that zero was real."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de la 1.2 un saldo vacío se anotaba como cero, así que lo más probable es que este sea el primer recuento real de ese dinero, y pasa a ser el punto de partida. Desmárquelo solo si ese cero era real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant la 1.2, un solde vide était noté comme zéro : c'est donc très probablement le premier comptage réel de cet argent, qui devient le point de départ. Ne la décochez que si ce zéro était réel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima della versione 1.2 un saldo vuoto veniva registrato come zero. Questo è quindi probabilmente il primo conteggio effettivo e diventa il punto di partenza. Deseleziona solo se lo zero era reale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 нұсқасына дейін бос теңгерім нөл ретінде жазылатын, сондықтан бұл көбіне ақшаның алғашқы нақты санауы және ол бастапқы нүкте болады. Нөл нақты болса ғана белгіні алып тастаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed wersją 1.2 brak salda zapisywano jako zero. To najpewniej pierwsze sprawdzenie stanu środków, które stanie się punktem początkowym. Odznacz tę opcję tylko wtedy, gdy saldo rzeczywiście wynosiło zero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes da versão 1.2, um saldo vazio era registrado como zero. Provavelmente, esta é a primeira contagem real do dinheiro e será o ponto de partida. Desmarque apenas se o saldo zero era real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 1.2 пустое поле остатка записывалось нулём, поэтому это, скорее всего, первый настоящий пересчёт денег, и он станет точкой отсчёта. Снимите отметку, только если тот ноль был настоящим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 sürümünden önce boş bakiye sıfır olarak kaydediliyordu. Bu nedenle bu büyük olasılıkla paranın ilk gerçek sayımıdır ve başlangıç noktası olur. Seçimi yalnızca sıfır bakiyesi gerçekse kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До версії 1.2 порожній залишок записувався як нуль, тож, найімовірніше, це перший справжній облік грошей, і він стає точкою відліку. Знімайте позначку, лише якщо той нуль був справжнім."
          }
        }
      }
    },
    "reconcile.help": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Параўнайце наяўныя грошы з балансам паводле ўліку"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleichen Sie das Geld, das Sie haben, mit dem, was die Bücher erwarten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the money you have with what the books expect"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare el dinero que tiene con lo que esperan los registros"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparer l'argent que vous avez avec ce qu'attendent les comptes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta il denaro che hai con il saldo previsto dai registri"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақшаңыз бен кітаптар күткен соманы салыстырыңыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównaj stan środków ze stanem według ewidencji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare o dinheiro que você tem com o saldo registrado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнить деньги на руках с тем, что ожидает учёт"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elinizdeki parayı kayıtlardaki beklenen tutarla karşılaştırın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівняйте гроші, які у вас є, з тим, що очікують книги"
          }
        }
      }
    },
    "reconcile.history": {
      "extractionState": "manual",
      "localizations": {
