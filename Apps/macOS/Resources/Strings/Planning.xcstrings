        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში შემოსავალი ჯერ არ არის და არც მედიანის გამოსათვლელი ისტორია არსებობს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда табыс жоқ және медиана алатын тарих жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда киреше жок жана медиананы эсептөөгө тарых жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak przychodów w tym miesiącu i historii do obliczenia mediany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há receita este mês nem histórico para calcular a mediana"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há rendimentos este mês nem histórico para calcular a mediana"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце ещё нет дохода, а медиану взять не из чего"
