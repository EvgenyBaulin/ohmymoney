    "advice.load.bank": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank daha sərt hesablayır: kredit kartı üçün borcun deyil, limitin 5%-ni götürür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк лічыць больш строга: 5% ад ліміту крэдытнай карты, а не ад доўгу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka počítá přísněji: u kreditní karty bere 5 % z limitu, ne z dluhu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank rechnet strenger: eine Kreditkarte als 5 % ihres Limits, nicht der Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank counts stricter: a credit card as 5% of its limit, not of the debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banco cuenta más estrictamente: una tarjeta de crédito como el 5 % de su límite, no de la deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une banque compte plus strictement : une carte de crédit à 5 % de son plafond, et non de la dette."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկն ավելի խիստ է հաշվում՝ վարկային քարտի սահմանաչափի 5%-ը, ոչ թե պարտքի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca usa un criterio più severo: per una carta di credito calcola il 5% del limite, non del debito."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკი უფრო მკაცრად ითვლის: საკრედიტო ბარათისთვის ლიმიტის 5%-ს იღებს და არა ვალისას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк қатаңырақ санайды: кредиттік карта лимиттің 5%-ы ретінде, берешектің емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк катуураак эсептейт: кредиттик карта боюнча карыздын эмес, лимиттин 5% алынат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank liczy bardziej rygorystycznie: kartę kredytową jako 5% limitu, a nie zadłużenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco usa um cálculo mais rigoroso: 5% do limite do cartão de crédito, não da dívida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um banco calcula de forma mais rigorosa: considera 5% do limite do cartão de crédito, não da dívida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк считает строже: кредитка — 5 % от лимита, а не от долга."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк сахтгиронатар ҳисоб мекунад: барои корти кредитӣ 5% аз маҳдудият, на аз қарз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka daha katı hesaplar: kredi kartında borcun değil, limitin %5’ini esas alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк рахує суворіше: кредитну картку — як 5 % її ліміту, а не від боргу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank qat’iyroq hisoblaydi: kredit kartasi uchun qarzning emas, limitning 5% olinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行的計算更嚴格：信用卡按額度的 5% 計算，而非按欠款計算。"
          }
        }
      }
    },
