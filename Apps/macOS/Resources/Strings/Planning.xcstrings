    "advice.load.bank": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank counts stricter: a credit card as 5% of its limit, not of the debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banco cuenta más estrictamente: una tarjeta de crédito como el 5 % de su límite, no de la deuda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк считает строже: кредитка — 5 % от лимита, а не от долга."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк рахує суворіше: кредитну картку — як 5 % її ліміту, а не від боргу."
          }
        }
      }
    },
