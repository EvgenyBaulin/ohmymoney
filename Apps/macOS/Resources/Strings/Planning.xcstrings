    "layout.edit.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a block onto the place it should take. The order is also in Settings → Planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un bloque al lugar que debe ocupar. El orden también está en Ajustes → Planificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un bloc à la place qu'il doit occuper. L'ordre se règle aussi dans Réglages → Planification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите блок на место, которое он должен занять. Порядок есть и в «Настройки → Планирование»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть блок на місце, яке він має займати. Порядок також є в «Налаштування → Планування»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un blocco nella posizione desiderata. Puoi cambiarne l’ordine anche in Impostazioni → Pianificazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокты қажетті орнына сүйреңіз. Тәртіп «Параметрлер → Жоспарлауда» да бар."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перацягніце блок на патрэбнае месца. Парадак таксама можна змяніць у Наладах → Планаванне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Block auf den Platz, den er einnehmen soll. Die Reihenfolge steht auch unter Einstellungen → Planung."
          }
        }
      }
    },
    "layout.empty.events": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A holiday or a birthday with a budget: Planning keeps its money back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas vacaciones o un cumpleaños con presupuesto: Planificación guarda su dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des vacances ou un anniversaire avec un budget : la Planification en réserve l'argent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпуск или день рождения с бюджетом: «Планирование» придержит на него деньги."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свято або день народження з бюджетом: «Планування» відкладе для них гроші."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una festa o un compleanno con un budget: Pianificazione mette da parte la somma necessaria."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бюджеті бар демалыс немесе туған күн: Жоспарлау оның ақшасын бөліп ұстайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Свята або дзень нараджэння з бюджэтам: Планаванне зарэзервуе грошы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Feiertag oder ein Geburtstag mit Budget: Die Planung hält das Geld dafür zurück."
          }
        }
      }
    },
