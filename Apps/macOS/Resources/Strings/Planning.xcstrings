    "reconcile.cannotRecord": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A difference on an archived account or in a currency the account does not hold cannot be recorded. Nothing was saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una diferencia en una cuenta archivada o en una divisa que la cuenta no tiene no se puede registrar. No se guardó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écart sur un compte archivé, ou dans une devise que le compte ne détient pas, ne peut pas être noté. Rien n'a été enregistré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу на счёте в архиве или в валюте вне списка счёта не записать. Ничего не сохранено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різницю на архівному рахунку або в валюті, якої рахунок не містить, не можна записати. Нічого не збережено."
          }
        }
      }
