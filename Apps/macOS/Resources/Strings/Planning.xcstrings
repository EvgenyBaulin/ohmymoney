    "reconcile.accountsQuestion": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колькі грошай цяпер на кожным рахунку? У палях ужо пазначаны балансы паводле ўліку: выпраўце толькі тыя, што адрозніваюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Geld ist jetzt auf jedem Konto? Jedes Feld enthält schon, was die Bücher erwarten: Korrigieren Sie nur die, die abweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much money is on each account now? Each field already holds what the books expect: fix only the ones that differ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto denaro c'è ora su ogni conto? Ogni campo mostra già il saldo previsto dai registri: correggi solo quelli diversi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр есеп-шотта қазір қанша ақша бар? Әр өрісте кітаптар күткен сома тұр: тек айырмашылығы бар екеуін түзетіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько денег на каждом счёте сейчас? В каждом поле — сколько ожидает учёт: поправьте только то, что отличается."
          }
        }
      }
    },
