    "reconcile.cannotRecord": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга запісаць розніцу на архіўным рахунку або ў валюце, якой няма на рахунку. Нічога не захавана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Differenz auf einem archivierten Konto oder in einer Währung, die das Konto nicht führt, kann nicht erfasst werden. Nichts wurde gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A difference on an archived account or in a currency the account does not hold cannot be recorded. Nothing was saved."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile registrare una differenza su un conto archiviato o in una valuta non presente sul conto. Nessuna modifica salvata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы есеп-шоттағы немесе есеп-шотта жоқ валютадағы айырманы жазу мүмкін емес. Ештеңе сақталмады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу на счёте в архиве или в валюте вне списка счёта не записать. Ничего не сохранено."
          }
        }
      }
    },
