{
  "sourceLanguage": "en",
  "strings": {
    "advice.badComparison.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pis xərclərin əvvəlki aylarla müqayisəsi"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Шкодныя выдаткі ў параўнанні з мінулымі месяцамі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nežádoucí výdaje oproti minulým měsícům"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Ausgaben gegenüber früheren Monaten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad spending against earlier months"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto malo frente a meses anteriores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépenses superflues par rapport aux mois précédents"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վատ ծախսերը՝ նախորդ ամիսների համեմատ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spese superflue rispetto ai mesi precedenti"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცუდი ხარჯები წინა თვეებთან შედარებით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаман шығын бұрынғы айлармен салыстырғанда"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Зыяндуу чыгымдар мурунку айларга салыштырмалуу"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złe wydatki na tle poprzednich miesięcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastos ruins em relação aos meses anteriores"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Despesas más face aos meses anteriores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плохие траты в сравнении с прошлыми месяцами"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти бад нисбат ба моҳҳои пеш"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki aylara göre kötü harcamalar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погані витрати проти попередніх місяців"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvalgi oylarga nisbatan behuda xarajatlar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不良支出與前幾個月比較"
          }
        }
      }
    },
    "advice.badCutScenario.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pis xərcləri azalt, «%@» məqsədinə tez çat"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Менш шкодных выдаткаў — «%@» хутчэй"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Méně nežádoucích výdajů, „%@“ dříve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger schlechte Ausgaben, „%@“ früher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less bad spending, “%@” sooner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos gasto malo, «%@» antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de dépenses superflues, « %@ » plus tôt"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քիչ վատ ծախսեր, «%@»՝ ավելի շուտ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno spese superflue, “%@” prima"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაკლები ცუდი ხარჯი, „%@“ უფრო ადრე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаман шығын азайса, “%@” тезірек"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Зыяндуу чыгымдарды азайтып, “%@” максатына эртерээк жетүү"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej złych wydatków, „%@” szybciej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos gastos ruins, “%@” mais cedo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos despesas más, «%@» mais cedo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше плохих трат — «%@» раньше"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти бад камтар, «%@» зудтар"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha az kötü harcama, daha erken “%@”"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менше поганих витрат — «%@» раніше"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Behuda xarajatlar kamroq, “%@” tezroq"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少不良支出，更早達成「%@」"
          }
        }
      }
    },
