          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar a meta arquivada «%@»?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o objetivo arquivado «%@»?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить архивную цель «%@»?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳадафи бойгонишудаи «%@» нест карда шавад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenmiş «%@» hedefi silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити ціль «%@» з архіву?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivlangan «%@» maqsadi o‘chirilsinmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除已封存的目標 «%@» 嗎？"
          }
        }
      }
    },
