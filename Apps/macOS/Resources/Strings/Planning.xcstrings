    "layout.empty.expected": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарплата, аванс, грошы, якія верне сябар, — усё, што вы чакаеце."
          }
        },
        "de": {
          "stringUnit": {
