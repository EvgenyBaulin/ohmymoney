    "form.accountArchived": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак «%@» у архіве — выберыце іншы, інакш плацёж будзе спісаны з асноўнага рахунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto „%@“ ist archiviert — wählen Sie ein anderes, sonst wird die Zahlung vom Hauptkonto abgebucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account «%@» is archived — pick another, or the payment is taken from the main account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta «%@» está archivada — elija otra, o el pago sale de la cuenta principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte « %@ » est aux archives — choisissez-en un autre, ou le paiement sera prélevé sur le compte principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto «%@» è archiviato: scegline un altro oppure il pagamento verrà prelevato dal conto principale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” есеп-шоты мұрағатта — басқасын таңдаңыз, әйтпесе төлем негізгі есеп-шоттан алынады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto «%@» jest zarchiwizowane — wybierz inne. W przeciwnym razie płatność zostanie pobrana z konta głównego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta «%@» está arquivada. Escolha outra ou o pagamento será debitado da conta principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт «%@» в архиве — выберите другой, иначе платёж спишется с основного."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» hesabı arşivlenmiş. Başka bir hesap seçin; yoksa ödeme ana hesaptan alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунок «%@» в архіві — оберіть інший, або платіж списується з основного рахунку."
          }
        }
      }
    },
