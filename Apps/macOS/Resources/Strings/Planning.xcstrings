    "reconcile.noRateForDifference": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üçün bu gün məzənnə yoxdur: fərqi rublla qeydə almaq mümkün deyil. ⌘R basın və ya qeydə almadan saxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На сёння няма курсу для %@: нельга запісаць розніцу ў рублях. Націсніце ⌘R або захавайце без запісу розніцы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro %@ dnes chybí kurz: rozdíl nelze zaznamenat v rublech. Stiskněte ⌘R nebo uložte bez zaznamenání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute kein Kurs für %@: Die Differenz kann nicht in Rubel erfasst werden. Drücken Sie ⌘R oder sichern Sie ohne Erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate today for %@: the difference cannot be recorded in rubles. Press ⌘R, or save without recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no hay tipo de %@: la diferencia no se puede registrar en rublos. Pulse ⌘R, o guarde sin registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux aujourd'hui pour %@ : l'écart ne peut pas être noté en roubles. Appuyez sur ⌘R, ou enregistrez sans noter."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօր %@ արժույթի փոխարժեք չկա․ տարբերությունը հնարավոր չէ գրանցել ռուբլով։ Սեղմեք ⌘R կամ պահեք առանց գրանցելու։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tasso disponibile oggi per %@: impossibile registrare la differenza in rubli. Premi ⌘R o salva senza registrare."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ისთვის დღეს კურსი არ არის: სხვაობა რუბლებში ვერ ჩაიწერება. დააჭირეთ ⌘R ან შეინახეთ ჩაწერის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ үшін бүгін бағам жоқ: айырманы рубльмен жазу мүмкін емес. ⌘R басыңыз, не жазбай сақтаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүн %@ үчүн курс жок: айырманы рубль менен жазуу мүмкүн эмес. ⌘R басыңыз же айырманы жазбай сактаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dzisiejszego kursu dla %@: nie można zapisać różnicy w rublach. Naciśnij ⌘R lub zachowaj bez zapisywania różnicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há cotação de %@ para hoje: a diferença não pode ser registrada em rublos. Pressione ⌘R ou salve sem registrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há taxa de câmbio de hoje para %@: não é possível registar a diferença em rublos. Prima ⌘R ou guarde sem registar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса на сегодня для %@: разницу не записать в рублях. Нажмите ⌘R или сохраните без записи."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имрӯз барои %@ қурб нест: фарқро бо рубл сабт кардан мумкин нест. ⌘R-ро пахш кунед ё бе сабти фарқ нигоҳ доред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için bugün kur yok: fark ruble olarak kaydedilemiyor. ⌘R tuşlarına basın veya farkı işlemeden kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу %@ сьогодні немає: різницю не можна записати в рублях. Натисніть ⌘R або збережіть без запису."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uchun bugungi kurs yo‘q: farqni rublda yozib bo‘lmaydi. ⌘R ni bosing yoki yozmasdan saqlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今日沒有 %@ 的匯率，無法以盧布記錄差額。請按 ⌘R，或儲存但不記錄差額。"
          }
        }
      }
    },
    "reconcile.notHeld": {
