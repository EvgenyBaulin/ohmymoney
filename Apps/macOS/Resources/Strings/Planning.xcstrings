    "form.goal.otherCurrency": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmin günün məzənnəsi ilə məqsədin %@ valyutasında hesablanır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана ў %@ мэты па курсе на дзень аперацыі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepočítáno na %@ cíle kurzem daného dne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt in %@ des Ziels zum Kurs seines Tages"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted in the goal's %@ at the rate of its day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuenta en %@ del objetivo al tipo de su día"
          }
        },
        "fr": {
