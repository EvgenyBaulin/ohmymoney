    "form.withdraw.noRate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма курсу для разліку %2$@ у %1$@ на гэты дзень: немагчыма праверыць захаваную суму"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es keinen Kurs, um %2$@ in %1$@ zu berechnen: Es kann nicht gegen das Gespeicherte geprüft werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate to count %2$@ in %1$@ for this day: it cannot be checked against what is saved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tipo para calcular %2$@ en %1$@ de este día: no se puede comprobar con lo guardado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux pour compter %2$@ en %1$@ ce jour-là : impossible de vérifier contre ce qui est enregistré"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tasso per calcolare %2$@ in %1$@ per questo giorno: impossibile confrontarlo con il risparmio"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %1$@ ішінде %2$@ санайтын бағам жоқ: сақталғанмен салыстыруға болмайды"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu do przeliczenia %2$@ na %1$@ w tym dniu. Nie można porównać kwoty z oszczędnościami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há cotação para calcular %2$@ em %1$@ neste dia: não é possível comparar com o valor guardado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса, чтобы перевести %2$@ в %1$@ на этот день: не проверить, хватит ли накопленного"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için %2$@ tutarını %1$@ cinsinden hesaplayacak kur yok; birikimle karşılaştırılamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
