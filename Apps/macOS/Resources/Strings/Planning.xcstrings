    "overview.upcoming.approxHelp": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas valyutada, Rusiya Mərkəzi Bankının bugünkü məzənnəsi ilə təxmini məbləğ"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прыкладная сума ў асноўнай валюце па сённяшнім курсе ЦБ РФ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přibližná částka ve výchozí měně podle dnešního kurzu CBR"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa so viel in der Standardwährung, zum heutigen Kurs der Bank of Russia"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About this much in the default currency, at today's CBR rate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximadamente esto en la divisa principal, al tipo del Banco de Rusia de hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ ce montant dans la devise par défaut, au cours du jour de la BR"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մոտավոր գումարը հիմնական արժույթով՝ ԿԲ-ի այսօրվա փոխարժեքով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importo approssimativo nella valuta predefinita, al tasso CBR di oggi"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიახლოებითი თანხა ძირითად ვალუტაში, ცენტრალური ბანკის დღევანდელი კურსით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі валютада шамамен осыншама, бүгінгі ҚР Банкінің бағамы бойынша"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүнкү CBR курсу боюнча демейки валютадагы болжолдуу сумма"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przybliżona kwota w walucie domyślnej, według dzisiejszego kursu CBR"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor aproximado na moeda padrão, pela cotação de hoje do CBR"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor aproximado na moeda predefinida, à taxa do CBR de hoje"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно в валюте по умолчанию, по сегодняшнему курсу ЦБ"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи тахминӣ бо асъори пешфарз, бо қурби имрӯзаи CBR"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü CBR kuruna göre varsayılan para birimindeki yaklaşık tutar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизно стільки у валюті за замовчуванням, за сьогоднішнім курсом ЦБ"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugungi CBR kursi bo‘yicha asosiy valyutadagi taxminiy summa"
          }
        },
