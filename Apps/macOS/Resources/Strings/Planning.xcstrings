    "selfEmployed.offer.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like income of the self-employed. The app can count the tax, remind of its due day on the 28th and keep it out of the free sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece un ingreso de actividad propia. La app puede calcular el impuesto, recordar su día de pago el 28 y dejarlo fuera de la suma libre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, у вас доход самозанятого. Приложение может считать налог НПД, напоминать о сроке 28-го числа и не считать налог свободными деньгами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже на дохід самозайнятих. Застосунок може порахувати податок, нагадати про його день — 28-го — і не враховувати його у вільній сумі."
          }
        }
      }
    },
