            "value": "And transfer to this account when allocating"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y transferir a esta cuenta al distribuir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et virer sur ce compte lors de la répartition"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բաշխելիս նաև փոխանցել այս հաշվին"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasferisci su questo conto durante l’assegnazione"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განაწილებისას ამ ანგარიშზე გადარიცხვაც"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлгенде осы есеп-шотқа аудару да"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүштүрүүдө бул эсепке да которуу"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelewaj też na to konto przy podziale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferir para esta conta ao distribuir"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferir também para esta conta ao distribuir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И переводить на этот счёт при распределении"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми тақсимот ба ин ҳисоб ҳам интиқол дода шавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dağıtırken bu hesaba da aktar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "І переказувати на цей рахунок під час розподілу"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Taqsimlashda bu hisobga ham o‘tkazish"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分配時同時轉入此帳戶"
          }
        }
      }
    },
    "form.goal.transfers.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gəlir bölüşdürülərkən vəsait ayrılır və bu hesaba bir addımda köçürülür; pəncərədə seçimi ləğv etmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры размеркаванні даходу ўнёсак і перавод на гэты рахунак робяцца разам. Перавод можна выключыць у форме."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při rozdělení příjmu se příspěvek i převod na tento účet provedou najednou. Převod lze vypnout v dialogu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Einnahme verteilt wird: der Beitrag und eine Überweisung auf dieses Konto in einem Schritt; das Blatt kann es abwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an income is allocated: the contribution and a transfer to this account, one step; the sheet can untick it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al distribuir un ingreso: la aportación y una transferencia a esta cuenta, en un solo paso; la hoja permite desmarcarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de la répartition d'un revenu : la contribution et un virement vers ce compte, en une étape ; la feuille peut le décocher."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եկամուտը բաշխելիս համալրումն ու այս հաշվին փոխանցումը կատարվում են մեկ քայլով․ պատուհանում կարելի է հանել նշումը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando assegni un reddito, il contributo e il trasferimento su questo conto avvengono insieme; puoi deselezionare l’opzione nel pannello."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შემოსავლის განაწილებისას შენატანი და ამ ანგარიშზე გადარიცხვა ერთად შესრულდება; ფანჯარაში მონიშვნის მოხსნა შესაძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табыс бөлінгенде: салым және осы есеп-шотқа аударым бір қадамда; парақта оны алып тастауға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кирешени бөлүштүрүүдө салым кошулуп, акча бул эсепке бир кадамда которулат; терезеден белгини алып салсаңыз болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy podziale przychodu wpłata i przelew na to konto są wykonywane razem. Można to wyłączyć w formularzu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao distribuir uma receita, a contribuição e a transferência para esta conta são feitas juntas. A transferência pode ser desmarcada na tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao distribuir um rendimento, a contribuição e a transferência para esta conta são feitas num só passo. Pode desativar esta opção no formulário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При распределении дохода — взнос и перевод на этот счёт одним шагом; в листе галочку можно снять."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми тақсимоти даромад маблағ ба ҳадаф гузошта ва ба ин ҳисоб интиқол дода мешавад; дар варақ инро хомӯш кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelir dağıtılırken katkı ve bu hesaba aktarım tek adımda yapılır; ekranda seçim kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли дохід розподіляється: внесок і переказ на цей рахунок в один крок; аркуш може це зняти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Daromad taqsimlanganda ajratma va bu hisobga o‘tkazma bir vaqtda amalga oshiriladi; oynada belgini olib tashlash mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分配收入時，一併存入目標並轉帳至此帳戶；可在分配畫面中取消勾選。"
          }
        }
      }
    },
