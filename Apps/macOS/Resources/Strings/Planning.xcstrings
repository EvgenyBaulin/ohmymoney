    "form.markAsPaid.forOther": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ верне %@: гэтая частка чакае ў «Мне вінныя»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zahlt %@ zurück: Dieser Teil wartet unter „Mir geschuldet“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gives back %@: that part waits in «Owed to me»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ devuelve %2$@: esa parte espera en «Me deben»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rend %@ : cette part attend dans « Me doivent »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restituisce %@: questa parte resta in «Mi devono»"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ қайтарады: бұл бөлік «Маған берілген» ішінде күтеді"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zwróci %@: ta część czeka w «Należne mi»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devolve %@: essa parte fica em «A receber»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вернёт %@: эта часть будет ждать в «Мне должны»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ geri öder: bu tutar «Alacaklarım»da bekler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ повертає %2$@: ця частина чекає в «Винні мені»"
          }
        }
      }
    },
