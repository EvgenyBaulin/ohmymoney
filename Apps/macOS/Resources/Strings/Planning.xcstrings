    "reconcile.notHeldDifference": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга запісаць розніцу для архіўнага рахунку або ў валюце, якой няма на рахунку: %@. Захавайце без запісу."
