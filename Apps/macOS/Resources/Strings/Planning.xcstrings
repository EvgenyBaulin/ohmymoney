            "value": "The payment was not made: the due date is closed without an operation, as «Skip» in Planning does"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago no se hizo: el vencimiento se cierra sin operación, como hace «Omitir» en Planificación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement n'a pas été effectué : l'échéance est clôturée sans opération, comme le fait « Passer » dans la Planification"
          }
        },
        "ru": {
