        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa pagare, cosa ricevere e quanto puoi spendere"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нені төлеу керек, нені алу керек және неше жұмсауға болады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zapłacić, co otrzymać i ile możesz wydać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pagar, o que receber e quanto você pode gastar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что платить, что получить и сколько можно тратить"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödemeleriniz, gelecek gelirleriniz ve harcayabileceğiniz tutar"
