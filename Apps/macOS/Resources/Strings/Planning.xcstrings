    "layout.empty.limits": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт вызначае месячныя выдаткі на катэгорыю і папярэджвае, калі ён заканчваецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Limit sagt, wie viel eine Kategorie im Monat ausgeben darf, und warnt, wenn es aufgebraucht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit says how much a category may take in a month, and warns when it runs out."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un limite indica quanto puoi spendere in una categoria ogni mese e ti avvisa quando lo raggiungi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
