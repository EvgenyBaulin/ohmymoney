    "layout.empty.goals": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкладваеце на падарожжа або новы ноўтбук? Мэта падкажа, колькі адкладаць штомесяц."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparen für eine Reise oder einen neuen Laptop? Ein Ziel zeigt, wie viel Sie im Monat beiseitelegen sollten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving for a trip or a new laptop? A goal counts how much to put aside a month."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmi per un viaggio o un nuovo portatile? Un obiettivo calcola quanto mettere da parte ogni mese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саяхатқа немесе жаңа ноутбукке жинап жүрсіз бе? Мақсат айына қанша бөлу керектігін есептейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копите на поездку или новый ноутбук? Цель посчитает, сколько откладывать в месяц."
          }
        }
      }
    },
