    "reconcile.rateMissing": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün məzənnəsi olmayan valyutada fərqi qeydə almaq mümkün deyil, buna görə heç nə saxlanmadı. ⌘R basın və ya qeydə almadan saxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга запісаць розніцу ў валюце без курсу на сёння, таму нічога не захавана. Націсніце ⌘R або захавайце без запісу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdíl v měně, pro kterou dnes chybí kurz, nelze zaznamenat, takže se nic neuložilo. Stiskněte ⌘R nebo uložte bez zaznamenání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Differenz in einer Währung ohne heutigen Kurs kann nicht erfasst werden, daher wurde nichts gespeichert. Drücken Sie ⌘R oder sichern Sie ohne Erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A difference in a currency without a rate today cannot be recorded, so nothing was saved. Press ⌘R, or save without recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una diferencia en una divisa sin tipo hoy no se puede registrar, así que no se guardó nada. Pulse ⌘R, o guarde sin registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écart dans une devise sans taux aujourd'hui ne peut pas être noté, donc rien n'a été enregistré. Appuyez sur ⌘R, ou enregistrez sans noter."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօր փոխարժեք չունեցող արժույթի տարբերությունը հնարավոր չէ գրանցել, ուստի ոչինչ չի պահպանվել։ Սեղմեք ⌘R կամ պահեք առանց գրանցելու։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare una differenza in una valuta senza un tasso di cambio per oggi. Non è stato salvato nulla. Premi ⌘R o salva senza registrare."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალუტაში, რომელსაც დღეს კურსი არ აქვს, სხვაობა ვერ ჩაიწერება, ამიტომ არაფერი შენახულა. დააჭირეთ ⌘R ან შეინახეთ ჩაწერის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін бағамы жоқ валютадағы айырманы жазу мүмкін емес, сондықтан ештеңе сақталмады. ⌘R басыңыз, не жазбай сақтаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүн курсу жок валютадагы айырманы жазуу мүмкүн эмес, ошондуктан эч нерсе сакталган жок. ⌘R басыңыз же айырманы жазбай сактаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać różnicy w walucie bez dzisiejszego kursu, więc nic nie zachowano. Naciśnij ⌘R lub zachowaj bez zapisywania różnicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível registrar uma diferença em uma moeda sem cotação para hoje, então nada foi salvo. Pressione ⌘R ou salve sem registrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível registar uma diferença numa moeda sem taxa de câmbio de hoje, pelo que nada foi guardado. Prima ⌘R ou guarde sem registar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу в валюте без курса на сегодня не записать, и ничего не сохранено. Нажмите ⌘R или сохраните без записи."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фарқро бо асъоре, ки имрӯз қурб надорад, сабт кардан мумкин нест, бинобар ин чизе нигоҳ дошта нашуд. ⌘R-ро пахш кунед ё бе сабти фарқ нигоҳ доред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün kuru olmayan bir para birimindeki fark işlenemez, bu yüzden hiçbir şey kaydedilmedi. ⌘R tuşlarına basın veya farkı işlemeden kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різницю в валюті, для якої сьогодні немає курсу, не можна записати, тож нічого не збережено. Натисніть ⌘R або збережіть без запису."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugungi kursi yo‘q valyutadagi farqni yozib bo‘lmaydi, shuning uchun hech narsa saqlanmadi. ⌘R ni bosing yoki yozmasdan saqlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法記錄今日沒有匯率的貨幣差額，因此未儲存任何資料。請按 ⌘R，或儲存但不記錄差額。"
          }
        }
      }
    },
