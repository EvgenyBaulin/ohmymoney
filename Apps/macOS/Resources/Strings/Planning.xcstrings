    "reconcile.firstCountToggleHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before 1.2 an empty balance was written as zero, so this is most likely the first real count of the money, and it becomes the starting point. Untick it only if that zero was real."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de la 1.2 un saldo vacío se anotaba como cero, así que lo más probable es que este sea el primer recuento real de ese dinero, y pasa a ser el punto de partida. Desmárquelo solo si ese cero era real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 1.2 пустое поле остатка записывалось нулём, поэтому это, скорее всего, первый настоящий пересчёт денег, и он станет точкой отсчёта. Снимите отметку, только если тот ноль был настоящим."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До версії 1.2 порожній залишок записувався як нуль, тож, найімовірніше, це перший справжній облік грошей, і він стає точкою відліку. Знімайте позначку, лише якщо той нуль був справжнім."
          }
        }
      }
    },
