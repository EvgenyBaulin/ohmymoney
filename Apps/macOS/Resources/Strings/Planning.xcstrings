    "events.form.budgetHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуста — без бюджэту. Рэшта бюджэту рэзервуецца ў свабоднай суме."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer — kein Budget. Was von einem Budget übrig ist, bleibt im freien Betrag zurückgehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty — no budget. What is left of a budget is kept back in the free sum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per non impostare un budget. La parte inutilizzata del budget resta riservata nell’importo disponibile."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бос — бюджет жоқ. Бюджеттің қалғаны бос қаржыда бөлініп қойылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусто — без бюджета. Остаток бюджета придерживается в свободной сумме."
          }
        }
      }
    },
