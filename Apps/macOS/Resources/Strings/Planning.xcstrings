    "layout.empty.limits": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit kateqoriyaya ayda nə qədər xərclənə biləcəyini göstərir və tükəndikdə xəbər verir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт вызначае месячныя выдаткі на катэгорыю і папярэджвае, калі ён заканчваецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit určuje, kolik lze za kategorii měsíčně utratit, a upozorní, když se vyčerpá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Limit sagt, wie viel eine Kategorie im Monat ausgeben darf, und warnt, wenn es aufgebraucht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit says how much a category may take in a month, and warns when it runs out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un límite indica cuánto puede gastar una categoría en un mes, y avisa cuando se agota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plafond indique combien une catégorie peut prendre par mois, et prévient quand il s'épuise."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանաչափը ցույց է տալիս կատեգորիայի ամսական ծախսի չափը և զգուշացնում է դրա սպառման մասին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un limite indica quanto puoi spendere in una categoria ogni mese e ti avvisa quando lo raggiungi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლიმიტი განსაზღვრავს კატეგორიის თვიურ ხარჯს და გაფრთხილებთ, როცა ის იწურება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит санат айына қанша ала алатынын айтады және оған жеткенде ескертеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит категорияга айына канча коротсо болорун көрсөтүп, акча түгөнгөндө эскертет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit określa miesięczną kwotę wydatków w kategorii i ostrzega, gdy się wyczerpuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um limite define quanto uma categoria pode gastar por mês e avisa quando ele acaba."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um limite define quanto pode gastar numa categoria por mês e avisa quando está esgotado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит говорит, сколько категория может забрать за месяц, и предупреждает, когда он кончается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳад нишон медиҳад, ки барои категория дар як моҳ чӣ қадар сарф кардан мумкин аст ва ҳангоми тамом шуданаш огоҳ мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit, bir kategoride ayda ne kadar harcanabileceğini belirler ve tükendiğinde uyarır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт показує, скільки категорія може взяти за місяць, і попереджає, коли він закінчується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit bir toifaga oyiga qancha sarflash mumkinligini belgilaydi va tugayotganida ogohlantiradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "限額可設定類別每月的支出上限，並在用盡時提醒你。"
          }
        }
      }
    },
