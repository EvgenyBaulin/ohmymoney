    "reconcile.expectedHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçota görə məbləğ: son sayım və o vaxtdan bəri bütün əməliyyatlar"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс паводле ўліку: апошні падлік і ўсе рухі пасля яго"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Očekávaný stav: poslední zjištěný zůstatek a všechny následné pohyby"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Bücher erwarten: der letzte Abgleich plus jede Bewegung seither"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the books expect: the last count plus every movement since"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que esperan los registros: el último recuento más cada movimiento desde entonces"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'attendent les comptes : le dernier comptage plus chaque mouvement depuis"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասվող մնացորդը՝ վերջին հաշվարկը և դրանից հետո բոլոր շարժերը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo previsto dai registri: l'ultimo conteggio più tutti i movimenti successivi"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აღრიცხვით მოსალოდნელი თანხა: ბოლო დათვლას დამატებული ყველა შემდგომი მოძრაობა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кітаптар күтетіні: соңғы санау плюс сол уақыттан бері әр қозғалыс"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсеп боюнча: акыркы санак жана андан берки бардык кыймылдар"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan według ewidencji: ostatni stan i wszystkie późniejsze operacje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo esperado: a última contagem mais todas as movimentações desde então"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor previsto: a última contagem mais todos os movimentos desde então"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько ожидает учёт: прошлая сверка плюс все движения после неё"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи интизорӣ: ҳисобкунии охирин ва ҳамаи ҳаракатҳо аз он вақт"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlardaki beklenen tutar: son sayım ve sonrasındaki tüm hareketler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що очікують книги: остання звірка плюс кожен рух після неї"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob bo‘yicha qoldiq: oxirgi sanov va undan keyingi barcha harakatlar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳面預期金額：上次盤點金額加上此後的所有收支"
          }
        }
      }
    },
