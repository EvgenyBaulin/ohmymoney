    "layout.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што аплаціць, што атрымаць і колькі можна выдаткаваць"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Sie zahlen, was Sie bekommen und wie viel Sie ausgeben können"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What to pay, what to receive and how much you can spend"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué pagar, qué recibir y cuánto puede gastar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'il faut payer, ce qu'il faut recevoir et ce que vous pouvez dépenser"
