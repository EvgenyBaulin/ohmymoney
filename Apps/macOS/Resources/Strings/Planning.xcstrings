    "reconcile.notHeldDifference": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivlənmiş hesabda və ya hesabda olmayan valyutada fərqi qeydə almaq mümkün deyil: %@. Qeydə almadan saxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга запісаць розніцу для архіўнага рахунку або ў валюце, якой няма на рахунку: %@. Захавайце без запісу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdíl na archivovaném účtu nebo v měně, kterou účet neobsahuje, nelze zaznamenat: %@. Uložte bez zaznamenání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Differenz auf einem archivierten Konto oder in einer Währung, die das Konto nicht führt, kann nicht erfasst werden: %@. Sichern Sie ohne Erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A difference on an archived account or in a currency the account does not hold cannot be recorded: %@. Save without recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una diferencia en una cuenta archivada o en una divisa que la cuenta no tiene no se puede registrar: %@. Guarde sin registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écart sur un compte archivé, ou dans une devise que le compte ne détient pas, ne peut pas être noté : %@. Enregistrez sans noter."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվացված հաշվի կամ հաշվին չպատկանող արժույթի տարբերությունը հնարավոր չէ գրանցել՝ %@։ Պահեք առանց գրանցելու։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi registrare una differenza su un conto archiviato o in una valuta non presente sul conto: %@. Salva senza registrare."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაარქივებულ ანგარიშზე ან ანგარიშზე არარსებულ ვალუტაში სხვაობა ვერ ჩაიწერება: %@. შეინახეთ ჩაწერის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағаттағы есеп-шоттағы немесе есеп-шот ұстамайтын валютадағы айырманы жазу мүмкін емес: %@. Жазбай сақтаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивделген эсептеги же эсепте жок валютадагы айырманы жазуу мүмкүн эмес: %@. Айырманы жазбай сактаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać różnicy na zarchiwizowanym koncie ani w walucie niedostępnej na koncie: %@. Zachowaj bez zapisywania różnicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível registrar uma diferença em uma conta arquivada ou em uma moeda que a conta não possui: %@. Salve sem registrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível registar uma diferença numa conta arquivada ou numa moeda que a conta não tem: %@. Guarde sem registar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу на счёте в архиве или в валюте вне списка счёта не записать: %@. Сохраните без записи."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фарқро дар суратҳисоби бойгонӣ ё бо асъоре, ки суратҳисоб надорад, сабт кардан мумкин нест: %@. Бе сабти фарқ нигоҳ доред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenmiş bir hesaptaki veya hesabın içermediği bir para birimindeki fark işlenemez: %@. Farkı işlemeden kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різницю на архівному рахунку або в валюті, якої рахунок не містить, не можна записати: %@. Збережіть без запису."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivlangan hisobdagi yoki hisobda mavjud bo‘lmagan valyutadagi farqni yozib bo‘lmaydi: %@. Yozmasdan saqlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法記錄已封存帳戶或帳戶未持有貨幣的差額：%@。請儲存但不記錄差額。"
          }
        }
      }
    },
