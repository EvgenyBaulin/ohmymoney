    "layout.edit.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloku istədiyiniz yerə sürükləyin. Sıranı Parametrlər → Planlaşdırma bölməsində də dəyişə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перацягніце блок на патрэбнае месца. Парадак таксама можна змяніць у Наладах → Планаванне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte blok na požadované místo. Pořadí najdete také v Nastavení → Plánování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Block auf den Platz, den er einnehmen soll. Die Reihenfolge steht auch unter Einstellungen → Planung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a block onto the place it should take. The order is also in Settings → Planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un bloque al lugar que debe ocupar. El orden también está en Ajustes → Planificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un bloc à la place qu'il doit occuper. L'ordre se règle aussi dans Réglages → Planification."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քաշեք բաժինը դեպի ցանկալի տեղը։ Հերթականությունը հասանելի է նաև Կարգավորումներ → Պլանավորում բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un blocco nella posizione desiderata. Puoi cambiarne l’ordine anche in Impostazioni → Pianificazione."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაათრიეთ ბლოკი სასურველ ადგილას. რიგის შეცვლა ასევე შეგიძლიათ: პარამეტრები → დაგეგმვა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокты қажетті орнына сүйреңіз. Тәртіп «Параметрлер → Жоспарлауда» да бар."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокту керектүү орунга сүйрөңүз. Тартибин Жөндөөлөр → Пландоо бөлүмүнөн да өзгөртсөңүз болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij blok w wybrane miejsce. Kolejność możesz też zmienić w Ustawienia → Planowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um bloco para a posição desejada. A ordem também está em Ajustes → Planejamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um bloco para o lugar pretendido. Também pode alterar a ordem em Definições → Planeamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите блок на место, которое он должен занять. Порядок есть и в «Настройки → Планирование»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокро ба ҷойи дилхоҳ кашед. Тартибро дар Танзимот → Банақшагирӣ низ иваз кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bloğu istediğiniz yere sürükleyin. Sıralamayı Ayarlar → Planlama bölümünden de değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть блок на місце, яке він має займати. Порядок також є в «Налаштування → Планування»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokni kerakli joyga torting. Tartibni Sozlamalar → Rejalashtirish bo‘limida ham o‘zgartirish mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將區塊拖移到所需位置。也可在「設定」→「規劃」中調整順序。"
          }
        }
      }
    },
    "layout.empty.events": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Büdcəsi olan bayram və ya ad günü: Planlaşdırma onun üçün vəsait ayırır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Свята або дзень нараджэння з бюджэтам: Планаванне зарэзервуе грошы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolená nebo narozeniny s rozpočtem: Plánování na ně odloží peníze."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Feiertag oder ein Geburtstag mit Budget: Die Planung hält das Geld dafür zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A holiday or a birthday with a budget: Planning keeps its money back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas vacaciones o un cumpleaños con presupuesto: Planificación guarda su dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des vacances ou un anniversaire avec un budget : la Planification en réserve l'argent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տոն կամ ծննդյան օր՝ նախատեսված գումարով․ Պլանավորումը կպահի այդ գումարը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una festa o un compleanno con un budget: Pianificazione mette da parte la somma necessaria."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღესასწაული ან დაბადების დღე ბიუჯეტით: დაგეგმვა თანხას გადადებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бюджеті бар демалыс немесе туған күн: Жоспарлау оның ақшасын бөліп ұстайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Майрамга же туулган күнгө бюджет түзүңүз: Пландоо ага акча калтырат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakacje lub urodziny z określonym budżetem: Planowanie odłoży na nie pieniądze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma viagem ou um aniversário com orçamento: o Planejamento reserva o dinheiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Férias ou um aniversário com orçamento: o Planeamento reserva o dinheiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпуск или день рождения с бюджетом: «Планирование» придержит на него деньги."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ид ё зодрӯз бо буҷа: Банақшагирӣ маблағи онро нигоҳ медорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçesi olan bir tatil veya doğum günü: Planlama, gereken parayı ayırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свято або день народження з бюджетом: «Планування» відкладе для них гроші."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayram yoki tug‘ilgan kun uchun budjet belgilang: Rejalashtirish unga pul ajratib qo‘yadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為假期或生日設定預算，規劃會保留所需金額。"
          }
        }
      }
    },
