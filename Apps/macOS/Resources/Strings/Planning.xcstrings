          "stringUnit": {
            "state": "translated",
            "value": "Již přijatý příjem zůstane; smaže se jen očekávaný příjem a jeho propojení. Pomocí ⌘Z je obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bereits erhaltene Einnahme bleibt; nur die Erwartung und ihre Verknüpfungen gehen. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income already received stays; only the expectation and its links go. ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso ya recibido se queda; solo se van la previsión y sus vínculos. ⌘Z los devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le revenu déjà reçu reste ; seuls l'attente et ses liens partent. ⌘Z les rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արդեն ստացված եկամուտը կմնա․ կջնջվեն միայն սպասվող եկամուտն ու դրա կապերը։ ⌘Z-ը կվերականգնի դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reddito già ricevuto rimane; vengono eliminati solo la previsione e i suoi collegamenti. Premi ⌘Z per ripristinarli."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უკვე მიღებული შემოსავალი დარჩება; წაიშლება მხოლოდ მოლოდინი და მისი კავშირები. ⌘Z მათ აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алынған табыс қалады; тек күту мен оның сілтемелері кетеді. ⌘Z қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Түшкөн киреше калат; күтүү жана анын байланыштары гана өчүрүлөт. ⌘Z аларды кайтарат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymany przychód pozostanie; usunięte zostaną tylko oczekiwanie i jego powiązania. Naciśnij ⌘Z, aby je przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A receita já recebida permanece; apenas a previsão e seus vínculos são apagados. Use ⌘Z para desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O rendimento já recebido mantém-se; apenas a previsão e as suas ligações são apagadas. Prima ⌘Z para as repor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полученные доходы останутся, удалится только ожидание и привязки к нему. ⌘Z вернёт их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади аллакай гирифташуда боқӣ мемонад; танҳо интизорӣ ва пайвандҳои он нест мешаванд. ⌘Z онҳоро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alınan gelir kalır; yalnızca beklenti ve bağlantıları silinir. ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід, який уже надійшов, лишається; видаляються лише очікування та їхні зв'язки. ⌘Z їх повертає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Olingan daromad qoladi; faqat kutilayotgan daromad va uning bog‘lanishlari o‘chiriladi. ⌘Z ularni tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已收到的收入會保留；僅刪除預期收入及其連結。按 ⌘Z 可還原。"
          }
        }
      }
    },
