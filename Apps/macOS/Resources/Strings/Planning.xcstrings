    "layout.empty.goals": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səyahət və ya yeni noutbuk üçün pul yığırsınız? Məqsəd hər ay nə qədər ayırmalı olduğunuzu hesablayır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкладваеце на падарожжа або новы ноўтбук? Мэта падкажа, колькі адкладаць штомесяц."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoříte na cestu nebo nový notebook? Cíl spočítá, kolik měsíčně odkládat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparen für eine Reise oder einen neuen Laptop? Ein Ziel zeigt, wie viel Sie im Monat beiseitelegen sollten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving for a trip or a new laptop? A goal counts how much to put aside a month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ahorra para un viaje o un portátil nuevo? Un objetivo calcula cuánto apartar al mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous épargnez pour un voyage ou un nouvel ordinateur ? Un objectif calcule ce qu'il faut mettre de côté par mois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խնայո՞ւմ եք ճամփորդության կամ նոր նոութբուքի համար։ Նպատակը հաշվում է ամսական խնայելիք գումարը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmi per un viaggio o un nuovo portatile? Un obiettivo calcola quanto mettere da parte ogni mese."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აგროვებთ მოგზაურობისთვის ან ახალი ლეპტოპისთვის? მიზანი გამოთვლის, რამდენი უნდა გადადოთ თვეში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саяхатқа немесе жаңа ноутбукке жинап жүрсіз бе? Мақсат айына қанша бөлу керектігін есептейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Саякатка же жаңы ноутбукка акча топтоп жатасызбы? Максат айына канча бөлүү керектигин эсептейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszczędzasz na podróż lub nowy laptop? Cel pomoże Ci obliczyć miesięczną kwotę oszczędności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando para uma viagem ou um notebook novo? Uma meta calcula quanto reservar por mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A poupar para uma viagem ou um computador novo? Um objetivo calcula quanto deve pôr de lado por mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копите на поездку или новый ноутбук? Цель посчитает, сколько откладывать в месяц."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои сафар ё ноутбуки нав пасандоз мекунед? Ҳадаф маблағи пасандози моҳонаро ҳисоб мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir seyahat veya yeni bir dizüstü bilgisayar için mi biriktiriyorsunuz? Hedef, ayda ne kadar ayırmanız gerektiğini hesaplar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладаєте на поїздку чи новий ноутбук? Ціль покаже, скільки відкладати на місяць."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayohat yoki yangi noutbuk uchun pul yig‘yapsizmi? Maqsad har oy qancha ajratish kerakligini hisoblaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在為旅行或新筆電存錢？目標會計算每月應存金額。"
          }
        }
      }
    },
