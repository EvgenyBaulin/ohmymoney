    "limits.suggest.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to suggest: every category spent on in the last three months already has a limit, or there is too little history yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que sugerir: todas las categorías en las que gastó en los últimos tres meses ya tienen límite, o todavía hay poco historial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить нечего: у всех категорий с тратами за последние три месяца уже есть лимит, или истории пока мало."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонувати нічого: кожна категорія, на яку витрачали за останні три місяці, вже має ліміт, або історії ще замало."
          }
        }
      }
    },
    "limits.suggest.open": {
      "extractionState": "manual",
      "localizations": {
