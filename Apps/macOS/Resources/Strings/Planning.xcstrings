    "reconcile.expectedHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс паводле ўліку: апошні падлік і ўсе рухі пасля яго"
          }
        },
        "de": {
          "stringUnit": {
