        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვადაგადაცილებული გადახდები გათვალისწინებულია: %@ — მათი თანხა ჯერ გაუხარჯავად ითვლება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "мерзімі өткен төлемдер де ескерілген: %@ — олардың ақшасы әлі кетпеген деп саналады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "мөөнөтү өткөн төлөмдөр камтылган: %@ — алардын акчасы азырынча коротулган деп эсептелбейт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "uwzględniono zaległe płatności: %@ — te środki nadal są liczone jako dostępne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "vencimentos em atraso incluídos: %@ — esses valores ainda não foram descontados"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "vencimentos em atraso incluídos: %@ — o respetivo dinheiro ainda é contabilizado"
