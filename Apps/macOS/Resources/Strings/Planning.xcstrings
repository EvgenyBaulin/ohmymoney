    "layout.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödənişlər, gözlənilən gəlirlər və xərcləyə biləcəyiniz məbləğ"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што аплаціць, што атрымаць і колькі можна выдаткаваць"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zaplatit, co přijmout a kolik můžete utratit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Sie zahlen, was Sie bekommen und wie viel Sie ausgeben können"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What to pay, what to receive and how much you can spend"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué pagar, qué recibir y cuánto puede gastar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'il faut payer, ce qu'il faut recevoir et ce que vous pouvez dépenser"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչ վճարել, ինչ ստանալ և որքան կարելի է ծախսել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa pagare, cosa ricevere e quanto puoi spendere"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რა უნდა გადაიხადოთ, მიიღოთ და რამდენის დახარჯვა შეგიძლიათ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нені төлеу керек, нені алу керек және неше жұмсауға болады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эмне төлөнөт, эмне түшөт жана канча коротсо болот"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zapłacić, co otrzymać i ile możesz wydać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pagar, o que receber e quanto você pode gastar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pagar, o que receber e quanto pode gastar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что платить, что получить и сколько можно тратить"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чӣ бояд пардохт ва қабул шавад ва чӣ қадар сарф кардан мумкин аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödemeleriniz, gelecek gelirleriniz ve harcayabileceğiniz tutar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що сплатити, що отримати і скільки можна витратити"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nima to‘lash, nima olish va qancha sarflash mumkin"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應付、應收與可支配金額"
          }
        }
      }
    },
