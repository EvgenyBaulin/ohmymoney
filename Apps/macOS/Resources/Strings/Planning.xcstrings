    "layout.summary.short": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarixinədək planlar mövcud məbləğdən %2$@ çox tələb edir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да %1$@ для планаў не хапае %2$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %1$@ plány převyšují dostupné prostředky o %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis %1$@ verlangen die Pläne %2$@ mehr, als da ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until %1$@ the plans ask %2$@ more than there is"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta el %1$@ los planes piden %2$@ más de lo que hay"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'au %1$@, les plans demandent %2$@ de plus qu'il n'y a"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչև %1$@ պլանների համար պակասում է %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino al %1$@ i piani richiedono %2$@ in più rispetto al disponibile"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-მდე გეგმებისთვის არსებულზე %2$@-ით მეტია საჭირო"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ дейін жоспарлар бар нәрседен %2$@ көп сұрайды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ чейин пландар үчүн дагы %2$@ жетпейт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %1$@ na plany zabraknie %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %1$@, os planos exigem %2$@ a mais do que há disponível"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %1$@ os planos excedem o disponível em %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %1$@ на планы не хватает %2$@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То %1$@ барои нақшаҳо %2$@ намерасад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarihine kadar planlar mevcut tutarı %2$@ aşıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До %1$@ плани вимагають на %2$@ більше, ніж є"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gacha rejalarga mavjud mablag‘dan %2$@ ko‘proq kerak"
          }
        },
