    "reconcile.firstCount.total": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ tarixində %1$@ məbləğində ümumi sayım qeydə alınıb, bundan əvvəl sayım olmayıb. Pulu ilk dəfə saymısınızsa, bu, nə gəlir, nə də xərcdir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падчас агульнага падліку %2$@ запісана %1$@; папярэдніх падлікаў не было. Калі гэта быў першы падлік грошай, сума не з'яўляецца ні даходам, ні расходам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celkový zůstatek %1$@ byl zaznamenán %2$@ a předtím nebyl žádný zůstatek zjištěn. Pokud jste peníze počítali poprvé, nejde o příjem ani výdaj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gesamtzählung von %1$@ hat %2$@ ohne vorherige Zählung erfasst. Wenn Sie das Geld zum ersten Mal gezählt haben, ist es weder Einnahme noch Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one-total count of %1$@ recorded %2$@ with no count before it. If that was the first time you counted the money, it is neither income nor spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recuento de un solo total de %1$@ registrado el %2$@ sin ningún recuento antes. Si era la primera vez que contaba ese dinero, no es ni ingreso ni gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le comptage d'un seul total de %1$@ noté le %2$@, sans comptage avant. Si c'était la première fois que vous comptiez cet argent, il n'est ni revenu ni dépense."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ընդհանուր հաշվարկը գրանցվել է %2$@, և դրանից առաջ հաշվարկ չի եղել։ Եթե առաջին անգամ եք հաշվել գումարը, սա ոչ եկամուտ է, ոչ էլ ծախս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conteggio totale di %1$@ ha registrato %2$@ senza alcun conteggio precedente. Se era la prima volta che contavi il denaro, non è né un'entrata né una spesa."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ საერთო დათვლისას დაფიქსირდა %1$@; მანამდე დათვლა არ ყოფილა. თუ ფული პირველად დათვალეთ, ეს არც შემოსავალია და არც ხარჯი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ бір жиынды санауы %2$@ жазды, оның алдында санау болмаған. Ақшаны алғаш рет санаған болсаңыз, ол табыс та, шығын да емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ күнү жалпы сумма катары %1$@ саналган, ага чейин санак болгон эмес. Эгер акчаны биринчи жолу санаган болсоңуз, бул киреше да, чыгаша да эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączny stan %1$@ zapisano %2$@ bez wcześniejszego sprawdzenia. Jeśli wtedy po raz pierwszy sprawdzono stan środków, nie jest to ani przychód, ani wydatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem do total de %1$@ registrou %2$@ sem uma contagem anterior. Se foi a primeira vez que você contou esse dinheiro, não é receita nem despesa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem do total único de %1$@ registou %2$@ sem uma contagem anterior. Se foi a primeira vez que contou o dinheiro, não é uma receita nem uma despesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверка одной суммой %1$@ записала %2$@, а до неё сверок не было. Если это был первый пересчёт денег, это не доход и не расход."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобкунии умумии %1$@ маблағи %2$@-ро сабт кард ва пеш аз он ҳисобкунӣ набуд. Агар ин ҳисобкунии аввалини пул бошад, он на даромад асту на хароҷот."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ tarihinde toplam %1$@ sayıldı; öncesinde başka sayım yoktu. Parayı ilk kez saydıysanız bu tutar gelir veya gider değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумковий облік %1$@ записав %2$@ без жодного обліку перед ним. Якщо це був перший раз, коли ви порахували гроші, це не дохід і не витрата."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bo‘yicha umumiy sanov %2$@ kuni yozilgan, undan oldin sanov bo‘lmagan. Agar pulni birinchi marta sanagan bo‘lsangiz, bu daromad ham, xarajat ham emas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "於 %2$@ 記錄了 %1$@ 的總額盤點，此前沒有盤點記錄。若這是首次盤點，這筆金額既非收入，也非支出。"
          }
        }
      }
    },
