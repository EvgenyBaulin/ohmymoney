    "advice.load.thresholds": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusiya Bankına görə, yük 50%-dən yüksək, 80%-dən isə çox yüksək sayılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк Расіі лічыць нагрузку высокай ад 50%, а вельмі высокай — ад 80%."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruská centrální banka považuje zátěž od 50 % za vysokou a od 80 % za velmi vysokou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank of Russia nennt eine Last ab 50 % hoch und ab 80 % sehr hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Bank of Russia calls a load high from 50% and very high from 80%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Banco de Rusia considera alta una carga desde el 50 % y muy alta desde el 80 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Banque de Russie juge une charge élevée à partir de 50 % et très élevée à partir de 80 %."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ռուսաստանի բանկը 50%-ից բեռը համարում է բարձր, իսկ 80%-ից՝ շատ բարձր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Banca di Russia considera l'incidenza alta dal 50% e molto alta dall'80%."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რუსეთის ბანკის მიხედვით, დატვირთვა 50%-დან მაღალია, 80%-დან კი — ძალიან მაღალი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресей Банкі жүктемені 50%-дан жоғары, ал 80%-дан өте жоғары деп санайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Россия Банкы 50%дан баштап жүктү жогору, 80%дан баштап өтө жогору деп эсептейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank Rosji uznaje obciążenie za wysokie od 50%, a za bardzo wysokie od 80%."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Banco da Rússia considera o comprometimento alto a partir de 50% e muito alto a partir de 80%."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bank of Russia considera a taxa de esforço alta a partir de 50% e muito alta a partir de 80%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЦБ считает нагрузку высокой от 50 %, очень высокой — от 80 %."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонки Русия бори қарзро аз 50% баланд ва аз 80% хеле баланд мешуморад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusya Merkez Bankası, borç yükünü %50’den itibaren yüksek, %80’den itibaren çok yüksek sayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк Росії називає навантаження високим від 50 %, а дуже високим — від 80 %."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rossiya banki 50% dan yuqori yukni yuqori, 80% dan yuqorisini juda yuqori deb hisoblaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "俄羅斯銀行將 50% 以上列為高負擔，80% 以上列為極高負擔。"
          }
        }
      }
    },
