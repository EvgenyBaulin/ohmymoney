    "reconcile.firstCountToggle.on": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс %@ становіцца пачатковым: без даходу і расходу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Saldo %@ wird zum Ausgangspunkt: keine Einnahme, keine Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance %@ becomes the starting point: no income, no spending."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo di %@ diventa il punto di partenza: nessuna entrata, nessuna spesa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теңгерімі бастапқы нүкте болады: табыс та, шығын да жоқ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток %@ — точка отсчёта, без дохода и расхода."
          }
        }
      }
    },
    "reconcile.firstCountToggleHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да версіі 1.2 пусты баланс запісваўся як нуль, таму гэта, хутчэй за ўсё, першы сапраўдны падлік грошай. Ён стане пачатковым балансам. Зніміце сцяжок, толькі калі той нуль быў сапраўдным."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor Version 1.2 wurde ein leerer Saldo als null geschrieben; deshalb ist dies sehr wahrscheinlich die erste echte Zählung des Geldes, und sie wird zum Ausgangspunkt. Wählen Sie es nur ab, wenn diese Null echt war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before 1.2 an empty balance was written as zero, so this is most likely the first real count of the money, and it becomes the starting point. Untick it only if that zero was real."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima della versione 1.2 un saldo vuoto veniva registrato come zero. Questo è quindi probabilmente il primo conteggio effettivo e diventa il punto di partenza. Deseleziona solo se lo zero era reale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 нұсқасына дейін бос теңгерім нөл ретінде жазылатын, сондықтан бұл көбіне ақшаның алғашқы нақты санауы және ол бастапқы нүкте болады. Нөл нақты болса ғана белгіні алып тастаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 1.2 пустое поле остатка записывалось нулём, поэтому это, скорее всего, первый настоящий пересчёт денег, и он станет точкой отсчёта. Снимите отметку, только если тот ноль был настоящим."
          }
        }
      }
    },
    "reconcile.help": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Параўнайце наяўныя грошы з балансам паводле ўліку"
