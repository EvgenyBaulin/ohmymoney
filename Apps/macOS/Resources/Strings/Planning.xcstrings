    "reconcile.notRecorded": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць розніцу, таму зверка не захавана. Паспрабуйце яшчэ раз або захавайце без запісу."
          }
        },
        "de": {
          "stringUnit": {
