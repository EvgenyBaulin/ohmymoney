    "layout.edit.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перацягніце блок на патрэбнае месца. Парадак таксама можна змяніць у Наладах → Планаванне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Block auf den Platz, den er einnehmen soll. Die Reihenfolge steht auch unter Einstellungen → Planung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a block onto the place it should take. The order is also in Settings → Planning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un blocco nella posizione desiderata. Puoi cambiarne l’ordine anche in Impostazioni → Pianificazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокты қажетті орнына сүйреңіз. Тәртіп «Параметрлер → Жоспарлауда» да бар."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите блок на место, которое он должен занять. Порядок есть и в «Настройки → Планирование»."
          }
        }
      }
    },
