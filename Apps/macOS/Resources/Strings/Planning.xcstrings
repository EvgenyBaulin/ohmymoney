    "layout.empty.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit says how much a category may take in a month, and warns when it runs out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un límite indica cuánto puede gastar una categoría en un mes, y avisa cuando se agota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит говорит, сколько категория может забрать за месяц, и предупреждает, когда он кончается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт показує, скільки категорія може взяти за місяць, і попереджає, коли він закінчується."
          }
        }
      }
    },
