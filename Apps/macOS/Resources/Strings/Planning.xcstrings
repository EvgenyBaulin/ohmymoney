    "reminders.overdue.explain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis ein Fälligkeitstermin abgeschlossen ist, zählt der freie Betrag sein Geld noch als auf dem Konto. Hat die Bank es vor dem Abgleich abgebucht, drücken Sie „Vor dem Abgleich abgebucht“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until a due date is closed, the free sum counts its money as still on the account. If the bank took it before the reconciliation, press «Taken before the reconciliation»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзімі өткен төлем жабылғанша, бос қаржы оның ақшасын әлі есеп-шотта тұр деп санайды. Егер банк оны салыстырудан бұрын алған болса, «Салыстырудан бұрын алынды» түймесін басыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока срок не закрыт, свободная сумма считает, что деньги ещё не ушли. Если банк списал их до сверки, нажмите «Уже списано до сверки»."
          }
        }
      }
    },
