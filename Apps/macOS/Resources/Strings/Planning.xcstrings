    "form.goal.planHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan %@ tarixindən başlayır. Aylıq plandan artıq ayrılan vəsait növbəti aylar üçün hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "План пачынаецца ў %@. Усё, што звыш месячнага плана, залічваецца ў наступныя месяцы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plán začíná v %@. Částka nad měsíční plán se započítá do následujících měsíců."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan beginnt im %@. Was über den Monatsplan hinaus eingelegt wird, zählt für die folgenden Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan starts in %@. What goes in above a month's plan counts towards the following months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan empieza en %@. Lo que se aporta por encima del plan de un mes cuenta para los meses siguientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan commence en %@. Ce qui est versé au-delà du plan d'un mois compte pour les mois suivants."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պլանը սկսվում է %@-ից։ Ամսական պլանից ավելի մուտքագրված գումարը հաշվվում է հաջորդ ամիսների համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano inizia a %@. Gli importi che superano il piano mensile valgono per i mesi successivi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გეგმა იწყება: %@. თვიურ გეგმაზე მეტი შენატანი მომდევნო თვეებში ჩაითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоспар %@ басталады. Айлық жоспардан артық салынғаны келесі айларға есептеледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "План %@ айында башталат. Айлык пландан ашкан салымдар кийинки айларга эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan zaczyna się w %@. Wpłaty ponad miesięczny plan są zaliczane na kolejne miesiące."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano começa em %@. O valor acima do planejado para um mês conta para os meses seguintes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano começa em %@. O que ultrapassar o plano de um mês conta para os meses seguintes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начало плана — %@. Внесённое сверх плана месяца засчитывается в следующие месяцы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нақша аз %@ оғоз мешавад. Маблағи зиёда аз нақшаи моҳ ба моҳҳои оянда ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan %@ tarihinde başlar. Aylık planı aşan katkılar sonraki aylara sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "План починається з %@. Усе, що відкладено понад місячний план, зараховується в наступні місяці."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Reja %@ da boshlanadi. Oylik rejadan ortiq ajratilgan mablag‘ keyingi oylarga hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計畫從 %@ 開始。超過當月計畫的存入金額會計入後續月份。"
          }
        }
      }
    },
