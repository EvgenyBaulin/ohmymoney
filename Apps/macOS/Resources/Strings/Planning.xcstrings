    "advice.load.bank": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк лічыць больш строга: 5% ад ліміту крэдытнай карты, а не ад доўгу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank rechnet strenger: eine Kreditkarte als 5 % ihres Limits, nicht der Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank counts stricter: a credit card as 5% of its limit, not of the debt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca usa un criterio più severo: per una carta di credito calcola il 5% del limite, non del debito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк қатаңырақ санайды: кредиттік карта лимиттің 5%-ы ретінде, берешектің емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк считает строже: кредитка — 5 % от лимита, а не от долга."
          }
        }
      }
    },
