        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр есеп-шотта қазір қанша ақша бар? Әр өрісте кітаптар күткен сома тұр: тек айырмашылығы бар екеуін түзетіңіз."
          }
