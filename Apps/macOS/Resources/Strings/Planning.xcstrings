    "reminders.overdue.settledHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the due date without an operation: the money left before the reconciliation of %@, and its balance already holds that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra el vencimiento sin operación: el dinero salió antes de la conciliación del %@, y su saldo ya lo contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturer l'échéance sans opération : l'argent est parti avant le rapprochement du %@, et son solde le contient déjà."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть срок без операции: деньги ушли до сверки %@, и её остаток это уже учёл."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити строк без операції: гроші пішли до звірки %@, і її залишок їх уже містить."
          }
        }
      }
    },
