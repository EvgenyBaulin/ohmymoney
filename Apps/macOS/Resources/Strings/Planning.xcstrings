    "layout.empty.goals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving for a trip or a new laptop? A goal counts how much to put aside a month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ahorra para un viaje o un portátil nuevo? Un objetivo calcula cuánto apartar al mes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копите на поездку или новый ноутбук? Цель посчитает, сколько откладывать в месяц."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладаєте на поїздку чи новий ноутбук? Ціль покаже, скільки відкладати на місяць."
          }
        }
      }
    },
