    "expected.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income already received stays; only the expectation and its links go. ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso ya recibido se queda; solo se van la previsión y sus vínculos. ⌘Z los devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le revenu déjà reçu reste ; seuls l'attente et ses liens partent. ⌘Z les rétablit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полученные доходы останутся, удалится только ожидание и привязки к нему. ⌘Z вернёт их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід, який уже надійшов, лишається; видаляються лише очікування та їхні зв'язки. ⌘Z їх повертає."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reddito già ricevuto rimane; vengono eliminati solo la previsione e i suoi collegamenti. Premi ⌘Z per ripristinarli."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алынған табыс қалады; тек күту мен оның сілтемелері кетеді. ⌘Z қайтарады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Атрыманы даход застанецца; выдаляцца толькі чаканне і яго сувязі. ⌘Z верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bereits erhaltene Einnahme bleibt; nur die Erwartung und ihre Verknüpfungen gehen. ⌘Z holt sie zurück."
          }
        }
      }
    },
    "expected.deleteMessage.touch": {
      "extractionState": "manual",
      "localizations": {
