    "form.withdraw.noRate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün üçün %2$@ məbləğini %1$@ ilə hesablamaq üçün məzənnə yoxdur; yığılan məbləğlə müqayisə etmək mümkün deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма курсу для разліку %2$@ у %1$@ на гэты дзень: немагчыма праверыць захаваную суму"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento den není k dispozici kurz pro přepočet %2$@ na %1$@, takže částku nelze porovnat s úsporami"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es keinen Kurs, um %2$@ in %1$@ zu berechnen: Es kann nicht gegen das Gespeicherte geprüft werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate to count %2$@ in %1$@ for this day: it cannot be checked against what is saved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tipo para calcular %2$@ en %1$@ de este día: no se puede comprobar con lo guardado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux pour compter %2$@ en %1$@ ce jour-là : impossible de vérifier contre ce qui est enregistré"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս օրվա %2$@-ը %1$@-ով հաշվելու փոխարժեք չկա․ հնարավոր չէ համեմատել կուտակված գումարի հետ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tasso per calcolare %2$@ in %1$@ per questo giorno: impossibile confrontarlo con il risparmio"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ დღისთვის %2$@-ის %1$@-ში გადასაყვანად კურსი არ არის: დანაზოგთან შედარება შეუძლებელია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күн үшін %1$@ ішінде %2$@ санайтын бағам жоқ: сақталғанмен салыстыруға болмайды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул күнгө %2$@ суммасын %1$@ менен эсептөө үчүн курс жок: аны топтолгон сумма менен салыштыруу мүмкүн эмес"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu do przeliczenia %2$@ na %1$@ w tym dniu. Nie można porównać kwoty z oszczędnościami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há cotação para calcular %2$@ em %1$@ neste dia: não é possível comparar com o valor guardado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem taxa para converter %2$@ em %1$@ neste dia: não é possível comparar com o valor guardado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса, чтобы перевести %2$@ в %1$@ на этот день: не проверить, хватит ли накопленного"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ҳисоб кардани %2$@ бо %1$@ дар ин рӯз қурб нест: бо маблағи пасандозшуда муқоиса кардан намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için %2$@ tutarını %1$@ cinsinden hesaplayacak kur yok; birikimle karşılaştırılamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає курсу, щоб порахувати %2$@ у %1$@ на цей день: перевірити із збереженим неможливо"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kun uchun %2$@ni %1$@da hisoblash kursi yo‘q: jamg‘arma bilan solishtirib bo‘lmaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有當天將 %2$@ 換算為 %1$@ 的匯率，無法與已存金額核對"
          }
        }
      }
    },
