    "advice.load.bank": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bank counts stricter: a credit card as 5% of its limit, not of the debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un banco cuenta más estrictamente: una tarjeta de crédito como el 5 % de su límite, no de la deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une banque compte plus strictement : une carte de crédit à 5 % de son plafond, et non de la dette."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк считает строже: кредитка — 5 % от лимита, а не от долга."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк рахує суворіше: кредитну картку — як 5 % її ліміту, а не від боргу."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca usa un criterio più severo: per una carta di credito calcola il 5% del limite, non del debito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк қатаңырақ санайды: кредиттік карта лимиттің 5%-ы ретінде, берешектің емес."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк лічыць больш строга: 5% ад ліміту крэдытнай карты, а не ад доўгу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bank rechnet strenger: eine Kreditkarte als 5 % ihres Limits, nicht der Schuld."
          }
        }
      }
    },
