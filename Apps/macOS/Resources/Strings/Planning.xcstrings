        }
      }
    },
    "reminders.overdue.settled": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzləşdirmədən əvvəl çıxılıb"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спісана да зверкі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Strženo před odsouhlasením"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Abgleich abgebucht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken before the reconciliation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobrado antes de la conciliación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prélevé avant le rapprochement"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գանձվել է մինչև համադրումը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Addebitato prima della riconciliazione"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯერებამდე ჩამოჭრილია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыстырудан бұрын алынды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыштырууга чейин алынган"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrano przed uzgodnieniem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Debitado antes da conciliação"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirado antes da reconciliação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже списано до сверки"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пеш аз муқоиса гирифта шуд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutabakattan önce çekildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списано до звірки"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Solishtirishdan oldin yechilgan"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對帳前已扣款"
          }
        }
      }
    },
    "reminders.overdue.settledHelp": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödəniş tarixini əməliyyatsız bağlayın: pul %@ üzləşdirməsindən əvvəl çıxılıb və qalıqda artıq nəzərə alınıb."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыць тэрмін плацяжу без аперацыі: грошы спісаны да зверкі рахунку %@ і ўжо ўлічаны ў яго балансе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzavřít termín bez operace: peníze odešly před odsouhlasením účtu %@ a jeho zůstatek to již zahrnuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie den Termin ohne Vorgang: Das Geld ging vor dem Abgleich vom %@ ab, und sein Saldo enthält das bereits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the due date without an operation: the money left before the reconciliation of %@, and its balance already holds that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra el vencimiento sin operación: el dinero salió antes de la conciliación del %@, y su saldo ya lo contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturer l'échéance sans opération : l'argent est parti avant le rapprochement du %@, et son solde le contient déjà."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փակել ժամկետը առանց գործարքի․ գումարը դուրս է եկել մինչև %@ հաշվի համադրումը և արդեն արտացոլված է դրա մնացորդում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi la scadenza senza un’operazione: il denaro è uscito prima della riconciliazione di %@ e il saldo ne tiene già conto."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დახურეთ გადახდის ვადა ოპერაციის გარეშე: თანხა %@-ის შეჯერებამდე ჩამოიჭრა და ეს უკვე ასახულია ნაშთში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзімді операциясыз жабыңыз: ақша %@ салыстыруынан бұрын кетті, ал теңгерімде ол бұрыннан бар."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлөм мөөнөтүн операциясыз жабуу: акча %@ салыштырылганга чейин алынган жана анын калдыгында эске алынган."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij termin bez operacji: środki pobrano przed uzgodnieniem %@, a saldo już to uwzględnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre o vencimento sem uma operação: o dinheiro saiu antes da conciliação de %@ e o saldo já reflete isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluir o vencimento sem uma operação: o dinheiro saiu antes da reconciliação de %@ e o saldo já o reflete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть срок без операции: деньги ушли до сверки %@, и её остаток это уже учёл."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муҳлати пардохтро бе амалиёт пӯшед: пул пеш аз муқоисаи %@ гирифта шуда буд ва ин аллакай дар бақия ба назар гирифта шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadeyi işlem oluşturmadan kapatın: para %@ mutabakatından önce çıktı ve bakiyeye zaten yansıdı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити строк без операції: гроші пішли до звірки %@, і її залишок їх уже містить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘lov muddatini amalsiz yopish: pul %@ solishtiruvidan oldin yechilgan va uning qoldig‘ida bu allaqachon hisobga olingan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結清到期項目但不記錄交易：款項已在 %@ 對帳前扣除，餘額已反映此扣款。"
          }
        }
      }
    },
