    "reconcile.rateMissing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Differenz in einer Währung ohne heutigen Kurs kann nicht erfasst werden, daher wurde nichts gespeichert. Drücken Sie ⌘R oder sichern Sie ohne Erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A difference in a currency without a rate today cannot be recorded, so nothing was saved. Press ⌘R, or save without recording."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін бағамы жоқ валютадағы айырманы жазу мүмкін емес, сондықтан ештеңе сақталмады. ⌘R басыңыз, не жазбай сақтаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу в валюте без курса на сегодня не записать, и ничего не сохранено. Нажмите ⌘R или сохраните без записи."
          }
        }
      }
    },
