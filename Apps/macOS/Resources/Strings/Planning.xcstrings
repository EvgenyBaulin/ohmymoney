    "limits.amount.help": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay üçün əlçatandır. Aylıq limiti dəyişmək üçün klikləyin; köçürülən qalıq ayrıca hesablanır. Yadda saxlamaq üçün Return, ləğv etmək üçün Esc düyməsini basın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даступна ў гэтым месяцы. Націсніце, каб змяніць месячны ліміт без уліку пераносу. Return захоўвае, Esc вяртае ранейшае значэнне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K dispozici tento měsíc. Kliknutím změníte měsíční limit bez převedené částky. Return uloží změnu, Esc ji vrátí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar in diesem Monat. Klicken, um das monatliche Limit zu ändern, die Übertragung daneben. Return speichert, Esc setzt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available this month. Click to change the monthly limit, the carry aside. Return saves, Esc puts it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible este mes. Haga clic para cambiar el límite mensual, el traspaso aparte. Intro guarda, Esc lo devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible ce mois-ci. Cliquez pour modifier le plafond mensuel, le report à part. Retour enregistre, Échap le remet en place."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հասանելի է այս ամիս։ Սեղմեք՝ ամսական սահմանաչափը փոխելու համար՝ առանց փոխանցված մնացորդի։ Return-ը պահում է, Esc-ը՝ չեղարկում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile questo mese. Fai clic per modificare il limite mensile, escluso il riporto. Invio salva, Esc annulla."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხელმისაწვდომია ამ თვეში. დააწკაპუნეთ თვიური ლიმიტის შესაცვლელად, გადატანილი თანხის გარეშე. Return ინახავს, Esc აუქმებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда қолжетімді. Айлық лимитті өзгерту үшін басыңыз, көшіру бөлек. Return сақтайды, Esc қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда жеткиликтүү. Айлык лимитти өзгөртүү үчүн басыңыз; калдык өзүнчө эсептелет. Return сактайт, Esc жокко чыгарат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępne w tym miesiącu. Kliknij, aby zmienić miesięczny limit bez przeniesionej kwoty. Return zapisuje, Esc przywraca poprzednią wartość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível neste mês. Clique para alterar o limite mensal, sem o valor acumulado. Return salva, Esc restaura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível este mês. Clique para alterar o limite mensal, sem o valor transitado. Prima Enter para guardar ou Esc para repor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно в этом месяце. Нажмите, чтобы изменить лимит в месяц, без переноса. Return — сохранить, Esc — вернуть как было."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи дастрас дар ин моҳ. Барои тағйири маҳдудияти моҳона бе маблағи интиқолшуда клик кунед. Return захира мекунад, Esc бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay kullanılabilir tutar. Devredilen tutar hariç aylık limiti değiştirmek için tıklayın. Return kaydeder, Esc geri alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно цього місяця. Клацніть, щоб змінити місячний ліміт, перенесення лишається. Return зберігає, Esc повертає як було."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy foydalanish mumkin bo‘lgan summa. Oylik limitni qoldiqdan alohida o‘zgartirish uchun bosing. Return saqlaydi, Esc bekor qiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月可用金額。按一下可更改每月限額，結轉金額另計。按 Return 儲存，按 Esc 還原。"
          }
        }
      }
    },
    "limits.amount.placeholder": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayda"
          }
        },
