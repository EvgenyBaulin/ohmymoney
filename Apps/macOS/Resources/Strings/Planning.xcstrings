    "reconcile.first": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın bir valyutada ilk sayımı başlanğıc nöqtəsidir: onu müqayisə etməyə heç nə yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Першы падлік рахунку ў валюце становіцца пачатковым балансам: параўноўваць яго няма з чым."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První zjištěný zůstatek účtu v dané měně je výchozím stavem: není s čím ho porovnat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Zählung eines Kontos in einer Währung ist sein Ausgangspunkt: Es gibt nichts, womit man sie vergleichen könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first count of an account in a currency is its starting point: there is nothing to compare it with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer recuento de una cuenta en una divisa es su punto de partida: no hay con qué compararlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier comptage d'un compte dans une devise est son point de départ : il n'y a rien à comparer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվի արժույթի առաջին հաշվարկը ելակետն է․ այն համեմատելու բան դեռ չկա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo conteggio di un conto in una valuta è il suo punto di partenza: non c'è nulla con cui confrontarlo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშზე ვალუტის პირველი დათვლა საწყისი წერტილია: მასთან შესადარებელი არაფერია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Валютадағы есеп-шоттың алғашқы санауы — оның бастапқы нүктесі: салыстыратын ештеңе жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептеги валютанын биринчи санаагы баштапкы чекит болот: аны салыштыра турган эч нерсе жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsze sprawdzenie stanu konta w danej walucie jest punktem początkowym: nie ma go z czym porównać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira contagem de uma conta em uma moeda é seu ponto de partida: não há com o que compará-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira contagem de uma conta numa moeda é o ponto de partida: não há nada com que a comparar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая сверка счёта в валюте — точка отсчёта: сравнивать не с чем."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобкунии аввалини суратҳисоб бо асъор нуқтаи оғози он аст: чизе барои муқоиса нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hesabın bir para birimindeki ilk sayımı başlangıç noktasıdır: karşılaştırılacak bir tutar yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перша звірка рахунку в валюті — це точка відліку: порівнювати її ні з чим."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobdagi valyutaning birinchi sanovi boshlang‘ich nuqtadir: uni taqqoslash uchun avvalgi ma’lumot yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶中某種貨幣的首次盤點是起始點，沒有可供比較的金額。"
          }
        }
      }
    },
    "reconcile.firstCount.card": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%3$@» hesabında %2$@ tarixində %1$@ sayımı qeydə alınıb, əvvəl isə hesabın yalnız sıfır ilkin qalığı var idi. Pulu ilk dəfə saymısınızsa, bu, nə gəlir, nə də xərcdir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падчас падліку %2$@ на рахунку «%3$@» запісана %1$@, а да гэтага на рахунку быў толькі нулявы пачатковы баланс. Калі гэта быў першы падлік грошай, сума не з'яўляецца ні даходам, ні расходам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek %1$@ byl zaznamenán %2$@ na účtu «%3$@», který měl předtím jen nulový počáteční stav. Pokud jste peníze počítali poprvé, nejde o příjem ani výdaj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zählung von %1$@ hat %2$@ auf „%3$@“ erfasst, während das Konto vorher nur einen Anfangssaldo von null hatte. Wenn Sie das Geld zum ersten Mal gezählt haben, ist es weder Einnahme noch Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The count of %1$@ recorded %2$@ on «%3$@», while before it the account had only a zero opening balance. If that was the first time you counted the money, it is neither income nor spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recuento de %1$@ registrado el %2$@ en «%3$@», mientras antes la cuenta solo tenía un saldo inicial de cero. Si era la primera vez que contaba ese dinero, no es ni ingreso ni gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le comptage de %1$@ noté le %2$@ sur « %3$@ », alors que jusque-là le compte n'avait qu'un solde d'ouverture nul. Si c'était la première fois que vous comptiez cet argent, il n'est ni revenu ni dépense."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%3$@» հաշվի %1$@ հաշվարկը գրանցվել է %2$@, իսկ մինչ այդ հաշվի սկզբնական մնացորդը զրո էր։ Եթե առաջին անգամ եք հաշվել գումարը, սա ոչ եկամուտ է, ոչ էլ ծախս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conteggio di %1$@ ha registrato %2$@ su «%3$@», mentre prima il conto aveva solo un saldo iniziale pari a zero. Se era la prima volta che contavi il denaro, non è né un'entrata né una spesa."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ დათვლისას «%3$@» ანგარიშზე დაფიქსირდა %1$@, მანამდე კი მხოლოდ ნულოვანი საწყისი ნაშთი იყო. თუ ფული პირველად დათვალეთ, ეს არც შემოსავალია და არც ხარჯი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ санауы «%3$@» есеп-шотында %2$@ жазды, ал бұрын онда тек нөлдік бастапқы теңгерім болған. Бұл ақшаны алғаш рет санаған болсаңыз, ол табыс та, шығын да емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ күнү «%3$@» эсебине %1$@ санака алынган, ал эми ага чейин эсептин баштапкы калдыгы нөл болчу. Эгер акчаны биринчи жолу санаган болсоңуз, бул киреше да, чыгаша да эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan %1$@ zapisano %2$@ na koncie «%3$@», na którym wcześniej było tylko zerowe saldo początkowe. Jeśli wtedy po raz pierwszy sprawdzono stan środków, nie jest to ani przychód, ani wydatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem de %1$@ registrou %2$@ em «%3$@», cujo saldo inicial era zero. Se foi a primeira vez que você contou esse dinheiro, não é receita nem despesa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem de %1$@ registou %2$@ em «%3$@», quando antes a conta tinha apenas um saldo inicial zero. Se foi a primeira vez que contou o dinheiro, não é uma receita nem uma despesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверка %1$@ записала %2$@ на «%3$@», хотя до неё у счёта был только нулевой начальный остаток. Если тогда вы впервые пересчитали деньги, это не доход и не расход."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобкунии %1$@ дар «%3$@» маблағи %2$@-ро сабт кард, дар ҳоле ки пештар танҳо бақияи ибтидоии сифр буд. Агар ин ҳисобкунии аввалини пул бошад, он на даромад асту на хароҷот."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%3$@» hesabında %2$@ tarihinde %1$@ sayıldı; öncesinde hesabın yalnızca sıfır açılış bakiyesi vardı. Parayı ilk kez saydıysanız bu tutar gelir veya gider değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Облік %1$@ записав %2$@ на «%3$@», тоді як раніше на рахунку був лише нульовий початковий залишок. Якщо це був перший раз, коли ви порахували гроші, це не дохід і не витрата."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sanovi %2$@ kuni «%3$@» hisobiga yozilgan, undan oldin esa hisobda faqat nol boshlang‘ich qoldiq bor edi. Agar pulni birinchi marta sanagan bo‘lsangiz, bu daromad ham, xarajat ham emas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%3$@」於 %2$@ 記錄了 %1$@ 的盤點金額，此前帳戶只有零元的期初餘額。若這是首次盤點，這筆金額既非收入，也非支出。"
          }
        }
      }
    },
    "reconcile.firstCount.fix": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, ilk sayım idi — başlanğıc nöqtəsi et"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта быў першы падлік — зрабіць яго пачатковым балансам"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šlo o první zjištění zůstatku — použít jako výchozí stav"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war die erste Zählung — machen Sie sie zum Ausgangspunkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was the first count — make it the starting point"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este era el primer recuento — que sea el punto de partida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'était le premier comptage — en faire le point de départ"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա առաջին հաշվարկն էր․ դարձնել ելակետ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Era il primo conteggio — usa come punto di partenza"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს პირველი დათვლა იყო — გახდეს საწყისი წერტილი"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл алғашқы санау болды — оны бастапқы нүкте етіңіз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул биринчи санак болчу — баштапкы чекит кылуу"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To było pierwsze sprawdzenie — ustaw jako punkt początkowy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foi a primeira contagem — torná-la o ponto de partida"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foi a primeira contagem — usar como ponto de partida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это первая сверка — сделать точкой отсчёта"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ҳисобкунии аввал буд — нуқтаи оғоз шавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ilk sayımdı — başlangıç noktası yap"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це була перша звірка — зробити її точкою відліку"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu birinchi sanov edi — uni boshlang‘ich nuqta qilish"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是首次盤點，設為起始點"
          }
        }
      }
    },
