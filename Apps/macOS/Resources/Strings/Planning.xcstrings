        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la cuenta está archivada — pase el pago a otra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le compte est archivé — déplacez le paiement vers un autre"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "հաշիվն արխիվացված է․ տեղափոխեք վճարումը այլ հաշիվ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "il conto è archiviato: sposta il pagamento su un altro conto"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიში დაარქივებულია — გადაიტანეთ გადახდა სხვა ანგარიშზე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "есеп-шот мұрағатта — төлемді басқасына көшіріңіз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "эсеп архивделген — төлөмдү башка эсепке которуңуз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "konto jest zarchiwizowane — przenieś płatność na inne konto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a conta está arquivada — transfira o pagamento para outra conta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "a conta está arquivada — mova o pagamento para outra conta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "счёт в архиве — перенесите платёж на другой"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "суратҳисоб дар бойгонӣ аст — пардохтро ба суратҳисоби дигар гузаронед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "hesap arşivlenmiş — ödemeyi başka bir hesaba taşıyın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "рахунок в архіві — перенесіть платіж на інший"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "hisob arxivlangan — to‘lovni boshqa hisobga o‘tkazing"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶已封存，請將付款移至其他帳戶"
          }
        }
      }
    },
