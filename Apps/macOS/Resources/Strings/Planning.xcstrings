    "selfEmployed.offer.later": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sual bir dəfə verilir: istənilən vaxt Parametrlər → Planlaşdırma bölməsində aktiv edə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтае пытанне задаецца адзін раз: уключыць можна ў любы час у Наладах → Планаванне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ptáme se jen jednou. Zapnout to můžete kdykoli v Nastavení → Plánování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wird einmal gefragt: Schalten Sie es jederzeit unter Einstellungen → Planung ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is asked once: turn it on any time in Settings → Planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se pregunta una vez: actívelo cuando quiera en Ajustes → Planificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette question n'est posée qu'une fois : activez-le à tout moment dans Réglages → Planification."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցը տրվում է մեկ անգամ․ կարող եք միացնել ցանկացած պահի՝ Կարգավորումներ → Պլանավորում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti verrà chiesto una sola volta: puoi attivarlo quando vuoi in Impostazioni → Pianificazione."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამას მხოლოდ ერთხელ გეკითხებით. ჩართვა ნებისმიერ დროს შეგიძლიათ: პარამეტრები → დაგეგმვა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл бір рет сұралады: оны кез келген уақытта «Параметрлер → Жоспарлау» ішінде қосуға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул бир эле жолу суралат. Каалаган убакта Жөндөөлөр → Пландоо бөлүмүнөн күйгүзсөңүз болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytamy tylko raz. Możesz to włączyć w dowolnej chwili w Ustawienia → Planowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pergunta aparece apenas uma vez. Ative quando quiser em Ajustes → Planejamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pergunta é feita uma só vez. Pode ativar em Definições → Planeamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше не спросим: включить можно в «Настройки → Планирование»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин савол як бор дода мешавад. Шумо метавонед онро ҳар вақт дар Танзимот → Банақшагирӣ фаъол кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu soru bir kez sorulur. Ayarlar → Planlama’dan istediğiniz zaman açabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це питається один раз: увімкнути можна будь-коли в «Налаштування → Планування»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu savol bir marta beriladi: istalgan vaqtda Sozlamalar → Rejalashtirish bo‘limida yoqishingiz mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會詢問一次。你可以隨時在「設定」→「規劃」中開啟。"
          }
        }
      }
    },
