    "advice.badComparison.title": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Шкодныя выдаткі ў параўнанні з мінулымі месяцамі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Ausgaben gegenüber früheren Monaten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad spending against earlier months"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spese superflue rispetto ai mesi precedenti"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаман шығын бұрынғы айлармен салыстырғанда"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плохие траты в сравнении с прошлыми месяцами"
          }
        }
      }
    },
    "advice.badCutScenario.title": {
