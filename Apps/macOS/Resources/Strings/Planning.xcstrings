    "reminders.overdue.explain": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödəniş tarixi bağlanana qədər sərbəst məbləğ bu pulu hesabda sayır. Bank onu üzləşdirmədən əvvəl çıxıbsa, «Üzləşdirmədən əvvəl çıxılıb» seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль тэрмін плацяжу не закрыты, свабодная сума ўлічвае гэтыя грошы на рахунку. Калі банк спісаў іх да зверкі, націсніце «Спісана да зверкі»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud není termín splatnosti uzavřen, volná částka počítá s tím, že peníze jsou stále na účtu. Pokud je banka strhla před odsouhlasením, stiskněte «Strženo před odsouhlasením»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis ein Fälligkeitstermin abgeschlossen ist, zählt der freie Betrag sein Geld noch als auf dem Konto. Hat die Bank es vor dem Abgleich abgebucht, drücken Sie „Vor dem Abgleich abgebucht“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until a due date is closed, the free sum counts its money as still on the account. If the bank took it before the reconciliation, press «Taken before the reconciliation»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que un vencimiento se cierre, la suma libre cuenta su dinero como todavía en la cuenta. Si el banco lo cobró antes de la conciliación, pulse «Cobrado antes de la conciliación»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant qu'une échéance n'est pas clôturée, la somme libre compte son argent comme encore sur le compte. Si la banque l'a prélevé avant le rapprochement, appuyez sur « Prélevé avant le rapprochement »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քանի դեռ վճարման ժամկետը փակված չէ, ազատ գումարի հաշվարկում այդ գումարը մնում է հաշվում։ Եթե բանկը գանձել է այն մինչև համադրումը, սեղմեք «Գանձվել է մինչև համադրումը»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché una scadenza non viene chiusa, l’importo libero considera il denaro ancora sul conto. Se la banca lo ha addebitato prima della riconciliazione, premi «Addebitato prima della riconciliazione»."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სანამ გადახდის ვადა დახურული არ არის, თავისუფალ თანხაში ის კვლავ ანგარიშზე არსებულად ითვლება. თუ ბანკმა თანხა შეჯერებამდე ჩამოჭრა, დააჭირეთ «შეჯერებამდე ჩამოჭრილია»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзімі өткен төлем жабылғанша, бос қаржы оның ақшасын әлі есеп-шотта тұр деп санайды. Егер банк оны салыстырудан бұрын алған болса, «Салыстырудан бұрын алынды» түймесін басыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлөм мөөнөтү жабылганга чейин, эркин сумма аны эсептеги акча катары эсептейт. Эгер банк акчаны салыштырууга чейин алса, «Салыштырууга чейин алынган» баскычын басыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki termin płatności nie zostanie zamknięty, wolna kwota uwzględnia te środki jako pozostające na koncie. Jeśli bank pobrał je przed uzgodnieniem, naciśnij «Pobrano przed uzgodnieniem»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que um vencimento seja encerrado, o saldo livre considera que o dinheiro ainda está na conta. Se o banco o debitou antes da conciliação, pressione «Debitado antes da conciliação»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até um vencimento ser concluído, o montante disponível considera que o dinheiro ainda está na conta. Se o banco o retirou antes da reconciliação, prima «Retirado antes da reconciliação»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока срок не закрыт, свободная сумма считает, что деньги ещё не ушли. Если банк списал их до сверки, нажмите «Уже списано до сверки»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То баста шудани муҳлати пардохт, маблағи озод ин пулро дар суратҳисоб ҳисоб мекунад. Агар бонк онро пеш аз муқоиса гирифта бошад, «Пеш аз муқоиса гирифта шуд»-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ödeme vadesi kapatılana kadar serbest tutar, parayı hâlâ hesapta sayar. Banka parayı mutabakattan önce çektiyse «Mutabakattan önce çekildi» seçeneğine basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доки строк платежу не закрито, вільна сума рахує його гроші як ще на рахунку. Якщо банк списав їх до звірки, натисніть «Списано до звірки»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘lov muddati yopilmaguncha, erkin summa uning pulini hali hisobda deb hisoblaydi. Agar bank pulni solishtirishdan oldin yechgan bo‘lsa, «Solishtirishdan oldin yechilgan» tugmasini bosing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在到期項目結清前，可用金額會將該筆款項視為仍在帳戶中。若銀行已在對帳前扣款，請按「對帳前已扣款」。"
          }
        }
      }
    },
