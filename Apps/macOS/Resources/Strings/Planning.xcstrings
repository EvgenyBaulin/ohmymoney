    "reconcile.notSaved": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzləşdirmə saxlanmadı və heç nə yazılmadı. Yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверка не захавана, нічога не запісана. Паспрабуйце яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsouhlasení nebylo uloženo a nic se nezapsalo. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abgleich wurde nicht gespeichert, und nichts wurde geschrieben. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reconciliation was not saved, and nothing was written. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conciliación no se guardó y no se escribió nada. Inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapprochement n'a pas été enregistré, et rien n'a été écrit. Réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համադրումը չի պահպանվել, և ոչինչ չի գրանցվել։ Կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riconciliazione non è stata salvata e non è stato registrato nulla. Riprova."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯერება არ შენახულა და არაფერი ჩაწერილა. სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыстыру сақталмады, ештеңе жазылмады. Қайталап көріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыштыруу сакталган жок, эч нерсе жазылган жок. Кайра аракет кылыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zachowano uzgodnienia ani nie zapisano żadnych danych. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conciliação não foi salva e nada foi registrado. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A reconciliação não foi guardada e nada foi registado. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверка не сохранилась, ничего не записано. Попробуйте ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муқоиса нигоҳ дошта нашуд ва чизе сабт нашуд. Аз нав кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutabakat kaydedilmedi ve hiçbir şey yazılmadı. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звірку не збережено, і нічого не записано. Спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Solishtirish saqlanmadi va hech narsa yozilmadi. Qayta urinib ko‘ring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未儲存對帳，也未寫入任何資料。請再試一次。"
          }
        }
      }
    },
    "reconcile.nothingCounted": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ heç nə sayılmayıb: ən azı bir hesabın qalığını daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль нічога не падлічана: увядзіце баланс хаця б аднаго рахунку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není zjištěn žádný zůstatek: zadejte zůstatek alespoň jednoho účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist noch nichts gezählt: Tragen Sie den Saldo mindestens eines Kontos ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is counted yet: type the balance of at least one account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se cuenta nada: escriba el saldo de al menos una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore compté : saisissez le solde d'au moins un compte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ ոչինչ հաշվված չէ․ մուտքագրեք առնվազն մեկ հաշվի մնացորդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora inserito nulla: inserisci il saldo di almeno un conto."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არაფერი დათვლილა: შეიყვანეთ სულ მცირე ერთი ანგარიშის ნაშთი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге ештеңе санамадыңыз: кем дегенде бір есеп-шоттың теңгерімін теріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча эч нерсе санала элек: жок дегенде бир эсептин калдыгын киргизиңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie sprawdzono jeszcze żadnego stanu: wpisz saldo co najmniej jednego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi contado ainda: digite o saldo de pelo menos uma conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há valores contados: introduza o saldo de pelo menos uma conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не сосчитано: введите остаток хотя бы одного счёта."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло чизе ҳисоб нашудааст: бақияи ҳадди ақал як суратҳисобро ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sayım yapılmadı: en az bir hesabın bakiyesini girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще нічого не порахувано: введіть залишок хоча б одного рахунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali hech narsa sanalmagan: kamida bitta hisob qoldig‘ini kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未盤點任何金額：請輸入至少一個帳戶的餘額。"
          }
        }
      }
    },
