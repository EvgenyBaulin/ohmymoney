        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld kommt auch an einem anderen Tag des Monats — zum Beispiel am 15. und am letzten Tag: Jeder Termin ist eine eigene Einnahme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money comes on another day of the month too — for example on the 15th and on the last day: each term is an income of its own"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша айдың басқа күнінде де келеді — мысалы 15-інде және айдың соңғы күнінде: әр мерзім өз алдына табыс"
          }
        },
        "ru": {
