    "namesake.financial.notSaved": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося завяршыць дзеянне. Праверце, ці не занятыя назва і псеўданімы сярод актыўных запісаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion konnte nicht abgeschlossen werden. Prüfe, ob der Name und die Aliasse unter den aktiven Einträgen verfügbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action could not be completed. Check that the name and aliases are available among active records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido completar la acción. Comprueba que el nombre y los alias estén disponibles entre los registros activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer l’action. Vérifiez que le nom et les alias sont disponibles parmi les entrées actives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l’azione. Verifica che il nome e gli alias siano disponibili tra le voci attive."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әрекетті аяқтау мүмкін болмады. Атау мен бүркеншік аттардың белсенді жазбаларда бос екенін тексеріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ukończyć operacji. Sprawdź, czy nazwa i aliasy nie są używane przez aktywne wpisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a ação. Verifique se o nome e os aliases estão disponíveis entre os registros ativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить действие. Проверьте, свободны ли имя и псевдонимы среди действующих записей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem tamamlanamadı. Adın ve takma adların etkin kayıtlarda kullanılmadığından emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося виконати дію. Перевірте, чи назва та псевдоніми не зайняті активними записами."
          }
        }
      }
    },
