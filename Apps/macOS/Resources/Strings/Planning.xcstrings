            "value": "Importo non valido"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს თანხა არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сома емес"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сумма эмес"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest prawidłowa kwota"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
