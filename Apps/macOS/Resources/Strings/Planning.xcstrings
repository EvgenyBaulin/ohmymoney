    "limits.amount.carryRestart": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni məbləğ qalıq köçürülməsini yenidən başladır: indi %@ köçürülür"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая сума пачне перанос нанова: цяпер перанесена %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nová částka znovu spustí převádění: nyní se převádí %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Betrag beginnt die Übertragung neu: %@ wird jetzt übertragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new amount starts the carry again: %@ is carried over now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un importe nuevo vuelve a empezar el traspaso: ahora se traspasa %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau montant relance le report : %@ est reporté maintenant"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նոր գումարից փոխանցումը վերսկսվում է․ այժմ փոխանցվում է %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo importo riavvia il riporto: ora vengono riportati %@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალი თანხით გადატანა თავიდან იწყება: ახლა გადატანილია %@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа сома көшіруді қайта бастайды: қазір %@ көшіріледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңы сумма калдыкты кайра эсептөөнү баштайт: азыр %@ которулат"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa kwota rozpoczyna przenoszenie od nowa: obecnie przeniesiono %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo valor reinicia o acúmulo: %@ é transferido agora"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo valor reinicia o transporte: %@ transita agora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая сумма начнёт перенос заново: сейчас перенесено %@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи нав интиқолро аз нав оғоз мекунад: ҳоло %@ интиқол меёбад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir tutar devri yeniden başlatır: Şu anda %@ devrediliyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нова сума починає перенесення знову: зараз переноситься %@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi summa qoldiq hisobini qayta boshlaydi: hozir %@ o‘tkaziladi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新金額會重新開始結轉：目前結轉 %@"
          }
        }
      }
    },
