    "form.notSaved": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yadda saxlanmadı. Sahələri yoxlayıb yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не захавана. Праверце палі і паспрабуйце яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuloženo. Zkontrolujte pole a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gespeichert. Prüfen Sie die Felder und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not saved. Check the fields and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardó. Revise los campos e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non enregistré. Vérifiez les champs et réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չպահվեց։ Ստուգեք դաշտերը և կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non salvato. Controlla i campi e riprova."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არ შენახულა. შეამოწმეთ ველები და სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақталмады. Өрістерді тексеріп, қайталап көріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сакталган жок. Талааларды текшерип, кайра аракет кылыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano. Sprawdź pola i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi salvo. Confira os campos e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi guardado. Verifique os campos e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сохранилось. Проверьте поля и попробуйте ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Захира нашуд. Майдонҳоро санҷед ва дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilemedi. Alanları denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не збережено. Перевірте поля й спробуйте знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Saqlanmadi. Maydonlarni tekshirib, qayta urinib ko‘ring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未儲存。請檢查欄位並再試一次。"
          }
        }
      }
    },
