    "form.goal.transfers": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Таксама пераводзіць на гэты рахунак пры размеркаванні"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und beim Verteilen auf dieses Konto überweisen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And transfer to this account when allocating"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y transferir a esta cuenta al distribuir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et virer sur ce compte lors de la répartition"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasferisci su questo conto durante l’assegnazione"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлгенде осы есеп-шотқа аудару да"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelewaj też na to konto przy podziale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferir para esta conta ao distribuir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И переводить на этот счёт при распределении"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dağıtırken bu hesaba da aktar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "І переказувати на цей рахунок під час розподілу"
          }
        }
      }
    },
    "form.goal.transfers.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры размеркаванні даходу ўнёсак і перавод на гэты рахунак робяцца разам. Перавод можна выключыць у форме."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Einnahme verteilt wird: der Beitrag und eine Überweisung auf dieses Konto in einem Schritt; das Blatt kann es abwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an income is allocated: the contribution and a transfer to this account, one step; the sheet can untick it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al distribuir un ingreso: la aportación y una transferencia a esta cuenta, en un solo paso; la hoja permite desmarcarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de la répartition d'un revenu : la contribution et un virement vers ce compte, en une étape ; la feuille peut le décocher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando assegni un reddito, il contributo e il trasferimento su questo conto avvengono insieme; puoi deselezionare l’opzione nel pannello."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табыс бөлінгенде: салым және осы есеп-шотқа аударым бір қадамда; парақта оны алып тастауға болады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy podziale przychodu wpłata i przelew na to konto są wykonywane razem. Można to wyłączyć w formularzu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao distribuir uma receita, a contribuição e a transferência para esta conta são feitas juntas. A transferência pode ser desmarcada na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При распределении дохода — взнос и перевод на этот счёт одним шагом; в листе галочку можно снять."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelir dağıtılırken katkı ve bu hesaba aktarım tek adımda yapılır; ekranda seçim kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли дохід розподіляється: внесок і переказ на цей рахунок в один крок; аркуш може це зняти."
          }
        }
      }
    },
