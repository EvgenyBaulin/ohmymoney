            "value": "Жаман шығын азайса, “%@” тезірек"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Менш шкодных выдаткаў — «%@» хутчэй"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger schlechte Ausgaben, „%@“ früher"
          }
        }
      }
    },
