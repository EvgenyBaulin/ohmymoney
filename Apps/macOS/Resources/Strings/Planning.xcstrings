      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income already received stays; only the expectation and its links go. ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso ya recibido se queda; solo se van la previsión y sus vínculos. ⌘Z los devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le revenu déjà reçu reste ; seuls l'attente et ses liens partent. ⌘Z les rétablit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полученные доходы останутся, удалится только ожидание и привязки к нему. ⌘Z вернёт их."
          }
        },
        "uk": {
