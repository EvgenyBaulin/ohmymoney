    "reconcile.notRecorded": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fərqi qeydə almaq mümkün olmadı, buna görə üzləşdirmə saxlanmadı. Yenidən cəhd edin və ya qeydə almadan saxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць розніцу, таму зверка не захавана. Паспрабуйце яшчэ раз або захавайце без запісу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdíl se nepodařilo zaznamenat, takže odsouhlasení nebylo uloženo. Zkuste to znovu nebo uložte bez zaznamenání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Differenz konnte nicht erfasst werden, daher wurde der Abgleich nicht gespeichert. Versuchen Sie es erneut oder sichern Sie ihn ohne Erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The difference could not be recorded, so the reconciliation was not saved. Try again, or save it without recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La diferencia no se pudo registrar, así que la conciliación no se guardó. Inténtelo de nuevo, o guárdela sin registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écart n'a pas pu être noté, donc le rapprochement n'a pas été enregistré. Réessayez, ou enregistrez-le sans noter."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերությունը հնարավոր չեղավ գրանցել, ուստի համադրումը չի պահպանվել։ Կրկին փորձեք կամ պահեք առանց գրանցելու։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare la differenza. La riconciliazione non è stata salvata. Riprova o salva senza registrare."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვაობა ვერ ჩაიწერა, ამიტომ შეჯერება არ შენახულა. სცადეთ ხელახლა ან შეინახეთ ჩაწერის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айырманы жазу мүмкін болмады, сондықтан салыстыру сақталмады. Қайталап көріңіз, не жазбай сақтаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айырманы жазуу мүмкүн болбогондуктан, салыштыруу сакталган жок. Кайра аракет кылыңыз же айырманы жазбай сактаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać różnicy, więc uzgodnienie nie zostało zachowane. Spróbuj ponownie lub zachowaj je bez zapisywania różnicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registrar a diferença, então a conciliação não foi salva. Tente novamente ou salve sem registrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registar a diferença, pelo que a reconciliação não foi guardada. Tente novamente ou guarde sem registar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разницу записать не удалось, и сверка не сохранена. Попробуйте ещё раз или сохраните её без записи."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фарқ сабт нашуд, бинобар ин муқоиса нигоҳ дошта нашуд. Аз нав кӯшиш кунед ё бе сабти фарқ нигоҳ доред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fark işlenemediği için mutabakat kaydedilmedi. Yeniden deneyin veya farkı işlemeden kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різницю не вдалося записати, тож звірку не збережено. Спробуйте ще раз або збережіть без запису."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Farqni yozib bo‘lmadi, shuning uchun solishtirish saqlanmadi. Qayta urinib ko‘ring yoki yozmasdan saqlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法記錄差額，因此未儲存對帳。請再試一次，或儲存但不記錄差額。"
          }
        }
      }
    },
