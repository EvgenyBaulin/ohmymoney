    "purchase.mileage.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilometrləri daxil edin; yürüş son yanacaq doldurulmasından hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце кіламетры; прабег разлічваецца ад апошняй запраўкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte stav tachometru. Ujetá vzdálenost se počítá od posledního tankování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie die Kilometer ein; der Kilometerstand wird ab dem letzten Tanken gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the kilometres; the mileage is counted from the last fill-up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba los kilómetros; el kilometraje se cuenta desde el último repostaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les kilomètres ; le kilométrage se calcule depuis le dernier plein."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք կիլոմետրերը․ վազքը հաշվարկվում է վերջին լիցքավորումից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci i chilometri; la percorrenza viene calcolata dall’ultimo rifornimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走行距離を入力してください。前回の給油時との差を計算します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ კილომეტრები; გარბენი ბოლო გამართვიდან დაითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Километрді теріңіз; жүрген жол соңғы толтырудан бері есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "킬로미터를 입력하세요. 지난 주유 이후 주행 거리를 계산합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Километрди киргизиңиз; жүрүлгөн жол акыркы май куюудан тартып эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de kilometerstand in. De afstand wordt berekend sinds de laatste tankbeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz stan licznika w kilometrach. Przebieg zostanie obliczony od ostatniego tankowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite os quilômetros; a distância é calculada desde o último abastecimento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza os quilómetros; a distância é calculada desde o último abastecimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите километры: пробег посчитается от прошлой заправки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Километрҳоро ворид кунед; масофа аз сӯзишгирии охирин ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilometreyi girin; mesafe son yakıt alımından itibaren hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть кілометри; пробіг рахується від останньої заправки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilometrni kiriting; masofa oxirgi yonilg‘i quyishdan boshlab hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入公里数；行驶里程从上次加油时开始计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入公里數；行駛里程會從上次加油時計算。"
          }
        }
      }
    },
    "purchase.mileage.messageFirst": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, yürüşü qeyd edilən ilk yanacaq doldurulmasıdır. Göstəricidəki rəqəmi daxil edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта першая запраўка з указаннем прабегу. Увядзіце паказанне одометра."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jde o první tankování se stavem tachometru. Zadejte údaj z palubní desky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist das erste Tanken mit einem Kilometerstand. Tragen Sie ein, was das Armaturenbrett zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the first fill-up with a mileage. Type what the dashboard shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el primer repostaje con kilometraje. Escriba lo que muestra el cuadro de mandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le premier plein avec un kilométrage. Saisissez ce qu'affiche le tableau de bord."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա վազքի ցուցումով առաջին լիցքավորումն է։ Մուտքագրեք վահանակի ցուցմունքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il primo rifornimento con chilometraggio. Inserisci il valore indicato sul cruscotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走行距離を記録する最初の給油です。メーターの表示を入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს პირველი გამართვაა გარბენის მითითებით. შეიყვანეთ დაფაზე ნაჩვენები მაჩვენებელი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүрген жолмен бұл алғашқы толтыру. Панельде көрсетілгенін теріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주행 거리를 입력하는 첫 주유입니다. 계기판에 표시된 값을 입력하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул — жүрүлгөн жолу көрсөтүлгөн биринчи май куюу. Тактадагы көрсөткүчтү киргизиңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de eerste tankbeurt met een kilometerstand. Voer de stand op het dashboard in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To pierwsze tankowanie z zapisanym stanem licznika. Wpisz wskazanie licznika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o primeiro abastecimento com quilometragem. Digite o valor mostrado no painel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o primeiro abastecimento com quilometragem. Introduza o valor indicado no painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это первая заправка с пробегом. Напишите, что показывает приборная панель."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин аввалин сӯзишгирӣ бо нишондиҳандаи масофа аст. Нишондиҳандаи ҳисобкунакро ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kilometre bilgisi girilen ilk yakıt alımı. Göstergedeki değeri girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це перша заправка з пробігом. Введіть те, що показує панель приладів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu masofa kiritilayotgan birinchi yonilg‘i quyish. Asboblar panelidagi ko‘rsatkichni kiriting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是首次记录加油里程。请输入仪表盘显示的数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是首次記錄里程的加油。請輸入儀表板顯示的數字。"
          }
        }
      }
    },
