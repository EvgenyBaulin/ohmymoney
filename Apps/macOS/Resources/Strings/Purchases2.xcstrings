    "person.giftBudget.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За тыдзень да дня нараджэння праграма нагадае пра яго і прапануе стварыць падзею з гэтым бюджэтам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Woche vor dem Geburtstag erinnert die App Sie und bietet ein Ereignis mit diesem Budget an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A week before the birthday the app reminds you and offers an event with this budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semana antes del cumpleaños la app se lo recuerda y ofrece un evento con este presupuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une semaine avant l'anniversaire, l'app vous le rappelle et propose un événement avec ce budget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una settimana prima del compleanno, l’app ti ricorda la data e propone un evento con questo budget."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Туған күнге бір апта қалғанда қолданба еске салып, осы бюджетпен іс-шара ұсынады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tydzień przed urodzinami aplikacja przypomni o nich i zaproponuje wydarzenie z tym budżetem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За неделю до дня рождения приложение напомнит и предложит событие с этим бюджетом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, doğum gününden bir hafta önce hatırlatma yapar ve bu bütçeyle bir etkinlik önerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За тиждень до дня народження застосунок нагадає і запропонує подію з цим бюджетом."
          }
        }
      }
    },
