    "person.giftBudget.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq ad günündən bir həftə əvvəl xatırladacaq və bu büdcə ilə tədbir təklif edəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За тыдзень да дня нараджэння праграма нагадае пра яго і прапануе стварыць падзею з гэтым бюджэтам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Týden před narozeninami vám aplikace připomene narozeniny a nabídne vytvoření události s tímto rozpočtem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Woche vor dem Geburtstag erinnert die App Sie und bietet ein Ereignis mit diesem Budget an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A week before the birthday the app reminds you and offers an event with this budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semana antes del cumpleaños la app se lo recuerda y ofrece un evento con este presupuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une semaine avant l'anniversaire, l'app vous le rappelle et propose un événement avec ce budget."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծննդյան օրից մեկ շաբաթ առաջ հավելվածը կհիշեցնի և կառաջարկի այս բյուջեով իրադարձություն ստեղծել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una settimana prima del compleanno, l’app ti ricorda la data e propone un evento con questo budget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誕生日の1週間前に通知し、この予算でイベントの作成を提案します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაბადების დღემდე ერთი კვირით ადრე აპი შეგახსენებთ და ამ ბიუჯეტით ღონისძიებას შემოგთავაზებთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Туған күнге бір апта қалғанда қолданба еске салып, осы бюджетпен іс-шара ұсынады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생일 일주일 전에 알림을 보내고 이 예산으로 이벤트를 제안합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Туулган күнгө бир жума калганда колдонмо эскертип, ушул бюджет менен иш-чара түзүүнү сунуштайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een week voor de verjaardag krijg je een herinnering en stelt de app een activiteit met dit budget voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tydzień przed urodzinami aplikacja przypomni o nich i zaproponuje wydarzenie z tym budżetem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma semana antes do aniversário, o app lembra você e sugere um evento com este orçamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma semana antes do aniversário, a app lembra-o e sugere um evento com este orçamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За неделю до дня рождения приложение напомнит и предложит событие с этим бюджетом."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома як ҳафта пеш аз зодрӯз ёдрас мекунад ва рӯйдодеро бо ин буҷет пешниҳод мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, doğum gününden bir hafta önce hatırlatma yapar ve bu bütçeyle bir etkinlik önerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За тиждень до дня народження застосунок нагадає і запропонує подію з цим бюджетом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova tug‘ilgan kundan bir hafta oldin eslatadi va shu budjet bilan tadbir yaratishni taklif qiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生日一周前，App 会提醒你并建议创建含此预算的活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生日一週前，App 會提醒你並建議建立含此預算的活動。"
          }
        }
      }
    },
