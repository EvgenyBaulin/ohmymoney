    "calendar.birthday.notCreated": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tədbir yaradılmadı: eynisi artıq mövcuddur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падзея не створана: такая ўжо існуе"
