    "purchase.mileage.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце кіламетры; прабег разлічваецца ад апошняй запраўкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie die Kilometer ein; der Kilometerstand wird ab dem letzten Tanken gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the kilometres; the mileage is counted from the last fill-up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba los kilómetros; el kilometraje se cuenta desde el último repostaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les kilomètres ; le kilométrage se calcule depuis le dernier plein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci i chilometri; la percorrenza viene calcolata dall’ultimo rifornimento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Километрді теріңіз; жүрген жол соңғы толтырудан бері есептеледі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz stan licznika w kilometrach. Przebieg zostanie obliczony od ostatniego tankowania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите километры: пробег посчитается от прошлой заправки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilometreyi girin; mesafe son yakıt alımından itibaren hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть кілометри; пробіг рахується від останньої заправки."
          }
        }
      }
    },
    "purchase.mileage.messageFirst": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта першая запраўка з указаннем прабегу. Увядзіце паказанне одометра."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist das erste Tanken mit einem Kilometerstand. Tragen Sie ein, was das Armaturenbrett zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the first fill-up with a mileage. Type what the dashboard shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el primer repostaje con kilometraje. Escriba lo que muestra el cuadro de mandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le premier plein avec un kilométrage. Saisissez ce qu'affiche le tableau de bord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il primo rifornimento con chilometraggio. Inserisci il valore indicato sul cruscotto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүрген жолмен бұл алғашқы толтыру. Панельде көрсетілгенін теріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To pierwsze tankowanie z zapisanym stanem licznika. Wpisz wskazanie licznika."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
