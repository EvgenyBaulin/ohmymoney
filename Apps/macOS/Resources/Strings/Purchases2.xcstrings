    "purchase.mileage.question": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son yanacaq doldurulmasından nə qədər yol getmisiniz?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колькі вы праехалі з апошняй запраўкі?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik jste ujeli od posledního tankování?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit sind Sie seit dem letzten Tanken gefahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far did you drive since the last fill-up?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuántos kilómetros recorrió desde el último repostaje?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de kilomètres avez-vous roulé depuis le dernier plein ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որքա՞ն եք անցել վերջին լիցքավորումից հետո։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti chilometri hai percorso dall’ultimo rifornimento?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の給油から何キロ走りましたか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რამდენი გაიარეთ ბოლო გამართვის შემდეგ?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы толтырудан бері қанша жүрдіңіз?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 주유 이후 얼마나 주행했나요?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы май куюудан бери канча жол жүрдүңүз?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver heb je gereden sinds de laatste tankbeurt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile kilometrów przejechano od ostatniego tankowania?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos quilômetros você rodou desde o último abastecimento?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos quilómetros percorreu desde o último abastecimento?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько проехали с прошлой заправки?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз сӯзишгирии охирин чӣ қадар роҳ тай кардед?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son yakıt alımından bu yana ne kadar yol yaptınız?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки ви проїхали з останньої заправки?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi yonilg‘i quyishdan beri qancha yo‘l bosdingiz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次加油后行驶了多远？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
