    "purchase.pause.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hazırda xərcləyə biləcəyiniz vəsaitin %2$@ %% hissəsidir. Alışı qeyd edə və ya gözləyə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — гэта %2$@ %% грошай, якія можна патраціць цяпер. Можна запісаць куплю або пачакаць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ představuje %2$@ %% peněz, které teď můžete utratit. Nákup můžete zaznamenat, nebo počkat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sind %2$@ %% des Geldes, das Sie jetzt ausgeben können. Sie können es erfassen oder warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is %2$@ %% of the money you can spend now. You can record it or wait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es el %2$@ % del dinero que puede gastar ahora. Puede registrarla o esperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ représente %2$@ %% de l'argent que vous pouvez dépenser maintenant. Vous pouvez le noter ou attendre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը այժմ ծախսելու համար հասանելի գումարի %2$@ %%-ն է։ Կարող եք գրանցել գնումը կամ սպասել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è il %2$@ %% del denaro che puoi spendere ora. Puoi registrare l’acquisto o aspettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は、今使えるお金の%2$@ %%です。記録するか、購入を待つことができます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ იმ თანხის %2$@ %%-ია, რომლის დახარჯვაც ახლა შეგიძლიათ. შეგიძლიათ ჩაწეროთ ან მოიცადოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — қазір жұмсауға болатын ақшаңыздың %2$@ %%. Жазуға да, күтуге де болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 지금 쓸 수 있는 금액의 %2$@ %%입니다. 기록하거나 기다릴 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — азыр сарптай ала турган акчаңыздын %2$@ %%. Сатып алууну жазсаңыз же күтө турсаңыз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is %2$@ %% van het geld dat je nu kunt uitgeven. Je kunt de aankoop vastleggen of wachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to %2$@ %% środków, które możesz teraz wydać. Możesz zapisać zakup lub poczekać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ representa %2$@ %% do dinheiro que você pode gastar agora. Você pode registrar a compra ou esperar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ corresponde a %2$@ %% do dinheiro que pode gastar agora. Pode registar a compra ou esperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — это %2$@ %% свободных денег. Можно записать сейчас или подождать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@ %% аз маблағест, ки ҳоло метавонед сарф кунед. Метавонед онро сабт кунед ё интизор шавед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, şu anda harcayabileceğiniz paranın %% %2$@ kadarını oluşturuyor. Kaydedebilir veya bekleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@ %% від грошей, які можна витратити зараз. Можна записати або почекати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hozir sarflashingiz mumkin bo‘lgan pulning %2$@ %% qismini tashkil qiladi. Xaridni qayd etishingiz yoki kutishingiz mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 占你当前可用资金的 %2$@ %%。你可以记录或等等再买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 佔你目前可支配金額的 %2$@ %%。你可以記錄這筆購買或稍後再買。"
          }
        }
      }
    },
    "purchase.pause.messageNoShare": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, sərbəst vəsait isə hesablanmayıb. Alışı qeyd edə və ya gözləyə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Свабодныя грошы не разлічаны. Можна запісаць куплю або пачакаць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, žádné volné peníze nejsou k dispozici. Nákup můžete zaznamenat, nebo počkat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, und es wird kein freies Geld gezählt. Sie können es erfassen oder warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, and no free money is counted. You can record it or wait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, y no se cuenta dinero libre. Puede registrarla o esperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, et aucun argent libre n'est compté. Vous pouvez le noter ou attendre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@․ ազատ գումար հաշվարկված չէ։ Կարող եք գրանցել գնումը կամ սպասել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, e non è stato calcolato denaro disponibile. Puoi registrare l’acquisto o aspettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。使えるお金は計算されていません。記録するか、購入を待つことができます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ხოლო თავისუფალი თანხა არ არის დათვლილი. შეგიძლიათ ჩაწეროთ ან მოიცადოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, және бос ақша есептелмеген. Жазуға да, күтуге де болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 쓸 수 있는 금액이 계산되지 않았습니다. 기록하거나 기다릴 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ал эми бош акча эсептелген жок. Сатып алууну жазсаңыз же күтө турсаңыз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, en er is geen vrij besteedbaar geld berekend. Je kunt de aankoop vastleggen of wachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — nie obliczono dostępnych środków. Możesz zapisać zakup lub poczekać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, e não há dinheiro disponível calculado. Você pode registrar a compra ou esperar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, sem dinheiro disponível calculado. Pode registar a compra ou esperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, а свободных денег нет. Можно записать сейчас или подождать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Маблағи озод ҳисоб нашудааст. Метавонед онро сабт кунед ё интизор шавед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; harcanabilir para hesaplanmadı. Kaydedebilir veya bekleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, і вільних грошей не враховано. Можна записати або почекати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, sarflash mumkin bo‘lgan mablag‘ hisoblanmagan. Xaridni qayd etishingiz yoki kutishingiz mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，尚未计算可用资金。你可以记录或等等再买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，目前未計算出可支配金額。你可以記錄這筆購買或稍後再買。"
          }
        }
      }
    },
