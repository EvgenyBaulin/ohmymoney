            "state": "translated",
            "value": "Сначала выберите папку обмена."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аввал ҷузвдони мубодиларо интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce paylaşım klasörünü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку виберіть папку обміну."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval almashuv jildini tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择交换文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選擇交換資料夾。"
          }
        }
      }
    },
    "sync.bootstrap.notEmpty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada artıq qeydlər var, ona görə də onlar əvəz edilməyəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут ужо ёсць запісы, таму яны не будуць заменены."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde už jsou záznamy, proto nebudou nahrazeny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es schon Einträge, daher werden sie nicht ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are already records here, so they are not replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí ya hay registros, así que no se reemplazan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a déjà des enregistrements ici, donc ils ne sont pas remplacés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այստեղ արդեն գրառումներ կան, ուստի դրանք չեն փոխարինվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono già presenti dei dati, quindi non verranno sostituiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに記録があるため、置き換えられません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქ უკვე არის ჩანაწერები, ამიტომ ისინი არ შეიცვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда жазбалар бар, сондықтан олар ауыстырылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул жерде жазуулар бар, ошондуктан алар алмаштырылбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn hier al gegevens, dus deze worden niet vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Są tu już wpisy, więc nie zostaną zastąpione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existem registros aqui, portanto eles não serão substituídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existem registos neste dispositivo, pelo que não serão substituídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь уже есть записи, поэтому их не заменяют."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин ҷо аллакай сабтҳо мавҷуданд, аз ин рӯ онҳо иваз карда намешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada zaten kayıtlar var, bu yüzden değiştirilmediler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут уже є записи, тому вони не замінюються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerda yozuvlar bor, shuning uchun ular almashtirilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处已有记录，因此不会替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處已有紀錄，因此不會取代。"
          }
        }
      }
    },
