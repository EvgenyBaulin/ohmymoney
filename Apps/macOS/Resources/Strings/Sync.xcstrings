    "sync.bootstrap.reopen": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Цалкам закрыйце праграму і адкрыйце яе зноў: даныя будуць загружаны пры запуску."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie die App vollständig und öffnen Sie sie erneut: Die Daten werden beim Start an ihren Platz gelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app completely and open it again: the data is put in place at launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre la app por completo y ábrala de nuevo: los datos se colocan al iniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez complètement l'app puis rouvrez-la : les données sont mises en place au lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi completamente l’app e riaprila: i dati verranno ripristinati all’avvio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбаны толық жауып, қайта ашыңыз: деректер іске қосылғанда қойылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij całkowicie aplikację i otwórz ją ponownie. Dane zostaną wczytane przy uruchomieniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью закройте приложение и откройте снова: данные подставятся при запуске."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı tamamen kapatıp yeniden açın. Veriler açılışta yerleştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повністю закрийте застосунок і відкрийте знову: дані застосовуються під час запуску."
          }
        }
      }
    },
