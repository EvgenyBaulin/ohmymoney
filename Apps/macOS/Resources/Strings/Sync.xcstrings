    "sync.bootstrap.staged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten sind bereit. Starten Sie die App neu, um sie zu sehen."
