    "sync.bootstrap.newerVersion": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüsxə tətbiqin daha yeni versiyasında yaradılıb. Tətbiqi yeniləyib yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія створана ў навейшай версіі праграмы. Абнавіце праграму і паспрабуйце яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopii vytvořila novější verze aplikace. Aktualizujte aplikaci a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie wurde von einer neueren Version der App geschrieben. Aktualisieren Sie diese App und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy was written by a newer version of the app. Update this app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia la escribió una versión más reciente de la app. Actualice esta app e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie a été écrite par une version plus récente de l'app. Mettez cette app à jour et réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատճենը ստեղծվել է հավելվածի ավելի նոր տարբերակով։ Թարմացրեք հավելվածը և կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia è stata creata con una versione più recente dell’app. Aggiorna l’app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーは新しいバージョンのアプリで作成されました。アプリをアップデートして、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ასლი აპის უფრო ახალი ვერსიით შეიქმნა. განაახლეთ აპი და სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірме қолданбаның жаңарақ нұсқасымен жазылған. Қолданбаны жаңартып, қайталаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көчүрмө колдонмонун жаңыраак версиясында жазылган. Колдонмону жаңыртып, кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopie is gemaakt met een nieuwere versie van de app. Werk de app bij en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopię zapisano w nowszej wersji aplikacji. Uaktualnij aplikację i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia foi criada por uma versão mais recente do app. Atualize o app e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia foi criada por uma versão mais recente da app. Atualize a app e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копию записала более новая версия приложения. Обновите это приложение и повторите."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нусха бо версияи навтари барнома сохта шудааст. Барномаро навсозӣ карда, дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopya, uygulamanın daha yeni bir sürümüyle yazılmış. Uygulamayı güncelleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію записала новіша версія застосунку. Оновіть цей застосунок і спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nusxa ilovaning yangiroq versiyasida yaratilgan. Ilovani yangilab, qayta urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此副本由较新版本的 App 写入。请更新此 App 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此副本由較新版本的 App 建立。請更新 App 後再試一次。"
          }
        }
      }
    },
    "sync.bootstrap.noSnapshot": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qovluqda hələ məlumat nüsxəsi yoxdur. Digər cihazda tətbiqi eyni qovluqla açın və nüsxənin yaradılmasını gözləyin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У папцы пакуль няма копіі даных. Адкрыйце праграму на іншай прыладзе з гэтай жа папкай і дачакайцеся стварэння копіі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složka zatím neobsahuje kopii dat. Otevřete aplikaci na druhém zařízení se stejnou složkou a počkejte, až se kopie uloží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner enthält noch keine Kopie der Daten. Öffnen Sie die App auf dem anderen Gerät mit demselben Ordner und warten Sie, bis sie die Kopie schreibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder holds no copy of the data yet. Open the app on the other device with this same folder and wait until it writes the copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta todavía no tiene una copia de los datos. Abra la app en el otro dispositivo con esta misma carpeta y espere a que escriba la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier ne contient pas encore de copie des données. Ouvrez l'app sur l'autre appareil avec ce même dossier et attendez qu'elle écrive la copie."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թղթապանակում դեռ տվյալների պատճեն չկա։ Բացեք հավելվածը մյուս սարքում՝ օգտագործելով նույն թղթապանակը, և սպասեք պատճենի ստեղծմանը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella non contiene ancora una copia dei dati. Apri l’app sull’altro dispositivo con la stessa cartella e attendi che la copia venga creata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダにはまだデータのコピーがありません。別のデバイスでこのフォルダを使ってアプリを開き、コピーが作成されるまでお待ちください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საქაღალდეში მონაცემების ასლი ჯერ არ არის. გახსენით აპი სხვა მოწყობილობაზე იმავე საქაღალდით და დაელოდეთ ასლის შექმნას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалтада әлі деректер көшірмесі жоқ. Басқа құрылғыда осы қалтамен қолданбаны ашып, көшірме жазылғанша күтіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Папкада маалыматтардын көчүрмөсү азырынча жок. Башка түзмөктө колдонмону ушул эле папка менен ачып, көчүрмө жазылганча күтүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De map bevat nog geen kopie van de gegevens. Open de app op het andere apparaat met dezelfde map en wacht tot de kopie is gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder nie zawiera jeszcze kopii danych. Otwórz aplikację na drugim urządzeniu z tym samym folderem i poczekaj na zapisanie kopii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta ainda não contém uma cópia dos dados. Abra o app no outro dispositivo com esta mesma pasta e aguarde a criação da cópia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta ainda não contém uma cópia dos dados. Abra a app no outro dispositivo com esta mesma pasta e aguarde até que a cópia seja criada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке пока нет копии данных. Откройте приложение на другом устройстве с этой же папкой и подождите, пока оно запишет копию."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҷузвдон ҳоло нусхаи маълумот нест. Барномаро дар дастгоҳи дигар бо ҳамин ҷузвдон кушоед ва то сабт шудани нусха интизор шавед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörde henüz veri kopyası yok. Diğer aygıtta aynı klasörü kullanarak uygulamayı açın ve kopyanın yazılmasını bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці ще немає копії даних. Відкрийте застосунок на іншому пристрої з цією самою папкою та зачекайте, поки він запише копію."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jildda hali ma’lumotlar nusxasi yo‘q. Boshqa qurilmada ilovani shu jild bilan oching va nusxa saqlanishini kuting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹中尚无数据副本。请在另一台设备上打开 App 并使用同一文件夹，等待副本写入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案夾中尚無資料副本。請在另一部裝置上以相同檔案夾開啟 App，並等候寫入副本。"
          }
        }
      }
    },
