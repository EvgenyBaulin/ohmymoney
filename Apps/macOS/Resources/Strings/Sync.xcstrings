      }
    },
    "sync.conflicts.footnote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis Sie wählen, ist die andere Fassung nicht in Ihren Büchern gespeichert und in keiner Summe enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you choose, the other version is not saved in your books and is in no sum."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдағанша басқа нұсқа есебіңізге сақталмайды және ешбір сомаға кірмейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы не выбрали, чужая версия не записана и не попадает в суммы."
