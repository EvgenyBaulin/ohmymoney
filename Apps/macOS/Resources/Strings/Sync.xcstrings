    "sync.conflicts.empty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No conflicts. A record changed on two devices at once waits here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликтов нет. Запись, изменённая на двух устройствах сразу, будет ждать здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфліктів немає. Тут очікують записи, змінені одночасно на двох пристроях."
          }
        }
      }
    },
    "sync.conflicts.explain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left — mine (this device), right — the other device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слева — моя (это устройство), справа — другая."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліворуч — моє (цей пристрій), праворуч — інший пристрій."
          }
        }
      }
    },
    "sync.conflicts.footnote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you choose, the other version is not saved in your books and is in no sum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы не выбрали, чужая версия не записана и не попадает в суммы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До вашого вибору інша версія не записується в облік і не входить до жодної суми."
          }
        }
      }
    },
