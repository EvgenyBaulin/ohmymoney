          "stringUnit": {
            "state": "translated",
            "value": "No hay conflictos. Aquí espera un registro cambiado en dos dispositivos a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun conflit. Un enregistrement modifié sur deux appareils à la fois attend ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conflitto. Gli elementi modificati contemporaneamente su due dispositivi vengono mostrati qui."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайшылық жоқ. Екі құрылғыда бірдей өзгерген жазбалар осында күтеді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak konfliktów. Tutaj pojawi się wpis zmieniony jednocześnie na dwóch urządzeniach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликтов нет. Запись, изменённая на двух устройствах сразу, будет ждать здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çakışma yok. İki aygıtta aynı anda değiştirilen kayıtlar burada bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфліктів немає. Тут очікують записи, змінені одночасно на двох пристроях."
          }
        }
      }
    },
    "sync.conflicts.explain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Злева — маё (гэта прылада), справа — з іншай прылады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links — meins (dieses Gerät), rechts — das andere Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left — mine (this device), right — the other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la izquierda, el mío (este dispositivo); a la derecha, el otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À gauche — le mien (cet appareil), à droite — l'autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A sinistra: la mia versione (questo dispositivo). A destra: l’altro dispositivo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сол жақта — менікі (осы құрылғы), оң жақта — басқа құрылғы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po lewej — moje (to urządzenie), po prawej — drugie urządzenie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слева — моя (это устройство), справа — другая."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol: benimki (bu aygıt), sağ: diğer aygıt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліворуч — моє (цей пристрій), праворуч — інший пристрій."
          }
        }
      }
    },
    "sync.conflicts.footnote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль вы не зробіце выбар, іншая версія не захаваецца ў вашых запісах і не будзе ўлічана ў сумах."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis Sie wählen, ist die andere Fassung nicht in Ihren Büchern gespeichert und in keiner Summe enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you choose, the other version is not saved in your books and is in no sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que elija, la otra versión no se guarda en sus cuentas y no entra en ninguna suma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous n'avez pas choisi, l'autre version n'est pas enregistrée dans vos comptes et n'entre dans aucune somme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché non scegli, l’altra versione non viene salvata nei tuoi dati né inclusa nei totali."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдағанша басқа нұсқа есебіңізге сақталмайды және ешбір сомаға кірмейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do czasu wyboru druga wersja nie jest zapisywana w Twoich danych ani uwzględniana w sumach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы не выбрали, чужая версия не записана и не попадает в суммы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim yapana kadar diğer sürüm kayıtlarınıza eklenmez ve toplamlara dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До вашого вибору інша версія не записується в облік і не входить до жодної суми."
          }
        }
      }
    },
