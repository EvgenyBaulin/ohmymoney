        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data is ready. Restart the app to see it."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер дайын. Көру үшін қолданбаны қайта іске қосыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные готовы. Перезапустите приложение, чтобы они появились."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані готові. Перезапустіть застосунок, щоб побачити їх."
          }
        }
      }
    },
