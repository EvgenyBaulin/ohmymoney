    "sync.conflicts.footnote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you choose, the other version is not saved in your books and is in no sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que elija, la otra versión no se guarda en sus cuentas y no entra en ninguna suma."
