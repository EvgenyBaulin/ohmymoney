    "sync.bootstrap.reopen": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqi tam bağlayıb yenidən açın: məlumatlar açılışda yüklənəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Цалкам закрыйце праграму і адкрыйце яе зноў: даныя будуць загружаны пры запуску."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úplně ukončete aplikaci a znovu ji otevřete. Data se načtou při spuštění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie die App vollständig und öffnen Sie sie erneut: Die Daten werden beim Start an ihren Platz gelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app completely and open it again: the data is put in place at launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre la app por completo y ábrala de nuevo: los datos se colocan al iniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez complètement l'app puis rouvrez-la : les données sont mises en place au lancement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամբողջությամբ փակեք հավելվածը և կրկին բացեք․ տվյալները կներմուծվեն գործարկման ժամանակ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi completamente l’app e riaprila: i dati verranno ripristinati all’avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを完全に終了してから、もう一度開いてください。起動時にデータが適用されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სრულად დახურეთ აპი და ხელახლა გახსენით: მონაცემები გაშვებისას ჩაიტვირთება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбаны толық жауып, қайта ашыңыз: деректер іске қосылғанда қойылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмону толугу менен жаап, кайра ачыңыз: маалыматтар ачылганда орнотулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de app volledig af en open deze opnieuw. De gegevens worden bij het opstarten geplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij całkowicie aplikację i otwórz ją ponownie. Dane zostaną wczytane przy uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o app completamente e abra-o novamente: os dados serão carregados na inicialização."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche a app por completo e volte a abri-la. Os dados serão carregados ao iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью закройте приложение и откройте снова: данные подставятся при запуске."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барномаро пурра пӯшед ва боз кушоед: маълумот ҳангоми оғоз ҷойгир мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı tamamen kapatıp yeniden açın. Veriler açılışta yerleştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повністю закрийте застосунок і відкрийте знову: дані застосовуються під час запуску."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilovani butunlay yoping va qayta oching: ma’lumotlar ishga tushishda o‘rnatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请完全退出 App，然后重新打开：数据将在启动时载入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請完全結束 App 並重新開啟。資料會在啟動時載入。"
          }
        }
      }
    },
