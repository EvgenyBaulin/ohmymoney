    "sync.conflicts.explain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left — mine (this device), right — the other device."
          }
        },
        "es": {
