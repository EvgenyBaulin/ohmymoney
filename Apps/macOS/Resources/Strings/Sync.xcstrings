    "sync.conflicts.empty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziddiyyət yoxdur. İki cihazda eyni vaxtda dəyişdirilən qeydlər burada görünəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Канфліктаў няма. Тут з’яўляюцца запісы, змененыя адначасова на дзвюх прыладах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné konflikty. Zde se zobrazí záznamy změněné současně na dvou zařízeních."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Konflikte. Ein Eintrag, der auf zwei Geräten zugleich geändert wurde, wartet hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No conflicts. A record changed on two devices at once waits here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay conflictos. Aquí espera un registro cambiado en dos dispositivos a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun conflit. Un enregistrement modifié sur deux appareils à la fois attend ici."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հակասություններ չկան։ Երկու սարքում միաժամանակ փոխված գրառումները կհայտնվեն այստեղ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conflitto. Gli elementi modificati contemporaneamente su due dispositivi vengono mostrati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "競合はありません。2台のデバイスで同時に変更された記録がここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კონფლიქტები არ არის. აქ გამოჩნდება ორ მოწყობილობაზე ერთდროულად შეცვლილი ჩანაწერი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайшылық жоқ. Екі құрылғыда бірдей өзгерген жазбалар осында күтеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карама-каршылыктар жок. Эки түзмөктө бир убакта өзгөртүлгөн жазуу бул жерде күтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen conflicten. Gegevens die op twee apparaten tegelijk zijn gewijzigd, verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak konfliktów. Tutaj pojawi się wpis zmieniony jednocześnie na dwóch urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum conflito. Registros alterados ao mesmo tempo em dois dispositivos aparecerão aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conflitos. Os registos alterados em dois dispositivos ao mesmo tempo aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликтов нет. Запись, изменённая на двух устройствах сразу, будет ждать здесь."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ихтилофе нест. Сабте, ки ҳамзамон дар ду дастгоҳ тағйир ёфтааст, дар ин ҷо пайдо мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çakışma yok. İki aygıtta aynı anda değiştirilen kayıtlar burada bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфліктів немає. Тут очікують записи, змінені одночасно на двох пристроях."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziddiyatlar yo‘q. Ikki qurilmada bir vaqtda o‘zgartirilgan yozuvlar shu yerda ko‘rinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有冲突。同时在两台设备上更改的记录会显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有衝突。同時在兩部裝置上更改的紀錄會顯示於此。"
          }
        }
      }
    },
    "sync.conflicts.explain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Solda — mənimki (bu cihaz), sağda — digər cihaz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Злева — маё (гэта прылада), справа — з іншай прылады."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlevo moje verze (toto zařízení), vpravo verze z druhého zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links — meins (dieses Gerät), rechts — das andere Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left — mine (this device), right — the other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la izquierda, el mío (este dispositivo); a la derecha, el otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À gauche — le mien (cet appareil), à droite — l'autre appareil."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձախում՝ իմը (այս սարքը), աջում՝ մյուս սարքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A sinistra: la mia versione (questo dispositivo). A destra: l’altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左：このデバイス、右：別のデバイス"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მარცხნივ — ჩემი (ეს მოწყობილობა), მარჯვნივ — სხვა მოწყობილობა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сол жақта — менікі (осы құрылғы), оң жақта — басқа құрылғы."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сол жакта — меники (бул түзмөк), оң жакта — башка түзмөктөгү."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Links: mijn versie (dit apparaat), rechts: het andere apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po lewej — moje (to urządzenie), po prawej — drugie urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À esquerda, sua versão neste dispositivo; à direita, a versão do outro dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À esquerda, a minha versão (neste dispositivo); à direita, a do outro dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слева — моя (это устройство), справа — другая."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чап — аз они ман (ин дастгоҳ), рост — дастгоҳи дигар."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol: benimki (bu aygıt), sağ: diğer aygıt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліворуч — моє (цей пристрій), праворуч — інший пристрій."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapda — meniki (shu qurilma), o‘ngda — boshqa qurilmaniki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左侧为我的版本（此设备），右侧为另一台设备的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左側為我的版本（此裝置），右側為另一部裝置的版本。"
          }
        }
      }
    },
    "sync.conflicts.footnote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim edənədək digər versiya qeydlərinizdə saxlanılmır və heç bir məbləğə daxil edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль вы не зробіце выбар, іншая версія не захаваецца ў вашых запісах і не будзе ўлічана ў сумах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud nevyberete, druhá verze se neuloží do vašich záznamů ani nezapočítá do součtů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis Sie wählen, ist die andere Fassung nicht in Ihren Büchern gespeichert und in keiner Summe enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you choose, the other version is not saved in your books and is in no sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que elija, la otra versión no se guarda en sus cuentas y no entra en ninguna suma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous n'avez pas choisi, l'autre version n'est pas enregistrée dans vos comptes et n'entre dans aucune somme."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչ ընտրություն կատարելը մյուս տարբերակը չի պահվում ձեր գրառումներում և չի ներառվում գումարներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché non scegli, l’altra versione non viene salvata nei tuoi dati né inclusa nei totali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択するまで、別のデバイスの内容は帳簿に保存されず、合計にも含まれません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არჩევამდე სხვა ვერსია თქვენს მონაცემებში არ შეინახება და არცერთ ჯამში არ ჩაითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдағанша басқа нұсқа есебіңізге сақталмайды және ешбір сомаға кірмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сиз тандаганга чейин башка версия эсебиңизде сакталбайт жана суммаларга кошулбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot je een keuze maakt, wordt de andere versie niet in je administratie bewaard en niet meegeteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do czasu wyboru druga wersja nie jest zapisywana w Twoich danych ani uwzględniana w sumach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até você escolher, a outra versão não será salva nos seus registros nem incluída nos totais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até fazer uma escolha, a outra versão não é guardada nos seus registos nem incluída nos totais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы не выбрали, чужая версия не записана и не попадает в суммы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То интихоби шумо версияи дигар дар дафтарҳои шумо нигоҳ дошта намешавад ва ба ягон маблағ дохил намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim yapana kadar diğer sürüm kayıtlarınıza eklenmez ve toplamlara dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До вашого вибору інша версія не записується в облік і не входить до жодної суми."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlov qilmaguningizcha, boshqa versiya hisoblaringizda saqlanmaydi va summalarga kiritilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你选择前，另一版本不会存入账本，也不会计入任何总额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你選擇之前，另一個版本不會儲存至帳簿，也不會計入任何總額。"
          }
        }
      }
    },
