            "state": "translated",
            "value": "從檔案夾載入資料"
          }
        }
      }
    },
    "sync.bootstrap.loading": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlar yüklənir…"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка даных…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten werden geladen…"
          }
        },
        "en": {
