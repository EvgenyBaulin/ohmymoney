    "sync.error.database": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişiklikləri verilənlər bazasına yazmaq mümkün olmadı. Heç nə itirilməyib; yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося захаваць змены ў базе даных. Нічога не страчана. Паспрабуйце яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny se nepodařilo uložit do databáze. Nic se neztratilo. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank hat die Änderungen nicht übernommen. Nichts ging verloren; versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database did not take the changes. Nothing was lost; try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó los cambios. No se perdió nada; inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté les modifications. Rien n'a été perdu ; réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների շտեմարանը չընդունեց փոփոխությունները։ Ոչինչ չի կորել․ կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database non ha acquisito le modifiche. Non è stato perso nulla; riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースに変更を保存できませんでした。データは失われていません。もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცვლილებები მონაცემთა ბაზაში ვერ შეინახა. არაფერი დაკარგულა; სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор өзгерістерді қабылдамады. Ештеңе жоғалмады; қайталаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат базасы өзгөртүүлөрдү кабыл алган жок. Эч нерсе жоголгон жок; кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijzigingen konden niet in de database worden opgeslagen. Er is niets verloren gegaan. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać zmian w bazie danych. Niczego nie utracono. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados não aceitou as alterações. Nada foi perdido; tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A base de dados não aceitou as alterações. Nada foi perdido; tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База не приняла изменения. Ничего не потеряно, повторите."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойгоҳи додаҳо тағйиротро қабул накард. Ҳеҷ чиз гум нашуд; дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler veritabanına kaydedilemedi. Hiçbir şey kaybolmadı; yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База даних не прийняла зміни. Нічого не втрачено; спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasi o‘zgarishlarni qabul qilmadi. Hech narsa yo‘qolmadi; qayta urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将更改存入数据库。没有数据丢失，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫無法套用更改，資料並未遺失。請再試一次。"
          }
        }
      }
    },
    "sync.error.filesNotReadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mübadilə fayllarını şifrələmək və ya oxumaq mümkün olmadı. İlk cihazınızda açar yaradın və ya digər cihazlarda onun 24 bərpa sözünü daxil edin. Bütün cihazlarda OhMyMoney-ni yeniləyib yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося зашыфраваць або прачытаць файлы абмену. Стварыце ключ на першай прыладзе або ўвядзіце яго 24 словы для аднаўлення на іншых прыладах. Абнавіце OhMyMoney на ўсіх прыладах і паспрабуйце яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory pro výměnu se nepodařilo zašifrovat nebo přečíst. Na prvním zařízení vytvořte klíč nebo na ostatních zařízeních zadejte jeho 24 slov pro obnovení. Aktualizujte OhMyMoney na všech zařízeních a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Austauschdateien konnten nicht verschlüsselt oder gelesen werden. Legen Sie auf Ihrem ersten Gerät einen Schlüssel an oder geben Sie auf anderen Geräten seine 24 Wiederherstellungswörter ein. Aktualisieren Sie OhMyMoney auf allen Geräten und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exchange files could not be encrypted or read. Create a key on your first device or enter its 24 recovery words on other devices. Update OhMyMoney on all devices, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de intercambio no se pudieron cifrar ni leer. Cree una clave en su primer dispositivo o introduzca sus 24 palabras de recuperación en los demás dispositivos. Actualice OhMyMoney en todos los dispositivos e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers d'échange n'ont pas pu être chiffrés ni lus. Créez une clé sur votre premier appareil ou saisissez ses 24 mots de récupération sur les autres appareils. Mettez OhMyMoney à jour sur tous les appareils, puis réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց գաղտնագրել կամ կարդալ փոխանակման ֆայլերը։ Ստեղծեք բանալի ձեր առաջին սարքում կամ մուտքագրեք դրա վերականգնման 24 բառերը մյուս սարքերում։ Թարմացրեք OhMyMoney-ը բոլոր սարքերում և կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile crittografare o leggere i file di scambio. Crea una chiave sul primo dispositivo o inserisci le sue 24 parole di recupero sugli altri dispositivi. Aggiorna OhMyMoney su tutti i dispositivi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有ファイルを暗号化または読み取れませんでした。最初のデバイスでキーを作成するか、ほかのデバイスで24個の復旧用の単語を入力してください。すべてのデバイスでOhMyMoneyをアップデートしてから、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაცვლის ფაილების დაშიფვრა ან წაკითხვა ვერ მოხერხდა. შექმენით გასაღები პირველ მოწყობილობაზე ან შეიყვანეთ მისი აღდგენის 24 სიტყვა სხვა მოწყობილობებზე. განაახლეთ OhMyMoney ყველა მოწყობილობაზე და სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмасу файлдарын шифрлау не оқу мүмкін болмады. Бірінші құрылғыда кілт жасаңыз немесе басқа құрылғыларда оның 24 қалпына келтіру сөзін енгізіңіз. Барлық құрылғыда OhMyMoney жаңартып, қайталаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмашуу файлдарын шифрлөө же окуу мүмкүн болгон жок. Биринчи түзмөгүңүздө ачкыч түзүңүз же башка түзмөктөрдө анын 24 калыбына келтирүү сөзүн киргизиңиз. Бардык түзмөктөрдө OhMyMoney колдонмосун жаңыртып, кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitwisselingsbestanden konden niet worden versleuteld of gelezen. Maak een sleutel aan op je eerste apparaat of voer de 24 herstelwoorden daarvan in op je andere apparaten. Werk OhMyMoney bij op alle apparaten en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaszyfrować ani odczytać plików wymiany. Utwórz klucz na pierwszym urządzeniu lub wprowadź jego 24 słowa odzyskiwania na pozostałych urządzeniach. Uaktualnij OhMyMoney na wszystkich urządzeniach i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criptografar ou ler os arquivos de troca. Crie uma chave no primeiro dispositivo ou digite suas 24 palavras de recuperação nos outros dispositivos. Atualize o OhMyMoney em todos os dispositivos e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível cifrar ou ler os ficheiros de partilha. Crie uma chave no primeiro dispositivo ou introduza as respetivas 24 palavras de recuperação nos outros dispositivos. Atualize o OhMyMoney em todos os dispositivos e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зашифровать или прочитать файлы обмена. На первом устройстве создайте ключ, на других введите его 24 слова восстановления. Обновите OhMyMoney на всех устройствах и повторите обмен."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рамзгузорӣ ё хондани файлҳои мубодила муяссар нашуд. Дар дастгоҳи аввал калид созед ё 24 калимаи барқарорсозии онро дар дастгоҳҳои дигар ворид кунед. OhMyMoney-ро дар ҳамаи дастгоҳҳо навсозӣ карда, дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım dosyaları şifrelenemedi veya okunamadı. İlk aygıtınızda bir anahtar oluşturun veya diğer aygıtlarda 24 kurtarma sözcüğünü girin. Tüm aygıtlarda OhMyMoney uygulamasını güncelleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зашифрувати або прочитати файли обміну. Створіть ключ на першому пристрої або введіть його 24 слова відновлення на інших. Оновіть OhMyMoney на всіх пристроях і спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Almashuv fayllarini shifrlab yoki o‘qib bo‘lmadi. Birinchi qurilmangizda kalit yarating yoki boshqa qurilmalarda uning 24 ta tiklash so‘zini kiriting. Barcha qurilmalarda OhMyMoney ilovasini yangilab, qayta urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加密或读取交换文件。请在第一台设备上创建密钥，或在其他设备上输入其 24 个恢复词。在所有设备上更新 OhMyMoney，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法加密或讀取交換檔案。請在第一部裝置上建立金鑰，或在其他裝置上輸入該金鑰的 24 個復原詞。請更新所有裝置上的 OhMyMoney，然後再試一次。"
          }
        }
      }
    },
    "sync.error.folderMissing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mübadilə qovluğu əlçatan deyil. iCloud Drive-ın aktiv olduğunu yoxlayın və ya qovluğu yenidən seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка для абмену недаступная. Праверце, ці ўключаны iCloud Drive, або выберыце папку зноў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složka pro výměnu není dostupná. Zkontrolujte, zda je zapnutý iCloud Drive, nebo složku vyberte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Austauschordner ist nicht verfügbar. Prüfen Sie, ob iCloud Drive eingeschaltet ist, oder wählen Sie den Ordner erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exchange folder is not available. Check that iCloud Drive is on, or choose the folder again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de intercambio no está disponible. Compruebe que iCloud Drive esté activado, o elija la carpeta de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier d'échange n'est pas disponible. Vérifiez que iCloud Drive est activé, ou choisissez à nouveau le dossier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխանակման թղթապանակը հասանելի չէ։ Ստուգեք՝ արդյոք iCloud Drive-ը միացված է, կամ կրկին ընտրեք թղթապանակը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella di scambio non è disponibile. Verifica che iCloud Drive sia attivo o scegli di nuovo la cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダを利用できません。iCloud Driveがオンになっているか確認するか、フォルダを選び直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაცვლის საქაღალდე მიუწვდომელია. შეამოწმეთ, ჩართულია თუ არა iCloud Drive, ან ხელახლა აირჩიეთ საქაღალდე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмасу қалтасы қолжетімсіз. iCloud Drive қосылғанын тексеріңіз немесе қалтаны қайта таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмашуу папкасы жеткиликсиз. iCloud Drive күйгүзүлгөнүн текшериңиз же папканы кайра тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitwisselingsmap is niet beschikbaar. Controleer of iCloud Drive is ingeschakeld of kies de map opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder wymiany jest niedostępny. Sprawdź, czy iCloud Drive jest włączony, lub wybierz folder ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de troca não está disponível. Verifique se o iCloud Drive está ativado ou escolha a pasta novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de partilha não está disponível. Verifique se o iCloud Drive está ativado ou escolha novamente a pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка обмена недоступна. Проверьте iCloud Drive или выберите папку заново."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷузвдони мубодила дастрас нест. Санҷед, ки iCloud Drive фаъол аст ё ҷузвдонро аз нав интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım klasörüne ulaşılamıyor. iCloud Drive'ın açık olduğunu denetleyin veya klasörü yeniden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка обміну недоступна. Перевірте, чи ввімкнено iCloud Drive, або виберіть папку знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Almashuv jildiga kirib bo‘lmayapti. iCloud Drive yoqilganini tekshiring yoki jildni qayta tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换文件夹不可用。请检查 iCloud Drive 是否已开启，或重新选择文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交換資料夾無法使用。請確認 iCloud Drive 已開啟，或重新選擇檔案夾。"
          }
        }
      }
    },
    "sync.error.folderNotReadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mübadilə qovluğundakı faylları oxumaq mümkün deyil. Heç nə itirilməyib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося прачытаць файлы ў папцы для абмену. Нічога не страчана."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory ve složce pro výměnu nelze přečíst. Nic se neztratilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien im Austauschordner können nicht gelesen werden. Nichts ging verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files in the exchange folder cannot be read. Nothing was lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de la carpeta de intercambio no se pueden leer. No se perdió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers du dossier d'échange ne peuvent pas être lus. Rien n'a été perdu."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հնարավոր չէ կարդալ փոխանակման թղթապանակի ֆայլերը։ Ոչինչ չի կորել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i file nella cartella di scambio. Non è stato perso nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダ内のファイルを読み取れません。データは失われていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაცვლის საქაღალდეში არსებული ფაილები ვერ იკითხება. არაფერი დაკარგულა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмасу қалтасындағы файлдарды оқу мүмкін емес. Ештеңе жоғалмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмашуу папкасындагы файлдарды окуу мүмкүн эмес. Эч нерсе жоголгон жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestanden in de uitwisselingsmap kunnen niet worden gelezen. Er is niets verloren gegaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać plików w folderze wymiany. Niczego nie utracono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ler os arquivos na pasta de troca. Nada foi perdido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ler os ficheiros na pasta de partilha. Nada foi perdido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы в папке обмена не читаются. Ничего не потеряно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хондани файлҳои ҷузвдони мубодила имкон надорад. Ҳеҷ чиз гум нашуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım klasöründeki dosyalar okunamıyor. Hiçbir şey kaybolmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли в папці обміну не читаються. Нічого не втрачено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Almashuv jildidagi fayllarni o‘qib bo‘lmayapti. Hech narsa yo‘qolmadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取交换文件夹中的文件。没有数据丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取交換資料夾中的檔案，資料並未遺失。"
          }
        }
      }
    },
    "sync.error.folderNotWritable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mübadilə qovluğuna yazmaq mümkün deyil. Dəyişiklikləriniz gözləyir və daha sonra göndəriləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць даныя ў папку для абмену. Вашы змены будуць адпраўлены пазней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do složky pro výměnu nelze zapisovat. Vaše změny se odešlou později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Austauschordner kann nichts geschrieben werden. Ihre Änderungen warten und gehen später hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing can be written to the exchange folder. Your changes wait and go out later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede escribir nada en la carpeta de intercambio. Sus cambios esperan y se envían más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne peut être écrit dans le dossier d'échange. Vos modifications attendent et partiront plus tard."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հնարավոր չէ գրել փոխանակման թղթապանակում։ Ձեր փոփոխությունները կուղարկվեն ավելի ուշ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scrivere nella cartella di scambio. Le modifiche sono in attesa e verranno inviate più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダに書き込めません。変更は保留され、後で送信されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაცვლის საქაღალდეში ჩაწერა შეუძლებელია. თქვენი ცვლილებები მოგვიანებით გაიგზავნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмасу қалтасына жазу мүмкін емес. Өзгерістеріңіз күтіп, кейін жіберіледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмашуу папкасына жазуу мүмкүн эмес. Өзгөртүүлөрүңүз күтүп турат жана кийин жөнөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kan niets naar de uitwisselingsmap worden geschreven. Je wijzigingen worden later verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać danych w folderze wymiany. Zmiany czekają na późniejsze wysłanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível gravar na pasta de troca. Suas alterações serão enviadas mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível escrever na pasta de partilha. As alterações aguardam e serão enviadas mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папку обмена нельзя записать. Ваши изменения ждут и уйдут позже."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҷузвдони мубодила чизе навиштан имкон надорад. Тағйироти шумо дар навбат мемонад ва баъдтар фиристода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım klasörüne yazılamıyor. Değişiklikleriniz bekliyor ve daha sonra gönderilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папку обміну не можна записувати. Ваші зміни очікують і будуть надіслані пізніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Almashuv jildiga yozib bo‘lmayapti. O‘zgarishlaringiz navbatda turibdi va keyinroq yuboriladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入交换文件夹。你的更改将等待稍后发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入交換資料夾。你的更改會保留並於稍後送出。"
          }
        }
      }
    },
    "sync.error.insideData": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qovluqda verilənlər bazanız və ya onun nüsxələri var, yaxud qovluq onların içindədir. Başqa qovluq seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта папка змяшчае вашу базу даных або яе копіі ці знаходзіцца ў іх. Выберыце іншую папку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato složka obsahuje vaši databázi nebo její kopie, případně je jejich součástí. Vyberte jinou složku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner enthält Ihre Datenbank oder ihre Kopien oder liegt darin. Wählen Sie einen anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder holds or lies inside your database or its copies. Choose another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta guarda o está dentro de su base de datos o sus copias. Elija otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier contient votre base ou ses copies, ou se trouve à l'intérieur. Choisissez-en un autre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս թղթապանակը պարունակում է ձեր տվյալների շտեմարանը կամ դրա պատճենները, կամ գտնվում է դրանց ներսում։ Ընտրեք մեկ այլ թղթապանակ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella contiene il database o le sue copie, oppure si trova al loro interno. Scegline un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダにはデータベースまたはそのコピーが含まれているか、その中にあります。別のフォルダを選択してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს საქაღალდე შეიცავს თქვენს მონაცემთა ბაზას ან მის ასლებს, ან მათ შიგნით მდებარეობს. აირჩიეთ სხვა საქაღალდე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қалтада дерекқор не оның көшірмелері бар немесе ол солардың ішінде. Басқасын таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул папкада маалымат базаңыз же анын көчүрмөлөрү бар же папка алардын ичинде жайгашкан. Башка папканы тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map bevat je database of kopieën daarvan, of bevindt zich daarin. Kies een andere map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder zawiera bazę danych lub jej kopie albo znajduje się w ich folderze. Wybierz inny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta contém o banco de dados ou suas cópias, ou está dentro deles. Escolha outra pasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta contém a base de dados ou as respetivas cópias, ou está dentro de uma delas. Escolha outra pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка содержит базу или копии либо лежит внутри них. Выберите другую."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ҷузвдон пойгоҳи додаҳо ё нусхаҳои онро дар бар мегирад ё дар дохили онҳо ҷойгир аст. Ҷузвдони дигареро интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör veritabanınızı veya kopyalarını içeriyor ya da bunların içinde yer alıyor. Başka bir klasör seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка містить вашу базу чи її копії або розташована всередині них. Виберіть іншу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu jildda ma’lumotlar bazangiz yoki uning nusxalari bor yoxud jild ular ichida joylashgan. Boshqa jildni tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹包含你的数据库或其副本，或位于其中。请选择其他文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾包含資料庫或其副本，或位於其中。請選擇其他檔案夾。"
          }
        }
      }
    },
