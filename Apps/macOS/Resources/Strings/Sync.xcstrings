    "sync.conflicts.empty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Konflikte. Ein Eintrag, der auf zwei Geräten zugleich geändert wurde, wartet hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No conflicts. A record changed on two devices at once waits here."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайшылық жоқ. Екі құрылғыда бірдей өзгерген жазбалар осында күтеді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликтов нет. Запись, изменённая на двух устройствах сразу, будет ждать здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфліктів немає. Тут очікують записи, змінені одночасно на двох пристроях."
          }
        }
      }
    },
    "sync.conflicts.explain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links — meins (dieses Gerät), rechts — das andere Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left — mine (this device), right — the other device."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сол жақта — менікі (осы құрылғы), оң жақта — басқа құрылғы."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слева — моя (это устройство), справа — другая."
