    "sync.conflicts.empty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No conflicts. A record changed on two devices at once waits here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay conflictos. Aquí espera un registro cambiado en dos dispositivos a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun conflit. Un enregistrement modifié sur deux appareils à la fois attend ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликтов нет. Запись, изменённая на двух устройствах сразу, будет ждать здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфліктів немає. Тут очікують записи, змінені одночасно на двох пристроях."
          }
        }
      }
    },
    "sync.conflicts.explain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left — mine (this device), right — the other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la izquierda, el mío (este dispositivo); a la derecha, el otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
