{
  "sourceLanguage": "en",
  "strings": {
    "sync.bootstrap.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qovluqdakı nüsxə zədələnib. Heç nə götürülməyib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія ў папцы пашкоджана. Даныя не загружаны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie ve složce je poškozená. Nic nebylo načteno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie im Ordner ist beschädigt. Nichts wurde übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy in the folder is damaged. Nothing was taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de la carpeta está dañada. No se tomó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie dans le dossier est endommagée. Rien n'a été pris."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թղթապանակի պատճենը վնասված է։ Ոչինչ չի ներմուծվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia nella cartella è danneggiata. Non è stato acquisito alcun dato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ内のコピーが破損しています。データは読み込まれませんでした。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საქაღალდეში არსებული ასლი დაზიანებულია. მონაცემები არ გადმოტანილა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалтадағы көшірме зақымдалған. Ештеңе алынбады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Папкадагы көчүрмө бузулган. Эч нерсе алынган жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopie in de map is beschadigd. Er is niets overgenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia w folderze jest uszkodzona. Niczego nie pobrano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia na pasta está danificada. Nada foi carregado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia na pasta está danificada. Não foram importados dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия в папке повреждена. Ничего не взято."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нусхаи ҷузвдон осеб дидааст. Ҳеҷ чиз гирифта нашуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasördeki kopya hasarlı. Hiçbir veri alınmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію в папці пошкоджено. Нічого не завантажено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jilddagi nusxa shikastlangan. Hech narsa olinmadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹中的副本已损坏。未导入任何数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案夾中的副本已損毀，未載入任何資料。"
          }
        }
      }
    },
    "sync.bootstrap.explain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qovluqda başqa cihazın məlumatlarının tam nüsxəsi var. Onu öz məlumatlarınız kimi istifadə edə bilərsiniz: tətbiq əvvəlcə buradakı məlumatların nüsxəsini saxlayır, sonra növbəti açılışda yeni məlumatları yükləyir. Bu, yalnız cihazda heç bir qeydiniz olmadıqda mümkündür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У папцы захоўваецца поўная копія даных з іншай прылады. Вы можаце загрузіць яе: праграма спачатку захавае копію бягучых даных, а затым загрузіць новыя пры наступным запуску. Гэта магчыма, толькі пакуль на гэтай прыладзе няма вашых запісаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složka obsahuje úplnou kopii dat z jiného zařízení. Můžete ji převzít: aplikace nejprve uloží kopii zdejších dat a při dalším spuštění načte nová data. To lze provést, jen pokud na tomto zařízení ještě nemáte žádné záznamy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner enthält eine vollständige Kopie der Daten eines anderen Geräts. Sie können sie als Ihre eigene übernehmen: Die App sichert zuerst, was hier ist, und legt die Daten beim nächsten Start an ihren Platz. Das ist nur möglich, solange dieses Gerät keine Ihrer Einträge hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder holds a full copy of another device's data. You can take it as your own: the app first saves a copy of what is here, then puts the data in place the next time it starts. This is possible only while this device has none of your records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta guarda una copia completa de los datos de otro dispositivo. Puede tomarla como propia: la app primero guarda una copia de lo que hay aquí, y luego coloca los datos en su sitio al siguiente inicio. Solo es posible mientras este dispositivo no tenga ninguno de sus registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier contient une copie complète des données d'un autre appareil. Vous pouvez la prendre comme la vôtre : l'app enregistre d'abord une copie de ce qui est ici, puis met les données en place au prochain démarrage. Cela n'est possible que tant que cet appareil n'a aucun de vos enregistrements."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թղթապանակում այլ սարքի տվյալների ամբողջական պատճենն է։ Կարող եք այն ներմուծել․ հավելվածը նախ կպահի այստեղի տվյալների պատճենը, ապա հաջորդ գործարկման ժամանակ կներմուծի տվյալները։ Դա հնարավոր է միայն, եթե այս սարքում դեռ գրառումներ չունեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella contiene una copia completa dei dati di un altro dispositivo. Puoi usarla come tua: l’app salva prima una copia dei dati presenti qui, poi ripristina i nuovi dati al prossimo avvio. È possibile solo se questo dispositivo non contiene ancora i tuoi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダには、別のデバイスのデータの完全なコピーが保存されています。このデータを使用できます。まずこのデバイスのデータのコピーを保存し、次回の起動時にデータを適用します。これは、このデバイスにまだ記録がない場合にのみ可能です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საქაღალდეში სხვა მოწყობილობის მონაცემების სრული ასლია. შეგიძლიათ მისი გამოყენება: აპი ჯერ აქ არსებული მონაცემების ასლს შეინახავს, შემდეგ კი მონაცემებს მომდევნო გაშვებისას ჩატვირთავს. ეს შესაძლებელია მხოლოდ მაშინ, როცა ამ მოწყობილობაზე თქვენი ჩანაწერები ჯერ არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалтада басқа құрылғы деректерінің толық көшірмесі бар. Оны өз деректеріңіз ретінде алуға болады: қолданба алдымен мұндағы деректердің көшірмесін сақтап, келесі іске қосылғанда жаңа деректерді қояды. Бұл осы құрылғыда өз жазбаларыңыз жоқ кезде ғана мүмкін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Папкада башка түзмөктөгү маалыматтардын толук көчүрмөсү бар. Аны өзүңүзгө ала аласыз: колдонмо адегенде бул жердеги маалыматтардын көчүрмөсүн сактап, кийинки ачылганда жаңы маалыматтарды орнотот. Бул түзмөктө жазууларыңыз жок болсо гана мүмкүн."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De map bevat een volledige kopie van de gegevens van een ander apparaat. Je kunt deze overnemen: de app bewaart eerst een kopie van de huidige gegevens en zet de nieuwe gegevens klaar bij de volgende keer opstarten. Dit kan alleen zolang dit apparaat geen gegevens van jou bevat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder zawiera pełną kopię danych z innego urządzenia. Możesz ją przyjąć jako własną: aplikacja najpierw zapisze kopię obecnych danych, a następnie wczyta nowe dane przy kolejnym uruchomieniu. Jest to możliwe tylko wtedy, gdy na tym urządzeniu nie ma jeszcze żadnych Twoich wpisów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta contém uma cópia completa dos dados de outro dispositivo. Você pode usá-la como sua: o app primeiro salva uma cópia dos dados atuais e, na próxima inicialização, carrega os novos dados. Isso só é possível enquanto não houver registros neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta contém uma cópia completa dos dados de outro dispositivo. Pode usá-la como sua: a app guarda primeiro uma cópia dos dados deste dispositivo e, na próxima abertura, carrega os novos dados. Só pode fazê-lo enquanto este dispositivo não tiver registos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке лежит полная копия данных другого устройства. Её можно взять как свои данные: приложение сначала сохранит копию того, что здесь есть, а потом подставит данные при следующем запуске. Это возможно, только пока на этом устройстве нет ваших записей."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҷузвдон нусхаи пурраи маълумоти дастгоҳи дигар мавҷуд аст. Шумо метавонед онро истифода баред: барнома аввал нусхаи маълумоти ин дастгоҳро нигоҳ медорад ва ҳангоми оғози навбатӣ маълумотро ҷойгир мекунад. Ин танҳо вақте имконпазир аст, ки дар ин дастгоҳ сабтҳои шумо набошанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör, başka bir aygıtın verilerinin tam bir kopyasını içeriyor. Bu verileri kullanabilirsiniz: Uygulama önce buradaki verilerin bir kopyasını kaydeder, ardından bir sonraki açılışta yeni verileri yerleştirir. Bu işlem yalnızca bu aygıtta henüz kaydınız yoksa yapılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці є повна копія даних іншого пристрою. Можна взяти її як свою: застосунок спочатку збереже копію поточного стану, а потім застосує дані під час наступного запуску. Це можливо лише поки на цьому пристрої немає ваших записів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jildda boshqa qurilmadagi ma’lumotlarning to‘liq nusxasi bor. Uni o‘zingizniki sifatida olishingiz mumkin: ilova avval shu yerdagi ma’lumotlar nusxasini saqlaydi, keyin esa navbatdagi ishga tushishda yangi ma’lumotlarni o‘rnatadi. Bu faqat qurilmada yozuvlaringiz bo‘lmaganida mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹包含另一台设备数据的完整副本。你可以将其用作自己的数据：App 会先备份此处的数据，然后在下次启动时载入副本。仅当此设备上没有你的记录时才能执行此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾包含另一部裝置的完整資料副本。你可以使用這份資料：App 會先儲存此處資料的副本，再於下次啟動時載入資料。只有此裝置尚無你的紀錄時才能執行此操作。"
          }
        }
      }
    },
    "sync.bootstrap.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatları yükləmək mümkün olmadı. Heç nə dəyişdirilməyib; yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося загрузіць даныя. Нічога не змянілася. Паспрабуйце яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data se nepodařilo načíst. Nic se nezměnilo. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten konnten nicht geladen werden. Nichts wurde verändert; versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data could not be loaded. Nothing was changed; try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los datos. No se cambió nada; inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données n'ont pas pu être chargées. Rien n'a été modifié ; réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց բեռնել տվյալները։ Ոչինչ չի փոխվել․ կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i dati. Non è stato modificato nulla; riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを読み込めませんでした。変更はありません。もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემები ვერ ჩაიტვირთა. არაფერი შეცვლილა; სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректерді жүктеу мүмкін болмады. Ештеңе өзгермеді; қайталаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалыматтар жүктөлгөн жок. Эч нерсе өзгөргөн жок; кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens konden niet worden geladen. Er is niets gewijzigd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać danych. Niczego nie zmieniono. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os dados. Nada foi alterado; tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os dados. Nada foi alterado; tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось загрузить данные. Ничего не изменено, попробуйте ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бор кардани маълумот муяссар нашуд. Ҳеҷ чиз тағйир наёфт; дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler yüklenemedi. Hiçbir şey değiştirilmedi; yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити дані. Нічого не змінено; спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlarni yuklab bo‘lmadi. Hech narsa o‘zgartirilmadi; qayta urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入数据。未更改任何内容，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入資料，未更動任何內容。請再試一次。"
          }
        }
      }
    },
    "sync.bootstrap.load": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatları qovluqdan yüklə"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузіць даныя з папкі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načíst data ze složky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten aus dem Ordner laden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
