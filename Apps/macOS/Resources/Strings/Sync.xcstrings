            "value": "Sinxronizasiya qovluğunda şifrələnmiş dəyişiklik jurnalı və verilənlər bazasının nüsxələri saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У папцы сінхранізацыі захоўваюцца зашыфраваны журнал змен і копіі базы даных."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Ordner gehen nur Journaldateien — nie Ihre Datenbank oder deren Kopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync folder holds an encrypted change journal and database snapshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de sincronización contiene un registro de cambios cifrado y copias de la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de synchronisation contient un journal chiffré des modifications et des instantanés de la base de données."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համաժամացման թղթապանակում պահվում են փոփոխությունների գաղտնագրված մատյանը և տվյալների շտեմարանի պատճենները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella di sincronizzazione contiene un registro crittografato delle modifiche e copie del database."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სინქრონიზაციის საქაღალდე შეიცავს ცვლილებების დაშიფრულ ჟურნალსა და მონაცემთა ბაზის ასლებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қалтаға тек журнал файлдары түседі — дерекқор мен көшірмелері түспейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Шайкештештирүү папкасында шифрленген өзгөртүүлөр журналы жана маалымат базасынын көчүрмөлөрү сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder synchronizacji zawiera zaszyfrowany dziennik zmian i kopie bazy danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de sincronização contém um histórico criptografado de alterações e cópias do banco de dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке обмена — зашифрованные журнал изменений и снимки базы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷузвдони ҳамоҳангсозӣ журнали рамзгузоришудаи тағйирот ва нусхаҳои пойгоҳи додаҳоро дар бар мегирад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşzamanlama klasörü, şifrelenmiş bir değişiklik günlüğü ve veritabanı kopyaları içerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка синхронізації містить зашифрований журнал змін і знімки бази даних."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinxronlash jildida shifrlangan o‘zgarishlar jurnali va ma’lumotlar bazasi nusxalari saqlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步資料夾包含加密的更改日誌和資料庫快照。"
          }
        }
      }
    },
