        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані готові. Перезапустіть застосунок, щоб побачити їх."
          }
        }
      }
    },
    "sync.bootstrap.title": {
      "comment": "Translation not verified by a native speaker.",
