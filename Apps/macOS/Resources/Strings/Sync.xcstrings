            "value": "Cargando los datos…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement des données…"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալները բեռնվում են…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamento dei dati…"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემები იტვირთება…"
          }
        },
