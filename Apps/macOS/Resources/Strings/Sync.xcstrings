    "sync.conflict.changedOnTwo": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed on two devices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiado en dos dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié sur deux appareils"
          }
        },
        "ru": {
          "stringUnit": {
