    "sync.conflicts.banner": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld record is waiting for your choice"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld records are waiting for your choice"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld registros esperan su elección"
