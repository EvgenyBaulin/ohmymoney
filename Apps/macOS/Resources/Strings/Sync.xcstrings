    "sync.bootstrap.staged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlar hazırdır. Onları görmək üçün tətbiqi yenidən başladın."
          }
        },
        "be": {
