{
  "sourceLanguage": "en",
  "strings": {
    "sync.bootstrap.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy in the folder is damaged. Nothing was taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de la carpeta está dañada. No se tomó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie dans le dossier est endommagée. Rien n'a été pris."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия в папке повреждена. Ничего не взято."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію в папці пошкоджено. Нічого не завантажено."
          }
        }
      }
    },
    "sync.bootstrap.explain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder holds a full copy of another device's data. You can take it as your own: the app first saves a copy of what is here, then puts the data in place the next time it starts. This is possible only while this device has none of your records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta guarda una copia completa de los datos de otro dispositivo. Puede tomarla como propia: la app primero guarda una copia de lo que hay aquí, y luego coloca los datos en su sitio al siguiente inicio. Solo es posible mientras este dispositivo no tenga ninguno de sus registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier contient une copie complète des données d'un autre appareil. Vous pouvez la prendre comme la vôtre : l'app enregistre d'abord une copie de ce qui est ici, puis met les données en place au prochain démarrage. Cela n'est possible que tant que cet appareil n'a aucun de vos enregistrements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке лежит полная копия данных другого устройства. Её можно взять как свои данные: приложение сначала сохранит копию того, что здесь есть, а потом подставит данные при следующем запуске. Это возможно, только пока на этом устройстве нет ваших записей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці є повна копія даних іншого пристрою. Можна взяти її як свою: застосунок спочатку збереже копію поточного стану, а потім застосує дані під час наступного запуску. Це можливо лише поки на цьому пристрої немає ваших записів."
          }
        }
      }
    },
    "sync.bootstrap.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data could not be loaded. Nothing was changed; try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los datos. No se cambió nada; inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données n'ont pas pu être chargées. Rien n'a été modifié ; réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось загрузить данные. Ничего не изменено, попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити дані. Нічого не змінено; спробуйте ще раз."
          }
        }
      }
    },
    "sync.bootstrap.load": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load data from the folder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar los datos de la carpeta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charger les données depuis le dossier"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить данные из папки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажити дані з папки"
          }
        }
      }
    },
    "sync.bootstrap.loading": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading the data…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando los datos…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement des données…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружаю данные…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження даних…"
          }
        }
      }
    },
    "sync.bootstrap.newerVersion": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy was written by a newer version of the app. Update this app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia la escribió una versión más reciente de la app. Actualice esta app e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie a été écrite par une version plus récente de l'app. Mettez cette app à jour et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копию записала более новая версия приложения. Обновите это приложение и повторите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію записала новіша версія застосунку. Оновіть цей застосунок і спробуйте ще раз."
          }
        }
      }
    },
    "sync.bootstrap.noSnapshot": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder holds no copy of the data yet. Open the app on the other device with this same folder and wait until it writes the copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta todavía no tiene una copia de los datos. Abra la app en el otro dispositivo con esta misma carpeta y espere a que escriba la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier ne contient pas encore de copie des données. Ouvrez l'app sur l'autre appareil avec ce même dossier et attendez qu'elle écrive la copie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке пока нет копии данных. Откройте приложение на другом устройстве с этой же папкой и подождите, пока оно запишет копию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці ще немає копії даних. Відкрийте застосунок на іншому пристрої з цією самою папкою та зачекайте, поки він запише копію."
          }
        }
      }
    },
    "sync.bootstrap.notConfigured": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the exchange folder first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija primero la carpeta de intercambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d'abord le dossier d'échange."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите папку обмена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку виберіть папку обміну."
          }
        }
      }
    },
    "sync.bootstrap.notEmpty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are already records here, so they are not replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí ya hay registros, así que no se reemplazan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a déjà des enregistrements ici, donc ils ne sont pas remplacés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь уже есть записи, поэтому их не заменяют."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут уже є записи, тому вони не замінюються."
          }
        }
      }
    },
    "sync.bootstrap.offer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy from %@ · device %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia de %1$@ · dispositivo %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie de %@ · appareil %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия от %@ · устройство %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія від %@ · пристрій %@"
          }
        }
      }
    },
    "sync.bootstrap.reopen": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app completely and open it again: the data is put in place at launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre la app por completo y ábrala de nuevo: los datos se colocan al iniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez complètement l'app puis rouvrez-la : les données sont mises en place au lancement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью закройте приложение и откройте снова: данные подставятся при запуске."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повністю закрийте застосунок і відкрийте знову: дані застосовуються під час запуску."
          }
        }
      }
    },
