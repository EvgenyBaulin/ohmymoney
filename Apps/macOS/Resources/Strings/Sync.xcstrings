            "state": "translated",
            "value": "Перезапустить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустити"
          }
        }
      }
    },
    "sync.bootstrap.staged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
