    "sync.error.database": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişiklikləri verilənlər bazasına yazmaq mümkün olmadı. Heç nə itirilməyib; yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося захаваць змены ў базе даных. Нічога не страчана. Паспрабуйце яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank hat die Änderungen nicht übernommen. Nichts ging verloren; versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database did not take the changes. Nothing was lost; try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó los cambios. No se perdió nada; inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté les modifications. Rien n'a été perdu ; réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների շտեմարանը չընդունեց փոփոխությունները։ Ոչինչ չի կորել․ կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database non ha acquisito le modifiche. Non è stato perso nulla; riprova."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცვლილებები მონაცემთა ბაზაში ვერ შეინახა. არაფერი დაკარგულა; სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор өзгерістерді қабылдамады. Ештеңе жоғалмады; қайталаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат базасы өзгөртүүлөрдү кабыл алган жок. Эч нерсе жоголгон жок; кайра аракет кылыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać zmian w bazie danych. Niczego nie utracono. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados não aceitou as alterações. Nada foi perdido; tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База не приняла изменения. Ничего не потеряно, повторите."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойгоҳи додаҳо тағйиротро қабул накард. Ҳеҷ чиз гум нашуд; дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler veritabanına kaydedilemedi. Hiçbir şey kaybolmadı; yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База даних не прийняла зміни. Нічого не втрачено; спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasi o‘zgarishlarni qabul qilmadi. Hech narsa yo‘qolmadi; qayta urinib ko‘ring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫無法套用更改，資料並未遺失。請再試一次。"
          }
        }
      }
    },
    "sync.error.filesNotReadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mübadilə fayllarını şifrələmək və ya oxumaq mümkün olmadı. İlk cihazınızda açar yaradın və ya digər cihazlarda onun 24 bərpa sözünü daxil edin. Bütün cihazlarda OhMyMoney-ni yeniləyib yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося зашыфраваць або прачытаць файлы абмену. Стварыце ключ на першай прыладзе або ўвядзіце яго 24 словы для аднаўлення на іншых прыладах. Абнавіце OhMyMoney на ўсіх прыладах і паспрабуйце яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Austauschdateien konnten nicht verschlüsselt oder gelesen werden. Legen Sie auf Ihrem ersten Gerät einen Schlüssel an oder geben Sie auf anderen Geräten seine 24 Wiederherstellungswörter ein. Aktualisieren Sie OhMyMoney auf allen Geräten und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exchange files could not be encrypted or read. Create a key on your first device or enter its 24 recovery words on other devices. Update OhMyMoney on all devices, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de intercambio no se pudieron cifrar ni leer. Cree una clave en su primer dispositivo o introduzca sus 24 palabras de recuperación en los demás dispositivos. Actualice OhMyMoney en todos los dispositivos e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers d'échange n'ont pas pu être chiffrés ni lus. Créez une clé sur votre premier appareil ou saisissez ses 24 mots de récupération sur les autres appareils. Mettez OhMyMoney à jour sur tous les appareils, puis réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց գաղտնագրել կամ կարդալ փոխանակման ֆայլերը։ Ստեղծեք բանալի ձեր առաջին սարքում կամ մուտքագրեք դրա վերականգնման 24 բառերը մյուս սարքերում։ Թարմացրեք OhMyMoney-ը բոլոր սարքերում և կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile crittografare o leggere i file di scambio. Crea una chiave sul primo dispositivo o inserisci le sue 24 parole di recupero sugli altri dispositivi. Aggiorna OhMyMoney su tutti i dispositivi e riprova."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაცვლის ფაილების დაშიფვრა ან წაკითხვა ვერ მოხერხდა. შექმენით გასაღები პირველ მოწყობილობაზე ან შეიყვანეთ მისი აღდგენის 24 სიტყვა სხვა მოწყობილობებზე. განაახლეთ OhMyMoney ყველა მოწყობილობაზე და სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмасу файлдарын шифрлау не оқу мүмкін болмады. Бірінші құрылғыда кілт жасаңыз немесе басқа құрылғыларда оның 24 қалпына келтіру сөзін енгізіңіз. Барлық құрылғыда OhMyMoney жаңартып, қайталаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмашуу файлдарын шифрлөө же окуу мүмкүн болгон жок. Биринчи түзмөгүңүздө ачкыч түзүңүз же башка түзмөктөрдө анын 24 калыбына келтирүү сөзүн киргизиңиз. Бардык түзмөктөрдө OhMyMoney колдонмосун жаңыртып, кайра аракет кылыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaszyfrować ani odczytać plików wymiany. Utwórz klucz na pierwszym urządzeniu lub wprowadź jego 24 słowa odzyskiwania na pozostałych urządzeniach. Uaktualnij OhMyMoney na wszystkich urządzeniach i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criptografar ou ler os arquivos de troca. Crie uma chave no primeiro dispositivo ou digite suas 24 palavras de recuperação nos outros dispositivos. Atualize o OhMyMoney em todos os dispositivos e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зашифровать или прочитать файлы обмена. На первом устройстве создайте ключ, на других введите его 24 слова восстановления. Обновите OhMyMoney на всех устройствах и повторите обмен."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рамзгузорӣ ё хондани файлҳои мубодила муяссар нашуд. Дар дастгоҳи аввал калид созед ё 24 калимаи барқарорсозии онро дар дастгоҳҳои дигар ворид кунед. OhMyMoney-ро дар ҳамаи дастгоҳҳо навсозӣ карда, дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım dosyaları şifrelenemedi veya okunamadı. İlk aygıtınızda bir anahtar oluşturun veya diğer aygıtlarda 24 kurtarma sözcüğünü girin. Tüm aygıtlarda OhMyMoney uygulamasını güncelleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зашифрувати або прочитати файли обміну. Створіть ключ на першому пристрої або введіть його 24 слова відновлення на інших. Оновіть OhMyMoney на всіх пристроях і спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Almashuv fayllarini shifrlab yoki o‘qib bo‘lmadi. Birinchi qurilmangizda kalit yarating yoki boshqa qurilmalarda uning 24 ta tiklash so‘zini kiriting. Barcha qurilmalarda OhMyMoney ilovasini yangilab, qayta urinib ko‘ring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法加密或讀取交換檔案。請在第一部裝置上建立金鑰，或在其他裝置上輸入該金鑰的 24 個復原詞。請更新所有裝置上的 OhMyMoney，然後再試一次。"
          }
        }
      }
    },
    "sync.error.folderMissing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mübadilə qovluğu əlçatan deyil. iCloud Drive-ın aktiv olduğunu yoxlayın və ya qovluğu yenidən seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка для абмену недаступная. Праверце, ці ўключаны iCloud Drive, або выберыце папку зноў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Austauschordner ist nicht verfügbar. Prüfen Sie, ob iCloud Drive eingeschaltet ist, oder wählen Sie den Ordner erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exchange folder is not available. Check that iCloud Drive is on, or choose the folder again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de intercambio no está disponible. Compruebe que iCloud Drive esté activado, o elija la carpeta de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier d'échange n'est pas disponible. Vérifiez que iCloud Drive est activé, ou choisissez à nouveau le dossier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխանակման թղթապանակը հասանելի չէ։ Ստուգեք՝ արդյոք iCloud Drive-ը միացված է, կամ կրկին ընտրեք թղթապանակը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella di scambio non è disponibile. Verifica che iCloud Drive sia attivo o scegli di nuovo la cartella."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაცვლის საქაღალდე მიუწვდომელია. შეამოწმეთ, ჩართულია თუ არა iCloud Drive, ან ხელახლა აირჩიეთ საქაღალდე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмасу қалтасы қолжетімсіз. iCloud Drive қосылғанын тексеріңіз немесе қалтаны қайта таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмашуу папкасы жеткиликсиз. iCloud Drive күйгүзүлгөнүн текшериңиз же папканы кайра тандаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder wymiany jest niedostępny. Sprawdź, czy iCloud Drive jest włączony, lub wybierz folder ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de troca não está disponível. Verifique se o iCloud Drive está ativado ou escolha a pasta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка обмена недоступна. Проверьте iCloud Drive или выберите папку заново."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷузвдони мубодила дастрас нест. Санҷед, ки iCloud Drive фаъол аст ё ҷузвдонро аз нав интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım klasörüne ulaşılamıyor. iCloud Drive'ın açık olduğunu denetleyin veya klasörü yeniden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка обміну недоступна. Перевірте, чи ввімкнено iCloud Drive, або виберіть папку знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Almashuv jildiga kirib bo‘lmayapti. iCloud Drive yoqilganini tekshiring yoki jildni qayta tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交換資料夾無法使用。請確認 iCloud Drive 已開啟，或重新選擇檔案夾。"
          }
        }
      }
    },
    "sync.error.folderNotReadable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mübadilə qovluğundakı faylları oxumaq mümkün deyil. Heç nə itirilməyib."
