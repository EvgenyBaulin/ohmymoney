    "sync.bootstrap.newerVersion": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія створана ў навейшай версіі праграмы. Абнавіце праграму і паспрабуйце яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie wurde von einer neueren Version der App geschrieben. Aktualisieren Sie diese App und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy was written by a newer version of the app. Update this app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia la escribió una versión más reciente de la app. Actualice esta app e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie a été écrite par une version plus récente de l'app. Mettez cette app à jour et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia è stata creata con una versione più recente dell’app. Aggiorna l’app e riprova."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірме қолданбаның жаңарақ нұсқасымен жазылған. Қолданбаны жаңартып, қайталаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopię zapisano w nowszej wersji aplikacji. Uaktualnij aplikację i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копию записала более новая версия приложения. Обновите это приложение и повторите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopya, uygulamanın daha yeni bir sürümüyle yazılmış. Uygulamayı güncelleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію записала новіша версія застосунку. Оновіть цей застосунок і спробуйте ще раз."
          }
        }
      }
    },
    "sync.bootstrap.noSnapshot": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У папцы пакуль няма копіі даных. Адкрыйце праграму на іншай прыладзе з гэтай жа папкай і дачакайцеся стварэння копіі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner enthält noch keine Kopie der Daten. Öffnen Sie die App auf dem anderen Gerät mit demselben Ordner und warten Sie, bis sie die Kopie schreibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder holds no copy of the data yet. Open the app on the other device with this same folder and wait until it writes the copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta todavía no tiene una copia de los datos. Abra la app en el otro dispositivo con esta misma carpeta y espere a que escriba la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier ne contient pas encore de copie des données. Ouvrez l'app sur l'autre appareil avec ce même dossier et attendez qu'elle écrive la copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella non contiene ancora una copia dei dati. Apri l’app sull’altro dispositivo con la stessa cartella e attendi che la copia venga creata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалтада әлі деректер көшірмесі жоқ. Басқа құрылғыда осы қалтамен қолданбаны ашып, көшірме жазылғанша күтіңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder nie zawiera jeszcze kopii danych. Otwórz aplikację na drugim urządzeniu z tym samym folderem i poczekaj na zapisanie kopii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке пока нет копии данных. Откройте приложение на другом устройстве с этой же папкой и подождите, пока оно запишет копию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörde henüz veri kopyası yok. Diğer aygıtta aynı klasörü kullanarak uygulamayı açın ve kopyanın yazılmasını bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці ще немає копії даних. Відкрийте застосунок на іншому пристрої з цією самою папкою та зачекайте, поки він запише копію."
          }
        }
      }
    },
    "sync.bootstrap.notConfigured": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку выберыце папку для абмену."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie zuerst den Austauschordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the exchange folder first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija primero la carpeta de intercambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d'abord le dossier d'échange."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli prima la cartella di scambio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдымен алмасу қалтасын таңдаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wybierz folder wymiany."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите папку обмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce paylaşım klasörünü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку виберіть папку обміну."
          }
        }
      }
    },
    "sync.bootstrap.notEmpty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут ужо ёсць запісы, таму яны не будуць заменены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es schon Einträge, daher werden sie nicht ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are already records here, so they are not replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí ya hay registros, así que no se reemplazan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a déjà des enregistrements ici, donc ils ne sont pas remplacés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono già presenti dei dati, quindi non verranno sostituiti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұнда жазбалар бар, сондықтан олар ауыстырылмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Są tu już wpisy, więc nie zostaną zastąpione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь уже есть записи, поэтому их не заменяют."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada zaten kayıtlar var, bu yüzden değiştirilmediler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут уже є записи, тому вони не замінюються."
          }
        }
      }
    },
    "sync.bootstrap.offer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія ад %@ · прылада %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie von %@ · Gerät %@"
          }
