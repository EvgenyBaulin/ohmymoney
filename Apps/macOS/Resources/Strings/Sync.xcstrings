    "sync.bootstrap.staged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlar hazırdır. Onları görmək üçün tətbiqi yenidən başladın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даныя гатовы. Перазапусціце праграму, каб убачыць іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data jsou připravena. Zobrazíte je restartováním aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten sind bereit. Starten Sie die App neu, um sie zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data is ready. Restart the app to see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos están listos. Reinicie la app para verlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sont prêtes. Redémarrez l'app pour les voir."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալները պատրաստ են։ Դրանք տեսնելու համար վերագործարկեք հավելվածը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati sono pronti. Riavvia l’app per visualizzarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの準備ができました。アプリを再起動すると表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემები მზადაა. მათ სანახავად ხელახლა გაუშვით აპი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер дайын. Көру үшін қолданбаны қайта іске қосыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалыматтар даяр. Аларды көрүү үчүн колдонмону кайра иштетиңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens staan klaar. Herstart de app om ze te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane są gotowe. Uruchom ponownie aplikację, aby je zobaczyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados estão prontos. Reinicie o app para vê-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados estão prontos. Reinicie a app para os ver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные готовы. Перезапустите приложение, чтобы они появились."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумот омода аст. Барои дидани он барномаро аз нав оғоз кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler hazır. Görmek için uygulamayı yeniden başlatın."
          }
        },
        "uk": {
