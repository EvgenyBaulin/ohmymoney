    "subs.advice.unused": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ каштуе %2$@ за год, апошняе выкарыстанне — %3$@"
