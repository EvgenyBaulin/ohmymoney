    "subs.appStore": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbuchungen des App Store kommen als eine Zeile („APPLE.COM/BILL“) und lassen sich nicht unterscheiden: Tragen Sie die Abos von Hand ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charges of the App Store come as one line («APPLE.COM/BILL») and cannot be told apart: lay the subscriptions out by hand."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списания App Store приходят одной строкой («APPLE.COM/BILL») и не различимы: разложите подписки по сервисам вручную."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списання App Store надходять одним рядком («APPLE.COM/BILL»), і їх не можна розрізнити: розподіліть підписки вручну."
          }
        }
      }
    },
