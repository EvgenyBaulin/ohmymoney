    "subs.terms.bankNote": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Бясплатныя пераводы, працэнты, павышаны кэшбэк: укажыце, колькі гэта для вас каштуе. Справаздача «Ці акупляюцца банкаўскія падпіскі» параўнае выгаду з цаной."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Überweisungen, Zinsen, höheres Cashback: Gib an, was dir das wert ist. Der Bericht «Lohnen sich Bankabos?» vergleicht den Wert mit dem Preis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free transfers, interest, a higher cashback: type what you think it is worth. The report «Do bank subscriptions pay back» sets it against the price."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferencias gratuitas, intereses, más cashback: indica cuánto crees que valen. El informe «¿Compensan las suscripciones bancarias?» lo compara con el precio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virements gratuits, intérêts, cashback majoré : indiquez leur valeur estimée. Le rapport « Les abonnements bancaires sont-ils rentables ? » la compare au prix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonifici gratuiti, interessi, cashback maggiore: inserisci il valore che gli attribuisci. Il report «Gli abbonamenti bancari convengono?» lo confronta con il prezzo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тегін аударымдар, пайыз, жоғары кэшбэк: олардың құнын өзіңіз бағалап енгізіңіз. «Банк жазылымдары өзін ақтай ма» есебі оны жазылым бағасымен салыстырады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Darmowe przelewy, odsetki, wyższy cashback: wpisz, ile są według Ciebie warte. Raport «Czy abonamenty bankowe się opłacają» porównuje je z ceną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências grátis, juros, cashback maior: informe o valor que você atribui a esses benefícios. O relatório «As assinaturas bancárias compensam?» compara esse valor com o preço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатные переводы, проценты, повышенный кэшбэк: впишите, сколько это стоит по-вашему. Отчёт «Окупаются ли подписки банков» сравнит это с ценой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz transferler, faiz, daha yüksek nakit iadesi: Sizce ne kadar değerliyse yazın. «Banka abonelikleri kendini karşılıyor mu?» raporu bunu fiyatla karşılaştırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовні перекази, відсотки, підвищений кешбек: вкажіть, скільки це для вас коштує. У звіті «Чи окупаються підписки банків» ця сума порівнюється з ціною."
          }
        }
      }
    },
