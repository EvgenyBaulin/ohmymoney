            "value": "Stesso tipo, %1$@: %2$@ — %3$@ al mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір түр, %1$@: %2$@ — айына %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один вид, %1$@: %2$@ — %3$@ в месяц"
