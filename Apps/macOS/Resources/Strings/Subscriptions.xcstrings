        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ custa %2$@ por ano, último uso em %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ в год, последний раз пользовались %3$@"
