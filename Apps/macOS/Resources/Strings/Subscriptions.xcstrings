    "subs.cancel.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmin günə qədər aktiv qalacaq; tarixçəsi saxlanılacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падпіска дзейнічае да гэтага дня; яе гісторыя захаваецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tohoto dne zůstane aktivní. Historie se zachová."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft bis zu diesem Tag; sein Verlauf bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It runs until that day; its history stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue activa hasta ese día; su historial se queda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il court jusqu'à ce jour ; son historique reste."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն գործում է մինչև այդ օրը, պատմությունը կպահպանվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta attivo fino a quel giorno; la cronologia viene conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日まで利用できます。履歴は残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოწერა ამ თარიღამდე იმოქმედებს; ისტორია შენარჩუნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сол күнге дейін жұмыс істейді; тарихы сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылуу ошол күнгө чейин иштейт; тарыхы сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het abonnement loopt tot die dag door. De geschiedenis blijft bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja pozostanie aktywna do tego dnia. Jej historia zostanie zachowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura fica ativa até esse dia e o histórico é mantido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém-se ativa até esse dia; o histórico é conservado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До этого дня она действует, история остаётся."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То он рӯз амал мекунад; таърихаш нигоҳ дошта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O güne kadar sürer; geçmişi saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діє до цього дня; історія залишається."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obuna shu kungacha amal qiladi; tarixi saqlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅将持续至该日期，历史记录会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱將持續至該日，並保留記錄。"
          }
        }
      }
    },
