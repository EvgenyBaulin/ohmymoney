    "subs.advice.unused": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ каштуе %2$@ за год, апошняе выкарыстанне — %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostet %2$@ im Jahr, zuletzt genutzt %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ costs %2$@ a year, last used %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cuesta %2$@ al año, último uso el %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ coûte %2$@ par an, dernière utilisation le %3$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ costa %2$@ all’anno, ultimo utilizzo %3$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ жылына %2$@ тұрады, соңғы қолдану %3$@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ жылына %2$@ турат, акыркы жолу %3$@ колдонулган"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kosztuje %2$@ rocznie, ostatnio użyto %3$@"
