    "subs.terms.neededNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Lazım kimi işarələnmiş abunəlik ləğv üçün təklif edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падпіска, пазначаная як патрэбная, не прапануецца да скасавання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné označené jako potřebné nebude nabídnuto ke zrušení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein als gebraucht markiertes Abo wird nie zur Kündigung angeboten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A subscription marked as needed is never offered for cancelling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suscripción marcada como necesaria nunca se sugiere cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement marqué comme nécessaire n'est jamais proposé à la résiliation."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որպես անհրաժեշտ նշված բաժանորդագրությունը չեղարկման համար չի առաջարկվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abbonamento segnato come necessario non viene mai suggerito per la disdetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要としてマークしたサブスクリプションは解約の候補に表示されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საჭიროდ მონიშნულ გამოწერას გასაუქმებლად არ შემოგთავაზებთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қажет деп белгіленген жазылымнан бас тарту ешқашан ұсынылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Керектүү деп белгиленген жазылууну токтотуу сунушталбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een abonnement dat als nodig is gemarkeerd, wordt nooit voorgesteld om op te zeggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja oznaczona jako potrzebna nie będzie proponowana do anulowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura marcada como necessária nunca será sugerida para cancelamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura marcada como necessária nunca é sugerida para cancelamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписку с отметкой «нужна» отменить не предлагают."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обунае, ки зарурӣ қайд шудааст, барои бекоркунӣ пешниҳод намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerekli olarak işaretlenen abonelik iptal için önerilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписка, позначена як потрібна, ніколи не пропонується до скасування."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerakli deb belgilangan obunani bekor qilish taklif etilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
