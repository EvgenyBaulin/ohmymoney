    "subs.terms.peopleNote": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xərci bölüşmək üçün Parametrlər → Sorğu kitabçaları bölməsində şəxslər əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадайце людзей у Наладах → Даведнікі, каб падзяліць выдаткі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro rozdělení nákladů přidejte osoby v Nastavení → Číselníky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen fügen Sie unter Einstellungen → Nachschlagewerke hinzu, um die Kosten zu teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add people in Settings → Reference books to share the cost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada personas en Ajustes → Libros de referencia para repartir el coste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des personnes dans Réglages → Références pour partager le coût."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծախսը բաժանելու համար մարդկանց ավելացրեք Կարգավորումներ → Տեղեկատուներ բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi persone in Impostazioni → Elenchi per condividere il costo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "費用を分担するには、「設定」→「参照リスト」で人を追加してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯის გასანაწილებლად დაამატეთ ადამიანები: პარამეტრები → ცნობარები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құнын бөлісу үшін Баптаулар → Анықтамалықтар ішінде адам қосыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чыгымды бөлүштүрүү үчүн адамдарды Орнотуулар → Маалымдамалар бөлүмүнөн кошуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg personen toe in Instellingen → Naslaglijsten om de kosten te delen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj osoby w Ustawienia → Słowniki, aby podzielić koszt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione pessoas em Ajustes → Cadastros para dividir o custo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione pessoas em Definições → Listas de referência para partilhar o custo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте людей в «Настройках → Справочниках», чтобы делить сумму."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои тақсими хароҷот дар Танзимот → Маълумотномаҳо одамонро илова кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücreti paylaşmak için Ayarlar → Başvuru Kitapları bölümünden kişiler ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте людей у «Налаштування → Довідники», щоб розділити вартість."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajatni taqsimlash uchun Sozlamalar → Ma’lumotnomalarda odamlarni qo‘shing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
