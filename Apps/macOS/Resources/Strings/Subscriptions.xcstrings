    "subs.appStore": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спісанні App Store паказваюцца адным радком («APPLE.COM/BILL»), таму іх нельга адрозніць. Дадайце падпіскі ўручную."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbuchungen des App Store kommen als eine Zeile („APPLE.COM/BILL“) und lassen sich nicht unterscheiden: Tragen Sie die Abos von Hand ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charges of the App Store come as one line («APPLE.COM/BILL») and cannot be told apart: lay the subscriptions out by hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cargos de App Store llegan como una sola línea («APPLE.COM/BILL») y no se distinguen: anote las suscripciones a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prélèvements de l'App Store arrivent sous une seule ligne (« APPLE.COM/BILL ») et ne peuvent pas être distingués : répartissez les abonnements à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli addebiti dell’App Store compaiono in un’unica voce («APPLE.COM/BILL») e non sono distinguibili: aggiungi gli abbonamenti manualmente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store төлемдері бір жолмен келеді («APPLE.COM/BILL»), оларды ажырату мүмкін емес: жазылымдарды қолмен бөліңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store төлөмдөрү бир сапта («APPLE.COM/BILL») көрсөтүлөт жана аларды ажыратуу мүмкүн эмес. Жазылууларды кол менен бөлүштүрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłaty App Store są widoczne jako jedna pozycja («APPLE.COM/BILL») i nie można ich rozróżnić. Dodaj subskrypcje ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cobranças da App Store aparecem em uma única linha («APPLE.COM/BILL») e não podem ser identificadas: adicione as assinaturas manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списания App Store приходят одной строкой («APPLE.COM/BILL») и не различимы: разложите подписки по сервисам вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ödemeleri tek satırda («APPLE.COM/BILL») görünür ve ayırt edilemez. Abonelikleri elle ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списання App Store надходять одним рядком («APPLE.COM/BILL»), і їх не можна розрізнити: розподіліть підписки вручну."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store to‘lovlari bir qatorda («APPLE.COM/BILL») ko‘rinadi va ularni ajratib bo‘lmaydi: obunalarni qo‘lda kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 的扣款合併為一筆（«APPLE.COM/BILL»），無法區分。請手動列出訂閱項目。"
          }
        }
      }
    },
