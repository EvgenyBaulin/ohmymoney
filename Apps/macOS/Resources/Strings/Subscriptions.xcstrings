    "subs.advice.duplicates": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аднаго тыпу, %1$@: %2$@ — %3$@ за месяц"
