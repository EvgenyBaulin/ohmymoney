            "state": "translated",
            "value": "%1$@は年間%2$@、使用記録なし"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ღირს %2$@ წელიწადში და გამოყენება არ აღნიშნულა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ жылына %2$@ тұрады, қолдану белгісі жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ жылына %2$@ турат, колдонулганы белгиленген эмес"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kost %2$@ per jaar en is niet als gebruikt gemarkeerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kosztuje %2$@ rocznie, brak oznaczeń użycia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ custa %2$@ por ano e não tem registro de uso"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ custa %2$@ por ano e não tem utilização registada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ в год, отметок «пользовался» нет"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ дар як сол %2$@ арзиш дорад ва истифодааш қайд нашудааст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yılda %2$@ tutuyor ve kullanım kaydı yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ коштує %2$@ на рік, використання не позначено"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yiliga %2$@ turadi, ishlatilgani belgilanmagan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 每年花费 %2$@，没有使用记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 每年花費 %2$@，沒有使用記錄"
          }
        }
      }
    },
    "subs.appStore": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ödənişləri bir sətirdə («APPLE.COM/BILL») göstərilir və onları ayırd etmək olmur. Abunəlikləri əl ilə əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спісанні App Store паказваюцца адным радком («APPLE.COM/BILL»), таму іх нельга адрозніць. Дадайце падпіскі ўручную."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platby z App Storu přicházejí jako jedna položka («APPLE.COM/BILL») a nelze je rozlišit. Předplatná rozepište ručně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbuchungen des App Store kommen als eine Zeile („APPLE.COM/BILL“) und lassen sich nicht unterscheiden: Tragen Sie die Abos von Hand ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charges of the App Store come as one line («APPLE.COM/BILL») and cannot be told apart: lay the subscriptions out by hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cargos de App Store llegan como una sola línea («APPLE.COM/BILL») y no se distinguen: anote las suscripciones a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prélèvements de l'App Store arrivent sous une seule ligne (« APPLE.COM/BILL ») et ne peuvent pas être distingués : répartissez les abonnements à la main."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store-ի գանձումները երևում են մեկ տողով («APPLE.COM/BILL») և հնարավոր չէ տարբերել․ ավելացրեք բաժանորդագրությունները ձեռքով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli addebiti dell’App Store compaiono in un’unica voce («APPLE.COM/BILL») e non sono distinguibili: aggiungi gli abbonamenti manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeの請求は1件（«APPLE.COM/BILL»）にまとめられ、区別できません。サブスクリプションを手動で登録してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store-ის ჩამოჭრები ერთ ჩანაწერად ჩანს («APPLE.COM/BILL») და მათი გარჩევა შეუძლებელია: დაამატეთ გამოწერები ხელით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store төлемдері бір жолмен келеді («APPLE.COM/BILL»), оларды ажырату мүмкін емес: жазылымдарды қолмен бөліңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store төлөмдөрү бир сапта («APPLE.COM/BILL») көрсөтүлөт жана аларды ажыратуу мүмкүн эмес. Жазылууларды кол менен бөлүштүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afschrijvingen van de App Store verschijnen op één regel («APPLE.COM/BILL») en zijn niet te onderscheiden. Voeg de abonnementen handmatig toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłaty App Store są widoczne jako jedna pozycja («APPLE.COM/BILL») i nie można ich rozróżnić. Dodaj subskrypcje ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cobranças da App Store aparecem em uma única linha («APPLE.COM/BILL») e não podem ser identificadas: adicione as assinaturas manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cobranças da App Store aparecem numa só linha («APPLE.COM/BILL») e não podem ser distinguidas: adicione as assinaturas manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списания App Store приходят одной строкой («APPLE.COM/BILL») и не различимы: разложите подписки по сервисам вручную."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пардохтҳои App Store дар як сатр («APPLE.COM/BILL») меоянд ва аз ҳам фарқ намекунанд: обунаҳоро дастӣ илова кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ödemeleri tek satırda («APPLE.COM/BILL») görünür ve ayırt edilemez. Abonelikleri elle ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списання App Store надходять одним рядком («APPLE.COM/BILL»), і їх не можна розрізнити: розподіліть підписки вручну."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store to‘lovlari bir qatorda («APPLE.COM/BILL») ko‘rinadi va ularni ajratib bo‘lmaydi: obunalarni qo‘lda kiriting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 的扣费合并显示为一条记录（«APPLE.COM/BILL»），无法区分。请手动列出订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 的扣款合併為一筆（«APPLE.COM/BILL»），無法區分。請手動列出訂閱項目。"
          }
        }
      }
    },
