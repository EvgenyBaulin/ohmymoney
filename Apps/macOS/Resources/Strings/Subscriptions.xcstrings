    "subs.empty": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ abunəlik yoxdur. Planlamada əlavə edin və ya alışlar əsasında təklif ediləni seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма падпісак. Дадайце падпіску ў планаванні або выберыце з прапанаваных на падставе пакупак."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádná předplatná. Přidejte je v Plánování nebo vyberte některé z návrhů podle nákupů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Abos. Legen Sie eines in der Planung an oder übernehmen Sie eines, das die Käufe vorschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No subscriptions yet. Add one in Planning, or take one the purchases suggest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay suscripciones. Añada una en Planificación, o tome una que sugieran las compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'abonnement. Ajoutez-en un dans la Planification, ou reprenez-en un que les achats suggèrent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ բաժանորդագրություններ չկան։ Ավելացրեք մեկը «Պլանավորում» բաժնում կամ ընտրեք գնումների հիման վրա առաջարկվածներից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun abbonamento. Aggiungine uno in Pianificazione o scegli uno di quelli suggeriti dagli acquisti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションはまだありません。「プランニング」で追加するか、購入履歴からの候補を追加してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოწერები ჯერ არ არის. დაამატეთ დაგეგმვაში ან აირჩიეთ შესყიდვების მიხედვით შემოთავაზებული გამოწერა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әлі жазылым жоқ. Жоспарлауда қосыңыз не сатып алулар ұсынғанын таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча жазылуулар жок. Пландоодо кошуңуз же сатып алуулар боюнча сунушталгандардын бирин тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen abonnementen. Voeg er een toe bij Planning of kies een suggestie op basis van je aankopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak subskrypcji. Dodaj ją w Planowaniu lub wybierz jedną z sugerowanych na podstawie zakupów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma assinatura ainda. Adicione uma em Planejamento ou use uma sugerida pelas compras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há assinaturas. Adicione uma em Planeamento ou escolha uma sugerida pelas compras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписок пока нет. Добавьте её в «Планировании» или возьмите ту, что подсказывают покупки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло обуна нест. Дар Банақшагирӣ илова кунед ё аз пешниҳодҳои харидҳо интихоб кунед."
