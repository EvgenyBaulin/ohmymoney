      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы спісанняў за падпіскі няма"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Abo-Abbuchungen in diesem Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No subscription charges this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay cargos de suscripciones este mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun prélèvement d'abonnement ce mois-ci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun addebito per abbonamenti questo mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда жазылым төлемдері жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда жазылуулар үчүн төлөм жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak opłat za subskrypcje w tym miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma cobrança de assinatura neste mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце списаний подписок нет"
