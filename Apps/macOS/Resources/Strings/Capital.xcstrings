    "capital.assets.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtomobil, avadanlıq, broker hesabı, mənzil: dəyərini əl ilə daxil edin, xalis sərvətə əlavə edilsin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аўтамабіль, абсталяванне, брокерскі рахунак, кватэра: ацаніце іх уручную, і яны ўвойдуць у чысты капітал."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto, vybavení, investiční účet nebo byt: zadejte jejich hodnotu a započítají se do čistého jmění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Auto, Ausrüstung, ein Brokerkonto, eine Wohnung: Bewerten Sie es von Hand, dann zählt es im Vermögen mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A car, equipment, a brokerage account, a flat: value it by hand and it counts in net worth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coche, un equipo, una cuenta de inversión, un piso: valórelo a mano y cuenta en el patrimonio neto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une voiture, un équipement, un compte-titres, un appartement : estimez-le à la main et il compte dans le patrimoine net."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավտոմեքենա, սարքավորում, բրոքերային հաշիվ, բնակարան․ գնահատեք դրանք ձեռքով՝ զուտ կապիտալում ներառելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’auto, un’attrezzatura, un conto titoli, un appartamento: inserisci il valore manualmente per includerlo nel patrimonio netto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車、設備、証券口座、マンションなどの価値を手動で入力すると、純資産に計上されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მანქანა, აღჭურვილობა, საბროკერო ანგარიში, ბინა: შეაფასეთ ხელით და ჩაითვლება წმინდა ქონებაში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көлік, жабдық, брокерлік шот, пәтер: оны қолмен бағалаңыз — ол таза байлыққа есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동차, 장비, 증권 계좌, 아파트 등의 가치를 직접 입력하면 순자산에 포함됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Унаа, жабдуу, брокердик эсеп, батир: баасын кол менен киргизиңиз, ал таза капиталга кошулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een auto, apparatuur, een beleggingsrekening of een woning: voer zelf de waarde in om deze mee te tellen in je vermogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samochód, sprzęt, rachunek maklerski, mieszkanie: wyceń je ręcznie, aby uwzględnić je w wartości netto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um carro, equipamento, conta de investimentos ou imóvel: avalie manualmente para incluí-lo no patrimônio líquido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um carro, equipamento, uma conta de investimento, uma casa: avalie-os manualmente para contar no património líquido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина, техника, брокерский счёт, квартира: оцените вручную, и это войдёт в капитал."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мошин, таҷҳизот, ҳисоби брокерӣ ё манзилро дастӣ арзёбӣ кунед, то ба дороии соф дохил шавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araba, ekipman, yatırım hesabı veya ev: Değerini elle girin, net varlığınıza eklensin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автомобіль, обладнання, брокерський рахунок, квартира: оцініть вручну, і вони враховуються в чистому капіталі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtomobil, uskuna, brokerlik hisobi, xonadon: qiymatini qo‘lda kiriting va u sof boylikka qo‘shiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汽车、设备、证券账户或房产：手动估值后即可计入净资产。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "汽車、設備、證券帳戶或房屋：手動估值後即可計入淨資產。"
          }
        }
      }
    },
