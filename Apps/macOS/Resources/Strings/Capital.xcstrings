    "capital.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahib olduqlarınızdan borclarınız çıxıldıqda"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што маеце мінус тое, што вінны"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co máte, minus to, co dlužíte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Sie haben, abzüglich dessen, was Sie schulden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you have less what you owe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que tiene menos lo que debe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez moins ce que vous devez"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր ունեցածը՝ հանած պարտքերը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che hai meno quello che devi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資産から負債を差し引いた金額"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რაც გაქვთ, გამოკლებული თქვენი ვალები"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бар нәрсеңіз мінус берешегіңіз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보유 자산에서 빚을 뺀 금액"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Барыңыздан карызыңыз кемитилген сумма"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bezittingen min je schulden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co masz, pomniejszone o zobowiązania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você tem menos o que deve"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que tem menos o que deve"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что есть минус что должен"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дороиҳо бо тарҳи қарзҳо"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlıklarınızdan borçlarınız çıkarıldığında kalan"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що маєте, мінус те, що винні"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavjud mablag‘ingizdan qarzlaringiz ayirilgan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持有资产减去欠款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資產減去負債"
          }
        }
      }
    },
