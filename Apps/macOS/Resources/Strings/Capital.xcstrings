    "capital.assets.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The property goes with all its valuations. ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bien se elimina con todas sus valoraciones. ⌘Z las devuelve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся имущество и все его оценки. ⌘Z вернёт их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майно видаляється разом з усіма його оцінками. ⌘Z поверне їх."
          }
        }
      }
    },
    "capital.assets.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The property goes with all its valuations. “Undo” brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bien se elimina con todas sus valoraciones. «Deshacer» las devuelve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся имущество и все его оценки. «Отменить» вернёт их."
