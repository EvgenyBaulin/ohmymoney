    "capital.countedTwice": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» həm mənfi balanslı hesab, həm də kredit kartı borcudur: məbləğ iki dəfə çıxıla bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — і рахунак з адмоўным балансам, і доўг па крэдытнай карце: сума можа быць аднята двойчы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» je účet se záporným zůstatkem i dluh na kreditní kartě. Částka se může odečíst dvakrát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist sowohl ein Konto im Minus als auch eine Kreditkartenschuld: Sein Geld könnte zweimal abgezogen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» is both an account below zero and a credit card debt: its money may be taken off twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» es a la vez una cuenta en negativo y una deuda de tarjeta de crédito: su dinero podría restarse dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est à la fois un compte à découvert et une dette de carte de crédit : son argent risque d'être retiré deux fois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»-ը և՛ բացասական մնացորդով հաշիվ է, և՛ վարկային քարտի պարտք․ գումարը կարող է երկու անգամ հանվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è sia un conto con saldo negativo sia un debito su carta di credito: l’importo potrebbe essere sottratto due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»は残高がマイナスの口座であり、クレジットカードの負債でもあるため、二重に差し引かれる可能性があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» არის როგორც უარყოფითი ნაშთის მქონე ანგარიში, ისე საკრედიტო ბარათის დავალიანება: თანხა შეიძლება ორჯერ გამოაკლდეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — нөлден төмен есеп-шот та, кредиттік карта берешегі де: оның ақшасы екі рет алынуы мүмкін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»은(는) 잔액이 마이너스인 계좌이자 신용 카드 부채로, 금액이 두 번 차감될 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» терс баланстагы эсеп да, кредиттик карта карызы да болуп саналат: анын суммасы эки жолу алынышы мүмкүн."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ is zowel een rekening met een negatief saldo als een creditcardschuld. Het bedrag wordt mogelijk dubbel afgetrokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» jest zarówno kontem z ujemnym saldem, jak i zadłużeniem na karcie kredytowej: kwota może zostać odjęta dwukrotnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» é uma conta com saldo negativo e também uma dívida de cartão de crédito: o valor pode ser descontado duas vezes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» é uma conta com saldo negativo e uma dívida de cartão de crédito: o valor pode ser descontado duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — и счёт в минусе, и долг по кредитной карте: его деньги могут вычитаться дважды."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ҳам ҳисоби манфӣ ва ҳам қарзи корти кредитӣ аст: маблағи он метавонад ду бор тарҳ шавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» hem eksi bakiyeli bir hesap hem de kredi kartı borcu: Tutarı iki kez düşülebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — і рахунок з мінусовим залишком, і борг по кредитній картці: його гроші можуть бути відняті двічі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» manfiy qoldiqli hisob ham, kredit karta qarzi ham: uning summasi ikki marta ayrilishi mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»既是负余额账户，也是一笔信用卡欠款：金额可能被扣除两次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」的帳戶餘額為負數，也有信用卡負債：金額可能會扣除兩次。"
          }
        }
      }
    },
