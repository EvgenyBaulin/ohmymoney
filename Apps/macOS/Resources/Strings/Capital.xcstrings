{
  "sourceLanguage": "en",
  "strings": {
    "capital.accrued": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "+ налічана ≈ %@, не ўлічваецца да выплаты"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "+ aufgelaufen ≈ %@, nicht gezählt, bis es ausgezahlt ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+ accrued ≈ %@, not counted until paid"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+ acumulado ≈ %@, no se cuenta hasta que se cobre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "+ accumulés ≈ %@, non comptés tant qu'ils ne sont pas versés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "+ maturati ≈ %@, conteggiati al pagamento"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "+ есептелген ≈ %@, төленгенше саналмайды"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "+ naliczone ≈ %@, uwzględniane po wypłacie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "+ начислено ≈ %@, не учтено до выплаты"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "+ нараховано ≈ %@, не враховується, доки не сплачено"
          }
        }
      }
    },
