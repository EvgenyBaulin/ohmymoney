    "capital.valuation.replaces": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün üçün artıq qiymətləndirmə var. Yenisi onu əvəz edəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На гэты дзень ужо ёсць ацэнка. Новая заменіць яе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento den už ocenění existuje. Toto ho nahradí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag gibt es bereits eine Bewertung: Diese ersetzt sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That day has a valuation already: this one takes its place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese día ya hay una valoración: esta la sustituye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jour-là a déjà une estimation : celle-ci la remplace."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ օրվա համար արդեն գնահատում կա․ նորը կփոխարինի դրան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già una valutazione per questo giorno: verrà sostituita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日の評価額は登録済みです。新しい評価額に置き換えられます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თარიღზე შეფასება უკვე არსებობს. ის ახლით ჩანაცვლდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол күнге бағалау бұрыннан бар: бұл оның орнын басады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 날짜에 이미 평가액이 있어 이 평가액으로 대체됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ал күнгө баа бар: анын ордуна ушул баа коюлат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is al een waardering op deze dag. Deze wordt vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycena dla tego dnia już istnieje. Nowa wycena ją zastąpi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma avaliação para esse dia. Esta vai substituí-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma avaliação para este dia. Esta irá substituí-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На эту дату уже есть оценка — новая её заменит."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ин рӯз аллакай арзёбӣ ҳаст: арзёбии нав ҷойи онро мегирад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün için zaten bir değerleme var. Bu değerleme onun yerini alacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цей день уже є оцінка: ця її замінить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kunda baho mavjud. Yangi baho uning o‘rnini egallaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该日期已有估值，新估值将取代原有估值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天已有估值，此估值將取代原有估值。"
          }
        }
      }
    },
