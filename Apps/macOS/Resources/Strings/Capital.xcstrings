{
  "sourceLanguage": "en",
  "strings": {
    "capital.accrued": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "+ hesablanıb ≈ %@, ödənənədək sayılmır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "+ налічана ≈ %@, не ўлічваецца да выплаты"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "+ naběhlo ≈ %@, započítá se po připsání"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "+ aufgelaufen ≈ %@, nicht gezählt, bis es ausgezahlt ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+ accrued ≈ %@, not counted until paid"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+ acumulado ≈ %@, no se cuenta hasta que se cobre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "+ accumulés ≈ %@, non comptés tant qu'ils ne sont pas versés"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "+ հաշվեգրված ≈ %@, կհաշվվի վճարվելուց հետո"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "+ maturati ≈ %@, conteggiati al pagamento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 未受取分 ≈ %@（受取後に計上）"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "+ დარიცხული ≈ %@, არ ჩაითვლება გადახდამდე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "+ есептелген ≈ %@, төленгенше саналмайды"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 발생 이자 ≈ %@, 지급 전까지 미포함"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "+ эсептелгени ≈ %@, төлөнгөнгө чейин эсепке алынбайт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "+ opgebouwd ≈ %@, telt mee na uitbetaling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "+ naliczone ≈ %@, uwzględniane po wypłacie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "+ rendimentos acumulados ≈ %@, não incluídos até o pagamento"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "+ juros acumulados ≈ %@, só contam após pagamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "+ начислено ≈ %@, не учтено до выплаты"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "+ ҳисобшуда ≈ %@, то пардохт ба ҳисоб гирифта намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "+ tahakkuk eden ≈ %@, ödenene kadar sayılmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "+ нараховано ≈ %@, не враховується, доки не сплачено"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "+ hisoblangan ≈ %@, to‘languncha hisobga olinmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 应计 ≈ %@，支付后计入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 已累計約 %@，支付後才計入"
          }
        }
      }
    },
