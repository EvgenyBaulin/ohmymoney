    "capital.editor.valueHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni dəyər üçün sətir menyusunda «Yeni qiymətləndirmə…» seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Новыя ацэнкі: «Новая ацэнка…» ў меню адпаведнага радка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Novou hodnotu zadáte volbou «Nové ocenění…» v nabídce příslušného řádku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Werte: „Neue Bewertung…“ im Menü seiner Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New values: «New valuation…» in the menu of its row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevos valores: «Nueva valoración…» en el menú de su fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelles valeurs : « Nouvelle estimation… » dans le menu de sa ligne."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նոր արժեքների համար ընտրեք «Նոր գնահատում…»՝ գույքի տողի ընտրացանկում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiornare il valore, scegli «Nuova valutazione…» nel menu della riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい評価額は、行のメニューの«評価額を追加…»から入力できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალი ღირებულებისთვის აირჩიეთ «ახალი შეფასება…» შესაბამისი რიგის მენიუში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа құн: жолының мәзірінде «Жаңа бағалау…»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 평가액은 해당 행의 메뉴에서 «새 평가…»를 선택하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңы баа кошуу үчүн анын сабынын менюсунан «Жаңы баа…» тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe waarde: kies ‘Nieuwe waardering…’ in het menu van de rij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać nową wartość, wybierz «Nowa wycena…» w menu wiersza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para atualizar o valor, escolha «Nova avaliação…» no menu do bem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para atualizar o valor, escolha «Nova avaliação…» no menu da respetiva linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая стоимость — «Новая оценка…» в меню строки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои арзиши нав дар менюи сатри он «Арзёбии нав…»-ро интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni değerler için varlığın satır menüsünde «Yeni Değerleme…» öğesini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові вартості: «Нова оцінка…» в меню його рядка."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi qiymat kiritish uchun qator menyusidan «Yangi baho…»ni tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要更新价值，请在该行菜单中选择«新增估值…»。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要更新價值，請從該項目的選單中選擇「新增估值…」。"
          }
        }
      }
    },
    "capital.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ hesablanacaq heç nə yoxdur: hesabı tutuşdurun və ya əmlak əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма чаго падлічваць: зверце рахунак або дадайце маёмасць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není co započítat: odsouhlaste účet nebo přidejte majetek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zu zählen: Gleichen Sie ein Konto ab oder fügen Sie einen Vermögenswert hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to count yet: reconcile an account or add property."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que contar: concilie una cuenta o añada un bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à compter pour l'instant : rapprochez un compte ou ajoutez un bien."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ հաշվարկելու ոչինչ չկա․ համադրեք հաշիվը կամ ավելացրեք գույք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dato da conteggiare: riconcilia un conto o aggiungi un bene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計上するものがありません。口座の残高を照合するか、資産を追加してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არაფერია დასათვლელი: შეაჯერეთ ანგარიში ან დაამატეთ ქონება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептеуге әлі ештеңе жоқ: есеп-шотты салыстырыңыз немесе мүлік қосыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산할 항목이 없습니다. 계좌를 대조하거나 재산을 추가하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча эсептей турган эч нерсе жок: эсепти салыштырыңыз же мүлк кошуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets om te berekenen: controleer een rekening of voeg een bezitting toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze czego zliczać: uzgodnij konto lub dodaj składnik majątku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a calcular ainda: concilie uma conta ou adicione um bem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada a contabilizar: reconcilie uma conta ou adicione um bem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего считать: сверьте счёт или добавьте имущество."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз чизе барои ҳисоб нест: ҳисобро муқоиса кунед ё амвол илова кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hesaplanacak bir şey yok: Bir hesabı mutabıklaştırın veya varlık ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки нічого порахувати: звірте рахунок або додайте майно."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha hisoblash uchun hech narsa yo‘q: hisobni solishtiring yoki mulk qo‘shing."
