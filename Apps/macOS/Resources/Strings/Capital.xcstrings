    "capital.assets.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əmlak bütün qiymətləndirmələri ilə silinəcək. ⌘Z onları bərpa edəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Маёмасць будзе выдалена разам з усімі ацэнкамі. ⌘Z верне іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Majetek bude smazán včetně všech ocenění. Klávesami ⌘Z ho obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vermögenswert geht mit allen seinen Bewertungen. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The property goes with all its valuations. ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bien se elimina con todas sus valoraciones. ⌘Z las devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bien part avec toutes ses estimations. ⌘Z les rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գույքը կջնջվի բոլոր գնահատումների հետ։ ⌘Z-ը կվերականգնի դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bene verrà eliminato con tutte le sue valutazioni. Premi ⌘Z per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資産とすべての評価額が削除されます。⌘Zで元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ქონება ყველა შეფასებასთან ერთად წაიშლება. ⌘Z მათ აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мүлік барлық бағалауымен бірге кетеді. ⌘Z оларды қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재산과 모든 평가액이 삭제됩니다. ⌘Z로 되돌릴 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мүлк бардык баалары менен кошо өчүрүлөт. ⌘Z аларды калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bezitting en alle waarderingen worden verwijderd. Met ⌘Z herstel je ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Składnik majątku zostanie usunięty wraz ze wszystkimi wycenami. Aby go przywrócić, naciśnij ⌘Z."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bem e todas as suas avaliações serão apagados. Use ⌘Z para restaurá-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bem e todas as suas avaliações serão apagados. Prima ⌘Z para os recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся имущество и все его оценки. ⌘Z вернёт их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амвол бо ҳамаи арзёбиҳояш нест мешавад. ⌘Z онҳоро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlık, tüm değerlemeleriyle birlikte silinir. ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майно видаляється разом з усіма його оцінками. ⌘Z поверне їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulk barcha baholari bilan o‘chiriladi. ⌘Z ularni tiklaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该财产及其所有估值都将被删除。按下 ⌘Z 可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資產及其所有估值都會刪除。按 ⌘Z 可還原。"
          }
        }
      }
    },
