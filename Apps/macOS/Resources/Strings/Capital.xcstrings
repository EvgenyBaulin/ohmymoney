    "capital.assets.empty": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аўтамабіль, абсталяванне, брокерскі рахунак, кватэра: ацаніце іх уручную, і яны ўвойдуць у чысты капітал."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Auto, Ausrüstung, ein Brokerkonto, eine Wohnung: Bewerten Sie es von Hand, dann zählt es im Vermögen mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A car, equipment, a brokerage account, a flat: value it by hand and it counts in net worth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coche, un equipo, una cuenta de inversión, un piso: valórelo a mano y cuenta en el patrimonio neto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une voiture, un équipement, un compte-titres, un appartement : estimez-le à la main et il compte dans le patrimoine net."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’auto, un’attrezzatura, un conto titoli, un appartamento: inserisci il valore manualmente per includerlo nel patrimonio netto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көлік, жабдық, брокерлік шот, пәтер: оны қолмен бағалаңыз — ол таза байлыққа есептеледі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samochód, sprzęt, rachunek maklerski, mieszkanie: wyceń je ręcznie, aby uwzględnić je w wartości netto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина, техника, брокерский счёт, квартира: оцените вручную, и это войдёт в капитал."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автомобіль, обладнання, брокерський рахунок, квартира: оцініть вручну, і вони враховуються в чистому капіталі."
          }
        }
      }
    },
