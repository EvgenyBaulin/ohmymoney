    "capital.warning.unanchored": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzləşdirilməyib, hesablanmayıb: %@"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зверана, не ўлічана: %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neodsouhlaseno, nezapočítáno: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht abgeglichen, nicht gezählt: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not reconciled, not counted: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conciliar, no se cuenta: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non rapproché, non compté : %@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չի համադրվել, չի հաշվարկվել՝ %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riconciliati, esclusi dal totale: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高未照合のため集計対象外: %@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არ არის შეჯერებული და არ ითვლება: %@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыстырылмаған, есептелмейді: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액을 확인하지 않아 계산에서 제외됨: %@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салыштырылган эмес, эсепке алынган жок: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet afgestemd, niet meegeteld: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuzgodnione, nie uwzględniono: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conciliado, não contabilizado: %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por reconciliar, não contabilizado: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сверен, не учтён: %@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мувофиқ нашудааст, ба ҳисоб гирифта нашудааст: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutabakat yapılmadı, hesaba katılmadı: %@"
          }
        },
        "uk": {
          "stringUnit": {
