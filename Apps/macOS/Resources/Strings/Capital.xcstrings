    "capital.assets.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Маёмасць будзе выдалена разам з усімі ацэнкамі. ⌘Z верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vermögenswert geht mit allen seinen Bewertungen. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The property goes with all its valuations. ⌘Z brings them back."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bene verrà eliminato con tutte le sue valutazioni. Premi ⌘Z per ripristinarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мүлік барлық бағалауымен бірге кетеді. ⌘Z оларды қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся имущество и все его оценки. ⌘Z вернёт их."
          }
        }
      }
    },
    "capital.assets.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Маёмасць будзе выдалена разам з усімі ацэнкамі. “Адмяніць” верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vermögenswert geht mit allen seinen Bewertungen. „Rückgängig“ holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The property goes with all its valuations. “Undo” brings them back."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bene verrà eliminato con tutte le sue valutazioni. Tocca “Annulla” per ripristinarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мүлік барлық бағалауымен бірге кетеді. «Болдырмау» оларды қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся имущество и все его оценки. «Отменить» вернёт их."
          }
        }
      }
    },
