    "capital.chart.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qrafik üçün ən azı bir tam ay başa çatmalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для графіка патрэбны канец хаця б аднаго поўнага месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zobrazení grafu musí uplynout alespoň jeden celý měsíc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Diagramm braucht das Ende von mindestens einem vollen Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chart needs the end of at least one full month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gráfico necesita el cierre de al menos un mes completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le graphique demande la fin d'au moins un mois complet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գծապատկերի համար անհրաժեշտ է առնվազն մեկ ամբողջական ամսվա ավարտ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il grafico richiede almeno un mese completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフを表示するには、少なくとも1か月分の月末データが必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დიაგრამისთვის მინიმუმ ერთი სრული თვის დასრულებაა საჭირო."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Графикке кем дегенде бір толық айдың соңы керек."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차트를 보려면 한 달 이상이 지나야 합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "График үчүн жок дегенде бир толук ай аякташы керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de grafiek is minstens één volledige maand nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykres wymaga co najmniej jednego pełnego miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gráfico precisa de pelo menos um mês completo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O gráfico requer pelo menos um mês completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для графика нужен конец хотя бы одного полного месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои диаграмма анҷоми ҳадди ақал як моҳи пурра лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafik için en az bir tam ayın bitmesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для графіка потрібен кінець хоча б одного повного місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagramma uchun kamida bir to‘liq oy tugashi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图表需要至少一个完整月的月末数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖表需要至少一個完整月份的月底資料。"
          }
        }
      }
    },
