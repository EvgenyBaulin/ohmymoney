    "capital.assets.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Маёмасць будзе выдалена разам з усімі ацэнкамі. ⌘Z верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vermögenswert geht mit allen seinen Bewertungen. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The property goes with all its valuations. ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bien se elimina con todas sus valoraciones. ⌘Z las devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bien part avec toutes ses estimations. ⌘Z les rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bene verrà eliminato con tutte le sue valutazioni. Premi ⌘Z per ripristinarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мүлік барлық бағалауымен бірге кетеді. ⌘Z оларды қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мүлк бардык баалары менен кошо өчүрүлөт. ⌘Z аларды калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Składnik majątku zostanie usunięty wraz ze wszystkimi wycenami. Aby go przywrócić, naciśnij ⌘Z."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bem e todas as suas avaliações serão apagados. Use ⌘Z para restaurá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся имущество и все его оценки. ⌘Z вернёт их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlık, tüm değerlemeleriyle birlikte silinir. ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майно видаляється разом з усіма його оцінками. ⌘Z поверне їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulk barcha baholari bilan o‘chiriladi. ⌘Z ularni tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資產及其所有估值都會刪除。按 ⌘Z 可還原。"
          }
        }
      }
    },
    "capital.assets.delete.message.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Маёмасць будзе выдалена разам з усімі ацэнкамі. “Адмяніць” верне іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vermögenswert geht mit allen seinen Bewertungen. „Rückgängig“ holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The property goes with all its valuations. “Undo” brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bien se elimina con todas sus valoraciones. «Deshacer» las devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bien part avec toutes ses estimations. « Annuler » les rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bene verrà eliminato con tutte le sue valutazioni. Tocca “Annulla” per ripristinarlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мүлік барлық бағалауымен бірге кетеді. «Болдырмау» оларды қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мүлк бардык баалары менен кошо өчүрүлөт. “Undo” аларды калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Składnik majątku zostanie usunięty wraz ze wszystkimi wycenami. Aby go przywrócić, stuknij „Cofnij”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bem e todas as suas avaliações serão apagados. Use “Desfazer” para restaurá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся имущество и все его оценки. «Отменить» вернёт их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlık, tüm değerlemeleriyle birlikte silinir. “Geri Al” ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майно видаляється разом з усіма його оцінками. «Скасувати» поверне їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulk barcha baholari bilan o‘chiriladi. “Bekor qilish” ularni tiklaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資產及其所有估值都會刪除。點一下「復原」可還原。"
          }
        }
      }
    },
