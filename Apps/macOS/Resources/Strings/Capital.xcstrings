            "state": "translated",
            "value": "O que tenho e devo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что есть и что должен"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlıklarım ve Borçlarım"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що маю і що винен"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mablag‘larim va qarzlarim"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的資產與負債"
          }
        }
      }
    },
