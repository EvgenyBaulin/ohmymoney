    "capital.dispose.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlki günədək hesablanır, sonra xalis sərvətdən çıxarılır və «Satılıb» bölməsində göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Улічваецца да папярэдняга дня ўключна, пасля чаго выключаецца з чыстага капіталу і трапляе ў «Прададзена»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do čistého jmění se započítává do předchozího dne, poté se zobrazí v části «Prodáno»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es zählt bis zum Vortag, dann verlässt es das Vermögen und steht unter „Verkauft“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It counts through the day before, then it leaves net worth and is listed under «Sold»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta hasta el día anterior; después sale del patrimonio neto y aparece en «Vendidos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il compte jusqu'à la veille, puis il sort du patrimoine net et figure dans « Vendus »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գույքը հաշվվում է մինչև նախորդ օրը ներառյալ, ապա հանվում է զուտ կապիտալից և հայտնվում «Վաճառված» բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene conteggiato fino al giorno precedente, poi viene escluso dal patrimonio netto e appare in «Venduto»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前日までは純資産に計上され、以降は計上されず、«売却済み»に表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წინა დღის ჩათვლით ითვლება, შემდეგ აკლდება წმინდა ქონებას და გადადის «გაყიდულში»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол алдыңғы күнге дейін есептеледі, содан кейін таза байлықтан шығып, «Сатылды» тізімінде көрсетіледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전날까지 순자산에 포함되며, 이후에는 순자산에서 제외되고 «매각됨»에 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мурунку күнгө чейин эсептелет, андан кийин таза капиталдан алынып, «Сатылган» бөлүмүнө өтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt mee tot en met de vorige dag. Daarna verdwijnt deze uit je nettovermogen en staat deze onder ‘Verkocht’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Składnik jest uwzględniany do poprzedniego dnia, a następnie znika z wartości netto i trafia do «Sprzedane»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta até o dia anterior. Depois, sai do patrimônio líquido e aparece em «Vendido»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta até ao dia anterior. Depois, deixa de contar no património líquido e aparece em «Vendido»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считается по предыдущий день, потом уходит из капитала в «Проданное»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То рӯзи пеш ҳисоб мешавад, баъд аз дороии соф хориҷ шуда, дар «Фурӯхта шуд» нишон дода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir önceki güne kadar net varlığa dahil edilir, ardından net varlıktan çıkarılır ve «Satıldı» altında listelenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майно враховується до попереднього дня, потім виходить з чистого капіталу і з'являється в «Продано»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldingi kungacha hisobga olinadi, so‘ng sof boylikdan chiqarilib, «Sotilgan» bo‘limiga o‘tadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计入至前一天，之后将从净资产中移除，并列于«已出售»。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計入至前一天，之後從淨資產中移除並列於「已售出」。"
          }
        }
      }
    },
