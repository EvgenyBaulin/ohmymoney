        }
      }
    },
    "deductions.document.ownershipExtract": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əmlak reyestrindən çıxarış və ya aktla birlikdə paylı tikinti müqaviləsi"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выпіска з рэестра нерухомасці або дагавор долевага будаўніцтва з актам"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výpis z katastru nemovitostí nebo smlouva o účasti na výstavbě s předávacím protokolem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auszug aus dem Immobilienregister oder Vertrag über den gemeinsamen Bau mit Übergabeprotokoll"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extract from the property register, or the shared-construction contract with its act"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extracto del registro de la propiedad o contrato de construcción compartida con su acta de entrega"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrait du registre immobilier ou contrat de construction participative et son acte"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անշարժ գույքի ռեգիստրի քաղվածքը կամ համատեղ շինարարության պայմանագիրն ու ակտը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estratto del registro immobiliare o contratto di costruzione condivisa con relativo verbale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不動産登記簿の抜粋、または共同建設契約書と引渡証書"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამონაწერი უძრავი ქონების რეესტრიდან ან წილობრივი მშენებლობის ხელშეკრულება მიღება-ჩაბარების აქტით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылжымайтын мүлік тізілімінен үзінді немесе актісімен бірге үлестік құрылыс шарты"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부동산 등기부 등본 또는 공동 건설 계약서와 인수 확인서"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кыймылсыз мүлк реестринен көчүрмө же үлүштүк курулуш келишими жана анын актысы"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uittreksel uit het eigendomsregister of de overeenkomst voor gezamenlijke bouw met opleveringsakte"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpis z rejestru nieruchomości lub umowa o wspólnej budowie wraz z protokołem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certidão do registro do imóvel ou contrato de construção compartilhada com termo de entrega"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certidão do registo predial ou contrato de construção partilhada com o respetivo auto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выписка из ЕГРН или договор долевого участия с актом"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Иқтибос аз феҳристи амвол ё шартномаи сохтмони муштарак бо санади он"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapu sicil kaydı veya teslim tutanağıyla birlikte ortak inşaat sözleşmesi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витяг із реєстру нерухомості або договір пайової участі з актом"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulk reyestridan ko'chirma yoki ulushli qurilish shartnomasi va uning dalolatnomasi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trích lục từ sổ đăng ký bất động sản, hoặc hợp đồng xây dựng chung kèm biên bản nghiệm thu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Выписка из ЕГРН или договор долевого строительства с актом"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產權登記摘錄，或共同建造合約及其驗收文件"
          }
        }
      }
    },
