    "deductions.refund.exactHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gəlir vergisindən çox deyil; hər rubl üçün şkalanın müvafiq pilləsinin dərəcəsi tətbiq edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не больш за падатак з даходу, кожны рубель — па стаўцы адпаведнай ступені шкалы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvýš zaplacenou daň z příjmu; každý rubl se počítá sazbou příslušného daňového pásma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens die gezahlte Einkommensteuer, berechnet für jeden Rubel mit dem Steuersatz seiner Tarifstufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not more than the tax on the income, each ruble at the rate of its step of the scale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No supera el impuesto sobre los ingresos; cada rublo se calcula al tipo de su tramo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au maximum l’impôt sur le revenu, chaque rouble étant calculé au taux de sa tranche."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եկամտի հարկից ոչ ավելի․ յուրաքանչյուր ռուբլին հաշվարկվում է սանդղակի համապատասխան աստիճանի դրույքաչափով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non oltre l’imposta sul reddito, applicando a ogni rublo l’aliquota del relativo scaglione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所得税額を上限に、各所得区分の税率で計算されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არაუმეტეს შემოსავლის გადასახადისა; თითოეული რუბლი იბეგრება სკალის შესაბამისი საფეხურის განაკვეთით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табыс салығынан аспайды; әр рубльге шкаланың тиісті мөлшерлемесі қолданылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소득세를 초과하지 않으며, 각 금액에 해당 소득 구간의 세율을 적용합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кирешеден төлөнгөн салыктан ашпайт; ар бир рубль шкаланын тиешелүү баскычынын чени менен эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet meer dan de belasting over het inkomen, per roebel tegen het tarief van de bijbehorende schijf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie więcej niż podatek od dochodu, liczony dla każdego rubla według stawki właściwego progu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até o valor do imposto sobre a renda, com cada rublo calculado à alíquota da respectiva faixa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo, o imposto sobre os rendimentos, aplicando a cada rublo a taxa do respetivo escalão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не больше налога с дохода, каждый рубль — по ставке своей ступени шкалы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "На бештар аз андози даромад; ҳар рубл бо меъёри зинаи дахлдор ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelir üzerinden ödenen vergiyi aşmaz; her ruble kendi vergi diliminin oranıyla hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не більше за податок на дохід; кожен рубль — за ставкою відповідного ступеня шкали."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Daromaddan to'langan soliqdan oshmaydi; har bir rublga shkalaning tegishli stavkasi qo'llanadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không vượt quá thuế thu nhập, mỗi rúp được tính theo mức của bậc thang thuế tương ứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Не больше налога с дохода: каждый рубль по ставке своей ступени шкалы."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不超過所得稅額，每盧布按其所屬稅率級距計算。"
          }
        }
      }
    },
