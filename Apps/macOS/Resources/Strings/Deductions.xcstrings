    "deductions.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, məsləhət deyil, bələdçidir: müraciət vergi idarəsinə, şəxsi kabinetdə və ya Gosuslugi-də edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даведка, а не парада: заяву трэба падаць у падатковую, у асабістым кабінеце або на Gosuslugi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientační informace, nikoli poradenství: žádost se podává finančnímu úřadu, v jeho osobním účtu nebo přes Gosuslugi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Orientierung, keine Beratung: Der Antrag geht an das Finanzamt, über dessen persönliches Konto oder über Gosuslugi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A guide, not advice: the claim goes to the tax office, in its personal account or on Gosuslugi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una guía, no asesoramiento: la solicitud se presenta ante la Agencia Tributaria, en su área personal o en Gosuslugi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide indicatif : la demande se fait auprès du fisc, dans votre espace personnel ou sur Gosuslugi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա ուղեցույց է, ոչ թե խորհրդատվություն։ Դիմումը ներկայացվում է հարկային՝ անձնական հաշվի կամ Gosuslugi-ի միջոցով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una guida, non una consulenza: presenta la richiesta all’ufficio fiscale, nell’area personale o su Gosuslugi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは目安であり、助言ではありません。税務署の個人アカウントまたはGosuslugiから申告してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს გზამკვლევია და არა რჩევა: განაცხადი შეიტანეთ საგადასახადოში, პირად კაბინეტში ან Gosuslugi-ზე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл — кеңес емес, нұсқаулық: өтініш салық органына, жеке кабинетте немесе Gosuslugi арқылы беріледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고용 안내입니다. 공제는 세무서, 세무서 개인 계정 또는 Gosuslugi에서 신청하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул кеңеш эмес, маалымдама: арыз салык кызматына жеке кабинетте же Госуслуги аркылуу берилет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een richtlijn, geen advies: vraag de aftrek aan bij de belastingdienst, in je persoonlijke account of via Gosuslugi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wskazówki, nie porada podatkowa. Wniosek złóż w urzędzie skarbowym, na jego portalu lub przez Gosuslugi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um guia, não uma orientação fiscal: solicite a dedução à Receita, na conta pessoal ou pelo Gosuslugi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um guia, não um aconselhamento: o pedido é feito à autoridade fiscal, na área pessoal ou no Gosuslugi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это подсказка, а не консультация: заявление подаётся в ФНС — в личном кабинете или на «Госуслугах»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин роҳнамо аст, на маслиҳат: дархост ба идораи андоз, дар кабинети шахсӣ ё дар Gosuslugi фиристода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir rehberdir, tavsiye değildir: Başvuru vergi dairesine, kişisel hesabından veya Gosuslugi üzerinden yapılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довідкова інформація, а не порада: заяву подають до податкової, в особистому кабінеті або на Gosuslugi."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu maslahat emas, yo'riqnoma: ariza soliq idorasiga, shaxsiy kabinetda yoki Gosuslugi orqali yuboriladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là hướng dẫn, không phải tư vấn: yêu cầu hoàn thuế được gửi đến cơ quan thuế, qua tài khoản cá nhân hoặc trên Gosuslugi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Справочная информация, а не совет: заявление подаётся в налоговую — в личном кабинете или через Госуслуги."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供參考，並非建議：申報需提交至稅務機關的個人帳戶或 Gosuslugi。"
          }
        }
      }
    },
