    "deductions.mortgage.priorUnknown": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit əvvəlki illər nəzərə alınmadan hesablanır: faizlərə görə artıq güzəşt almısınızsa, qalan limit daha azdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт разлічаны без уліку папярэдніх гадоў: калі вы ўжо атрымлівалі вылік за працэнты, ён меншы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit se počítá bez předchozích let: pokud jste už odpočet úroků uplatnili, je nižší."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Höchstbetrag wird ohne frühere Jahre berechnet. Bereits geltend gemachte Zinsen verringern ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit is counted without earlier years: if you already took a deduction on interest, it is smaller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite se calcula sin tener en cuenta años anteriores: si ya dedujiste intereses, será menor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plafond est calculé sans les années précédentes : si vous avez déjà déduit des intérêts, il est réduit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանաչափը հաշվարկված է առանց նախորդ տարիների։ Եթե արդեն ստացել եք տոկոսների նվազեցում, մնացորդն ավելի փոքր է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite è calcolato senza gli anni precedenti: se hai già detratto interessi, il limite residuo è inferiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限は過去の控除を考慮せずに計算されています。利息の控除を受けたことがある場合、残りの上限は少なくなります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლიმიტი წინა წლების გარეშეა დათვლილი: თუ პროცენტზე გამოქვითვა უკვე მიიღეთ, დარჩენილი ლიმიტი ნაკლებია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шек алдыңғы жылдар ескерілмей есептелген: пайыздар бойынша шегерім алған болсаңыз, қалған сома аз болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 연도는 한도 계산에 반영되지 않았습니다. 이자 공제를 받은 적이 있다면 남은 한도가 더 적습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек мурунку жылдарды эске албастан эсептелди: пайыздар үчүн чегерим алган болсоңуз, калган чек азыраак."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet is berekend zonder eerdere jaren: als je al rente hebt afgetrokken, is de resterende limiet lager."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit nie uwzględnia poprzednich lat. Jeśli odliczono już odsetki, pozostały limit jest niższy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite é calculado sem considerar anos anteriores: se você já deduziu juros, o limite restante é menor."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite é calculado sem os anos anteriores: se já deduziu juros, o valor disponível é menor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит посчитан без прошлых лет: если вы уже получали вычет по процентам, он меньше."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маҳдудият бидуни солҳои пеш ҳисоб шудааст: агар аллакай барои фоизҳо тарҳ гирифта бошед, он камтар аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınır, önceki yıllar hesaba katılmadan hesaplanır: Daha önce faiz indirimi aldıysanız kalan tutar daha azdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт розраховано без урахування попередніх років: якщо ви вже отримували відрахування за відсотками, він менший."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit avvalgi yillarsiz hisoblangan: foizlar uchun oldin chegirma olgan bo'lsangiz, u kamroq bo'ladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn được tính không kể các năm trước: nếu bạn đã nhận khấu trừ tiền lãi, mức còn lại sẽ nhỏ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит считается без учёта прошлых лет: если проценты уже были включены в вычет, он будет меньше."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上限計算不含前幾年：若已就利息申報過扣除，可用額度將減少。"
          }
        }
      }
    },
    "deductions.noRules": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
