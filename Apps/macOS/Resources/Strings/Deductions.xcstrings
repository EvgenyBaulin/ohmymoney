    "deductions.open.help": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İl üzrə vergi idarəsindən nə qədər geri almaq olar və hansı sənədlər lazımdır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што можна вярнуць з падатковай за год і якія дакументы патрэбны"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik můžete za rok získat zpět od finančního úřadu a jaké doklady potřebujete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mögliche Steuererstattung für das Jahr und benötigte Unterlagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can come back from the tax office for the year and which documents it asks for"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto puede devolverte la Agencia Tributaria por el año y qué documentos necesitas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montant remboursable par le fisc pour l’année et documents nécessaires"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչ գումար կարող է հարկայինը վերադարձնել տարվա համար և ինչ փաստաթղթեր են անհրաժեշտ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto puoi ricevere dall’ufficio fiscale per l’anno e quali documenti servono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今年の還付見込額と税務署への必要書類"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რამდენის დაბრუნებაა შესაძლებელი წლისთვის და რა საბუთებს ითხოვს საგადასახადო"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір жылда салықтан қанша қайтаруға болады және қандай құжаттар қажет"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올해 환급받을 수 있는 금액과 세무서에 필요한 서류"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жыл ичинде салык кызматынан канча кайтарылат жана кандай документтер керек"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je dit jaar kunt terugkrijgen van de belastingdienst en welke documenten je nodig hebt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możliwy zwrot podatku za rok i wymagane dokumenty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto pode ser restituído pela Receita no ano e quais documentos são necessários"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pode receber da autoridade fiscal pelo ano e os documentos necessários"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько можно вернуть из налоговой за год и какие документы нужны"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чӣ қадар андозро барои сол баргардондан мумкин аст ва кадом ҳуҷҷатҳо лозиманд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıl için vergi dairesinden ne kadar iade alınabileceği ve hangi belgelerin gerektiği"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що можна повернути з податкової за рік і які документи потрібні"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yil uchun soliq idorasidan qancha qaytishi va qanday hujjatlar kerakligi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những khoản nào có thể được cơ quan thuế hoàn lại trong năm và các giấy tờ cần thiết"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Что можно вернуть из налоговой за год и какие документы она запросит"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本年度可能從稅務機關退回的金額，以及所需文件"
          }
        }
      }
    },
