            "value": "Клиникадан салық органына арналған медициналық қызметтер ақысы туралы анықтама"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병원 발급 세무서 제출용 의료비 납입 증명서"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиникадан салык кызматы үчүн медициналык кызматтарга төлөм жөнүндө маалымкат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verklaring van de kliniek over betaalde medische zorg voor de belastingdienst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaświadczenie o opłaceniu usług medycznych dla urzędu skarbowego, z placówki medycznej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprovante de pagamento de serviços médicos para a Receita, emitido pela clínica"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Declaração da clínica dos serviços médicos pagos, para a autoridade fiscal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справка об оплате медицинских услуг для налоговой — от клиники"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумотнома аз клиника дар бораи пардохти хизматрасониҳои тиббӣ барои идораи андоз"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinikten vergi dairesi için alınan sağlık hizmeti ödeme belgesi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довідка про оплату медичних послуг для податкової від клініки"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soliq idorasi uchun klinikadan to'langan tibbiy xizmatlar haqida ma'lumotnoma"
          }
