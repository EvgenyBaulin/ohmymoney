        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contratto di istruzione e licenza, se non indicata nel contratto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "教育機関との契約書、および契約書に記載がない場合は免許証"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სწავლის ხელშეკრულება და ლიცენზია, თუ ის ხელშეკრულებაში მითითებული არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оқу шарты және шартта көрсетілмесе, лицензия"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교육 계약서 및 계약서에 명시되지 않은 경우 인가증"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Окутуу келишими жана анда көрсөтүлбөсө, лицензиясы"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderwijsovereenkomst en de vergunning als die niet in de overeenkomst staat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umowa o naukę oraz licencja, jeśli umowa jej nie wskazuje"
