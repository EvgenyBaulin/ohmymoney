    "deductions.refund.upToHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İl üzrə gəlir göstərilməyib: ən azı bu qədər gəlir vergisi ödənilibsə, %@ dərəcəsi ilə hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход за год не пазначаны: разлічана па стаўцы %@, калі выплачана не менш за гэтую суму падаходнага падатку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjem za rok není uveden: počítáno sazbou %@ za předpokladu, že byla zaplacena alespoň taková daň z příjmu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Jahreseinkommen angegeben: Berechnet mit %@, sofern mindestens so viel Einkommensteuer gezahlt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No income for the year is given: counted at %@, if at least that much income tax was paid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han indicado ingresos para el año: se calcula al %@, siempre que se haya pagado al menos esa cantidad en impuestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun revenu annuel indiqué : calcul à %@, sous réserve d’avoir payé au moins ce montant d’impôt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարվա եկամուտը նշված չէ․ հաշվարկված է %@ դրույքաչափով, եթե վճարվել է առնվազն այդքան եկամտահարկ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun reddito annuo indicato: calcolato al %@, se hai pagato almeno tale importo in imposte sul reddito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間所得が未入力のため、%@で計算しています。同額以上の所得税を納めている場合の金額です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წლის შემოსავალი მითითებული არ არის: დათვლილია %@ განაკვეთით, თუ სულ მცირე ამდენი საშემოსავლო გადასახადი გადაიხადეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылдық табыс көрсетілмеген: кемінде осы сомаға тең табыс салығы төленсе, %@ мөлшерлемесімен есептеледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연간 소득이 입력되지 않아 %@ 세율로 계산했습니다. 해당 금액 이상의 소득세를 납부한 경우에 적용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылдык киреше көрсөтүлгөн жок: %@ чени менен эсептелди, эгер киреше салыгы кеминде ушул суммада төлөнсө."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen jaarinkomen opgegeven: berekend tegen %@, als minstens dat bedrag aan inkomstenbelasting is betaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie podano dochodu za rok. Kwotę obliczono według stawki %@, przy założeniu, że zapłacono co najmniej tyle podatku dochodowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma renda anual informada: calculado à alíquota de %@, se ao menos esse valor de imposto de renda tiver sido pago."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram indicados rendimentos para o ano: calculado a %@, desde que tenha sido pago pelo menos esse valor em imposto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход за год не указан: считаем по ставке %@, если НДФЛ уплачен не меньше."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади солона нишон дода нашудааст: бо меъёри %@ ҳисоб шудааст, агар на камтар аз ин маблағ андози даромад пардохт шуда бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık gelir girilmedi: En az bu tutarda gelir vergisi ödenmişse %@ oranıyla hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід за рік не вказано: розраховано за ставкою %@, якщо сплачено не менше податку на дохід."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yillik daromad ko'rsatilmagan: %@ stavkada hisoblangan, agar kamida shu miqdorda daromad solig'i to'langan bo'lsa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có thu nhập cả năm: tính theo %@, nếu đã nộp ít nhất ngần ấy thuế thu nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход за год не указан: расчёт идёт по %@, если подоходного налога уплачено не меньше этой суммы."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未提供本年收入：若已繳納的所得稅至少達此金額，則以 %@ 計算。"
          }
        }
      }
    },
