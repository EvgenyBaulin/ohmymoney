    "deductions.group.mortgageNote": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit ömür boyu bir mənzil üçün keçərlidir; tətbiq əvvəllər alınan güzəştləri bilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт дзейнічае на ўсё жыццё і адно жыллё; праграме невядома, што было заяўлена раней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit platí na celý život a jednu nemovitost; aplikace neví, co bylo uplatněno dříve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Höchstbetrag gilt lebenslang für eine Immobilie. Die App kennt frühere Abzüge nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit is for life and one home; the app does not know what was claimed before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite es vitalicio y para una sola vivienda; la app no sabe lo que se ha deducido antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plafond s’applique à vie pour un seul logement ; l’app ne connaît pas les déductions déjà demandées."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանաչափը գործում է ողջ կյանքի ընթացքում՝ մեկ բնակարանի համար։ Հավելվածը չգիտի, թե նախկինում որքան նվազեցում է ստացվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite vale per tutta la vita e per una sola abitazione; l’app non conosce le detrazioni già richieste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限は生涯で1住宅に適用されます。過去の控除額は考慮されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლიმიტი მოქმედებს მთელი სიცოცხლის განმავლობაში და ერთ საცხოვრებელზე; აპმა არ იცის, ადრე რამდენი გამოიქვითა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шек өмір бойына және бір үйге беріледі; қолданба бұрын қанша шегерім алынғанын білмейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도는 평생 한 채의 주택에 적용됩니다. 이전에 공제받은 금액은 반영되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек өмүр бою жана бир турак жайга берилет; мурда канча чегерим алынганын колдонмо билбейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet geldt levenslang en voor één woning; de app weet niet wat eerder is afgetrokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit obowiązuje przez całe życie i dotyczy jednej nieruchomości. Aplikacja nie uwzględnia wcześniejszych odliczeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite vale para toda a vida e um único imóvel; o app não sabe o que já foi deduzido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite é vitalício e aplica-se a uma habitação; a app não sabe o que foi deduzido antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит — на всю жизнь и одно жильё; что заявлено раньше, приложение не знает."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маҳдудият барои тамоми умр ва як манзил аст; барнома намедонад, ки қаблан чӣ қадар тарҳ гирифта шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınır, bir konut için ömür boyu geçerlidir; uygulama daha önce talep edilen tutarı bilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт діє на все життя та для одного житла; застосунок не знає, що було заявлено раніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit bir umrga va bitta uyga beriladi; ilova oldin qancha chegirma olinganini bilmaydi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn áp dụng trọn đời cho một căn nhà; ứng dụng không biết những khoản đã được khấu trừ trước đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит действует на всю жизнь и на одно жильё; приложение не знает, что уже было заявлено."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上限為終身且限一套住房；本應用不知道先前是否已申報。"
          }
        }
      }
    },
