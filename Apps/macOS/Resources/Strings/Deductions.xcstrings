        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ წლისთვის ლიმიტების ცხრილში წესები არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл жылға арналған шектер кестесінде ережелер жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올해 적용되는 한도 규정이 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чектердин таблицасында бул жылга эрежелер жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tabel met limieten bevat geen regels voor dit jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela limitów nie zawiera zasad na ten rok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabela de limites não tem regras para este ano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabela de limites não tem regras para este ano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В справочнике нет лимитов за этот год."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҷадвали маҳдудиятҳо барои ин сол қоидаҳо нестанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınır tablosunda bu yıl için kural yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У таблиці лімітів немає правил для цього року."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yil uchun limitlar jadvalida qoidalar yo'q."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng giới hạn không có quy định nào cho năm này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "В таблице лимитов нет правил для этого года."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該年度的上限表沒有相關規則。"
          }
        }
