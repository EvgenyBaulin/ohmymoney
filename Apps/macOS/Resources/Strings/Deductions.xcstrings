{
  "sourceLanguage": "en",
  "strings": {
    "deductions.account.field": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fərdi investisiya hesabı (İİS): köçürmələr vergi güzəştinə daxildir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Індывідуальны інвестыцыйны рахунак (ІІР): пераводы на яго ідуць у падатковы вылік"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Individuální investiční účet (IIS): vklady se zahrnou do daňového odpočtu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Individuelles Anlagekonto (IIS): Einzahlungen sind steuerlich absetzbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Individual investment account (IIS): transfers to it go to the tax deduction"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta de inversión individual (IIS): las aportaciones dan derecho a deducción fiscal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte d’investissement individuel (IIS) : les versements donnent droit à une déduction fiscale"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անհատական ներդրումային հաշիվ (IIS)․ փոխանցումները ներառվում են հարկային նվազեցման մեջ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conto d’investimento individuale (IIS): i versamenti danno diritto alla detrazione fiscale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人投資口座（IIS）：入金額が税控除の対象になります"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ინდივიდუალური საინვესტიციო ანგარიში (IIS): მასზე ჩარიცხვები საგადასახადო გამოქვითვას ექვემდებარება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жеке инвестициялық шот (ИИС): оған аударылған қаражатқа салық шегерімі беріледі"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 투자 계좌(IIS): 입금액이 세액 공제 대상"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жеке инвестициялык эсеп (ИИС): ага которулган акча салык чегеримине кирет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Individuele beleggingsrekening (IIS): stortingen tellen mee voor de belastingaftrek"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indywidualne konto inwestycyjne (IIS): wpłaty uprawniają do odliczenia podatkowego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta individual de investimento (IIS): aportes contam para a dedução fiscal"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta de investimento individual (IIS): as transferências contam para a dedução fiscal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индивидуальный инвестиционный счёт (ИИС): переводы на него — в налоговый вычет"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби инфиродии сармоягузорӣ (ИИС): маблағгузорӣ ба тарҳи андоз дохил мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bireysel yatırım hesabı (IIS): Bu hesaba aktarılan tutarlar vergi indirimine dahil edilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Індивідуальний інвестиційний рахунок (ІВР): перекази на нього враховуються для податкового відрахування"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Individual investitsiya hisobi (IIS): unga o'tkazmalar soliq chegirmasiga kiradi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản đầu tư cá nhân (IIS): chuyển tiền vào đó được tính vào khấu trừ thuế"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Индивидуальный инвестиционный счёт (ИИС): переводы на него идут в налоговый вычет"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人投資帳戶（IIS）：轉入的款項可用於稅務扣除"
          }
        }
      }
    },
