    "deductions.debt.field": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İpoteka: faizlər vergi güzəştinə daxildir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Іпатэка: працэнты ідуць у падатковы вылік"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hypotéka: úroky se zahrnou do daňového odpočtu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hypothek: Zinsen sind steuerlich absetzbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mortgage: the interest goes to the tax deduction"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hipoteca: los intereses dan derecho a deducción fiscal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt immobilier : les intérêts donnent droit à une déduction fiscale"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիփոթեք․ տոկոսները ներառվում են հարկային նվազեցման մեջ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutuo: gli interessi danno diritto alla detrazione fiscale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "住宅ローン：支払利息が税控除の対象になります"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იპოთეკა: პროცენტი საგადასახადო გამოქვითვას ექვემდებარება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ипотека: пайыздарына салық шегерімі беріледі"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주택담보대출: 이자가 세액 공제 대상"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ипотека: пайыздар салык чегеримине кирет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hypotheek: de rente telt mee voor de belastingaftrek"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredyt hipoteczny: odsetki podlegają odliczeniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Financiamento imobiliário: os juros contam para a dedução fiscal"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crédito à habitação: os juros contam para a dedução fiscal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ипотека: проценты — в налоговый вычет"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ипотека: фоизҳо ба тарҳи андоз дохил мешаванд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konut kredisi: Faiz tutarı vergi indirimine dahil edilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Іпотека: відсотки враховуються для податкового відрахування"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipoteka: foizlar soliq chegirmasiga kiradi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thế chấp: lãi suất được tính vào khấu trừ thuế"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ипотека: проценты идут в налоговый вычет"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "房貸：利息可用於稅務扣除"
          }
        }
      }
    },
