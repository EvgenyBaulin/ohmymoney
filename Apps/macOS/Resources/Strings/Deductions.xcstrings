    "deductions.refund.exactHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not more than the tax on the income, each ruble at the rate of its step of the scale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не больше налога с дохода, каждый рубль — по ставке своей ступени шкалы."
