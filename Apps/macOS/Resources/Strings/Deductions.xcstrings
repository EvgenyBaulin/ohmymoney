        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấy xác nhận đã trả dịch vụ y tế cho cơ quan thuế, do phòng khám cấp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Справка об оплате медицинских услуг для налоговой из клиники"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診所出具的已付醫療服務證明（供稅務機關使用）"
