    "deductions.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu il üçün heç nə qeyd edilməyib. Əməliyyatları «Vergi güzəşti» ilə, ipotekanı borcda, İİS-i isə hesabda qeyd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэты год нічога не пазначана. Пазначце аперацыі як «Падатковы вылік», іпатэку — у запазычанасці, а ІІР — у рахунку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento rok není nic označeno. U operací označte «Daňový odpočet», u dluhu hypotéku a u účtu IIS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Jahr ist nichts markiert. Markiere Buchungen mit «Steuerabzug», eine Hypothek bei der Schuld und ein IIS beim Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is marked for this year. Mark operations with «Tax deduction», a mortgage in its debt and an IIS in its account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada marcado para este año. Marca las operaciones con «Deducción fiscal», la hipoteca en su deuda y la IIS en su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est indiqué pour cette année. Marquez les opérations avec «Tax deduction», le prêt immobilier dans sa dette et l’IIS dans son compte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս տարվա համար ոչինչ նշված չէ։ Գործարքներում նշեք «Հարկային նվազեցում», պարտքում՝ հիփոթեքը, իսկ հաշվում՝ IIS-ը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento contrassegnato per quest’anno. Contrassegna le operazioni con «Detrazione fiscale», il mutuo nel debito e l’IIS nel conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今年の対象はありません。取引に「税控除」を、負債に住宅ローンを、口座にIISを設定してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ წლისთვის არაფერი მონიშნულა. მონიშნეთ ოპერაციებზე «საგადასახადო გამოქვითვა», იპოთეკა — ვალში, ხოლო IIS — ანგარიშში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл жылға ештеңе белгіленбеген. Операцияларда «Салық шегерімін», қарызда ипотеканы және шотта ИИС-ті белгілеңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올해 표시된 항목이 없습니다. 거래에 «세액 공제»를 표시하고 대출에 주택담보대출을, 계좌에 IIS를 표시하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул жылга эч нерсе белгиленген жок. Операцияларда «Салык чегеримин», карызда ипотеканы жана эсепте ИИСтү белгилеңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets gemarkeerd voor dit jaar. Markeer transacties met «Belastingaftrek», een hypotheek bij de schuld en een IIS bij de rekening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie oznaczono w tym roku. Oznacz operacje jako «Odliczenie podatkowe», kredyt hipoteczny w jego ustawieniach, a IIS w ustawieniach konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada marcado para este ano. Marque operações com «Dedução fiscal», um financiamento na dívida e uma IIS na conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada assinalado para este ano. Assinale as operações com «Dedução fiscal», o crédito à habitação na respetiva dívida e a IIS na respetiva conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За этот год ничего не отмечено. Отметьте операции полем «Налоговый вычет», ипотеку — в долге, ИИС — в счёте."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ин сол чизе қайд нашудааст. Амалиётҳоро бо «Тарҳи андоз», ипотекаро дар қарз ва ИИС-ро дар ҳисоб қайд кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yıl için işaretlenmiş bir şey yok. İşlemleri «Vergi indirimi» ile işaretleyin, konut kredisini borcunda ve IIS’yi hesabında belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цей рік нічого не позначено. Позначте операції як «Податкове відрахування», іпотеку — у боргу, а ІВР — у рахунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yil uchun hech narsa belgilanmagan. Amallarni «Soliq chegirmasi» bilan belgilang, ipotekani qarzda, IISni esa hisobda belgilang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có khoản nào được đánh dấu cho năm này. Hãy đánh dấu giao dịch là «Khấu trừ thuế», khoản thế chấp ở mục nợ và IIS ở mục tài khoản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "За этот год ничего не отмечено. Отметьте операции «Налоговым вычетом», ипотеку — в долге, а ИИС — в счёте."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本年度尚無標記項目。請將交易標記為「稅務扣除」，房貸標記其債務，IIS 標記其帳戶。"
          }
        }
      }
    },
