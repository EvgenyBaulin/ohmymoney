    "deductions.document.prescription": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«vergi orqanları üçün» qeydi olan resept və dərman qəbzləri"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэцэпт з пазнакай «для падатковых органаў» і чэкі на лекі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předpis s označením «pro finanční úřad» a účtenky za léky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezept mit dem Vermerk «für die Steuerbehörden» und Belege für die Medikamente"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prescription marked «for the tax authorities» and the receipts for the medicines"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Receta marcada «para las autoridades fiscales» y recibos de los medicamentos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordonnance portant la mention «for the tax authorities» et reçus des médicaments"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«հարկային մարմինների համար» նշումով դեղատոմսն ու դեղերի անդորրագրերը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prescrizione con la dicitura «per le autorità fiscali» e ricevute dei farmaci"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«for the tax authorities»と記載された処方箋と医薬品の領収書"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რეცეპტი აღნიშვნით «საგადასახადო ორგანოებისთვის» და წამლების ქვითრები"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Салық органдары үшін» деген белгісі бар рецепт және дәрі-дәрмек түбіртектері"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«세무 당국 제출용» 표시가 있는 처방전 및 약값 영수증"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Салык органдары үчүн» белгиси бар рецепт жана дарылардын чектери"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recept met vermelding «voor de belastingdienst» en de aankoopbewijzen van de medicijnen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recepta z adnotacją «dla organów podatkowych» i potwierdzenia zakupu leków"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receita médica com a indicação «para as autoridades fiscais» e recibos dos medicamentos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Receita com a indicação «para as autoridades fiscais» e recibos dos medicamentos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рецепт с отметкой «Для налоговых органов» и чеки на лекарства"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дорухат бо қайди «барои мақомоти андоз» ва расидҳои доруҳо"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Vergi dairesi için» ibareli reçete ve ilaç makbuzları"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рецепт із позначкою «для податкових органів» і чеки за ліки"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«for the tax authorities» belgili retsept va dorilar cheklari"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đơn thuốc có ghi «для налоговых органов» và biên lai mua thuốc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Рецепт с пометкой «для предоставления в налоговые органы» и чеки на лекарства"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註明「供稅務機關使用」的處方及藥品收據"
          }
        }
      }
    },
    "deductions.document.sportPaymentCertificate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
