    "questions.intent.whatGrew.income": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmişəkindən çox olan gəlir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што вырасла вышэй за звычайны ўзровень (даходы)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co překročilo obvyklou hodnotu (příjmy)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was über das Übliche gewachsen ist (Einnahmen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What grew beyond usual (income)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué subió por encima de lo habitual (ingresos)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui a dépassé l'habituel (revenus)"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչն է սովորականից ավելի աճել (եկամուտ)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrate aumentate rispetto al solito"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რამ გადააჭარბა ჩვეულებრივს (შემოსავალი)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегіден не өсті (табыс)"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаттагыдан ашкан киреше"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co wzrosło ponad normę (przychody)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que passou do habitual (receitas)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ultrapassou o habitual (rendimentos)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что выросло сверх обычного (доходы)"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чӣ аз маъмул зиёд шуд (даромад)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalin üzerine çıkanlar (gelir)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що зросло понад звичайне (доходи)"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatdagidan oshgan daromadlar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高於平常的收入"
          }
        }
      }
    },
