    "questions.saved.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ heç nə saxlanmayıb. Əməliyyatlarda filtrləri qurub “Filtrləri saxla…” seçin və ya Hesabatlarda cədvəli saxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль нічога не захавана. Задайце фільтры ў аперацыях і выберыце “Захаваць фільтры…” або захавайце табліцу ў справаздачах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nic neuloženo. Nastavte filtry v Operacích a vyberte „Uložit filtry…“ nebo uložte tabulku v Přehledech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts gespeichert. Stellen Sie Filter unter „Vorgänge“ ein und wählen Sie „Filter sichern…“, oder speichern Sie eine Tabelle in „Berichte“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing saved yet. Set filters in Operations and choose “Save filters…”, or save a table in Reports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada guardado. Fije filtros en Operaciones y elija «Guardar filtros…», o guarde una tabla en Informes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'enregistré pour l'instant. Réglez des filtres dans Opérations et choisissez « Enregistrer les filtres… », ou enregistrez un tableau dans Rapports."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ ոչինչ պահված չէ։ Սահմանեք զտիչներ «Գործառնություններում» և ընտրեք «Պահել զտիչները…» կամ պահեք աղյուսակը «Հաշվետվություններում»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora salvato nulla. Imposta i filtri in Operazioni e scegli “Salva filtri…”, oppure salva una tabella in Report."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არაფერი შეგინახავთ. დააყენეთ ფილტრები ოპერაციებში და აირჩიეთ „ფილტრების შენახვა…“, ან შეინახეთ ცხრილი ანგარიშებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге ештеңе сақталмаған. Операцияларда сүзгілерді орнатып, «Сүзгілерді сақтау…» таңдаңыз, не Есептерде кестені сақтаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча эч нерсе сакталган жок. Операцияларда чыпкаларды коюп, «Чыпкаларды сактоо…» дегенди тандаңыз же Отчеттордо таблицаны сактаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic jeszcze nie zachowano. Ustaw filtry w Operacjach i wybierz „Zachowaj filtry…” lub zachowaj tabelę w Raportach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada salvo ainda. Defina filtros em Operações e escolha “Salvar filtros…” ou salve uma tabela em Relatórios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não guardou nada. Defina filtros em Operações e selecione “Guardar filtros…” ou guarde uma tabela em Relatórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего не сохранено. Настройте фильтры в «Операциях» и выберите «Сохранить фильтры…» или сохраните таблицу в «Отчётах»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз чизе захира нашудааст. Дар Амалиёт филтрҳоро танзим карда, “Захираи филтрҳо…”-ро интихоб кунед ё ҷадвалеро дар Ҳисобот захира кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kayıt yok. İşlemler’de filtreleri ayarlayıp “Filtreleri Kaydet…”i seçin veya Raporlar’da bir tabloyu kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще нічого не збережено. Задайте фільтри в «Операціях» і оберіть «Зберегти фільтри…», або збережіть таблицю в «Звітах»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali hech narsa saqlanmagan. Operatsiyalarda filtrlarni sozlab, “Filtrlarni saqlash…”ni tanlang yoki Hisobotlarda jadvalni saqlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無儲存項目。請在交易中設定篩選條件並選擇「儲存篩選條件⋯」，或在報表中儲存表格。"
          }
        }
      }
    },
