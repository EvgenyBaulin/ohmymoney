    "questions.hint.shape": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask in words: “how much on taxi in September”, “compare cafés with last year”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunte con palabras: «cuánto en taxi en septiembre», «comparar cafés con el año pasado»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez en mots : « combien en taxi en septembre », « comparer les cafés avec l'an dernier »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите словами: «сколько на такси в сентябре», «сравни кафе с прошлым годом»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте словами: «скільки на таксі у вересні», «порівняти кав'ярні з минулим роком»."
          }
        }
      }
    },
