    "questions.mode.help": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sual rejimi: Enter məlumatlarınıza əsasən cavab verir və heç nə yazmır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэжым пытанняў: Enter дае адказ на аснове вашых даных, нічога не запісваючы"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim otázek: Enter odpoví podle vašich dat a nic nezapíše"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragemodus: Enter beantwortet aus Ihren Daten und schreibt nichts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Question mode: Enter answers from your data and writes nothing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de preguntas: Intro responde con sus datos y no escribe nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode question : Entrée répond d'après vos données et n'écrit rien"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցերի ռեժիմ․ Enter-ը պատասխանում է ձեր տվյալների հիման վրա՝ առանց փոփոխություններ գրանցելու"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità domande: Invio risponde usando i tuoi dati senza modificarli"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კითხვების რეჟიმი: Enter პასუხობს თქვენი მონაცემების მიხედვით და არაფერს წერს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сұрақ режимі: Enter деректеріңізден жауап береді және ешнәрсе жазбайды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суроо режими: Enter дайындарыңыздын негизинде жооп берет, эч нерсе жазбайт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb pytań: Return odpowiada na podstawie danych i niczego nie zapisuje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de perguntas: Retorno responde com seus dados e não altera nada"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de pergunta: prima Enter para obter respostas dos seus dados, sem alterar nada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим вопроса: Enter отвечает по вашим данным и ничего не записывает"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Реҷаи савол: Enter аз рӯи маълумоти шумо ҷавоб медиҳад ва чизе сабт намекунад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soru modu: Enter, verilerinize göre yanıt verir ve hiçbir şey kaydetmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим питань: Enter відповідає з ваших даних і нічого не записує"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Savol rejimi: Enter maʼlumotlaringiz asosida javob beradi va hech narsa yozmaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提問模式：按下 Return 即可根據資料回答問題，不會寫入任何資料"
          }
        }
      }
    },
