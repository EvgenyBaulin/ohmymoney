    "questions.answer.nothingGrew": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is above the usual for this period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está por encima de lo habitual en este periodo."
          }
        },
        "fr": {
          "stringUnit": {
