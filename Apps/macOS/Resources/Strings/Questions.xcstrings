    "questions.saved.period.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Last month” saved in October means November when opened in December; fixed days never move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«El mes pasado» guardado en octubre significa noviembre al abrirlo en diciembre; los días fijos nunca se mueven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Le mois dernier » enregistré en octobre désigne novembre à l'ouverture en décembre ; les jours fixes ne bougent jamais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Прошлый месяц», сохранённый в октябре, в декабре означает ноябрь; зафиксированные дни не сдвигаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Минулий місяць», збережений у жовтні, у грудні відкривається як листопад; фіксовані дні не рухаються."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазанда сақталған “өткен ай” желтоқсанда ашылғанда қарашаны білдіреді; нақты күндер ешқашан жылжымайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "“Мінулы месяц”, захаваны ў кастрычніку, пры адкрыцці ў снежні азначае лістапад; фіксаваныя даты не змяняюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Letzter Monat“, im Oktober gespeichert, heißt beim Öffnen im Dezember den November; feste Tage wandern nie."
          }
        }
      }
    },
