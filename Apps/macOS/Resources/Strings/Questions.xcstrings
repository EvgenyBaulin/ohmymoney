    "question.hint.deviceNotEligible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot run the language model, so only the shapes above work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede ejecutar el modelo de lenguaje, así que solo funcionan las formas de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas faire tourner le modèle de langue, donc seules les formes ci-dessus fonctionnent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не может запустить языковую модель, поэтому работают только такие формулировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій не може запустити мовну модель, тож працюють лише наведені форми."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл құрылғы тіл моделін іске қоса алмайды, сондықтан тек жоғарыдағы үлгілер жұмыс істейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта прылада не падтрымлівае моўную мадэль, таму працуюць толькі прыклады вышэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann das Sprachmodell nicht ausführen, daher funktionieren nur die oben genannten Formen."
          }
        }
      }
    },
    "question.hint.enableAppleIntelligence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in System Settings to ask in free words in English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Apple Intelligence en Ajustes del Sistema para preguntar con palabras libres en español."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans les réglages du système pour poser des questions en mots libres, en anglais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Apple Intelligence в системных настройках — тогда свободные вопросы на английском тоже заработают."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Apple Intelligence в Системних налаштуваннях, щоб ставити питання вільними словами англійською."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Еркін сөздермен ағылшынша сұрау үшін жүйе баптауларында Apple Intelligence қосыңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце Apple Intelligence у сістэмных наладах, каб задаваць пытанні сваімі словамі па-англійску."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie Apple Intelligence in den Systemeinstellungen ein, um auf Englisch frei zu fragen."
          }
        }
      }
    },
    "question.hint.modelNotReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language model is still downloading; free questions will work when it is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de lenguaje todavía se está descargando; las preguntas libres funcionarán cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de langue est encore en cours de téléchargement ; les questions libres marcheront quand il sera prêt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языковая модель ещё загружается; свободные вопросы заработают, когда она будет готова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовна модель ще завантажується; вільні питання запрацюють, коли вона буде готова."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіл моделі әлі жүктеліп жатыр; ол дайын болғанда еркін сұрақтар жұмыс істейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Моўная мадэль яшчэ спампоўваецца. Калі яна будзе гатовая, можна будзе задаваць пытанні ў свабоднай форме."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell wird noch geladen; freie Fragen funktionieren, sobald es bereit ist."
          }
        }
      }
    },
    "question.hint.modelUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language model is not available in this region or language, so only the shapes above work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de lenguaje no está disponible en esta región o idioma, así que solo funcionan las formas de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de langue n'est pas disponible dans cette région ou cette langue, donc seules les formes ci-dessus fonctionnent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языковая модель недоступна в этом регионе или языке, поэтому работают только такие формулировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовна модель недоступна в цьому регіоні чи мові, тож працюють лише наведені форми."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіл моделі бұл аймақта не тілде қолжетімсіз, сондықтан тек жоғарыдағы үлгілер жұмыс істейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Моўная мадэль недаступная ў гэтым рэгіёне або для гэтай мовы, таму працуюць толькі прыклады вышэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell ist in dieser Region oder Sprache nicht verfügbar, daher funktionieren nur die oben genannten Formen."
          }
        }
      }
    },
    "questions.answer.likeForLike": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The period is not over: compared with the same part of the other one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El periodo no ha terminado: se compara con la misma parte del otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La période n'est pas terminée : comparée à la même partie de l'autre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Период ещё не закончился: сравнение с такой же частью другого периода."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Період ще не закінчився: порівняно з такою самою частиною іншого."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кезең аяқталмаған: басқа кезеңнің дәл сол бөлігімен салыстырылған."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перыяд яшчэ не скончыўся: параўнана з адпаведнай часткай іншага перыяду."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeitraum ist nicht vorbei: verglichen mit dem gleichen Teil des anderen."
          }
        }
      }
    },
    "questions.answer.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
