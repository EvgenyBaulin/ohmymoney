        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я не зрозумів питання. Спробуйте одне з цих:"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Savolni tushunmadim. Quyidagilardan birini sinab koʻring:"
          }
