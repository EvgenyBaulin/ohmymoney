        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լեզվային մոդելը դեռ ներբեռնվում է։ Ազատ ձևակերպված հարցերը հասանելի կլինեն, երբ այն պատրաստ լինի։"
