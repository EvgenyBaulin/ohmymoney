    "questions.model.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdakı dil modeli tərəfindən oxunur; rəqəmlər tətbiq tərəfindən hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытанне апрацоўвае моўная мадэль на гэтай прыладзе; лічбы падлічвае праграма."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otázku zpracuje jazykový model v tomto zařízení; údaje vypočítá aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Sprachmodell auf diesem Gerät gelesen; die Zahlen zählt die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read by the language model on this device; the figures are counted by the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo lee el modelo de lenguaje en este dispositivo; las cifras las cuenta la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu par le modèle de langue sur cet appareil ; les chiffres sont calculés par l'app."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցը մշակում է այս սարքի լեզվային մոդելը, իսկ թվերը հաշվում է հավելվածը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letto dal modello linguistico su questo dispositivo; gli importi sono calcolati dall’app."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კითხვას ამ მოწყობილობის ენობრივი მოდელი კითხულობს; მონაცემებს აპი ითვლის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіл моделі осы құрылғыда оқиды; сандарды қолданба санайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул түзмөктөгү тил модели окуйт; сандарды колдонмо эсептейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytanie analizuje model językowy na tym urządzeniu; dane liczbowe oblicza aplikacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpretado pelo modelo de linguagem neste dispositivo; os valores são calculados pelo app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpretado pelo modelo de linguagem neste dispositivo; os valores são calculados pela app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопрос прочитала языковая модель на этом устройстве; цифры посчитало приложение."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели забонии ин дастгоҳ саволро мехонад; барнома рақамҳоро ҳисоб мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıttaki dil modeli tarafından okunur; tutarlar uygulama tarafından hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читається мовною моделлю на цьому пристрої; цифри рахує застосунок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Savolni ushbu qurilmadagi til modeli oʻqiydi; hisob-kitoblarni ilova bajaradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由此裝置上的語言模型讀取；數值由 App 計算。"
          }
        }
      }
    },
