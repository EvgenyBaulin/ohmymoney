            "value": "Rien ne dépasse l'habituel pour cette période."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверх обычного за этот период ничего не выросло."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цей період нічого не піднялося вище за звичайне."
