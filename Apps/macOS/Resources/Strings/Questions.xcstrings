        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіл моделі әлі жүктеліп жатыр; ол дайын болғанда еркін сұрақтар жұмыс істейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тил модели жүктөлүп жатат. Ал даяр болгондо эркин суроолор иштейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model językowy jest nadal pobierany. Dowolne pytania będą dostępne, gdy będzie gotowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de linguagem ainda está sendo baixado. Você poderá fazer perguntas livres quando ele estiver pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de linguagem ainda está a ser descarregado. Poderá fazer perguntas livres quando estiver pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языковая модель ещё загружается; свободные вопросы заработают, когда она будет готова."
