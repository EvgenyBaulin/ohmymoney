    "questions.palette.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Heç nə tapılmadı. Hesab, ekran və ya əmr adı yazın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічога не знойдзена. Паспрабуйце назву рахунку, экрана або каманды."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nebylo nalezeno. Zkuste název účtu, obrazovky nebo příkazu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts gefunden. Versuchen Sie den Namen eines Kontos, eines Bereichs oder eines Befehls."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing found. Try a name of an account, a screen or a command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró nada. Pruebe con el nombre de una cuenta, una pantalla o un comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien trouvé. Essayez le nom d'un compte, d'un écran ou d'une commande."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչինչ չի գտնվել։ Փորձեք հաշվի, էկրանի կամ հրամանի անունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun risultato. Prova il nome di un conto, una schermata o un comando."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერაფერი მოიძებნა. სცადეთ ანგარიშის, ეკრანის ან ბრძანების სახელი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ештеңе табылмады. Есеп-шот, экран немесе команда атын байқап көріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эч нерсе табылган жок. Эсептин, экрандын же буйруктун атын жазып көрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie znaleziono. Spróbuj podać nazwę konta, ekranu lub polecenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum resultado. Tente o nome de uma conta, tela ou comando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem resultados. Experimente o nome de uma conta, de um ecrã ou de um comando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не найдено. Попробуйте название счёта, экрана или команды."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чизе ёфт нашуд. Номи ҳисоб, экран ё фармонро санҷед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç bulunamadı. Bir hesap, ekran veya komut adı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не знайдено. Спробуйте назву рахунку, екрана або команди."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hech narsa topilmadi. Hisob, ekran yoki buyruq nomini kiriting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到結果。請試試帳戶、畫面或指令的名稱。"
          }
        }
      }
    },
