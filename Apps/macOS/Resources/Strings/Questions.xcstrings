            "value": "Nada ultrapassou o habitual neste período."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверх обычного за этот период ничего не выросло."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин давра чизе аз маъмул зиёд нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönemde normalin üzerine çıkan bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цей період нічого не піднялося вище за звичайне."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu davrda hech narsa odatdagidan oshmagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此期間沒有高於平常的項目。"
          }
        }
