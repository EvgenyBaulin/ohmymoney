    "questions.hint.shape": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlə soruşun: “sentyabrda taksiyə nə qədər xərcləmişəm”, “kafeləri keçən illə müqayisə et”."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спытайце сваімі словамі: «колькі на таксі ў верасні», «параўнай кавярні з мінулым годам»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptejte se například: „kolik za taxi v září“, „porovnej kavárny s loňským rokem“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie in Worten: „wie viel für Taxi im September“, „Cafés mit dem letzten Jahr vergleichen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask in words: “how much on taxi in September”, “compare cafés with last year”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunte con palabras: «cuánto en taxi en septiembre», «comparar cafés con el año pasado»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez en mots : « combien en taxi en septembre », « comparer les cafés avec l'an dernier »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցրեք բառերով․ «որքա՞ն եմ ծախսել տաքսու վրա սեպտեմբերին», «համեմատել սրճարանները նախորդ տարվա հետ»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda: “quanto ho speso in taxi a settembre”, “confronta i bar con l’anno scorso”."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დასვით კითხვა: „რამდენი დავხარჯე ტაქსიზე სექტემბერში“, „შეადარე კაფეები გასულ წელს“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сөзбен сұраңыз: «қыркүйекте таксиге қанша», «кафелерді былтырғымен салыстыру»."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суроо бериңиз: “сентябрда таксиге канча короттум”, “кафелерди былтыркыга салыштыр”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj własnymi słowami: „ile na taksówki we wrześniu”, „porównaj kawiarnie z poprzednim rokiem”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte com suas palavras: “quanto gastei com táxi em setembro”, “comparar cafés com o ano passado”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte por palavras: «quanto gastei em táxis em setembro», «comparar cafés com o ano passado»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите словами: «сколько на такси в сентябре», «сравни кафе с прошлым годом»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо сухан пурсед: «дар моҳи сентябр барои таксӣ чӣ қадар сарф шуд», «қаҳвахонаҳоро бо соли гузашта муқоиса кун»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soru sorun: “eylülde taksiye ne kadar harcadım”, “kafeleri geçen yılla karşılaştır”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте словами: «скільки на таксі у вересні», «порівняти кав'ярні з минулим роком»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soʻz bilan soʻrang: “sentabrda taksiga qancha sarflangan”, “kafelarni oʻtgan yil bilan solishtir”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用文字提問，例如：「九月計程車花了多少」、「比較咖啡廳與去年的花費」。"
          }
        }
      }
    },
