    "question.hint.deviceNotEligible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot run the language model, so only the shapes above work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не может запустить языковую модель, поэтому работают только такие формулировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій не може запустити мовну модель, тож працюють лише наведені форми."
          }
        }
      }
    },
    "question.hint.enableAppleIntelligence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in System Settings to ask in free words in English."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Apple Intelligence в системных настройках — тогда свободные вопросы на английском тоже заработают."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Apple Intelligence в Системних налаштуваннях, щоб ставити питання вільними словами англійською."
          }
        }
      }
    },
    "question.hint.modelNotReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language model is still downloading; free questions will work when it is ready."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языковая модель ещё загружается; свободные вопросы заработают, когда она будет готова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовна модель ще завантажується; вільні питання запрацюють, коли вона буде готова."
          }
        }
      }
    },
    "question.hint.modelUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language model is not available in this region or language, so only the shapes above work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языковая модель недоступна в этом регионе или языке, поэтому работают только такие формулировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовна модель недоступна в цьому регіоні чи мові, тож працюють лише наведені форми."
          }
        }
      }
    },
