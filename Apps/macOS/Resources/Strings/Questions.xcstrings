      }
    },
    "question.hint.deviceNotEligible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot run the language model, so only the shapes above work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede ejecutar el modelo de lenguaje, así que solo funcionan las formas de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas faire tourner le modèle de langue, donc seules les formes ci-dessus fonctionnent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не может запустить языковую модель, поэтому работают только такие формулировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій не може запустити мовну модель, тож працюють лише наведені форми."
          }
        }
      }
    },
    "question.hint.enableAppleIntelligence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in System Settings to ask in free words in English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Apple Intelligence en Ajustes del Sistema para preguntar con palabras libres en español."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans les réglages du système pour poser des questions en mots libres, en anglais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Apple Intelligence в системных настройках — тогда свободные вопросы на английском тоже заработают."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Apple Intelligence в Системних налаштуваннях, щоб ставити питання вільними словами англійською."
          }
        }
      }
    },
    "question.hint.modelNotReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
