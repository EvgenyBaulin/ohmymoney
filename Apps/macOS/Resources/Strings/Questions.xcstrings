      }
    },
    "question.hint.deviceNotEligible": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz dil modelini işlədə bilmir, ona görə yalnız yuxarıdakı sual nümunələri işləyir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта прылада не падтрымлівае моўную мадэль, таму працуюць толькі прыклады вышэй."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení nedokáže spustit jazykový model, proto fungují jen výše uvedené formulace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann das Sprachmodell nicht ausführen, daher funktionieren nur die oben genannten Formen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot run the language model, so only the shapes above work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede ejecutar el modelo de lenguaje, así que solo funcionan las formas de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas faire tourner le modèle de langue, donc seules les formes ci-dessus fonctionnent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը չի կարող գործարկել լեզվային մոդելը, ուստի աշխատում են միայն վերը նշված ձևակերպումները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non supporta il modello linguistico, quindi puoi usare solo gli esempi qui sopra."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ მოწყობილობაზე ენობრივი მოდელი ვერ მუშაობს, ამიტომ მხოლოდ ზემოთ მოცემული ფორმულირებებია ხელმისაწვდომი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл құрылғы тіл моделін іске қоса алмайды, сондықтан тек жоғарыдағы үлгілер жұмыс істейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул түзмөктө тил модели иштебейт, андыктан жогорудагы үлгүлөр гана иштейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie obsługuje modelu językowego, więc działają tylko powyższe rodzaje pytań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não pode executar o modelo de linguagem. Use os formatos acima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não pode executar o modelo de linguagem, pelo que só funcionam os exemplos acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не может запустить языковую модель, поэтому работают только такие формулировки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин дастгоҳ модели забониро иҷро карда наметавонад, бинобар ин танҳо қолабҳои боло кор мекунанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıt dil modelini çalıştıramıyor, bu nedenle yalnızca yukarıdaki soru kalıpları kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій не може запустити мовну модель, тож працюють лише наведені форми."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qurilma til modelini ishga tushira olmaydi, shuning uchun faqat yuqoridagi shakllar ishlaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無法執行語言模型，因此只能使用上述問法。"
          }
        }
      }
    },
    "question.hint.enableAppleIntelligence": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İngilis dilində sərbəst sual vermək üçün Sistem Parametrlərində Apple Intelligence-ı aktiv edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце Apple Intelligence у сістэмных наладах, каб задаваць пытанні сваімі словамі па-англійску."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li pokládat volné otázky v angličtině, zapněte Apple Intelligence v Nastavení systému."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie Apple Intelligence in den Systemeinstellungen ein, um auf Englisch frei zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in System Settings to ask in free words in English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Apple Intelligence en Ajustes del Sistema para preguntar con palabras libres en español."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans les réglages du système pour poser des questions en mots libres, en anglais."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անգլերենով ազատ ձևակերպված հարցեր տալու համար միացրեք Apple Intelligence-ը համակարգի կարգավորումներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence in Impostazioni di Sistema per fare domande libere in inglese."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თავისუფალი ფორმით ინგლისურად კითხვების დასასმელად ჩართეთ Apple Intelligence სისტემის პარამეტრებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Еркін сөздермен ағылшынша сұрау үшін жүйе баптауларында Apple Intelligence қосыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Англисче эркин суроо берүү үчүн Тутум жөндөөлөрүнөн Apple Intelligence'ти күйгүзүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Apple Intelligence w Ustawieniach systemowych, aby zadawać dowolne pytania po angielsku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Apple Intelligence nos Ajustes do Sistema para fazer perguntas livremente em inglês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a Apple Intelligence nas Definições do Sistema para fazer perguntas livres em inglês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Apple Intelligence в системных настройках — тогда свободные вопросы на английском тоже заработают."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои савол додан бо забони англисӣ Apple Intelligence-ро дар танзимоти система фаъол кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İngilizce serbest sorular sormak için Sistem Ayarları’nda Apple Intelligence’ı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Apple Intelligence в Системних налаштуваннях, щоб ставити питання вільними словами англійською."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingliz tilida erkin savol berish uchun Tizim sozlamalarida Apple Intelligenceʼni yoqing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定」中開啟 Apple Intelligence，即可用英文自由提問。"
          }
        }
      }
    },
    "question.hint.modelNotReady": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil modeli hələ endirilir. Hazır olduqda sərbəst suallar işləyəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Моўная мадэль яшчэ спампоўваецца. Калі яна будзе гатовая, можна будзе задаваць пытанні ў свабоднай форме."
          }
