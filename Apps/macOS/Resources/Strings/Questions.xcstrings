    "questions.answer.likeForLike": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dövr hələ bitməyib: digər dövrün eyni hissəsi ilə müqayisə edilib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перыяд яшчэ не скончыўся: параўнана з адпаведнай часткай іншага перыяду."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Období ještě neskončilo. Porovnána je stejná část druhého období."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeitraum ist nicht vorbei: verglichen mit dem gleichen Teil des anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The period is not over: compared with the same part of the other one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El periodo no ha terminado: se compara con la misma parte del otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La période n'est pas terminée : comparée à la même partie de l'autre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամանակաշրջանը դեռ չի ավարտվել․ համեմատվել է մյուսի նույն հատվածի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il periodo non è ancora terminato: il confronto riguarda la stessa parte dell’altro periodo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პერიოდი ჯერ არ დასრულებულა: შედარებულია სხვა პერიოდის იმავე ნაწილთან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кезең аяқталмаған: басқа кезеңнің дәл сол бөлігімен салыстырылған."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мезгил бүтө элек: башка мезгилдин ошол эле бөлүгү менен салыштырылды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okres jeszcze się nie skończył. Porównano taki sam fragment drugiego okresu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O período ainda não terminou: comparação com a mesma parte do outro período."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O período ainda não terminou: a comparação é feita com a mesma parte do outro período."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Период ещё не закончился: сравнение с такой же частью другого периода."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Давра ҳанӯз тамом нашудааст: бо қисми баробари давраи дигар муқоиса шуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönem henüz bitmedi; diğer dönemin aynı kısmıyla karşılaştırıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Період ще не закінчився: порівняно з такою самою частиною іншого."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Davr hali tugamagan: boshqa davrning ayni qismi bilan solishtirildi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此期間尚未結束：已與另一期間的相同時段比較。"
          }
        }
      }
    },
