        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ პერიოდში არაფერი აღემატება ჩვეულებრივ მაჩვენებელს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кезеңде әдеттегіден асатын ештеңе жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул мезгилде эч нерсе адаттагыдан ашкан жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie przekracza normy dla tego okresu."
