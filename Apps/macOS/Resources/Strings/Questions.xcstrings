    "questions.saved.period.footer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oktyabrda saxlanmış “Keçən ay” dekabrda açıldıqda noyabrı göstərir; sabit günlər dəyişmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "“Мінулы месяц”, захаваны ў кастрычніку, пры адкрыцці ў снежні азначае лістапад; фіксаваныя даты не змяняюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Minulý měsíc“ uložený v říjnu znamená při otevření v prosinci listopad; pevné dny se nemění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Letzter Monat“, im Oktober gespeichert, heißt beim Öffnen im Dezember den November; feste Tage wandern nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Last month” saved in October means November when opened in December; fixed days never move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«El mes pasado» guardado en octubre significa noviembre al abrirlo en diciembre; los días fijos nunca se mueven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Le mois dernier » enregistré en octobre désigne novembre à l'ouverture en décembre ; les jours fixes ne bougent jamais."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հոկտեմբերին պահված «Անցյալ ամիսը» դեկտեմբերին բացելիս նշանակում է նոյեմբեր։ Հաստատված օրերը չեն փոխվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mese scorso” salvato a ottobre indica novembre se aperto a dicembre; le date fisse non cambiano."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოქტომბერში შენახული „გასული თვე“ დეკემბერში გახსნისას ნოემბერს ნიშნავს; ფიქსირებული დღეები არ იცვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазанда сақталған “өткен ай” желтоқсанда ашылғанда қарашаны білдіреді; нақты күндер ешқашан жылжымайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Октябрда сакталган «Өткөн ай» декабрда ачылганда ноябрды билдирет; белгиленген күндөр өзгөрбөйт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zeszły miesiąc” zachowany w październiku oznacza listopad po otwarciu w grudniu; stałe daty się nie zmieniają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mês passado” salvo em outubro significa novembro quando aberto em dezembro; datas fixas não mudam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mês passado” guardado em outubro corresponde a novembro quando aberto em dezembro; os dias fixos não mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Прошлый месяц», сохранённый в октябре, в декабре означает ноябрь; зафиксированные дни не сдвигаются."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "“Моҳи гузашта”, ки дар октябр захира шудааст, ҳангоми кушодан дар декабр ноябрро нишон медиҳад; рӯзҳои муайяншуда тағйир намеёбанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekimde kaydedilen “Geçen ay”, aralıkta açıldığında kasımı gösterir; sabit tarihler değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Минулий місяць», збережений у жовтні, у грудні відкривається як листопад; фіксовані дні не рухаються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oktabrda saqlangan “O‘tgan oy” dekabrda ochilganda noyabrni bildiradi; belgilangan sanalar o‘zgarmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 10 月儲存的「上個月」，於 12 月開啟時會顯示 11 月；固定日期則不會變動。"
          }
        }
      }
    },
