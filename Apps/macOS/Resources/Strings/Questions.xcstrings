    "questions.answer.none.short": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dövr üçün göstəriləcək məlumat yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэты перыяд няма чаго паказаць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za toto období není co zobrazit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Zeitraum gibt es nichts zu zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to show for this period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que mostrar en este periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à montrer pour cette période."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ժամանակաշրջանի համար ցուցադրելու տվյալներ չկան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da mostrare per questo periodo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ პერიოდისთვის საჩვენებელი არაფერია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кезең үшін көрсетуге ештеңе жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул мезгилде көрсөтө турган эч нерсе жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak danych dla tego okresu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a mostrar neste período."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a mostrar neste período."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За этот период нечего показать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ин давра чизе нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönem için gösterilecek bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цей період показати нічого."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu davr uchun koʻrsatadigan maʼlumot yoʻq."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此期間沒有可顯示的內容。"
          }
        }
      }
    },
    "questions.answer.nothingGrew": {
