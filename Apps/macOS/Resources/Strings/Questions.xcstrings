    "questions.saved.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing saved yet. Set filters in Operations and choose “Save filters…”, or save a table in Reports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada guardado. Fije filtros en Operaciones y elija «Guardar filtros…», o guarde una tabla en Informes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'enregistré pour l'instant. Réglez des filtres dans Opérations et choisissez « Enregistrer les filtres… », ou enregistrez un tableau dans Rapports."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего не сохранено. Настройте фильтры в «Операциях» и выберите «Сохранить фильтры…» или сохраните таблицу в «Отчётах»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще нічого не збережено. Задайте фільтри в «Операціях» і оберіть «Зберегти фільтри…», або збережіть таблицю в «Звітах»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге ештеңе сақталмаған. Операцияларда сүзгілерді орнатып, «Сүзгілерді сақтау…» таңдаңыз, не Есептерде кестені сақтаңыз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль нічога не захавана. Задайце фільтры ў аперацыях і выберыце “Захаваць фільтры…” або захавайце табліцу ў справаздачах."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts gespeichert. Stellen Sie Filter unter „Vorgänge“ ein und wählen Sie „Filter sichern…“, oder speichern Sie eine Tabelle in „Berichte“."
          }
        }
      }
    },
