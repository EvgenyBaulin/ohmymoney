          "stringUnit": {
            "state": "translated",
            "value": "Не понял вопрос. Попробуйте так:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я не зрозумів питання. Спробуйте одне з цих:"
