    "questions.model.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read by the language model on this device; the figures are counted by the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo lee el modelo de lenguaje en este dispositivo; las cifras las cuenta la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu par le modèle de langue sur cet appareil ; les chiffres sont calculés par l'app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопрос прочитала языковая модель на этом устройстве; цифры посчитало приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читається мовною моделлю на цьому пристрої; цифри рахує застосунок."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тіл моделі осы құрылғыда оқиды; сандарды қолданба санайды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытанне апрацоўвае моўная мадэль на гэтай прыладзе; лічбы падлічвае праграма."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Sprachmodell auf diesem Gerät gelesen; die Zahlen zählt die App."
          }
        }
      }
    },
