    "borrowed.transfer.refusal.noDebt": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şəxsə bu valyutada qaytarılacaq açıq borc yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас няма непагашанага доўгу гэтаму чалавеку ў гэтай валюце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine offene Schuld an diese Person in dieser Währung, die zurückgezahlt werden könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no open debt to this person in this currency to pay back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una deuda pendiente con esta persona en esta divisa que devolver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de dette ouverte envers cette personne, dans cette devise, à rembourser."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անձին այս արժույթով չմարված պարտք չունեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai debiti aperti da rimborsare a questa persona in questa valuta."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ადამიანთან ამ ვალუტაში მიმდინარე ვალი არ გაქვთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы адамға осы валютада қайтаратын ашық берешек жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул адамга ушул валютада төлөнө элек карыз жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz długu wobec tej osoby w tej walucie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há dívida em aberto com esta pessoa nesta moeda para pagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет открытого долга этому человеку в этой валюте, который можно вернуть."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба ин шахс бо ин асъор қарзи кушодае барои бозпардохт нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişiye bu para biriminde ödenecek açık borcunuz yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає відкритого боргу цій людині в цій валюті, який можна погасити."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kishiga ushbu valyutada qaytariladigan ochiq qarz yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你沒有欠此人此幣別的未清債務。"
          }
        }
      }
    },
    "borrowed.transfer.refusal.to": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vəsaiti sizə aid olmayan bir kartdan digərinə köçürmək olmur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга перавесці грошы з адной чужой карткі на другую."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld kann nicht von einer fremden Karte auf eine andere verschoben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money can't be moved from one card that isn't yours to another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero no se puede pasar de una tarjeta ajena a otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne peut pas virer de l'argent d'une carte qui n'est pas la vôtre vers une autre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը չի կարող փոխանցվել ուրիշի մի քարտից մյուսին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi spostare denaro da una carta altrui a un'altra."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვისი ერთი ბარათიდან მეორეზე თანხის გადარიცხვა შეუძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақшаны сіздікі емес бір картадан басқасына көшіруге болмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзүңүзгө таандык эмес бир картадан экинчисине акча которууга болбойт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przenieść pieniędzy między cudzymi kartami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível transferir dinheiro entre cartões de outras pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Между чужими картами переводить нечего: ни те, ни другие деньги не ваши."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз як корти каси дигар ба корти дигари каси дигар пул гузарондан мумкин нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size ait olmayan bir karttan size ait olmayan başka bir karta para aktarılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна переказувати гроші з однієї чужої картки на іншу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulni sizga tegishli bo‘lmagan bir kartadan boshqasiga o‘tkazib bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在兩張他人的卡片之間轉帳。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
