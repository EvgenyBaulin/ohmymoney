        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուրիշի գումար․ մնացորդ չունի և չի հաշվարկվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Denaro altrui: nessun saldo, nessun conteggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人のお金のため、残高は計上されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვისი ფული: ბალანსის გარეშე და ჯამში არ შედის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа адамның ақшасы: теңгерім жоқ және санау жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람의 돈: 잔액이 없으며 합계에 포함되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Башка бирөөнүн акчасы: баланс жок жана эсепке алынбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld van iemand anders: geen saldo en telt niet mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cudze pieniądze: bez salda, nieuwzględniane w sumie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinheiro de outra pessoa: sem saldo e fora dos totais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinheiro de outra pessoa: sem saldo e não contabilizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужие деньги: остатка и сверки нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули каси дигар: бе бақия ва бе ҳисоб."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başkasının parası: bakiye yok, toplama dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужі гроші: без залишку та звірки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa birovning puli: balans va hisobga olish yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他人的钱：无余额，不计入总额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他人的錢：不顯示餘額，也不計入總額。"
          }
        }
      }
