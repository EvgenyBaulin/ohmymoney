    "borrowed.editor.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld, das nicht Ihnen gehört: das eines Elternteils, eines Partners oder eine Firmenkarte. Was Sie damit kaufen, sind Ihre Ausgaben, in jeder Summe, Kategorie und jedem Limit; die Karte hat aber keinen Saldo: Sie wird nicht gezählt, steht nicht in „Gesamt“, in Gruppen oder im Kapital und senkt nie „Kann ausgegeben werden“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money that isn't yours: a parent's, a partner's or a company card. What you buy with it is your spending, in every total, category and limit, but the card has no balance: it isn't counted, isn't in «Total», groups or capital and never lowers «Можно тратить»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги не ваши: карта родителя, партнёра, корпоративная. Покупки с неё — ваши расходы во всех итогах, категориях и лимитах, но остатка у неё нет: её не сверяют, её нет во «Всего», группах и «Капитале», и она не уменьшает «Можно тратить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужі гроші: картка батьків, партнера або компанії. Покупки з неї — ваші витрати в усіх підсумках, категоріях і лімітах, але картка не має залишку: він не звіряється, не входить до «Усього», груп і капіталу та ніколи не зменшує «Можна витрачати»."
          }
        }
      }
    },
    "borrowed.editor.income": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Überweisung auf mein Konto ist eine Einnahme in"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer to my account is income in"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод себе — доход в"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переказ на мій рахунок — дохід у категорії"
          }
        }
      }
    },
    "borrowed.editor.income.default": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfe der Familie (standardmäßig)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family help (by default)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощь семьи (по умолчанию)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допомога родини (типово)"
          }
        }
      }
    },
    "borrowed.editor.incomeHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld, das von dieser Karte auf Ihr Konto wandert, wird als Einnahme in dieser Kategorie eingetragen, nicht als Überweisung. Ihr Geld kann nicht auf die Karte verschoben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money moved from this card to your account is written as income in this category, not as a transfer. Your money can't be moved onto the card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод с этой карты на ваш счёт записывается доходом в этой категории, а не переводом. Переводить свои деньги на эту карту нельзя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші з цієї картки на ваш рахунок записуються як дохід у цій категорії, а не як переказ. Ваші гроші не можна переказувати на цю картку."
          }
        }
      }
    },
    "borrowed.editor.mainStays": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto ist Ihr eigenes Geld: Es kann keine fremde Karte sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is your own money: it can't be someone else's card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт — ваши деньги: чужой картой он быть не может."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок — ваші власні гроші: він не може бути чужою карткою."
          }
        }
      }
    },
