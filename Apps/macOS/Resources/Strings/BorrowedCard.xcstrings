    "borrowed.editor.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money that isn't yours: a parent's, a partner's or a company card. What you buy with it is your spending, in every total, category and limit, but the card has no balance: it isn't counted, isn't in «Total», groups or capital and never lowers «Можно тратить»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinero que no es suyo: de un padre, de una pareja o una tarjeta de empresa. Lo que compra con ella es su gasto, en todos los totales, categorías y límites, pero la tarjeta no tiene saldo: no se cuenta, no está en «Total», en los grupos ni en el capital y nunca reduce «Se puede gastar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l'argent qui n'est pas le vôtre : celui d'un parent, d'un conjoint ou une carte d'entreprise. Ce que vous achetez avec est votre dépense, dans chaque total, catégorie et plafond, mais la carte n'a pas de solde : elle n'est pas comptée, ne figure pas dans « Total », les groupes ou le capital, et ne réduit jamais « Puis-je dépenser »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги не ваши: карта родителя, партнёра, корпоративная. Покупки с неё — ваши расходы во всех итогах, категориях и лимитах, но остатка у неё нет: её не сверяют, её нет во «Всего», группах и «Капитале», и она не уменьшает «Можно тратить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужі гроші: картка батьків, партнера або компанії. Покупки з неї — ваші витрати в усіх підсумках, категоріях і лімітах, але картка не має залишку: він не звіряється, не входить до «Усього», груп і капіталу та ніколи не зменшує «Можна витрачати»."
          }
        }
      }
    },
    "borrowed.editor.income": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer to my account is income in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transferencia a mi cuenta es ingreso en"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un virement vers mon compte est un revenu dans"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод себе — доход в"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переказ на мій рахунок — дохід у категорії"
          }
        }
      }
    },
    "borrowed.editor.income.default": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family help (by default)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda familiar (por defecto)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide familiale (par défaut)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощь семьи (по умолчанию)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допомога родини (типово)"
          }
        }
      }
    },
    "borrowed.editor.incomeHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money moved from this card to your account is written as income in this category, not as a transfer. Your money can't be moved onto the card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero que pasa de esta tarjeta a su cuenta se anota como ingreso en esta categoría, no como transferencia. Su dinero no se puede pasar a la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent viré de cette carte vers votre compte est noté comme revenu dans cette catégorie, et non comme virement. Votre argent ne peut pas être viré sur la carte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод с этой карты на ваш счёт записывается доходом в этой категории, а не переводом. Переводить свои деньги на эту карту нельзя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші з цієї картки на ваш рахунок записуються як дохід у цій категорії, а не як переказ. Ваші гроші не можна переказувати на цю картку."
          }
        }
      }
    },
    "borrowed.editor.mainStays": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is your own money: it can't be someone else's card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal es dinero propio: no puede ser una tarjeta ajena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal est votre propre argent : il ne peut pas être la carte d'un autre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт — ваши деньги: чужой картой он быть не может."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок — ваші власні гроші: він не може бути чужою карткою."
          }
        }
      }
    },
