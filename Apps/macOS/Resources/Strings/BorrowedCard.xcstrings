          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С чужой карты: запишется доходом в «%@»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз корти каси дигар: ҳамчун даромад дар «%@» сабт мешавад."
