          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A cosa serve il denaro"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რისთვისაა თანხა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша не үшін"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча эмне үчүн"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na co są pieniądze"
          }
        },
        "pt-BR": {
