    "borrowed.transfer.purposeLabel": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vəsaitin təyinatı"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На што грошы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür das Geld ist"
          }
        },
        "en": {
