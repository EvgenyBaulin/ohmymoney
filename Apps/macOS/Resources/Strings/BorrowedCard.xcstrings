        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Denaro altrui: nessun saldo, nessun conteggio."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვისი ფული: ბალანსის გარეშე და ჯამში არ შედის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа адамның ақшасы: теңгерім жоқ және санау жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Башка бирөөнүн акчасы: баланс жок жана эсепке алынбайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cudze pieniądze: bez salda, nieuwzględniane w sumie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinheiro de outra pessoa: sem saldo e fora dos totais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужие деньги: остатка и сверки нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули каси дигар: бе бақия ва бе ҳисоб."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başkasının parası: bakiye yok, toplama dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужі гроші: без залишку та звірки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa birovning puli: balans va hisobga olish yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他人的錢：不顯示餘額，也不計入總額。"
          }
        }
      }
    },
