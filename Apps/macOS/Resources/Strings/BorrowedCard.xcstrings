    "borrowed.transfer.asIncome": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von einer fremden Karte: Es wird als Einnahme in „%@“ eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From someone else's card: it will be written as income in «%@»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С чужой карты: запишется доходом в «%@»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Із чужої картки: буде записано як дохід у категорії «%@»."
          }
        }
      }
    },
    "borrowed.transfer.note.advance": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorschuss: keine Ausgabe. Was Sie mit der Karte kaufen, zählt als Ihres, wenn Sie es ausgeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An advance: not spending. What you buy with the card is counted as yours when you spend it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: не расход. Траты с карты считаются вашими, когда вы их совершаете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: не витрата. Покупки з картки враховуються як ваші, коли ви їх оплачуєте."
          }
        }
      }
    },
    "borrowed.transfer.note.debtRepayment": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückzahlung: Es wird als Zahlung Ihrer offenen Schuld an diese Person eingetragen, nicht als Überweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repayment: it will be written as a payment of your open debt to this person, not as a transfer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат долга: запишется платежом по вашему открытому долгу этому человеку, а не переводом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погашення: буде записано як платіж за вашим відкритим боргом цій людині, а не як переказ."
          }
        }
      }
    },
    "borrowed.transfer.note.gift": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Geschenk: Es wird als Ausgabe in „Geschenke“ eingetragen, nicht als Überweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gift: it will be written as an expense in «Gifts», not as a transfer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарок: запишется расходом в «Подарки», а не переводом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарунок: буде записано як витрату в категорії «Подарунки», а не як переказ."
          }
        }
      }
    },
