    "borrowed.refusal.ownMoney": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit kartı, əmanət və ya ehtiyat fondu öz vəsaitinizdir: başqasının kartı ola bilməz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крэдытная картка, дэпазіт і фінансавая падушка — гэта вашы грошы. Яны не могуць быць чужой карткай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditní karta, vklad ani finanční rezerva nemohou být cizí kartou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte, eine Einlage oder das Sicherheitspolster sind Ihr eigenes Geld: Sie können keine fremde Karte sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card, a deposit or the safety cushion is your own money: it can't be someone else's card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito, un depósito o el colchón de seguridad son dinero propio: no pueden ser una tarjeta ajena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit, un dépôt ou le matelas de sécurité sont votre propre argent : ils ne peuvent pas être la carte d'un autre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վարկային քարտը, ավանդը կամ պահուստային ֆոնդը ձեր սեփական գումարն է․ այն չի կարող ուրիշի քարտ լինել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta di credito, un deposito o il fondo di emergenza rappresentano denaro tuo: non possono essere una carta altrui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットカード、預金、生活防衛資金は自分のお金として扱うため、他の人のカードにはできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკრედიტო ბარათი, ანაბარი და ფინანსური რეზერვი თქვენი ფულია: ისინი სხვისი ბარათი ვერ იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта, салым немесе қаржылық жастық — сіздің өз ақшаңыз: ол басқа адамның картасы бола алмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신용 카드, 예금 또는 비상금은 내 돈이므로 다른 사람의 카드로 설정할 수 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттик карта, депозит же каржылык резерв — өзүңүздүн акчаңыз: алар башка бирөөнүн картасы боло албайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een creditcard, deposito of financiële buffer is je eigen geld en kan geen kaart van iemand anders zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta kredytowa, lokata i poduszka finansowa to Twoje pieniądze, więc nie mogą być cudzą kartą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão de crédito, depósito ou reserva de segurança representa seu próprio dinheiro: não pode ser um cartão de outra pessoa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão de crédito, um depósito ou a reserva de segurança é dinheiro seu: não pode ser um cartão de outra pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитка, вклад и подушка безопасности — ваши деньги: чужой картой они быть не могут."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Корти кредитӣ, пасандоз ё захираи эҳтиётӣ пули худи шумост: он корти каси дигар буда наметавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi kartı, mevduat veya güvence yastığı kendi paranızdır; başkasının kartı olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитна картка, вклад або фінансова подушка — ваші гроші: вони не можуть бути чужою карткою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit karta, omonat va zaxira jamg‘armasi o‘z pulingiz hisoblanadi: ular boshqa birovning kartasi bo‘la olmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡、存款或备用金属于你自己的钱，不能设为他人的卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡、存款或緊急預備金屬於你自己的錢，不能設為他人的卡片。"
          }
        }
      }
    },
    "borrowed.screen.noBalance": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqasının vəsaiti: balansı yoxdur və hesaba daxil edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужыя грошы: без балансу і ўліку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cizí peníze: bez zůstatku a bez započítání."
          }
        },
        "de": {
