    "borrowed.transfer.note.advance": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Avans: xərc sayılmır. Kartla aldıqlarınız ödəniş zamanı xərciniz kimi sayılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: не лічыцца выдаткам. Пакупкі з карткі ўлічваюцца як вашы выдаткі ў момант аплаты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorschuss: keine Ausgabe. Was Sie mit der Karte kaufen, zählt als Ihres, wenn Sie es ausgeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An advance: not spending. What you buy with the card is counted as yours when you spend it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adelanto: no es gasto. Lo que compre con la tarjeta cuenta como suyo cuando lo gaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une avance : ce n'est pas une dépense. Ce que vous achetez avec la carte compte comme le vôtre quand vous le dépensez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանխավճար է, ոչ թե ծախս։ Քարտով գնումները կհաշվարկվեն որպես ձեր ծախս՝ դրանք կատարելիս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anticipo: non è una spesa. Gli acquisti con la carta vengono conteggiati come spese tue quando li effettui."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ავანსი: ხარჯად არ ითვლება. ბარათით შეძენილი ნივთები თქვენს ხარჯად ჩაიწერება შეძენისას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: шығыс емес. Картамен сатып алғаныңыз жұмсаған кезде сіздікі ретінде саналады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: чыгаша эмес. Карта менен сатып алган нерселериңиз төлөгөндө сиздин чыгашаңыз болуп эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaliczka: nie jest wydatkiem. Zakupy dokonane kartą liczą się jako Twoje wydatki w chwili ich dokonania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adiantamento: não é uma despesa. As compras feitas com o cartão são contabilizadas como suas no momento do gasto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: не расход. Траты с карты считаются вашими, когда вы их совершаете."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пешпардохт: хароҷот нест. Харидҳо бо ин корт ҳангоми пардохт ҳамчун хароҷоти шумо ҳисоб мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avans: harcama sayılmaz. Kartla yaptığınız alışverişler, harcama yaptığınızda size ait sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: не витрата. Покупки з картки враховуються як ваші, коли ви їх оплачуєте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avans: xarajat emas. Karta bilan xarid qilganingizda xarajat sizniki hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預支款項：不計為支出。使用此卡消費時，才會計入你的支出。"
          }
        }
      }
    },
    "borrowed.transfer.note.debtRepayment": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borcun qaytarılması: köçürmə kimi deyil, bu şəxsə olan açıq borcunuzun ödənişi kimi qeydə alınacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне доўгу: будзе запісана як пагашэнне вашага існага доўгу гэтаму чалавеку, а не як перавод."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückzahlung: Es wird als Zahlung Ihrer offenen Schuld an diese Person eingetragen, nicht als Überweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repayment: it will be written as a payment of your open debt to this person, not as a transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devolución: se anotará como pago de su deuda pendiente con esta persona, no como transferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remboursement : ce sera noté comme paiement de votre dette ouverte envers cette personne, et non comme virement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պարտքի մարում․ կգրանցվի որպես այս անձին ձեր չմարված պարտքի վճարում, ոչ թե փոխանցում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rimborso: sarà registrato come pagamento del tuo debito aperto verso questa persona, non come trasferimento."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალის დაბრუნება: ჩაიწერება ამ ადამიანის მიმართ თქვენი მიმდინარე ვალის დაფარვად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтару: аударым емес, осы адамға ашық берешектің төлемі ретінде жазылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карызды кайтаруу: которуу эмес, бул адамга болгон карызыңызды төлөө катары катталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spłata: zostanie zapisana jako spłata Twojego długu wobec tej osoby, a nie jako przelew."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pagamento: será registrado como pagamento da sua dívida em aberto com esta pessoa, não como transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат долга: запишется платежом по вашему открытому долгу этому человеку, а не переводом."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бозпардохт: ҳамчун пардохти қарзи кушодаи шумо ба ин шахс сабт мешавад, на ҳамчун интиқол."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borç ödemesi: transfer olarak değil, bu kişiye olan açık borcunuzun ödemesi olarak kaydedilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погашення: буде записано як платіж за вашим відкритим боргом цій людині, а не як переказ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarz qaytarish: o‘tkazma emas, bu kishiga ochiq qarzingiz to‘lovi sifatida yoziladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "償還債務：將記為償還你對此人的未清債務，而非轉帳。"
          }
        }
      }
    },
