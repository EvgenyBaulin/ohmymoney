    "borrowed.refusal.ownMoney": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card, a deposit or the safety cushion is your own money: it can't be someone else's card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito, un depósito o el colchón de seguridad son dinero propio: no pueden ser una tarjeta ajena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit, un dépôt ou le matelas de sécurité sont votre propre argent : ils ne peuvent pas être la carte d'un autre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитка, вклад и подушка безопасности — ваши деньги: чужой картой они быть не могут."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитна картка, вклад або фінансова подушка — ваші гроші: вони не можуть бути чужою карткою."
          }
        }
      }
    },
    "borrowed.screen.noBalance": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else's money: no balance and no count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinero ajeno: sin saldo y sin conteo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent d'un autre : pas de solde et pas de comptage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужие деньги: остатка и сверки нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужі гроші: без залишку та звірки."
          }
        }
      }
    },
