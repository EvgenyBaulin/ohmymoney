    "borrowed.transfer.asIncome": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З чужой карткі: будзе запісана як даход у «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von einer fremden Karte: Es wird als Einnahme in „%@“ eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From someone else's card: it will be written as income in «%@»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da una carta altrui: sarà registrato come entrata in «%@»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа адамның картасынан: «%@» санатында табыс ретінде жазылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С чужой карты: запишется доходом в «%@»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Із чужої картки: буде записано як дохід у категорії «%@»."
          }
        }
      }
    },
    "borrowed.transfer.note.advance": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: не лічыцца выдаткам. Пакупкі з карткі ўлічваюцца як вашы выдаткі ў момант аплаты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorschuss: keine Ausgabe. Was Sie mit der Karte kaufen, zählt als Ihres, wenn Sie es ausgeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An advance: not spending. What you buy with the card is counted as yours when you spend it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anticipo: non è una spesa. Gli acquisti con la carta vengono conteggiati come spese tue quando li effettui."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: шығыс емес. Картамен сатып алғаныңыз жұмсаған кезде сіздікі ретінде саналады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: не расход. Траты с карты считаются вашими, когда вы их совершаете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс: не витрата. Покупки з картки враховуються як ваші, коли ви їх оплачуєте."
          }
        }
      }
    },
    "borrowed.transfer.note.debtRepayment": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне доўгу: будзе запісана як пагашэнне вашага існага доўгу гэтаму чалавеку, а не як перавод."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückzahlung: Es wird als Zahlung Ihrer offenen Schuld an diese Person eingetragen, nicht als Überweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repayment: it will be written as a payment of your open debt to this person, not as a transfer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rimborso: sarà registrato come pagamento del tuo debito aperto verso questa persona, non come trasferimento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтару: аударым емес, осы адамға ашық берешектің төлемі ретінде жазылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат долга: запишется платежом по вашему открытому долгу этому человеку, а не переводом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погашення: буде записано як платіж за вашим відкритим боргом цій людині, а не як переказ."
          }
        }
      }
    },
    "borrowed.transfer.note.gift": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падарунак: будзе запісана як выдатак у «Падарункі», а не як перавод."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Geschenk: Es wird als Ausgabe in „Geschenke“ eingetragen, nicht als Überweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gift: it will be written as an expense in «Gifts», not as a transfer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un regalo: sarà registrato come spesa in «Regali», non come trasferimento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыйлық: аударым емес, «Сыйлықтар» ішінде шығыс ретінде жазылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарок: запишется расходом в «Подарки», а не переводом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарунок: буде записано як витрату в категорії «Подарунки», а не як переказ."
          }
        }
      }
    },
