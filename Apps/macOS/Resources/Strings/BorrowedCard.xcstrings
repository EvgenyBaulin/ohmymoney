    "borrowed.refusal.ownMoney": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte, eine Einlage oder das Sicherheitspolster sind Ihr eigenes Geld: Sie können keine fremde Karte sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card, a deposit or the safety cushion is your own money: it can't be someone else's card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитка, вклад и подушка безопасности — ваши деньги: чужой картой они быть не могут."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитна картка, вклад або фінансова подушка — ваші гроші: вони не можуть бути чужою карткою."
          }
        }
      }
    },
    "borrowed.screen.noBalance": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremdes Geld: kein Saldo und keine Zählung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else's money: no balance and no count."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужие деньги: остатка и сверки нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужі гроші: без залишку та звірки."
          }
        }
      }
    },
