    "borrowed.transfer.asIncome": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqasının kartından: «%@» kateqoriyasında gəlir kimi qeydə alınacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З чужой карткі: будзе запісана як даход у «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von einer fremden Karte: Es wird als Einnahme in „%@“ eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From someone else's card: it will be written as income in «%@»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde una tarjeta ajena: se anotará como ingreso en «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis la carte d'un autre : ce sera noté comme revenu dans « %@ »."
