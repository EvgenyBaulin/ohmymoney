    "borrowed.transfer.refusal.noDebt": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine offene Schuld an diese Person in dieser Währung, die zurückgezahlt werden könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no open debt to this person in this currency to pay back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
