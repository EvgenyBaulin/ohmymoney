          "stringUnit": {
            "state": "translated",
            "value": "Пешпардохт барои хароҷоти ман бо ин корт"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kartla yapacağım harcamalar için avans"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аванс на мої витрати з цієї картки"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu karta bilan xarajatlarim uchun avans"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此卡消費的預支款項"
          }
        }
      }
    },
