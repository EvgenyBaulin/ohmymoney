    "borrowed.refusal.ownMoney": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крэдытная картка, дэпазіт і фінансавая падушка — гэта вашы грошы. Яны не могуць быць чужой карткай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte, eine Einlage oder das Sicherheitspolster sind Ihr eigenes Geld: Sie können keine fremde Karte sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card, a deposit or the safety cushion is your own money: it can't be someone else's card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito, un depósito o el colchón de seguridad son dinero propio: no pueden ser una tarjeta ajena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit, un dépôt ou le matelas de sécurité sont votre propre argent : ils ne peuvent pas être la carte d'un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta di credito, un deposito o il fondo di emergenza rappresentano denaro tuo: non possono essere una carta altrui."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта, салым немесе қаржылық жастық — сіздің өз ақшаңыз: ол басқа адамның картасы бола алмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta kredytowa, lokata i poduszka finansowa to Twoje pieniądze, więc nie mogą być cudzą kartą."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитка, вклад и подушка безопасности — ваши деньги: чужой картой они быть не могут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi kartı, mevduat veya güvence yastığı kendi paranızdır; başkasının kartı olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитна картка, вклад або фінансова подушка — ваші гроші: вони не можуть бути чужою карткою."
          }
        }
      }
    },
