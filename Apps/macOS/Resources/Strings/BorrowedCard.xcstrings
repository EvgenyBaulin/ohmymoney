    "borrowed.editor.incomeHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kartdan hesabınıza köçürülən vəsait köçürmə kimi deyil, bu kateqoriyada gəlir kimi qeydə alınır. Öz vəsaitinizi karta köçürə bilməzsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы, пераведзеныя з гэтай карткі на ваш рахунак, запісваюцца як даход у гэтай катэгорыі, а не як перавод. Перавесці свае грошы на картку нельга."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld, das von dieser Karte auf Ihr Konto wandert, wird als Einnahme in dieser Kategorie eingetragen, nicht als Überweisung. Ihr Geld kann nicht auf die Karte verschoben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money moved from this card to your account is written as income in this category, not as a transfer. Your money can't be moved onto the card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero que pasa de esta tarjeta a su cuenta se anota como ingreso en esta categoría, no como transferencia. Su dinero no se puede pasar a la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent viré de cette carte vers votre compte est noté comme revenu dans cette catégorie, et non comme virement. Votre argent ne peut pas être viré sur la carte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս քարտից ձեր հաշվին փոխանցված գումարը գրանցվում է որպես այս կատեգորիայի եկամուտ, ոչ թե փոխանցում։ Ձեր գումարը չի կարող փոխանցվել այս քարտին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro spostato da questa carta al tuo conto viene registrato come entrata in questa categoria, non come trasferimento. Non puoi spostare il tuo denaro su questa carta."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ბარათიდან თქვენს ანგარიშზე გადმორიცხული თანხა ამ კატეგორიაში შემოსავლად ჩაიწერება. თქვენი ფულის ბარათზე გადარიცხვა შეუძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы картадан сіздің есеп-шотыңызға көшкен ақша осы санатта табыс ретінде жазылады, аударым ретінде емес. Сіздің ақшаңыз картаға көше алмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул картадан эсебиңизге которулган акча которуу эмес, ушул категориядагы киреше катары катталат. Өз акчаңызды бул картага которо албайсыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieniądze przelane z tej karty na Twoje konto są zapisywane jako przychód w tej kategorii, a nie jako przelew. Nie możesz przelać swoich pieniędzy na tę kartę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro enviado deste cartão para sua conta é registrado como receita nesta categoria, não como transferência. Seu dinheiro não pode ser enviado para o cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод с этой карты на ваш счёт записывается доходом в этой категории, а не переводом. Переводить свои деньги на эту карту нельзя."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуле, ки аз ин корт ба ҳисоби шумо мегузарад, ҳамчун даромад дар ин категория сабт мешавад, на ҳамчун интиқол. Пули худро ба ин корт гузаронда наметавонед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu karttan hesabınıza aktarılan para, transfer olarak değil, bu kategoride gelir olarak kaydedilir. Kendi paranızı bu karta aktaramazsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші з цієї картки на ваш рахунок записуються як дохід у цій категорії, а не як переказ. Ваші гроші не можна переказувати на цю картку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kartadan hisobingizga o‘tkazilgan pul o‘tkazma emas, shu toifadagi daromad sifatida yoziladi. Pulingizni bu kartaga o‘tkazib bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此卡轉入你帳戶的金額會記為此類別的收入，而非轉帳。你的錢無法轉入此卡。"
          }
        }
      }
    },
    "borrowed.editor.mainStays": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas hesab öz vəsaitinizdir: başqasının kartı ola bilməz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак змяшчае вашы грошы і не можа быць чужой карткай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto ist Ihr eigenes Geld: Es kann keine fremde Karte sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account is your own money: it can't be someone else's card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal es dinero propio: no puede ser una tarjeta ajena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal est votre propre argent : il ne peut pas être la carte d'un autre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնական հաշիվը ձեր սեփական գումարն է․ այն չի կարող ուրիշի քարտ լինել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale contiene denaro tuo: non può essere una carta altrui."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავარ ანგარიშზე თქვენი ფულია: ის სხვისი ბარათი ვერ იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот — сіздің ақшаңыз: ол басқа адамның картасы бола алмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги эсеп — өзүңүздүн акчаңыз: ал башка бирөөнүн картасы боло албайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto główne zawiera Twoje pieniądze, więc nie może być cudzą kartą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal representa seu próprio dinheiro: ela não pode ser um cartão de outra pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт — ваши деньги: чужой картой он быть не может."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби асосӣ пули худи шумост: он корти каси дигар буда наметавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana hesap kendi paranızdır; başkasının kartı olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок — ваші власні гроші: він не може бути чужою карткою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy hisob o‘z pulingiz uchun: u boshqa birovning kartasi bo‘la olmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要帳戶是你自己的錢，不能設為他人的卡片。"
          }
        }
      }
    },
    "borrowed.editor.person": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartın sahibi"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чыя картка"
          }
