    "archive.password.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivi şifrələmədən yaratmaq üçün boş saxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакіньце поле пустым, каб запісаць архіў без шыфравання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponecháním prázdného pole uložíte archiv bez šifrování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie das Feld leer, um das Archiv ohne Verschlüsselung zu schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it empty to write the archive without encryption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjelo vacío para escribir el archivo sin cifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour écrire l'archive sans chiffrement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դատարկ թողեք՝ արխիվն առանց գաղտնագրման պահպանելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per creare l’archivio senza crittografia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄にすると、暗号化せずにアーカイブを書き出します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივის დაშიფვრის გარეშე შესაქმნელად ველი ცარიელი დატოვეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағатты шифрсыз жазу үшін бос қалдырыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивди шифрлөөсүз түзүү үчүн бош калтырыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om het archief zonder versleuteling te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby zapisać archiwum bez szyfrowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para criar o arquivo sem criptografia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para criar o arquivo sem encriptação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы записать архив без шифрования."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои сабти бойгонӣ бе рамзгузорӣ холӣ монед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivi şifrelemeden kaydetmek için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім, щоб записати архів без шифрування."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivni shifrlamasdan saqlash uchun bo‘sh qoldiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则不加密归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即可寫入未加密的封存檔。"
          }
        }
      }
    },
