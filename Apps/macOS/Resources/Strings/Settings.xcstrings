    "templates.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates fill themselves from what you enter. Pinned ones always stay first. A template in the archive leaves the chips and comes back with «Bring back»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas se rellenan solas con lo que introduce. Las fijadas siempre van primero. Una plantilla en el archivo sale de los chips y vuelve con «Recuperar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles se remplissent d'eux-mêmes d'après ce que vous saisissez. Les épinglés restent toujours en premier. Un modèle aux archives quitte les pastilles et revient avec « Ramener »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны сами набираются из того, что вы вводите. Закреплённые всегда идут первыми. Шаблон в архиве уходит из чипов и возвращается кнопкой «Вернуть»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони створюються з ваших записів. Закріплені завжди перші. Шаблон в архіві зникає з підказок і повертається через «Повернути»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлгілер енгізгендеріңізден өзі толтырылады. Бекітілгендері әрдайым алда тұрады. Мұрағаттағы үлгі батырмалардан жоғалып, «Қайтару» арқылы оралады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen füllen sich aus dem, was Sie eingeben. Angeheftete bleiben immer vorn. Eine Vorlage im Archiv verschwindet aus den Chips und kommt mit „Zurückholen“ wieder."
          }
        }
      }
    },
