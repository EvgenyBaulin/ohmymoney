    "archive.password.mismatch.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the same password in both fields. The archive will open only with exactly what you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba la misma contraseña en los dos campos. El archivo se abrirá solo con exactamente lo que escriba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите один и тот же пароль в оба поля. Архив откроется только тем паролем, который вы введёте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть однаковий пароль в обох полях. Архів відкриється лише з точно таким самим паролем."
          }
        }
      }
