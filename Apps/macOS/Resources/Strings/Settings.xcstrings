    "currencies.custom.ratesHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məzənnə göstərilən tarixdən növbəti daxil edilmiş məzənnəyədək qüvvədədir; artıq qeydə alınmış əməliyyatların məzənnəsi dəyişmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс дзейнічае з зададзенай даты да наступнага ўведзенага курсу; ужо запісаныя аперацыі захоўваюць свой курс."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz platí od zadaného dne do dalšího zadaného kurzu; již zaznamenané transakce si svůj kurz zachovají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kurs gilt von seinem Tag bis zum nächsten eingetragenen; bereits erfasste Vorgänge behalten ihren Kurs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rate holds from its day until the next one typed; operations already recorded keep their rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tipo vale desde su día hasta el siguiente que escriba; las operaciones ya registradas conservan su tipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cours vaut de son jour jusqu'à la saisie du suivant ; les opérations déjà notées gardent leur cours."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխարժեքը գործում է իր օրվանից մինչև հաջորդ մուտքագրված փոխարժեքը․ արդեն գրանցված գործառնությունները պահպանում են իրենց փոխարժեքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cambio è valido dal giorno indicato fino al successivo inserito; le operazioni già registrate mantengono il loro cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レートは指定日から次のレートの入力日まで適用されます。記録済みの取引のレートは変わりません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კურსი მოქმედებს მითითებული დღიდან მომდევნო კურსამდე; უკვე შენახული ოპერაციები თავიანთ კურსს ინარჩუნებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бағам өз күнінен бастап келесі теріліскенше жарайды; бұрын жазылған операциялар өз бағамын сақтайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс киргизилген күндөн кийинки курс киргизилгенге чейин күчүндө болот; буга чейин катталган операциялардын курсу сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een koers geldt vanaf de ingevoerde datum tot de volgende ingevoerde koers. Reeds vastgelegde transacties behouden hun koers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs obowiązuje od wybranego dnia do następnego wpisanego kursu; zapisane operacje zachowują swój kurs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cotação vale a partir de sua data até a próxima cotação inserida. As operações já registradas mantêm sua cotação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma taxa aplica-se desde a sua data até à introdução da seguinte; as operações já registadas mantêm a sua taxa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс действует с его дня до следующего вписанного; записанные операции сохраняют свой курс."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурб аз санаи худ то қурби навбатии воридшуда амал мекунад; амалиёти аллакай сабтшуда қурби худро нигоҳ медоранд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kur, tarihinden bir sonraki kurun girildiği tarihe kadar geçerlidir; kaydedilmiş işlemler kendi kurunu korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс діє від своєї дати до наступного введеного; уже записані операції зберігають свій курс."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs ko‘rsatilgan sanadan keyingi kurs kiritilguncha amal qiladi; avval qayd etilgan amallar o‘z kursini saqlaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇率从生效日期起适用，直至输入下一个汇率；已记录的交易保留原汇率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯率自指定日期起生效，直到下一筆匯率生效為止；已記錄的交易會保留原有匯率。"
          }
        }
      }
    },
