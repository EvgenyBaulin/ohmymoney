    "settings.entry.orderHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahəni yuxarı və ya aşağı sürüşdürün. ↓ panelində sahələr bu sırada görünür və Tab bu sıra ilə sahələr arasında keçir. Əməliyyatın növü həmişə yuxarıda, “Böl”, “Başqasının əvəzinə ödənilib” və “Nisyə” isə aşağıda qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перацягніце поле ўгору або ўніз. Панэль ↓ паказвае палі ў гэтым парадку, і Tab перамяшчае па іх у тым жа парадку. Тып аперацыі заўсёды застаецца зверху; «Падзяліць», «Аплачана за кагосьці» і «У крэдыт» — знізу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte pole nahoru nebo dolů. Panel ↓ zobrazí pole v tomto pořadí a klávesa Tab mezi nimi bude postupně přecházet. Typ operace zůstává vždy nahoře; „Rozdělit“, „Zaplaceno za někoho“ a „Na úvěr“ zůstávají dole."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie ein Feld nach oben oder unten. Das Bedienfeld ↓ zeigt seine Felder in dieser Reihenfolge, und Tab geht in ihr durch sie. Die Art des Vorgangs bleibt immer oben; „Teilen“, „Für jemand anderen bezahlt“ und „Auf Kredit“ bleiben unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a field up or down. The ↓ panel shows its fields in this order, and Tab moves through them in it. The type of the operation always stays on top; “Split”, “Paid for someone” and “On credit” stay at the bottom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un campo arriba o abajo. El panel ↓ muestra sus campos en este orden, y Tab se mueve por ellos en ese orden. El tipo de la operación siempre queda arriba; «Dividir», «Pagado por otro» y «A crédito» quedan abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un champ vers le haut ou le bas. Le panneau ↓ affiche ses champs dans cet ordre, et Tab les parcourt dans le même ordre. Le type de l'opération reste toujours en haut ; « Répartir », « Payé pour quelqu'un » et « À crédit » restent en bas."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քաշեք դաշտը վերև կամ ներքև։ ↓ վահանակում դաշտերը կցուցադրվեն այս հերթականությամբ, և Tab-ը կանցնի դրանցով։ Գործարքի տեսակը միշտ վերևում է, իսկ «Բաժանել», «Վճարված է ուրիշի համար» և «Ապառիկ» դաշտերը՝ ներքևում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un campo verso l’alto o il basso. Il pannello ↓ mostra i campi in questo ordine e Tab li scorre nello stesso ordine. Il tipo di operazione resta sempre in cima; “Dividi”, “Pagato per qualcuno” e “A credito” restano in fondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を上下にドラッグします。↓パネルにはこの順序で項目が表示され、Tabキーで順に移動できます。取引の種類は常に一番上、「分割」「立て替え」「後払い」は一番下に表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაათრიეთ ველი ზემოთ ან ქვემოთ. ↓ პანელში ველები ამ რიგით გამოჩნდება და Tab-იც ამ რიგით გადაინაცვლებს. ოპერაციის ტიპი ყოველთვის ზემოთ რჩება; „გაყოფა“, „სხვის ნაცვლად გადახდილი“ და „კრედიტით“ — ქვემოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өрісті жоғары не төмен сүйреңіз. ↓ панелі өрістерді осы ретпен көрсетеді, Tab та осы ретпен ауысады. Операция түрі әрқашан жоғарыда, “Бөлу”, “Біреу үшін төледім” және “Несиеге” төменде қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Талааны өйдө же ылдый сүйрөңүз. ↓ панелинде талаалар ушул иретте көрсөтүлөт, Tab да аларды ушул иретте аралайт. Операциянын түрү дайыма жогоруда; «Бөлүү», «Башка бирөө үчүн төлөндү» жана «Карызга» ылдыйда турат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een veld omhoog of omlaag. De velden staan in deze volgorde in het ↓-paneel en met Tab doorloop je ze in die volgorde. Het type transactie blijft altijd bovenaan; ‘Splitsen’, ‘Betaald voor iemand’ en ‘Op krediet’ blijven onderaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij pole w górę lub w dół. Pola w panelu ↓ będą wyświetlane w tej kolejności, a klawisz Tab będzie między nimi przechodzić. Typ operacji zawsze pozostaje na górze, a „Podziel”, „Zapłacono za kogoś” i „Na kredyt” — na dole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um campo para cima ou para baixo. O painel ↓ mostra os campos nessa ordem, e Tab percorre os campos nessa mesma ordem. O tipo de operação fica sempre no topo; “Dividir”, “Pago para alguém” e “A crédito” ficam na parte inferior."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um campo para cima ou para baixo. O painel ↓ apresenta os campos por esta ordem, que também é seguida pela tecla Tab. O tipo de operação fica sempre no topo; “Dividir”, “Pago por alguém” e “A crédito” ficam no fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите поле выше или ниже. В этом порядке панель ↓ показывает поля, и в нём же Tab переходит между ними. Тип операции всегда сверху, «Разделить», «За другого» и «В кредит» — внизу."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Майдонро ба боло ё поён кашед. Майдонҳо дар панели ↓ бо ҳамин тартиб нишон дода мешаванд ва Tab аз рӯи ҳамин тартиб мегузарад. Навъи амалиёт ҳамеша дар боло, «Тақсим», «Барои каси дигар пардохт шуд» ва «Ба қарз» дар поён мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alanı yukarı veya aşağı sürükleyin. ↓ panelinde alanlar bu sırada görünür ve Tab tuşuyla bu sırada geçilir. İşlem türü her zaman üstte; “Böl”, “Başkası için ödendi” ve “Veresiye” altta kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть поле вгору або вниз. Панель ↓ показує поля в цьому порядку, і Tab переходить між ними так само. Вид операції завжди зверху; «Розбити», «Оплачено за іншого» та «У кредит» — знизу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maydonni yuqoriga yoki pastga torting. ↓ panelida maydonlar shu tartibda ko‘rsatiladi va Tab ular orasida shu tartibda o‘tadi. Operatsiya turi doim tepada, “Bo‘lish”, “Boshqa birov uchun to‘langan” va “Nasmiyaga” esa pastda qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖移字段。↓ 面板按此顺序显示字段，按 Tab 键依次切换。交易类型始终位于顶部；“拆分”、“代他人付款”和“赊账”始终位于底部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下拖移欄位。↓ 面板會依此順序顯示欄位，按 Tab 也會依此順序切換。交易類型一律置頂；「拆分」、「代墊」和「賒帳」置於底部。"
          }
        }
      }
    },
