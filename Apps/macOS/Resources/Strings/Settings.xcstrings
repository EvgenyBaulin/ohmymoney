    "backups.readable.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüsxənin oxuna bilən versiyası (gündəlik nüsxənin və yeniləmədən əvvəl yaradılmış nüsxənin yanındakı CSV faylları qovluğu) yalnız bu Mac-də saxlanılır. iCloud Drive-dakı qovluğa yalnız .sqlite faylı göndərilir — açıq şəkildə, şifrələnmədən."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Версія копіі для чытання — папка з файламі CSV побач са штодзённай копіяй і копіяй перад абнаўленнем — захоўваецца толькі на гэтым Mac. У папку ў iCloud Drive трапляе толькі файл .sqlite, у адкрытым выглядзе, без шыфравання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čitelná verze kopie (složka souborů CSV vedle denní kopie a kopie vytvořené před aktualizací) zůstává jen na tomto Macu. Do složky na iCloud Drive se ukládá pouze soubor .sqlite — nechráněný a nešifrovaný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lesbare Fassung einer Kopie (ein Ordner mit CSV-Dateien neben der Kopie des Tages und der Kopie vor einem Update) liegt nur auf diesem Mac. Ein Ordner im iCloud Drive bekommt nur die .sqlite-Datei — offen, nicht verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The readable version of a copy (a folder of CSV files beside the copy of the day and the copy made before an update) lies on this Mac only. A folder in iCloud Drive gets the .sqlite file alone — in the open, not encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión legible de una copia (una carpeta de archivos CSV junto a la copia del día y la copia hecha antes de una actualización) está solo en este Mac. Una carpeta en iCloud Drive recibe solo el archivo .sqlite — en claro, sin cifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version lisible d'une copie (un dossier de fichiers CSV à côté de la copie du jour et de la copie faite avant une mise à jour) reste sur ce Mac seulement. Un dossier dans iCloud Drive reçoit le seul fichier .sqlite — à découvert, non chiffré."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատճենի ընթեռնելի տարբերակը՝ CSV ֆայլերի պանակը, որը գտնվում է օրվա և թարմացումից առաջ ստեղծված պատճենների կողքին, պահվում է միայն այս Mac-ում։ iCloud Drive-ի պանակ է ուղարկվում միայն .sqlite ֆայլը՝ առանց գաղտնագրման։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione leggibile di una copia (una cartella di file CSV accanto alla copia del giorno e a quella creata prima di un aggiornamento) si trova solo su questo Mac. Nella cartella in iCloud Drive viene salvato solo il file .sqlite, in chiaro e senza crittografia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り用のコピー（日次コピーとアップデート前のコピーに添えられたCSVファイルのフォルダ）は、このMacにのみ保存されます。iCloud Driveのフォルダには、.sqliteファイルのみが暗号化されずに保存されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ასლის წაკითხვადი ვერსია (CSV ფაილების საქაღალდე, რომელიც დღის ასლისა და განახლებამდე შექმნილი ასლის გვერდით მდებარეობს) მხოლოდ ამ Mac-ზე ინახება. iCloud Drive-ის საქაღალდეში მხოლოდ .sqlite ფაილი გადაიგზავნება — დაუშიფრავად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірменің оқылатын нұсқасы (күн көшірмесі мен жаңартудан бұрынғы көшірменің жанындағы CSV файлдар қалтасы) тек осы Mac-та тұрады. iCloud Drive қалтасына тек .sqlite файлы түседі — ашық күйінде, шифрсыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көчүрмөнүн окула турган версиясы (күнүмдүк жана жаңыртууга чейин түзүлгөн көчүрмөлөрдүн жанындагы CSV файлдар папкасы) ушул Mac компьютеринде гана сакталат. iCloud Drive папкасына .sqlite файлы гана ачык, шифрлөөсүз сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De leesbare versie van een kopie (een map met CSV-bestanden naast de dagelijkse kopie en de kopie van vóór een update) staat alleen op deze Mac. In een map in iCloud Drive wordt alleen het .sqlite-bestand bewaard, onversleuteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytelna wersja kopii (folder plików CSV obok kopii dziennej i kopii sprzed uaktualnienia) znajduje się tylko na tym Macu. Do folderu w iCloud Drive trafia sam plik .sqlite — jawny, bez szyfrowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão legível de uma cópia (uma pasta de arquivos CSV ao lado da cópia do dia e da cópia feita antes de uma atualização) fica apenas neste Mac. Uma pasta no iCloud Drive recebe apenas o arquivo .sqlite, sem criptografia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão legível de uma cópia (uma pasta de ficheiros CSV junto à cópia do dia e à cópia criada antes de uma atualização) fica apenas neste Mac. Uma pasta no iCloud Drive recebe apenas o ficheiro .sqlite, sem encriptação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаемая версия копии (папка с CSV рядом с копией дня и копией «перед обновлением») лежит только на этом Mac. В папку iCloud Drive попадает только файл .sqlite — открыто, без шифрования."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Версияи хондашавандаи нусха (ҷузвдони файлҳои CSV дар паҳлуи нусхаи рӯзона ва нусхаи пеш аз навсозӣ сохташуда) танҳо дар ҳамин Mac нигоҳ дошта мешавад. Ба ҷузвдони iCloud Drive танҳо файли .sqlite фиристода мешавад — ошкоро, бе рамзгузорӣ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kopyanın okunabilir sürümü (günlük kopyanın ve güncelleme öncesi oluşturulan kopyanın yanındaki CSV dosyaları klasörü) yalnızca bu Mac'te bulunur. iCloud Drive'daki klasöre yalnızca .sqlite dosyası kaydedilir — açık olarak, şifrelenmeden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читабельна версія копії (папка CSV-файлів поруч із копією дня та копією перед оновленням) зберігається лише на цьому Mac. До папки в iCloud Drive потрапляє лише файл .sqlite — відкритий, без шифрування."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nusxaning o‘qish uchun mo‘ljallangan versiyasi (kunlik va yangilanishdan oldingi nusxalar yonidagi CSV fayllar jildi) faqat shu Mac’da saqlanadi. iCloud Drive’dagi jildga faqat .sqlite fayli yuboriladi — ochiq holda, shifrlanmasdan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本的可读版本（每日副本和更新前副本旁边的 CSV 文件夹）仅保存在这台 Mac 上。iCloud Drive 中的文件夹只接收 .sqlite 文件，且以明文保存，未经加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "副本的可讀取版本（與每日副本及更新前副本並列的 CSV 檔案夾）只會保留在這部 Mac 上。iCloud Drive 中的檔案夾只會收到 .sqlite 檔案，且未加密。"
          }
        }
      }
    },
