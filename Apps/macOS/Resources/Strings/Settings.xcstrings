    "settings.selfEmployed.referenceHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-də qeydə alınmış qanunvericilik. Yeni versiya çıxanadək qanun dəyişərsə, öz dəyərinizi daxil edin; sahə boş olduqda qanundakı dəyər tətbiq edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Закон у адпаведнасці з данымі OhMyMoney. Калі закон змяніўся да выхаду новай версіі, увядзіце сваё значэнне; пустое поле адпавядае закону."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zákon podle údajů OhMyMoney. Pokud se zákon změnil před vydáním nové verze, zadejte vlastní hodnotu; prázdné pole se řídí zákonem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gesetz, wie OhMyMoney es kennt. Hat sich das Gesetz geändert, bevor eine neue Version erschien, tragen Sie Ihren Wert ein; ein leeres Feld folgt dem Gesetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The law as OhMyMoney knows it. If the law changed before a new version came out, type your value; an empty field follows the law."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ley tal como la conoce OhMyMoney. Si la ley cambió antes de que saliera una versión nueva, escriba su valor; un campo vacío sigue la ley."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La loi telle qu'OhMyMoney la connaît. Si la loi a changé avant la sortie d'une nouvelle version, saisissez votre valeur ; un champ vide suit la loi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օրենքը՝ ըստ OhMyMoney-ի տվյալների։ Եթե օրենքը փոխվել է մինչև նոր տարբերակի թողարկումը, մուտքագրեք ձեր արժեքը։ Դատարկ դաշտի դեպքում օգտագործվում է օրենքով սահմանված արժեքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La legge secondo OhMyMoney. Se la legge cambia prima del rilascio di una nuova versione, inserisci il valore aggiornato; un campo vuoto usa il valore previsto dalla legge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoneyに登録されている法定値です。新しいバージョンが出る前に法律が変わった場合は、値を入力してください。空欄の場合は法定値が使われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კანონი OhMyMoney-ის მონაცემებით. თუ ახალი ვერსიის გამოსვლამდე კანონი შეიცვალა, შეიყვანეთ თქვენი მნიშვნელობა; ცარიელი ველის შემთხვევაში კანონის მნიშვნელობა გამოიყენება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney білетін заң талаптары. Жаңа нұсқа шыққанға дейін заң өзгерсе, өз мәніңізді енгізіңіз; бос өріс заңға сай есептеледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney'деги мыйзам маалыматы. Мыйзам жаңы версия чыкканга чейин өзгөрсө, өз маанисиңизди киргизиңиз; бош талаада мыйзамдагы маани колдонулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wet zoals bekend bij OhMyMoney. Als de wet is gewijzigd voordat een nieuwe versie is uitgebracht, voer je eigen waarde in. Een leeg veld volgt de wet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepisy znane aplikacji OhMyMoney. Jeśli przepisy zmieniły się przed wydaniem nowej wersji, wpisz własną wartość. Puste pole oznacza wartość zgodną z przepisami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A legislação conforme conhecida pelo OhMyMoney. Se a lei mudar antes de uma nova versão, digite seu valor; um campo vazio segue a legislação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A lei conforme registada em OhMyMoney. Se a lei mudar antes de sair uma nova versão, introduza o valor; um campo vazio segue a lei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения закона, как их знает OhMyMoney. Если закон изменился раньше, чем вышла новая версия, впишите своё; пустое поле — как в законе."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қонун мувофиқи маълумоти OhMyMoney. Агар қонун пеш аз баромадани версияи нав тағйир ёбад, қимати худро ворид кунед; майдони холӣ ба қонун мувофиқат мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney’nin bildiği mevzuat. Yeni sürüm çıkmadan mevzuat değişirse kendi değerinizi girin; boş alan mevzuata uyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закон, відомий OhMyMoney. Якщо закон змінився до нової версії, введіть власне значення; порожнє поле відповідає закону."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney’dagi qonun ma’lumotlari. Yangi versiya chiqishidan oldin qonun o‘zgarsa, o‘z qiymatingizni kiriting; bo‘sh maydonda qonundagi qiymat ishlatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 所依据的法规。如果法规在新版本发布前发生变化，请输入相应数值；留空则按法规计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 所依據的法規。若法規在新版本推出前有所變更，請輸入適用數值；留空則依照法規。"
          }
        }
      }
    },
