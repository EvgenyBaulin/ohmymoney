    "integrity.repair.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "First a copy «before repair» is made. Then %lld row that holds nothing of yours is removed, in one step. Everything else is left as it is and goes to the report."
                }
              },
              "other": {
                "stringUnit": {
