    },
    "backups.restore.newer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nüsxə OhMyMoney tətbiqinin daha yeni versiyasında yaradılıb. Bərpa etmək üçün tətbiqi yeniləyin. Heç nə əvəzlənmədi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта копія створана ў навейшай версіі OhMyMoney. Абнавіце праграму, каб аднавіць яе. Нічога не заменена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto kopii vytvořila novější verze OhMyMoney. Chcete-li ji obnovit, aktualizujte aplikaci. Nic nebylo nahrazeno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie wurde von einer neueren Version von OhMyMoney geschrieben: Aktualisieren Sie die App, um sie wiederherzustellen. Nichts wurde ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy was written by a newer version of OhMyMoney: update the app to restore it. Nothing was replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia la escribió una versión más reciente de OhMyMoney: actualice la app para restaurarla. No se reemplazó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie a été écrite par une version plus récente d'OhMyMoney : mettez l'app à jour pour la restaurer. Rien n'a été remplacé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս պատճենը ստեղծվել է OhMyMoney-ի ավելի նոր տարբերակով։ Վերականգնելու համար թարմացրեք հավելվածը։ Ոչինչ չի փոխարինվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia è stata creata con una versione più recente di OhMyMoney: aggiorna l’app per ripristinarla. Nessun dato è stato sostituito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーは新しいバージョンのOhMyMoneyで作成されています。復元するにはアプリをアップデートしてください。データは置き換えられていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ასლი OhMyMoney-ის უფრო ახალი ვერსიით შეიქმნა. აღსადგენად განაახლეთ აპი. არაფერი შეცვლილა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл көшірмені OhMyMoney-дің жаңа нұсқасы жазған: оны қалпына келтіру үшін қолданбаны жаңартыңыз. Ештеңе ауыстырылмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул көчүрмө OhMyMoney колдонмосунун жаңыраак версиясында түзүлгөн. Калыбына келтирүү үчүн колдонмону жаңыртыңыз. Эч нерсе алмаштырылган жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze kopie is gemaakt met een nieuwere versie van OhMyMoney. Werk de app bij om de kopie terug te zetten. Er is niets vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia pochodzi z nowszej wersji OhMyMoney. Uaktualnij aplikację, aby ją przywrócić. Żadne dane nie zostały zastąpione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia foi criada por uma versão mais recente do OhMyMoney. Atualize o app para restaurá-la. Nada foi substituído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia foi criada por uma versão mais recente do OhMyMoney. Atualize a aplicação para a restaurar. Nada foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту копию записала более новая версия OhMyMoney: чтобы восстановить её, обновите приложение. Ничего не заменено."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин нусха дар версияи навтари OhMyMoney сохта шудааст. Барои барқарор кардан, барномаро нав кунед. Ҳеҷ чиз иваз нашуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kopya, OhMyMoney’nin daha yeni bir sürümüyle oluşturulmuş. Geri yüklemek için uygulamayı güncelleyin. Hiçbir veri değiştirilmedi."
          }
