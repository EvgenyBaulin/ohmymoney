    "archive.password.mismatch.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər iki xanaya eyni parolu daxil edin. Arxiv yalnız daxil etdiyiniz parolla açılacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце аднолькавы пароль у абодвух палях. Архіў адкрыецца толькі з дакладна такім паролем."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do obou polí zadejte stejné heslo. Archiv bude možné otevřít jen přesně tímto heslem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie in beide Felder dasselbe Passwort. Das Archiv öffnet sich nur mit genau dem, was Sie eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the same password in both fields. The archive will open only with exactly what you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba la misma contraseña en los dos campos. El archivo se abrirá solo con exactamente lo que escriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le même mot de passe dans les deux champs. L'archive ne s'ouvrira qu'avec exactement ce que vous saisissez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երկու դաշտում էլ մուտքագրեք նույն գաղտնաբառը։ Արխիվը կբացվի միայն ձեր մուտքագրած ճշգրիտ գաղտնաբառով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la stessa password in entrambi i campi. L’archivio si aprirà solo con la password esatta inserita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の欄に同じパスワードを入力してください。アーカイブを開くには、入力したパスワードがそのまま必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ორივე ველში ერთი და იგივე პაროლი შეიყვანეთ. არქივი მხოლოდ ზუსტად ამ პაროლით გაიხსნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екі өрісте де бірдей құписөз теріңіз. Мұрағат тек дәл теріген құписөзбен ашылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эки талаага тең бирдей сырсөз киргизиңиз. Архив так ошол сырсөз менен гана ачылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer in beide velden hetzelfde wachtwoord in. Het archief kan alleen worden geopend met precies wat je invoert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz to samo hasło w obu polach. Archiwum otworzy się tylko po wpisaniu dokładnie tego hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a mesma senha nos dois campos. O arquivo só poderá ser aberto com a senha exata que você digitar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza a mesma palavra-passe nos dois campos. O arquivo só abrirá com a palavra-passe exata que introduzir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите один и тот же пароль в оба поля. Архив откроется только тем паролем, который вы введёте."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҳар ду майдон як паролро ворид кунед. Бойгонӣ танҳо бо пароли дақиқи воридкардаатон кушода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki alana da aynı parolayı girin. Arşiv yalnızca tam olarak yazdığınız parolayla açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть однаковий пароль в обох полях. Архів відкриється лише з точно таким самим паролем."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikkala maydonga bir xil parol kiriting. Arxiv faqat aynan shu parol bilan ochiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在两个栏位中输入相同的密码。打开归档时必须输入完全相同的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在兩個欄位輸入相同的密碼。開啟封存檔時必須輸入完全相同的密碼。"
          }
        }
      }
    },
