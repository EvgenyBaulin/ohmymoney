    "archive.import.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqdəki bütün məlumatlar arxivdəkilərlə əvəz ediləcək. Əvvəlcə cari vəziyyətin nüsxəsi yaradılacaq, sonra tətbiq yenidən başladılacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе даныя ў праграме будуць заменены змесцівам архіва. Спачатку будзе створана копія бягучых даных, пасля чаго праграма перазапусціцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veškerá data v aplikaci budou nahrazena obsahem archivu. Nejprve se uloží kopie současného stavu a aplikace se restartuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in der App wird durch den Inhalt des Archivs ersetzt. Vorher wird eine Kopie des jetzigen Stands geschrieben, und die App startet neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the app is replaced by what is inside the archive. A copy of the current state is written first, and the app restarts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que hay en la app se sustituye por lo que contiene el archivo. Antes se escribe una copia del estado actual, y la app se reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est dans l'app est remplacé par le contenu de l'archive. Une copie de l'état actuel est d'abord écrite, puis l'app redémarre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածի բոլոր տվյալները կփոխարինվեն արխիվի տվյալներով։ Նախ կպահպանվի ընթացիկ վիճակի պատճենը, ապա հավելվածը կվերագործարկվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i dati nell’app saranno sostituiti con quelli dell’archivio. Prima verrà creata una copia dei dati attuali, poi l’app si riavvierà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内のすべてのデータがアーカイブの内容に置き換えられます。まず現在の状態のコピーが作成され、アプリが再起動します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპში არსებული ყველაფერი არქივის შიგთავსით შეიცვლება. ჯერ მიმდინარე მონაცემების ასლი შეიქმნება, შემდეგ კი აპი ხელახლა გაეშვება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбадағы барлық нәрсе мұрағаттағымен ауыстырылады. Алдымен ағымдағы күйдің көшірмесі жазылады, содан кейін қолданба қайта іске қосылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмодогу бардык дайындар архивдеги дайындар менен алмаштырылат. Адегенде учурдагы абалдын көчүрмөсү түзүлүп, колдонмо өчүрүлүп-күйгүзүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gegevens in de app worden vervangen door de inhoud van het archief. Eerst wordt een kopie van de huidige gegevens bewaard. Daarna wordt de app opnieuw gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie dane w aplikacji zostaną zastąpione zawartością archiwum. Najpierw zostanie zapisana kopia bieżącego stanu, a aplikacja uruchomi się ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados do app serão substituídos pelo conteúdo do arquivo. Uma cópia dos dados atuais será criada primeiro e o app será reiniciado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados da aplicação serão substituídos pelo conteúdo do arquivo. Primeiro, será criada uma cópia do estado atual e a aplicação será reiniciada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что есть в приложении, заменится содержимым архива. Копия текущего состояния будет сделана заранее, затем приложение перезапустится."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳамаи додаҳои барнома бо мундариҷаи бойгонӣ иваз мешаванд. Аввал нусхаи ҳолати ҷорӣ сабт мешавад ва барнома аз нав оғоз меёбад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadaki her şey arşivdeki içerikle değiştirilir. Önce mevcut durumun bir kopyası kaydedilir ve uygulama yeniden başlatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе в застосунку буде замінено вмістом архіву. Спочатку збережеться копія поточного стану, потім застосунок перезапуститься."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilovadagi barcha ma’lumotlar arxivdagilari bilan almashtiriladi. Avval joriy holat nusxasi saqlanadi, so‘ng ilova qayta ishga tushadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 中的所有内容都将替换为归档中的内容。当前状态会先存为副本，然后 App 将重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 中的所有資料都會由封存檔中的內容取代。系統會先儲存目前狀態的副本，然後重新啟動 App。"
          }
        }
      }
    },
