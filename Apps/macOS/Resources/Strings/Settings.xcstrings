        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey değiştirilmedi: Onarım öncesi kopya oluşturulamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не змінено: не вдалося створити копію перед виправленням."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hech narsa o‘zgarmadi: tuzatishdan oldin nusxa yaratib bo‘lmadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未作任何更改：无法创建修复前的副本。"
