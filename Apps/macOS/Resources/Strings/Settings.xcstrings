    "settings.entry.plusOpensHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entry line is hidden behind the round «+» in the bottom right corner. «+» or ⌘N opens what is chosen: the line at the bottom with the keyboard, or the form at the right. In a narrow window the form folds into the button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea de entrada se oculta tras el botón redondo «+» de la esquina inferior derecha. «+» o ⌘N abre lo elegido: la línea de abajo con el teclado, o el formulario a la derecha. En una ventana estrecha el formulario se pliega en el botón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne de saisie se cache derrière le bouton rond « + » en bas à droite. « + » ou ⌘N ouvre ce qui est choisi : la ligne en bas avec le clavier, ou le formulaire à droite. Dans une fenêtre étroite, le formulaire se replie dans le bouton."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка ввода спрятана за круглой «+» в правом нижнем углу. «+» или ⌘N открывает выбранное: строку снизу с клавиатурой или форму справа. В узком окне форма сворачивается в кнопку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок вводу приховано за круглою кнопкою «+» у правому нижньому куті. «+» або ⌘N відкриває вибране: рядок знизу з клавіатурою або форму праворуч. У вузькому вікні форма згортається в кнопку."
          }
        }
      }
    },
