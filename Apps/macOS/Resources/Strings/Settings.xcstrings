    "settings.entry.hintsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chips are the templates you repeat; hints are the places and alike operations offered as you type. Switching them off hides them, it deletes nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chips son las plantillas que repite; las sugerencias son los lugares y operaciones parecidas que se ofrecen mientras escribe. Desactivarlas las oculta, no borra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pastilles sont les modèles que vous répétez ; les suggestions sont les lieux et les opérations semblables proposés pendant la saisie. Les désactiver les masque, sans rien supprimer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чипы — шаблоны, которые вы повторяете; подсказки — места и похожие операции, пока вы печатаете. Выключение только прячет их, ничего не удаляет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони — це записи, які ви повторюєте; підказки — місця й схожі операції під час вводу. Вимкнення лише приховує їх, нічого не видаляючи."
          }
        }
      }
    },
