    "settings.planning.listLengthHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödənişlər, abunəliklər, gözlənilən gəlirlər və məqsədlər ən yaxından başlayaraq göstərilir, qalanları isə «Hamısını göstər» altında olur. Hər bölmə üçün say onun başlığında ayrıca seçilə bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацяжы, падпіскі, чаканыя даходы і мэты паказваюцца ад найбліжэйшых; астатнія даступныя праз «Паказаць усе». Для кожнага блока можна задаць сваю колькасць у яго загалоўку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platby, předplatná, očekávané příjmy a cíle se zobrazují od nejbližších; ostatní najdete pod «Zobrazit vše». Každý blok může mít vlastní počet nastavený v záhlaví."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen, Abos, erwartete Einnahmen und Ziele zeigen die nächsten zuerst und den Rest hinter „Alle anzeigen“. Ein Block kann seine eigene Zahl in seiner Kopfzeile setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payments, subscriptions, expected incomes and goals show the nearest first and the rest behind «Show all». A block can set its own number in its header."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagos, suscripciones, ingresos previstos y objetivos muestran primero los más cercanos y el resto tras «Mostrar todo». Un bloque puede poner su propio número en su cabecera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements, abonnements, revenus attendus et objectifs montrent d'abord les plus proches, et le reste derrière « Tout afficher ». Un bloc peut régler son propre nombre dans son en-tête."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարումները, բաժանորդագրությունները, սպասվող եկամուտներն ու նպատակները ցուցադրվում են մոտակաից սկսած, իսկ մնացածը՝ «Ցուցադրել բոլորը» կոճակի հետևում։ Յուրաքանչյուր բաժնի համար կարելի է առանձին քանակ սահմանել դրա վերնագրում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamenti, abbonamenti, entrate previste e obiettivi mostrano prima i più vicini; gli altri sono sotto «Mostra tutto». Puoi impostare un numero diverso nell’intestazione di ogni blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い、サブスクリプション、収入予定、目標は日付が近いものから表示し、残りは「すべて表示」の下にまとめます。各リストの表示件数は見出しで変更できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადახდებში, გამოწერებში, მოსალოდნელ შემოსავლებსა და მიზნებში ჯერ უახლოესი ჩანს, დანარჩენი კი — ღილაკით «ყველას ჩვენება». თითოეული ბლოკის სათაურში რაოდენობის შეცვლა შესაძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлемдер, жазылымдар, күтілетін кірістер мен мақсаттар алдымен ең жақынын көрсетеді, қалғаны «Барлығын көрсету» артында. Әр блоктың тақырыбында өз санын қоюға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлөмдөрдүн, жазылуулардын, күтүлгөн кирешелердин жана максаттардын алгач эң жакындары көрсөтүлөт, калгандары «Баарын көрсөтүү» баскычынын артында болот. Ар бир бөлүмдүн санын анын аталышынан өзгөртсө болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij betalingen, abonnementen, verwachte inkomsten en doelen staan de eerstvolgende bovenaan en de rest achter «Toon alles». Elk blok kan een eigen aantal instellen in de kop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatności, subskrypcje, oczekiwane przychody i cele są wyświetlane od najbliższych. Pozostałe znajdziesz pod przyciskiem «Pokaż wszystkie». Liczbę wierszy można zmienić w nagłówku sekcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamentos, assinaturas, receitas previstas e metas mostram os mais próximos primeiro; os demais ficam em «Mostrar Tudo». Cada bloco pode definir sua quantidade no cabeçalho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pagamentos, assinaturas, rendimentos previstos e objetivos mostram primeiro os mais próximos; os restantes ficam em «Mostrar tudo». Pode definir outro número no cabeçalho de cada bloco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежи, подписки, поступления и цели показывают ближайшие, остальные — за «Показать все». Блок может задать своё число в своём заголовке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар пардохтҳо, обунаҳо, даромадҳои интизорӣ ва ҳадафҳо аввал наздиктаринҳо нишон дода мешаванд; боқимонда зери «Намоиши ҳама» ҳастанд. Шумораи ҳар бахшро дар сарлавҳаи он тағйир додан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödemeler, abonelikler, beklenen gelirler ve hedeflerde en yakın olanlar önce gösterilir; kalanı «Tümünü Göster» altında yer alır. Her bölümün sayısı başlığından değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежі, підписки, очікувані доходи й цілі показують найближче, а решту — за «Показати все». Кожен блок може мати власну кількість у заголовку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘lovlar, obunalar, kutilayotgan daromadlar va maqsadlarning avval eng yaqinlari, qolganlari esa «Barchasini ko‘rsatish» orqali ko‘rsatiladi. Har bir bo‘lim sonini sarlavhasida o‘zgartirish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款、订阅、预期收入和目标按最近日期优先显示，其余项目可通过“显示全部”查看。每个区块可在标题中设置自己的行数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款、訂閱、預期收入和目標會先顯示最近的項目，其餘項目可在「顯示全部」中查看。可在各區塊標題中設定顯示數量。"
          }
        }
      }
    },
