    "settings.events.automatic": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv hadisəni yeni əməliyyatlara əlavə et"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадаваць актыўную падзею да новых аперацый"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přiřazovat aktivní událost k novým operacím"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktive Ereignis auf neue Vorgänge setzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the active event on new operations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner el evento activo en las operaciones nuevas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre l'événement actif sur les nouvelles opérations"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ակտիվ իրադարձությունը ավելացնել նոր գործարքներին"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna l’evento attivo alle nuove operazioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規取引に開催中のイベントを設定"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქტიური მოვლენის დამატება ახალ ოპერაციებზე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа операцияларға белсенді оқиғаны қою"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңы операцияларга активдүү окуяны кошуу"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de actieve gebeurtenis toe aan nieuwe transacties"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj aktywne wydarzenie do nowych operacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar o evento ativo em novas operações"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Associar o evento ativo a novas operações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставить активное событие новым операциям"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Илова кардани рӯйдоди фаъол ба амалиёти нав"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni işlemlere etkin etkinliği ekle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставити активну подію на нові операції"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faol tadbirni yangi operatsiyalarga qo‘shish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将进行中的事件添加到新交易"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將進行中的事件套用至新交易"
          }
        }
      }
    },
    "settings.events.automaticHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söndürüldükdə həmin günü əhatə edən hadisə yalnız paneldə təklif olunur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключана: падзея, якая ахоплівае гэты дзень, толькі прапануецца на панэлі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto: událost připadající na daný den se pouze nabídne v panelu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Ein Ereignis, das den Tag umfasst, wird nur im Bedienfeld angeboten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: an event covering the day is only offered in the panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: un evento que cubre el día solo se ofrece en el panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : un événement couvrant le jour n'est proposé que dans le panneau."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անջատված դեպքում այդ օրը ներառող իրադարձությունը միայն առաջարկվում է վահանակում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, un evento che comprende il giorno viene solo proposto nel pannello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、その日に開催中のイベントはパネルでのみ提案されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამორთვისას: იმ დღის მოვლენა მხოლოდ პანელში შემოგთავაზდებათ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өшірулі: осы күнге сәйкес оқиға тек панельде ұсынылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өчүк болсо, ошол күнгө туура келген окуя панелде гана сунушталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit: een gebeurtenis op die dag wordt alleen in het paneel voorgesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy opcja jest wyłączona, wydarzenie obejmujące dany dzień jest tylko proponowane w panelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: um evento que inclui o dia é apenas sugerido no painel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: um evento que abranja o dia é apenas sugerido no painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: событие на эту дату только предлагается в панели."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хомӯш: рӯйдоди марбут ба рӯз танҳо дар панел пешниҳод мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıyken: o günü kapsayan etkinlik yalnızca panelde önerilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вимкнено, подія цього дня лише пропонується на панелі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘chirilgan bo‘lsa: shu kunni qamrab olgan tadbir faqat panelda taklif qilinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，当天涵盖的事件只会在面板中作为建议显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，涵蓋當天的事件只會在面板中顯示為建議。"
          }
        }
      }
    },
    "settings.forWhom.fixedHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu beş seçim sabitdir, yalnız adlarını dəyişmək olar. Öz seçiminizi əlavə etmək üçün aşağıda şəxs əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты набор складаецца з пяці пунктаў, змяніць можна толькі іх назвы. Каб дадаць свой варыянт, дадайце чалавека ніжэй."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Těchto pět možností tvoří úplnou sadu a lze měnit jen jejich názvy. Chcete-li přidat vlastní možnost, přidejte níže osobu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese fünf sind die ganze Auswahl, und nur ihre Bezeichnungen können sich ändern. Um eigene hinzuzufügen, legen Sie unten eine Person an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These five are the whole set, and only their captions can change. To add your own, add a person below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cinco son el conjunto completo, y solo pueden cambiar sus rótulos. Para añadir las suyas, añada una persona abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces cinq-là forment l'ensemble complet, et seules leurs légendes peuvent changer. Pour en ajouter, ajoutez une personne ci-dessous."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավաքածուն բաղկացած է այս հինգից, և փոխել կարելի է միայն դրանց անվանումները։ Ձեր տարբերակն ավելացնելու համար ստորև ավելացրեք մարդ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste cinque voci sono fisse e puoi cambiarne solo le etichette. Per aggiungerne una tua, aggiungi una persona qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この5項目は固定されており、表示名のみ変更できます。独自の項目を追加するには、以下で人を追加してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ხუთეული ფიქსირებულია და მხოლოდ მათი სახელების შეცვლაა შესაძლებელი. საკუთარის დასამატებლად ქვემოთ დაამატეთ ადამიანი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жиын осы бес нұсқадан тұрады, тек атауларын өзгертуге болады. Өз нұсқаңызды қосу үшін төменде адам қосыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул бешөө — толук топтом, алардын аталыштарын гана өзгөртүүгө болот. Өз вариантыңызды кошуу үчүн төмөнгө адам кошуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn de vijf vaste opties. Alleen de namen kunnen worden gewijzigd. Voeg hieronder een persoon toe voor een eigen optie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To pełny zestaw pięciu opcji. Można zmienić tylko ich nazwy. Aby dodać własną, dodaj osobę poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são as cinco opções disponíveis, e só os nomes podem ser alterados. Para adicionar outra opção, adicione uma pessoa abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são as cinco opções disponíveis e só os respetivos nomes podem ser alterados. Para adicionar uma opção, adicione uma pessoa abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этих пяти значений столько и есть, меняются только их подписи. Чтобы добавить своё — заведите человека ниже."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маҷмуа аз ҳамин панҷто иборат аст ва танҳо номҳои онҳоро тағйир додан мумкин аст. Барои илова кардани номи худ, дар поён шахсеро илова кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu beş seçenek sabittir; yalnızca adları değiştirilebilir. Kendi seçeneğinizi eklemek için aşağıya bir kişi ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці п'ять — увесь набір, можна змінити лише підписи. Щоб додати власний варіант, додайте людину нижче."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘plam shu beshtadan iborat, faqat ularning nomlarini o‘zgartirish mumkin. O‘zingiznikini qo‘shish uchun pastga odam qo‘shing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定选项只有这五个，只能更改名称。如需添加其他选项，请在下方添加人员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這五個選項為固定項目，只能更改名稱。如要新增選項，請在下方加入人員。"
          }
        }
      }
    },
