    "settings.numbers.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змяняецца толькі адлюстраванне на экране. У файлах CSV і архіве пераносу заўсёды выкарыстоўваецца кропка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur was Sie auf dem Bildschirm lesen, ändert sich. CSV-Dateien und das Übertragungsarchiv nutzen immer einen Punkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what you read on screen changes. CSV files and the transfer archive always use a point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo lo que se lee en pantalla. Los archivos CSV y el archivo de traslado siempre usan el punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul ce que vous lisez à l'écran change. Les fichiers CSV et l'archive de transfert utilisent toujours un point."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo ciò che vedi sullo schermo. I file CSV e l’archivio di trasferimento usano sempre il punto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек экрандағы көрініс өзгереді. CSV файлдары мен тасымалдау мұрағаты әрдайым нүктені қолданады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia się tylko sposób wyświetlania na ekranie. Pliki CSV i archiwum transferowe zawsze używają kropki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o que você vê na tela muda. Os arquivos CSV e o arquivo de transferência sempre usam ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняется только то, что вы читаете на экране. Файлы CSV и архив переноса всегда пишутся с точкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
