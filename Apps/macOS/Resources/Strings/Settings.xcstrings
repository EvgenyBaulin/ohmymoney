        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівняти з архівом…"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxiv bilan solishtirish…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与归档比较…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與封存檔比較…"
          }
        }
      }
    },
    "backups.compareArchive.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Köçürmə arxivini açın və onun cari verilənlər bazasından fərqinə baxın. Heç birinə dəyişiklik yazılmır; parollu arxiv üçün əvvəlcə parol tələb olunur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрыйце архіў для пераносу і паглядзіце, чым ён адрозніваецца ад бягучай базы даных. Нічога не будзе запісана; калі архіў абаронены паролем, спачатку спатрэбіцца ўвесці яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete archiv pro přenos a podívejte se, jak se liší od současné databáze. Do žádného z nich se nic nezapíše; u archivu s heslem budete nejprve požádáni o jeho zadání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie ein Archiv der Übertragung und sehen Sie, wie es sich von der jetzigen Datenbank unterscheidet. In keines wird geschrieben; ein Archiv mit Passwort fragt zuerst danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an archive of the transfer and see how it differs from the database now. Nothing is written to either; an archive with a password asks for it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra un archivo de traslado y vea en qué se diferencia de la base de datos de ahora. No se escribe nada en ninguno de los dos; un archivo con contraseña la pide antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une archive de transfert et voyez en quoi elle diffère de la base actuelle. Rien n'est écrit dans l'un ni dans l'autre ; une archive protégée par mot de passe le demande d'abord."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացեք փոխանցման արխիվը և տեսեք, թե այն ինչով է տարբերվում ընթացիկ տվյալների բազայից։ Դրանցից ոչ մեկում փոփոխություններ չեն պահպանվի։ Գաղտնաբառով արխիվի համար նախ կպահանջվի գաղտնաբառը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un archivio di trasferimento per confrontarlo con il database attuale. Nessuno dei due verrà modificato; se l’archivio è protetto, ti verrà chiesta la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移行用のアーカイブを開き、現在のデータベースとの差を確認します。どちらにも変更は書き込まれません。パスワード付きのアーカイブでは、先にパスワードを入力します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გახსენით გადატანის არქივი და ნახეთ, რით განსხვავდება ის მიმდინარე მონაცემთა ბაზისგან. არც ერთში არაფერი ჩაიწერება; პაროლით დაცული არქივი ჯერ პაროლს მოითხოვს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аударым мұрағатын ашып, оның қазіргі дерекқордан қалай өзгеше екенін көріңіз. Ешқайсысына ештеңе жазылмайды; құписөзі бар мұрағат алдымен құписөзді сұрайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөрүү архивин ачып, анын учурдагы базадан айырмасын көрүңүз. Экөөнө тең өзгөртүү жазылбайт; сырсөздүү архив үчүн адегенде сырсөз суралат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een overdrachtsarchief en bekijk de verschillen met de huidige database. Geen van beide wordt gewijzigd. Voor een beveiligd archief wordt eerst om het wachtwoord gevraagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz archiwum transferu, aby porównać je z bieżącą bazą danych. Żadne dane nie zostaną zapisane. Jeśli archiwum jest chronione hasłem, najpierw musisz je podać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo de transferência para ver as diferenças em relação ao banco de dados atual. Nenhum dos dois será alterado. Se o arquivo tiver senha, ela será solicitada primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um arquivo de transferência para ver as diferenças em relação à base de dados atual. Nenhum dos dois será alterado; se o arquivo tiver uma palavra-passe, terá de a introduzir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте архив переноса и посмотрите, чем он отличается от базы сейчас. Ни в базу, ни в архив ничего не пишется; архив с паролем сначала спросит его."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бойгонии интиқолро кушоед ва фарқи онро аз пойгоҳи додаҳои ҷорӣ бинед. Ба ҳеҷ яке тағйирот сабт намешавад; барои бойгонии паролдошта аввал парол дархост мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarım için oluşturulmuş bir arşivi açın ve mevcut veritabanından farklarını görün. İkisinde de değişiklik yapılmaz; arşiv parolalıysa önce parola istenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте архів перенесення й перегляньте відмінності від поточної бази. Нічого не записується в жоден із них; для архіву з паролем спочатку потрібно ввести пароль."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘chirish arxivini ochib, uni joriy ma’lumotlar bazasi bilan solishtiring. Hech biriga o‘zgartirish kiritilmaydi; parolli arxiv uchun avval parol so‘raladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开用于转移的归档，查看它与当前数据库的差异。两者都不会被写入；受密码保护的归档会先要求输入密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟移轉用封存檔，查看它與目前資料庫的差異。兩者都不會被修改；若封存檔有密碼，會先要求輸入密碼。"
          }
        }
      }
    },
