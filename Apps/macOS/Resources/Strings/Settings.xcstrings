    "settings.planning.reserve": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylıq məqsəd planlarını «Xərcləmək üçün sərbəst» məbləğindən ayır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэзерваваць месячныя планы па мэтах у суме «Можна выдаткаваць»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odložit měsíční příspěvky na cíle z částky «K útratě»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die monatlichen Zielpläne in „Frei verfügbar“ zurückhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep back the monthly goal plans in «Free to spend»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descontar en «Libre para gastar» los planes mensuales de objetivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenir les plans mensuels d'objectifs dans « Libre à dépenser »"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահուստավորել նպատակների ամսական պլանները «Ազատ ծախսելու» գումարում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accantona i versamenti mensili agli obiettivi da «Disponibile da spendere»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月々の目標積立予定を「使えるお金」から差し引く"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიზნების თვიური გეგმებისთვის თანხის გადანახვა «თავისუფლად დასახარჯი თანხიდან»"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлық мақсат жоспарларын «Жұмсауға бос» сомасынан алып тастау"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сарптоого жеткиликтүү» суммасынан айлык максаттардын планын кармап калуу"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserveer maandelijkse doelbedragen in «Vrij te besteden»"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwzględniaj miesięczne plany wpłat na cele w kwocie «Do wydania»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservar os aportes mensais às metas em «Livre para gastar»"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservar os planos mensais dos objetivos em «Disponível para gastar»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервировать плановые взносы на цели в «Свободной сумме»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нақшаҳои моҳонаи ҳадафҳоро дар «Барои харҷ дастрас» ҷудо кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık hedef planlarını «Harcanabilir» tutarından ayır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервувати місячні плани цілей у «Можна витрачати»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylik maqsad rejalarini «Sarflash mumkin» summasidan ajratish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“可支配金额”中预留每月目标计划金额"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「可支出」中預留每月目標存款"
          }
        }
      }
    },
