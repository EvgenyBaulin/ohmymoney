    "settings.planning.listLengthHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payments, subscriptions, expected incomes and goals show the nearest first and the rest behind «Show all». A block can set its own number in its header."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagos, suscripciones, ingresos previstos y objetivos muestran primero los más cercanos y el resto tras «Mostrar todo». Un bloque puede poner su propio número en su cabecera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежи, подписки, поступления и цели показывают ближайшие, остальные — за «Показать все». Блок может задать своё число в своём заголовке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
