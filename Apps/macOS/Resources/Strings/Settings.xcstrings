    "settings.starter.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадае катэгорыі, прыклады лімітаў і пліткі агляду паводле вашага ладу жыцця. Толькі дадае; ⌘Z адмяняе змены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänzt Kategorien, Beispiel-Limits und Kacheln der Übersicht für Ihre Lebensweise. Ergänzt nur; ⌘Z nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds categories, example limits and Overview tiles for the way you live. Only adds; ⌘Z takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade categorías, límites de ejemplo y mosaicos del Resumen según su forma de vida. Solo añade; ⌘Z lo deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des catégories, des exemples de plafonds et des tuiles de l'Aperçu selon votre mode de vie. Seulement ajouter ; ⌘Z le reprend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge categorie, esempi di limiti e riquadri alla Panoramica in base al tuo stile di vita. Aggiunge soltanto; usa ⌘Z per annullare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өмір салтыңызға сай санаттар, лимит мысалдары мен Шолу плиткаларын қосады. Тек қосады; ⌘Z кері қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje kategorie, przykładowe limity i kafelki Przeglądu dopasowane do Twojego stylu życia. Tylko dodaje; ⌘Z cofa zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona categorias, exemplos de limites e cartões à Visão Geral para o seu estilo de vida. Apenas adiciona; ⌘Z desfaz a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет категории, примеры лимитов и плитки «Обзора» под ваш образ жизни. Только добавляет; ⌘Z отменяет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşam biçiminize uygun kategoriler, örnek limitler ve Genel Bakış kartları ekler. Yalnızca ekleme yapar; ⌘Z ile geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає категорії, приклади лімітів і плитки огляду під ваш спосіб життя. Лише додає; ⌘Z скасовує дію."
          }
        }
      }
    },
    "settings.starter.hint.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадае катэгорыі, прыклады лімітаў і пліткі агляду паводле вашага ладу жыцця. Толькі дадае; «Адмяніць» адмяняе змены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänzt Kategorien, Beispiel-Limits und Kacheln der Übersicht für Ihre Lebensweise. Ergänzt nur; „Rückgängig“ nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds categories, example limits and Overview tiles for the way you live. Only adds; “Undo” takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade categorías, límites de ejemplo y mosaicos del Resumen según su forma de vida. Solo añade; «Deshacer» lo deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des catégories, des exemples de plafonds et des tuiles de l'Aperçu selon votre mode de vie. Seulement ajouter ; « Annuler » le reprend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge categorie, esempi di limiti e riquadri alla Panoramica in base al tuo stile di vita. Aggiunge soltanto; usa “Annulla” per annullare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өмір салтыңызға сай санаттар, лимит мысалдары мен Шолу плиткаларын қосады. Тек қосады; “Болдырмау” кері қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje kategorie, przykładowe limity i kafelki Przeglądu dopasowane do Twojego stylu życia. Tylko dodaje; „Cofnij” cofa zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona categorias, exemplos de limites e cartões à Visão Geral para o seu estilo de vida. Apenas adiciona; “Desfazer” reverte a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет категории, примеры лимитов и плитки «Обзора» под ваш образ жизни. Только добавляет; «Отменить» отменяет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşam biçiminize uygun kategoriler, örnek limitler ve Genel Bakış kartları ekler. Yalnızca ekleme yapar; “Geri Al” ile geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає категорії, приклади лімітів і плитки огляду під ваш спосіб життя. Лише додає; «Скасувати дію» повертає попередній стан."
          }
        }
      }
    },
