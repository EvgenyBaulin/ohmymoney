    "categories.appearance.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A category without a symbol shows the mark of its kind in the list of operations; a subcategory follows its category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoría sin símbolo muestra la marca de su tipo en la lista de operaciones; una subcategoría sigue a su categoría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une catégorie sans symbole affiche le repère de son type dans la liste des opérations ; une sous-catégorie suit sa catégorie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория без значка показывает в «Операциях» значок вида операции; подкатегория берёт значок категории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія без значка показує позначку свого виду в списку операцій; підкатегорія успадковує значок категорії."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгісі жоқ санат операциялар тізімінде өз түрінің таңбасын көрсетеді; ішкі санат өз санатына ілеседі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kategorie ohne Symbol zeigt in der Liste der Vorgänge das Zeichen ihrer Art; eine Unterkategorie folgt ihrer Kategorie."
