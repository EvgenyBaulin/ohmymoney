        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report could not be saved there. Choose another folder and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el informe allí. Elija otra carpeta e inténtelo de nuevo."
