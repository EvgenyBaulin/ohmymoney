    "categories.add.parentRefused": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kateqoriya yalnız eyni növlü və arxivdə olmayan kateqoriyaya əlavə edilə bilər. Üst kateqoriyanı yenidən seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыю можна змясціць толькі ў неархіўную катэгорыю таго ж тыпу. Выберыце бацькоўскую катэгорыю яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorii lze zařadit pouze pod nearchivovanou kategorii stejného typu. Vyberte nadřazenou kategorii znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kategorie gehört nur unter eine Kategorie derselben Art, die nicht im Archiv ist. Wählen Sie die übergeordnete Kategorie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A category goes only under a category of the same kind that is not in the archive. Choose the parent again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoría solo va bajo una categoría del mismo tipo que no esté en el archivo. Elija de nuevo la categoría padre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une catégorie ne se place que sous une catégorie du même type qui n'est pas aux archives. Choisissez à nouveau la catégorie parente."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կատեգորիան կարելի է ավելացնել միայն նույն տեսակի՝ չարխիվացված կատեգորիայի տակ։ Կրկին ընտրեք վերադաս կատեգորիան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoria può essere inserita solo in una categoria dello stesso tipo non archiviata. Scegli di nuovo la categoria principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "親にできるのは、同じ種類でアーカイブされていないカテゴリのみです。親カテゴリを選び直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორია მხოლოდ იმავე ტიპის, არაარქივებულ კატეგორიაში შეიძლება მოთავსდეს. ხელახლა აირჩიეთ მთავარი კატეგორია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санат тек мұрағатта емес, сол түрдегі санаттың астына қосылады. Негізгісін қайта таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияны архивде жок, ошол эле түрдөгү категорияга гана кошууга болот. Негизги категорияны кайра тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een categorie kan alleen worden geplaatst onder een niet-gearchiveerde categorie van dezelfde soort. Kies opnieuw een bovenliggende categorie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria nadrzędna musi być tego samego rodzaju i nie może znajdować się w archiwum. Wybierz ją ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma categoria só pode ficar dentro de outra do mesmo tipo que não esteja arquivada. Escolha a categoria superior novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma categoria só pode estar dentro de outra do mesmo tipo que não esteja arquivada. Escolha novamente a categoria principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорию можно положить только в категорию того же вида, которая не в архиве. Выберите родителя ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияро танҳо зери категорияи ҳамон навъ, ки дар бойгонӣ нест, ҷойгир кардан мумкин аст. Категорияи асосиро аз нав интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kategori yalnızca aynı türde ve arşivde olmayan bir kategorinin altına eklenebilir. Üst kategoriyi yeniden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорію можна додати лише до неархівної категорії того самого виду. Виберіть батьківську категорію знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Turkumni faqat o‘zi bilan bir xil turdagi, arxivlanmagan turkumga joylash mumkin. Asosiy turkumni qayta tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能将类别放在同类型且未归档的类别下。请重新选择上级类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "類別只能歸在相同類型且未封存的類別下。請重新選擇上層類別。"
          }
        }
      }
    },
