    "report.offer.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application was stopped or it crashed. A problem report will say what happened: it holds the journal, versions and counts — never amounts, names or descriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación se detuvo o se cayó. Un informe del problema dirá qué pasó: contiene el diario, versiones y recuentos — nunca importes, nombres ni descripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a été arrêtée ou elle a planté. Un rapport de problème dira ce qui s'est passé : il contient le journal, les versions et des compteurs — jamais de montants, de noms ni de descriptions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение остановили или оно упало. Отчёт о проблеме покажет, что случилось: в нём журнал, версии и количества — и никогда суммы, имена или описания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок зупинено або стався збій. Звіт про проблему пояснить, що сталося: він містить журнал, версії й лічильники — без сум, імен та описів."
          }
        }
      }
    },
