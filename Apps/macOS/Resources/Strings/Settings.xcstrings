    "categories.tax.otherHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məsələn, ödənişlərsiz sadələşdirilmiş 6% və ya 13% gəlir vergisi: verginin təxmini məbləği çıxılma tətbiq edilmədən və kiçik məbləğlər köçürülmədən kənara qoyulur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Напрыклад, спрошчаная стаўка 6% без узносаў або падаходны падатак 13%: прыблізная сума падатку адкладваецца без выліку і без перамяшчэння дробных сум."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Například zjednodušená sazba 6 % bez odvodů nebo daň z příjmu 13 %: přibližná daň se odloží stranou, bez odpočtu a bez převodu malých částek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel die vereinfachten 6 % ohne Beiträge oder Einkommensteuer von 13 %: Die Steuer ≈ wird beiseitegelegt, ohne Abzug und ohne kleine Beträge zu verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example the simplified 6% without contributions or income tax of 13%: the tax ≈ is put aside, without the deduction and without moving small sums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo el 6 % simplificado sin aportaciones o el impuesto sobre la renta del 13 %: el impuesto ≈ se aparta, sin deducción y sin mover sumas pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple le 6 % simplifié sans cotisations, ou l'impôt sur le revenu de 13 % : l'impôt ≈ est mis de côté, sans déduction et sans transférer les petites sommes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օրինակ՝ պարզեցված 6%՝ առանց վճարների, կամ 13% եկամտահարկ․ հարկը ≈ մի կողմ է դրվում՝ առանց նվազեցման և փոքր գումարների փոխանցման։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad esempio, il 6% semplificato senza contributi o l'imposta sul reddito del 13%: l'imposta ≈ viene accantonata, senza detrazione e senza spostare piccole somme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たとえば、拠出金を除く簡易課税の6%や所得税の13%です。控除や少額の移動をせず、おおよその税額を取り分けます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაგალითად, გამარტივებული 6% შენატანების გარეშე ან საშემოსავლო გადასახადი 13%: გადასახადი ≈ გადაიდება გამოქვითვისა და მცირე თანხების გადატანის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мысалы, жарналарсыз жеңілдетілген 6% немесе 13% табыс салығы: салық ≈ бөліп қойылады, шегерімсіз және майда сомаларды аудармай."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мисалы, төгүмдөрсүз жөнөкөйлөштүрүлгөн 6% же 13% киреше салыгы: болжолдуу салыктык чегерүүсүз жана майда суммаларды которбостон бөлүнөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijvoorbeeld het vereenvoudigde tarief van 6% zonder premies of 13% inkomstenbelasting: de geschatte belasting wordt apart gezet, zonder aftrek en zonder kleine bedragen over te boeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na przykład podatek uproszczony 6% bez składek lub podatek dochodowy 13%: odkładana jest przybliżona kwota podatku, bez odliczenia i bez przenoszenia drobnych kwot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo, a alíquota simplificada de 6% sem contribuições ou o imposto de renda de 13%: o valor aproximado do imposto é reservado, sem dedução e sem mover pequenas quantias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo, a taxa simplificada de 6% sem contribuições ou o imposto sobre o rendimento de 13%: o imposto é reservado aproximadamente, sem dedução nem transferência de pequenos montantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например, УСН 6 % без взносов или НДФЛ 13 %: налог ≈ откладывается, без вычета и без переноса малых сумм."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Масалан, 6%-и низоми содакардашуда бе пардохтҳо ё 13% андоз аз даромад: андози тахминӣ ҷудо карда мешавад, бе тарҳ ва бе интиқоли маблағҳои хурд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örneğin primler hariç basitleştirilmiş %6 veya %13 gelir vergisi: Yaklaşık vergi tutarı, indirim uygulanmadan ve küçük tutarlar aktarılmadan ayrılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наприклад, спрощена система 6% без внесків або податок на доходи 13%: податок ≈ відкладається без відрахування та перенесення малих сум."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Masalan, badallarsiz 6% soddalashtirilgan soliq yoki 13% daromad solig‘i: soliqning taxminiy summasi chegirmasiz va kichik summalarni o‘tkazmasdan ajratiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如不含缴款的 6% 简化税率或 13% 所得税：将预留约等于税款的金额，不计扣除，也不转移小额款项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如不含繳款的簡化稅率 6% 或所得稅率 13%：會預留約略稅額，不計扣除額，也不轉移小額款項。"
          }
        }
      }
    },
