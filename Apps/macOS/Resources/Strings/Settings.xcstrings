        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A categoria não foi apagada porque ainda está em uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория не удалена: на неё что-то ещё ссылается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori silinmedi: Hâlâ ona bağlı veriler var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорію не видалено: на неї ще є посилання."
          }
        }
      }
    },
    "categories.delete.failedAfterMove": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі перамешчаны, але катэгорыя не выдалена: на яе яшчэ ёсць спасылкі. ⌘Z адменіць перамяшчэнне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorgänge sind verschoben, aber die Kategorie wurde nicht gelöscht: Noch etwas verweist auf sie. ⌘Z nimmt die Verschiebung zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations have moved, but the category was not deleted: something still points at it. ⌘Z takes the move back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones se movieron, pero la categoría no se eliminó: algo todavía apunta a ella. ⌘Z deshace el traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations ont été déplacées, mais la catégorie n'a pas été supprimée : quelque chose y fait encore référence. ⌘Z reprend le déplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni sono state spostate, ma la categoria non è stata eliminata perché è ancora in uso. Premi ⌘Z per annullare lo spostamento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар көшті, бірақ санат жойылмады: оған әлі бір нәрсе сілтейді. ⌘Z көшуді қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje zostały przeniesione, ale nie usunięto kategorii, ponieważ nadal jest używana. Naciśnij ⌘Z, aby cofnąć przeniesienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações foram movidas, mas a categoria não foi apagada porque ainda está em uso. Pressione ⌘Z para desfazer a movimentação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции перенесены, а категория не удалена: на неё ещё что-то ссылается. ⌘Z вернёт их обратно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler taşındı ancak kategori silinmedi: Hâlâ ona bağlı veriler var. Taşımayı ⌘Z ile geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції перенесено, але категорію не видалено: на неї ще є посилання. ⌘Z скасовує перенесення."
          }
        }
      }
    },
