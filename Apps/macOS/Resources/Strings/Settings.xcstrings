            "state": "translated",
            "value": "El Banco de Rusia no publica todas las divisas activadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Banque de Russie ne publie pas toutes les devises activées"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ռուսաստանի բանկը չի հրապարակում բոլոր միացված արժույթների փոխարժեքները"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Banca di Russia non pubblica tutte le valute attive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な通貨の一部はロシア銀行で公表されていません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რუსეთის ბანკი ყველა ჩართული ვალუტის კურსს არ აქვეყნებს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресей Банкі қосылған әр валютаны жарияламайды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Россия Банкы бардык иштетилген валюталардын курсун жарыялабайт"
          }
        },
        "nl": {
