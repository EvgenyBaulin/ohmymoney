    "settings.entry.keyboardHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab indi yalnız mətn sahələri arasında keçir. Menyularda da dayanması üçün Sistem Ayarları → Klaviatura bölməsində “Klaviatura ilə naviqasiya”nı aktiv edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Цяпер Tab перамяшчае фокус толькі паміж тэкставымі палямі. Каб пераходзіць і да меню, уключыце “Навігацыя з клавіятуры” ў Сістэмныя налады → Клавіятура."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabulátor nyní přepíná jen mezi textovými poli. Chcete-li přecházet i na nabídky, zapněte „Navigaci klávesnicí“ v Nastavení systému → Klávesnice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab wechselt jetzt nur zwischen Textfeldern. Damit es auch bei den Menüs hält, schalten Sie „Tastaturnavigation“ in den Systemeinstellungen unter Tastatur ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab now moves between text fields only. To have it stop at the menus as well, turn on “Keyboard navigation” in System Settings → Keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab ahora solo se mueve entre campos de texto. Para que también se detenga en los menús, active «Navegación con teclado» en Ajustes del Sistema → Teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab ne passe désormais qu'entre les champs de texte. Pour qu'il s'arrête aussi sur les menus, activez « Navigation au clavier » dans Réglages du système → Clavier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab-ն այժմ անցնում է միայն տեքստային դաշտերով։ Որպեսզի այն կանգ առնի նաև ընտրացանկերի վրա, միացրեք “Keyboard navigation”-ը System Settings → Keyboard բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasto Tab si sposta solo tra i campi di testo. Per includere anche i menu, attiva “Navigazione tramite tastiera” in Impostazioni di Sistema → Tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、Tabキーではテキストフィールド間のみを移動します。メニューにも移動するには、「システム設定」→「キーボード」で「キーボードナビゲーション」をオンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab ახლა მხოლოდ ტექსტურ ველებს შორის გადადის. მენიუებზეც გადასასვლელად ჩართეთ “კლავიატურით ნავიგაცია” აქ: სისტემის პარამეტრები → კლავიატურა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір Tab тек мәтін өрістері арасында ауысады. Мәзірлерге де тоқтау үшін Жүйелік баптаулар → Пернетақта ішіндегі “Пернетақтамен шарлау” параметрін қосыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab азыр текст талааларынын ортосунда гана жылат. Менюларга да өтүү үчүн Системалык жөндөөлөр → Баскычтоп бөлүмүндө “Баскычтоп менен навигацияны” күйгүзүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met Tab ga je nu alleen tussen tekstvelden. Schakel ‘Toetsenbordnavigatie’ in via Systeeminstellingen → Toetsenbord om ook menu's te selecteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabulator przenosi teraz tylko między polami tekstowymi. Aby zatrzymywał się także na menu, włącz „Nawigację klawiaturą” w Ustawieniach systemowych → Klawiatura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tecla Tab agora alterna apenas entre campos de texto. Para incluir os menus, ative “Navegação por teclado” em Ajustes do Sistema → Teclado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tecla Tab passa agora apenas entre campos de texto. Para passar também pelos menus, ative “Navegação por teclado” em Definições do Sistema → Teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас Tab переходит только между полями ввода. Чтобы он останавливался и на списках, включите «Навигация с клавиатуры» в Системных настройках → Клавиатура."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло Tab танҳо байни майдонҳои матн мегузарад. Барои гузаштан ба менюҳо низ, дар Танзимоти система → Клавиатура “Паймоиш бо клавиатура”-ро фаъол кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab artık yalnızca metin alanları arasında geçiş yapar. Menülerde de durması için Sistem Ayarları → Klavye bölümünde “Klavye ile gezinme”yi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз Tab переходить лише між текстовими полями. Щоб переходити також до меню, увімкніть «Навігацію клавіатурою» в «Системні параметри → Клавіатура»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab endi faqat matn maydonlari orasida o‘tadi. Menyularda ham to‘xtashi uchun Tizim sozlamalari → Klaviatura bo‘limida “Klaviatura navigatsiyasi”ni yoqing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab 键目前仅在文本栏之间移动。如需同时选中菜单，请在“系统设置”→“键盘”中打开“键盘导航”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab 鍵目前只會在文字欄位之間切換。若要在選單處停留，請前往「系統設定」→「鍵盤」，開啟「鍵盤導覽」。"
          }
        }
      }
    },
