        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona archiviata non viene più proposta durante l’inserimento delle operazioni o negli elenchi; resta nelle sue operazioni, in Analisi e nei resoconti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағатталған адам операция енгізгенде және тізімдерде ұсынылмайды; оның операцияларында, Талдауда және Есептерде сақталады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowana osoba nie jest już proponowana przy wprowadzaniu operacji ani na listach. Pozostaje w swoich operacjach, analizach i raportach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa arquivada deixa de aparecer ao registrar operações e nas listas; ela permanece nas operações, Análises e Relatórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человек в архиве не предлагается при вводе и в списках, а его операции, «Аналитика» и «Отчёты» его сохраняют."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenen kişi, işlem girerken ve listelerde artık gösterilmez; işlemleri, analizlerde ve raporlarda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Архівна людина більше не пропонується під час вводу та в списках; її операції, аналітика й звіти зберігають її."
          }
        }
