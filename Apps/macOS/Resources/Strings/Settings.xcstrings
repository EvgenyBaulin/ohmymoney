          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones van de camino a la nueva categoría. Cuando eso se escriba, elimínela de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations sont en route vers la nouvelle catégorie. Quand cela sera écrit, supprimez-la à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni sono in fase di spostamento nella nuova categoria. Al termine, elimina di nuovo la categoria."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар жаңа санатқа жолда. Ол жазылғаннан кейін, оны қайтадан жойыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa przenoszenie operacji do nowej kategorii. Po zapisaniu spróbuj ponownie usunąć kategorię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações estão sendo movidas para a nova categoria. Quando a alteração for salva, apague a categoria novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции переезжают в новую категорию. Как допишутся — удалите её ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler yeni kategoriye taşınıyor. İşlem kaydedildiğinde kategoriyi yeniden silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції переносяться до нової категорії. Після запису видаліть категорію знову."
          }
        }
      }
    },
    "categories.delete.notReady": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даныя яшчэ счытваюцца — пакуль нічога нельга падлічыць. Пачакайце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten werden noch gelesen — es lässt sich noch nichts zählen. Einen Moment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data is still being read — nothing can be counted yet. A moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos todavía se están leyendo — todavía no se puede contar nada. Un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sont encore en cours de lecture — rien ne peut encore être compté. Un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettura dei dati in corso: non è ancora possibile contarli. Attendi un momento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер әлі оқылып жатыр — әлі ештеңе санауға болмайды. Сәл күтіңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa odczytywanie danych. Nie można jeszcze nic zliczyć. Poczekaj chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados ainda estão sendo lidos. Aguarde um momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные ещё читаются — посчитать пока нечего. Секунду."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler hâlâ okunuyor; henüz sayım yapılamıyor. Biraz bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані ще читаються — обчислення поки неможливе. Зачекайте мить."
          }
        }
      }
    },
