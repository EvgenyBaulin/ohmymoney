        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo está danificado ou não é um arquivo do OhMyMoney"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл повреждён или это не архив OhMyMoney"
