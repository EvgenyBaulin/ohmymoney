    "categories.delete.moving": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyatlar yeni kateqoriyaya köçürülür. Köçürmə yadda saxlandıqdan sonra yenidən silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі перамяшчаюцца ў новую катэгорыю. Пасля захавання выдаліце катэгорыю яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace se přesouvají do nové kategorie. Po uložení kategorii smažte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorgänge sind auf dem Weg in die neue Kategorie. Wenn das geschrieben ist, löschen Sie sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations are on their way to the new category. When that is written, delete it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones van de camino a la nueva categoría. Cuando eso se escriba, elimínela de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations sont en route vers la nouvelle catégorie. Quand cela sera écrit, supprimez-la à nouveau."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարքները տեղափոխվում են նոր կատեգորիա։ Ավարտից հետո կրկին ջնջեք կատեգորիան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni sono in fase di spostamento nella nuova categoria. Al termine, elimina di nuovo la categoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引を新しいカテゴリに移動中です。保存が完了したら、もう一度削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაციები ახალ კატეგორიაში გადადის. შენახვის დასრულების შემდეგ ხელახლა წაშალეთ კატეგორია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар жаңа санатқа жолда. Ол жазылғаннан кейін, оны қайтадан жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар жаңы категорияга жылдырылып жатат. Сакталгандан кийин категорияны кайра өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transacties worden verplaatst naar de nieuwe categorie. Verwijder de categorie opnieuw zodra dit is opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa przenoszenie operacji do nowej kategorii. Po zapisaniu spróbuj ponownie usunąć kategorię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações estão sendo movidas para a nova categoria. Quando a alteração for salva, apague a categoria novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações estão a ser movidas para a nova categoria. Quando terminar, volte a apagá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции переезжают в новую категорию. Как допишутся — удалите её ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиётҳо ба категорияи нав кӯчонда мешаванд. Пас аз сабт, категорияро аз нав нест кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler yeni kategoriye taşınıyor. İşlem kaydedildiğinde kategoriyi yeniden silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції переносяться до нової категорії. Після запису видаліть категорію знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiyalar yangi turkumga ko‘chirilmoqda. Saqlangach, turkumni qayta o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在将交易移至新类别。存储完成后，请再次删除该类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易正在移至新類別。儲存完成後，請再次刪除此類別。"
          }
        }
      }
    },
    "categories.delete.notReady": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlar hələ oxunur — saymaq mümkün deyil. Bir az gözləyin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даныя яшчэ счытваюцца — пакуль нічога нельга падлічыць. Пачакайце."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data se ještě načítají, zatím nelze nic spočítat. Chvíli počkejte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten werden noch gelesen — es lässt sich noch nichts zählen. Einen Moment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data is still being read — nothing can be counted yet. A moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos todavía se están leyendo — todavía no se puede contar nada. Un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sont encore en cours de lecture — rien ne peut encore être compté. Un instant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալները դեռ ընթերցվում են․ հաշվարկը դեռ հնարավոր չէ։ Սպասեք մի պահ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettura dei dati in corso: non è ancora possibile contarli. Attendi un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを読み込み中のため、まだ件数を確認できません。しばらくお待ちください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემების წაკითხვა ჯერ არ დასრულებულა — დათვლა ჯერ შეუძლებელია. მოიცადეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер әлі оқылып жатыр — әлі ештеңе санауға болмайды. Сәл күтіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат дагы эле окулууда — азырынча эсептөө мүмкүн эмес. Бир аз күтө туруңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens worden nog geladen. Er kan nog niets worden geteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa odczytywanie danych. Nie można jeszcze nic zliczyć. Poczekaj chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados ainda estão sendo lidos. Aguarde um momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados ainda estão a ser lidos e não é possível contá-los. Aguarde um momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные ещё читаются — посчитать пока нечего. Секунду."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумот ҳоло хонда мешавад — ҳисоб кардан ҳанӯз имкон надорад. Каме интизор шавед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler hâlâ okunuyor; henüz sayım yapılamıyor. Biraz bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані ще читаються — обчислення поки неможливе. Зачекайте мить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar hali yuklanmoqda — hozircha sanab bo‘lmaydi. Biroz kuting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取数据，暂时无法统计。请稍候。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料仍在讀取中，暫時無法計算。請稍候。"
          }
        }
      }
    },
