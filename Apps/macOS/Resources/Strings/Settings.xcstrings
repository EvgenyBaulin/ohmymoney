    "settings.updates.automaticHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day the app looks for a new version, downloads it in the background and installs it on quit. Off: an update comes only through “Check for Updates…”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день приложение ищет новую версию, скачивает её в фоне и ставит при выходе. Выключено: обновление придёт только по «Проверить обновления…»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на день застосунок шукає нову версію, завантажує її у фоні й установлює під час виходу. Якщо вимкнено, оновлення доступні лише через «Перевірити оновлення…»."
          }
        }
      }
    },
    "settings.updates.unavailableHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not look for updates: it carries no key to check the signature of an update with."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка не ищет обновлений: в ней нет ключа, которым проверяется подпись обновления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збірка не шукає оновлень: у ній немає ключа для перевірки підпису оновлення."
          }
        }
      }
    },
