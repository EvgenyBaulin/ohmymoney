    "currencies.directory.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назвы і краіны бяруцца з даведніка валют. Уласныя валюты паказваюцца так, як вы іх увялі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und Länder stammen aus dem Verzeichnis der Währungen. Eigene Währungen werden so angezeigt, wie Sie sie eingetragen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and countries come from the directory of currencies. Own currencies are shown as you typed them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres y los países vienen del directorio de divisas. Las divisas propias se muestran tal como las escribió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms et les pays viennent du répertoire des devises. Les devises personnelles sont affichées telles que vous les avez saisies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi e i paesi provengono dall’elenco delle valute. Le valute personali sono mostrate come le hai inserite."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атаулар мен елдер валюталар анықтамалығынан алынады. Өз валюталары сіз терген түрінде көрсетіледі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy i kraje pochodzą z katalogu walut. Własne waluty są wyświetlane tak, jak je wpisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes e países vêm do catálogo de moedas. As moedas próprias aparecem como você as digitou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия и страны берутся из справочника валют. Свои валюты показываются так, как вы их ввели."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adlar ve ülkeler para birimleri dizininden alınır. Özel para birimleri girdiğiniz gibi gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви й країни беруться з довідника валют. Власні валюти показуються так, як ви їх увели."
          }
        }
      }
    },
    "currencies.lock.base": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубель — валюта ўсіх вынікаў, лімітаў і справаздач, таму ён заўсёды ўключаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rubel ist die Währung jeder Summe, jedes Limits und Berichts: Er bleibt eingeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ruble is the currency of every total, limit and report: it stays on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rublo es la divisa de todos los totales, límites e informes: se queda activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rouble est la devise de chaque total, plafond et rapport : il reste activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rublo è la valuta di tutti i totali, limiti e resoconti e rimane attivo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубль — әр жиынның, лимиттің және есептің валютасы: ол қосулы қалады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubel jest walutą wszystkich sum, limitów i raportów. Musi pozostać włączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rublo é a moeda de todos os totais, limites e relatórios e permanece ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубль — валюта всех итогов, лимитов и отчётов: он не выключается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruble tüm toplamların, limitlerin ve raporların para birimidir; kapatılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубль — валюта всіх підсумків, лімітів і звітів: він залишається ввімкненим."
          }
        }
      }
    },
    "currencies.lock.default": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта па змаўчанні заўсёды ўключана. Спачатку выберыце іншую."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardwährung bleibt eingeschaltet. Wählen Sie zuerst eine andere Standardwährung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default currency stays on. Choose another default first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La divisa por defecto se queda activada. Elija antes otra por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La devise par défaut reste activée. Choisissez d'abord une autre devise par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La valuta di default rimane attiva. Scegline prima un’altra."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдепкі валюта қосулы қалады. Алдымен басқа әдепкіні таңдаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślna waluta musi pozostać włączona. Najpierw wybierz inną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A moeda padrão permanece ativada. Escolha outra moeda padrão primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта по умолчанию не выключается. Сначала выберите другую."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saptanmış para birimi kapatılamaz. Önce başka bir para birimini saptanmış olarak seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типова валюта залишається ввімкненою. Спочатку виберіть іншу типову валюту."
          }
        }
      }
    },
    "currencies.lock.held": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта валюта выкарыстоўваецца на рахунку. Спачатку прыбярыце яе з рахунку (Налады → Рахункі)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konto führt diese Währung: Nehmen Sie sie zuerst vom Konto (Einstellungen → Konten)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account holds this currency: take it off the account first (Settings → Accounts)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta tiene esta divisa: quítela antes de la cuenta (Ajustes → Cuentas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte détient cette devise : retirez-la d'abord du compte (Réglages → Comptes)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto usa questa valuta. Rimuovila prima dal conto (Impostazioni → Conti)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір есеп-шот бұл валютаны ұстайды: алдымен оны есеп-шоттан алыңыз (Параметрлер → Есеп-шоттар)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta waluta jest używana na koncie. Najpierw usuń ją z konta (Ustawienia → Konta)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta usa esta moeda. Remova-a da conta primeiro em Ajustes → Contas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта валюта есть на счёте: сначала уберите её из счёта (Настройки → Счета)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hesapta bu para birimi var. Önce hesaptan kaldırın (Ayarlar → Hesaplar)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку є ця валюта: спочатку приберіть її з рахунку («Налаштування → Рахунки»)."
          }
        }
      }
    },
    "currencies.missing.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адсутнічаюць у штодзённых курсах: %@. Для аперацыі ў такой валюце трэба ўвесці курс уручную. Спіс знаходзіцца ў раздзеле Налады → Валюты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlt in den Tageskursen: %@. Ein Vorgang in einer solchen Währung braucht einen von Hand eingetragenen Kurs. Die Liste finden Sie unter Einstellungen → Währungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing from its daily rates: %@. An operation in such a currency takes a rate typed by hand. The list is in Settings → Currencies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan en sus tipos diarios: %@. Un movimiento en esa divisa toma un tipo escrito a mano. La lista está en Ajustes → Divisas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absente de ses cours quotidiens : %@. Une opération dans une telle devise prend un cours saisi à la main. La liste est dans Réglages → Devises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano dai tassi giornalieri: %@. Per le operazioni in queste valute devi inserire il tasso manualmente. Trovi l’elenco in Impostazioni → Valute."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күнделікті бағамдарында жоқ: %@. Мұндай валютадағы операцияға қолмен теріліген бағам керек. Тізім — Параметрлер → Валюталарда."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wśród dziennych kursów: %@. Dla operacji w tych walutach należy wpisać kurs ręcznie. Lista znajduje się w Ustawienia → Waluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não incluídas nas cotações diárias: %@. Para operações nessas moedas, digite a cotação manualmente. Veja a lista em Ajustes → Moedas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет в ежедневных курсах ЦБ: %@. Для операции в такой валюте курс вводится вручную. Список — в Настройках, вкладка «Валюты»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük kurlarda bulunmayanlar: %@. Bu para birimindeki işlemler için kur elle girilir. Liste Ayarlar → Para Birimleri bölümündedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У щоденних курсах немає: %@. Для операції в такій валюті курс вводиться вручну. Список — у «Налаштування → Валюти»."
          }
        }
      }
    },
    "currencies.missing.title": {
