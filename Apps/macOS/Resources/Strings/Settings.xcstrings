    "references.usage.none": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona heç nə istinad etmir: silmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На яго нішто не спасылаецца: яго можна выдаліць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznam se nepoužívá a lze ho smazat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist darauf: Er kann gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it: it can be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada hace referencia a él: se puede eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'y réfère : il peut être supprimé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն չի օգտագործվում և կարելի է ջնջել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è in uso e può essere eliminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用されていないため、削除できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მასზე მითითება არ არსებობს: მისი წაშლა შესაძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған сілтемелер жоқ: жоюға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Буга эч нерсе шилтеме кылбайт: өчүрсө болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt nergens naar verwezen. Het kan worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie jest używana: można ją usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está em uso e pode ser apagado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está a ser usado: pode ser apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На это ничто не ссылается — можно удалить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба он ҳеҷ чиз истинод надорад: онро нест кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir yerde kullanılmıyor: silinebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На запис немає посилань: його можна видалити."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Undan hech qayerda foydalanilmaydi: uni o‘chirish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未被使用：可以删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何項目使用此記錄，可以刪除。"
          }
        }
      }
    },
