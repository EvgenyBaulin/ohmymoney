    "settings.tiles.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşarələnmiş lövhələr İcmalda göstərilir. Lövhəni siçanla öz qrupunda və ya başqa qrupda istədiyiniz yerə sürüşdürün; qrupu isə adından tutub sürüşdürün. İşarələnməmiş lövhə gizlənir və yerini saxlayır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адзначаныя пліткі паказваюцца ў аглядзе. Перацягніце плітку мышшу ў іншае месца ў сваёй або іншай групе; групу перацягвайце за назву. Неадзначаная плітка схавана і захоўвае сваё месца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaškrtnuté dlaždice se zobrazují v přehledu. Dlaždici můžete myší přetáhnout na jiné místo ve stejné nebo jiné skupině. Skupinu přetáhnete za její název. Nezaškrtnutá dlaždice je skrytá a zůstává na svém místě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angekreuzte Kacheln werden in der Übersicht gezeigt. Ziehen Sie eine Kachel mit der Maus an eine andere Stelle, in ihrer Gruppe oder in eine andere; eine Gruppe ziehen Sie an ihrem Namen. Eine nicht angekreuzte Kachel ist ausgeblendet und behält ihren Platz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ticked tiles are shown on Overview. Drag a tile with the mouse to another place, in its group or another one; drag a group by its name. An unticked tile is hidden and keeps its place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mosaicos marcados se muestran en el Resumen. Arrastre un mosaico con el ratón a otro lugar, dentro de su grupo o a otro; arrastre un grupo por su nombre. Un mosaico desmarcado se oculta y conserva su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tuiles cochées s'affichent dans l'Aperçu. Faites glisser une tuile à la souris vers une autre place, dans son groupe ou un autre ; faites glisser un groupe par son nom. Une tuile décochée est masquée et garde sa place."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշված սալիկները ցուցադրվում են Ամփոփման մեջ։ Մկնիկով քաշեք սալիկը նույն կամ այլ խմբի մեջ, իսկ խումբը՝ իր անունով։ Չնշված սալիկը թաքցվում է՝ պահպանելով իր տեղը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I riquadri selezionati sono visibili nel riepilogo. Trascina un riquadro con il mouse per spostarlo nel suo gruppo o in un altro; trascina un gruppo per il nome. Un riquadro deselezionato viene nascosto e mantiene la sua posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックしたタイルが概要に表示されます。タイルをドラッグして、同じグループ内または別のグループに移動できます。グループは名前をドラッグして移動できます。チェックを外したタイルは非表示になり、位置は保持されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონიშნული ფილები მიმოხილვაში ჩანს. გადაათრიეთ ფილა სხვა ადგილას, იმავე ან სხვა ჯგუფში; ჯგუფის გადასატანად გადაათრიეთ მისი სახელი. მოუნიშნავი ფილა დამალულია და ადგილს ინარჩუნებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгіленген плиткалар Шолуда көрсетіледі. Плитканы тінтуірмен өз тобында не басқа топта басқа орынға сүйреңіз; топты атауынан сүйреңіз. Белгіленбеген плитка жасырылып, орнын сақтайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгиленген такталар Серепте көрсөтүлөт. Тактаны өз тобундагы же башка топтогу орунга чычкан менен сүйрөңүз; топту атынан сүйрөңүз. Белгиси алынган такта жашырылып, ордун сактайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangevinkte tegels staan in het overzicht. Sleep een tegel naar een andere plek, in dezelfde of een andere groep. Sleep een groep aan de naam. Een uitgevinkte tegel is verborgen en behoudt zijn plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczone kafelki są widoczne w przeglądzie. Przeciągnij kafelek w inne miejsce, w tej samej lub innej grupie. Aby przenieść grupę, przeciągnij jej nazwę. Odznaczony kafelek jest ukryty i zachowuje swoje miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os blocos marcados aparecem na Visão Geral. Arraste um bloco com o mouse para outro lugar, no mesmo grupo ou em outro; arraste um grupo pelo nome. Um bloco desmarcado fica oculto e mantém sua posição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os blocos assinalados aparecem no resumo. Arraste um bloco com o rato para outro lugar, no mesmo grupo ou noutro; arraste um grupo pelo nome. Um bloco não assinalado fica oculto e mantém o seu lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмеченные плитки показываются в «Обзоре». Чтобы переставить плитку — в своей группе или в другую, — перетащите её мышью; группу перетаскивайте за название. Неотмеченная плитка скрыта и остаётся на своём месте."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Лавҳаҳои ишорашуда дар шарҳ намоёнанд. Лавҳаро бо муш ба ҷои дигар, дар гурӯҳи худ ё гурӯҳи дигар кашед; гурӯҳро аз номаш кашед. Лавҳаи ишоранашуда пинҳон мешавад ва ҷояшро нигоҳ медорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretli kutucuklar Genel Bakış’ta gösterilir. Bir kutucuğu kendi grubunda veya başka bir grupta istediğiniz yere sürükleyin; grubu taşımak için adından sürükleyin. İşareti kaldırılan kutucuk gizlenir ve yerini korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначені плитки відображаються в огляді. Перетягніть плитку мишею на інше місце у своїй чи іншій групі; групу перетягуйте за назву. Непозначена плитка прихована й зберігає місце."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgilangan plitkalar umumiy ko‘rinishda ko‘rsatiladi. Plitkani sichqoncha bilan o‘z guruhida yoki boshqa guruhga suring; guruhni nomidan ushlab suring. Belgilanmagan plitka yashiriladi va o‘z o‘rnini saqlaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选的卡片会显示在概览中。用鼠标将卡片拖移到本组或其他组中的位置；拖移分组名称可移动分组。未勾选的卡片会隐藏，但保留原来的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾選的圖塊會顯示在總覽中。使用滑鼠拖移圖塊至同一群組或其他群組中的位置；拖移群組名稱可移動群組。未勾選的圖塊會隱藏並保留原位。"
          }
        }
      }
    },
