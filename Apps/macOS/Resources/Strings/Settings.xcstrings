    "settings.tiles.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ticked tiles are shown on Overview. Drag a tile with the mouse to another place, in its group or another one; drag a group by its name. An unticked tile is hidden and keeps its place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mosaicos marcados se muestran en el Resumen. Arrastre un mosaico con el ratón a otro lugar, dentro de su grupo o a otro; arrastre un grupo por su nombre. Un mosaico desmarcado se oculta y conserva su lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмеченные плитки показываются в «Обзоре». Чтобы переставить плитку — в своей группе или в другую, — перетащите её мышью; группу перетаскивайте за название. Неотмеченная плитка скрыта и остаётся на своём месте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначені плитки відображаються в огляді. Перетягніть плитку мишею на інше місце у своїй чи іншій групі; групу перетягуйте за назву. Непозначена плитка прихована й зберігає місце."
          }
        }
      }
    },
    "settings.tiles.moveTo": {
