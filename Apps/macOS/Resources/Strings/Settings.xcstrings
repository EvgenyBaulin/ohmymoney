    "archive.import.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is read-only: an import is not possible. Leave the mode first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app está en solo lectura: no es posible importar. Salga antes del modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app est en lecture seule : l'import n'est pas possible. Quittez d'abord ce mode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим «Только просмотр»: импорт недоступен. Сначала выйдите из режима."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок у режимі лише перегляду: імпорт неможливий. Спочатку вийдіть із режиму."
          }
        }
      }
    },
