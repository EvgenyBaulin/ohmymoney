    "settings.appearance.textHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mətn ölçüsü bütün pəncərələrdə eyni anda dəyişir. Valyuta ayarı məbləğlərin ekranlarda, qrafiklərdə və kartlarda necə göstərildiyini müəyyən edir; fayllar və məbləğ daxil edilən sahələr dəyişmir. «Ad» yalnız rus dilində qısa rusca adları göstərir; ingilis dilində kod göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Памер тэксту змяняецца адразу ва ўсіх вокнах. Настройка валюты вызначае яе абазначэнне ў сумах на экранах, графіках і картках; файлы і палі ўводу сум застаюцца без змен. «Назва» паказвае кароткія рускія назвы толькі на рускай мове; на англійскай паказваецца код."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velikost textu se změní ve všech oknech najednou. Měna určuje označení částek na obrazovkách, v grafech a na kartách. Soubory a pole pro zadávání částek zůstanou beze změny. Volba «Název» zobrazuje krátké ruské názvy pouze v ruštině, v angličtině zobrazuje kód."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Textgröße ändert sich in jedem Fenster zugleich. Die Währung ist, wie Beträge sie auf den Bildschirmen, in Diagrammen und Karten benennen; Dateien und Felder, in die ein Betrag getippt wird, bleiben, wie sie sind. „Name“ schreibt kurze russische Namen nur auf Russisch; auf Englisch zeigt es den Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text size changes in every window at once. The currency is how amounts name it on the screens, charts and cards; files and the fields where an amount is typed stay as they are. «Name» writes short Russian names only in Russian; in English it shows the code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño del texto cambia de golpe en todas las ventanas. La divisa es como los importes la nombran en las pantallas, gráficos y tarjetas; los archivos y los campos donde se escribe un importe se quedan como están. «Nombre» escribe nombres rusos cortos solo en ruso; en inglés muestra el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille du texte change dans toutes les fenêtres à la fois. La devise est le nom que lui donnent les montants sur les écrans, graphiques et cartes ; les fichiers et les champs où un montant est saisi restent tels quels. « Nom » n'écrit les noms courts qu'en russe ; en anglais, il affiche le code."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեքստի չափը փոխվում է բոլոր պատուհաններում միաժամանակ։ Արժույթի կարգավորումը որոշում է դրա ցուցադրումը էկրանների, գծապատկերների և քարտերի գումարներում․ ֆայլերը և գումարի մուտքագրման դաշտերը չեն փոխվում։ «Անվանում»-ը կարճ ռուսերեն անվանումները ցույց է տալիս միայն ռուսերենում, իսկ անգլերենում՝ կոդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dimensioni del testo cambiano subito in tutte le finestre. La valuta determina come viene indicata negli importi su schermate, grafici e schede; i file e i campi per l'inserimento degli importi restano invariati. «Nome» usa nomi russi abbreviati solo in russo; in inglese mostra il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字サイズはすべてのウインドウに同時に適用されます。通貨の表示形式は画面、グラフ、カードの金額に適用されます。ファイルと金額の入力欄は変わりません。「名前」では、ロシア語の場合のみ短いロシア語名を表示し、英語の場合はコードを表示します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტექსტის ზომა ყველა ფანჯარაში ერთდროულად იცვლება. ვალუტის პარამეტრი განსაზღვრავს მის ჩვენებას ეკრანებზე, დიაგრამებსა და ბარათებზე; ფაილები და თანხის შესაყვანი ველები უცვლელი რჩება. «სახელი» მოკლე რუსულ სახელებს მხოლოდ რუსულ ენაზე აჩვენებს; ინგლისურად კი კოდი გამოჩნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мәтін өлшемі барлық терезеде бірден өзгереді. Валюта — экрандардағы, диаграммалар мен карталардағы сомалардың белгіленуі; файлдар мен сома енгізу өрістері өзгермейді. «Атау» қысқа орысша атауларды тек орыс тілінде жазады; ағылшын тілінде код көрсетіледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тексттин өлчөмү бардык терезелерде бир убакта өзгөрөт. Валюта жөндөөсү экрандарда, диаграммаларда жана карталарда суммалардын жанында валютанын көрсөтүлүшүн өзгөртөт; файлдар жана сумма киргизилген талаалар өзгөрбөйт. «Аталышы» орусча кыска аталыштарды орус тилинде гана жазат; англис тилинде кодду көрсөтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekstgrootte verandert tegelijk in alle vensters. De valuta-instelling bepaalt hoe de valuta bij bedragen op schermen, in grafieken en op kaarten wordt weergegeven. Bestanden en invoervelden voor bedragen blijven ongewijzigd. «Naam» toont alleen in het Russisch korte Russische namen; in het Engels wordt de code getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wielkość tekstu zmienia się jednocześnie we wszystkich oknach. Ustawienie waluty określa jej oznaczenie przy kwotach na ekranach, wykresach i kartach; nie zmienia plików ani pól do wpisywania kwot. Opcja «Nazwa» wyświetla skrócone rosyjskie nazwy tylko w języku rosyjskim; w języku angielskim wyświetla kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho do texto muda em todas as janelas ao mesmo tempo. A opção de moeda define como ela aparece nos valores das telas, gráficos e cartões; os arquivos e campos de valor permanecem iguais. «Nome» usa nomes russos abreviados apenas em russo; em inglês, mostra o código."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho do texto muda em todas as janelas de imediato. A moeda define como é apresentada junto aos valores nos ecrãs, gráficos e cartões; os ficheiros e os campos de introdução de valores mantêm-se inalterados. «Nome» apresenta nomes russos abreviados apenas em russo; em inglês, apresenta o código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер шрифта меняется сразу во всех окнах. Валюта — как суммы называют её на экранах, графиках и карточках; файлы и поля, где набирают сумму, не меняются. «Название» пишет сокращения (руб., долл.) только по-русски, по-английски — код."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Андозаи матн дар ҳамаи равзанаҳо якбора тағйир меёбад. Асъор тарзи нишон додани онро дар экранҳо, диаграммаҳо ва кортҳо муайян мекунад; файлҳо ва майдонҳои воридкунии маблағ бетағйир мемонанд. «Ном» номҳои кӯтоҳи русиро танҳо бо забони русӣ менависад; бо забони англисӣ рамзро нишон медиҳад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin boyutu tüm pencerelerde aynı anda değişir. Para birimi seçimi, tutarların ekranlarda, grafiklerde ve kartlarda nasıl gösterileceğini belirler; dosyalar ve tutar girilen alanlar değişmez. «Ad» yalnızca Rusçada kısa Rusça adları gösterir; İngilizcede kod gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір тексту змінюється одразу в усіх вікнах. Вигляд валюти визначає її підпис біля сум на екранах, графіках і картках; файли й поля вводу сум не змінюються. «Назва» показує короткі російські назви лише російською; англійською показує код."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Matn o‘lchami barcha oynalarda bir vaqtda o‘zgaradi. Valyuta sozlamasi ekranlar, diagrammalar va kartalarda summalar yonida nima ko‘rsatilishini belgilaydi; fayllar va summa kiritiladigan maydonlar o‘zgarmaydi. «Nom» faqat rus tilida qisqa ruscha nomlarni, ingliz tilida esa kodni ko‘rsatadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字大小会同时应用于所有窗口。货币格式用于屏幕、图表和卡片中的金额；文件和金额输入栏保持不变。“名称”仅在俄语界面中显示俄语简称，英语界面中显示代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字大小會立即套用到所有視窗。貨幣設定會變更畫面、圖表和卡片中金額的貨幣表示方式；檔案和金額輸入欄位維持不變。「名稱」僅在俄文介面中顯示俄文簡稱；英文介面會顯示代碼。"
          }
        }
      }
    },
    "settings.backups.beforeMigrationMirrored": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniləmələrdən əvvəl yaradılmış nüsxələr də buradadır, «before-migration» qovluğunda. Nüsxələrin növbələnməsi onları silmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіі перад абнаўленнямі таксама захоўваюцца тут, у папцы «before-migration». Ратацыя копій ніколі іх не выдаляе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou tu také kopie vytvořené před aktualizacemi ve složce «before-migration». Při střídání záloh se nikdy nemažou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien vor Updates liegen auch hier, im Ordner „before-migration“. Die Rotation der Kopien löscht sie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies made before updates are here too, in the «before-migration» folder. Copy rotation never deletes them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias hechas antes de las actualizaciones también están aquí, en la carpeta «antes-de-actualizacion». La rotación de copias nunca las elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies faites avant les mises à jour sont aussi là, dans le dossier « before-migration ». La rotation des copies ne les supprime jamais."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թարմացումներից առաջ ստեղծված պատճենները նույնպես այստեղ են՝ «before-migration» պանակում։ Պատճենների հերթափոխը դրանք երբեք չի ջնջում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le copie create prima degli aggiornamenti si trovano qui, nella cartella «before-migration». La rotazione delle copie non le elimina mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート前に作成されたコピーも「before-migration」フォルダにあります。コピーのローテーションで削除されることはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განახლებამდე შექმნილი ასლებიც აქაა, საქაღალდეში «before-migration». ასლების როტაცია მათ არასოდეს შლის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңартуға дейінгі көшірмелер де осында, «before-migration» қалтасында. Көшірмелерді кезекпен тазалау оларды жоймайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңыртуулардын алдында жасалган көчүрмөлөр да ушул жерде, «before-migration» папкасында. Көчүрмөлөрдү алмаштыруу аларды эч качан өчүрбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieën van vóór updates staan hier ook, in de map «before-migration». Ze worden nooit verwijderd bij het rouleren van kopieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Są tu również kopie utworzone przed aktualizacjami, w folderze «before-migration». Rotacja kopii nigdy ich nie usuwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias feitas antes das atualizações também estão aqui, na pasta «before-migration». A rotação de backups nunca as apaga."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias feitas antes das atualizações também estão aqui, na pasta «before-migration». A rotação de cópias nunca as apaga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии «до обновления» лежат и здесь — в папке «before-migration». Ротация копий их не удаляет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нусхаҳои пеш аз навсозӣ сохташуда низ дар ҷузвдони «before-migration» ҳастанд. Ҳангоми ивазкунии нусхаҳо онҳо нест карда намешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemelerden önce oluşturulan kopyalar da burada, «before-migration» klasöründedir. Kopya döngüsü bunları silmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії перед оновленнями також тут, у папці «before-migration». Автоматичне очищення їх ніколи не видаляє."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangilanishlardan oldin yaratilgan nusxalar ham shu yerda, «before-migration» jildida. Nusxalarni almashtirishda ular o‘chirilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新前创建的副本也保存在此处的“before-migration”文件夹中。备份轮换不会删除这些副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新前製作的備份也存放在此處的 «before-migration» 資料夾中。備份輪替不會刪除這些備份。"
          }
        }
      }
    },
