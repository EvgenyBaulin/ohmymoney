    "settings.planning.goalValuation.today": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "па сённяшнім курсе"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "zum heutigen Kurs"
          }
        },
        "en": {
          "stringUnit": {
