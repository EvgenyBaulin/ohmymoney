    "export.failed.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qovluqda heç nə dəyişmədi. Səbəb jurnaldadır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У папцы нічога не змянілася. Прычына ўказана ў журнале."
