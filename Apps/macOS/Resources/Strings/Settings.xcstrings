    "settings.appearance.accentHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System colours only: they follow the dark theme and «Increase contrast» by themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo colores del sistema: siguen por sí solos el tema oscuro y «Aumentar contraste»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs système uniquement : elles suivent d'elles-mêmes le thème sombre et « Augmenter le contraste »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвета системные: они сами подстраиваются под тёмную тему и «Увеличить контраст»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише системні кольори: вони самі враховують темну тему й підвищений контраст."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек жүйелік түстер: қараңғы тақырып пен «Контрастты арттыру» параметріне автоматты түрде бейімделеді."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Systemfarben: Sie folgen dem dunklen Design und „Kontrast erhöhen“ von selbst."
          }
        }
      }
    },
