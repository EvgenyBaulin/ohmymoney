    "backups.beforeUpdate.confirmTitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаліць старыя копіі, створаныя перад абнаўленнем?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Kopien löschen, die vor einem Update entstanden sind?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete old copies made before an update?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar las copias antiguas hechas antes de una actualización?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les anciennes copies faites avant une mise à jour ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare le vecchie copie create prima di un aggiornamento?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңартудан бұрын жасалған ескі көшірмелер жойылсын ба?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć stare kopie sprzed uaktualnienia?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar cópias antigas feitas antes de uma atualização?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить старые копии «перед обновлением»?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme öncesi oluşturulan eski kopyalar silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити старі копії перед оновленнями?"
          }
        }
      }
    },
