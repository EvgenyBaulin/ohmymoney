    "settings.categoryHints.explanation": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney qeydlərinizdən öyrənir: kateqoriya təklif etmək üçün yerdən, məbləğdən və sözlərdən istifadə edir. Bu göstəricilər onun nə qədər tez-tez düzgün təklif etdiyini göstərir. Kateqoriyanı düzəltdikdə model növbəti qeyd üçün öyrənir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney вучыцца на вашых запісах: выкарыстоўвае месца, суму і словы, каб прапанаваць катэгорыю. Гэтыя паказчыкі адлюстроўваюць, як часта прапанова правільная. Выпраўленне катэгорыі дапамагае мадэлі зрабіць наступную прапанову."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney se učí z vašich záznamů: k návrhu kategorie používá místo, částku a slova. Tyto údaje ukazují, jak často se trefí. Opravou kategorie model učíte pro další záznam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney lernt aus Ihren Eingaben: Es nutzt Ort, Betrag und Wörter, um eine Kategorie vorzuschlagen. Diese Messungen zeigen, wie oft es richtig liegt. Eine korrigierte Kategorie lehrt das Modell für die nächste Eingabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney learns from your entries: it uses the place, amount and words to suggest a category. These measurements show how often it gets it right. Correcting a category teaches the model for the next entry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney aprende de sus apuntes: usa el lugar, el importe y las palabras para sugerir una categoría. Estas mediciones muestran con qué frecuencia acierta. Corregir una categoría enseña al modelo para el siguiente apunte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney apprend de vos saisies : il s'appuie sur le lieu, le montant et les mots pour suggérer une catégorie. Ces mesures montrent à quelle fréquence il a raison. Corriger une catégorie instruit le modèle pour la saisie suivante."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն սովորում է ձեր գրառումներից․ այն օգտագործում է վայրը, գումարը և բառերը՝ կատեգորիա առաջարկելու համար։ Այս չափումները ցույց են տալիս, թե որքան հաճախ է այն ճիշտ գուշակում։ Կատեգորիան ուղղելով՝ մոդելին սովորեցնում եք հաջորդ գրառման համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney impara dalle tue registrazioni: usa il luogo, l'importo e le parole per suggerire una categoria. Queste metriche mostrano quanto spesso indovina. Correggere una categoria aiuta il modello a imparare per la registrazione successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoneyは入力内容から学習し、場所、金額、言葉を使ってカテゴリを提案します。これらの指標は、提案が正しかった頻度を示します。カテゴリを修正すると、モデルが学習し、次の入力に反映されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney თქვენი ჩანაწერებიდან სწავლობს: კატეგორიის შესარჩევად იყენებს ადგილს, თანხასა და სიტყვებს. ეს მაჩვენებლები აჩვენებს, რამდენად ხშირად ირჩევს სწორად. კატეგორიის შესწორება მოდელს მომდევნო ჩანაწერისთვის ასწავლის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney жазбаларыңыздан үйренеді: орын, сома және сөздер арқылы санат ұсынады. Бұл өлшемдер дұрыс болжау жиілігін көрсетеді. Санатты түзету келесі жазбаға арналған үлгіні үйретеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney жазууларыңыздан үйрөнөт: категория сунуштоо үчүн жерди, сумманы жана сөздөрдү колдонот. Бул көрсөткүчтөр анын канчалык көп туура тапканын көрсөтөт. Категорияны оңдоо моделге кийинки жазуу үчүн үйрөнүүгө жардам берет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney leert van je invoer en gebruikt de plaats, het bedrag en de woorden om een categorie voor te stellen. Deze metingen tonen hoe vaak dat klopt. Door een categorie te corrigeren, leert het model voor de volgende invoer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney uczy się na podstawie Twoich wpisów: używa miejsca, kwoty i słów, aby zaproponować kategorię. Te pomiary pokazują, jak często trafia. Poprawienie kategorii pomaga modelowi przy następnym wpisie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney aprende com seus lançamentos: usa o local, o valor e as palavras para sugerir uma categoria. Estas métricas mostram com que frequência ele acerta. Corrigir uma categoria ensina o modelo para o próximo lançamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney aprende com os seus registos: usa o local, o valor e as palavras para sugerir uma categoria. Estas métricas mostram com que frequência acerta. Corrigir uma categoria ajuda o modelo a aprender para o próximo registo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney учится на ваших записях: по месту, сумме и словам угадывает категорию. Здесь видно, как часто он угадывает. Исправляете категорию — модель учится и в следующий раз ошибается реже."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney аз сабтҳои шумо меомӯзад: барои пешниҳоди категория аз ҷой, маблағ ва калимаҳо истифода мебарад. Ин нишондиҳандаҳо басомади пешниҳоди дурустро нишон медиҳанд. Ислоҳи категория ба модел барои сабти навбатӣ кумак мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney kayıtlarınızdan öğrenir: Kategori önermek için yeri, tutarı ve sözcükleri kullanır. Bu ölçümler, ne sıklıkla doğru tahmin ettiğini gösterir. Bir kategoriyi düzeltmek, modele sonraki kayıt için öğretir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney навчається на ваших записах: використовує місце, суму й слова, щоб запропонувати категорію. Ці показники відображають частоту влучних підказок. Виправлення категорії навчає модель для наступного запису."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney yozuvlaringizdan o‘rganadi: turkumni tavsiya qilish uchun joy, summa va so‘zlardan foydalanadi. Bu ko‘rsatkichlar tavsiyalar qanchalik tez-tez to‘g‘ri chiqishini ko‘rsatadi. Turkumni tuzatish modelga keyingi yozuv uchun o‘rganishga yordam beradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 会从你的记录中学习，利用地点、金额和文字建议类别。这些指标显示建议的准确程度。更正类别可帮助模型改进后续建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 會從你的記錄中學習，並根據地點、金額和文字建議類別。這些指標顯示建議的準確程度。修正類別可讓模型在下次記錄時學習。"
          }
        }
      }
    },
