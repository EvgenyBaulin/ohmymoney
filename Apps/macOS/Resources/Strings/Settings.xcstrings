    "names.other.taken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва ўжо выкарыстоўваецца для «%@»: радок уводу не зможа іх адрозніць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hört bereits auf diesen Namen: Die Eingabezeile könnte beide nicht unterscheiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» already answers to this name: the entry line would not tell the two apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya responde a este nombre: la línea de entrada no distinguiría los dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » répond déjà à ce nom : la ligne de saisie ne saurait pas les distinguer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» usa già questo nome: non sarebbe possibile distinguere i due elementi durante l’inserimento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» осы атаумен белгілі: енгізу жолы екеуін ажырата алмайды."
