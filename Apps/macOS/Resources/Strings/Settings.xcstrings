    "archive.password.mismatch.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце аднолькавы пароль у абодвух палях. Архіў адкрыецца толькі з дакладна такім паролем."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie in beide Felder dasselbe Passwort. Das Archiv öffnet sich nur mit genau dem, was Sie eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the same password in both fields. The archive will open only with exactly what you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba la misma contraseña en los dos campos. El archivo se abrirá solo con exactamente lo que escriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le même mot de passe dans les deux champs. L'archive ne s'ouvrira qu'avec exactement ce que vous saisissez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la stessa password in entrambi i campi. L’archivio si aprirà solo con la password esatta inserita."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екі өрісте де бірдей құписөз теріңіз. Мұрағат тек дәл теріген құписөзбен ашылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите один и тот же пароль в оба поля. Архив откроется только тем паролем, который вы введёте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть однаковий пароль в обох полях. Архів відкриється лише з точно таким самим паролем."
          }
        }
      }
    },
