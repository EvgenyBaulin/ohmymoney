    "categories.rename.taken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Іншая катэгорыя цяпер мае такую назву. Новая назва захавана; вы можаце перайменаваць любую з іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bereits eine Kategorie mit diesem Namen. Der Name bleibt, wie er war — wählen Sie einen anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another category has this name now. The rename is saved; you can rename either one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una categoría con este nombre. El nombre se queda como estaba: elija otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une catégorie porte déjà ce nom. Le nom reste tel qu'il était — choisissez-en un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra categoria ha ora questo nome. La modifica è stata salvata; puoi rinominare una delle due."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен санат бұрыннан бар. Атауы бұрынғыдай қалады — басқасын таңдаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь есть ещё одна категория с таким названием. Переименование сохранено; можно переименовать любую из них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія з такою назвою вже є. Назва не змінилася — виберіть іншу."
          }
        }
      }
    },
