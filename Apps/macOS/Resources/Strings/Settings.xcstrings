    "categories.cashbackHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход у гэтай катэгорыі і яе падкатэгорыях улічваецца ў аналітыцы як кэшбэк."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmen in dieser Kategorie und ihren Unterkategorien zählen in der Auswertung als Cashback."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income in this category and its subcategories counts as cashback in Analytics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ingreso en esta categoría y en sus subcategorías cuenta como cashback en Analítica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revenu dans cette catégorie et ses sous-catégories compte comme cashback dans l'Analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate in questa categoria e nelle sue sottocategorie sono conteggiate come cashback in Analisi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы санаттағы және оның ішкі санаттарындағы табыс Аналитикада кешбэк болып саналады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przychody w tej kategorii i jej podkategoriach są uwzględniane jako cashback w analizie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As receitas nesta categoria e em suas subcategorias contam como cashback em Análises."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход в этой категории и её подкатегориях Analytics считает кэшбэком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kategorideki ve alt kategorilerindeki gelirler, Analiz’de nakit iade olarak sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід у цій категорії та її підкатегоріях враховується як кешбек в аналітиці."
          }
        }
      }
    },
    "categories.cashbackRulesHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканы кэшбэк вызначаецца правіламі рахункаў: на экране рахунку або ў Налады → Рахункі → “Кэшбэк…”. За выплату доўгу кэшбэк не налічваецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Cashback zu erwarten ist, legen die Regeln der Konten fest: auf dem Bildschirm des Kontos oder in Einstellungen → Konten → „Cashback…“. Eine Zahlung auf eine Schuld bringt keinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much cashback to expect is set by the rules of the accounts: on the account screen or in Settings → Accounts → “Cashback…”. A payment on a debt earns none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto cashback esperar lo fijan las reglas de las cuentas: en la pantalla de la cuenta o en Ajustes → Cuentas → «Cashback…». Un pago de deuda no genera ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback attendu se fixe par les règles des comptes : sur l'écran du compte ou dans Réglages → Comptes → « Cashback… ». Un paiement de dette n'en rapporte aucun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cashback previsto è definito dalle regole dei conti: nella schermata del conto o in Impostazioni → Conti → “Cashback…”. I pagamenti dei debiti non danno diritto al cashback."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтілетін кешбэк көлемін есеп-шоттың ережелері белгілейді: есеп-шот экранында немесе Параметрлер → Есеп-шоттар → «Кешбэк…». Берешек бойынша төлем кешбэк бермейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwany cashback określają reguły konta: na ekranie konta lub w Ustawienia → Konta → „Cashback…”. Spłata długu nie daje cashbacku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback esperado é definido pelas regras das contas, na tela da conta ou em Ajustes → Contas → “Cashback…”. Pagamentos de dívidas não geram cashback."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько кэшбэка ждать, задают правила счетов: экран счёта или «Настройки → Счета» → «Кэшбэк…». За платёж по долгу кэшбэк не платят."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenen nakit iade, hesapların kurallarına göre belirlenir. Hesap ekranından veya Ayarlar → Hesaplar → “Nakit İade…” bölümünden ayarlayabilirsiniz. Borç ödemeleri nakit iade kazandırmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний кешбек визначають правила рахунків: на екрані рахунку або в «Налаштування → Рахунки → Кешбек…». Платіж за боргом кешбеку не дає."
          }
        }
      }
    },
    "categories.delete.blocked": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» выкарыстоўваецца: %2$@. Замест выдалення змясціце катэгорыю ў архіў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wird von %2$@ genutzt. Legen Sie die Kategorie stattdessen ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» is used by %2$@. Put the category in the archive instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» la usa %2$@. Pase la categoría al archivo en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est utilisée par %2$@. Mettez plutôt la catégorie aux archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è usata da %2$@. Archivia la categoria."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» санатын %2$@ қолданады. Оның орнына санатты мұрағатқа өткізіңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria «%1$@» jest używana przez: %2$@. Przenieś ją do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» é usada por %2$@. Arquive a categoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На «%1$@» %2$@. Отправьте категорию в архив."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@», %2$@ tarafından kullanılıyor. Bunun yerine kategoriyi arşivleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» використовується в %2$@. Натомість перемістіть категорію в архів."
          }
        }
      }
    },
