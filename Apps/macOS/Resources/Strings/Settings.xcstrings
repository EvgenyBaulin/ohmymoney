    "backups.restore.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nüsxə zədələnib və bərpa edilə bilməz. Heç nə əvəz edilmədi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта копія пашкоджана, і аднавіць яе немагчыма. Нічога не заменена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato kopie je poškozená a nelze ji obnovit. Nic nebylo nahrazeno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie ist beschädigt und lässt sich nicht wiederherstellen. Nichts wurde ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy is damaged and cannot be restored. Nothing was replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia está dañada y no se puede restaurar. No se reemplazó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie est endommagée et ne peut pas être restaurée. Rien n'a été remplacé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս պատճենը վնասված է և հնարավոր չէ վերականգնել։ Ոչինչ չի փոխարինվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia è danneggiata e non può essere ripristinata. Non è stato sostituito nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーは壊れているため、復元できません。データは置き換えられていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ასლი დაზიანებულია და მისი აღდგენა შეუძლებელია. არაფერი შეცვლილა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл көшірме бүлінген және қалпына келтірілмейді. Ештеңе ауыстырылмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул көчүрмө бузулган жана аны калыбына келтирүү мүмкүн эмес. Эч нерсе алмаштырылган жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze kopie is beschadigd en kan niet worden teruggezet. Er is niets vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia jest uszkodzona i nie można jej przywrócić. Nic nie zostało zastąpione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia está danificada e não pode ser restaurada. Nada foi substituído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia está danificada e não pode ser restaurada. Nada foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия повреждена, восстановить из неё нельзя. Ничего не заменено."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин нусха осеб дидааст ва барқарор карда намешавад. Ҳеҷ чиз иваз нашуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kopya hasarlı ve geri yüklenemiyor. Hiçbir şey değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю копію пошкоджено, її неможливо відновити. Нічого не замінено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nusxa shikastlangan, uni tiklab bo‘lmaydi. Hech narsa almashtirilmadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此副本已损坏，无法恢复。未替换任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此副本已損毀，無法回復。未取代任何資料。"
          }
        }
      }
    },
