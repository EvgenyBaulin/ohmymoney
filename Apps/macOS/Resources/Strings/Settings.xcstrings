    "report.crashHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application does not read the system logs itself. The reports are in ~/Library/Logs/DiagnosticReports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación no lee por sí misma los registros del sistema. Los informes están en ~/Library/Logs/DiagnosticReports."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application ne lit pas elle-même les journaux du système. Les rapports sont dans ~/Bibliothèque/Logs/DiagnosticReports."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не читает системные журналы само. Отчёты лежат в ~/Library/Logs/DiagnosticReports."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок не читає системні журнали самостійно. Звіти лежать у ~/Library/Logs/DiagnosticReports."
          }
        }
      }
    },
    "report.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One file to hand over when something breaks. It holds the journal, versions and counts — never amounts, names or descriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo archivo para entregar cuando algo se rompe. Contiene el diario, versiones y recuentos — nunca importes, nombres ni descripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul fichier à transmettre quand quelque chose casse. Il contient le journal, les versions et des compteurs — jamais de montants, de noms ni de descriptions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один файл, который можно отдать на разбор, когда что-то сломалось. В нём журнал, версии и количества — и никогда суммы, имена или описания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один файл, який можна передати, коли щось не працює. Містить журнал, версії й лічильники — без сум, імен та описів."
          }
        }
      }
    },
    "report.interrupted": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session before this one did not end: the application was stopped or it crashed. A problem report will say what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión anterior no terminó: la aplicación se detuvo o se cayó. Un informe del problema dirá qué pasó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session précédente ne s'est pas terminée : l'application a été arrêtée ou elle a planté. Un rapport de problème dira ce qui s'est passé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс перед этим не завершился: приложение остановили или оно упало. Отчёт о проблеме покажет, что случилось."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
