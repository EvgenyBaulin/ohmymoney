    "archive.import.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilənlər bazası açıq olmadıqda arxivi yükləmək mümkün deyil. Əvvəlcə Parametrlər → Ehtiyat nüsxələr bölməsində nüsxəni bərpa edin, sonra arxivi yenidən açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Немагчыма загрузіць архіў, пакуль база даных не адкрыта. Спачатку аднавіце копію ў раздзеле Налады → Рэзервовыя копіі, а затым зноў адкрыйце архіў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiv nelze načíst, dokud není otevřená databáze. Nejprve obnovte kopii v Nastavení → Zálohy a potom archiv znovu otevřete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Archiv kann nicht geladen werden, solange die Datenbank nicht geöffnet ist. Stellen Sie zuerst unter Einstellungen → Sicherungen eine Kopie wieder her und öffnen Sie das Archiv dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive cannot be loaded while the database is not open. Restore a copy in Settings → Backups first, then open the archive again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no se puede cargar mientras la base de datos no está abierta. Restaure antes una copia en Ajustes → Copias de seguridad y vuelva a abrir el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archive ne peut pas être chargée tant que la base n'est pas ouverte. Restaurez d'abord une copie dans Réglages → Sauvegardes, puis ouvrez de nouveau l'archive."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվը հնարավոր չէ բեռնել, քանի դեռ տվյալների բազան բաց չէ։ Նախ վերականգնեք պատճենը Կարգավորումներ → Պահուստային պատճեններ բաժնում, ապա կրկին բացեք արխիվը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare l’archivio mentre il database è chiuso. Ripristina prima una copia in Impostazioni → Backup, poi apri di nuovo l’archivio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースが開いていないため、アーカイブを読み込めません。先に「設定」→「バックアップ」でコピーを復元してから、アーカイブをもう一度開いてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივის ჩატვირთვა შეუძლებელია, სანამ მონაცემთა ბაზა გახსნილი არ არის. ჯერ აღადგინეთ ასლი განყოფილებაში პარამეტრები → სარეზერვო ასლები, შემდეგ კი კვლავ გახსენით არქივი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор ашылмаған кезде мұрағатты жүктеу мүмкін емес. Алдымен Параметрлер → Резервтік көшірмелерде көшірмені қалпына келтіріңіз, содан кейін мұрағатты қайта ашыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайындар базасы ачык эмес учурда архивди жүктөө мүмкүн эмес. Адегенде Жөндөөлөр → Камдык көчүрмөлөр бөлүмүнөн көчүрмөнү калыбына келтирип, архивди кайра ачыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het archief kan niet worden geladen zolang de database niet is geopend. Zet eerst een kopie terug via Instellingen → Reservekopieën en open het archief opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wczytać archiwum, gdy baza danych nie jest otwarta. Najpierw przywróć kopię w Ustawieniach → Kopie zapasowe, a następnie otwórz archiwum ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível carregar o arquivo enquanto o banco de dados não estiver aberto. Primeiro, restaure uma cópia em Ajustes → Backups e abra o arquivo novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível carregar o arquivo enquanto a base de dados não estiver aberta. Primeiro, restaure uma cópia em Definições → Cópias de segurança e volte a abrir o arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока база не открыта, архив не загрузить. Сначала восстановите копию: Настройки → Бэкапы, — затем откройте архив снова."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То кушода шудани пойгоҳи додаҳо бор кардани бойгонӣ имкон надорад. Аввал нусхаро дар Танзимот → Нусхаҳои эҳтиётӣ барқарор кунед, сипас бойгониро аз нав кушоед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanı açık değilken arşiv yüklenemez. Önce Ayarlar → Yedeklemeler bölümünden bir kopyayı geri yükleyin, ardından arşivi yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна завантажити архів, поки базу даних не відкрито. Спочатку відновіть копію в «Налаштування → Резервні копії», потім відкрийте архів знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasi ochiq bo‘lmaganda arxivni yuklab bo‘lmaydi. Avval Sozlamalar → Zaxira nusxalari bo‘limida nusxani tiklang, so‘ng arxivni qayta oching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据库未打开时无法载入归档。请先在“设置”→“备份”中恢复副本，然后重新打开归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫未開啟時無法載入封存檔。請先在「設定」→「備份」中回復副本，再重新開啟封存檔。"
          }
        }
      }
    },
