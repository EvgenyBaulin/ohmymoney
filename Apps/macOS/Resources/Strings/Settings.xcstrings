    "integrity.repair.noCopy": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Heç nə dəyişdirilmədi: bərpadan əvvəl nüsxə yaratmaq mümkün olmadı."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічога не зменена: не ўдалося стварыць копію перад выпраўленнем."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se nezměnilo: před opravou se nepodařilo vytvořit kopii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wurde verändert: Eine Kopie vor der Reparatur konnte nicht angelegt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was changed: a copy before the repair could not be made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se cambió nada: no se pudo hacer una copia antes de la reparación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été modifié : une copie avant la réparation n'a pas pu être faite."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչինչ չի փոխվել․ չհաջողվեց շտկումից առաջ պատճեն ստեղծել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna modifica apportata: impossibile creare una copia prima della riparazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修復前のコピーを作成できなかったため、変更は行われませんでした。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არაფერი შეცვლილა: გასწორებამდე ასლის შექმნა ვერ მოხერხდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ештеңе өзгермеді: түзетуге дейінгі көшірмені жасау мүмкін болмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эч нерсе өзгөргөн жок: оңдоонун алдында көчүрмө түзүү мүмкүн болгон жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets gewijzigd: er kon geen kopie vóór het herstel worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wprowadzono zmian: nie udało się utworzyć kopii przed naprawą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi alterado: não foi possível criar uma cópia antes do reparo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi alterado: não foi possível criar uma cópia antes da reparação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не изменено: копию перед исправлением сделать не удалось."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чизе тағйир наёфт: сохтани нусха пеш аз ислоҳ имконнопазир шуд."
