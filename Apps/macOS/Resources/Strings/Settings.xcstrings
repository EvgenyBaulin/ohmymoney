          "stringUnit": {
            "state": "translated",
            "value": "Дар ҷузвдон чизе тағйир наёфт. Сабаб дар гузориш аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörde hiçbir şey değiştirilmedi. Nedeni günlükte bulabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці нічого не змінилося. Причина в журналі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jildda hech narsa o‘zgarmadi. Sababi jurnalda ko‘rsatilgan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹中的内容未更改。原因详见日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案夾中的內容未變更。原因記錄於日誌中。"
          }
        }
      }
    },
