    "settings.hints.burnoutHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У раздзеле «Варта паглядзець», не часцей за раз на тыдзень: калі за тыдзень дробных неабавязковых пакупак значна больш, чым звычайна"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Lohnt einen Blick“, höchstens einmal in der Woche: eine Woche mit vielen kleinen Käufen, auf die Sie eher verzichten könnten als üblich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In «Worth a look», at most once a week: a week with many more small purchases you could do without than usual"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Merece una mirada», como mucho una vez por semana: una semana con muchas más compras pequeñas prescindibles que de costumbre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans « À regarder de plus près », au plus une fois par semaine : une semaine avec bien plus de petits achats dont on pourrait se passer que d'habitude"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In «Da controllare», al massimo una volta a settimana: una settimana con molti più piccoli acquisti superflui del solito"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Назар аударыңыз» бөлімінде, аптасына бір реттен көп емес: қажетсіз ұсақ сатып алулар әдеттегіден едәуір көбейген апта"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W sekcji «Warto zobaczyć», najwyżej raz w tygodniu: tydzień ze znacznie większą niż zwykle liczbą drobnych zakupów, bez których można się obejść"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em «Vale conferir», no máximo uma vez por semana: uma semana com muito mais pequenas compras dispensáveis que o habitual"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Стоит посмотреть», не чаще раза в неделю: за неделю мелких необязательных покупок заметно больше обычного"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Göz Atmaya Değer» bölümünde, haftada en fazla bir kez: vazgeçebileceğiniz küçük alışverişlerin normalden çok daha fazla olduğu bir hafta"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «Варто переглянути», не частіше разу на тиждень: тиждень із набагато більшою кількістю необов'язкових дрібних покупок, ніж зазвичай"
          }
        }
      }
    },
    "settings.hints.burnoutNeedsEssentials": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазначце неабходныя выдаткі ў катэгорыях («Неабходныя выдаткі») — без гэтага падказка не адрозніць пачастунак ад прадуктаў і не з’явіцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie die notwendigen Ausgaben unter Kategorien („Notwendige Ausgaben“) — ohne sie kann der Hinweis einen Genuss nicht von Lebensmitteln unterscheiden und schweigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the necessary spending in Categories («Necessary spending») — without it the hint cannot tell a treat from groceries and stays silent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque el gasto necesario en Categorías («Gasto necesario») — sin ello, la sugerencia no distingue un capricho de la compra de comida y calla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez les dépenses nécessaires dans Catégories (« Dépenses nécessaires ») — sans cela, la suggestion ne peut pas distinguer une gâterie des courses et reste muette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna le spese necessarie in Categorie («Spese necessarie»). Senza questa indicazione, il suggerimento non può distinguere uno sfizio dalla spesa alimentare e non viene mostrato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санаттарда қажетті шығындарды белгілеңіз («Қажетті шығындар») — онсыз кеңес ермекке жұмсалған ақшаны азық-түліктен ажырата алмайды да, көрсетілмейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz niezbędne wydatki w Kategoriach («Niezbędne wydatki») — bez tego wskazówka nie odróżni przyjemności od zakupów spożywczych i nie będzie wyświetlana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque os gastos necessários em Categorias («Gastos necessários») — sem isso, a dica não consegue distinguir um agrado das compras de mercado e não aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте необходимые траты в «Категориях» («Необходимая трата») — без них подсказка не отличит мелочь от продуктов и молчит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoriler'de zorunlu harcamaları işaretleyin («Zorunlu harcama»). Bu işaretler olmadan ipucu, keyfi harcamaları market alışverişinden ayıramaz ve gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте необхідні витрати в категоріях («Необхідні витрати») — без цього підказка не відрізняє приємну дрібницю від продуктів і мовчить."
          }
        }
      }
    },
    "settings.hints.creditHistory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадваць пра крэдытную гісторыю"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An die Kreditauskunft erinnern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind about the credit history"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordar el historial crediticio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappeler l'historique de crédit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria sulla storia creditizia"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Несие тарихы туралы еске салу"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypominaj o historii kredytowej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrar do histórico de crédito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминать о кредитной истории"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi geçmişini hatırlat"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадувати про кредитну історію"
          }
        }
      }
    },
    "settings.hints.creditHistoryHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "1 лютага і 1 жніўня: запытайце сваю крэдытную гісторыю — бясплатна двойчы на год у кожным бюро праз Gosuslugi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am 1. Februar und 1. August: Fordern Sie Ihre Kreditauskunft an — bei jeder Auskunftei zweimal im Jahr kostenlos, über Gosuslugi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On 1 February and 1 August: ask for your credit history — free twice a year in each bureau, through Gosuslugi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 1 de febrero y el 1 de agosto: pedir el historial crediticio — gratis dos veces al año en cada oficina de crédito, a través de Gosuslugi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 1er février et le 1er août : demander votre historique de crédit — gratuit deux fois par an auprès de chaque bureau, via Gosuslugi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 1º febbraio e il 1º agosto: richiedi la tua storia creditizia, gratis due volte all’anno presso ogni ufficio, tramite Gosuslugi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ақпан мен 1 тамызда: несие тарихыңызды сұратыңыз — Gosuslugi арқылы әр бюродан жылына екі рет тегін"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 lutego i 1 sierpnia: poproś o historię kredytową — dwa razy w roku bezpłatnie w każdym biurze, przez Gosuslugi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 1º de fevereiro e 1º de agosto: solicite seu histórico de crédito — grátis duas vezes por ano em cada bureau, pelo Gosuslugi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 февраля и 1 августа: запросите кредитную историю — дважды в год бесплатно в каждом бюро, через Госуслуги"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Şubat ve 1 Ağustos'ta kredi geçmişinizi istemenizi hatırlatır. Gosuslugi üzerinden her bürodan yılda iki kez ücretsiz alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1 лютого й 1 серпня: запитати кредитну історію — безкоштовно двічі на рік у кожному бюро через Держпослуги"
          }
        }
      }
    },
