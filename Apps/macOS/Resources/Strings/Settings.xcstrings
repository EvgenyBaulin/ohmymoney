                "stringUnit": {
                  "state": "translated",
                  "value": "Будут удалены %lld копии старше года"
                }
              }
            }
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Буде видалено %lld копії старше року"
                }
              },
              "many": {
