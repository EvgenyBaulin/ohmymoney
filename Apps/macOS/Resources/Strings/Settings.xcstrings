    "references.restore.nameTaken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» застанецца ў архіве: іншы запіс мае такую ж назву. Змяніце назву аднаго з іх або аб’яднайце іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ bleibt im Archiv: Ein anderer Eintrag hat seinen Namen. Benennen Sie einen davon um oder führen Sie sie zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» stays in the archive: another record has its name. Rename one of them, or merge them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se queda en el archivo: otro registro tiene su nombre. Renombre uno de ellos, o fusiónelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » reste aux archives : un autre enregistrement porte ce nom. Renommez l'un d'eux, ou fusionnez-les."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» resta in archivio: un altro elemento ha lo stesso nome. Rinomina uno dei due o uniscili."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» мұрағатта қалады: бұл атау басқа жазбада бар. Біреуінің атауын өзгертіңіз немесе біріктіріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» остаётся в архиве: это название уже у другой записи. Переименуйте одну из них или объедините их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» залишається в архіві: інший запис має цю назву. Перейменуйте один із них або об'єднайте."
          }
        }
      }
    },
