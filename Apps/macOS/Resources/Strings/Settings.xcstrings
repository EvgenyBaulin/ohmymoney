    "settings.updates.automatic": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for and install updates automatically"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar e instalar actualizaciones automáticamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверять и устанавливать обновления автоматически"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряти й установлювати оновлення автоматично"
          }
        }
      }
    },
    "settings.updates.automaticHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day the app looks for a new version, downloads it in the background and installs it on quit. Off: an update comes only through “Check for Updates…”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día la app busca una versión nueva, la descarga en segundo plano y la instala al salir. Desactivado: una actualización llega solo por «Buscar actualizaciones…»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день приложение ищет новую версию, скачивает её в фоне и ставит при выходе. Выключено: обновление придёт только по «Проверить обновления…»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на день застосунок шукає нову версію, завантажує її у фоні й установлює під час виходу. Якщо вимкнено, оновлення доступні лише через «Перевірити оновлення…»."
          }
        }
      }
    },
    "settings.updates.unavailableHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not look for updates: it carries no key to check the signature of an update with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no busca actualizaciones: no lleva la clave para verificar la firma de una actualización."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка не ищет обновлений: в ней нет ключа, которым проверяется подпись обновления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збірка не шукає оновлень: у ній немає ключа для перевірки підпису оновлення."
          }
        }
      }
    },
