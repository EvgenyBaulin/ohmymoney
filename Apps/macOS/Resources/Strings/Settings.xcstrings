    "currencies.custom.firstRateHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş buraxmaq olar: ilk məzənnə daxil edilənədək bu valyutadakı məbləğlərin məzənnəsi olmayacaq — rubl məbləği təxmin edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна пакінуць пустым: да ўводу першага курсу сумы ў гэтай валюце не маюць курсу — сума ў рублях не вылічваецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete ponechat prázdné. Dokud nezadáte první kurz, částky v této měně kurz nemají — hodnota v rublech se neodhaduje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darf leer bleiben: Bis zum ersten Kurs haben Beträge in dieser Währung keinen Kurs — Rubel werden nie geschätzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May be left empty: until the first rate, amounts in this currency have no rate — rubles are never guessed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede quedar vacío: hasta el primer tipo, los importes de esta divisa no tienen tipo — los rublos nunca se adivinan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut rester vide : jusqu'au premier cours, les montants de cette devise n'ont pas de taux — les roubles ne sont jamais devinés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարելի է դատարկ թողնել․ մինչև առաջին փոխարժեքի մուտքագրումը այս արժույթով գումարները փոխարժեք չեն ունենա․ ռուբլով արժեքը չի ենթադրվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi lasciare vuoto: fino al primo cambio, gli importi in questa valuta non hanno un cambio; i rubli non vengono stimati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄のままにできます。最初のレートを入力するまで、この通貨の金額は換算されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეგიძლიათ ცარიელი დატოვოთ: პირველი კურსის მითითებამდე ამ ვალუტის თანხებს კურსი არ ექნება — რუბლის თანხა ვარაუდით არ განისაზღვრება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бос қалуы мүмкін: алғашқы бағамға дейін осы валютадағы сомаларда бағам жоқ — рубль ешқашан болжанбайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бош калтырса болот: биринчи курс киргизилгенге чейин бул валютадагы суммалардын курсу болбойт — рублдагы сумма болжолдонбойт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag leeg blijven: tot de eerste koers is ingevoerd, hebben bedragen in deze valuta geen koers. Bedragen in roebels worden niet geschat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można pozostawić puste: do czasu podania pierwszego kursu kwoty w tej walucie nie mają kursu — wartość w rublach nie jest szacowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser deixado em branco. Até a primeira cotação, os valores nesta moeda ficam sem conversão para rublos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode deixar em branco: até à primeira taxa, os montantes nesta moeda não têm taxa de câmbio; o valor em rublos nunca é estimado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно оставить пустым: до первого курса у сумм в этой валюте курса нет — рубли не угадываются."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Метавон холӣ гузошт: то ворид шудани қурби аввал маблағҳои ин асъор қурб надоранд — маблағи рублӣ тахмин карда намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş bırakılabilir: İlk kur girilene kadar bu para birimindeki tutarların kuru olmaz; ruble tutarı tahmin edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна залишити порожнім: до першого курсу суми в цій валюті не мають курсу — рублі не вгадуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo‘sh qoldirish mumkin: birinchi kurs kiritilguncha bu valyutadagi summalar kurssiz qoladi — rubldagi qiymat taxmin qilinmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以留空：输入首个汇率前，此货币的金额没有汇率，系统不会估算卢布金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可留空：在輸入第一筆匯率前，此貨幣的金額沒有匯率，不會推算盧布金額。"
          }
        }
      }
    },
    "currencies.custom.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusiya Bankının dərc etmədiyi valyutalar — tokenlər, xallar: ISO kodu olmayan üç böyük latın hərfindən ibarət kod və tarixçəsi saxlanılan, özünüzün daxil etdiyi məzənnə. Bunlar üçün banka sorğu göndərilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюты, для якіх Банк Расіі не публікуе курс: токены, балы. Код з трох вялікіх лацінскіх літар, які не з'яўляецца кодам ISO, і курс з гісторыяй уводзяцца ўручную. Запыты ў банк па іх не адпраўляюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měny, které Ruská centrální banka nezveřejňuje — tokeny a body: kód tvoří tři velká písmena latinky, která nejsou kódem ISO. Kurz zadáváte sami a ukládá se jeho historie. Banka se na tyto měny nedotazuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Währungen, die die Bank of Russia nicht veröffentlicht — Token, Punkte: ein Code aus drei großen lateinischen Buchstaben, der kein ISO-Code ist, mit einem Kurs, den Sie selbst eintragen, samt Verlauf. Die Bank wird danach nie gefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currencies the Bank of Russia does not publish — tokens, points: a code of three capital Latin letters that is no ISO code, a rate you type yourself, with its history. The bank is never asked for them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisas que el Banco de Rusia no publica — tokens, puntos: un código de tres letras latinas mayúsculas que no es código ISO, un tipo que escribe usted mismo, con su historial. Al banco nunca se le pregunta por ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devises que la Banque de Russie ne publie pas — jetons, points : un code de trois lettres latines majuscules qui n'est pas un code ISO, un cours que vous saisissez vous-même, avec son historique. La banque n'est jamais interrogée à leur sujet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արժույթներ, որոնք Ռուսաստանի բանկը չի հրապարակում՝ տոկեններ, միավորներ։ Կոդը երեք լատինատառ մեծատառ է և ISO կոդ չէ։ Փոխարժեքը մուտքագրում եք ինքներդ․ դրա պատմությունը պահպանվում է։ Բանկից այդ փոխարժեքները չեն հարցվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valute non pubblicate dalla Banca di Russia, come token e punti: un codice di tre lettere latine maiuscole che non sia un codice ISO e un cambio da inserire a mano, con la relativa cronologia. Non vengono richieste alla banca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロシア銀行が公表しないトークンやポイントなどの通貨です。ISO通貨コードと重複しない英大文字3文字のコードと、手動で入力するレートを履歴とともに管理します。銀行への照会は行いません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალუტები, რომელთა კურსსაც რუსეთის ბანკი არ აქვეყნებს — ტოკენები, ქულები: სამი დიდი ლათინური ასოსგან შემდგარი კოდი, რომელიც ISO კოდი არ არის, და თქვენ მიერ მითითებული კურსი თავისი ისტორიით. მათი კურსი ბანკიდან არ მოითხოვება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресей Банкі жарияламайтын валюталар — токендер, ұпайлар: ISO кодына ұқсамайтын үш бас латын әрпі, өзіңіз теретін бағам және оның тарихы. Банктен оларға ешқашан сұралмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Россия Банкы жарыялабаган валюталар — токендер, упайлар: үч баш латын тамгасынан турган, ISO коду болбогон код жана тарыхы сакталган, кол менен киргизилген курс. Алар үчүн банктан маалымат суралбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta waarvoor de Bank of Russia geen koers publiceert, zoals tokens en punten: een code van drie Latijnse hoofdletters die geen ISO-code is en een koers met geschiedenis die je zelf invoert. De bank wordt hiervoor niet geraadpleegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waluty, których Bank of Russia nie publikuje — tokeny i punkty: kod z trzech wielkich liter łacińskich, który nie jest kodem ISO, oraz wpisywany ręcznie kurs z historią. Bank nie jest o nie pytany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Moedas que o Banco da Rússia não publica, como tokens e pontos: um código de três letras latinas maiúsculas que não seja um código ISO e uma cotação inserida por você, com histórico. O banco não é consultado para essas moedas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Moedas que o Banco da Rússia não publica, como tokens e pontos: um código de três letras latinas maiúsculas que não seja um código ISO e uma taxa introduzida por si, com histórico. O banco nunca é consultado para estas moedas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюты, которых нет у ЦБ, — токены, баллы: код из трёх латинских заглавных букв (не код ISO), курс вписываете сами, с историей. ЦБ эти коды не спрашивает."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Асъорҳое, ки Бонки Русия нашр намекунад — токенҳо, холҳо: рамзи сеҳарфӣ бо ҳарфҳои калони лотинӣ, ки рамзи ISO нест, ва қурбе, ки худатон бо таърихаш ворид мекунед. Барои онҳо ба бонк дархост фиристода намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusya Merkez Bankası'nın yayımlamadığı para birimleri — tokenlar, puanlar: ISO kodu olmayan üç büyük Latin harfinden oluşan bir kod ve geçmişiyle birlikte elle girdiğiniz bir kur. Bunlar için bankadan kur alınmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюти, які не публікує Банк Росії, — токени, бали: код із трьох великих латинських літер, що не є кодом ISO, власний курс та його історія. До банку за ними не звертаються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rossiya banki e’lon qilmaydigan valyutalar — tokenlar, ballar: uchta katta lotin harfidan iborat ISO kodi bo‘lmagan kod va o‘zingiz kiritadigan, tarixi saqlanadigan kurs. Ular uchun bankka so‘rov yuborilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于俄罗斯银行不发布汇率的货币，如代币和积分。使用三个大写拉丁字母作为代码，且不能是 ISO 代码；汇率由你输入并保留历史记录。系统不会向银行查询这些货币的汇率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於 Bank of Russia 未公布匯率的貨幣，例如代幣或點數。代碼須為三個大寫拉丁字母，且不能是 ISO 貨幣代碼；匯率由你自行輸入並保留歷史記錄。不會向銀行查詢這些貨幣。"
          }
        }
      }
    },
