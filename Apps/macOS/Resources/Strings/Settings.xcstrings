        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "de meegestuurde instellingen: taal, thema, valuta's, drempels en schakelaars"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "przenoszone ustawienia: język, motyw, waluty, progi i przełączniki"
          }
        },
        "pt-BR": {
          "stringUnit": {
