    "categories.appearance.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Simvolu olmayan kateqoriya əməliyyatlar siyahısında növünün işarəsi ilə göstərilir; alt kateqoriya isə kateqoriyasının simvolunu istifadə edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для катэгорыі без сімвала ў спісе аперацый паказваецца значок яе тыпу; падкатэгорыя выкарыстоўвае сімвал сваёй катэгорыі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie bez symbolu se v seznamu operací zobrazuje se značkou svého typu. Podkategorie přebírá symbol své kategorie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kategorie ohne Symbol zeigt in der Liste der Vorgänge das Zeichen ihrer Art; eine Unterkategorie folgt ihrer Kategorie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A category without a symbol shows the mark of its kind in the list of operations; a subcategory follows its category."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoría sin símbolo muestra la marca de su tipo en la lista de operaciones; una subcategoría sigue a su categoría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une catégorie sans symbole affiche le repère de son type dans la liste des opérations ; une sous-catégorie suit sa catégorie."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց սեփական նշանի կատեգորիան գործարքների ցանկում ցուցադրվում է իր տեսակի նշանով, իսկ ենթակատեգորիան՝ իր կատեգորիայի նշանով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoria senza simbolo mostra quello del suo tipo nell’elenco delle operazioni; una sottocategoria usa quello della categoria principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンボルのないカテゴリには、取引一覧で種類に応じたマークが表示されます。サブカテゴリは親カテゴリに従います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორია სიმბოლოს გარეშე ოპერაციების სიაში თავისი ტიპის ნიშნით გამოჩნდება; ქვეკატეგორია მთავარი კატეგორიის ნიშანს გამოიყენებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгісі жоқ санат операциялар тізімінде өз түрінің таңбасын көрсетеді; ішкі санат өз санатына ілеседі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгиси жок категория операциялар тизмесинде өз түрүнүн белгиси менен көрсөтүлөт; ички категория негизги категориянын белгисин колдонот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een categorie zonder symbool toont het symbool van de soort in de transactielijst. Een subcategorie volgt de bovenliggende categorie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria bez symbolu używa na liście operacji symbolu swojego rodzaju. Podkategoria używa symbolu swojej kategorii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma categoria sem símbolo mostra a marca do seu tipo na lista de operações. Uma subcategoria usa o símbolo da categoria."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma categoria sem símbolo apresenta o símbolo do respetivo tipo na lista de operações; uma subcategoria segue a categoria principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория без значка показывает в «Операциях» значок вида операции; подкатегория берёт значок категории."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияи бе аломат дар рӯйхати амалиёт аломати навъи худро нишон медиҳад; зеркатегория аломати категорияи асосиро мегирад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembolü olmayan bir kategori, işlem listesinde türünün işaretiyle gösterilir. Alt kategori, üst kategorisinin işaretini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія без значка показує позначку свого виду в списку операцій; підкатегорія успадковує значок категорії."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgisiz turkum operatsiyalar ro‘yxatida o‘z turiga mos belgi bilan ko‘rinadi; kichik turkum esa asosiy turkum belgisini oladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有符号的类别会在交易列表中显示其类型标记；子类别跟随所属类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有符號的類別會在交易列表中顯示其類型的標記；子類別則沿用上層類別的設定。"
          }
        }
      }
    },
