    "categories.cashbackHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kateqoriyadakı və alt kateqoriyalarındakı gəlirlər Analitikada keşbek kimi hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход у гэтай катэгорыі і яе падкатэгорыях улічваецца ў аналітыцы як кэшбэк."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjmy v této kategorii a jejích podkategoriích se v Analýze počítají jako cashback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmen in dieser Kategorie und ihren Unterkategorien zählen in der Auswertung als Cashback."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income in this category and its subcategories counts as cashback in Analytics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ingreso en esta categoría y en sus subcategorías cuenta como cashback en Analítica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revenu dans cette catégorie et ses sous-catégories compte comme cashback dans l'Analyse."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս կատեգորիայի և դրա ենթակատեգորիաների եկամուտը Վերլուծությունում հաշվվում է որպես քեշբեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate in questa categoria e nelle sue sottocategorie sono conteggiate come cashback in Analisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカテゴリとサブカテゴリの収入は、分析でキャッシュバックとして集計されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ კატეგორიისა და მისი ქვეკატეგორიების შემოსავალი ანალიტიკაში ქეშბექად ჩაითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы санаттағы және оның ішкі санаттарындағы табыс Аналитикада кешбэк болып саналады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул категориядагы жана анын ички категорияларындагы киреше Аналитикада кэшбэк катары эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomsten in deze categorie en de subcategorieën tellen mee als cashback in de analyse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przychody w tej kategorii i jej podkategoriach są uwzględniane jako cashback w analizie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As receitas nesta categoria e em suas subcategorias contam como cashback em Análises."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os rendimentos nesta categoria e nas respetivas subcategorias contam como cashback na Análise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход в этой категории и её подкатегориях Analytics считает кэшбэком."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади ин категория ва зеркатегорияҳои он дар Таҳлил ҳамчун кешбэк ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kategorideki ve alt kategorilerindeki gelirler, Analiz’de nakit iade olarak sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід у цій категорії та її підкатегоріях враховується як кешбек в аналітиці."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu turkum va uning kichik turkumlaridagi daromadlar tahlilda keshbek sifatida hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此类别及其子类别中的收入在分析中计为返现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此類別及其子類別的收入會在分析中計為現金回饋。"
          }
        }
      }
    },
    "categories.cashbackRulesHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözlənilən keşbek hesabların qaydalarına əsasən müəyyən edilir: hesab ekranında və ya Parametrlər → Hesablar → “Keşbek…” bölməsində. Borc ödənişinə keşbek verilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканы кэшбэк вызначаецца правіламі рахункаў: на экране рахунку або ў Налады → Рахункі → “Кэшбэк…”. За выплату доўгу кэшбэк не налічваецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Očekávaný cashback určují pravidla účtů: na obrazovce účtu nebo v Nastavení → Účty → „Cashback…“. Platby na dluh cashback nepřinášejí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Cashback zu erwarten ist, legen die Regeln der Konten fest: auf dem Bildschirm des Kontos oder in Einstellungen → Konten → „Cashback…“. Eine Zahlung auf eine Schuld bringt keinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much cashback to expect is set by the rules of the accounts: on the account screen or in Settings → Accounts → “Cashback…”. A payment on a debt earns none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto cashback esperar lo fijan las reglas de las cuentas: en la pantalla de la cuenta o en Ajustes → Cuentas → «Cashback…». Un pago de deuda no genera ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback attendu se fixe par les règles des comptes : sur l'écran du compte ou dans Réglages → Comptes → « Cashback… ». Un paiement de dette n'en rapporte aucun."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասվող քեշբեքի չափը սահմանվում է հաշիվների կանոններով՝ հաշվի էկրանին կամ Կարգավորումներ → Հաշիվներ → «Քեշբեք…» բաժնում։ Պարտքի վճարումից քեշբեք չի հաշվարկվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cashback previsto è definito dalle regole dei conti: nella schermata del conto o in Impostazioni → Conti → “Cashback…”. I pagamenti dei debiti non danno diritto al cashback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュバックの予定額は、口座のルールで設定します。口座画面または「設定」→「口座」→「キャッシュバック…」で設定できます。借入金の返済には適用されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოსალოდნელი ქეშბექი ანგარიშების წესებით განისაზღვრება: ანგარიშის ეკრანზე ან პარამეტრები → ანგარიშები → „ქეშბექი…“. ვალის გადახდაზე ქეშბექი არ ირიცხება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтілетін кешбэк көлемін есеп-шоттың ережелері белгілейді: есеп-шот экранында немесе Параметрлер → Есеп-шоттар → «Кешбэк…». Берешек бойынша төлем кешбэк бермейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күтүлгөн кэшбэктин өлчөмү эсептердин эрежелеринде коюлат: эсептин экранында же Жөндөөлөр → Эсептер → “Кэшбэк…”. Карызды төлөө үчүн кэшбэк берилбейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verwachte cashback wordt bepaald door de regels van de rekeningen: op het rekeningoverzicht of in Instellingen → Rekeningen → “Cashback…”. Een betaling op een schuld levert geen cashback op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwany cashback określają reguły konta: na ekranie konta lub w Ustawienia → Konta → „Cashback…”. Spłata długu nie daje cashbacku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback esperado é definido pelas regras das contas, na tela da conta ou em Ajustes → Contas → “Cashback…”. Pagamentos de dívidas não geram cashback."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cashback previsto é definido pelas regras das contas: no ecrã da conta ou em Definições → Contas → “Cashback…”. Um pagamento de dívida não dá direito a cashback."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько кэшбэка ждать, задают правила счетов: экран счёта или «Настройки → Счета» → «Кэшбэк…». За платёж по долгу кэшбэк не платят."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Андозаи кешбэки пешбинишуда дар қоидаҳои ҳисобҳо муайян мешавад: дар саҳифаи ҳисоб ё дар Танзимот → Ҳисобҳо → “Кешбэк…”. Барои пардохти қарз кешбэк дода намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenen nakit iade, hesapların kurallarına göre belirlenir. Hesap ekranından veya Ayarlar → Hesaplar → “Nakit İade…” bölümünden ayarlayabilirsiniz. Borç ödemeleri nakit iade kazandırmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний кешбек визначають правила рахунків: на екрані рахунку або в «Налаштування → Рахунки → Кешбек…». Платіж за боргом кешбеку не дає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutilayotgan keshbek miqdori hisob qoidalarida belgilanadi: hisob ekranida yoki Sozlamalar → Hisoblar → “Keshbek…” bo‘limida. Qarzni to‘lash uchun keshbek berilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计返现金额由账户规则决定，可在账户页面或“设置”→“账户”→“返现…”中设置。偿还债务不会获得返现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預期現金回饋依帳戶規則計算，可在帳戶畫面或「設定」→「帳戶」→「現金回饋⋯」中設定。債務還款不會獲得回饋。"
          }
        }
      }
    },
    "categories.delete.blocked": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» kateqoriyası %2$@ tərəfindən istifadə olunur. Bunun əvəzinə kateqoriyanı arxivə köçürün."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» выкарыстоўваецца: %2$@. Замест выдалення змясціце катэгорыю ў архіў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» využívá %2$@. Přesuňte kategorii do archivu."
