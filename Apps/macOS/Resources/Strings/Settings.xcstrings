    "categories.delete.withChildren.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» і яе %2$@ нідзе не выкарыстоўваюцца. “Адмяніць” верне іх назад."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und ihre %2$@ werden von nichts genutzt. „Rückgängig“ holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» and its %2$@ are used by nothing. “Undo” brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» y sus %2$@ no los usa nada. «Deshacer» los devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et ses %2$@ ne sont utilisées par rien. « Annuler » les rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e le sue %2$@ non sono usate. Tocca “Annulla” per ripristinarle."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» және оның %2$@ ешкім қолданбайды. «Болдырмау» оларды қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria «%1$@» i jej podkategorie (%2$@) nie są używane. Wybierz „Cofnij”, aby je przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e suas %2$@ não estão em uso. Toque em “Desfazer” para restaurá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» и %2$@ ничем не заняты. «Отменить» вернёт их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ve %2$@ kullanılmıyor. “Geri Al” ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» та її %2$@ ніде не використовуються. «Скасувати дію» повертає їх."
          }
        }
      }
    },
