    "templates.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar daxil etdiklərinizdən avtomatik yaranır. Bərkidilmişlər həmişə əvvəl göstərilir. Arxivdəki şablon seçimlərdən silinir və «Geri qaytar» ilə bərpa olunur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны ствараюцца аўтаматычна з уведзеных вамі даных. Замацаваныя заўсёды паказваюцца першымі. Шаблон у архіве знікае з хуткага выбару; каб вярнуць яго, націсніце «Вярнуць»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šablony se vytvářejí automaticky podle vašich záznamů. Připnuté šablony zůstávají vždy nahoře. Archivovaná šablona zmizí z nabídky a můžete ji vrátit volbou «Vrátit»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen füllen sich aus dem, was Sie eingeben. Angeheftete bleiben immer vorn. Eine Vorlage im Archiv verschwindet aus den Chips und kommt mit „Zurückholen“ wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates fill themselves from what you enter. Pinned ones always stay first. A template in the archive leaves the chips and comes back with «Bring back»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas se rellenan solas con lo que introduce. Las fijadas siempre van primero. Una plantilla en el archivo sale de los chips y vuelve con «Recuperar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles se remplissent d'eux-mêmes d'après ce que vous saisissez. Les épinglés restent toujours en premier. Un modèle aux archives quitte les pastilles et revient avec « Ramener »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձևանմուշներն ավտոմատ լրացվում են ձեր մուտքագրած տվյալներից։ Ամրացվածները միշտ առաջինն են։ Արխիվացված ձևանմուշը հեռացվում է ցանկից և վերադարձվում է «Վերականգնել» հրամանով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli si compilano in base ai dati inseriti. Quelli fissati restano sempre in cima. Un modello archiviato scompare dai suggerimenti e può essere ripristinato con «Ripristina»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートは入力内容から自動的に作成されます。ピンで固定したものは常に先頭に表示されます。アーカイブしたテンプレートはチップから消え、「元に戻す」で再表示できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შაბლონები თქვენი ჩანაწერების მიხედვით ავტომატურად ივსება. მიმაგრებული შაბლონები ყოველთვის პირველია. არქივში გადატანილი შაბლონი სიიდან ქრება და «დაბრუნებით» აღდგება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлгілер енгізгендеріңізден өзі толтырылады. Бекітілгендері әрдайым алда тұрады. Мұрағаттағы үлгі батырмалардан жоғалып, «Қайтару» арқылы оралады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлгүлөр сиз киргизген маалыматтан автоматтык түрдө толукталат. Кадалгандар дайыма башында турат. Архивделген үлгү тизмеден алынып, «Кайтаруу» аркылуу калыбына келтирилет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjablonen worden automatisch aangemaakt op basis van je invoer. Vastgemaakte sjablonen staan altijd bovenaan. Een gearchiveerd sjabloon verdwijnt uit de lijst en kun je terugzetten met «Zet terug»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablony tworzą się automatycznie na podstawie wpisywanych danych. Przypięte szablony są zawsze na początku. Szablon przeniesiony do archiwum znika z listy i można go przywrócić opcją «Przywróć»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos são preenchidos automaticamente com o que você informa. Os fixados ficam sempre no início. Um modelo arquivado deixa de aparecer nas sugestões e volta com «Restaurar»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos são preenchidos automaticamente com os dados que introduz. Os afixados aparecem sempre primeiro. Um modelo arquivado deixa de aparecer nas opções e pode ser reposto com «Repor»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны сами набираются из того, что вы вводите. Закреплённые всегда идут первыми. Шаблон в архиве уходит из чипов и возвращается кнопкой «Вернуть»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблонҳо аз маълумоти воридкардаи шумо худкор пур мешаванд. Шаблонҳои санҷоқшуда ҳамеша дар аввал мемонанд. Шаблони бойгонишуда аз рӯйхати интихобҳо нопадид мешавад ва бо «Баргардонед» бармегардад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar girdiklerinize göre otomatik doldurulur. Sabitlenenler her zaman başta kalır. Arşivlenen şablon listeden kaldırılır ve «Geri Getir» ile geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони створюються з ваших записів. Закріплені завжди перші. Шаблон в архіві зникає з підказок і повертається через «Повернути»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shablonlar kiritgan ma’lumotlaringizdan avtomatik to‘ldiriladi. Qadab qo‘yilganlari doim birinchi turadi. Arxivdagi shablon tugmachalar orasidan yo‘qoladi va «Qaytarish» orqali tiklanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板会根据你输入的内容自动填充。置顶的模板始终排在前面。归档的模板会从快捷选项中移除，选择 «恢复» 可将其找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本會依據你輸入的內容自動填入。釘選的範本會保持在最前方。封存的範本會從快捷選項中移除，可使用«還原»將其恢復。"
          }
        }
      }
    },
