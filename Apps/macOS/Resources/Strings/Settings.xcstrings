    "categories.system.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма захоўвае гэту катэгорыю для ўласнага ўліку. Яе можна перайменаваць, але нельга архіваваць ці выдаліць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App behält diese Kategorie für ihre eigenen Aufzeichnungen. Sie kann umbenannt, aber nicht archiviert oder gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app keeps this category for its own records. It can be renamed, but not archived or deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app guarda esta categoría para sus propios registros. Se puede renombrar, pero no archivar ni eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app garde cette catégorie pour ses propres registres. Elle peut être renommée, mais ni archivée ni supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app usa questa categoria per le proprie registrazioni. Puoi rinominarla, ma non archiviarla né eliminarla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба бұл санатты өз жазбалары үшін сақтайды. Оны қайта атауға болады, бірақ мұрағатқа өткізуге не жоюға болмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja używa tej kategorii do własnych zapisów. Można zmienić jej nazwę, ale nie można jej zarchiwizować ani usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app mantém esta categoria para seus próprios registros. Ela pode ser renomeada, mas não arquivada nem apagada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту категорию приложение ведёт само. Её можно переименовать, но нельзя архивировать или удалить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bu kategoriyi kendi kayıtları için tutar. Adı değiştirilebilir, ancak arşivlenemez veya silinemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок використовує цю категорію для власних записів. Її можна перейменувати, але не архівувати чи видаляти."
          }
        }
      }
    },
