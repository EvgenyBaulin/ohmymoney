    "archive.import.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма працуе ў рэжыме толькі для чытання: імпарт немагчымы. Спачатку выйдзіце з гэтага рэжыму."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist nur lesbar: Ein Import ist nicht möglich. Verlassen Sie zuerst den Modus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is read-only: an import is not possible. Leave the mode first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app está en solo lectura: no es posible importar. Salga antes del modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app est en lecture seule : l'import n'est pas possible. Quittez d'abord ce mode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app è in sola lettura: impossibile importare. Esci prima da questa modalità."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба тек оқу режимінде: импорттау мүмкін емес. Алдымен режимнен шығыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим «Только просмотр»: импорт недоступен. Сначала выйдите из режима."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок у режимі лише перегляду: імпорт неможливий. Спочатку вийдіть із режиму."
          }
        }
      }
    },
