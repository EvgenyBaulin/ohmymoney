    "settings.entry.returnHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "↓ paneli açıq olduqda Return kursorun yerindən asılı olmayaraq əməliyyatı saxlayır; açıq menyuda isə elementi seçir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Return у адкрытай панэлі ↓ захоўвае аперацыю незалежна ад становішча курсора; у адкрытым меню Return выбірае пункт."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesa Return v otevřeném panelu ↓ uloží operaci bez ohledu na polohu kurzoru; v otevřené nabídce vybere položku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Return im geöffneten Bedienfeld ↓ sichert den Vorgang, wo der Cursor steht; in einem geöffneten Menü wählt Return den Eintrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return in the open ↓ panel saves the operation wherever the cursor is; in an open menu Return picks the item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intro en el panel ↓ abierto guarda la operación donde esté el cursor; en un menú abierto, Intro elige el elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour dans le panneau ↓ ouvert enregistre l'opération où que se trouve le curseur ; dans un menu ouvert, Retour choisit l'élément."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բաց ↓ վահանակում Return-ը պահում է գործարքը՝ անկախ կուրսորի դիրքից, իսկ բաց ընտրացանկում՝ ընտրում տարրը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel pannello ↓ aperto, Invio salva l’operazione ovunque si trovi il cursore; in un menu aperto, Invio seleziona la voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↓パネルが開いているときは、カーソルの位置に関係なくReturnキーで取引を保存します。メニューが開いているときは、Returnキーで項目を選択します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ღია ↓ პანელში Return ინახავს ოპერაციას კურსორის მდებარეობის მიუხედავად; ღია მენიუში Return ირჩევს ელემენტს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашық ↓ панелінде Return меңзер қайда болса да операцияны сақтайды; ашық мәзірде Return тармақты таңдайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ачык ↓ панелинде Return курсор кайда турбасын операцияны сактайт; ачык менюда Return пунктту тандайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met Return bewaar je de transactie vanuit het geopende ↓-paneel, ongeacht waar de cursor staat. In een open menu selecteer je met Return een onderdeel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz Return w otwartym panelu ↓ zapisuje operację niezależnie od położenia kursora; w otwartym menu wybiera pozycję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o painel ↓ aberto, Return salva a operação onde quer que esteja o cursor; em um menu aberto, Return seleciona o item."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o painel ↓ aberto, Return guarda a operação onde quer que esteja o cursor; num menu aberto, Return seleciona o elemento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Return в открытой панели ↓ сохраняет операцию, где бы ни был курсор; в открытом списке Return выбирает пункт."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар панели кушодаи ↓ тугмаи Return амалиётро дар ҳар ҷои курсор бошад, нигоҳ медорад; дар менюи кушода ҷузъро интихоб мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık ↓ panelinde Return, imleç nerede olursa olsun işlemi kaydeder; açık bir menüde ise öğeyi seçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Return на відкритій панелі ↓ зберігає операцію незалежно від положення курсора; у відкритому меню Return вибирає пункт."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochiq ↓ panelida kursor qayerda bo‘lishidan qat’i nazar, Return operatsiyani saqlaydi; ochiq menyuda esa elementni tanlaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "↓ 面板打开时，无论光标位于何处，按 Return 键都会存储交易；菜单打开时，按 Return 键会选取项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在開啟的 ↓ 面板中，無論游標位於何處，按 Return 都會儲存交易；在開啟的選單中，按 Return 可選取項目。"
          }
        }
      }
    },
