        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última cópia não passou na verificação de integridade"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A última cópia não passou na verificação de integridade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя копия не прошла проверку целостности"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нусхаи охирин аз санҷиши яклухтӣ нагузашт"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kopya bütünlük denetiminden geçemedi"
