    "settings.events.automaticHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: an event covering the day is only offered in the panel."
          }
        },
        "es": {
