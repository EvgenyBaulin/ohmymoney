    "backups.restore.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy is damaged and cannot be restored. Nothing was replaced."
          }
        },
        "es": {
