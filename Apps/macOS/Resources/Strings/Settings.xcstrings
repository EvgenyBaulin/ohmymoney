    "settings.hints.creditHistoryHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "1 fevral və 1 avqustda: kredit tarixçənizi Gosuslugi vasitəsilə sorğulayın — hər büroda ildə iki dəfə pulsuzdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "1 лютага і 1 жніўня: запытайце сваю крэдытную гісторыю — бясплатна двойчы на год у кожным бюро праз Gosuslugi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1. února a 1. srpna: požádejte o svou úvěrovou historii — dvakrát ročně zdarma v každém registru prostřednictvím Gosuslugi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am 1. Februar und 1. August: Fordern Sie Ihre Kreditauskunft an — bei jeder Auskunftei zweimal im Jahr kostenlos, über Gosuslugi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On 1 February and 1 August: ask for your credit history — free twice a year in each bureau, through Gosuslugi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 1 de febrero y el 1 de agosto: pedir el historial crediticio — gratis dos veces al año en cada oficina de crédito, a través de Gosuslugi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 1er février et le 1er août : demander votre historique de crédit — gratuit deux fois par an auprès de chaque bureau, via Gosuslugi"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փետրվարի 1-ին և օգոստոսի 1-ին՝ հարցում ուղարկեք ձեր վարկային պատմության համար։ Gosuslugi-ի միջոցով յուրաքանչյուր բյուրոյում տարեկան երկու անգամ անվճար է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 1º febbraio e il 1º agosto: richiedi la tua storia creditizia, gratis due volte all’anno presso ogni ufficio, tramite Gosuslugi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2月1日と8月1日に信用情報の取得をお知らせします。Gosuslugiを通じて、各信用情報機関で年2回無料で取得できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "1 თებერვალს და 1 აგვისტოს: გამოითხოვეთ საკრედიტო ისტორია — უფასოდ წელიწადში ორჯერ თითოეულ ბიუროში, Gosuslugi-ის მეშვეობით"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ақпан мен 1 тамызда: несие тарихыңызды сұратыңыз — Gosuslugi арқылы әр бюродан жылына екі рет тегін"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "1-февралда жана 1-августта: кредиттик тарыхыңызды суратыңыз — Gosuslugi аркылуу ар бир бюродон жылына эки жолу акысыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op 1 februari en 1 augustus: vraag je kredietgeschiedenis op. Dit is bij elk bureau tweemaal per jaar gratis, via Gosuslugi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 lutego i 1 sierpnia: poproś o historię kredytową — dwa razy w roku bezpłatnie w każdym biurze, przez Gosuslugi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 1º de fevereiro e 1º de agosto: solicite seu histórico de crédito — grátis duas vezes por ano em cada bureau, pelo Gosuslugi"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A 1 de fevereiro e 1 de agosto: peça o seu histórico de crédito — gratuito duas vezes por ano em cada entidade, através do Gosuslugi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 февраля и 1 августа: запросите кредитную историю — дважды в год бесплатно в каждом бюро, через Госуслуги"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "1 феврал ва 1 август: таърихи қарзатонро дархост кунед — соле ду бор дар ҳар бюро тавассути Госуслуги ройгон аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Şubat ve 1 Ağustos'ta kredi geçmişinizi istemenizi hatırlatır. Gosuslugi üzerinden her bürodan yılda iki kez ücretsiz alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1 лютого й 1 серпня: запитати кредитну історію — безкоштовно двічі на рік у кожному бюро через Держпослуги"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "1-fevral va 1-avgustda: kredit tarixingizni so‘rang — Gosuslugi orqali har bir byuroda yiliga ikki marta bepul"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 2 月 1 日和 8 月 1 日提醒查询信用记录：可通过 Gosuslugi 每年向每家征信机构免费查询两次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 2 月 1 日和 8 月 1 日提醒查詢信用紀錄：透過 Gosuslugi，每年可向各信用機構免費查詢兩次"
          }
        }
      }
    },
