    "settings.selfEmployed.referenceHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Закон у адпаведнасці з данымі OhMyMoney. Калі закон змяніўся да выхаду новай версіі, увядзіце сваё значэнне; пустое поле адпавядае закону."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gesetz, wie OhMyMoney es kennt. Hat sich das Gesetz geändert, bevor eine neue Version erschien, tragen Sie Ihren Wert ein; ein leeres Feld folgt dem Gesetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The law as OhMyMoney knows it. If the law changed before a new version came out, type your value; an empty field follows the law."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ley tal como la conoce OhMyMoney. Si la ley cambió antes de que saliera una versión nueva, escriba su valor; un campo vacío sigue la ley."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La loi telle qu'OhMyMoney la connaît. Si la loi a changé avant la sortie d'une nouvelle version, saisissez votre valeur ; un champ vide suit la loi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La legge secondo OhMyMoney. Se la legge cambia prima del rilascio di una nuova versione, inserisci il valore aggiornato; un campo vuoto usa il valore previsto dalla legge."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney білетін заң талаптары. Жаңа нұсқа шыққанға дейін заң өзгерсе, өз мәніңізді енгізіңіз; бос өріс заңға сай есептеледі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения закона, как их знает OhMyMoney. Если закон изменился раньше, чем вышла новая версия, впишите своё; пустое поле — как в законе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закон, відомий OhMyMoney. Якщо закон змінився до нової версії, введіть власне значення; порожнє поле відповідає закону."
          }
        }
      }
    },
