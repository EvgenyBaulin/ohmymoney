    "references.restore.nameTaken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» arxivdə qalır: bu ad başqa qeyddə istifadə olunur. Onlardan birinin adını dəyişin və ya onları birləşdirin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» застанецца ў архіве: іншы запіс мае такую ж назву. Змяніце назву аднаго з іх або аб’яднайце іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» zůstane v archivu: jiný záznam má stejný název. Jeden z nich přejmenujte nebo je slučte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ bleibt im Archiv: Ein anderer Eintrag hat seinen Namen. Benennen Sie einen davon um oder führen Sie sie zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» stays in the archive: another record has its name. Rename one of them, or merge them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se queda en el archivo: otro registro tiene su nombre. Renombre uno de ellos, o fusiónelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » reste aux archives : un autre enregistrement porte ce nom. Renommez l'un d'eux, ou fusionnez-les."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»-ը կմնա արխիվում․ մեկ այլ գրառում ունի նույն անունը։ Վերանվանեք դրանցից մեկը կամ միավորեք դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» resta in archivio: un altro elemento ha lo stesso nome. Rinomina uno dei due o uniscili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前の項目があるため、«%@»はアーカイブに残ります。いずれかの名前を変更するか、統合してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» დარჩება არქივში: სხვა ჩანაწერს იგივე სახელი აქვს. შეუცვალეთ სახელი ერთ-ერთს ან გააერთიანეთ ისინი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» мұрағатта қалады: бұл атау басқа жазбада бар. Біреуінің атауын өзгертіңіз немесе біріктіріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» архивде калат: башка жазуунун аты ушундай. Биринин атын өзгөртүңүз же аларды бириктириңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» blijft in het archief: een ander record heeft dezelfde naam. Wijzig een van de namen of voeg de records samen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» pozostaje w archiwum: inna pozycja ma tę samą nazwę. Zmień nazwę jednej z nich lub je scal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» permanece no arquivo: outro registro tem o mesmo nome. Renomeie um deles ou mescle os dois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» permanece no arquivo: outro registo tem o mesmo nome. Altere o nome de um deles ou combine-os."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» остаётся в архиве: это название уже у другой записи. Переименуйте одну из них или объедините их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» дар бойгонӣ мемонад: сабти дигаре ҳамин номро дорад. Номи яке аз онҳоро иваз кунед ё онҳоро якҷо кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» arşivde kalacak: başka bir kayıt bu adı kullanıyor. Kayıtlardan birinin adını değiştirin veya bunları birleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» залишається в архіві: інший запис має цю назву. Перейменуйте один із них або об'єднайте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» arxivda qoladi: bu nom boshqa yozuvda mavjud. Birining nomini o‘zgartiring yoki ularni birlashtiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»仍保留在归档中：另一条记录已使用该名称。请重新命名其中一条，或合并它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» 會保留在封存中：另一筆記錄使用了相同名稱。請重新命名其中一筆，或合併兩者。"
          }
        }
      }
    },
