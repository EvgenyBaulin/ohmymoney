    "categories.add.parentRefused": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыю можна змясціць толькі ў неархіўную катэгорыю таго ж тыпу. Выберыце бацькоўскую катэгорыю яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kategorie gehört nur unter eine Kategorie derselben Art, die nicht im Archiv ist. Wählen Sie die übergeordnete Kategorie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A category goes only under a category of the same kind that is not in the archive. Choose the parent again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoría solo va bajo una categoría del mismo tipo que no esté en el archivo. Elija de nuevo la categoría padre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une catégorie ne se place que sous une catégorie du même type qui n'est pas aux archives. Choisissez à nouveau la catégorie parente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoria può essere inserita solo in una categoria dello stesso tipo non archiviata. Scegli di nuovo la categoria principale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санат тек мұрағатта емес, сол түрдегі санаттың астына қосылады. Негізгісін қайта таңдаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria nadrzędna musi być tego samego rodzaju i nie może znajdować się w archiwum. Wybierz ją ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma categoria só pode ficar dentro de outra do mesmo tipo que não esteja arquivada. Escolha a categoria superior novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорию можно положить только в категорию того же вида, которая не в архиве. Выберите родителя ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kategori yalnızca aynı türde ve arşivde olmayan bir kategorinin altına eklenebilir. Üst kategoriyi yeniden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорію можна додати лише до неархівної категорії того самого виду. Виберіть батьківську категорію знову."
          }
        }
      }
    },
