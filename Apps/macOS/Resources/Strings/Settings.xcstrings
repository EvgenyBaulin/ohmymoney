    "settings.planning.reserveEvents": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep back what is left of the event budgets in «Free to spend»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descontar en «Libre para gastar» lo que queda de los presupuestos de eventos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenir le reste des budgets d'événements dans « Libre à dépenser »"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывать остаток бюджетов событий в «Свободной сумме»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервувати залишки бюджетів подій у «Можна витрачати»"
          }
        }
      }
    },
    "settings.planning.reserveEventsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is left of the budget of every event under way or about to start by the chosen date is not counted as free money; a payment tied to an event is part of that budget. Off, no budget is held back and a tied payment is held back as an ordinary one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que queda del presupuesto de cada evento en curso o a punto de empezar, hasta la fecha elegida, no cuenta como dinero libre; un pago ligado a un evento forma parte de ese presupuesto. Desactivado, no se descuenta ningún presupuesto y un pago ligado se descuenta como uno normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste du budget de chaque événement en cours ou sur le point de commencer, à la date choisie, n'est pas compté comme argent libre ; un paiement lié à un événement fait partie de ce budget. Désactivé, aucun budget n'est retenu et un paiement lié est retenu comme un paiement ordinaire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток бюджета каждого события, идущего сейчас или начинающегося до выбранной даты, не считается свободными деньгами; платёж, привязанный к событию, входит в этот остаток. Выключено — бюджеты событий не вычитаются, а привязанный платёж вычитается как обычный."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок бюджету кожної поточної події або події, що почнеться до вибраної дати, не вважається вільними грошима; пов'язаний із подією платіж — частина бюджету. Якщо вимкнено, бюджет не резервується, а пов'язаний платіж резервується як звичайний."
          }
        }
      }
    },
    "settings.planning.reserveHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planned contributions not yet made by the chosen date are not counted as free money."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aportaciones previstas que aún no se han hecho hasta la fecha elegida no cuentan como dinero libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contributions prévues et pas encore faites à la date choisie ne sont pas comptées comme argent libre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несделанные плановые взносы до выбранной даты не считаются свободными деньгами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заплановані внески, ще не зроблені до вибраної дати, не вважаються вільними грошима."
          }
        }
      }
    },
