        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» — «%2$@» атауларының бірі: енгізу жолы екеуін ажырата алмайды."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist bereits ein Name von „%2$@“: Die Eingabezeile könnte beide nicht unterscheiden."
