    "archive.error.checksum": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdəki faylın yoxlama cəmi uyğun gəlmir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кантрольная сума файла ў архіве не супадае"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolní součet souboru v archivu nesouhlasí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei im Archiv entspricht nicht ihrer Prüfsumme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file inside the archive does not match its checksum"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo dentro del archivo no coincide con su suma de control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier dans l'archive ne correspond pas à sa somme de contrôle"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվի ֆայլերից մեկը չի համապատասխանում իր ստուգիչ գումարին"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file nell’archivio non corrisponde al suo checksum"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ内のファイルのチェックサムが一致しません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივში არსებული ფაილის საკონტროლო ჯამი არ ემთხვევა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағат ішіндегі файл өзінің бақылау сомасына сәйкес келмейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивдеги файлдын текшерүү суммасы дал келбейт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De controlesom van een bestand in het archief klopt niet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma kontrolna pliku w archiwum jest niezgodna"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo dentro do arquivo compactado não corresponde à soma de verificação"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A soma de verificação de um ficheiro no arquivo não corresponde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл внутри архива не сходится с контрольной суммой"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷамъи санҷишии яке аз файлҳои бойгонӣ мувофиқат намекунад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivdeki bir dosyanın sağlama toplamı eşleşmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл усередині архіву не відповідає контрольній сумі"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdagi faylning nazorat summasi mos kelmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档中的文件校验和不匹配"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存檔中的檔案與其總和檢查碼不符"
          }
        }
      }
    },
    "archive.error.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayl zədələnib və ya OhMyMoney arxivi deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл пашкоджаны або не з’яўляецца архівам OhMyMoney"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor je poškozený nebo nejde o archiv OhMyMoney"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist beschädigt oder kein Archiv von OhMyMoney"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is damaged or is not an OhMyMoney archive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo está dañado o no es un archivo de OhMyMoney"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est endommagé ou n'est pas une archive d'OhMyMoney"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլը վնասված է կամ OhMyMoney-ի արխիվ չէ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è danneggiato o non è un archivio OhMyMoney"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが壊れているか、OhMyMoneyのアーカイブではありません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილი დაზიანებულია ან OhMyMoney-ის არქივი არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл бүлінген немесе OhMyMoney мұрағаты емес"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл бузулган же OhMyMoney архиви эмес"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand is beschadigd of is geen OhMyMoney-archief"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik jest uszkodzony lub nie jest archiwum OhMyMoney"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo está danificado ou não é um arquivo do OhMyMoney"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro está danificado ou não é um arquivo OhMyMoney"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл повреждён или это не архив OhMyMoney"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл осеб дидааст ё бойгонии OhMyMoney нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya hasarlı veya bir OhMyMoney arşivi değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл пошкоджено або це не архів OhMyMoney"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayl shikastlangan yoki OhMyMoney arxivi emas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已损坏或不是 OhMyMoney 归档"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案已損毀，或不是 OhMyMoney 封存檔"
          }
        }
      }
    },
    "archive.error.database": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdəki verilənlər bazasını açmaq mümkün olmadı. Heç nə əvəz edilmədi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося адкрыць базу даных у архіве. Нічога не заменена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Databázi v archivu nelze otevřít. Nic nebylo nahrazeno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank im Archiv kann nicht geöffnet werden. Nichts wurde ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database inside the archive cannot be opened. Nothing was replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir la base de datos dentro del archivo. No se reemplazó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base contenue dans l'archive ne peut pas être ouverte. Rien n'a été remplacé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվի տվյալների բազան հնարավոր չէ բացել։ Ոչինչ չի փոխարինվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il database nell’archivio. Non è stato sostituito nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ内のデータベースを開けません。データは置き換えられていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივში არსებული მონაცემთა ბაზა ვერ გაიხსნა. არაფერი შეცვლილა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағат ішіндегі дерекқорды ашу мүмкін емес. Ештеңе ауыстырылмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивдеги дайындар базасын ачуу мүмкүн эмес. Эч нерсе алмаштырылган жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De database in het archief kan niet worden geopend. Er is niets vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć bazy danych w archiwum. Nic nie zostało zastąpione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o banco de dados dentro do arquivo. Nada foi substituído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível abrir a base de dados no arquivo. Nada foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу внутри архива открыть не удалось. Ничего не заменено."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойгоҳи додаҳои бойгониро кушода нашуд. Ҳеҷ чиз иваз нашуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivdeki veritabanı açılamıyor. Hiçbir şey değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База даних усередині архіву не відкривається. Нічого не замінено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdagi ma’lumotlar bazasini ochib bo‘lmadi. Hech narsa almashtirilmadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开归档中的数据库。未替换任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟封存檔中的資料庫。未取代任何資料。"
          }
        }
      }
    },
