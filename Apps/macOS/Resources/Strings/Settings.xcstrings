    "report.offer.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq dayandırılıb və ya qəzaya uğrayıb. Problem hesabatı nə baş verdiyini göstərəcək: burada jurnal, versiyalar və saylar var — məbləğlər, adlar və təsvirlər yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма была спынена або адбыўся збой. Справаздача аб праблеме дапаможа высветліць прычыну: яна змяшчае журнал, версіі і колькасныя даныя, але не сумы, назвы і апісанні."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace byla zastavena nebo spadla. Hlášení problému pomůže zjistit, co se stalo: obsahuje protokol, verze a počty — nikdy částky, jména ani popisy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anwendung wurde gestoppt oder ist abgestürzt. Ein Problembericht sagt, was passiert ist: Er enthält das Journal, Versionen und Zählungen — nie Beträge, Namen oder Beschreibungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application was stopped or it crashed. A problem report will say what happened: it holds the journal, versions and counts — never amounts, names or descriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación se detuvo o se cayó. Un informe del problema dirá qué pasó: contiene el diario, versiones y recuentos — nunca importes, nombres ni descripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a été arrêtée ou elle a planté. Un rapport de problème dira ce qui s'est passé : il contient le journal, les versions et des compteurs — jamais de montants, de noms ni de descriptions."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածը դադարեցվել է կամ խափանվել։ Խնդրի հաշվետվությունը կօգնի պարզել պատճառը․ այն պարունակում է մատյանը, տարբերակներն ու քանակները, բայց ոչ գումարներ, անուններ կամ նկարագրություններ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app è stata interrotta o si è arrestata in modo anomalo. Un rapporto può aiutare a capire cosa è successo: contiene log, versioni e conteggi, mai importi, nomi o descrizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションが停止されたか、クラッシュしました。問題レポートで原因を確認できます。レポートにはログ、バージョン、件数が含まれます。金額、名前、説明は含まれません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპი შეჩერდა ან ავარიულად გაითიშა. პრობლემის ანგარიში აჩვენებს, რა მოხდა: ის შეიცავს ჟურნალს, ვერსიებსა და რაოდენობებს — არასდროს თანხებს, სახელებს ან აღწერებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба тоқтатылған немесе істен шыққан. Мәселе есебі не болғанын көрсетеді: онда журнал, нұсқалар мен сандар бар — сомалар, атаулар мен сипаттамалар болмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмо токтотулган же ката менен жабылган. Көйгөй тууралуу отчет эмне болгонун көрсөтөт: анда журнал, версиялар жана сандар бар — суммалар, аттар же сүрөттөмөлөр жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app is gestopt of vastgelopen. Een probleemrapport laat zien wat er is gebeurd. Het bevat het logboek, versies en aantallen, maar nooit bedragen, namen of beschrijvingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikację zatrzymano lub wystąpiła awaria. Raport problemu pomoże ustalić przyczynę: zawiera dziennik, wersje i liczby — nigdy kwoty, nazwy ani opisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app foi interrompido ou apresentou uma falha. Um relatório de problema mostrará o que aconteceu: ele contém o registro, versões e contagens — nunca valores, nomes ou descrições."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação foi interrompida ou falhou. Um relatório de problema ajudará a perceber o que aconteceu: contém o registo, versões e contagens — nunca valores, nomes ou descrições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение остановили или оно упало. Отчёт о проблеме покажет, что случилось: в нём журнал, версии и количества — и никогда суммы, имена или описания."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома қатъ шуд ё ба садама дучор шуд. Гузориши мушкилот нишон медиҳад, ки чӣ рӯй дод: он журнал, версияҳо ва шумораҳоро дар бар мегирад — маблағҳо, номҳо ва тавсифҳо ҳаргиз дохил намешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama durduruldu veya çöktü. Sorun raporu ne olduğunu gösterecek: günlük, sürümler ve sayıları içerir; tutarları, adları veya açıklamaları içermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок зупинено або стався збій. Звіт про проблему пояснить, що сталося: він містить журнал, версії й лічильники — без сум, імен та описів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova to‘xtatilgan yoki ishdan chiqqan. Muammo hisoboti nima yuz berganini ko‘rsatadi: unda jurnal, versiyalar va sonlar bor — summalar, nomlar va tavsiflar yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 被停止或发生崩溃。问题报告可帮助了解原因：报告包含日志、版本和数量，不含金额、名称或描述。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 已停止或當機。問題報告會說明發生的狀況：報告包含日誌、版本和數量，不含金額、名稱或描述。"
          }
        }
      }
    },
