    "settings.categoryHints.explanation": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney learns from your entries: it uses the place, amount and words to suggest a category. These measurements show how often it gets it right. Correcting a category teaches the model for the next entry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney учится на ваших записях: по месту, сумме и словам угадывает категорию. Здесь видно, как часто он угадывает. Исправляете категорию — модель учится и в следующий раз ошибается реже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney навчається на ваших записах: використовує місце, суму й слова, щоб запропонувати категорію. Ці показники відображають частоту влучних підказок. Виправлення категорії навчає модель для наступного запису."
          }
        }
      }
    },
    "settings.categoryHints.history": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "history (last category)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "по истории (последняя категория)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "історія (остання категорія)"
          }
        }
      }
    },
    "settings.categoryHints.macroF1": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Macro-F1"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макро-F1"
          }
        },
        "uk": {
