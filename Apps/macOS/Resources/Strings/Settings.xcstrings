      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstənilən əməliyyatda beş seçimdən birinin əvəzinə şəxs seçmək olar. Analitikada «Kimin üçün» bölməsi onları ayrıca hesablayır. Qohumluq əlaqələri, digər adlar və birləşdirmə Məlumat kitabçalarındadır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У любой аперацыі можна выбраць чалавека замест аднаго з пяці пунктаў. У раздзеле «Для каго» ў аналітыцы яны ўлічваюцца асобна. Сувязі, іншыя імёны і аб’яднанне — у даведніках."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U každé operace lze místo jedné z pěti možností vybrat osobu; přehled «Pro koho» v analýze ji započítá samostatně. Vztahy, další jména a slučování najdete v číselnících."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Person kann bei jedem Vorgang statt einer der fünf gesetzt werden, und „Für wen“ in der Auswertung zählt sie getrennt. Beziehungen, weitere Namen und Zusammenführen stehen in den Nachschlagewerken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A person can be set on any operation instead of one of the five, and «For whom» in Analytics counts them separately. Relations, other names and merging are in Reference books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona se puede poner en cualquier operación en lugar de una de las cinco, y «Para quién» en la Analítica las cuenta por separado. Las relaciones, otros nombres y la fusión están en Libros de referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne peut être choisie sur n'importe quelle opération à la place de l'une des cinq, et « Pour qui » dans l'Analyse les compte à part. Les liens, les autres noms et les fusions se trouvent dans les Références."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցանկացած գործարքի համար հինգ տարբերակներից մեկի փոխարեն կարելի է մարդ նշել։ Վերլուծության «Ում համար» բաժնում նրանք հաշվվում են առանձին։ Կապերը, այլ անունները և միավորումը հասանելի են տեղեկատուներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi assegnare una persona a qualsiasi operazione al posto di una delle cinque voci. In Analisi, «Per chi» le conteggia separatamente. Relazioni, altri nomi e unione si trovano negli elenchi di riferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの取引にも5項目の代わりに人を設定でき、分析の「誰のため」では個別に集計されます。関係、別名、統合は「マスタ」で設定できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნებისმიერ ოპერაციაში ხუთიდან ერთის ნაცვლად შეგიძლიათ ადამიანი მიუთითოთ. ანალიტიკაში „ვისთვის“ მათ ცალ-ცალკე ითვლის. კავშირები, სხვა სახელები და გაერთიანება ცნობარებშია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кез келген операцияда осы бесеудің орнына адамды таңдауға болады, Талдаудағы «Кімге» оларды бөлек есептейді. Қатынастар, басқа атаулар және біріктіру Анықтамалықтарда."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Каалаган операцияда бешөөнүн биринин ордуна адамды тандаса болот. Аналитикадагы «Ким үчүн» аларды өзүнчө эсептейт. Туугандык байланыштар, башка ысымдар жана бириктирүү Маалымдамаларда."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt bij elke transactie een persoon kiezen in plaats van een van de vijf opties. In ‘Voor wie’ onder Analyse worden personen apart geteld. Relaties, andere namen en samenvoegen vind je in Naslagwerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do każdej operacji można przypisać osobę zamiast jednej z pięciu opcji. W analizie „Dla kogo” osoby są liczone oddzielnie. Relacje, inne nazwy i łączenie znajdują się w Słownikach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa pode ser escolhida em qualquer operação no lugar de uma das cinco opções, e «Para quem» em Análises contabiliza cada pessoa separadamente. Relações, outros nomes e mesclagem ficam em Cadastros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode associar uma pessoa a qualquer operação em vez de uma das cinco opções, e «Para quem» nas Análises contabiliza-a separadamente. As relações, outros nomes e a fusão encontram-se em Referências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человека можно указать у любой операции вместо одного из пяти значений, и в «На кого» аналитики он считается отдельно. Отношение, другие названия и слияние — в «Справочниках»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҳар амалиёт ба ҷои яке аз он панҷто шахсеро интихоб кардан мумкин аст. Дар Таҳлилҳо «Барои кӣ» онҳоро алоҳида ҳисоб мекунад. Муносибатҳо, номҳои дигар ва муттаҳидсозӣ дар Маълумотномаҳо ҳастанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir işlemde beş seçenekten biri yerine bir kişi seçilebilir. Analiz'deki «Kimin için» bölümü bu kişileri ayrı sayar. İlişkiler, diğer adlar ve birleştirme işlemleri Başvuru Listeleri'ndedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На будь-якій операції можна вказати людину замість одного з п'яти варіантів, і «Для кого» в аналітиці врахує її окремо. Зв'язки, інші імена та об'єднання — у довідниках."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har qanday operatsiyada beshtadan biri o‘rniga odamni tanlash mumkin, Tahlildagi «Kim uchun» ularni alohida hisoblaydi. Qarindoshlik, boshqa ismlar va birlashtirish Ma’lumotnomalarda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何交易都可以选择一位人员，代替五个固定选项之一。“分析”中的 «为谁» 会分别统计。关系、其他名称和合并可在参考资料中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何交易都可選擇人員，取代五個固定選項之一；「分析」中的「對象」會分別統計。關係、其他名稱和合併功能位於參考資料中。"
          }
        }
      }
    },
