    "categories.delete.used": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» kateqoriyasında %2$@ var. Onlar üçün yeni kateqoriya seçin: əvvəlcə əməliyyatlar köçürüləcək, sonra kateqoriya silinəcək. Hər iki addımı geri almaq üçün ⌘Z düymələrini iki dəfə basın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%1$@»: %2$@. Выберыце новую катэгорыю для аперацый: спачатку яны будуць перамешчаны, потым катэгорыя будзе выдалена. Для адмены націсніце ⌘Z двойчы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ v kategorii «%1$@». Vyberte pro ně novou kategorii: nejprve se přesunou, pak se kategorie smaže. Obě akce vrátíte dvěma stisky ⌘Z."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ unter „%1$@“. Wählen Sie ein neues Zuhause für das, was dort abgelegt ist: Es wandert zuerst, die Kategorie danach. Zwei Schritte von ⌘Z."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ under «%1$@». Choose a new home for what is filed there: it moves first, the category goes after. Two steps of ⌘Z."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ bajo «%1$@». Elija un nuevo destino para lo que hay archivado allí: primero se mueve, después la categoría. Dos pasos de ⌘Z."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ dans « %1$@ ». Choisissez un nouveau lieu pour ce qui y est classé : cela se déplace d'abord, la catégorie part ensuite. Deux étapes de ⌘Z."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» կատեգորիայում %2$@։ Ընտրեք նոր կատեգորիա․ նախ գործարքները կտեղափոխվեն, ապա կատեգորիան կջնջվի։ Հետարկելու համար երկու անգամ սեղմեք ⌘Z։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ in «%1$@». Scegli una nuova categoria per le operazioni: verranno spostate prima di eliminare la categoria. Premi ⌘Z due volte per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»には%2$@。取引の移動先を選択してください。先に取引が移動され、その後カテゴリが削除されます。元に戻すには⌘Zを2回押します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» შეიცავს: %2$@. აირჩიეთ ოპერაციების ახალი კატეგორია: ჯერ ისინი გადავა, შემდეგ კატეგორია წაიშლება. ორივეს გასაუქმებლად ორჯერ დააჭირეთ ⌘Z."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» астындағы %2$@. Оған тіркелген нәрселер үшін жаңа орын таңдаңыз: алдымен көшеді, санат кейін жойылады. ⌘Z-ді екі рет басыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ичинде %2$@. Алар үчүн жаңы категория тандаңыз: адегенде операциялар жылдырылат, андан кийин категория өчүрүлөт. Кайтаруу үчүн ⌘Z эки жолу басылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ onder «%1$@». Kies een nieuwe categorie voor deze transacties. Ze worden eerst verplaatst, daarna wordt de categorie verwijderd. Maak dit in twee stappen ongedaan met ⌘Z."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ w kategorii «%1$@». Wybierz nową kategorię dla tych operacji. Najpierw zostaną przeniesione, a potem kategoria zostanie usunięta. Cofnięcie wymaga dwukrotnego naciśnięcia ⌘Z."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ em «%1$@». Escolha para onde movê-las. As operações serão movidas primeiro e a categoria será apagada em seguida. Pressione ⌘Z duas vezes para desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ em «%1$@». Escolha uma nova categoria para as operações: estas são movidas primeiro e a categoria é apagada em seguida. Prima ⌘Z duas vezes para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%1$@» %2$@. Выберите, куда перенести содержимое: оно переедет первым, категория уйдёт следом. Два шага ⌘Z."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар «%1$@» %2$@. Барои онҳо категорияи нав интихоб кунед: аввал амалиётҳо кӯчонда мешаванд, баъд категория нест мешавад. Барои бекор кардани ҳар ду қадам ⌘Z-ро ду бор пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» altında %2$@ var. İşlemler için yeni bir kategori seçin. Önce işlemler taşınır, ardından kategori silinir. Geri almak için ⌘Z’ye iki kez basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%1$@» — %2$@. Виберіть нову категорію для записів: спочатку вони перенесуться, потім категорія видалиться. Два кроки ⌘Z."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» turkumida %2$@. Ular uchun yangi turkum tanlang: avval operatsiyalar ko‘chiriladi, so‘ng turkum o‘chiriladi. Bekor qilish uchun ⌘Z ikki marta bosiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»下有%2$@。请选择新类别：交易将先被移动，然后删除类别。需按两次 ⌘Z 才能全部撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»中有%2$@。請選擇新類別：交易會先移動，再刪除類別。按兩次 ⌘Z 可還原。"
          }
        }
      }
    },
