            "state": "translated",
            "value": "Las operaciones van de camino a la nueva categoría. Cuando eso se escriba, elimínela de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations sont en route vers la nouvelle catégorie. Quand cela sera écrit, supprimez-la à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni sono in fase di spostamento nella nuova categoria. Al termine, elimina di nuovo la categoria."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар жаңа санатқа жолда. Ол жазылғаннан кейін, оны қайтадан жойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции переезжают в новую категорию. Как допишутся — удалите её ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції переносяться до нової категорії. Після запису видаліть категорію знову."
          }
        }
      }
    },
    "categories.delete.notReady": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даныя яшчэ счытваюцца — пакуль нічога нельга падлічыць. Пачакайце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten werden noch gelesen — es lässt sich noch nichts zählen. Einen Moment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data is still being read — nothing can be counted yet. A moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos todavía se están leyendo — todavía no se puede contar nada. Un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sont encore en cours de lecture — rien ne peut encore être compté. Un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettura dei dati in corso: non è ancora possibile contarli. Attendi un momento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер әлі оқылып жатыр — әлі ештеңе санауға болмайды. Сәл күтіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные ещё читаются — посчитать пока нечего. Секунду."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані ще читаються — обчислення поки неможливе. Зачекайте мить."
          }
        }
      }
    },
    "categories.delete.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаліць катэгорыю?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorie löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the category?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar la categoría?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer la catégorie ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare la categoria?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санат жойылсын ба?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить категорию?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити категорію?"
          }
        }
      }
    },
    "categories.delete.used": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%1$@»: %2$@. Выберыце новую катэгорыю для аперацый: спачатку яны будуць перамешчаны, потым катэгорыя будзе выдалена. Для адмены націсніце ⌘Z двойчы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ unter „%1$@“. Wählen Sie ein neues Zuhause für das, was dort abgelegt ist: Es wandert zuerst, die Kategorie danach. Zwei Schritte von ⌘Z."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ under «%1$@». Choose a new home for what is filed there: it moves first, the category goes after. Two steps of ⌘Z."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ bajo «%1$@». Elija un nuevo destino para lo que hay archivado allí: primero se mueve, después la categoría. Dos pasos de ⌘Z."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ dans « %1$@ ». Choisissez un nouveau lieu pour ce qui y est classé : cela se déplace d'abord, la catégorie part ensuite. Deux étapes de ⌘Z."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ in «%1$@». Scegli una nuova categoria per le operazioni: verranno spostate prima di eliminare la categoria. Premi ⌘Z due volte per annullare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» астындағы %2$@. Оған тіркелген нәрселер үшін жаңа орын таңдаңыз: алдымен көшеді, санат кейін жойылады. ⌘Z-ді екі рет басыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%1$@» %2$@. Выберите, куда перенести содержимое: оно переедет первым, категория уйдёт следом. Два шага ⌘Z."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%1$@» — %2$@. Виберіть нову категорію для записів: спочатку вони перенесуться, потім категорія видалиться. Два кроки ⌘Z."
          }
        }
      }
    },
