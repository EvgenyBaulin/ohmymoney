    "settings.forWhom.fixedHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты набор складаецца з пяці пунктаў, змяніць можна толькі іх назвы. Каб дадаць свой варыянт, дадайце чалавека ніжэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese fünf sind die ganze Auswahl, und nur ihre Bezeichnungen können sich ändern. Um eigene hinzuzufügen, legen Sie unten eine Person an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These five are the whole set, and only their captions can change. To add your own, add a person below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cinco son el conjunto completo, y solo pueden cambiar sus rótulos. Para añadir las suyas, añada una persona abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces cinq-là forment l'ensemble complet, et seules leurs légendes peuvent changer. Pour en ajouter, ajoutez une personne ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste cinque voci sono fisse e puoi cambiarne solo le etichette. Per aggiungerne una tua, aggiungi una persona qui sotto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жиын осы бес нұсқадан тұрады, тек атауларын өзгертуге болады. Өз нұсқаңызды қосу үшін төменде адам қосыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этих пяти значений столько и есть, меняются только их подписи. Чтобы добавить своё — заведите человека ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці п'ять — увесь набір, можна змінити лише підписи. Щоб додати власний варіант, додайте людину нижче."
          }
        }
      }
    },
