    "settings.planning.goalValuationHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü məzənnə ilə — məqsədin pulu öz valyutasında saxlanıldıqda. Köçürmələrin məzənnəsi ilə — pul rublla saxlanıldıqda: hər köçürmə öz gününün rubl məbləği ilə hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Па сённяшнім курсе — калі грошы на мэту захоўваюцца ў яе валюце. Па курсах узносаў — калі яны захоўваюцца ў рублях: кожны ўзнос улічваецца ў рублях па курсе на дзень узносу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnešním kurzem, pokud jsou peníze uložené v měně cíle. Kurzem v době vkladů, pokud jsou uložené v rublech: každý vklad se počítá v rublech podle dne vkladu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum heutigen Kurs — wenn das Geld des Ziels in seiner Währung liegt. Zu den Kursen der Beiträge — wenn es in Rubel liegt: Jeder Beitrag zählt mit den Rubeln seines Tages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At today's rate — when the goal's money is kept in its currency. At the rates of the contributions — when it is kept in rubles: each contribution counts with the rubles of its day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tipo de hoy — cuando el dinero del objetivo se guarda en su divisa. Al tipo de cada aportación — cuando se guarda en rublos: cada aportación cuenta con los rublos de su día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au cours du jour — quand l'argent de l'objectif est gardé dans sa devise. Au cours des contributions — quand il est gardé en roubles : chaque contribution compte avec les roubles de son jour."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօրվա փոխարժեքով՝ երբ նպատակի գումարը պահվում է իր արժույթով։ Մուծումների փոխարժեքով՝ երբ այն պահվում է ռուբլով․ յուրաքանչյուր մուծում հաշվվում է իր օրվա ռուբլու արժեքով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tasso di oggi: quando i risparmi sono conservati nella valuta dell’obiettivo. Ai tassi dei versamenti: quando sono conservati in rubli; ogni versamento vale i rubli del giorno in cui è stato effettuato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標の通貨で保管している場合は今日のレートを、ルーブルで保管している場合は積立時のレートを使用します。積立時のレートでは、それぞれの積立額を当日のルーブル額で計算します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღევანდელი კურსით — როცა მიზნის თანხა მის ვალუტაში ინახება. შენატანების კურსით — როცა თანხა რუბლებში ინახება: თითოეული შენატანი იმ დღის რუბლის კურსით ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгінгі бағаммен — мақсат ақшасы оның валютасында сақталса. Жарналар бағамымен — рубльде сақталса: әр жарна өз күніндегі рубль сомасымен есептеледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүнкү курс боюнча — максаттын акчасы ошол валютада сакталса. Салымдар кошулган күнкү курс боюнча — акча рубль менен сакталса: ар бир салым кошулган күнкү рубль суммасы менен эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegen de huidige koers: als het geld in de valuta van het doel wordt aangehouden. Tegen de koers van de inleg: als het in roebels wordt aangehouden. Elke inleg telt mee voor het bedrag in roebels van die dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Według dzisiejszego kursu — gdy środki są przechowywane w walucie celu. Według kursów wpłat — gdy są przechowywane w rublach: każda wpłata jest liczona według jej wartości w rublach w dniu wpłaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pela cotação de hoje: quando o dinheiro da meta é guardado na moeda dela. Pela cotação dos aportes: quando é guardado em rublos; cada aporte considera os rublos do dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À taxa de hoje — quando o dinheiro do objetivo é guardado na respetiva moeda. Às taxas das contribuições — quando é guardado em rublos: cada contribuição conta pelo valor em rublos do respetivo dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По сегодняшнему курсу — если деньги цели лежат в её валюте. По курсу взносов — если они лежат в рублях: каждый взнос считается рублями своего дня."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо қурби имрӯз — вақте ки маблағи ҳадаф бо асъори худ нигоҳ дошта мешавад. Бо қурби рӯзҳои пасандоз — вақте ки он бо рубл нигоҳ дошта мешавад: ҳар пасандоз бо маблағи рублии рӯзи худ ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef parası kendi para biriminde tutuluyorsa bugünkü kurla, ruble olarak tutuluyorsa katkıların yapıldığı günkü kurla hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За сьогоднішнім курсом — коли гроші цілі зберігаються в її валюті. За курсами внесків — коли в рублях: кожен внесок враховується в рублях свого дня."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugungi kurs bo‘yicha — maqsad puli o‘z valyutasida saqlansa. Badallar kiritilgan kundagi kurs bo‘yicha — pul rublda saqlansa: har bir badal o‘sha kundagi rubl qiymatida hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按今日汇率：适用于以目标货币保存的资金。按每次存入时的汇率：适用于以卢布保存的资金，每笔存入按当天的卢布金额计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依今日匯率：目標資金以外幣持有。依每次存入時的匯率：目標資金以盧布持有，每筆存款按當日盧布金額計算。"
          }
        }
      }
    },
    "settings.planning.includesGoals": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məqsəd pulları icmaldakı hesablardadır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на мэты знаходзяцца на рахунках у аглядзе"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze na cíle jsou na účtech v přehledu"
          }
        },
        "de": {
