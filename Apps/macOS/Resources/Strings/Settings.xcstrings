    "references.usage.none": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На яго нішто не спасылаецца: яго можна выдаліць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist darauf: Er kann gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it: it can be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada hace referencia a él: se puede eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'y réfère : il peut être supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è in uso e può essere eliminato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған сілтемелер жоқ: жоюға болады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie jest używana: można ją usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está em uso e pode ser apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На это ничто не ссылается — можно удалить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir yerde kullanılmıyor: silinebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На запис немає посилань: його можна видалити."
          }
        }
      }
    },
