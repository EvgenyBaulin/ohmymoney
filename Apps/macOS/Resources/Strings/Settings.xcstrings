    "settings.appearance.textHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text size changes in every window at once. The currency is how amounts name it on the screens, charts and cards; files and the fields where an amount is typed stay as they are. «Name» writes short Russian names only in Russian; in English it shows the code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño del texto cambia de golpe en todas las ventanas. La divisa es como los importes la nombran en las pantallas, gráficos y tarjetas; los archivos y los campos donde se escribe un importe se quedan como están. «Nombre» escribe nombres rusos cortos solo en ruso; en inglés muestra el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille du texte change dans toutes les fenêtres à la fois. La devise est le nom que lui donnent les montants sur les écrans, graphiques et cartes ; les fichiers et les champs où un montant est saisi restent tels quels. « Nom » n'écrit les noms courts qu'en russe ; en anglais, il affiche le code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер шрифта меняется сразу во всех окнах. Валюта — как суммы называют её на экранах, графиках и карточках; файлы и поля, где набирают сумму, не меняются. «Название» пишет сокращения (руб., долл.) только по-русски, по-английски — код."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір тексту змінюється одразу в усіх вікнах. Вигляд валюти визначає її підпис біля сум на екранах, графіках і картках; файли й поля вводу сум не змінюються. «Назва» показує короткі російські назви лише російською; англійською показує код."
          }
        }
      }
    },
    "settings.backups.beforeMigrationMirrored": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies made before updates are here too, in the «before-migration» folder. Copy rotation never deletes them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias hechas antes de las actualizaciones también están aquí, en la carpeta «antes-de-actualizacion». La rotación de copias nunca las elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies faites avant les mises à jour sont aussi là, dans le dossier « before-migration ». La rotation des copies ne les supprime jamais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии «до обновления» лежат и здесь — в папке «before-migration». Ротация копий их не удаляет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії перед оновленнями також тут, у папці «before-migration». Автоматичне очищення їх ніколи не видаляє."
          }
        }
      }
    },
