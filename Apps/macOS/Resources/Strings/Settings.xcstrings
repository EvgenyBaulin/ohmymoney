    "settings.numbers.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız ekrandakı görünüş dəyişir. CSV fayllarında və köçürmə arxivində həmişə nöqtə istifadə olunur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змяняецца толькі адлюстраванне на экране. У файлах CSV і архіве пераносу заўсёды выкарыстоўваецца кропка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změní se pouze zobrazení na obrazovce. Soubory CSV a přenosový archiv vždy používají tečku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur was Sie auf dem Bildschirm lesen, ändert sich. CSV-Dateien und das Übertragungsarchiv nutzen immer einen Punkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what you read on screen changes. CSV files and the transfer archive always use a point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo lo que se lee en pantalla. Los archivos CSV y el archivo de traslado siempre usan el punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul ce que vous lisez à l'écran change. Les fichiers CSV et l'archive de transfert utilisent toujours un point."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխվում է միայն էկրանին ցուցադրվող ձևաչափը։ CSV ֆայլերում և փոխանցման արխիվում միշտ օգտագործվում է կետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo ciò che vedi sullo schermo. I file CSV e l’archivio di trasferimento usano sempre il punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上の表示のみが変わります。CSVファイルと移行アーカイブでは、常に小数点が使われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იცვლება მხოლოდ ეკრანზე ნაჩვენები ფორმატი. CSV ფაილები და გადატანის არქივი ყოველთვის წერტილს იყენებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек экрандағы көрініс өзгереді. CSV файлдары мен тасымалдау мұрағаты әрдайым нүктені қолданады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Экранда көрсөтүлүшү гана өзгөрөт. CSV файлдарында жана көчүрүү архивинде дайыма чекит колдонулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de weergave op het scherm verandert. CSV-bestanden en het overdrachtsarchief gebruiken altijd een punt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia się tylko sposób wyświetlania na ekranie. Pliki CSV i archiwum transferowe zawsze używają kropki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o que você vê na tela muda. Os arquivos CSV e o arquivo de transferência sempre usam ponto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas muda a apresentação no ecrã. Os ficheiros CSV e o arquivo de transferência usam sempre um ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняется только то, что вы читаете на экране. Файлы CSV и архив переноса всегда пишутся с точкой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо намоиш дар экран тағйир меёбад. Дар файлҳои CSV ва бойгонии интиқол ҳамеша нуқта истифода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ekranda gördükleriniz değişir. CSV dosyaları ve aktarım arşivi her zaman nokta kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюється лише відображення на екрані. CSV-файли й архів перенесення завжди використовують крапку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat ekrandagi ko‘rinish o‘zgaradi. CSV fayllari va ko‘chirish arxivida doim nuqta ishlatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只更改屏幕上的显示格式。CSV 文件和传输归档始终使用小数点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會變更螢幕上的顯示方式。CSV 檔案和轉移封存檔一律使用小數點。"
          }
        }
      }
    },
