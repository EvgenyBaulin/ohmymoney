            "value": "importes, tipos, saldos, nombres de categorías, lugares y eventos, nombres de personas, notas de operaciones, contraseñas y rutas de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les montants, les taux, les soldes, les noms des catégories, des lieux et des événements, les noms des personnes, les notes des opérations, les mots de passe et les chemins de fichiers."
          }
        },
        "it": {
