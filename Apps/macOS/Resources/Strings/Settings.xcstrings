    "settings.events.automatic": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the active event on new operations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner el evento activo en las operaciones nuevas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre l'événement actif sur les nouvelles opérations"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставить активное событие новым операциям"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставити активну подію на нові операції"
          }
        }
      }
    },
    "settings.events.automaticHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: an event covering the day is only offered in the panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: un evento que cubre el día solo se ofrece en el panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : un événement couvrant le jour n'est proposé que dans le panneau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: событие на эту дату только предлагается в панели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вимкнено, подія цього дня лише пропонується на панелі."
          }
        }
      }
    },
    "settings.forWhom.fixedHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These five are the whole set, and only their captions can change. To add your own, add a person below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cinco son el conjunto completo, y solo pueden cambiar sus rótulos. Para añadir las suyas, añada una persona abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces cinq-là forment l'ensemble complet, et seules leurs légendes peuvent changer. Pour en ajouter, ajoutez une personne ci-dessous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этих пяти значений столько и есть, меняются только их подписи. Чтобы добавить своё — заведите человека ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці п'ять — увесь набір, можна змінити лише підписи. Щоб додати власний варіант, додайте людину нижче."
          }
        }
      }
    },
    "settings.forWhom.people": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personas"
          }
        },
        "fr": {
          "stringUnit": {
