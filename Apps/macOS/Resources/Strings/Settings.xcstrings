        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածներ, որոնց գործարքը, ակտիվը, պարտքը կամ բաժանորդագրությունը բացակայում է"
          }
        },
        "it": {
          "stringUnit": {
