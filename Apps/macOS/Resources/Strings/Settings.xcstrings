    "backups.space.low": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüsxələr üçün az yer qalıb: %@ boşdur. Heç nə avtomatik silinmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мала месца для копій: вольна %@. Нічога не выдаляецца аўтаматычна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Málo místa pro kopie: volné místo %@. Nic se nemaže automaticky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Platz für Kopien: %@ frei. Von selbst wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little room for copies: %@ free. Nothing is deleted on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco espacio para las copias: libres %@. Nada se elimina por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de place pour les copies : %@ libres. Rien n'est supprimé de soi-même."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատճենների համար քիչ տեղ կա․ ազատ է %@։ Ոչինչ ինքնաբերաբար չի ջնջվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco spazio per le copie: %@ disponibili. Nulla viene eliminato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー用の空き容量がわずかです: %@。データが自動的に削除されることはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ასლებისთვის მცირე ადგილია: თავისუფალია %@. არაფერი წაიშლება ავტომატურად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірмелерге орын аз: %@ бос. Өздігінен ештеңе жойылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көчүрмөлөр үчүн орун аз: %@ бош. Эч нерсе автоматтык түрдө өчүрүлбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weinig ruimte voor kopieën: %@ vrij. Er wordt niets automatisch verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mało miejsca na kopie: dostępne %@. Nic nie jest usuwane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco espaço para cópias: %@ disponível. Nada é apagado automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco espaço para cópias: %@ disponíveis. Nada é apagado automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало места для копий: свободно %@. Ничего не удаляется само."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои нусхаҳо ҷой кам аст: %@ холӣ. Ҳеҷ чиз худкор нест намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalar için az yer var: %@ boş. Hiçbir şey kendiliğinden silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало місця для копій: вільно %@. Нічого не видаляється автоматично."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nusxalar uchun joy kam: %@ bo‘sh. Hech narsa o‘z-o‘zidan o‘chirilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份空间不足：剩余 %@。备份不会自动删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份空間不足：剩餘 %@。不會自動刪除任何備份。"
          }
        }
      }
    },
