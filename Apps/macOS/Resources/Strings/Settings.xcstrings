    "settings.hints.burnoutHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In «Worth a look», at most once a week: a week with many more small purchases you could do without than usual"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Merece una mirada», como mucho una vez por semana: una semana con muchas más compras pequeñas prescindibles que de costumbre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans « À regarder de plus près », au plus une fois par semaine : une semaine avec bien plus de petits achats dont on pourrait se passer que d'habitude"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Стоит посмотреть», не чаще раза в неделю: за неделю мелких необязательных покупок заметно больше обычного"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «Варто переглянути», не частіше разу на тиждень: тиждень із набагато більшою кількістю необов'язкових дрібних покупок, ніж зазвичай"
          }
        }
      }
    },
    "settings.hints.burnoutNeedsEssentials": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the necessary spending in Categories («Necessary spending») — without it the hint cannot tell a treat from groceries and stays silent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque el gasto necesario en Categorías («Gasto necesario») — sin ello, la sugerencia no distingue un capricho de la compra de comida y calla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez les dépenses nécessaires dans Catégories (« Dépenses nécessaires ») — sans cela, la suggestion ne peut pas distinguer une gâterie des courses et reste muette."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте необходимые траты в «Категориях» («Необходимая трата») — без них подсказка не отличит мелочь от продуктов и молчит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте необхідні витрати в категоріях («Необхідні витрати») — без цього підказка не відрізняє приємну дрібницю від продуктів і мовчить."
          }
        }
      }
    },
    "settings.hints.creditHistory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind about the credit history"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordar el historial crediticio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappeler l'historique de crédit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминать о кредитной истории"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадувати про кредитну історію"
          }
        }
      }
    },
    "settings.hints.creditHistoryHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On 1 February and 1 August: ask for your credit history — free twice a year in each bureau, through Gosuslugi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 1 de febrero y el 1 de agosto: pedir el historial crediticio — gratis dos veces al año en cada oficina de crédito, a través de Gosuslugi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 1er février et le 1er août : demander votre historique de crédit — gratuit deux fois par an auprès de chaque bureau, via Gosuslugi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 февраля и 1 августа: запросите кредитную историю — дважды в год бесплатно в каждом бюро, через Госуслуги"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1 лютого й 1 серпня: запитати кредитну історію — безкоштовно двічі на рік у кожному бюро через Держпослуги"
          }
        }
      }
    },
