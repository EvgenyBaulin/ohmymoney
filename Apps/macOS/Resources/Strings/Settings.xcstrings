    "currencies.lock.held": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта валюта выкарыстоўваецца на рахунку. Спачатку прыбярыце яе з рахунку (Налады → Рахункі)."
