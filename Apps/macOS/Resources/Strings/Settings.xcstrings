    "settings.updates.automatic": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аўтаматычна правяраць і ўсталёўваць абнаўленні"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates automatisch suchen und installieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for and install updates automatically"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar e instalar actualizaciones automáticamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher et installer les mises à jour automatiquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca e installa automaticamente gli aggiornamenti"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңартуларды автоматты тексеріп, орнату"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie sprawdzaj i instaluj uaktualnienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar e instalar atualizações automaticamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверять и устанавливать обновления автоматически"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri otomatik olarak denetle ve yükle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряти й установлювати оновлення автоматично"
          }
        }
      }
    },
    "settings.updates.automaticHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на дзень праграма правярае наяўнасць новай версіі, спампоўвае яе ў фоне і ўсталёўвае пры выхадзе. Калі выключана, абнаўленне даступна толькі праз “Праверыць абнаўленні…”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal am Tag sucht die App nach einer neuen Version, lädt sie im Hintergrund und installiert sie beim Beenden. Aus: Ein Update kommt nur über „Nach Updates suchen…“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day the app looks for a new version, downloads it in the background and installs it on quit. Off: an update comes only through “Check for Updates…”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día la app busca una versión nueva, la descarga en segundo plano y la instala al salir. Desactivado: una actualización llega solo por «Buscar actualizaciones…»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour, l'app cherche une nouvelle version, la télécharge en arrière-plan et l'installe à la sortie. Désactivé : une mise à jour n'arrive que par « Rechercher les mises à jour… »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno l’app cerca una nuova versione, la scarica in background e la installa alla chiusura. Se disattivato, gli aggiornamenti sono disponibili solo tramite “Verifica aggiornamenti…”."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба күніне бір рет жаңа нұсқаны іздеп, фонда жүктейді және шыққанда орнатады. Өшірулі болса, жаңарту тек “Жаңартуларды тексеру…” арқылы келеді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz dziennie aplikacja sprawdza, czy jest dostępna nowa wersja, pobiera ją w tle i instaluje po zakończeniu pracy. Gdy opcja jest wyłączona, uaktualnienia można znaleźć tylko przez „Sprawdź uaktualnienia…”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia, o app busca uma nova versão, baixa em segundo plano e a instala ao encerrar. Se desativado, a atualização só ocorre por “Buscar Atualizações…”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день приложение ищет новую версию, скачивает её в фоне и ставит при выходе. Выключено: обновление придёт только по «Проверить обновления…»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama günde bir kez yeni sürüm olup olmadığını denetler, varsa arka planda indirir ve çıkışta yükler. Kapalıysa güncellemeler yalnızca “Güncellemeleri Denetle…” ile alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на день застосунок шукає нову версію, завантажує її у фоні й установлює під час виходу. Якщо вимкнено, оновлення доступні лише через «Перевірити оновлення…»."
          }
        }
      }
    },
    "settings.updates.unavailableHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта зборка не правярае абнаўленні: у ёй няма ключа для праверкі подпісу абнаўлення."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build sucht nicht nach Updates: Er enthält keinen Schlüssel, mit dem die Signatur eines Updates geprüft werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not look for updates: it carries no key to check the signature of an update with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no busca actualizaciones: no lleva la clave para verificar la firma de una actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne recherche pas de mises à jour : elle ne porte aucune clé pour vérifier la signature d'une mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione non cerca aggiornamenti: non dispone della chiave per verificarne la firma."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл жинақ жаңартуларды тексермейді: жаңарту қолтаңбасын тексеретін кілті жоқ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja nie sprawdza uaktualnień, ponieważ nie zawiera klucza do weryfikacji ich podpisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão não busca atualizações: ela não tem uma chave para verificar a assinatura de uma atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка не ищет обновлений: в ней нет ключа, которым проверяется подпись обновления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu derleme güncellemeleri denetlemez: Güncelleme imzasını doğrulamak için anahtar içermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збірка не шукає оновлень: у ній немає ключа для перевірки підпису оновлення."
          }
        }
      }
    },
    "settings.write.refused": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць — прычына ў журнале."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht geschrieben werden — das Journal sagt, warum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write — the log says why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo escribir — el diario indica el motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'écrire — le journal indique pourquoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scrivere: consulta il registro per i dettagli."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазу мүмкін болмады — себебі журналда."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać. Przyczyna jest podana w dzienniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gravar — consulte o registro para saber o motivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось записать — подробности в журнале."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazılamadı. Nedeni günlükte belirtiliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
