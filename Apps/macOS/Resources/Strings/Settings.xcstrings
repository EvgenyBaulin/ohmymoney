    "settings.updates.automaticHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq gündə bir dəfə yeni versiyanı yoxlayır, onu arxa planda endirir və bağlanarkən quraşdırır. Söndürüldükdə yeniləmə yalnız “Yeniləmələri yoxla…” ilə alınır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на дзень праграма правярае наяўнасць новай версіі, спампоўвае яе ў фоне і ўсталёўвае пры выхадзе. Калі выключана, абнаўленне даступна толькі праз “Праверыць абнаўленні…”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace jednou denně vyhledá novou verzi, stáhne ji na pozadí a nainstaluje při ukončení. Je-li volba vypnutá, aktualizace se vyhledávají pouze pomocí „Zkontrolovat aktualizace…“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal am Tag sucht die App nach einer neuen Version, lädt sie im Hintergrund und installiert sie beim Beenden. Aus: Ein Update kommt nur über „Nach Updates suchen…“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day the app looks for a new version, downloads it in the background and installs it on quit. Off: an update comes only through “Check for Updates…”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día la app busca una versión nueva, la descarga en segundo plano y la instala al salir. Desactivado: una actualización llega solo por «Buscar actualizaciones…»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour, l'app cherche une nouvelle version, la télécharge en arrière-plan et l'installe à la sortie. Désactivé : une mise à jour n'arrive que par « Rechercher les mises à jour… »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օրը մեկ անգամ հավելվածը ստուգում է նոր տարբերակի առկայությունը, ներբեռնում այն հետին պլանում և տեղադրում հավելվածից դուրս գալիս։ Եթե անջատված է, թարմացումը հասանելի է միայն «Ստուգել թարմացումները…» հրամանով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno l’app cerca una nuova versione, la scarica in background e la installa alla chiusura. Se disattivato, gli aggiornamenti sono disponibili solo tramite “Verifica aggiornamenti…”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日1回新しいバージョンを確認し、バックグラウンドでダウンロードして、終了時にインストールします。オフの場合は、“アップデートを確認…”からのみアップデートできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპი დღეში ერთხელ ამოწმებს ახალ ვერსიას, ფონზე ჩამოტვირთავს და დახურვისას აყენებს. გამორთვისას განახლება მხოლოდ „განახლებების შემოწმებით…“ არის შესაძლებელი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба күніне бір рет жаңа нұсқаны іздеп, фонда жүктейді және шыққанда орнатады. Өшірулі болса, жаңарту тек “Жаңартуларды тексеру…” арқылы келеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмо күнүнө бир жолу жаңы версияны текшерип, аны фондо жүктөйт жана жабылганда орнотот. Өчүрүлгөндө жаңыртуу «Жаңыртууларды текшерүү…» аркылуу гана алынат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app zoekt dagelijks naar een nieuwe versie, downloadt deze op de achtergrond en installeert deze bij het afsluiten. Als deze optie uitstaat, kun je alleen bijwerken via ‘Zoek naar updates…’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz dziennie aplikacja sprawdza, czy jest dostępna nowa wersja, pobiera ją w tle i instaluje po zakończeniu pracy. Gdy opcja jest wyłączona, uaktualnienia można znaleźć tylko przez „Sprawdź uaktualnienia…”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia, o app busca uma nova versão, baixa em segundo plano e a instala ao encerrar. Se desativado, a atualização só ocorre por “Buscar Atualizações…”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia, a aplicação procura uma nova versão, descarrega-a em segundo plano e instala-a ao sair. Se desativado, as atualizações só são obtidas através de “Procurar atualizações…”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день приложение ищет новую версию, скачивает её в фоне и ставит при выходе. Выключено: обновление придёт только по «Проверить обновления…»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома ҳар рӯз версияи навро меҷӯяд, дар замина боргирӣ мекунад ва ҳангоми баромадан насб мекунад. Агар хомӯш бошад, навсозӣ танҳо тавассути “Санҷидани навсозиҳо…” дастрас мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama günde bir kez yeni sürüm olup olmadığını denetler, varsa arka planda indirir ve çıkışta yükler. Kapalıysa güncellemeler yalnızca “Güncellemeleri Denetle…” ile alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на день застосунок шукає нову версію, завантажує її у фоні й установлює під час виходу. Якщо вимкнено, оновлення доступні лише через «Перевірити оновлення…»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova kuniga bir marta yangi versiyani tekshiradi, uni fonda yuklab oladi va yopilganda o‘rnatadi. O‘chirilsa, yangilanishlar faqat “Yangilanishlarni tekshirish…” orqali olinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 每天检查一次新版本，在后台下载，并在退出时安装。关闭后，只能通过“检查更新…”获取更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 每天檢查一次新版本，在背景下載，並於結束時安裝。關閉後，僅能透過「檢查更新…」取得更新。"
          }
        }
      }
    },
    "settings.updates.unavailableHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu versiya yeniləmələri yoxlamır: yeniləmənin imzasını yoxlamaq üçün açar yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта зборка не правярае абнаўленні: у ёй няма ключа для праверкі подпісу абнаўлення."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto sestavení nevyhledává aktualizace, protože neobsahuje klíč k ověření jejich podpisu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build sucht nicht nach Updates: Er enthält keinen Schlüssel, mit dem die Signatur eines Updates geprüft werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not look for updates: it carries no key to check the signature of an update with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no busca actualizaciones: no lleva la clave para verificar la firma de una actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne recherche pas de mises à jour : elle ne porte aucune clé pour vérifier la signature d'une mise à jour."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս տարբերակը չի ստուգում թարմացումները, քանի որ չունի թարմացման ստորագրությունը ստուգելու բանալի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione non cerca aggiornamenti: non dispone della chiave per verificarne la firma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはアップデートの署名を検証するためのキーがないため、アップデートを確認できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ვერსია განახლებებს არ ამოწმებს: მას განახლების ხელმოწერის შესამოწმებელი გასაღები არ აქვს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл жинақ жаңартуларды тексермейді: жаңарту қолтаңбасын тексеретін кілті жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул түзүм жаңыртууларды текшербейт: анда жаңыртуунун кол тамгасын текшерүүчү ачкыч жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie zoekt niet naar updates omdat de sleutel ontbreekt om de handtekening van een update te controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja nie sprawdza uaktualnień, ponieważ nie zawiera klucza do weryfikacji ich podpisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão não busca atualizações: ela não tem uma chave para verificar a assinatura de uma atualização."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão não procura atualizações: não inclui uma chave para verificar a assinatura de uma atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка не ищет обновлений: в ней нет ключа, которым проверяется подпись обновления."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин версия навсозиҳоро намеҷӯяд: барои санҷидани имзои навсозӣ калид надорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu derleme güncellemeleri denetlemez: Güncelleme imzasını doğrulamak için anahtar içermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збірка не шукає оновлень: у ній немає ключа для перевірки підпису оновлення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu versiya yangilanishlarni tekshirmaydi: unda yangilanish imzosini tekshirish kaliti yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不会检查更新：缺少用于验证更新签名的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不會檢查更新，因為未包含驗證更新簽章所需的金鑰。"
          }
        }
      }
    },
    "settings.write.refused": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazmaq mümkün olmadı — səbəb jurnalda göstərilib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць — прычына ў журнале."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zápis se nezdařil. Důvod najdete v protokolu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht geschrieben werden — das Journal sagt, warum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write — the log says why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo escribir — el diario indica el motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'écrire — le journal indique pourquoi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց գրել․ պատճառը նշված է մատյանում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scrivere: consulta il registro per i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込めませんでした。理由はログを確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაწერა ვერ მოხერხდა — მიზეზი ჟურნალშია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазу мүмкін болмады — себебі журналда."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазуу мүмкүн болгон жок — себеби журналда көрсөтүлгөн."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaren mislukt. In het logboek staat waarom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać. Przyczyna jest podana w dzienniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gravar — consulte o registro para saber o motivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível escrever — consulte o registo para saber porquê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось записать — подробности в журнале."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сабт нашуд — сабаб дар гузориш аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazılamadı. Nedeni günlükte belirtiliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося записати — причина в журналі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yozib bo‘lmadi — sabab jurnalda ko‘rsatilgan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入，原因请查看日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入，原因請參閱記錄。"
          }
        }
      }
    },
