        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app est en lecture seule : l'import n'est pas possible. Quittez d'abord ce mode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим «Только просмотр»: импорт недоступен. Сначала выйдите из режима."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок у режимі лише перегляду: імпорт неможливий. Спочатку вийдіть із режиму."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба тек оқу режимінде: импорттау мүмкін емес. Алдымен режимнен шығыңыз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist nur lesbar: Ein Import ist nicht möglich. Verlassen Sie zuerst den Modus."
          }
        }
      }
    },
    "archive.import.title": {
