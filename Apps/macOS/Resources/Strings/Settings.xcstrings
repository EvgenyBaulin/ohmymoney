    "settings.planning.goalValuationHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Па сённяшнім курсе — калі грошы на мэту захоўваюцца ў яе валюце. Па курсах узносаў — калі яны захоўваюцца ў рублях: кожны ўзнос улічваецца ў рублях па курсе на дзень узносу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum heutigen Kurs — wenn das Geld des Ziels in seiner Währung liegt. Zu den Kursen der Beiträge — wenn es in Rubel liegt: Jeder Beitrag zählt mit den Rubeln seines Tages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At today's rate — when the goal's money is kept in its currency. At the rates of the contributions — when it is kept in rubles: each contribution counts with the rubles of its day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tipo de hoy — cuando el dinero del objetivo se guarda en su divisa. Al tipo de cada aportación — cuando se guarda en rublos: cada aportación cuenta con los rublos de su día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au cours du jour — quand l'argent de l'objectif est gardé dans sa devise. Au cours des contributions — quand il est gardé en roubles : chaque contribution compte avec les roubles de son jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tasso di oggi: quando i risparmi sono conservati nella valuta dell’obiettivo. Ai tassi dei versamenti: quando sono conservati in rubli; ogni versamento vale i rubli del giorno in cui è stato effettuato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгінгі бағаммен — мақсат ақшасы оның валютасында сақталса. Жарналар бағамымен — рубльде сақталса: әр жарна өз күніндегі рубль сомасымен есептеледі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По сегодняшнему курсу — если деньги цели лежат в её валюте. По курсу взносов — если они лежат в рублях: каждый взнос считается рублями своего дня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За сьогоднішнім курсом — коли гроші цілі зберігаються в її валюті. За курсами внесків — коли в рублях: кожен внесок враховується в рублях свого дня."
          }
        }
      }
    },
    "settings.planning.includesGoals": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на мэты знаходзяцца на рахунках у аглядзе"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zielgeld liegt auf Konten in der Übersicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal money sits on accounts in the summary"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de los objetivos está en cuentas del resumen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent des objectifs se trouve sur des comptes du récapitulatif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risparmi per gli obiettivi sono su conti nel riepilogo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат ақшасы жиынтықтағы шоттарда"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги целей лежат на счетах в сводке"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші цілей лежать на рахунках у підсумку"
          }
        }
      }
    },
    "settings.planning.includesGoalsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі ўключана, сума «Можна выдаткаваць» не ўключае грошы, ужо адкладзеныя на мэты. Выключыце, калі грошы на мэты захоўваюцца на рахунку па-за аглядам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeschaltet lässt „Kann ausgegeben werden“ das bereits in Ziele gelegte Geld weg. Ausschalten, wenn das Zielgeld auf einem Konto außerhalb der Übersicht liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, «can spend» leaves out the money already put into goals. Turn it off when goal money is kept on an account outside the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado, «se puede gastar» no incluye el dinero ya aportado a objetivos. Desactívelo cuando el dinero de los objetivos se guarde en una cuenta fuera del resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé, « peut dépenser » exclut l'argent déjà mis dans les objectifs. Désactivez quand l'argent des objectifs est gardé sur un compte hors du récapitulatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, «Disponibile da spendere» esclude i risparmi già destinati agli obiettivi. Disattivalo se sono su un conto fuori dal riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосулы болса, «жұмсауға болады» сомасына мақсаттарға салынған ақша кірмейді. Мақсат ақшасы жиынтыққа кірмейтін шотта болса, өшіріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, «можно тратить» не считает деньги, уже отложенные на цели. Выключите, если деньги целей лежат на счёте вне сводки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ввімкнено, «Можна витрачати» не враховує вже відкладені на цілі гроші. Вимкніть, якщо гроші цілей зберігаються на рахунку поза підсумком."
          }
        }
      }
    },
