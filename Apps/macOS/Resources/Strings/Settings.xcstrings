    "archive.noPassword.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything inside — names of people, places and every amount — will lie in the open. Anyone who gets the file can read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que contiene — nombres de personas, lugares y cada importe — quedará a la vista. Cualquiera que tenga el archivo podrá leerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qu'elle contient — les noms des personnes, les lieux et chaque montant — sera visible à découvert. Quiconque obtient le fichier peut le lire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё внутри — имена людей, места и все суммы — будет лежать в открытом виде. Любой, у кого окажется файл, это прочитает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе всередині — імена людей, місця й кожна сума — зберігатиметься відкрито. Кожен, хто отримає файл, зможе його прочитати."
          }
        }
      }
    },
    "archive.noPassword.title": {
      "comment": "Translation not verified by a native speaker.",
