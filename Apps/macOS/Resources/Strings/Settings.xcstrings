    "references.archiveHint.events": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived event is no longer offered when you enter operations or in lists; its operations, Analytics and Reports keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento archivado ya no se ofrece al introducir operaciones ni en las listas; sus operaciones, la Analítica y los Informes lo siguen conservando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un événement archivé n'est plus proposé à la saisie des opérations ni dans les listes ; ses opérations, l'Analyse et les Rapports le gardent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Событие в архиве не предлагается при вводе и в списках, а его операции, «Аналитика» и «Отчёты» его сохраняют."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Архівна подія більше не пропонується під час вводу та в списках; її операції, аналітика й звіти зберігають її."
          }
        }
      }
    },
