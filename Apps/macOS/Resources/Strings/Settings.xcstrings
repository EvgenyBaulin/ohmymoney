    "backups.dataSet.noMirror": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A data set keeps its copies in its own folder: they go to no chosen folder, and the folder chosen for your own data stays as it is"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conjunto de datos guarda sus copias en su propia carpeta: no van a ninguna carpeta elegida, y la carpeta elegida para sus datos propios se queda como está"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор данных хранит копии в своей папке: в выбранную папку они не идут, а папка, выбранная для ваших данных, остаётся прежней"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Набір даних зберігає копії у власній папці: вони не потрапляють до вибраної папки, а папка для ваших даних залишається без змін"
          }
        }
      }
    },
