    "archive.import.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the app is replaced by what is inside the archive. A copy of the current state is written first, and the app restarts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что есть в приложении, заменится содержимым архива. Копия текущего состояния будет сделана заранее, затем приложение перезапустится."
          }
        }
      }
    },
    "archive.import.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive could not be opened"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив открыть не удалось"
          }
        }
      }
    },
    "archive.import.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load this archive?"
