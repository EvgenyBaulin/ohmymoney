    "backups.freeUp.nothing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nothing to delete: the copies that may go are already gone. Copies made before an update stay; you can remove the old ones with «Delete older than a year»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалять нечего: копии, которые можно убрать, уже убраны. Копии «перед обновлением» остаются; старые можно убрать кнопкой «Удалить старше года»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає що видаляти: усі придатні для видалення копії вже прибрано. Копії перед оновленнями залишаються; старі можна видалити через «Видалити старше року»."
          }
        }
      }
    },
