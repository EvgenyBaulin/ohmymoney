    "backups.readable.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The readable version of a copy (a folder of CSV files beside the copy of the day and the copy made before an update) lies on this Mac only. A folder in iCloud Drive gets the .sqlite file alone — in the open, not encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión legible de una copia (una carpeta de archivos CSV junto a la copia del día y la copia hecha antes de una actualización) está solo en este Mac. Una carpeta en iCloud Drive recibe solo el archivo .sqlite — en claro, sin cifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version lisible d'une copie (un dossier de fichiers CSV à côté de la copie du jour et de la copie faite avant une mise à jour) reste sur ce Mac seulement. Un dossier dans iCloud Drive reçoit le seul fichier .sqlite — à découvert, non chiffré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаемая версия копии (папка с CSV рядом с копией дня и копией «перед обновлением») лежит только на этом Mac. В папку iCloud Drive попадает только файл .sqlite — открыто, без шифрования."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читабельна версія копії (папка CSV-файлів поруч із копією дня та копією перед оновленням) зберігається лише на цьому Mac. До папки в iCloud Drive потрапляє лише файл .sqlite — відкритий, без шифрування."
          }
        }
      }
    },
