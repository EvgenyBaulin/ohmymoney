    "settings.appearance.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mövzu dərhal tətbiq olunur — yenidən başlatmağa ehtiyac yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэма змяняецца адразу — перазапуск не патрэбны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzhled se změní ihned, bez restartování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Design gilt sofort — kein Neustart nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The theme applies at once — no restart needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tema se aplica al momento — no hace falta reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le thème s'applique tout de suite — pas besoin de redémarrer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թեման կիրառվում է անմիջապես․ վերագործարկում պետք չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tema viene applicato subito, senza riavviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマはすぐに適用されます。再起動は不要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თემა მაშინვე იცვლება — ხელახლა გაშვება საჭირო არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тақырып бірден қолданылады — қайта іске қосу қажет емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема дароо колдонулат — кайра иштетүүнүн кереги жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het thema wordt direct toegepast. Opnieuw opstarten is niet nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motyw zmienia się od razu — ponowne uruchomienie nie jest potrzebne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tema é aplicado imediatamente, sem precisar reiniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O tema é aplicado de imediato — não é necessário reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема применяется сразу, перезапуск не нужен."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мавзӯъ фавран татбиқ мешавад — бозоғозӣ лозим нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema hemen uygulanır; yeniden başlatma gerekmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема застосовується одразу — перезапуск не потрібен."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavzu darhol qo‘llanadi — qayta ishga tushirish shart emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题立即生效，无需重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題會立即套用，無須重新啟動。"
          }
        }
      }
    },
