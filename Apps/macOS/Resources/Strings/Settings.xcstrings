      }
    },
    "settings.planning.reserveEventsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Davam edən və ya seçilmiş tarixədək başlayacaq hər tədbirin büdcə qalığı sərbəst pula daxil edilmir; tədbirlə bağlı ödəniş həmin büdcənin bir hissəsidir. Söndürüldükdə büdcə üçün vəsait ayrılmır, bağlı ödəniş isə adi ödəniş kimi ayrılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэшта бюджэту кожнай падзеі, якая ўжо ідзе або пачнецца да выбранай даты, не лічыцца свабоднымі грашыма; звязаны з падзеяй плацёж уваходзіць у яе бюджэт. Калі выключана, бюджэт не рэзервуецца, а звязаны плацёж рэзервуецца як звычайны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývající rozpočet každé probíhající události nebo události, která začne do zvoleného data, se nezapočítává do volných peněz. Platba přiřazená k události je součástí jejího rozpočtu. Je-li volba vypnutá, rozpočty se neodkládají a přiřazená platba se odloží jako běžná platba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was vom Budget jedes laufenden oder bald beginnenden Ereignisses bis zum gewählten Datum übrig ist, zählt nicht als freies Geld; eine an ein Ereignis gebundene Zahlung gehört zu diesem Budget. Ausgeschaltet wird kein Budget zurückgehalten, und eine gebundene Zahlung wird wie eine gewöhnliche zurückgehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is left of the budget of every event under way or about to start by the chosen date is not counted as free money; a payment tied to an event is part of that budget. Off, no budget is held back and a tied payment is held back as an ordinary one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que queda del presupuesto de cada evento en curso o a punto de empezar, hasta la fecha elegida, no cuenta como dinero libre; un pago ligado a un evento forma parte de ese presupuesto. Desactivado, no se descuenta ningún presupuesto y un pago ligado se descuenta como uno normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste du budget de chaque événement en cours ou sur le point de commencer, à la date choisie, n'est pas compté comme argent libre ; un paiement lié à un événement fait partie de ce budget. Désactivé, aucun budget n'est retenu et un paiement lié est retenu comme un paiement ordinaire."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրված ամսաթվի դրությամբ ընթացող կամ սկսվող յուրաքանչյուր իրադարձության բյուջեի մնացորդը չի հաշվվում որպես ազատ գումար։ Իրադարձությանը կապված վճարումը այդ բյուջեի մասն է։ Անջատված լինելու դեպքում բյուջեն չի պահուստավորվում, իսկ կապված վճարումը պահուստավորվում է որպես սովորական վճարում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il budget residuo di ogni evento in corso o in partenza entro la data scelta non è incluso nel denaro disponibile; un pagamento collegato a un evento fa parte del suo budget. Se disattivato, il budget non viene accantonato e i pagamenti collegati vengono accantonati come gli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した日付までに開催中または開始予定の各イベントについて、予算の残額を「使えるお金」から差し引きます。イベントに紐付いた支払いはその予算に含まれます。オフの場合、予算は差し引かれず、紐付いた支払いは通常の支払いとして差し引かれます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არჩეულ თარიღამდე დაწყებული ან დასაწყები ღონისძიებების ბიუჯეტების ნაშთი თავისუფალ თანხაში არ ითვლება. ღონისძიებასთან დაკავშირებული გადახდა მისი ბიუჯეტის ნაწილია. გამორთვისას ბიუჯეტი არ გადაიდება, ხოლო დაკავშირებული გადახდა ჩვეულებრივ გადახდად ჩაითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған күнге дейін басталатын не жүріп жатқан оқиғалардың бюджет қалдығы бос ақшаға кірмейді; оқиғаға тіркелген төлем сол бюджетке кіреді. Өшірулі болса, бюджет резервтелмейді, тіркелген төлем кәдімгі төлем ретінде резервтеледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүрүп жаткан же тандалган күнгө чейин баштала турган ар бир иш-чаранын бюджетинин калдыгы эркин акчага кошулбайт. Иш-чарага байланышкан төлөм анын бюджетине кирет. Өчүрүлгөндө бюджет кармалбайт, ал эми байланышкан төлөм кадимки төлөм катары кармалат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resterende budget van elke gebeurtenis die loopt of uiterlijk op de gekozen datum begint, telt niet mee als vrij te besteden geld. Een betaling die aan een gebeurtenis is gekoppeld, maakt deel uit van dat budget. Als dit uitstaat, wordt geen budget gereserveerd en telt een gekoppelde betaling als gewone verplichting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostały budżet każdego trwającego wydarzenia oraz wydarzenia rozpoczynającego się do wybranej daty jest wyłączony z wolnych środków. Powiązana płatność jest częścią tego budżetu. Gdy opcja jest wyłączona, budżet nie jest rezerwowany, a powiązana płatność jest traktowana jak zwykła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo do orçamento de cada evento em andamento ou prestes a começar até a data escolhida não conta como dinheiro livre; um pagamento vinculado a um evento faz parte desse orçamento. Quando desativado, nenhum orçamento é reservado e o pagamento vinculado é reservado como um pagamento comum."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O restante orçamento de cada evento em curso ou que comece até à data escolhida não conta como dinheiro disponível; um pagamento associado a um evento faz parte desse orçamento. Quando desativado, não é reservado qualquer orçamento e um pagamento associado é reservado como um pagamento normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток бюджета каждого события, идущего сейчас или начинающегося до выбранной даты, не считается свободными деньгами; платёж, привязанный к событию, входит в этот остаток. Выключено — бюджеты событий не вычитаются, а привязанный платёж вычитается как обычный."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи буҷети ҳар рӯйдоде, ки идома дорад ё то санаи интихобшуда оғоз мешавад, маблағи озод ҳисоб намешавад; пардохти вобаста ба рӯйдод қисми ҳамон буҷет аст. Ҳангоми хомӯш будан буҷет ҷудо намешавад ва пардохти вобаста чун пардохти одӣ ҷудо мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen tarihte devam eden veya başlayacak her etkinliğin kalan bütçesi harcanabilir paraya katılmaz. Etkinliğe bağlı ödeme bu bütçenin parçasıdır. Kapalıyken bütçe ayrılmaz ve bağlı ödeme normal ödeme olarak ayrılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок бюджету кожної поточної події або події, що почнеться до вибраної дати, не вважається вільними грошима; пов'язаний із подією платіж — частина бюджету. Якщо вимкнено, бюджет не резервується, а пов'язаний платіж резервується як звичайний."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlangan sanagacha davom etayotgan yoki boshlanadigan har bir tadbir budjetining qoldig‘i erkin pulga kirmaydi; tadbirga bog‘langan to‘lov shu budjetning bir qismidir. O‘chirilganda budjet uchun pul ajratilmaydi, bog‘langan to‘lov esa oddiy to‘lov kabi ajratiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截至所选日期，进行中或即将开始的活动的预算余额不计入可支配金额；关联活动的付款计入该活动预算。关闭后，不预留活动预算，关联付款按普通付款预留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中或將於所選日期前開始的活動，其預算餘額不計入可用資金；關聯活動的付款屬於該活動預算。關閉後，不預留活動預算，關聯付款則會按一般付款預留。"
          }
        }
      }
    },
    "settings.planning.reserveHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş tarixədək edilməsi planlaşdırılan, lakin hələ edilməmiş köçürmələr sərbəst pula daxil edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запланаваныя ўзносы, яшчэ не зробленыя да выбранай даты, не лічацца свабоднымі грашыма."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plánované příspěvky, které do zvoleného data ještě neproběhly, se nezapočítávají do volných peněz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante Beiträge, die bis zum gewählten Datum noch nicht geleistet sind, zählen nicht als freies Geld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planned contributions not yet made by the chosen date are not counted as free money."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aportaciones previstas que aún no se han hecho hasta la fecha elegida no cuentan como dinero libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contributions prévues et pas encore faites à la date choisie ne sont pas comptées comme argent libre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրված ամսաթվի դրությամբ պլանավորված, բայց դեռ չարված մուծումները չեն հաշվվում որպես ազատ գումար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I versamenti previsti entro la data scelta e non ancora effettuati non sono inclusi nel denaro disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した日付までの未実行の積立予定を「使えるお金」から差し引きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არჩეულ თარიღამდე დაგეგმილი, მაგრამ ჯერ განუხორციელებელი შენატანები თავისუფალ თანხაში არ ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған күнге дейін жоспарланған, бірақ әлі салынбаған жарналар бос ақшаға кірмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тандалган күнгө чейин киргизиле элек пландуу салымдар эркин акчага кошулбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplande inleg die op de gekozen datum nog niet is gedaan, telt niet mee als vrij te besteden geld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłaty zaplanowane do wybranej daty, które nie zostały jeszcze dokonane, są wyłączone z wolnych środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aportes planejados ainda não feitos até a data escolhida não contam como dinheiro livre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As contribuições planeadas ainda não efetuadas até à data escolhida não contam como dinheiro disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несделанные плановые взносы до выбранной даты не считаются свободными деньгами."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасандозҳои нақшавие, ки то санаи интихобшуда ҳанӯз гузошта нашудаанд, маблағи озод ҳисоб намешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen tarihe kadar yapılması planlanan katkılar harcanabilir paraya katılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заплановані внески, ще не зроблені до вибраної дати, не вважаються вільними грошима."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlangan sanagacha rejalangan, ammo hali kiritilmagan badallar erkin pulga kirmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截至所选日期尚未存入的计划金额不计入可支配金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截至所選日期尚未存入的計畫金額不計入可用資金。"
          }
        }
      }
    },
