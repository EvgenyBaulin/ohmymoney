    "categories.delete.used.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» kateqoriyasında %2$@ var. Onlar üçün yeni kateqoriya seçin: əvvəlcə əməliyyatlar köçürüləcək, sonra kateqoriya silinəcək. Hər iki addımı geri almaq üçün “Geri al” düyməsinə iki dəfə toxunun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%1$@»: %2$@. Выберыце новую катэгорыю для аперацый: спачатку яны будуць перамешчаны, потым катэгорыя будзе выдалена. Для адмены націсніце “Адмяніць” двойчы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ v kategorii «%1$@». Vyberte pro ně novou kategorii: nejprve se přesunou, pak se kategorie smaže. Obě akce vrátíte dvojím klepnutím na „Zpět“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ unter „%1$@“. Wählen Sie ein neues Zuhause für das, was dort eingeordnet ist: Es wandert zuerst, die Kategorie danach. Zwei Schritte von „Rückgängig“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ under «%1$@». Choose a new home for what is filed there: it moves first, the category goes after. Two steps of “Undo”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ bajo «%1$@». Elija un nuevo destino para lo que hay archivado allí: primero se mueve, después la categoría. Dos pasos de «Deshacer»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ dans « %1$@ ». Choisissez un nouveau lieu pour ce qui y est classé : cela se déplace d'abord, la catégorie part ensuite. Deux étapes de « Annuler »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» կատեգորիայում %2$@։ Ընտրեք նոր կատեգորիա․ նախ գործարքները կտեղափոխվեն, ապա կատեգորիան կջնջվի։ Հետարկելու համար երկու անգամ սեղմեք «Հետարկել»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ in «%1$@». Scegli una nuova categoria per le operazioni: verranno spostate prima di eliminare la categoria. Tocca “Annulla” due volte per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»には%2$@。取引の移動先を選択してください。先に取引が移動され、その後カテゴリが削除されます。元に戻すには「取り消す」を2回選択します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» შეიცავს: %2$@. აირჩიეთ ოპერაციების ახალი კატეგორია: ჯერ ისინი გადავა, შემდეგ კატეგორია წაიშლება. ორივეს გასაუქმებლად ორჯერ აირჩიეთ „გაუქმება“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ «%1$@» астында. Онда тіркелгендер үшін жаңа орын таңдаңыз: алдымен көшеді, санат кейін жойылады. «Болдырмау» екі рет."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ичинде %2$@. Алар үчүн жаңы категория тандаңыз: адегенде операциялар жылдырылат, андан кийин категория өчүрүлөт. Кайтаруу үчүн “Артка кайтаруу” эки жолу басылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ onder «%1$@». Kies een nieuwe categorie voor deze transacties. Ze worden eerst verplaatst, daarna wordt de categorie verwijderd. Maak dit in twee stappen ongedaan met “Herstel”."
          }
