    "settings.anomalies.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher sensitivity finds more and asks more often; a lower one only says what is plainly out of place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sensibilidad mayor encuentra más y pregunta con más frecuencia; una menor solo señala lo que está claramente fuera de lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше чувствительность, тем больше находок и вопросов; низкая говорит только о явно выбивающемся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вища чутливість знаходить більше й запитує частіше; нижча повідомляє лише про явно незвичне."
          }
        }
      }
