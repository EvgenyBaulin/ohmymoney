    "currencies.custom.firstRateHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May be left empty: until the first rate, amounts in this currency have no rate — rubles are never guessed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede quedar vacío: hasta el primer tipo, los importes de esta divisa no tienen tipo — los rublos nunca se adivinan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut rester vide : jusqu'au premier cours, les montants de cette devise n'ont pas de taux — les roubles ne sont jamais devinés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно оставить пустым: до первого курса у сумм в этой валюте курса нет — рубли не угадываются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна залишити порожнім: до першого курсу суми в цій валюті не мають курсу — рублі не вгадуються."
          }
        }
      }
    },
    "currencies.custom.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currencies the Bank of Russia does not publish — tokens, points: a code of three capital Latin letters that is no ISO code, a rate you type yourself, with its history. The bank is never asked for them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisas que el Banco de Rusia no publica — tokens, puntos: un código de tres letras latinas mayúsculas que no es código ISO, un tipo que escribe usted mismo, con su historial. Al banco nunca se le pregunta por ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devises que la Banque de Russie ne publie pas — jetons, points : un code de trois lettres latines majuscules qui n'est pas un code ISO, un cours que vous saisissez vous-même, avec son historique. La banque n'est jamais interrogée à leur sujet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюты, которых нет у ЦБ, — токены, баллы: код из трёх латинских заглавных букв (не код ISO), курс вписываете сами, с историей. ЦБ эти коды не спрашивает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюти, які не публікує Банк Росії, — токени, бали: код із трьох великих латинських літер, що не є кодом ISO, власний курс та його історія. До банку за ними не звертаються."
          }
        }
      }
    },
    "currencies.custom.manage": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
