    "settings.privacy.lockRefused": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiqlənmədi — kilid sönülü qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пацверджана — блакіроўка застаецца выключанай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepotvrzeno — zámek zůstává vypnutý."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht bestätigt — die Sperre bleibt aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not confirmed — the lock stays off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No confirmado — el bloqueo sigue desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non confirmé — le verrou reste désactivé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաստատվեց․ կողպումը մնում է անջատված։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non confermato: il blocco resta disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認できませんでした。ロックはオフのままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არ დადასტურდა — დაბლოკვა გამორთული რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Расталмады — құлып өшірулі қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ырасталган жок — кулпу өчүк бойдон калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet bevestigd. De vergrendeling blijft uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie potwierdzono — blokada pozostaje wyłączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não confirmado — o bloqueio continua desativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não confirmado — o bloqueio permanece desativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не подтверждено — блокировка не включена."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тасдиқ нашуд — қулф хомӯш мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmadı; kilit kapalı kalacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не підтверджено — блокування залишається вимкненим."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasdiqlanmadi — qulf o‘chirilganicha qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未确认，锁定仍处于关闭状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未確認，鎖定功能維持關閉。"
          }
        }
      }
    },
    "settings.privacy.lockUnavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac-da nə Touch ID, nə də giriş parolu var — kilidi aktiv etmək mümkün deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На гэтым Mac няма ні Touch ID, ні пароля ўваходу — уключыць блакіроўку немагчыма."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac nemá Touch ID ani přihlašovací heslo — zámek nelze zapnout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat weder Touch ID noch ein Anmeldepasswort — die Sperre kann nicht eingeschaltet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has neither Touch ID nor a login password — the lock cannot be turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene ni Touch ID ni contraseña de inicio de sesión — el bloqueo no se puede activar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n'a ni Touch ID ni mot de passe de session — le verrou ne peut pas être activé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս Mac-ը չունի ոչ Touch ID, ոչ մուտքի գաղտնաբառ․ կողպումը հնարավոր չէ միացնել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non dispone di Touch ID né di una password di accesso: non è possibile attivare il blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにはTouch IDもログインパスワードもないため、ロックをオンにできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ Mac-ს არც Touch ID აქვს და არც შესვლის პაროლი — დაბლოკვის ჩართვა შეუძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл Mac құрылғысында Touch ID де, кіру құпиясөзі де жоқ — құлыпты қосу мүмкін емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул Mac'те Touch ID да, кирүү сырсөзү да жок — кулпуну күйгүзүү мүмкүн эмес."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac heeft geen Touch ID of inlogwachtwoord. De vergrendeling kan niet worden ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie ma Touch ID ani hasła logowania — nie można włączyć blokady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não tem Touch ID nem senha de início de sessão — o bloqueio não pode ser ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não tem Touch ID nem palavra-passe de início de sessão — não é possível ativar o bloqueio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Mac нет ни Touch ID, ни пароля для входа — блокировку не включить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ин Mac на Touch ID ҳаст, на гузарвожаи воридшавӣ — қулфро фаъол кардан имкон надорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te Touch ID veya giriş parolası yok; kilit açılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому Mac немає ні Touch ID, ні пароля входу — блокування неможливо ввімкнути."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’da Touch ID ham, kirish paroli ham yo‘q — qulfni yoqib bo‘lmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 未设置触控 ID 或登录密码，无法开启锁定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 未設定 Touch ID 或登入密碼，無法開啟鎖定功能。"
          }
        }
      }
    },
    "settings.privacy.noPassword": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təyin edilməyib — kilid Touch ID və Mac parolu ilə açılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зададзены — для разблакіроўкі выкарыстоўваюцца Touch ID і пароль Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenastaveno — zámek otevřete pomocí Touch ID nebo hesla Macu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht festgelegt — Touch ID und das Passwort des Mac öffnen die Sperre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set — Touch ID and the password of the Mac open the lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin fijar — Touch ID y la contraseña del Mac abren el bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non défini — Touch ID et le mot de passe du Mac ouvrent le verrou."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանված չէ․ կողպումը բացվում է Touch ID-ով կամ Mac-ի գաղտնաբառով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non impostata: usa Touch ID o la password del Mac per sbloccare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定。Touch IDまたはMacのパスワードでロックを解除できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არ არის დაყენებული — განბლოკვა შესაძლებელია Touch ID-ით ან Mac-ის პაროლით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орнатылмаған — құлыпты Touch ID және Mac құпиясөзі ашады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Орнотулган эмес — кулпу Touch ID жана Mac сырсөзү менен ачылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet ingesteld. Ontgrendel met Touch ID of het wachtwoord van deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono — blokadę można otworzyć za pomocą Touch ID lub hasła Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não definida — o Touch ID e a senha do Mac desbloqueiam o app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não definida — o Touch ID e a palavra-passe do Mac desbloqueiam a app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не задан — блокировку открывают Touch ID и пароль Mac."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танзим нашудааст — қулф бо Touch ID ва гузарвожаи Mac кушода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlanmadı; kilit Touch ID ve Mac parolasıyla açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не задано — блокування відкривається через Touch ID і пароль Mac."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘rnatilmagan — qulf Touch ID va Mac paroli bilan ochiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置，可使用触控 ID 或 Mac 密码解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定，可使用 Touch ID 或 Mac 密碼解鎖。"
          }
        }
      }
    },
    "settings.privacy.notInDataSet": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumat dəstində və təlimdə kilid sönülüdür: onların hesabları uydurmadır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У наборы даных і навучальным рэжыме блакіроўка выключана: іх даныя выдуманыя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V datové sadě a v průvodci je zámek vypnutý: jejich údaje jsou smyšlené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sperre ist in einem Datensatz und im Lernprogramm aus: Deren Bücher sind erfunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock is off in a data set and in the tutorial: their books are made up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo está desactivado en un conjunto de datos y en el tutorial: sus cuentas son inventadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrou est désactivé dans un jeu de données et dans le didacticiel : leurs comptes sont inventés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների հավաքածուում և ուսուցման ընթացքում կողպումն անջատված է․ դրանց տվյալները հորինված են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco è disattivato nei set di dati e nel tutorial: i loro dati sono fittizi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データセットとチュートリアルでは、架空の帳簿を使用するためロックはオフです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ნაკრებსა და სასწავლო რეჟიმში დაბლოკვა გამორთულია: მათი მონაცემები გამოგონილია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер жиынында және оқытуда құлып өшірулі: ондағы есептер ойдан шығарылған."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайындар топтомунда жана окуу режиминде кулпу өчүк: андагы маалыматтар ойдон чыгарылган."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergrendeling staat uit in een gegevensset en in de rondleiding: de administratie is fictief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokada jest wyłączona w zestawie danych i w samouczku: ich dane są fikcyjne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio fica desativado em conjuntos de dados e no tutorial: os lançamentos são fictícios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio está desativado num conjunto de dados e no tutorial: os respetivos registos são fictícios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В наборе данных и в учебном режиме блокировки нет: там учёт выдуманный."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар маҷмӯи маълумот ва дарс қулф хомӯш аст: маълумоти онҳо намунавӣ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veri setlerinde ve öğreticide kilit kapalıdır; kayıtlar örnektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У наборі даних і навчанні блокування вимкнено: облік там вигаданий."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar to‘plami va qo‘llanmada qulf o‘chirilgan: ulardagi ma’lumotlar namunaviy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据集和教程中的账目为虚构内容，锁定已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料集和教學中的帳簿為虛構資料，因此不會鎖定。"
          }
        }
      }
    },
