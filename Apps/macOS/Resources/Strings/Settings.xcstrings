    "export.warning.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспартаваныя файлы змяшчаюць імёны людзей і сумы. Яны захоўваюцца па-за ізаляваным асяроддзем праграмы ў выбраным вамі месцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die exportierten Dateien enthalten Namen von Personen und Beträge. Sie verlassen die Sandbox der App und bleiben dort, wo Sie sie ablegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exported files contain names of people and amounts. They leave the app's sandbox and stay wherever you put them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos exportados contienen nombres de personas e importes. Salen del entorno aislado de la app y se quedan donde los guarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers exportés contiennent des noms de personnes et des montants. Ils sortent du bac à sable de l'app et restent là où vous les mettez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file esportati contengono nomi di persone e importi. Escono dalla sandbox dell’app e rimangono nella posizione scelta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортталған файлдарда адамдардың аттары мен сомалар бар. Олар қолданба құмсалғышынан шығады және қай жерге қойсаңыз, сонда қалады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportowane pliki zawierają imiona i nazwiska oraz kwoty. Opuszczą piaskownicę aplikacji i pozostaną w wybranym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos exportados contêm nomes de pessoas e valores. Eles saem do armazenamento protegido do app e permanecem onde você os salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выгруженных файлах есть имена людей и суммы. Они покидают песочницу приложения и останутся там, куда вы их положите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarılan dosyalar kişi adlarını ve tutarları içerir. Dosyalar uygulamanın korumalı alanından çıkar ve kaydettiğiniz yerde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортовані файли містять імена людей і суми. Вони залишають пісочницю застосунку й зберігаються там, куди ви їх покладете."
          }
        }
      }
    },
