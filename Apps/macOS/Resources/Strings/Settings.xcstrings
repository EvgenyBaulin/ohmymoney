    "settings.appearance.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэма змяняецца адразу — перазапуск не патрэбны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Design gilt sofort — kein Neustart nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The theme applies at once — no restart needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tema se aplica al momento — no hace falta reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le thème s'applique tout de suite — pas besoin de redémarrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tema viene applicato subito, senza riavviare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тақырып бірден қолданылады — қайта іске қосу қажет емес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motyw zmienia się od razu — ponowne uruchomienie nie jest potrzebne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tema é aplicado imediatamente, sem precisar reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема применяется сразу, перезапуск не нужен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema hemen uygulanır; yeniden başlatma gerekmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема застосовується одразу — перезапуск не потрібен."
          }
        }
      }
    },
