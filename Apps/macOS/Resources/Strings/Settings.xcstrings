    "settings.entry.orderHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a field up or down. The ↓ panel shows its fields in this order, and Tab moves through them in it. The type of the operation always stays on top; “Split”, “Paid for someone” and “On credit” stay at the bottom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un campo arriba o abajo. El panel ↓ muestra sus campos en este orden, y Tab se mueve por ellos en ese orden. El tipo de la operación siempre queda arriba; «Dividir», «Pagado por otro» y «A crédito» quedan abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un champ vers le haut ou le bas. Le panneau ↓ affiche ses champs dans cet ordre, et Tab les parcourt dans le même ordre. Le type de l'opération reste toujours en haut ; « Répartir », « Payé pour quelqu'un » et « À crédit » restent en bas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите поле выше или ниже. В этом порядке панель ↓ показывает поля, и в нём же Tab переходит между ними. Тип операции всегда сверху, «Разделить», «За другого» и «В кредит» — внизу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть поле вгору або вниз. Панель ↓ показує поля в цьому порядку, і Tab переходить між ними так само. Вид операції завжди зверху; «Розбити», «Оплачено за іншого» та «У кредит» — знизу."
          }
        }
      }
    },
