    "backups.beforeUpdate.deleteOld": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ildən köhnələri sil…"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаліць старэйшыя за год…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat starší než rok…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Älter als ein Jahr löschen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete older than a year…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar las de más de un año…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer celles de plus d'un an…"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջել մեկ տարուց հին պատճենները…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina quelle più vecchie di un anno…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1年より前のコピーを削除…"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წელზე ძველის წაშლა…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір жылдан ескісін жою…"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир жылдан эскилерин өчүрүү…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder ouder dan een jaar…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń starsze niż rok…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar cópias com mais de um ano…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar cópias com mais de um ano…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить старше года…"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нест кардани нусхаҳои аз як сол кӯҳна…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Yıldan Eskileri Sil…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити старше року…"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yildan eskilarini o‘chirish…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除超过一年的副本…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除超過一年的副本…"
          }
        }
      }
    },
    "backups.beforeUpdate.keptForever": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "avtomatik silinmir; “Bir ildən köhnələri sil…” ən yeni nüsxəni saxlayır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "не выдаляюцца аўтаматычна; «Выдаліць старэйшыя за год…» захоўвае найноўшую копію"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "nemažou se automaticky; volba „Smazat starší než rok…“ ponechá nejnovější kopii"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wird nicht automatisch entfernt; „Älter als ein Jahr löschen…“ behält die neueste Kopie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not removed automatically; “Delete older than a year…” keeps the newest copy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no se eliminan automáticamente; «Eliminar las de más de un año…» conserva la copia más reciente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pas supprimées automatiquement ; « Supprimer celles de plus d'un an… » garde la copie la plus récente"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "ինքնաբերաբար չի ջնջվում․ «Ջնջել մեկ տարուց հին պատճենները…» գործողությունը պահում է ամենանոր պատճենը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "non vengono rimosse automaticamente; “Elimina quelle più vecchie di un anno…” conserva la copia più recente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では削除されません。「1年より前のコピーを削除…」では最新のコピーが残ります"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ავტომატურად არ იშლება; “წელზე ძველის წაშლა…” უახლეს ასლს ინარჩუნებს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "автоматты түрде жойылмайды; «Бір жылдан ескісін жою…» ең жаңа көшірмені қалдырады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "автоматтык түрдө өчүрүлбөйт; “Бир жылдан эскилерин өчүрүү…” эң жаңы көчүрмөнү сактайт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "wordt niet automatisch verwijderd; ‘Verwijder ouder dan een jaar…’ behoudt de nieuwste kopie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "nie są usuwane automatycznie; opcja „Usuń starsze niż rok…” zachowuje najnowszą kopię"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "não são removidas automaticamente; “Apagar cópias com mais de um ano…” mantém a cópia mais recente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "não são apagadas automaticamente; «Apagar cópias com mais de um ano…» mantém a cópia mais recente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "не удаляются сами; «Удалить старше года…» оставляет самую свежую копию"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "ба таври худкор нест намешавад; «Нест кардани нусхаҳои аз як сол кӯҳна…» нусхаи навтаринро нигоҳ медорад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "otomatik olarak silinmez; “Bir Yıldan Eskileri Sil…” en yeni kopyayı korur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "не видаляються автоматично; «Видалити старше року…» залишає найновішу копію"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "avtomatik o‘chirilmaydi; “Bir yildan eskilarini o‘chirish…” eng yangi nusxani saqlab qoladi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动删除；“删除超过一年的副本…”会保留最新副本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會自動移除；「刪除超過一年的副本…」會保留最新的副本"
          }
        }
      }
    },
    "backups.beforeUpdate.newestStays": {
      "comment": "Translation not verified by a native speaker.",
