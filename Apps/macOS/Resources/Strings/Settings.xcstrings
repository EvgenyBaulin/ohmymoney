    "settings.entry.keyboardHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Цяпер Tab перамяшчае фокус толькі паміж тэкставымі палямі. Каб пераходзіць і да меню, уключыце “Навігацыя з клавіятуры” ў Сістэмныя налады → Клавіятура."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab wechselt jetzt nur zwischen Textfeldern. Damit es auch bei den Menüs hält, schalten Sie „Tastaturnavigation“ in den Systemeinstellungen unter Tastatur ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab now moves between text fields only. To have it stop at the menus as well, turn on “Keyboard navigation” in System Settings → Keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab ahora solo se mueve entre campos de texto. Para que también se detenga en los menús, active «Navegación con teclado» en Ajustes del Sistema → Teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab ne passe désormais qu'entre les champs de texte. Pour qu'il s'arrête aussi sur les menus, activez « Navigation au clavier » dans Réglages du système → Clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasto Tab si sposta solo tra i campi di testo. Per includere anche i menu, attiva “Navigazione tramite tastiera” in Impostazioni di Sistema → Tastiera."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір Tab тек мәтін өрістері арасында ауысады. Мәзірлерге де тоқтау үшін Жүйелік баптаулар → Пернетақта ішіндегі “Пернетақтамен шарлау” параметрін қосыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас Tab переходит только между полями ввода. Чтобы он останавливался и на списках, включите «Навигация с клавиатуры» в Системных настройках → Клавиатура."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз Tab переходить лише між текстовими полями. Щоб переходити також до меню, увімкніть «Навігацію клавіатурою» в «Системні параметри → Клавіатура»."
          }
        }
      }
    },
