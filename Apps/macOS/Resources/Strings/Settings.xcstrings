    "report.saveFailed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabatı orada saxlamaq mümkün olmadı. Başqa qovluq seçib yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося захаваць справаздачу ў гэтым месцы. Выберыце іншую папку і паспрабуйце яшчэ раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlášení se sem nepodařilo uložit. Vyberte jinou složku a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht konnte dort nicht gesichert werden. Wählen Sie einen anderen Ordner und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report could not be saved there. Choose another folder and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el informe allí. Elija otra carpeta e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport n'a pas pu être enregistré à cet endroit. Choisissez un autre dossier et réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հնարավոր չեղավ պահել հաշվետվությունն այդ տեղում։ Ընտրեք մեկ այլ պանակ և կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il rapporto in questa posizione. Scegli un’altra cartella e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートをそこに保存できませんでした。別のフォルダを選択して、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშის აქ შენახვა ვერ მოხერხდა. აირჩიეთ სხვა საქაღალდე და სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есепті мұнда сақтау мүмкін болмады. Басқа қалтаны таңдап, қайталаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчетту бул жерге сактоо мүмкүн болгон жок. Башка папканы тандап, кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het rapport kon daar niet worden bewaard. Kies een andere map en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zachować raportu w tym miejscu. Wybierz inny folder i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o relatório nesse local. Escolha outra pasta e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o relatório nesse local. Escolha outra pasta e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчёт не удалось сохранить в эту папку. Выберите другую и попробуйте ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гузориш дар он ҷо захира нашуд. Ҷузвдони дигареро интихоб кунед ва дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapor buraya kaydedilemedi. Başka bir klasör seçip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти звіт тут. Виберіть іншу папку й спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobotni bu yerga saqlab bo‘lmadi. Boshqa jildni tanlab, qayta urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将报告存储到此位置。请选择其他文件夹，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將報告儲存至該位置。請選擇其他檔案夾再試一次。"
          }
        }
      }
    },
