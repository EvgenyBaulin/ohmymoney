      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniləmədən əvvəl yaradılmış bir ildən köhnə nüsxə yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма копій, створаных перад абнаўленнем і старэйшых за год."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsou k dispozici žádné kopie vytvořené před aktualizací, které jsou starší než rok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Kopien, die vor einem Update entstanden und älter als ein Jahr sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no copies made before an update that are older than a year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay copias hechas antes de una actualización con más de un año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de copie faite avant une mise à jour de plus d'un an."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թարմացումից առաջ ստեղծված մեկ տարուց հին պատճեններ չկան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono copie create prima di un aggiornamento più vecchie di un anno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート前に作成された、1年より前のコピーはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განახლებამდე შექმნილი წელზე ძველი ასლები არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір жылдан ескі, жаңартудан бұрын жасалған көшірмелер жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңыртууга чейин түзүлгөн, бир жылдан эски көчүрмөлөр жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen kopieën van vóór een update die ouder zijn dan een jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma kopii sprzed uaktualnienia starszych niż rok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há cópias feitas antes de uma atualização com mais de um ano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há cópias com mais de um ano criadas antes de uma atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копий «перед обновлением» старше года нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нусхаҳои аз як сол кӯҳнаи пеш аз навсозӣ сохташуда нестанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme öncesi oluşturulmuş, bir yıldan eski kopya yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає копій перед оновленнями, старших за рік."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangilanishdan oldin yaratilgan bir yildan eski nusxalar yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有超过一年的更新前副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有更新前製作且超過一年的副本。"
          }
        }
      }
    },
