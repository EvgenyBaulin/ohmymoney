    "categories.cashbackHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income in this category and its subcategories counts as cashback in Analytics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ingreso en esta categoría y en sus subcategorías cuenta como cashback en Analítica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revenu dans cette catégorie et ses sous-catégories compte comme cashback dans l'Analyse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход в этой категории и её подкатегориях Analytics считает кэшбэком."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід у цій категорії та її підкатегоріях враховується як кешбек в аналітиці."
          }
        }
      }
    },
    "categories.cashbackRulesHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much cashback to expect is set by the rules of the accounts: on the account screen or in Settings → Accounts → “Cashback…”. A payment on a debt earns none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto cashback esperar lo fijan las reglas de las cuentas: en la pantalla de la cuenta o en Ajustes → Cuentas → «Cashback…». Un pago de deuda no genera ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cashback attendu se fixe par les règles des comptes : sur l'écran du compte ou dans Réglages → Comptes → « Cashback… ». Un paiement de dette n'en rapporte aucun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько кэшбэка ждать, задают правила счетов: экран счёта или «Настройки → Счета» → «Кэшбэк…». За платёж по долгу кэшбэк не платят."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний кешбек визначають правила рахунків: на екрані рахунку або в «Налаштування → Рахунки → Кешбек…». Платіж за боргом кешбеку не дає."
          }
        }
      }
    },
    "categories.delete.blocked": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» is used by %2$@. Put the category in the archive instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» la usa %2$@. Pase la categoría al archivo en su lugar."
