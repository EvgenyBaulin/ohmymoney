        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კურსი მხოლოდ საკუთარი ვალუტისთვის შეიყვანება — დანარჩენებს ბანკი ადგენს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бағам тек өз валютасына теріледі — басқаларын банк береді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс өз валютаңыз үчүн гана киргизилет — калгандарын банк берет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen voor een eigen valuta voer je een koers in. De bank levert de overige koersen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs można wpisać tylko dla własnej waluty — pozostałe podaje bank"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cotação só pode ser digitada para moedas próprias. O banco fornece as demais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pode introduzir uma taxa para uma moeda própria. As restantes são fornecidas pelo banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс вписывается только у своей валюты — курсы остальных даёт ЦБ"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурб танҳо барои асъори шахсӣ ворид мешавад — қурби дигаронро бонк медиҳад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur yalnızca özel para birimi için girilir; diğerleri bankadan alınır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс вводиться лише для власної валюти — інші надає банк"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs faqat shaxsiy valyuta uchun kiritiladi — qolganlarini bank beradi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能为自定义货币输入汇率，其他汇率由银行提供"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能為自訂貨幣輸入匯率，其他匯率由銀行提供"
          }
        }
      }
    },
