    "references.merge.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations of «%1$@» move to «%2$@», its name becomes another name of «%2$@», and «%1$@» goes to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de «%1$@» pasan a «%2$@», su nombre pasa a ser otro nombre de «%2$@», y «%1$@» va al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations de « %1$@ » passent sur « %2$@ », son nom devient un autre nom de « %2$@ », et « %1$@ » part aux archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции «%1$@» перейдут к «%2$@», его название станет другим названием «%2$@», а сам «%1$@» уйдёт в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції «%1$@» перейдуть до «%2$@», його назва стане іншою назвою «%2$@», а «%1$@» потрапить в архів."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» операциялары «%2$@» ішіне көшеді, атауы «%2$@» үшін басқа атау болады, ал «%1$@» мұрағатқа өтеді."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorgänge von „%1$@“ wandern zu „%2$@“, sein Name wird ein weiterer Name von „%2$@“, und „%1$@“ kommt ins Archiv."
          }
        }
      }
    },
