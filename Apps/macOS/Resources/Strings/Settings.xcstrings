    "settings.hints.creditHistoryHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On 1 February and 1 August: ask for your credit history — free twice a year in each bureau, through Gosuslugi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 1 de febrero y el 1 de agosto: pedir el historial crediticio — gratis dos veces al año en cada oficina de crédito, a través de Gosuslugi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 февраля и 1 августа: запросите кредитную историю — дважды в год бесплатно в каждом бюро, через Госуслуги"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1 лютого й 1 серпня: запитати кредитну історію — безкоштовно двічі на рік у кожному бюро через Держпослуги"
          }
        }
      }
    },
