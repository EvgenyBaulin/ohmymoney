    "backups.space.low": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мала месца для копій: вольна %@. Нічога не выдаляецца аўтаматычна."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Platz für Kopien: %@ frei. Von selbst wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little room for copies: %@ free. Nothing is deleted on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco espacio para las copias: libres %@. Nada se elimina por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de place pour les copies : %@ libres. Rien n'est supprimé de soi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco spazio per le copie: %@ disponibili. Nulla viene eliminato automaticamente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірмелерге орын аз: %@ бос. Өздігінен ештеңе жойылмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mało miejsca na kopie: dostępne %@. Nic nie jest usuwane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco espaço para cópias: %@ disponível. Nada é apagado automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало места для копий: свободно %@. Ничего не удаляется само."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalar için az yer var: %@ boş. Hiçbir şey kendiliğinden silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало місця для копій: вільно %@. Нічого не видаляється автоматично."
          }
        }
      }
    },
