            "value": "Write the archive without a password?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать архив без пароля?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записати архів без пароля?"
          }
        }
      }
    },
