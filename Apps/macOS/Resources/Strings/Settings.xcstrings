    "settings.currencies.defaultHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything new starts in it: the entry line, templates, scheduled payments, expected income, debts and goals. Totals, limits and reports stay in rubles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ней начинается всё новое: строка ввода, шаблоны, платежи, ожидаемые поступления, долги и цели. Итоги, лимиты и отчёты остаются в рублях."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе нове починається в ній: рядок вводу, шаблони, заплановані платежі, очікувані доходи, борги й цілі. Підсумки, ліміти та звіти залишаються в рублях."
          }
        }
