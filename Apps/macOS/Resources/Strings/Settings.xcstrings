    "settings.entry.hintsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Düymələr təkrarladığınız şablonlardır; təkliflər isə yazarkən göstərilən yerlər və oxşar əməliyyatlardır. Onları söndürmək yalnız gizlədir, heç nə silinmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопкі — гэта шаблоны, якімі вы часта карыстаецеся; падказкі — месцы і падобныя аперацыі, якія прапануюцца падчас уводу. Калі іх выключыць, яны схаваюцца, але не выдаляцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítka představují opakovaně používané šablony. Návrhy nabízejí místa a podobné operace při psaní. Vypnutím se jen skryjí, nic se nesmaže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chips sind die Vorlagen, die Sie wiederholen; Hinweise sind die Orte und ähnlichen Vorgänge, die beim Tippen angeboten werden. Ausschalten blendet sie aus, es löscht nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chips are the templates you repeat; hints are the places and alike operations offered as you type. Switching them off hides them, it deletes nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chips son las plantillas que repite; las sugerencias son los lugares y operaciones parecidas que se ofrecen mientras escribe. Desactivarlas las oculta, no borra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pastilles sont les modèles que vous répétez ; les suggestions sont les lieux et les opérations semblables proposés pendant la saisie. Les désactiver les masque, sans rien supprimer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կոճակները հաճախ կրկնվող ձևանմուշներն են, իսկ հուշումները՝ մուտքագրելիս առաջարկվող վայրերն ու նման գործառնությունները։ Անջատելիս դրանք թաքցվում են, ոչինչ չի ջնջվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pulsanti sono i modelli che usi spesso; i suggerimenti sono luoghi e operazioni simili proposti mentre scrivi. Se li disattivi, vengono nascosti senza eliminare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チップは繰り返し使うテンプレートです。候補には、入力中に場所や類似する取引が表示されます。オフにすると非表示になりますが、削除はされません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შაბლონები განმეორებადი ჩანაწერებისთვისაა; მინიშნებები კი აკრეფისას შემოთავაზებული ადგილები და მსგავსი ოპერაციებია. გამორთვა მათ მხოლოდ დამალავს და არაფერს წაშლის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Батырмалар — жиі қолданатын үлгілер; ұсыныстар — терген кезде көрсетілетін орындар мен ұқсас операциялар. Өшіргенде тек жасырылады, ештеңе жойылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблондор — сиз кайталаган жазуулар; сунуштар — терип жатканда көрсөтүлгөн жерлер жана окшош операциялар. Аларды өчүрүү эч нерсени жок кылбай, жашырат гана."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjabloonknoppen zijn sjablonen die je vaker gebruikt. Suggesties zijn plaatsen en soortgelijke transacties die tijdens het typen verschijnen. Als je ze uitschakelt, worden ze verborgen; er wordt niets verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciski to często używane szablony; podpowiedzi to miejsca i podobne operacje proponowane podczas pisania. Wyłączenie ich tylko je ukrywa — niczego nie usuwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos são modelos que você usa com frequência; as sugestões são locais e operações semelhantes exibidos enquanto você digita. Desativá-los apenas os oculta, sem apagar nada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os botões são os modelos que usa com frequência; as sugestões são locais e operações semelhantes apresentados enquanto escreve. Desativá-los apenas os oculta, sem apagar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чипы — шаблоны, которые вы повторяете; подсказки — места и похожие операции, пока вы печатаете. Выключение только прячет их, ничего не удаляет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тугмаҳо қолабҳои такроршавандаи шумоанд; пешниҳодҳо ҷойҳо ва амалиётҳои монанданд, ки ҳангоми навиштан пайдо мешаванд. Хомӯш кардан онҳоро пинҳон мекунад ва чизеро нест намекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düğmeler sık kullandığınız şablonlardır; öneriler ise yazarken sunulan yerler ve benzer işlemlerdir. Bunları kapatmak yalnızca gizler, hiçbir şeyi silmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони — це записи, які ви повторюєте; підказки — місця й схожі операції під час вводу. Вимкнення лише приховує їх, нічого не видаляючи."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugmalar — takrorlanadigan shablonlar; tavsiyalar esa yozayotganda taklif qilinadigan joylar va o‘xshash amallardir. Ularni o‘chirish faqat yashiradi, hech narsa o‘chirilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是你常用的模板；输入时会提示地点和类似交易。关闭后只会隐藏，不会删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本按鈕顯示常用的範本；提示則會在輸入時顯示地點和類似交易。關閉後只會隱藏，不會刪除任何資料。"
          }
        }
      }
    },
