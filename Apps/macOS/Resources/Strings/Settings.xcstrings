        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tipo se escribe solo para una divisa propia — los demás los da el banco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cours ne se saisit que pour une devise personnelle — la banque fournit les autres"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխարժեք մուտքագրվում է միայն սեփական արժույթի համար․ մյուսներինը տրամադրում է բանկը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi inserire un tasso solo per una valuta personale. Gli altri sono forniti dalla banca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レートを入力できるのは独自通貨のみです。それ以外は銀行から取得します"
