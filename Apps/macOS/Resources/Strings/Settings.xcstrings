    "references.delete.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona heç nə istinad etmir: nə əməliyyatlar, o cümlədən səbətdəkilər, nə planlar, nə də borclar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На яго нішто не спасылаецца: ні аперацыі, у тым ліку ў кошыку, ні планы, ні даўгі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznam nepoužívá žádná operace, a to ani v koši, ani žádný plán nebo dluh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist darauf: kein Vorgang, auch die im Papierkorb nicht, kein Plan, keine Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it: no operation, the ones in the bin included, no plan, no debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada hace referencia a él: ninguna operación, tampoco las de la papelera, ningún plan ni deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'y réfère : aucune opération, celles de la corbeille comprises, aucun plan, aucune dette."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն չի օգտագործվում որևէ գործարքում, այդ թվում՝ աղբարկղում գտնվող, պլանում կամ պարտքում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è usato da alcuna operazione, nemmeno nel cestino, né da piani o debiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引（ゴミ箱内を含む）、予定、債務では使用されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მასზე არ არის მითითება არცერთ ოპერაციაში, მათ შორის ურნაში, არც გეგმასა თუ ვალში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған ештеңе сілтеме жасамайды: себеттегілерді қоса алғанда, операция да, жоспар да, қарыз да жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Буга эч нерсе шилтеме кылбайт: операциялар, анын ичинде таштандыдагылары да, пландар же карыздар жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt nergens naar verwezen: niet in transacties, ook niet in de prullenmand, en niet in plannen of schulden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie jest używana w żadnej operacji, również w koszu, ani w żadnym planie lub długu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está em uso por nenhuma operação, inclusive na lixeira, plano ou dívida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é usado por nenhuma operação, incluindo as que estão no lixo, plano ou dívida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На это ничто не ссылается: ни операции, в том числе в корзине, ни планы, ни долги."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба он ҳеҷ чиз истинод надорад: на амалиёт, аз ҷумла дар сабад, на нақша ва на қарз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıt hiçbir işlemde (çöp kutusundakiler dahil), planda veya borçta kullanılmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо не посилається на цей запис: ні операції, зокрема в кошику, ні плани, ні борги."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Undan hech qayerda foydalanilmaydi: na operatsiyalarda, jumladan savatdagilarda, na reja yoki qarzlarda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有交易（包括废纸篓中的交易）、计划或债务使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何項目使用此記錄：包括垃圾桶內的所有交易、計畫和債務。"
          }
        }
      }
    },
