          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например, УСН 6 % без взносов или НДФЛ 13 %: налог ≈ откладывается, без вычета и без переноса малых сумм."
          }
        },
        "uk": {
          "stringUnit": {
