    "currencies.missing.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing from its daily rates: %@. An operation in such a currency takes a rate typed by hand. The list is in Settings → Currencies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan en sus tipos diarios: %@. Un movimiento en esa divisa toma un tipo escrito a mano. La lista está en Ajustes → Divisas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absente de ses cours quotidiens : %@. Une opération dans une telle devise prend un cours saisi à la main. La liste est dans Réglages → Devises."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет в ежедневных курсах ЦБ: %@. Для операции в такой валюте курс вводится вручную. Список — в Настройках, вкладка «Валюты»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У щоденних курсах немає: %@. Для операції в такій валюті курс вводиться вручну. Список — у «Налаштування → Валюти»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күнделікті бағамдарында жоқ: %@. Мұндай валютадағы операцияға қолмен теріліген бағам керек. Тізім — Параметрлер → Валюталарда."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlt in den Tageskursen: %@. Ein Vorgang in einer solchen Währung braucht einen von Hand eingetragenen Kurs. Die Liste finden Sie unter Einstellungen → Währungen."
          }
        }
      }
    },
