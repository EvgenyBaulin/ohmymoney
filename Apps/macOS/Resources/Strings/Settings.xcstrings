    "settings.categoryHints.noMonths": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayları müqayisə etmək üçün hələ kifayət qədər cavablandırılmış nümunə yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль недастаткова прыкладаў з адказамі для параўнання месяцаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro porovnání měsíců zatím není dost vyhodnocených příkladů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch nicht genug beantwortete Beispiele, um Monate zu vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are not enough answered examples yet to compare months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay suficientes ejemplos respondidos para comparar meses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore assez d'exemples répondus pour comparer les mois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամիսները համեմատելու համար դեռ բավարար պատասխանված օրինակներ չկան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora abbastanza esempi con risposta per confrontare i mesi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月別に比較するには、回答済みの例がまだ足りません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვეების შესადარებლად პასუხგაცემული მაგალითები ჯერ საკმარისი არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айларды салыстыру үшін жауап берілген мысалдар әлі жеткіліксіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айларды салыштыруу үчүн жооп берилген мисалдар азырынча жетишсиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog niet genoeg beoordeelde voorbeelden om maanden te vergelijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze dość ocenionych przykładów, aby porównać miesiące."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há exemplos respondidos suficientes para comparar os meses."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há exemplos respondidos suficientes para comparar meses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока мало проверенных подсказок для сравнения по месяцам."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои муқоисаи моҳҳо ҳанӯз мисолҳои ҷавобдодашуда кофӣ нестанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayları karşılaştırmak için henüz yeterli yanıtlanmış örnek yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки недостатньо прикладів із відповідями для порівняння місяців."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylarni taqqoslash uchun tasdiqlangan misollar hali yetarli emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有反馈的示例不足，无法比较各月数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前已確認的範例不足，無法比較各月份。"
          }
        }
      }
    },
