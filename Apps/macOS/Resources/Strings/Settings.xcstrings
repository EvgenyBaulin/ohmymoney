    "currencies.custom.refusal.bankSymbol": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankın valyutası bu simvolla göstərilir — məbləğ həmin valyutada oxunar"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтым сімвалам абазначаецца валюта банка — сума будзе прачытана як сума ў гэтай валюце"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento symbol používá měna banky — částka by se zobrazovala jako tato měna"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Währung der Bank wird mit diesem Zeichen geschrieben — ein Betrag würde als diese Währung gelesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A currency of the bank is written with this symbol — an amount would read as that currency"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una divisa del banco se escribe con este símbolo — un importe se leería como esa divisa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une devise de la banque s'écrit avec ce symbole — un montant se lirait comme cette devise"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս նշանով գրվում է բանկի արժույթներից մեկը․ գումարը կընթերցվի որպես այդ արժույթ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valuta della banca usa questo simbolo: un importo verrebbe interpretato in quella valuta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記号は銀行の通貨に使われているため、金額がその通貨として扱われます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ სიმბოლოთი ბანკის ვალუტა აღინიშნება — თანხა ამ ვალუტაში გამოჩნდება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк валютасы осы белгімен жазылады — сома сол валюта ретінде оқылар еді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк валютасы ушул белги менен жазылат — сумма ошол валютада көрсөтүлөт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een valuta van de bank gebruikt dit symbool. Een bedrag zou als die valuta worden gelezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tym symbolem zapisywana jest waluta banku — kwota zostałaby odczytana jako ta waluta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma moeda do banco usa este símbolo; um valor seria interpretado como essa moeda"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma moeda do banco usa este símbolo; um montante seria interpretado nessa moeda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этим символом пишется валюта ЦБ — сумма прочиталась бы как она"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Асъори бонк бо ин рамз навишта мешавад — маблағ ҳамчун он асъор хонда мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankanın bir para birimi bu simgeyle yazılıyor; tutar o para biriminde okunur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цим символом позначається валюта банку — сума читатиметься як сума в тій валюті"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank valyutasi shu belgi bilan yoziladi — summa o‘sha valyutada deb tushuniladi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行的一种货币使用此符号，金额会被识别为该货币"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行貨幣使用此符號，金額會被識別為該貨幣"
          }
        }
      }
    },
    "currencies.custom.refusal.code": {
