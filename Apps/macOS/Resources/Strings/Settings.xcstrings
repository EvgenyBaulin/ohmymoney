        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e suas %2$@ não estão em uso. Toque em “Desfazer” para restaurá-las."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e as respetivas %2$@ não estão a ser usadas. Toque em “Desfazer” para as repor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» и %2$@ ничем не заняты. «Отменить» вернёт их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ва %2$@-и он дар ҳеҷ ҷо истифода намешаванд. Барои барқарор кардан “Бекор кардан”-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ve %2$@ kullanılmıyor. “Geri Al” ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» та її %2$@ ніде не використовуються. «Скасувати дію» повертає їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» va uning %2$@ hech qayerda ishlatilmayapti. Ularni “Bekor qilish” bilan tiklash mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»及其%2$@均未被使用。轻点“撤销”可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有項目使用«%1$@»及其%2$@。點一下「復原」可還原。"
          }
        }
      }
    },
