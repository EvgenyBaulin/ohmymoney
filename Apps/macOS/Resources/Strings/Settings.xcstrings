    "backups.freeUp.nothing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nothing to delete: the copies that may go are already gone. Copies made before an update stay; you can remove the old ones with «Delete older than a year»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que eliminar: las copias que podían irse ya no están. Las copias hechas antes de una actualización se quedan; puede quitar las antiguas con «Eliminar las de más de un año»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалять нечего: копии, которые можно убрать, уже убраны. Копии «перед обновлением» остаются; старые можно убрать кнопкой «Удалить старше года»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає що видаляти: усі придатні для видалення копії вже прибрано. Копії перед оновленнями залишаються; старі можна видалити через «Видалити старше року»."
          }
        }
      }
    },
    "backups.freeUp.stillLow": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even then less than 1 GB will be free, and there is nothing more to delete here. Copies made before an update stay; you can remove the old ones with «Delete older than a year»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aun así quedará menos de 1 GB libre, y aquí no hay nada más que eliminar. Las copias hechas antes de una actualización se quedan; puede quitar las antiguas con «Eliminar las de más de un año»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже после этого свободно останется меньше 1 ГБ, а удалять здесь больше нечего. Копии «перед обновлением» остаются; старые можно убрать кнопкой «Удалить старше года»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіть після цього залишиться менше 1 GB, а тут більше нічого видаляти. Копії перед оновленнями залишаються; старі можна видалити через «Видалити старше року»."
          }
        }
      }
    },
