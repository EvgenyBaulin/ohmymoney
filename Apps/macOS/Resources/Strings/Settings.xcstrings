    "integrity.repair.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Спачатку будзе створана копія «перад выпраўленнем». Затым за адзін крок будуць выдалены %lld радкі, якія не змяшчаюць вашых даных. Усё астатняе застанецца без змен і трапіць у справаздачу."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Спачатку будзе створана копія «перад выпраўленнем». Затым за адзін крок будзе выдалена %lld радкоў, якія не змяшчаюць вашых даных. Усё астатняе застанецца без змен і трапіць у справаздачу."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Спачатку будзе створана копія «перад выпраўленнем». Затым за адзін крок будзе выдалены %lld радок, які не змяшчае вашых даных. Усё астатняе застанецца без змен і трапіць у справаздачу."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Спачатку будзе створана копія «перад выпраўленнем». Затым за адзін крок будзе выдалена %lld радка, які не змяшчае вашых даных. Усё астатняе застанецца без змен і трапіць у справаздачу."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zuerst wird eine Kopie „vor der Reparatur“ angelegt. Dann wird %lld Zeile entfernt, die nichts von Ihnen enthält, in einem Schritt. Alles andere bleibt, wie es ist, und geht in den Bericht."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zuerst wird eine Kopie „vor der Reparatur“ angelegt. Dann werden %lld Zeilen entfernt, die nichts von Ihnen enthalten, in einem Schritt. Alles andere bleibt, wie es ist, und geht in den Bericht."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "First a copy «before repair» is made. Then %lld row that holds nothing of yours is removed, in one step. Everything else is left as it is and goes to the report."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "First a copy «before repair» is made. Then %lld rows that hold nothing of yours are removed, in one step. Everything else is left as it is and goes to the report."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
