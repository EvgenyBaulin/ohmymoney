      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас"
          }
        },
        "uk": {
