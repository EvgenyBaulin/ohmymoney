    "settings.forWhom.peopleHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A person can be set on any operation instead of one of the five, and «For whom» in Analytics counts them separately. Relations, other names and merging are in Reference books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona se puede poner en cualquier operación en lugar de una de las cinco, y «Para quién» en la Analítica las cuenta por separado. Las relaciones, otros nombres y la fusión están en Libros de referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne peut être choisie sur n'importe quelle opération à la place de l'une des cinq, et « Pour qui » dans l'Analyse les compte à part. Les liens, les autres noms et les fusions se trouvent dans les Références."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человека можно указать у любой операции вместо одного из пяти значений, и в «На кого» аналитики он считается отдельно. Отношение, другие названия и слияние — в «Справочниках»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На будь-якій операції можна вказати людину замість одного з п'яти варіантів, і «Для кого» в аналітиці врахує її окремо. Зв'язки, інші імена та об'єднання — у довідниках."
          }
        }
      }
    },
