    "settings.entry.styleHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line reads «coffee 250» and suggests the category, the place and the account from what you entered before; ↓ walks the list, Tab opens the panel. The form stands at the right of the window all the time: the same fields, no line and no suggestions — you choose the category, the people and the account yourself; Return saves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка понимает «кофе 250» и подсказывает категорию, место и счёт по тому, что вы вводили раньше; ↓ листает список, Tab открывает панель. Форма стоит справа всегда: те же поля, но без строки и без подсказок — категорию, людей и счёт выбираете вы сами; Return сохраняет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок читає «кава 250» і пропонує категорію, місце та рахунок за попередніми записами; ↓ переходить списком, Tab відкриває панель. Форма постійно праворуч: ті самі поля без рядка й підказок — категорію, людей і рахунок вибираєте самі; Return зберігає."
          }
        }
      }
    },
