    "archive.import.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive cannot be loaded while the database is not open. Restore a copy in Settings → Backups first, then open the archive again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no se puede cargar mientras la base de datos no está abierta. Restaure antes una copia en Ajustes → Copias de seguridad y vuelva a abrir el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archive ne peut pas être chargée tant que la base n'est pas ouverte. Restaurez d'abord une copie dans Réglages → Sauvegardes, puis ouvrez de nouveau l'archive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока база не открыта, архив не загрузить. Сначала восстановите копию: Настройки → Бэкапы, — затем откройте архив снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна завантажити архів, поки базу даних не відкрито. Спочатку відновіть копію в «Налаштування → Резервні копії», потім відкрийте архів знову."
          }
        }
      }
    },
