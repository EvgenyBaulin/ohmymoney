    "settings.entry.plusOpensHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entry line is hidden behind the round «+» in the bottom right corner. «+» or ⌘N opens what is chosen: the line at the bottom with the keyboard, or the form at the right. In a narrow window the form folds into the button."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка ввода спрятана за круглой «+» в правом нижнем углу. «+» или ⌘N открывает выбранное: строку снизу с клавиатурой или форму справа. В узком окне форма сворачивается в кнопку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок вводу приховано за круглою кнопкою «+» у правому нижньому куті. «+» або ⌘N відкриває вибране: рядок знизу з клавіатурою або форму праворуч. У вузькому вікні форма згортається в кнопку."
          }
        }
      }
    },
