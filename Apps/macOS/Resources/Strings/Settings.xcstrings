    "archive.import.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive cannot be loaded while the database is not open. Restore a copy in Settings → Backups first, then open the archive again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока база не открыта, архив не загрузить. Сначала восстановите копию: Настройки → Бэкапы, — затем откройте архив снова."
          }
        }
      }
    },
    "archive.import.working": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the archive and checking it…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив открывается и проверяется…"
          }
        }
      }
    },
    "archive.noPassword.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything inside — names of people, places and every amount — will lie in the open. Anyone who gets the file can read it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё внутри — имена людей, места и все суммы — будет лежать в открытом виде. Любой, у кого окажется файл, это прочитает."
          }
        }
      }
    },
    "archive.noPassword.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write the archive without a password?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать архив без пароля?"
          }
        }
      }
    },
