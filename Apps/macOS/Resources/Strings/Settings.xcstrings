    "categories.limit.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly limit: an empty field removes the limit, zero is not accepted. ↻ — what is left carries over; a new amount starts the carry again this month. Each change is undone with ⌘Z."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит в месяц: пустое поле убирает лимит, ноль не ставится. ↻ — остаток переносится; новая сумма начинает перенос заново с этого месяца. Каждое изменение отменяется ⌘Z."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місячний ліміт: порожнє поле прибирає ліміт, нуль не приймається. ↻ — залишок переходить далі; нова сума починає перенесення заново цього місяця. Кожну зміну можна скасувати через ⌘Z."
          }
        }
      }
    },
    "categories.limit.hint.touch": {
