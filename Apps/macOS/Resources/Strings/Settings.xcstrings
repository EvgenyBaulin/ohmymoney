    "categories.tax.otherHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example the simplified 6% without contributions or income tax of 13%: the tax ≈ is put aside, without the deduction and without moving small sums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo el 6 % simplificado sin aportaciones o el impuesto sobre la renta del 13 %: el impuesto ≈ se aparta, sin deducción y sin mover sumas pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple le 6 % simplifié sans cotisations, ou l'impôt sur le revenu de 13 % : l'impôt ≈ est mis de côté, sans déduction et sans transférer les petites sommes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например, УСН 6 % без взносов или НДФЛ 13 %: налог ≈ откладывается, без вычета и без переноса малых сумм."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наприклад, спрощена система 6% без внесків або податок на доходи 13%: податок ≈ відкладається без відрахування та перенесення малих сум."
          }
        }
      }
    },
