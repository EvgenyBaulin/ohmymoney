    "settings.language.restart": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İndi yenidən başladın"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перазапусціць зараз"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Restartovat nyní"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt neu starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrer maintenant"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերագործարկել հիմա"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia ora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ再起動"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახლავე გადატვირთვა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір қайта іске қосу"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азыр кайра иштетүү"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstart nu"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar agora"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar agora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустить"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳозир аз нав оғоз кардан"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Yeniden Başlat"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустити зараз"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozir qayta ishga tushirish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重新启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重新啟動"
          }
        }
      }
    },
    "settings.language.restartHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəzi sistem menyuları yenidən başladıqdan sonra dəyişir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Некаторыя сістэмныя меню зменяцца пасля перазапуску."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé systémové nabídky se změní až po restartu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Systemmenüs ändern sich erst nach einem Neustart."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some system menus change after a restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos menús del sistema cambian tras reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains menus du système changent après un redémarrage."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համակարգի որոշ ընտրացանկերի լեզուն փոխվում է վերագործարկումից հետո։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni menu di sistema cambiano dopo il riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のシステムメニューは再起動後に変更されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზოგი სისტემური მენიუ გადატვირთვის შემდეგ შეიცვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбір жүйелік мәзірлер қайта іске қосқаннан кейін өзгереді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айрым тутумдук менюлар кайра иштетилгенден кийин өзгөрөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige systeemmenu’s veranderen na een herstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre menu systemowe zmienią się po ponownym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns menus do sistema são alterados após reiniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns menus do sistema mudam após reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые системные меню сменят язык после перезапуска."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баъзе менюҳои система пас аз оғози дубора тағйир меёбанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı sistem menüleri yeniden başlatıldıktan sonra değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі системні меню зміняться після перезапуску."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrim tizim menyulari qayta ishga tushirgandan so‘ng o‘zgaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分系统菜单会在重新启动后更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分系統選單會在重新啟動後變更。"
          }
        }
      }
    },
