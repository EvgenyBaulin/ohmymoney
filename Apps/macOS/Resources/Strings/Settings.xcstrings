    "settings.anomalies.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокая адчувальнасць знаходзіць больш анамалій і часцей пытаецца; нізкая паведамляе толькі пра відавочныя адхіленні."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine höhere Empfindlichkeit findet mehr und fragt öfter; eine niedrigere sagt nur, was eindeutig nicht passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher sensitivity finds more and asks more often; a lower one only says what is plainly out of place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sensibilidad mayor encuentra más y pregunta con más frecuencia; una menor solo señala lo que está claramente fuera de lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sensibilité plus élevée en trouve davantage et demande plus souvent ; une plus basse ne signale que ce qui est manifestement hors norme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sensibilità più alta rileva più anomalie e chiede conferma più spesso; una più bassa segnala solo quelle evidenti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоғары сезімталдық көбірек ауытқу тауып, жиірек сұрайды; төмені тек айқын ауытқуларды көрсетеді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше чувствительность, тем больше находок и вопросов; низкая говорит только о явно выбивающемся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вища чутливість знаходить більше й запитує частіше; нижча повідомляє лише про явно незвичне."
          }
        }
      }
    },
