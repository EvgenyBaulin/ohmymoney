    "settings.appearance.textHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text size changes in every window at once. The currency is how amounts name it on the screens, charts and cards; files and the fields where an amount is typed stay as they are. «Name» writes short Russian names only in Russian; in English it shows the code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер шрифта меняется сразу во всех окнах. Валюта — как суммы называют её на экранах, графиках и карточках; файлы и поля, где набирают сумму, не меняются. «Название» пишет сокращения (руб., долл.) только по-русски, по-английски — код."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір тексту змінюється одразу в усіх вікнах. Вигляд валюти визначає її підпис біля сум на екранах, графіках і картках; файли й поля вводу сум не змінюються. «Назва» показує короткі російські назви лише російською; англійською показує код."
          }
        }
      }
    },
    "settings.backups.beforeMigrationMirrored": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies made before updates are here too, in the «before-migration» folder. Copy rotation never deletes them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии «до обновления» лежат и здесь — в папке «before-migration». Ротация копий их не удаляет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії перед оновленнями також тут, у папці «before-migration». Автоматичне очищення їх ніколи не видаляє."
          }
        }
      }
    },
