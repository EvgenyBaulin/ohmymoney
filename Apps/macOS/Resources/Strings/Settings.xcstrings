    "settings.planning.includesGoalsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, «can spend» leaves out the money already put into goals. Turn it off when goal money is kept on an account outside the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado, «se puede gastar» no incluye el dinero ya aportado a objetivos. Desactívelo cuando el dinero de los objetivos se guarde en una cuenta fuera del resumen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, «можно тратить» не считает деньги, уже отложенные на цели. Выключите, если деньги целей лежат на счёте вне сводки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ввімкнено, «Можна витрачати» не враховує вже відкладені на цілі гроші. Вимкніть, якщо гроші цілей зберігаються на рахунку поза підсумком."
          }
        }
      }
    },
    "settings.planning.limits": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límites"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимиты"
          }
        },
        "uk": {
