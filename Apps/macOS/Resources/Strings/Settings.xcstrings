    "archive.import.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq yalnız oxuma rejimindədir: idxal mümkün deyil. Əvvəlcə bu rejimdən çıxın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма працуе ў рэжыме толькі для чытання: імпарт немагчымы. Спачатку выйдзіце з гэтага рэжыму."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace je v režimu pouze pro čtení, import není možný. Nejprve tento režim opusťte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist nur lesbar: Ein Import ist nicht möglich. Verlassen Sie zuerst den Modus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is read-only: an import is not possible. Leave the mode first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app está en solo lectura: no es posible importar. Salga antes del modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app est en lecture seule : l'import n'est pas possible. Quittez d'abord ce mode."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածը միայն ընթերցման ռեժիմում է․ ներմուծումը հնարավոր չէ։ Նախ դուրս եկեք այդ ռեժիմից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app è in sola lettura: impossibile importare. Esci prima da questa modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは読み出し専用のため、読み込めません。先にこのモードを終了してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპი მხოლოდ წაკითხვის რეჟიმშია: იმპორტი შეუძლებელია. ჯერ გამოდით ამ რეჟიმიდან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба тек оқу режимінде: импорттау мүмкін емес. Алдымен режимнен шығыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмо окуу гана режиминде: импорттоо мүмкүн эмес. Адегенде бул режимден чыгыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app is alleen-lezen: importeren is niet mogelijk. Verlaat eerst deze modus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja działa w trybie tylko do odczytu. Aby importować dane, najpierw wyłącz ten tryb."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app está no modo somente leitura. Saia desse modo para importar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação está em modo de leitura: não é possível importar. Saia primeiro deste modo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим «Только просмотр»: импорт недоступен. Сначала выйдите из режима."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома дар реҷаи танҳо хондан аст: воридот имкон надорад. Аввал аз ин реҷа бароед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama salt okunur modda: içe aktarma yapılamaz. Önce bu moddan çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок у режимі лише перегляду: імпорт неможливий. Спочатку вийдіть із режиму."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova faqat o‘qish rejimida: import qilib bo‘lmaydi. Avval bu rejimdan chiqing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 处于只读模式，无法导入。请先退出该模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 目前為唯讀模式，無法輸入。請先離開此模式。"
          }
        }
      }
    },
