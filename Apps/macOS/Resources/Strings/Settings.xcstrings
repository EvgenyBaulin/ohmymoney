        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O código deve ter três letras latinas maiúsculas, como UST"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код — три латинские заглавные буквы, например UST"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рамз аз се ҳарфи калони лотинӣ иборат аст, масалан UST"
