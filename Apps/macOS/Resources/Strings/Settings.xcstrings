    "backups.afterImport.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data came from an archive, and folders chosen on another Mac do not travel with it. Choose where copies of the backups go — for example, a folder in iCloud Drive. Until then the copies stay on this Mac only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos llegaron desde un archivo, y las carpetas elegidas en otro Mac no viajan con ellos. Elija dónde se guardan las copias de seguridad — por ejemplo, una carpeta en iCloud Drive. Hasta entonces las copias se quedan solo en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données viennent d'une archive, et les dossiers choisis sur un autre Mac ne voyagent pas avec elle. Choisissez où vont les copies des sauvegardes — par exemple, un dossier dans iCloud Drive. Jusque-là, les copies restent sur ce Mac seulement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные загружены из архива, а папки, выбранные на другом Mac, с ним не переносятся. Выберите, куда класть копии бэкапов, — например, папку в iCloud Drive. Пока она не выбрана, копии остаются только на этом Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані надійшли з архіву, а папки, вибрані на іншому Mac, не переносяться. Виберіть місце для резервних копій — наприклад, папку в iCloud Drive. Доти копії залишатимуться лише на цьому Mac."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер мұрағаттан келді, ал басқа Mac-та таңдалған қалталар онымен бірге көшпейді. Көшірмелердің қайда барғанын таңдаңыз — мысалы, iCloud Drive-дағы қалта. Осыған дейін көшірмелер тек осы Mac-та қалады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten stammen aus einem Archiv, und Ordner, die auf einem anderen Mac gewählt wurden, kommen damit nicht mit. Wählen Sie, wohin die Kopien der Sicherungen gehen — zum Beispiel einen Ordner im iCloud Drive. Bis dahin bleiben die Kopien nur auf diesem Mac."
          }
        }
      }
    },
