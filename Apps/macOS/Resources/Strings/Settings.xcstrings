    "integrity.finding.attachmentWithoutOwner": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyatı, aktivi, borcu və ya abunəliyi olmayan əlavələr"
