    "references.archiveHint.events": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivlənmiş hadisə əməliyyat daxil edərkən və siyahılarda təklif edilmir; əməliyyatlarda, Analitikada və Hesabatlarda qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Архіўная падзея больш не прапануецца пры ўводзе аперацый і не паказваецца ў спісах. Яе аперацыі, аналітыка і справаздачы захоўваюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivovaná událost se už nenabízí při zadávání operací ani v seznamech; zůstane u svých operací, v analýzách a přehledech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein archiviertes Ereignis wird beim Eingeben von Vorgängen und in Listen nicht mehr angeboten; seine Vorgänge, die Auswertung und die Berichte behalten es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived event is no longer offered when you enter operations or in lists; its operations, Analytics and Reports keep it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento archivado ya no se ofrece al introducir operaciones ni en las listas; sus operaciones, la Analítica y los Informes lo siguen conservando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un événement archivé n'est plus proposé à la saisie des opérations ni dans les listes ; ses opérations, l'Analyse et les Rapports le gardent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվացված իրադարձությունն այլևս չի առաջարկվում գործարքներ մուտքագրելիս կամ ցուցակներում, բայց պահպանվում է իր գործարքներում, վերլուծությունում և հաշվետվություններում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento archiviato non viene più proposto durante l’inserimento delle operazioni o negli elenchi; resta nelle sue operazioni, in Analisi e nei resoconti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブしたイベントは、取引の入力時や一覧に表示されなくなります。取引、分析、レポートには残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივში გადატანილი მოვლენა აღარ გამოჩნდება ოპერაციის შეყვანისას ან სიებში; ის შენარჩუნდება ოპერაციებში, ანალიტიკასა და ანგარიშებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағатталған оқиға операция енгізгенде және тізімдерде ұсынылмайды; оның операцияларында, Талдауда және Есептерде сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивделген окуя операцияларды киргизүүдө жана тизмелерде сунушталбайт. Ал операцияларда, аналитикада жана отчеттордо сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gearchiveerde gebeurtenis wordt niet meer aangeboden bij het invoeren van transacties of in lijsten. De gebeurtenis blijft behouden in transacties, analyses en rapporten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowane wydarzenie nie jest już proponowane przy wprowadzaniu operacji ani na listach. Pozostaje w swoich operacjach, analizach i raportach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um evento arquivado deixa de aparecer ao registrar operações e nas listas; ele permanece nas operações, Análises e Relatórios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um evento arquivado deixa de aparecer ao introduzir operações e nas listas, mas mantém-se nas operações, análises e relatórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Событие в архиве не предлагается при вводе и в списках, а его операции, «Аналитика» и «Отчёты» его сохраняют."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рӯйдоди бойгонӣ ҳангоми ворид кардани амалиёт ва дар рӯйхатҳо пешниҳод намешавад; амалиёт, Таҳлил ва Ҳисобот онро нигоҳ медоранд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenen etkinlik, işlem girerken ve listelerde artık gösterilmez; işlemleri, analizlerde ve raporlarda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Архівна подія більше не пропонується під час вводу та в списках; її операції, аналітика й звіти зберігають її."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivlangan hodisa operatsiya kiritishda va ro‘yxatlarda taklif etilmaydi. U operatsiyalar, tahlil va hisobotlarda saqlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档的事件不会再出现在记账选项或列表中；其交易、分析和报告会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存的事件不會再出現在記錄交易時的選項或列表中；相關交易、分析和報表會保留該事件。"
          }
        }
      }
    },
    "references.archiveHint.people": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivlənmiş şəxs əməliyyat daxil edərkən və siyahılarda təklif edilmir; əməliyyatlarda, Analitikada və Hesabatlarda qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Архіўная асоба больш не прапануецца пры ўводзе аперацый і не паказваецца ў спісах. Яе аперацыі, аналітыка і справаздачы захоўваюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivovaná osoba se už nenabízí při zadávání operací ani v seznamech; zůstane u svých operací, v analýzách a přehledech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine archivierte Person wird beim Eingeben von Vorgängen und in Listen nicht mehr angeboten; ihre Vorgänge, die Auswertung und die Berichte behalten sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived person is no longer offered when you enter operations or in lists; their operations, Analytics and Reports keep them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona archivada ya no se ofrece al introducir operaciones ni en las listas; sus operaciones, la Analítica y los Informes la siguen conservando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne archivée n'est plus proposée à la saisie des opérations ni dans les listes ; leurs opérations, l'Analyse et les Rapports les gardent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվացված անձն այլևս չի առաջարկվում գործարքներ մուտքագրելիս կամ ցուցակներում, բայց պահպանվում է իր գործարքներում, վերլուծությունում և հաշվետվություններում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona archiviata non viene più proposta durante l’inserimento delle operazioni o negli elenchi; resta nelle sue operazioni, in Analisi e nei resoconti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブした人は、取引の入力時や一覧に表示されなくなります。取引、分析、レポートには残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივში გადატანილი პირი აღარ გამოჩნდება ოპერაციის შეყვანისას ან სიებში; ის შენარჩუნდება ოპერაციებში, ანალიტიკასა და ანგარიშებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағатталған адам операция енгізгенде және тізімдерде ұсынылмайды; оның операцияларында, Талдауда және Есептерде сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивделген адам операцияларды киргизүүдө жана тизмелерде сунушталбайт. Ал операцияларда, аналитикада жана отчеттордо сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gearchiveerde persoon wordt niet meer aangeboden bij het invoeren van transacties of in lijsten. De persoon blijft behouden in transacties, analyses en rapporten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowana osoba nie jest już proponowana przy wprowadzaniu operacji ani na listach. Pozostaje w swoich operacjach, analizach i raportach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa arquivada deixa de aparecer ao registrar operações e nas listas; ela permanece nas operações, Análises e Relatórios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa arquivada deixa de aparecer ao introduzir operações e nas listas, mas mantém-se nas operações, análises e relatórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человек в архиве не предлагается при вводе и в списках, а его операции, «Аналитика» и «Отчёты» его сохраняют."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шахси бойгонӣ ҳангоми ворид кардани амалиёт ва дар рӯйхатҳо пешниҳод намешавад; амалиёт, Таҳлил ва Ҳисобот ӯро нигоҳ медоранд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenen kişi, işlem girerken ve listelerde artık gösterilmez; işlemleri, analizlerde ve raporlarda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Архівна людина більше не пропонується під час вводу та в списках; її операції, аналітика й звіти зберігають її."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivlangan shaxs operatsiya kiritishda va ro‘yxatlarda taklif etilmaydi. U operatsiyalar, tahlil va hisobotlarda saqlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档的人员不会再出现在记账选项或列表中；其交易、分析和报告会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存的人員不會再出現在記錄交易時的選項或列表中；相關交易、分析和報表會保留該人員。"
          }
        }
      }
    },
