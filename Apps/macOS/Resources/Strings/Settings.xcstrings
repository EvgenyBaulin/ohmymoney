    "categories.delete.used": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ under «%1$@». Choose a new home for what is filed there: it moves first, the category goes after. Two steps of ⌘Z."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ bajo «%1$@». Elija un nuevo destino para lo que hay archivado allí: primero se mueve, después la categoría. Dos pasos de ⌘Z."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ dans « %1$@ ». Choisissez un nouveau lieu pour ce qui y est classé : cela se déplace d'abord, la catégorie part ensuite. Deux étapes de ⌘Z."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%1$@» %2$@. Выберите, куда перенести содержимое: оно переедет первым, категория уйдёт следом. Два шага ⌘Z."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%1$@» — %2$@. Виберіть нову категорію для записів: спочатку вони перенесуться, потім категорія видалиться. Два кроки ⌘Z."
          }
        }
      }
    },
