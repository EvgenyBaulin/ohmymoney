    "references.merge.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» əməliyyatları «%2$@» qeydinə köçürülür, adı «%2$@» üçün digər ad olur və «%1$@» arxivə göndərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі «%1$@» будуць перанесены ў «%2$@», яго назва стане іншай назвай «%2$@», а «%1$@» будзе перанесены ў архіў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace z «%1$@» se přesunou do «%2$@», název se stane dalším názvem pro «%2$@» a «%1$@» se archivuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorgänge von „%1$@“ wandern zu „%2$@“, sein Name wird ein weiterer Name von „%2$@“, und „%1$@“ kommt ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations of «%1$@» move to «%2$@», its name becomes another name of «%2$@», and «%1$@» goes to the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de «%1$@» pasan a «%2$@», su nombre pasa a ser otro nombre de «%2$@», y «%1$@» va al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations de « %1$@ » passent sur « %2$@ », son nom devient un autre nom de « %2$@ », et « %1$@ » part aux archives."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»-ի գործարքները կանցնեն «%2$@»-ին, դրա անունը կդառնա «%2$@»-ի այլ անունը, իսկ «%1$@»-ը կարխիվացվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni di «%1$@» passano a «%2$@», il suo nome diventa un altro nome di «%2$@» e «%1$@» viene archiviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»の取引は«%2$@»に移され、その名前は«%2$@»の別名になります。«%1$@»はアーカイブされます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»-ის ოპერაციები გადავა «%2$@»-ში, მისი სახელი გახდება «%2$@»-ის სხვა სახელი, ხოლო «%1$@» გადავა არქივში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» операциялары «%2$@» ішіне көшеді, атауы «%2$@» үшін басқа атау болады, ал «%1$@» мұрағатқа өтеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» операциялары «%2$@» жазуусуна өтөт, анын аты «%2$@» жазуусунун башка аты болуп калат, ал эми «%1$@» архивделет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transacties van «%1$@» gaan naar «%2$@», de naam wordt een andere naam van «%2$@» en «%1$@» gaat naar het archief."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações de «%1$@» passam para «%2$@», seu nome se torna outro nome de «%2$@» e «%1$@» é arquivado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações de «%1$@» passam para «%2$@», o seu nome torna-se outro nome de «%2$@» e «%1$@» é arquivado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции «%1$@» перейдут к «%2$@», его название станет другим названием «%2$@», а сам «%1$@» уйдёт в архив."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёти «%1$@» ба «%2$@» мегузарад, номи он номи дигари «%2$@» мешавад ва «%1$@» ба бойгонӣ меравад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» işlemleri «%2$@» kaydına taşınır, adı «%2$@» için başka bir ad olur ve «%1$@» arşivlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції «%1$@» перейдуть до «%2$@», його назва стане іншою назвою «%2$@», а «%1$@» потрапить в архів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» operatsiyalari «%2$@»ga o‘tadi, uning nomi «%2$@»ning boshqa nomiga aylanadi va «%1$@» arxivlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»的交易将移至«%2$@》，其名称将成为«%2$@»的其他名称，«%1$@»将被归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» 的交易會移至 «%2$@»，其名稱會成為 «%2$@» 的其他名稱，而 «%1$@» 會移至封存。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje z «%1$@» zostaną przeniesione do «%2$@», nazwa stanie się inną nazwą «%2$@», a «%1$@» trafi do archiwum."
          }
        }
      }
    },
