    "settings.selfEmployed.taxAccountHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gəlir bölüşdürülərkən vergi bu hesaba köçürülür"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры размеркаванні даходу падатак пераносіцца на гэты рахунак"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při rozdělení příjmu se daň přesune na tento účet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verteilung einer Einnahme verschiebt die Steuer auf dieses Konto"
