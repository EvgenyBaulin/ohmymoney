    "categories.delete.used.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%1$@»: %2$@. Выберыце новую катэгорыю для аперацый: спачатку яны будуць перамешчаны, потым катэгорыя будзе выдалена. Для адмены націсніце “Адмяніць” двойчы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ unter „%1$@“. Wählen Sie ein neues Zuhause für das, was dort eingeordnet ist: Es wandert zuerst, die Kategorie danach. Zwei Schritte von „Rückgängig“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ under «%1$@». Choose a new home for what is filed there: it moves first, the category goes after. Two steps of “Undo”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ bajo «%1$@». Elija un nuevo destino para lo que hay archivado allí: primero se mueve, después la categoría. Dos pasos de «Deshacer»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ dans « %1$@ ». Choisissez un nouveau lieu pour ce qui y est classé : cela se déplace d'abord, la catégorie part ensuite. Deux étapes de « Annuler »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ in «%1$@». Scegli una nuova categoria per le operazioni: verranno spostate prima di eliminare la categoria. Tocca “Annulla” due volte per annullare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ «%1$@» астында. Онда тіркелгендер үшін жаңа орын таңдаңыз: алдымен көшеді, санат кейін жойылады. «Болдырмау» екі рет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ w kategorii «%1$@». Wybierz nową kategorię dla tych operacji. Najpierw zostaną przeniesione, a potem kategoria zostanie usunięta. Aby to cofnąć, wybierz „Cofnij” dwa razy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ em «%1$@». Escolha para onde movê-las. As operações serão movidas primeiro e a categoria será apagada em seguida. Toque em “Desfazer” duas vezes para reverter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%1$@» %2$@. Выберите, куда перенести содержимое: оно переедет первым, категория уйдёт следом. Два нажатия «Отменить»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» altında %2$@ var. İşlemler için yeni bir kategori seçin. Önce işlemler taşınır, ardından kategori silinir. Geri almak için “Geri Al”a iki kez dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%1$@» — %2$@. Виберіть нову категорію для записів: спочатку вони перенесуться, потім категорія видалиться. Два кроки «Скасувати дію»."
          }
        }
      }
    },
    "categories.delete.withChildren": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» і яе %2$@ нідзе не выкарыстоўваюцца. ⌘Z верне іх назад."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und ihre %2$@ werden von nichts genutzt. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» and its %2$@ are used by nothing. ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» y sus %2$@ no los usa nada. ⌘Z los devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et ses %2$@ ne sont utilisées par rien. ⌘Z les rétablit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e le sue %2$@ non sono usate. Premi ⌘Z per ripristinarle."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» және оның %2$@ ешкім қолданбайды. ⌘Z оларды қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria «%1$@» i jej podkategorie (%2$@) nie są używane. Naciśnij ⌘Z, aby je przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e suas %2$@ não estão em uso. Pressione ⌘Z para restaurá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» и %2$@ ничем не заняты. ⌘Z вернёт их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ve %2$@ kullanılmıyor. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» та її %2$@ ніде не використовуються. ⌘Z повертає їх."
          }
        }
      }
    },
