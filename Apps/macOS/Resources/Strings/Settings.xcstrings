    },
    "categories.cashbackRulesHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much cashback to expect is set by the rules of the accounts: on the account screen or in Settings → Accounts → “Cashback…”. A payment on a debt earns none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto cashback esperar lo fijan las reglas de las cuentas: en la pantalla de la cuenta o en Ajustes → Cuentas → «Cashback…». Un pago de deuda no genera ninguno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько кэшбэка ждать, задают правила счетов: экран счёта или «Настройки → Счета» → «Кэшбэк…». За платёж по долгу кэшбэк не платят."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний кешбек визначають правила рахунків: на екрані рахунку або в «Налаштування → Рахунки → Кешбек…». Платіж за боргом кешбеку не дає."
          }
        }
      }
    },
