    "settings.selfEmployed.deductionLeft.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See «Мой налог»: the deduction of 10,000 ₽ is given once and lowers the rate 4% → 3% and 6% → 4% until it runs out. While the field is empty the tax is counted without it — a little more is put aside."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите в «Мой налог»: вычет 10,000 ₽ даётся один раз и снижает ставку 4 % → 3 % и 6 % → 4 %, пока не кончится. Пока поле пусто, налог считается без вычета — отложится чуть больше."
          }
        }
      }
    },
