          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» колдонулат: %2$@. Анын ордуна категорияны архивге көчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» wordt gebruikt door %2$@. Archiveer de categorie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria «%1$@» jest używana przez: %2$@. Przenieś ją do archiwum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» é usada por %2$@. Arquive a categoria."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está a ser usada por %2$@. Em alternativa, arquive a categoria."
