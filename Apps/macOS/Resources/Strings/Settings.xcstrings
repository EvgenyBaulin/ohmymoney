    "backups.dataSet.noMirror": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumat dəstinin nüsxələri öz qovluğunda saxlanılır və seçilmiş qovluğa göndərilmir. Öz məlumatlarınız üçün seçdiyiniz qovluq dəyişmir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор даных захоўвае копіі ва ўласнай папцы: яны не адпраўляюцца ў выбраную папку, а папка для вашых даных застаецца без змен"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datová sada uchovává kopie ve vlastní složce: neukládají se do vybrané složky a složka vybraná pro vaše vlastní data zůstává beze změny"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Datensatz bewahrt seine Kopien in einem eigenen Ordner auf: Sie gehen in keinen gewählten Ordner, und der Ordner für Ihre eigenen Daten bleibt, wie er ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A data set keeps its copies in its own folder: they go to no chosen folder, and the folder chosen for your own data stays as it is"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conjunto de datos guarda sus copias en su propia carpeta: no van a ninguna carpeta elegida, y la carpeta elegida para sus datos propios se queda como está"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeu de données garde ses copies dans son propre dossier : elles ne vont dans aucun dossier choisi, et le dossier choisi pour vos données reste tel quel"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների հավաքածուի պատճենները պահվում են դրա սեփական պանակում․ դրանք չեն ուղարկվում ընտրված պանակ, իսկ ձեր տվյալների համար ընտրված պանակը մնում է անփոփոխ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un insieme di dati conserva le proprie copie nella sua cartella: non vengono inviate alla cartella scelta e la cartella scelta per i tuoi dati rimane invariata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データセットのコピーは専用のフォルダに保存され、選択したフォルダにはコピーされません。自分のデータ用に選択したフォルダはそのままです"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ნაკრების ასლები მის საკუთარ საქაღალდეში ინახება: ისინი არჩეულ საქაღალდეში არ გადაიგზავნება, ხოლო თქვენი მონაცემებისთვის არჩეული საქაღალდე უცვლელი რჩება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер жиыны көшірмелерін өз қалтасында сақтайды: олар таңдалған қалтаға бармайды, ал өз деректеріңіз үшін таңдалған қалта өз күйінде қалады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайындар топтому көчүрмөлөрүн өз папкасында сактайт: алар тандалган папкага жөнөтүлбөйт, ал эми жеке дайындарыңыз үчүн тандалган папка өзгөрбөйт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gegevensset bewaart kopieën in een eigen map: ze gaan niet naar een gekozen map. De map voor je eigen gegevens blijft ongewijzigd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zestaw danych przechowuje kopie we własnym folderze. Nie są one przesyłane do wybranego folderu, a folder wybrany dla Twoich danych pozostaje bez zmian"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um conjunto de dados mantém suas cópias na própria pasta: elas não vão para a pasta escolhida, e a pasta escolhida para seus dados permanece como está"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um conjunto de dados guarda as suas cópias na própria pasta: não são enviadas para nenhuma pasta escolhida e a pasta escolhida para os seus dados mantém-se inalterada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор данных хранит копии в своей папке: в выбранную папку они не идут, а папка, выбранная для ваших данных, остаётся прежней"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маҷмӯаи додаҳо нусхаҳояшро дар ҷузвдони худ нигоҳ медорад: онҳо ба ҷузвдони интихобшуда фиристода намешаванд ва ҷузвдони барои додаҳои шахсии шумо интихобшуда бетағйир мемонад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir veri kümesi kopyalarını kendi klasöründe tutar: kopyalar seçilen klasöre gönderilmez ve kendi verileriniz için seçtiğiniz klasör değişmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Набір даних зберігає копії у власній папці: вони не потрапляють до вибраної папки, а папка для ваших даних залишається без змін"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar to‘plami nusxalarini o‘z jildida saqlaydi: ular tanlangan jildga yuborilmaydi, shaxsiy ma’lumotlaringiz uchun tanlangan jild esa o‘zgarmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据集的副本保存在其专属文件夹中，不会存入选定的文件夹；为个人数据选定的文件夹保持不变"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料集的副本會儲存在專屬檔案夾中，不會複製到所選檔案夾；為個人資料選擇的檔案夾不受影響"
          }
        }
      }
    },
