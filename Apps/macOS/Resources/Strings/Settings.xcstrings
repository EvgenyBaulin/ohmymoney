    "archive.error.database": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database inside the archive cannot be opened. Nothing was replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir la base de datos dentro del archivo. No se reemplazó nada."
