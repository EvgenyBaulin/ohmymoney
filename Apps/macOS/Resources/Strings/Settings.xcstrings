        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եկամուտը բաշխելիս հարկը փոխանցվում է այս հաշվին"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ripartizione di un’entrata trasferisce l’imposta su questo conto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収入を振り分ける際に、税額をこの口座に移します"
