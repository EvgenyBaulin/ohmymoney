    "settings.allocation.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules only suggest amounts on the sheet of an income — nothing is written there without «Record»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas solo proponen importes en la hoja de un ingreso — allí no se escribe nada sin «Registrar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles ne font que proposer des montants sur la feuille d'un revenu — rien n'y est noté sans « Noter »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила только предлагают суммы в листе распределения дохода — без «Записать» там ничего не пишется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила лише пропонують суми у вікні доходу — нічого не записується без «Записати»."
          }
        }
      }
    },
