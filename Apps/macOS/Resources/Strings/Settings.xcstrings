    "settings.tiles.full": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcmalda ən çox 12 lövhə ola bilər: yenisini əlavə etmək üçün birini söndürün."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У аглядзе можа быць не больш за 12 плітак. Выключыце адну, каб дадаць іншую."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehled pojme nejvýše 12 dlaždic. Chcete-li přidat další, jednu vypněte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersicht fasst höchstens 12 Kacheln: Schalten Sie eine aus, um eine andere hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overview holds at most 12 tiles: switch one off to add another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Resumen admite como máximo 12 mosaicos: desactive uno para añadir otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Aperçu contient au plus 12 tuiles : désactivez-en une pour en ajouter une autre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփումը կարող է պարունակել առավելագույնը 12 սալիկ․ նորը ավելացնելու համար անջատեք դրանցից մեկը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riepilogo contiene fino a 12 riquadri: disattivane uno per aggiungerne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "概要には最大12個のタイルを表示できます。別のタイルを追加するには、いずれかをオフにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიმოხილვაში არაუმეტეს 12 ფილა ეტევა. ახლის დასამატებლად გამორთეთ ერთ-ერთი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шолуда ең көбі 12 плитка болады: жаңасын қосу үшін біреуін өшіріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Серепке эң көп дегенде 12 такта батат. Башкасын кошуу үчүн бирин өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het overzicht bevat maximaal 12 tegels. Schakel een tegel uit om een andere toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegląd mieści maksymalnie 12 kafelków. Wyłącz jeden, aby dodać kolejny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Visão Geral comporta até 12 blocos: desative um para adicionar outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O resumo permite até 12 blocos: desative um para adicionar outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Обзоре» не больше 12 плиток: чтобы добавить, снимите другую."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар шарҳ ҳадди аксар 12 лавҳа ҷой мегирад: барои илова кардани дигаре якеро хомӯш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel Bakış en fazla 12 kutucuk içerir. Başka bir tane eklemek için birini kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В огляді щонайбільше 12 плиток: вимкніть одну, щоб додати іншу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumiy ko‘rinishda ko‘pi bilan 12 ta plitka bo‘ladi. Boshqasini qo‘shish uchun birini o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "概览最多显示 12 张卡片：请先关闭一张，再添加其他卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總覽最多可顯示 12 個圖塊。請先關閉一個，再加入其他圖塊。"
          }
        }
      }
    },
