    "backups.restore.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта копія пашкоджана, і аднавіць яе немагчыма. Нічога не заменена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie ist beschädigt und lässt sich nicht wiederherstellen. Nichts wurde ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy is damaged and cannot be restored. Nothing was replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia está dañada y no se puede restaurar. No se reemplazó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie est endommagée et ne peut pas être restaurée. Rien n'a été remplacé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia è danneggiata e non può essere ripristinata. Non è stato sostituito nulla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл көшірме бүлінген және қалпына келтірілмейді. Ештеңе ауыстырылмады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia jest uszkodzona i nie można jej przywrócić. Nic nie zostało zastąpione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia está danificada e não pode ser restaurada. Nada foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия повреждена, восстановить из неё нельзя. Ничего не заменено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kopya hasarlı ve geri yüklenemiyor. Hiçbir şey değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю копію пошкоджено, її неможливо відновити. Нічого не замінено."
          }
        }
      }
    },
    "backups.restore.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося аднавіць копію. Нічога не заменена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
