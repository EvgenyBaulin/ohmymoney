    "backups.restore.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq yalnız oxuma rejimindədir: nüsxəni bərpa etmək mümkün deyil. Əvvəlcə bu rejimdən çıxın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма працуе ў рэжыме толькі для чытання. Каб аднавіць копію, спачатку выйдзіце з гэтага рэжыму."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace je v režimu jen pro čtení. Kopii nelze obnovit. Nejprve tento režim ukončete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist nur lesbar: Eine Kopie kann nicht wiederhergestellt werden. Verlassen Sie zuerst den Modus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is read-only: a copy cannot be restored. Leave the mode first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app está en solo lectura: no se puede restaurar una copia. Salga antes del modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app est en lecture seule : une copie ne peut pas être restaurée. Quittez d'abord ce mode."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածը միայն ընթերցման ռեժիմում է․ պատճենը հնարավոր չէ վերականգնել։ Նախ դուրս եկեք այդ ռեժիմից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app è in sola lettura: impossibile ripristinare una copia. Esci prima da questa modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは読み取り専用のため、コピーを復元できません。先に読み取り専用モードを解除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპი მხოლოდ წაკითხვის რეჟიმშია: ასლის აღდგენა შეუძლებელია. ჯერ გამოდით ამ რეჟიმიდან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба тек оқу режимінде: көшірмені қалпына келтіру мүмкін емес. Алдымен режимнен шығыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмо окуу гана режиминде: көчүрмөнү калыбына келтирүү мүмкүн эмес. Адегенде режимден чыгыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app staat in de alleen-lezenmodus. Een kopie kan niet worden teruggezet. Schakel deze modus eerst uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja działa w trybie tylko do odczytu. Aby przywrócić kopię, wyłącz ten tryb."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app está em modo somente leitura. Saia desse modo para restaurar uma cópia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação está em modo de leitura e não é possível restaurar uma cópia. Saia primeiro deste modo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим «Только просмотр»: восстановить копию нельзя. Сначала выйдите из режима."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома дар ҳолати танҳо хондан аст: нусхаро барқарор кардан мумкин нест. Аввал аз ин ҳолат бароед."
