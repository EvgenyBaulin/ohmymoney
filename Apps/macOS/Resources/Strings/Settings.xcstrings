            "value": "«%1$@» wordt nergens gebruikt. Met “Herstel” zet je de categorie terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria «%1$@» nie jest używana. Wybierz „Cofnij”, aby ją przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» não está em uso. Toque em “Desfazer” para restaurá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» não está a ser usada. Toque em “Desfazer” para a repor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ничем не занята. «Отменить» вернёт её."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» дар ҳеҷ ҷо истифода намешавад. Барои барқарор кардан “Бекор кардан”-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» kullanılmıyor. “Geri Al” ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ніде не використовується. «Скасувати дію» повертає її."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»dan hech narsa foydalanmayapti. Uni “Bekor qilish” bilan tiklash mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»未被使用。轻点“撤销”可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有項目使用«%1$@»。點一下「復原」可還原。"
          }
        }
      }
    },
