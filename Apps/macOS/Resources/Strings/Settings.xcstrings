          "stringUnit": {
            "state": "translated",
            "value": "At today's rate — when the goal's money is kept in its currency. At the rates of the contributions — when it is kept in rubles: each contribution counts with the rubles of its day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По сегодняшнему курсу — если деньги цели лежат в её валюте. По курсу взносов — если они лежат в рублях: каждый взнос считается рублями своего дня."
          }
        }
      }
    },
    "settings.planning.includesGoals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal money sits on accounts in the summary"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги целей лежат на счетах в сводке"
          }
        }
      }
    },
    "settings.planning.includesGoalsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, «can spend» leaves out the money already put into goals. Turn it off when goal money is kept on an account outside the summary."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, «можно тратить» не считает деньги, уже отложенные на цели. Выключите, если деньги целей лежат на счёте вне сводки."
          }
        }
      }
    },
    "settings.planning.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits"
          }
