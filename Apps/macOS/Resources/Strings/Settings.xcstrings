    "currencies.directory.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Adlar və ölkələr valyuta kataloqundan götürülür. Öz valyutalarınız daxil etdiyiniz kimi göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назвы і краіны бяруцца з даведніка валют. Уласныя валюты паказваюцца так, як вы іх увялі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy a země pocházejí ze seznamu měn. Vlastní měny se zobrazují tak, jak jste je zadali."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und Länder stammen aus dem Verzeichnis der Währungen. Eigene Währungen werden so angezeigt, wie Sie sie eingetragen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and countries come from the directory of currencies. Own currencies are shown as you typed them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres y los países vienen del directorio de divisas. Las divisas propias se muestran tal como las escribió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms et les pays viennent du répertoire des devises. Les devises personnelles sont affichées telles que vous les avez saisies."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անուններն ու երկրները վերցված են արժույթների տեղեկատուից։ Սեփական արժույթները ցուցադրվում են այնպես, ինչպես մուտքագրել եք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi e i paesi provengono dall’elenco delle valute. Le valute personali sono mostrate come le hai inserite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と国は通貨一覧から取得されます。独自通貨は入力したとおりに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სახელები და ქვეყნები ვალუტების ცნობარიდანაა. საკუთარი ვალუტები ისე ჩანს, როგორც შეიყვანეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атаулар мен елдер валюталар анықтамалығынан алынады. Өз валюталары сіз терген түрінде көрсетіледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аталыштар жана өлкөлөр валюта маалымкатынан алынат. Өз валюталарыңыз сиз киргизгендей көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen en landen komen uit de valutalijst. Eigen valuta's worden weergegeven zoals je ze hebt ingevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy i kraje pochodzą z katalogu walut. Własne waluty są wyświetlane tak, jak je wpisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes e países vêm do catálogo de moedas. As moedas próprias aparecem como você as digitou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes e países são fornecidos pelo diretório de moedas. As moedas próprias aparecem como foram introduzidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия и страны берутся из справочника валют. Свои валюты показываются так, как вы их ввели."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Номҳо ва кишварҳо аз феҳристи асъор гирифта мешаванд. Асъори шахсӣ ҳамон тавре нишон дода мешавад, ки ворид кардед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adlar ve ülkeler para birimleri dizininden alınır. Özel para birimleri girdiğiniz gibi gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви й країни беруться з довідника валют. Власні валюти показуються так, як ви їх увели."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomlar va mamlakatlar valyutalar ma’lumotnomasidan olinadi. Shaxsiy valyutalar kiritilganidek ko‘rsatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称和国家来自货币目录。自定义货币按输入的内容显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱和國家來自貨幣目錄。自訂貨幣會依照你的輸入顯示。"
          }
        }
      }
    },
    "currencies.lock.base": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubl bütün cəmlərin, limitlərin və hesabatların valyutasıdır: aktiv qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубель — валюта ўсіх вынікаў, лімітаў і справаздач, таму ён заўсёды ўключаны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubl je měnou všech součtů, limitů a přehledů. Nelze ho vypnout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rubel ist die Währung jeder Summe, jedes Limits und Berichts: Er bleibt eingeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ruble is the currency of every total, limit and report: it stays on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rublo es la divisa de todos los totales, límites e informes: se queda activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rouble est la devise de chaque total, plafond et rapport : il reste activé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ռուբլին բոլոր հանրագումարների, սահմանաչափերի և հաշվետվությունների արժույթն է․ այն միշտ միացված է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rublo è la valuta di tutti i totali, limiti e resoconti e rimane attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーブルはすべての合計、予算、レポートの基準通貨のため、無効にできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რუბლი ყველა ჯამის, ლიმიტისა და ანგარიშის ვალუტაა და ჩართული რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубль — әр жиынның, лимиттің және есептің валютасы: ол қосулы қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубль бардык жыйынтыктардын, лимиттердин жана отчеттордун валютасы болгондуктан өчүрүлбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De roebel wordt gebruikt voor alle totalen, limieten en rapporten en blijft ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubel jest walutą wszystkich sum, limitów i raportów. Musi pozostać włączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rublo é a moeda de todos os totais, limites e relatórios e permanece ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O rublo é a moeda de todos os totais, limites e relatórios e permanece ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубль — валюта всех итогов, лимитов и отчётов: он не выключается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубл асъори ҳамаи ҷамъбастҳо, маҳдудиятҳо ва ҳисоботҳост: он фаъол мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruble tüm toplamların, limitlerin ve raporların para birimidir; kapatılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубль — валюта всіх підсумків, лімітів і звітів: він залишається ввімкненим."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubl barcha jami summalar, limitlar va hisobotlar valyutasi: u o‘chirilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卢布用于所有总额、限额和报告，始终保持启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "盧布用於所有總額、限額和報表，因此會保持啟用。"
          }
        }
      }
    },
    "currencies.lock.default": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Standart valyuta aktiv qalır. Əvvəlcə başqa standart valyuta seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта па змаўчанні заўсёды ўключана. Спачатку выберыце іншую."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí měnu nelze vypnout. Nejprve vyberte jinou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardwährung bleibt eingeschaltet. Wählen Sie zuerst eine andere Standardwährung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default currency stays on. Choose another default first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La divisa por defecto se queda activada. Elija antes otra por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La devise par défaut reste activée. Choisissez d'abord une autre devise par défaut."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լռելյայն արժույթը միշտ միացված է։ Նախ ընտրեք մեկ այլ լռելյայն արժույթ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La valuta di default rimane attiva. Scegline prima un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルト通貨は無効にできません。先に別の通貨をデフォルトに設定してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაგულისხმევი ვალუტა ჩართული რჩება. ჯერ აირჩიეთ სხვა ნაგულისხმევი ვალუტა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдепкі валюта қосулы қалады. Алдымен басқа әдепкіні таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Демейки валютаны өчүрүүгө болбойт. Адегенде башка демейки валютаны тандаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaardvaluta blijft ingeschakeld. Kies eerst een andere standaardvaluta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślna waluta musi pozostać włączona. Najpierw wybierz inną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A moeda padrão permanece ativada. Escolha outra moeda padrão primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A moeda predefinida permanece ativa. Escolha primeiro outra moeda predefinida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Валюта по умолчанию не выключается. Сначала выберите другую."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Асъори пешфарз фаъол мемонад. Аввал асъори пешфарзи дигарро интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saptanmış para birimi kapatılamaz. Önce başka bir para birimini saptanmış olarak seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типова валюта залишається ввімкненою. Спочатку виберіть іншу типову валюту."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Standart valyutani o‘chirib bo‘lmaydi. Avval boshqa standart valyutani tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认货币始终保持启用。请先选择其他默认货币。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設貨幣會保持啟用。請先選擇其他預設貨幣。"
          }
        }
      }
    },
    "currencies.lock.held": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabda bu valyuta var: əvvəlcə onu hesabdan çıxarın (Ayarlar → Hesablar)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта валюта выкарыстоўваецца на рахунку. Спачатку прыбярыце яе з рахунку (Налады → Рахункі)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto měnu používá účet. Nejprve ji z něj odeberte (Nastavení → Účty)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konto führt diese Währung: Nehmen Sie sie zuerst vom Konto (Einstellungen → Konten)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account holds this currency: take it off the account first (Settings → Accounts)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta tiene esta divisa: quítela antes de la cuenta (Ajustes → Cuentas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte détient cette devise : retirez-la d'abord du compte (Réglages → Comptes)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս արժույթն օգտագործվում է հաշվում․ նախ հեռացրեք այն հաշվից (Կարգավորումներ → Հաշիվներ)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto usa questa valuta. Rimuovila prima dal conto (Impostazioni → Conti)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この通貨を使用している口座があります。先に口座から削除してください（設定 → 口座）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ვალუტა ანგარიშზე გამოიყენება. ჯერ წაშალეთ ის ანგარიშიდან (პარამეტრები → ანგარიშები)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір есеп-шот бұл валютаны ұстайды: алдымен оны есеп-шоттан алыңыз (Параметрлер → Есеп-шоттар)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул валюта эсепте колдонулууда. Адегенде аны эсептен алып салыңыз (Жөндөөлөр → Эсептер)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze valuta wordt gebruikt door een rekening. Verwijder de valuta eerst van de rekening (Instellingen → Rekeningen)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta waluta jest używana na koncie. Najpierw usuń ją z konta (Ustawienia → Konta)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta usa esta moeda. Remova-a da conta primeiro em Ajustes → Contas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta usa esta moeda. Remova-a primeiro da conta (Definições → Contas)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта валюта есть на счёте: сначала уберите её из счёта (Настройки → Счета)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҳисоб ин асъор мавҷуд аст: аввал онро аз ҳисоб хориҷ кунед (Танзимот → Ҳисобҳо)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hesapta bu para birimi var. Önce hesaptan kaldırın (Ayarlar → Hesaplar)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунку є ця валюта: спочатку приберіть її з рахунку («Налаштування → Рахунки»)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobda bu valyuta bor: avval uni hisobdan olib tashlang (Sozlamalar → Hisoblar)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有账户使用此货币，请先从账户中移除（设置 → 账户）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有帳戶持有此貨幣。請先從帳戶移除（設定 → 帳戶）。"
          }
        }
      }
    },
    "currencies.missing.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündəlik məzənnələrdə yoxdur: %@. Bu valyutalarda əməliyyat üçün məzənnə əl ilə daxil edilir. Siyahı Ayarlar → Valyutalar bölməsindədir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адсутнічаюць у штодзённых курсах: %@. Для аперацыі ў такой валюце трэба ўвесці курс уручную. Спіс знаходзіцца ў раздзеле Налады → Валюты."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V denních kurzech chybí: %@. U operací v těchto měnách je nutné zadat kurz ručně. Seznam najdete v Nastavení → Měny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlt in den Tageskursen: %@. Ein Vorgang in einer solchen Währung braucht einen von Hand eingetragenen Kurs. Die Liste finden Sie unter Einstellungen → Währungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing from its daily rates: %@. An operation in such a currency takes a rate typed by hand. The list is in Settings → Currencies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan en sus tipos diarios: %@. Un movimiento en esa divisa toma un tipo escrito a mano. La lista está en Ajustes → Divisas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absente de ses cours quotidiens : %@. Une opération dans une telle devise prend un cours saisi à la main. La liste est dans Réglages → Devises."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օրական փոխարժեքներում բացակայում են՝ %@։ Այս արժույթներով գործարքների համար փոխարժեքը մուտքագրվում է ձեռքով։ Ցանկը՝ Կարգավորումներ → Արժույթներ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano dai tassi giornalieri: %@. Per le operazioni in queste valute devi inserire il tasso manualmente. Trovi l’elenco in Impostazioni → Valute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日次レートに含まれていない通貨: %@。これらの通貨で取引するには、レートを手動で入力してください。通貨一覧は「設定 → 通貨」にあります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღიურ კურსებში არ არის: %@. ასეთ ვალუტაში ოპერაციისთვის კურსი ხელით უნდა შეიყვანოთ. სია იხილეთ: პარამეტრები → ვალუტები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күнделікті бағамдарында жоқ: %@. Мұндай валютадағы операцияға қолмен теріліген бағам керек. Тізім — Параметрлер → Валюталарда."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күнүмдүк курстарда жок: %@. Мындай валютадагы операция үчүн курс кол менен киргизилет. Тизме: Жөндөөлөр → Валюталар."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontbreekt in de dagelijkse koersen: %@. Voor een transactie in deze valuta voer je de koers zelf in. De lijst staat in Instellingen → Valuta's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wśród dziennych kursów: %@. Dla operacji w tych walutach należy wpisać kurs ręcznie. Lista znajduje się w Ustawienia → Waluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não incluídas nas cotações diárias: %@. Para operações nessas moedas, digite a cotação manualmente. Veja a lista em Ajustes → Moedas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em falta nas taxas diárias: %@. As operações nestas moedas usam uma taxa introduzida manualmente. Consulte a lista em Definições → Moedas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет в ежедневных курсах ЦБ: %@. Для операции в такой валюте курс вводится вручную. Список — в Настройках, вкладка «Валюты»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар қурбҳои ҳаррӯзаи он нест: %@. Барои амалиёт бо ин асъор қурбро дастӣ ворид кунед. Рӯйхат дар Танзимот → Асъор аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük kurlarda bulunmayanlar: %@. Bu para birimindeki işlemler için kur elle girilir. Liste Ayarlar → Para Birimleri bölümündedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У щоденних курсах немає: %@. Для операції в такій валюті курс вводиться вручну. Список — у «Налаштування → Валюти»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunlik kurslarda yo‘q: %@. Bunday valyutadagi operatsiya uchun kurs qo‘lda kiritiladi. Ro‘yxat Sozlamalar → Valyutalar bo‘limida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日汇率中缺少：%@。使用这些货币的交易需要手动输入汇率。列表位于“设置 → 货币”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每日匯率中缺少：%@。使用這些貨幣記帳時，需手動輸入匯率。列表位於「設定 → 貨幣」。"
          }
        }
      }
    },
    "currencies.missing.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusiya Bankı bütün aktiv valyutaların məzənnəsini dərc etmir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк Расіі публікуе курсы не ўсіх уключаных валют"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruská centrální banka nezveřejňuje kurzy všech zapnutých měn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank of Russia veröffentlicht nicht jede eingeschaltete Währung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Bank of Russia does not publish every enabled currency"
          }
        },
        "es": {
