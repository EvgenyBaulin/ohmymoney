    "archive.error.checksum": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кантрольная сума файла ў архіве не супадае"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei im Archiv entspricht nicht ihrer Prüfsumme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file inside the archive does not match its checksum"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo dentro del archivo no coincide con su suma de control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier dans l'archive ne correspond pas à sa somme de contrôle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file nell’archivio non corrisponde al suo checksum"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағат ішіндегі файл өзінің бақылау сомасына сәйкес келмейді"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma kontrolna pliku w archiwum jest niezgodna"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo dentro do arquivo compactado não corresponde à soma de verificação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл внутри архива не сходится с контрольной суммой"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivdeki bir dosyanın sağlama toplamı eşleşmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл усередині архіву не відповідає контрольній сумі"
          }
        }
      }
    },
    "archive.error.damaged": {
      "comment": "Translation not verified by a native speaker.",
