    "settings.planning.listLength": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Радкі ў доўгіх блоках"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilen in langen Blöcken"
          }
        },
        "en": {
