          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ em «%1$@». Escolha uma nova categoria para as operações: estas são movidas primeiro e a categoria é apagada em seguida. Toque em “Desfazer” duas vezes para reverter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%1$@» %2$@. Выберите, куда перенести содержимое: оно переедет первым, категория уйдёт следом. Два нажатия «Отменить»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар «%1$@» %2$@. Барои онҳо категорияи нав интихоб кунед: аввал амалиётҳо кӯчонда мешаванд, баъд категория нест мешавад. Барои бекор кардани ҳар ду қадам “Бекор кардан”-ро ду бор пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» altında %2$@ var. İşlemler için yeni bir kategori seçin. Önce işlemler taşınır, ardından kategori silinir. Geri almak için “Geri Al”a iki kez dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%1$@» — %2$@. Виберіть нову категорію для записів: спочатку вони перенесуться, потім категорія видалиться. Два кроки «Скасувати дію»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» turkumida %2$@. Ular uchun yangi turkum tanlang: avval operatsiyalar ko‘chiriladi, so‘ng turkum o‘chiriladi. Bekor qilish uchun “Bekor qilish” ikki marta bosiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»下有%2$@。请选择新类别：交易将先被移动，然后删除类别。需轻点两次“撤销”才能全部撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»中有%2$@。請選擇新類別：交易會先移動，再刪除類別。點兩次「復原」可還原。"
          }
        }
      }
    },
    "categories.delete.withChildren": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» və onun %2$@ heç yerdə istifadə olunmur. Onları ⌘Z ilə bərpa edə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» і яе %2$@ нідзе не выкарыстоўваюцца. ⌘Z верне іх назад."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ani její %2$@ se nikde nepoužívají. Pomocí ⌘Z je obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und ihre %2$@ werden von nichts genutzt. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» and its %2$@ are used by nothing. ⌘Z brings them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» y sus %2$@ no los usa nada. ⌘Z los devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et ses %2$@ ne sont utilisées par rien. ⌘Z les rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» կատեգորիան և դրա %2$@ չեն օգտագործվում։ ⌘Z-ը վերականգնում է դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e le sue %2$@ non sono usate. Premi ⌘Z per ripristinarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»とその%2$@は使われていません。⌘Zで元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» და მისი %2$@ არსად გამოიყენება. მათ აღსადგენად დააჭირეთ ⌘Z."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» және оның %2$@ ешкім қолданбайды. ⌘Z оларды қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» жана анын %2$@ эч жерде колдонулбайт. Аларды ⌘Z менен калыбына келтирсеңиз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» en de bijbehorende %2$@ worden nergens gebruikt. Met ⌘Z zet je ze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria «%1$@» i jej podkategorie (%2$@) nie są używane. Naciśnij ⌘Z, aby je przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e suas %2$@ não estão em uso. Pressione ⌘Z para restaurá-las."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» e as respetivas %2$@ não estão a ser usadas. Prima ⌘Z para as repor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» и %2$@ ничем не заняты. ⌘Z вернёт их."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ва %2$@-и он дар ҳеҷ ҷо истифода намешаванд. Барои барқарор кардан ⌘Z-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ve %2$@ kullanılmıyor. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» та її %2$@ ніде не використовуються. ⌘Z повертає їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» va uning %2$@ hech qayerda ishlatilmayapti. Ularni ⌘Z bilan tiklash mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»及其%2$@均未被使用。按 ⌘Z 可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有項目使用«%1$@»及其%2$@。按下 ⌘Z 可還原。"
          }
        }
      }
    },
