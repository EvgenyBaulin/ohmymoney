    "categories.limit.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylıq limit: boş xana limiti silir, sıfır qəbul edilmir. ↻ — qalıq növbəti aya keçirilir; yeni məbləğ bu ay qalıq hesablamasını yenidən başlayır. Hər dəyişikliyi ⌘Z ilə geri almaq olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Месячны ліміт: пустое поле здымае ліміт, нуль не прымаецца. ↻ — рэшта пераносіцца; новая сума пачынае перанос зноў у гэтым месяцы. Кожную змену можна скасаваць праз ⌘Z."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční limit: prázdné pole limit zruší, nulu nelze zadat. ↻ — zůstatek se převádí; nová částka začne převod počítat znovu od tohoto měsíce. Každou změnu lze vrátit pomocí ⌘Z."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatliches Limit: Ein leeres Feld entfernt das Limit, null wird nicht angenommen. ↻ — was übrig ist, wird übertragen; ein neuer Betrag beginnt die Übertragung in diesem Monat neu. Jede Änderung machen Sie mit ⌘Z rückgängig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly limit: an empty field removes the limit, zero is not accepted. ↻ — what is left carries over; a new amount starts the carry again this month. Each change is undone with ⌘Z."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite mensual: un campo vacío quita el límite, el cero no se acepta. ↻ — lo que queda se traspasa; un importe nuevo vuelve a empezar el traspaso este mes. Cada cambio se deshace con ⌘Z."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plafond mensuel : un champ vide retire le plafond, zéro n'est pas accepté. ↻ — ce qui reste est reporté ; un nouveau montant relance le report ce mois-ci. Chaque modification s'annule avec ⌘Z."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսական սահմանաչափ․ դատարկ դաշտը հանում է սահմանաչափը, զրոն չի ընդունվում։ ↻ — մնացորդը փոխանցվում է հաջորդ ամիս․ նոր գումար մուտքագրելիս փոխանցումը սկսվում է նորից՝ այս ամսից։ Յուրաքանչյուր փոփոխություն կարելի է հետարկել ⌘Z-ով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite mensile: lascia vuoto per rimuovere il limite; lo zero non è accettato. ↻ — il residuo viene riportato al mese successivo; un nuovo importo avvia di nuovo il riporto da questo mese. Annulla ogni modifica con ⌘Z."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の上限：空欄にすると上限を解除します。0は指定できません。↻ — 残額を翌月に繰り越します。金額を変更すると、今月から繰り越しをやり直します。変更は⌘Zで取り消せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვიური ლიმიტი: ცარიელი ველი ლიმიტს შლის, ნული არ მიიღება. ↻ — ნაშთი გადადის შემდეგ თვეში; ახალი თანხის მითითება გადატანას ამ თვიდან თავიდან იწყებს. ყოველი ცვლილება უქმდება ⌘Z-ით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлық лимит: өрісі бос болса лимит алынады, нөлді қабылдамайды. ↻ — қалғаны көшеді; жаңа сома осы айда көшіруді қайта бастайды. Әр өзгеріс ⌘Z-мен болдырылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлык лимит: талааны бош калтырсаңыз, лимит алынат; нөл кабыл алынбайт. ↻ — калдык кийинки айга өтөт; жаңы сумма киргизилсе, калдык ушул айдан кайра эсептелет. Ар бир өзгөртүүнү ⌘Z менен артка кайтарса болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maandlimiet: laat het veld leeg om de limiet te verwijderen. Nul is niet toegestaan. ↻ — het restant wordt meegenomen; bij een nieuw bedrag begint de overdracht deze maand opnieuw. Elke wijziging kan met ⌘Z ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit miesięczny: puste pole usuwa limit, zero nie jest akceptowane. ↻ — pozostała kwota przechodzi na kolejny miesiąc; nowa kwota rozpoczyna przenoszenie od tego miesiąca. Każdą zmianę można cofnąć za pomocą ⌘Z."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite mensal: deixe o campo vazio para remover o limite. Zero não é aceito. ↻ — o saldo passa para o mês seguinte; um novo valor reinicia o acúmulo neste mês. Desfaça cada alteração com ⌘Z."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite mensal: um campo vazio remove o limite; não é aceite zero. ↻ — o valor restante transita; um novo montante reinicia a transferência neste mês. Cada alteração pode ser anulada com ⌘Z."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит в месяц: пустое поле убирает лимит, ноль не ставится. ↻ — остаток переносится; новая сумма начинает перенос заново с этого месяца. Каждое изменение отменяется ⌘Z."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маҳдудияти моҳона: майдони холӣ маҳдудиятро нест мекунад, сифр қабул намешавад. ↻ — бақия ба моҳи оянда мегузарад; маблағи нав интиқоли бақияро аз ҳамин моҳ аз нав оғоз мекунад. Ҳар тағйиротро бо ⌘Z бекор кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık limit: Boş alan limiti kaldırır, sıfır kabul edilmez. ↻ — kalan tutar devreder; yeni bir tutar girildiğinde devir bu aydan yeniden başlar. Her değişiklik ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місячний ліміт: порожнє поле прибирає ліміт, нуль не приймається. ↻ — залишок переходить далі; нова сума починає перенесення заново цього місяця. Кожну зміну можна скасувати через ⌘Z."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylik limit: bo‘sh maydon limitni olib tashlaydi, nol qabul qilinmaydi. ↻ — qoldiq keyingi oyga o‘tadi; yangi summa qoldiqni shu oydan qayta hisoblaydi. Har bir o‘zgarishni ⌘Z bilan bekor qilish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月度限额：留空可移除限额，不能设为零。↻ 表示结余会结转；设置新金额后，本月重新开始结转。每次更改均可用 ⌘Z 撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月限額：留空即可移除限額，不接受零。↻ — 剩餘金額會結轉；輸入新金額會從本月重新開始結轉。每項更改都可按 ⌘Z 還原。"
          }
        }
      }
    },
