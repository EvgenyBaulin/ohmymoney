    "references.usage.used": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by %@, the bin included. It cannot be deleted: merge it into another record or put it in the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo usa %@, también la papelera. No se puede eliminar: fusiónelo con otro registro o pásela al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé par %@, corbeille comprise. Il ne peut pas être supprimé : fusionnez-le avec un autre enregistrement ou mettez-le aux archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется: %@ — корзина тоже считается. Удалить нельзя: можно объединить с другой записью или убрать в архив."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується в %@, зокрема в кошику. Не можна видалити: об'єднайте з іншим записом або архівуйте."
          }
        }
      }
    },
