    "archive.noPassword.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdəki hər şey — insanların və yerlərin adları, bütün məbləğlər — açıq saxlanacaq. Faylı əldə edən hər kəs onları oxuya bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усё змесціва — імёны людзей, назвы месцаў і ўсе сумы — будзе адкрытым. Любы, хто атрымае файл, зможа яго прачытаць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veškerý obsah — jména lidí, názvy míst i všechny částky — bude uložen nechráněný. Přečíst si ho bude moci každý, kdo soubor získá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles darin — Namen von Personen, Orte und jeder Betrag — liegt offen da. Wer die Datei bekommt, kann sie lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything inside — names of people, places and every amount — will lie in the open. Anyone who gets the file can read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que contiene — nombres de personas, lugares y cada importe — quedará a la vista. Cualquiera que tenga el archivo podrá leerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qu'elle contient — les noms des personnes, les lieux et chaque montant — sera visible à découvert. Quiconque obtient le fichier peut le lire."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվի ամբողջ բովանդակությունը՝ մարդկանց և վայրերի անունները, բոլոր գումարները, հասանելի կլինի առանց պաշտպանության։ Ֆայլը ստացող ցանկացած անձ կկարողանա կարդալ այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il contenuto, inclusi nomi di persone, luoghi e importi, sarà leggibile. Chiunque ottenga il file potrà leggerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人や場所の名前、すべての金額を含む内容が暗号化されずに保存されます。ファイルを入手した人は誰でも内容を読めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივში ყველაფერი — ადამიანებისა და ადგილების სახელები და ყველა თანხა — დაუცველი იქნება. მის წაკითხვას შეძლებს ყველა, ვისაც ფაილი ექნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ішіндегі бәрі — адамдардың аттары, орындар және әр сома — ашық жатады. Файлды алған кез келген адам оқи алады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ичиндеги бардык маалымат — адамдардын, жерлердин аттары жана ар бир сумма — ачык сакталат. Файлга ээ болгон ар бир адам аны окуй алат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in het archief — namen van personen, plaatsen en alle bedragen — is onbeschermd. Iedereen met het bestand kan het lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała zawartość — nazwy osób i miejsc oraz wszystkie kwoty — będzie jawna. Każdy, kto otrzyma plik, będzie mógł ją odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o conteúdo — nomes de pessoas, lugares e valores — ficará exposto. Qualquer pessoa com acesso ao arquivo poderá lê-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o conteúdo — nomes de pessoas, locais e todos os valores — ficará visível. Quem tiver acesso ao ficheiro poderá lê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё внутри — имена людей, места и все суммы — будет лежать в открытом виде. Любой, у кого окажется файл, это прочитает."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳамаи мундариҷа — номҳои одамон, ҷойҳо ва ҳамаи маблағҳо — ошкор мемонад. Ҳар касе, ки файлро гирад, онро хонда метавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçindeki her şey — kişi ve yer adları ile tüm tutarlar — açıkta olacak. Dosyayı ele geçiren herkes bunları okuyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе всередині — імена людей, місця й кожна сума — зберігатиметься відкрито. Кожен, хто отримає файл, зможе його прочитати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdagi hamma narsa — odamlar va joylar nomlari, barcha summalar — ochiq saqlanadi. Faylni qo‘lga kiritgan har kim ularni o‘qiy oladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档中的所有内容，包括人物、地点名称和每笔金额，都将以明文保存。任何获得此文件的人都可以读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案中的所有內容，包括人名、地點和所有金額，都將以未加密方式儲存。任何取得檔案的人都能讀取。"
          }
        }
      }
    },
