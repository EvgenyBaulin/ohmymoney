      }
    },
    "categories.rename.taken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Artıq başqa kateqoriyanın bu adı var. Ad dəyişikliyi saxlanılıb; istənilən birinin adını dəyişə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Іншая катэгорыя цяпер мае такую назву. Новая назва захавана; вы можаце перайменаваць любую з іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiná kategorie už má tento název. Přejmenování je uloženo; kteroukoli z nich můžete přejmenovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bereits eine Kategorie mit diesem Namen. Der Name bleibt, wie er war — wählen Sie einen anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another category has this name now. The rename is saved; you can rename either one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una categoría con este nombre. El nombre se queda como estaba: elija otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une catégorie porte déjà ce nom. Le nom reste tel qu'il était — choisissez-en un autre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այժմ մեկ այլ կատեգորիա ունի այս անունը։ Նոր անունը պահպանվել է․ կարող եք վերանվանել դրանցից ցանկացածը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra categoria ha ora questo nome. La modifica è stata salvata; puoi rinominare una delle due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のカテゴリが別にあります。名前の変更は保存されました。どちらの名前も変更できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს სახელი უკვე სხვა კატეგორიას აქვს. ცვლილება შენახულია; შეგიძლიათ რომელიმეს სახელი შეუცვალოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы атаумен санат бұрыннан бар. Атауы бұрынғыдай қалады — басқасын таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азыр башка категорияда да ушул ат бар. Жаңы ат сакталды; каалаганын өзгөртө аласыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere categorie heeft nu deze naam. De naamswijziging is bewaard; je kunt beide categorieën een andere naam geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna kategoria ma teraz tę nazwę. Zmiana została zachowana; możesz zmienić nazwę dowolnej z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra categoria já tem esse nome. A alteração foi salva; você pode renomear qualquer uma delas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra categoria tem agora este nome. A alteração foi guardada; pode alterar o nome de qualquer uma delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь есть ещё одна категория с таким названием. Переименование сохранено; можно переименовать любую из них."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло категорияи дигаре ин номро дорад. Номи нав сабт шуд; шумо метавонед номи ҳар кадомро иваз кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad artık başka bir kategoride kullanılıyor. Ad değişikliği kaydedildi; iki kategoriden birinin adını değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія з такою назвою вже є. Назва не змінилася — виберіть іншу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozir boshqa turkum shu nomda. Yangi nom saqlandi; istalgan birining nomini o‘zgartirishingiz mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在已有另一个类别使用此名称。重命名已存储；你可以重命名任一类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個類別現在使用此名稱。新名稱已儲存；你可以重新命名任一類別。"
          }
        }
      }
    },
