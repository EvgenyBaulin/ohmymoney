      }
    },
    "settings.categoryHints.metricsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accuracy is how often the first suggestion was right. Macro-F1 gives rare and frequent categories equal weight. Coverage is the share of parts for which the model was confident enough to fill in a category. Labelled parts are the parts with an owner-chosen category that the model can learn from."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точность — как часто первая подсказка была верной. В Macro-F1 редкие категории весят наравне с частыми. Покрытие — доля частей, для которых модель была достаточно уверена, чтобы подставить категорию. Размечено — сколько частей с выбранной вами категорией, на которых модель может учиться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точність — як часто перша підказка була правильною. Macro-F1 однаково враховує рідкісні й часті категорії. Охоплення — частка частин, для яких модель була достатньо впевнена, щоб заповнити категорію. Частини з категорією — записи з категорією, вибраною власником, на яких модель може навчатися."
          }
        }
      }
    },
