    "settings.planning.freeMoneyHorizonHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti 30 gün və ya ən yaxın gəlirə qədər olan öhdəliklər üçün vəsait ayırın. Gələcək gəlirlər əlavə edilmir. Qarşıda gəlir yoxdursa, 30 gün götürülür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэзерваваць сродкі на абавязковыя выдаткі на наступныя 30 дзён або да найбліжэйшага даходу. Будучы даход не дадаецца. Калі даходаў не чакаецца, выкарыстоўваюцца 30 дзён."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odložte peníze na závazky na příštích 30 dní nebo do nejbližšího příjmu. Budoucí příjmy se nepřičítají. Pokud žádný příjem neočekáváte, použije se 30 dní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verpflichtungen für die nächsten 30 Tage oder bis zur nächsten Einnahme zurückhalten. Künftige Einnahmen werden nicht hinzugerechnet. Gibt es keine bevorstehende Einnahme, gelten 30 Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold back commitments for the next 30 days or until the nearest income. Future income is not added. With no upcoming income, use 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descuenta los compromisos de los próximos 30 días o hasta el ingreso más cercano. Los ingresos futuros no se suman. Si no hay ingresos próximos, se usan 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On retient les engagements des 30 prochains jours, ou jusqu'au prochain revenu. Les revenus futurs ne sont pas ajoutés. Sans revenu à venir, on prend 30 jours."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահուստավորել հաջորդ 30 օրվա կամ մինչև մոտակա եկամուտը նախատեսված պարտավորությունները։ Ապագա եկամուտը չի ավելացվում։ Եթե եկամուտ չի սպասվում, օգտագործվում է 30 օրը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accantona gli impegni per i prossimi 30 giorni o fino alla prossima entrata. Le entrate future non vengono aggiunte. Se non ci sono entrate previste, usa 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後30日間または次の収入までの支出予定を差し引きます。将来の収入は加算されません。収入予定がない場合は30日間を使用します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაინახეთ თანხა მომდევნო 30 დღის ან უახლოესი შემოსავლის თარიღამდე არსებული ვალდებულებებისთვის. მომავალი შემოსავალი არ ემატება. თუ შემოსავალი არ იგეგმება, გამოიყენება 30 დღე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Келесі 30 күнге не ең жақын кіріске дейінгі міндеттемелерге ақша қалдыру. Болашақ кіріс қосылмайды. Алдағы кіріс болмаса, 30 күн алынады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кийинки 30 күндөгү же эң жакын кирешеге чейинки милдеттенмелерди кармап калуу. Келечектеги кирешелер кошулбайт. Күтүлгөн киреше жок болсо, 30 күн колдонулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserveer verplichtingen voor de komende 30 dagen of tot de eerstvolgende inkomsten. Toekomstige inkomsten worden niet meegeteld. Zonder komende inkomsten worden 30 dagen gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłóż środki na zobowiązania na najbliższe 30 dni lub do najbliższego przychodu. Przyszłe przychody nie są doliczane. Jeśli nie ma nadchodzącego przychodu, przyjmij 30 dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve os compromissos dos próximos 30 dias ou até a próxima receita. Receitas futuras não são adicionadas. Se não houver receita prevista, use 30 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve os compromissos para os próximos 30 dias ou até ao próximo rendimento. Os rendimentos futuros não são adicionados. Se não houver rendimentos previstos, são usados 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывать обязательства на ближайшие 30 дней или до ближайшего дохода. Будущие доходы не прибавляются. Если ближайшего дохода нет — 30 дней."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ӯҳдадориҳоро барои 30 рӯзи оянда ё то даромади наздиктарин ҷудо кунед. Даромади оянда илова намешавад. Агар даромади дарпешистода набошад, 30 рӯз истифода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki 30 günün veya en yakın gelire kadar olan yükümlülüklerin tutarını ayırır. Gelecekteki gelirler eklenmez. Yaklaşan gelir yoksa 30 gün kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервувати зобов'язання на наступні 30 днів або до найближчого доходу. Майбутній дохід не додається. Якщо доходу не очікується, використовується 30 днів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyingi 30 kun yoki eng yaqin daromadgacha bo‘lgan majburiyatlar uchun pul ajrating. Kelajakdagi daromadlar qo‘shilmaydi. Kutilayotgan daromad bo‘lmasa, 30 kun olinadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预留未来 30 天或至最近一笔收入到账前的款项。不计入未来收入。如果没有即将到账的收入，则使用 30 天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預留未來 30 天或至最近一筆收入的應付金額。不計入未來收入。若沒有即將到來的收入，則以 30 天計算。"
          }
        }
      }
    },
