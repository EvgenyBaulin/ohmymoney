    "references.refusal.otherNameTaken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» artıq «%2$@» üçün addır: daxiletmə sətrində onları ayırmaq mümkün olmaz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ужо з’яўляецца назвай «%2$@»: у радку ўводу іх нельга будзе адрозніць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» už je název záznamu «%2$@»: při zadávání by je nebylo možné rozlišit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist bereits ein Name von „%2$@“: Die Eingabezeile könnte beide nicht unterscheiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» is already a name of «%2$@»: the entry line would not tell the two apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ya es un nombre de «%2$@»: la línea de entrada no distinguiría los dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est déjà un nom de « %2$@ » : la ligne de saisie ne saurait pas les distinguer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»-ն արդեն «%2$@»-ի անուններից է․ մուտքագրելիս դրանք հնարավոր չի լինի տարբերել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è già un nome di «%2$@»: durante l’inserimento non sarebbe possibile distinguerli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»はすでに«%2$@»の名前として使われているため、入力時に区別できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» უკვე არის «%2$@»-ის სახელი: შეყვანის ველში მათი გარჩევა ვერ მოხერხდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» — «%2$@» атауларының бірі: енгізу жолы екеуін ажырата алмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» — «%2$@» жазуусунун аты: киргизүү сабында аларды айырмалоо мүмкүн болбойт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» is al een naam van «%2$@». Bij het invoeren zou er geen onderscheid zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» to już nazwa «%2$@»: podczas wprowadzania nie będzie można ich rozróżnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» já é um nome de «%2$@»: não seria possível distingui-los ao registrar uma operação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» já é um nome de «%2$@»: não seria possível distingui-los ao introduzir dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» — уже название «%2$@»: строка ввода не различила бы две записи."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» аллакай номи «%2$@» аст: дар сатри воридкунӣ онҳоро фарқ кардан имкон надорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» zaten «%2$@» için kullanılan bir ad: giriş satırında ikisi ayırt edilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» уже є назвою «%2$@»: рядок вводу не розрізнить записи."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» allaqachon «%2$@»ning nomi: kiritishda ularni farqlab bo‘lmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»已是«%2$@»的名称：记账时无法区分两者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» 已是 «%2$@» 的名稱：輸入時將無法區分兩者。"
          }
        }
      }
    },
