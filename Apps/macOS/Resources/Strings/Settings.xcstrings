    "settings.privacy.lockUnavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На гэтым Mac няма ні Touch ID, ні пароля ўваходу — уключыць блакіроўку немагчыма."
