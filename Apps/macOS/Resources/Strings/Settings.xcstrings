            "state": "translated",
            "value": "Pravidla pouze navrhují částky ve formuláři příjmu. Bez volby «Zaznamenat» se nic nezapíše."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln schlagen nur Beträge auf dem Blatt einer Einnahme vor — dort wird nichts ohne „Erfassen“ geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules only suggest amounts on the sheet of an income — nothing is written there without «Record»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas solo proponen importes en la hoja de un ingreso — allí no se escribe nada sin «Registrar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles ne font que proposer des montants sur la feuille d'un revenu — rien n'y est noté sans « Noter »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանոններն ընդամենը առաջարկում են գումարներ եկամտի թերթիկում․ առանց «Գրանցել»-ի ոչինչ չի գրանցվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole suggeriscono solo gli importi nella scheda di un'entrata: nulla viene registrato senza «Registra»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールは収入の入力画面で金額を提案するだけです。「記録」を押すまで何も記録されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წესები მხოლოდ შემოსავლის ფურცელზე გთავაზობთ თანხებს — «ჩაწერის» გარეშე არაფერი ჩაიწერება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер кіріс парағында сомаларды ғана ұсынады — «Жазу» басылмайынша ештеңе жазылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эрежелер киреше барагында суммаларды гана сунуштайт — «Жазуу» басылмайынча эч нерсе жазылбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regels stellen alleen bedragen voor bij inkomsten. Er wordt niets vastgelegd zonder «Record»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły tylko proponują kwoty w formularzu przychodu — nic nie zostanie zapisane bez wybrania «Zapisz»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras apenas sugerem valores na tela de uma receita — nada é salvo sem tocar em «Registrar»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras apenas sugerem valores na ficha de um rendimento — nada é guardado sem «Registar»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила только предлагают суммы в листе распределения дохода — без «Записать» там ничего не пишется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоидаҳо танҳо маблағҳоро дар варақаи даромад пешниҳод мекунанд — бе «Сабт» чизе навишта намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurallar, gelir formunda yalnızca tutar önerir; «Kaydet» seçilmeden hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила лише пропонують суми у вікні доходу — нічого не записується без «Записати»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoidalar daromad varag‘ida faqat summalarni tavsiya qiladi — «Yozish» bosilmaguncha hech narsa saqlanmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则只会在收入表单中建议金额，只有点按“记录”才会写入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則只會在收入表單中建議金額；按下「記錄」後才會寫入。"
          }
        }
      }
    },
