    "names.other.taken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» artıq bu addan istifadə edir: daxiletmə sətri onları fərqləndirə bilməyəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва ўжо выкарыстоўваецца для «%@»: радок уводу не зможа іх адрозніць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název už používá «%@». Řádek pro zadávání by je nerozlišil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hört bereits auf diesen Namen: Die Eingabezeile könnte beide nicht unterscheiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» already answers to this name: the entry line would not tell the two apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya responde a este nombre: la línea de entrada no distinguiría los dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » répond déjà à ce nom : la ligne de saisie ne saurait pas les distinguer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»-ն արդեն օգտագործում է այս անունը․ գրառման տողում դրանք հնարավոր չի լինի տարբերել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» usa già questo nome: non sarebbe possibile distinguere i due elementi durante l’inserimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前はすでに«%@»に使われているため、入力時に区別できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ სახელს უკვე იყენებს «%@»: შეყვანის ველი მათ ვერ გაარჩევს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» осы атаумен белгілі: енгізу жолы екеуін ажырата алмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул ат «%@» үчүн мурунтан колдонулат: киргизүү сабы экөөнү айырмалай албайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» gebruikt deze naam al. Het invoerveld kan de twee dan niet onderscheiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» używa już tej nazwy. Pole wprowadzania nie pozwoli ich rozróżnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» já usa este nome. O campo de entrada não conseguiria distingui-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» já usa este nome. A linha de introdução não conseguiria distingui-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это название уже у «%@» — строка ввода не различила бы две записи."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» аллакай бо ин ном шинохта мешавад: сатри воридкунӣ онҳоро фарқ карда наметавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad zaten «%@» için kullanılıyor; giriş satırı ikisini ayıramaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже використовує цю назву: рядок вводу не розрізнить записи."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nom allaqachon «%@»ga tegishli: kiritish satri ularni ajrata olmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»已使用此名称：输入栏无法区分两者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已使用此名稱，輸入欄將無法區分兩者。"
          }
        }
      }
    },
