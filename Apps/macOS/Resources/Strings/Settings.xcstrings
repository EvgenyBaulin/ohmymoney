    "export.warning.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İxrac edilən fayllarda insanların adları və məbləğlər var. Onlar tətbiqin qorunan mühitindən çıxır və saxladığınız yerdə qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспартаваныя файлы змяшчаюць імёны людзей і сумы. Яны захоўваюцца па-за ізаляваным асяроддзем праграмы ў выбраным вамі месцы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportované soubory obsahují jména a částky. Opustí zabezpečené úložiště aplikace a zůstanou tam, kam je uložíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die exportierten Dateien enthalten Namen von Personen und Beträge. Sie verlassen die Sandbox der App und bleiben dort, wo Sie sie ablegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exported files contain names of people and amounts. They leave the app's sandbox and stay wherever you put them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos exportados contienen nombres de personas e importes. Salen del entorno aislado de la app y se quedan donde los guarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers exportés contiennent des noms de personnes et des montants. Ils sortent du bac à sable de l'app et restent là où vous les mettez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արտահանված ֆայլերը պարունակում են մարդկանց անուններ և գումարներ։ Դրանք դուրս են գալիս հավելվածի մեկուսացված միջավայրից և մնում ձեր ընտրած տեղում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file esportati contengono nomi di persone e importi. Escono dalla sandbox dell’app e rimangono nella posizione scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したファイルには、名前や金額が含まれます。ファイルはアプリのサンドボックスの外に保存されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ექსპორტირებული ფაილები შეიცავს ადამიანების სახელებსა და თანხებს. ისინი აპის დაცული გარემოდან გადის და თქვენ მიერ არჩეულ ადგილას რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортталған файлдарда адамдардың аттары мен сомалар бар. Олар қолданба құмсалғышынан шығады және қай жерге қойсаңыз, сонда қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорттолгон файлдарда адамдардын аттары жана суммалар бар. Алар колдонмонун корголгон чөйрөсүнөн чыгып, сиз тандаган жерде сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geëxporteerde bestanden bevatten namen van personen en bedragen. Ze verlaten de sandbox van de app en blijven staan waar je ze bewaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportowane pliki zawierają imiona i nazwiska oraz kwoty. Opuszczą piaskownicę aplikacji i pozostaną w wybranym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos exportados contêm nomes de pessoas e valores. Eles saem do armazenamento protegido do app e permanecem onde você os salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros exportados contêm nomes de pessoas e valores. Saem da área protegida da aplicação e permanecem onde os guardar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выгруженных файлах есть имена людей и суммы. Они покидают песочницу приложения и останутся там, куда вы их положите."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлҳои содиршуда номҳои одамон ва маблағҳоро дар бар мегиранд. Онҳо берун аз фазои ҳифзшудаи барнома, дар ҷойи интихобкардаи шумо мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarılan dosyalar kişi adlarını ve tutarları içerir. Dosyalar uygulamanın korumalı alanından çıkar ve kaydettiğiniz yerde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортовані файли містять імена людей і суми. Вони залишають пісочницю застосунку й зберігаються там, куди ви їх покладете."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport qilingan fayllarda odamlarning ismlari va summalar bor. Ular ilovaning himoyalangan muhitidan chiqadi va siz saqlagan joyda qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出的文件包含姓名和金额。文件将离开 App 沙盒并保存在你选择的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出的檔案包含姓名和金額。這些檔案會離開 App 的沙盒，並保留在你選擇的位置。"
          }
        }
      }
    },
