    "categories.delete.free": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» heç yerdə istifadə olunmur. Onu ⌘Z ilə bərpa edə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» нідзе не выкарыстоўваецца. ⌘Z верне яе назад."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» se nikde nepoužívá. Pomocí ⌘Z ji obnovíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wird von nichts genutzt. ⌘Z holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» is used by nothing. ⌘Z brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» no la usa nada. ⌘Z la devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » n'est utilisée par rien. ⌘Z la rétablit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» կատեգորիան չի օգտագործվում։ ⌘Z-ը վերականգնում է այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» non è usata. Premi ⌘Z per ripristinarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»は使われていません。⌘Zで元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» არსად გამოიყენება. მის აღსადგენად დააჭირეთ ⌘Z."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» санатын ешкім қолданбайды. ⌘Z оны қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» эч жерде колдонулбайт. Аны ⌘Z менен калыбына келтирсеңиз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» wordt nergens gebruikt. Met ⌘Z zet je de categorie terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria «%1$@» nie jest używana. Naciśnij ⌘Z, aby ją przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» não está em uso. Pressione ⌘Z para restaurá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» não está a ser usada. Prima ⌘Z para a repor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ничем не занята. ⌘Z вернёт её."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» дар ҳеҷ ҷо истифода намешавад. Барои барқарор кардан ⌘Z-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» kullanılmıyor. ⌘Z ile geri getirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ніде не використовується. ⌘Z повертає її."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»dan hech narsa foydalanmayapti. Uni ⌘Z bilan tiklash mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»未被使用。按 ⌘Z 可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有項目使用«%1$@»。按下 ⌘Z 可還原。"
          }
        }
      }
    },
