          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "as definições incluídas: idioma, tema, moedas, limites e opções"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "переносимые настройки: язык, тема, валюты, пороги, флаги"
          }
        },
        "tg": {
