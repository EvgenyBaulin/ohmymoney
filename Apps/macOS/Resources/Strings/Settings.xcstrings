    "settings.selfEmployed.referenceHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The law as OhMyMoney knows it. If the law changed before a new version came out, type your value; an empty field follows the law."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ley tal como la conoce OhMyMoney. Si la ley cambió antes de que saliera una versión nueva, escriba su valor; un campo vacío sigue la ley."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La loi telle qu'OhMyMoney la connaît. Si la loi a changé avant la sortie d'une nouvelle version, saisissez votre valeur ; un champ vide suit la loi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения закона, как их знает OhMyMoney. Если закон изменился раньше, чем вышла новая версия, впишите своё; пустое поле — как в законе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закон, відомий OhMyMoney. Якщо закон змінився до нової версії, введіть власне значення; порожнє поле відповідає закону."
          }
        }
      }
    },
