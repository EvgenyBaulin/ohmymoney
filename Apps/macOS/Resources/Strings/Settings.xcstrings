          "stringUnit": {
            "state": "translated",
            "value": "This Mac has neither Touch ID nor a login password — the lock cannot be turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene ni Touch ID ni contraseña de inicio de sesión — el bloqueo no se puede activar."
