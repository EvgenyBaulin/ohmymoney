            "value": "«%1$@» e le sue %2$@ non sono usate. Tocca “Annulla” per ripristinarle."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» және оның %2$@ ешкім қолданбайды. «Болдырмау» оларды қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» и %2$@ ничем не заняты. «Отменить» вернёт их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» та її %2$@ ніде не використовуються. «Скасувати дію» повертає їх."
          }
        }
      }
    },
