                "stringUnit": {
                  "state": "translated",
                  "value": "%lld copies older than a year will be deleted"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Будут удалены %lld копии старше года"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Будут удалены %lld копий старше года"
                }
              },
