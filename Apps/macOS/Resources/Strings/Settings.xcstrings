    "settings.planning.cushionOutHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. The cushion money in the summary is held back from the free sum. Turn off to include it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto. El dinero del colchón del resumen se descuenta de la suma libre. Desactívelo para incluirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut. L'argent du matelas dans le récapitulatif est mis de côté pour la somme libre. Désactivez pour l'y inclure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию включено. Деньги подушки в сводке вычитаются из свободной суммы. Выключите, чтобы учитывать их как свободные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово ввімкнено. Гроші подушки в підсумку утримуються з вільної суми. Вимкніть, щоб ураховувати їх."
          }
        }
      }
    },
