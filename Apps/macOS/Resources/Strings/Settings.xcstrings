    "backups.failure.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son nüsxə bütövlük yoxlamasından keçmədi"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апошняя копія не прайшла праверку цэласнасці"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední kopie neprošla kontrolou integrity"
