    "categories.delete.busy": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Böyük dəyişiklik hələ yadda saxlanılır. Bir az gözləyib yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вялікае змяненне яшчэ захоўваецца. Пачакайце і паспрабуйце зноў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsáhlá změna se ještě ukládá. Chvíli počkejte a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine große Änderung wird noch geschrieben. Einen Moment, dann versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large change is still being written. A moment, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía se está escribiendo un cambio grande. Un momento, y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une modification importante est encore en cours d'écriture. Un instant, puis réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեծ փոփոխության գրանցումը դեռ ընթացքի մեջ է։ Սպասեք մի պահ և կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una modifica estesa è ancora in fase di salvataggio. Attendi un momento e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな変更を保存中です。しばらくしてからもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დიდი ცვლილების შენახვა ჯერ არ დასრულებულა. მოიცადეთ და ხელახლა სცადეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлкен өзгеріс әлі жазылып жатыр. Сәл күтіп, қайталап көріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чоң өзгөртүү дагы эле сакталып жатат. Бир аздан кийин кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een grote wijziging wordt nog opgeslagen. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa zapisywanie dużej zmiany. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma alteração grande ainda está sendo salva. Aguarde um momento e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda está a ser guardada uma alteração grande. Aguarde um momento e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большая правка ещё пишется. Секунду, и попробуйте снова."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйироти калон ҳоло сабт мешавад. Каме интизор шавед ва аз нав кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük bir değişiklik hâlâ kaydediliyor. Biraz bekleyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Велика зміна ще записується. Зачекайте мить і спробуйте знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Katta o‘zgarish hali saqlanmoqda. Biroz kutib, qayta urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在存储大量更改。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大量變更仍在儲存中。請稍候再試。"
          }
        }
      }
    },
