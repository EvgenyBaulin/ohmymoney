            "state": "translated",
            "value": "Oude kopieën van vóór een update verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć stare kopie sprzed uaktualnienia?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar cópias antigas feitas antes de uma atualização?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar cópias antigas criadas antes de uma atualização?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить старые копии «перед обновлением»?"
