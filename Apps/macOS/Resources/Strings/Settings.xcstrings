    "settings.starter.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həyat tərzinizə uyğun kateqoriyalar, nümunə limitlər və İcmal plitələri əlavə edir. Yalnız əlavə edir; ⌘Z ilə geri qaytara bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадае катэгорыі, прыклады лімітаў і пліткі агляду паводле вашага ладу жыцця. Толькі дадае; ⌘Z адмяняе змены."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá kategorie, ukázkové limity a dlaždice přehledu podle vašeho životního stylu. Stávající údaje nemění; akci vrátíte pomocí ⌘Z."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänzt Kategorien, Beispiel-Limits und Kacheln der Übersicht für Ihre Lebensweise. Ergänzt nur; ⌘Z nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds categories, example limits and Overview tiles for the way you live. Only adds; ⌘Z takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade categorías, límites de ejemplo y mosaicos del Resumen según su forma de vida. Solo añade; ⌘Z lo deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des catégories, des exemples de plafonds et des tuiles de l'Aperçu selon votre mode de vie. Seulement ajouter ; ⌘Z le reprend."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացնում է ձեր ապրելակերպին համապատասխան կատեգորիաներ, սահմանաչափերի օրինակներ և Ընդհանուր պատկերի սալիկներ։ Միայն ավելացնում է․ ⌘Z-ը հետ է շրջում փոփոխությունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge categorie, esempi di limiti e riquadri alla Panoramica in base al tuo stile di vita. Aggiunge soltanto; usa ⌘Z per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暮らし方に合わせたカテゴリ、上限の例、概要のタイルを追加します。既存の項目は変更されません。⌘Zで取り消せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამატებს თქვენს ცხოვრებაზე მორგებულ კატეგორიებს, ლიმიტების მაგალითებსა და მიმოხილვის ბარათებს. მხოლოდ ამატებს; ⌘Z გააუქმებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өмір салтыңызға сай санаттар, лимит мысалдары мен Шолу плиткаларын қосады. Тек қосады; ⌘Z кері қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жашоо образыңызга ылайык категорияларды, мисал лимиттерди жана Сереп такталарын кошот. Учурдагы маалымат өзгөрбөйт; ⌘Z менен жокко чыгарсаңыз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt categorieën, voorbeeldlimieten en tegels in Overzicht toe die bij je leven passen. Bestaande gegevens blijven staan; met ⌘Z maak je dit ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje kategorie, przykładowe limity i kafelki Przeglądu dopasowane do Twojego stylu życia. Tylko dodaje; ⌘Z cofa zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona categorias, exemplos de limites e cartões à Visão Geral para o seu estilo de vida. Apenas adiciona; ⌘Z desfaz a ação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona categorias, exemplos de limites e cartões à Visão geral, adaptados à sua vida. Apenas adiciona; ⌘Z reverte a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет категории, примеры лимитов и плитки «Обзора» под ваш образ жизни. Только добавляет; ⌘Z отменяет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияҳо, маҳдудиятҳои намунавӣ ва кортҳои шарҳи умумиро мувофиқи тарзи зиндагии шумо илова мекунад. Танҳо илова мекунад; ⌘Z тағйиротро бекор мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşam biçiminize uygun kategoriler, örnek limitler ve Genel Bakış kartları ekler. Yalnızca ekleme yapar; ⌘Z ile geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає категорії, приклади лімітів і плитки огляду під ваш спосіб життя. Лише додає; ⌘Z скасовує дію."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Turmush tarzingizga mos toifalar, namunaviy limitlar va Umumiy ko‘rinish kartalarini qo‘shadi. Faqat qo‘shadi; ⌘Z bilan bekor qilish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的生活方式添加类别、示例限额和概览卡片。只添加内容；按 ⌘Z 可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照你的生活方式加入類別、範例限額和「總覽」圖塊。僅會新增項目；按 ⌘Z 可還原。"
          }
        }
      }
    },
    "settings.starter.hint.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həyat tərzinizə uyğun kateqoriyalar, nümunə limitlər və İcmal plitələri əlavə edir. Yalnız əlavə edir; “Geri al” ilə geri qaytara bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадае катэгорыі, прыклады лімітаў і пліткі агляду паводле вашага ладу жыцця. Толькі дадае; «Адмяніць» адмяняе змены."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá kategorie, ukázkové limity a dlaždice přehledu podle vašeho životního stylu. Stávající údaje nemění; akci vrátíte pomocí „Zpět“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänzt Kategorien, Beispiel-Limits und Kacheln der Übersicht für Ihre Lebensweise. Ergänzt nur; „Rückgängig“ nimmt es zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds categories, example limits and Overview tiles for the way you live. Only adds; “Undo” takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade categorías, límites de ejemplo y mosaicos del Resumen según su forma de vida. Solo añade; «Deshacer» lo deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des catégories, des exemples de plafonds et des tuiles de l'Aperçu selon votre mode de vie. Seulement ajouter ; « Annuler » le reprend."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացնում է ձեր ապրելակերպին համապատասխան կատեգորիաներ, սահմանաչափերի օրինակներ և Ընդհանուր պատկերի սալիկներ։ Միայն ավելացնում է․ “Հետարկել”-ը հետ է շրջում փոփոխությունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge categorie, esempi di limiti e riquadri alla Panoramica in base al tuo stile di vita. Aggiunge soltanto; usa “Annulla” per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暮らし方に合わせたカテゴリ、上限の例、概要のタイルを追加します。既存の項目は変更されません。「取り消す」で元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამატებს თქვენს ცხოვრებაზე მორგებულ კატეგორიებს, ლიმიტების მაგალითებსა და მიმოხილვის ბარათებს. მხოლოდ ამატებს; “გაუქმება” დააბრუნებს წინა მდგომარეობას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өмір салтыңызға сай санаттар, лимит мысалдары мен Шолу плиткаларын қосады. Тек қосады; “Болдырмау” кері қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жашоо образыңызга ылайык категорияларды, мисал лимиттерди жана Сереп такталарын кошот. Учурдагы маалымат өзгөрбөйт; “Жокко чыгаруу” менен артка кайтарсаңыз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt categorieën, voorbeeldlimieten en tegels in Overzicht toe die bij je leven passen. Bestaande gegevens blijven staan; met “Herstel” maak je dit ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje kategorie, przykładowe limity i kafelki Przeglądu dopasowane do Twojego stylu życia. Tylko dodaje; „Cofnij” cofa zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona categorias, exemplos de limites e cartões à Visão Geral para o seu estilo de vida. Apenas adiciona; “Desfazer” reverte a ação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona categorias, exemplos de limites e cartões à Visão geral, adaptados à sua vida. Apenas adiciona; “Desfazer” reverte a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет категории, примеры лимитов и плитки «Обзора» под ваш образ жизни. Только добавляет; «Отменить» отменяет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияҳо, маҳдудиятҳои намунавӣ ва кортҳои шарҳи умумиро мувофиқи тарзи зиндагии шумо илова мекунад. Танҳо илова мекунад; “Бекор кардан” тағйиротро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşam biçiminize uygun kategoriler, örnek limitler ve Genel Bakış kartları ekler. Yalnızca ekleme yapar; “Geri Al” ile geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає категорії, приклади лімітів і плитки огляду під ваш спосіб життя. Лише додає; «Скасувати дію» повертає попередній стан."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Turmush tarzingizga mos toifalar, namunaviy limitlar va Umumiy ko‘rinish kartalarini qo‘shadi. Faqat qo‘shadi; “Undo” bilan bekor qilish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的生活方式添加类别、示例限额和概览卡片。只添加内容；轻点“撤销”可还原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照你的生活方式加入類別、範例限額和「總覽」圖塊。僅會新增項目；點一下「還原」即可復原。"
          }
        }
      }
    },
