    "categories.pastQuality.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ужыць новую якасць да мінулых аперацый?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Bewertung auf vergangene Vorgänge anwenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the new quality to past operations?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Aplicar la nueva calidad a las operaciones pasadas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer la nouvelle utilité aux opérations passées ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicare la nuova qualità alle operazioni passate?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа сапа өткен операцияларға қолданылсын ба?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosować nową ocenę do wcześniejszych operacji?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar a nova qualidade às operações anteriores?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить новую оценку к прошлым операциям?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni kalite geçmiş işlemlere uygulansın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосувати нову оцінку до попередніх операцій?"
          }
        }
      }
    },
