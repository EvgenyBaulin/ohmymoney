    "categories.system.help": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq bu kateqoriyanı öz qeydləri üçün saxlayır. Adını dəyişmək olar, lakin arxivləşdirmək və ya silmək olmaz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма захоўвае гэту катэгорыю для ўласнага ўліку. Яе можна перайменаваць, але нельга архіваваць ці выдаліць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace tuto kategorii používá pro vlastní záznamy. Lze ji přejmenovat, ale ne archivovat ani smazat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App behält diese Kategorie für ihre eigenen Aufzeichnungen. Sie kann umbenannt, aber nicht archiviert oder gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app keeps this category for its own records. It can be renamed, but not archived or deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app guarda esta categoría para sus propios registros. Se puede renombrar, pero no archivar ni eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app garde cette catégorie pour ses propres registres. Elle peut être renommée, mais ni archivée ni supprimée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածն այս կատեգորիան պահում է իր հաշվառման համար։ Այն կարելի է վերանվանել, բայց ոչ արխիվացնել կամ ջնջել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app usa questa categoria per le proprie registrazioni. Puoi rinominarla, ma non archiviarla né eliminarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカテゴリはアプリの記録に使用されます。名前は変更できますが、アーカイブや削除はできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპი ამ კატეგორიას საკუთარი აღრიცხვისთვის ინახავს. შეგიძლიათ სახელი შეუცვალოთ, მაგრამ ვერ დააარქივებთ ან წაშლით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба бұл санатты өз жазбалары үшін сақтайды. Оны қайта атауға болады, бірақ мұрағатқа өткізуге не жоюға болмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмо бул категорияны өз эсептери үчүн сактайт. Атын өзгөртсө болот, бирок архивге жылдырууга же өчүрүүгө болбойт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app gebruikt deze categorie voor de eigen administratie. Je kunt de naam wijzigen, maar de categorie niet archiveren of verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja używa tej kategorii do własnych zapisów. Można zmienić jej nazwę, ale nie można jej zarchiwizować ani usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app mantém esta categoria para seus próprios registros. Ela pode ser renomeada, mas não arquivada nem apagada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação mantém esta categoria para os seus registos. Pode alterar-lhe o nome, mas não arquivá-la nem apagá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту категорию приложение ведёт само. Её можно переименовать, но нельзя архивировать или удалить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома ин категорияро барои сабтҳои худ нигоҳ медорад. Номашро иваз кардан мумкин аст, аммо бойгонӣ ё нест карданаш мумкин нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bu kategoriyi kendi kayıtları için tutar. Adı değiştirilebilir, ancak arşivlenemez veya silinemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок використовує цю категорію для власних записів. Її можна перейменувати, але не архівувати чи видаляти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova bu turkumdan o‘z hisoblari uchun foydalanadi. Uning nomini o‘zgartirish mumkin, ammo arxivlash yoki o‘chirish mumkin emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 使用此类别记录数据。可以重命名，但不能归档或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 保留此類別供自身記錄使用。可以重新命名，但無法封存或刪除。"
          }
        }
      }
    },
