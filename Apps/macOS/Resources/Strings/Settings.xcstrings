    "report.offer.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма была спынена або адбыўся збой. Справаздача аб праблеме дапаможа высветліць прычыну: яна змяшчае журнал, версіі і колькасныя даныя, але не сумы, назвы і апісанні."
