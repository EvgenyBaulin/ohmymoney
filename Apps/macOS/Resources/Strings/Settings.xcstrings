          "stringUnit": {
            "state": "translated",
            "value": "Файл пошкоджено або це не архів OhMyMoney"
          }
        }
      }
    },
    "archive.error.database": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося адкрыць базу даных у архіве. Нічога не заменена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank im Archiv kann nicht geöffnet werden. Nichts wurde ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database inside the archive cannot be opened. Nothing was replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir la base de datos dentro del archivo. No se reemplazó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base contenue dans l'archive ne peut pas être ouverte. Rien n'a été remplacé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il database nell’archivio. Non è stato sostituito nulla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағат ішіндегі дерекқорды ашу мүмкін емес. Ештеңе ауыстырылмады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć bazy danych w archiwum. Nic nie zostało zastąpione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o banco de dados dentro do arquivo. Nada foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу внутри архива открыть не удалось. Ничего не заменено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivdeki veritabanı açılamıyor. Hiçbir şey değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База даних усередині архіву не відкривається. Нічого не замінено."
          }
        }
      }
    },
