    "settings.hints.burnoutHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Diqqətə dəyər» bölməsində, həftədə ən çox bir dəfə: adi haldan xeyli çox, vaz keçə biləcəyiniz kiçik alışlar olan həftə"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У раздзеле «Варта паглядзець», не часцей за раз на тыдзень: калі за тыдзень дробных неабавязковых пакупак значна больш, чым звычайна"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V části «Stojí za pozornost» nejvýš jednou týdně: týden s mnohem více drobnými nákupy, bez kterých byste se obešli, než obvykle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Lohnt einen Blick“, höchstens einmal in der Woche: eine Woche mit vielen kleinen Käufen, auf die Sie eher verzichten könnten als üblich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In «Worth a look», at most once a week: a week with many more small purchases you could do without than usual"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Merece una mirada», como mucho una vez por semana: una semana con muchas más compras pequeñas prescindibles que de costumbre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans « À regarder de plus près », au plus une fois par semaine : une semaine avec bien plus de petits achats dont on pourrait se passer que d'habitude"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Արժե դիտել» բաժնում՝ շաբաթական առավելագույնը մեկ անգամ, երբ սովորականից շատ են ոչ անհրաժեշտ մանր գնումները"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In «Da controllare», al massimo una volta a settimana: una settimana con molti più piccoli acquisti superflui del solito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「要チェック」に週1回まで表示：なくてもよい少額の買い物が普段より大幅に多い週をお知らせ"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«ყურადღების ღირსია»-ში, კვირაში მაქსიმუმ ერთხელ: კვირა, როცა ჩვეულებრივზე ბევრად მეტ არასავალდებულო წვრილ შესყიდვას აკეთებთ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Назар аударыңыз» бөлімінде, аптасына бір реттен көп емес: қажетсіз ұсақ сатып алулар әдеттегіден едәуір көбейген апта"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Көңүл буруңуз» бөлүмүндө жумасына эң көп бир жолу: адаттагыдан кыйла көп, зарыл эмес майда сатып алуулар болгон жума"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In «Het bekijken waard», hooguit eenmaal per week: een week met veel meer kleine, niet-noodzakelijke aankopen dan gewoonlijk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W sekcji «Warto zobaczyć», najwyżej raz w tygodniu: tydzień ze znacznie większą niż zwykle liczbą drobnych zakupów, bez których można się obejść"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em «Vale conferir», no máximo uma vez por semana: uma semana com muito mais pequenas compras dispensáveis que o habitual"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em «Vale a pena ver», no máximo uma vez por semana: uma semana com muito mais pequenas compras dispensáveis do que o habitual"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Стоит посмотреть», не чаще раза в неделю: за неделю мелких необязательных покупок заметно больше обычного"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар «Қобили таваҷҷуҳ», на бештар аз як бор дар як ҳафта: ҳафтае, ки харидҳои хурди нолозим аз маъмул хеле зиёдтаранд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Göz Atmaya Değer» bölümünde, haftada en fazla bir kez: vazgeçebileceğiniz küçük alışverişlerin normalden çok daha fazla olduğu bir hafta"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «Варто переглянути», не частіше разу на тиждень: тиждень із набагато більшою кількістю необов'язкових дрібних покупок, ніж зазвичай"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«E’tiborga molik» bo‘limida haftasiga ko‘pi bilan bir marta: odatdagidan ancha ko‘p, voz kechish mumkin bo‘lgan mayda xaridlar qilingan hafta haqida"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 «值得一看» 中每周最多提示一次：当某周非必要小额消费明显多于平时时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「值得留意」中，每週最多提示一次：當週非必要的小額購物比平常多出許多"
          }
        }
      }
    },
    "settings.hints.burnoutNeedsEssentials": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kateqoriyalarda zəruri xərcləri qeyd edin («Zəruri xərclər»). Əks halda ipucu özünüzü sevindirmək üçün etdiyiniz alışları ərzaqdan ayıra bilmir və göstərilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазначце неабходныя выдаткі ў катэгорыях («Неабходныя выдаткі») — без гэтага падказка не адрозніць пачастунак ад прадуктаў і не з’явіцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V kategoriích označte nutné výdaje («Nutné výdaje») — bez toho upozornění nerozliší drobnou radost od nákupu potravin a nezobrazí se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie die notwendigen Ausgaben unter Kategorien („Notwendige Ausgaben“) — ohne sie kann der Hinweis einen Genuss nicht von Lebensmitteln unterscheiden und schweigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the necessary spending in Categories («Necessary spending») — without it the hint cannot tell a treat from groceries and stays silent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque el gasto necesario en Categorías («Gasto necesario») — sin ello, la sugerencia no distingue un capricho de la compra de comida y calla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez les dépenses nécessaires dans Catégories (« Dépenses nécessaires ») — sans cela, la suggestion ne peut pas distinguer une gâterie des courses et reste muette."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կատեգորիաներում նշեք անհրաժեշտ ծախսերը («Անհրաժեշտ ծախսեր»), որպեսզի հուշումը կարողանա տարբերել հաճույքի համար գնումները մթերքից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna le spese necessarie in Categorie («Spese necessarie»). Senza questa indicazione, il suggerimento non può distinguere uno sfizio dalla spesa alimentare e non viene mostrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「カテゴリ」で必要な支出を「必要な支出」に設定してください。設定しないと、ヒントがお楽しみと食料品を区別できず、表示されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორიებში მონიშნეთ აუცილებელი ხარჯები («აუცილებელი ხარჯები») — ამის გარეშე მინიშნება ვერ გაარჩევს სასუსნავს სურსათისგან და არ გამოჩნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санаттарда қажетті шығындарды белгілеңіз («Қажетті шығындар») — онсыз кеңес ермекке жұмсалған ақшаны азық-түліктен ажырата алмайды да, көрсетілмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияларда зарыл чыгымдарды белгилеңиз («Зарыл чыгымдар»). Ансыз кеңеш таттууну азык-түлүктөн айырмалай албай, көрсөтүлбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer de noodzakelijke uitgaven in Categorieën («Noodzakelijke uitgaven»). Zonder die informatie kan de tip een extraatje niet van boodschappen onderscheiden en verschijnt deze niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz niezbędne wydatki w Kategoriach («Niezbędne wydatki») — bez tego wskazówka nie odróżni przyjemności od zakupów spożywczych i nie będzie wyświetlana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque os gastos necessários em Categorias («Gastos necessários») — sem isso, a dica não consegue distinguir um agrado das compras de mercado e não aparece."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinale as despesas necessárias em Categorias («Despesas necessárias») — sem isso, a sugestão não distingue um mimo das compras essenciais e não aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте необходимые траты в «Категориях» («Необходимая трата») — без них подсказка не отличит мелочь от продуктов и молчит."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти заруриро дар Категорияҳо («Хароҷоти зарурӣ») қайд кунед — бе ин маслиҳат хариди дилхоҳро аз маводи ғизоӣ фарқ карда наметавонад ва нишон дода намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoriler'de zorunlu harcamaları işaretleyin («Zorunlu harcama»). Bu işaretler olmadan ipucu, keyfi harcamaları market alışverişinden ayıramaz ve gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте необхідні витрати в категоріях («Необхідні витрати») — без цього підказка не відрізняє приємну дрібницю від продуктів і мовчить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Toifalarda zarur xarajatlarni belgilang («Zarur xarajatlar») — busiz maslahat o‘zingizni siylashni oziq-ovqat xarididan ajrata olmaydi va ko‘rsatilmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“类别”中标记必要支出（«必要支出»）。否则，提示无法区分犒劳自己和购买日用品，也就不会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「類別」中標記必要支出（「必要支出」）。否則提示無法區分犒賞自己的購物和日常採買，也不會顯示。"
          }
        }
      }
    },
