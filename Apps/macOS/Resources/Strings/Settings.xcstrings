    "settings.currencies.defaultHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün yeni qeydlər, şablonlar, planlaşdırılmış ödənişlər, gözlənilən gəlirlər, borclar və məqsədlər bu valyutada başlayır. Yekunlar, limitlər və hesabatlar rublla qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Яна выкарыстоўваецца для новых запісаў, шаблонаў, запланаваных плацяжоў, чаканых даходаў, даўгоў і мэт. Вынікі, ліміты і справаздачы застаюцца ў рублях."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá se pro nové záznamy, šablony, plánované platby, očekávané příjmy, dluhy a cíle. Součty, limity a přehledy zůstávají v rublech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Neue beginnt darin: die Eingabezeile, Vorlagen, geplante Zahlungen, erwartete Einnahmen, Schulden und Ziele. Summen, Limits und Berichte bleiben in Rubel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything new starts in it: the entry line, templates, scheduled payments, expected income, debts and goals. Totals, limits and reports stay in rubles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo nuevo empieza en ella: la línea de entrada, las plantillas, los pagos programados, los ingresos previstos, las deudas y los objetivos. Los totales, los límites y los informes se quedan en rublos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est nouveau y commence : la ligne de saisie, les modèles, les paiements planifiés, les revenus attendus, les dettes et les objectifs. Les totaux, plafonds et rapports restent en roubles."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բոլոր նոր տարրերը սկսվում են այս արժույթով՝ գրառման տողը, ձևանմուշները, պլանավորված վճարումները, սպասվող եկամուտները, պարտքերը և նպատակները։ Ընդհանուր գումարները, սահմանաչափերը և հաշվետվությունները մնում են ռուբլով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene usata per tutte le nuove voci: registrazioni, modelli, pagamenti programmati, entrate previste, debiti e obiettivi. Totali, limiti e rapporti restano in rubli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄、テンプレート、定期支払い、収入予定、債務、目標の新規作成時に使われます。合計、上限、レポートはルーブルのままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველაფერი ახალი ამ ვალუტით იწყება: ჩანაწერის სტრიქონი, შაბლონები, დაგეგმილი გადახდები, მოსალოდნელი შემოსავალი, ვალები და მიზნები. ჯამები, ლიმიტები და ანგარიშები რუბლებში რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық жаңа жазба осы валютамен басталады: енгізу жолы, үлгілер, жоспарлы төлемдер, күтілетін кіріс, қарыздар мен мақсаттар. Қорытындылар, лимиттер мен есептер рубльде қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңы жазуулар, шаблондор, пландаштырылган төлөмдөр, күтүлгөн киреше, карыздар жана максаттар ушул валютада түзүлөт. Жалпы суммалар, чектер жана отчеттор рублде калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je toevoegt begint in deze valuta: de invoerregel, sjablonen, geplande betalingen, verwachte inkomsten, schulden en doelen. Totalen, limieten en rapporten blijven in roebels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest używana we wszystkich nowych wpisach, szablonach, płatnościach cyklicznych, oczekiwanych przychodach, długach i celach. Sumy, limity i raporty pozostają w rublach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo que é novo começa nessa moeda: lançamentos, modelos, pagamentos agendados, receitas esperadas, dívidas e metas. Totais, limites e relatórios permanecem em rublos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os novos elementos começam nesta moeda: a linha de registo, modelos, pagamentos agendados, rendimentos previstos, dívidas e objetivos. Os totais, limites e relatórios mantêm-se em rublos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ней начинается всё новое: строка ввода, шаблоны, платежи, ожидаемые поступления, долги и цели. Итоги, лимиты и отчёты остаются в рублях."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳамаи чизҳои нав бо он оғоз мешаванд: сатри сабт, қолабҳо, пардохтҳои нақшавӣ, даромади интизорӣ, қарзҳо ва ҳадафҳо. Ҷамъбастҳо, маҳдудиятҳо ва гузоришҳо бо рубл мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni kayıtlar, şablonlar, planlanmış ödemeler, beklenen gelirler, borçlar ve hedefler bu para birimiyle başlar. Toplamlar, sınırlar ve raporlar ruble olarak kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе нове починається в ній: рядок вводу, шаблони, заплановані платежі, очікувані доходи, борги й цілі. Підсумки, ліміти та звіти залишаються в рублях."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi yozuv qatori, shablonlar, rejalashtirilgan to‘lovlar, kutilayotgan daromadlar, qarzlar va maqsadlar shu valyutada yaratiladi. Jami summalar, limitlar va hisobotlar rublda qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建记录、模板、定期付款、预期收入、债务和目标均默认使用此货币。总额、限额和报告仍以卢布显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新的記錄、範本、排程付款、預期收入、債務和目標都會使用此貨幣。總額、限額和報告仍以盧布顯示。"
          }
        }
      }
    },
