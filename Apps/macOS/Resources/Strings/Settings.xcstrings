    "settings.selfEmployed.enabledHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Peşəkar gəlir vergisi: gəlir kateqoriyaları üzrə dərəcələr, sərbəst məbləğdə və Planlamada təxmini vergi"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падатак на прафесійны даход: стаўкі для катэгорый даходу, прыблізны падатак у свабоднай суме і на экране планавання"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Daň z příjmů z výdělečné činnosti: sazby u kategorií příjmů, přibližná daň ve volné částce a v plánování"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuer auf Einkünfte aus selbstständiger Tätigkeit: Sätze für Einnahmekategorien, die Steuer ≈ im freien Betrag und in der Planung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tax on professional income: rates on income categories, the tax ≈ in the free sum and in Planning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El impuesto sobre los ingresos profesionales: tasas en las categorías de ingreso, el impuesto ≈ en la suma libre y en Planificación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impôt sur l'activité professionnelle : taux sur les catégories de revenus, impôt ≈ dans la somme libre et dans la Planification"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մասնագիտական եկամտի հարկ․ եկամտի կատեգորիաների դրույքաչափերը և մոտավոր հարկը՝ ազատ գումարում ու Պլանավորման մեջ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta sul reddito professionale: aliquote per categoria di entrata e imposta ≈ nel saldo disponibile e in Pianificazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "職業所得税を使用します。収入カテゴリに税率を設定し、概算税額を「使えるお金」と「計画」に反映します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პროფესიული შემოსავლის გადასახადი: განაკვეთები შემოსავლის კატეგორიებზე და გადასახადის მიახლოებითი ოდენობა თავისუფალ თანხასა და დაგეგმვაში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кәсіби кіріс салығы: кіріс санаттарының мөлшерлемелері, бос сомадағы және Жоспарлаудағы салық ≈"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кесиптик кирешеге салык: киреше категорияларындагы чендер, эркин суммадагы жана Пландоодогу болжолдуу салык"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Belasting op beroepsinkomsten: tarieven per inkomstencategorie en de geschatte belasting in het vrij te besteden bedrag en in Planning"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatek od dochodu zawodowego: stawki dla kategorii przychodów i przybliżony podatek w wolnych środkach oraz na ekranie Planowanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposto sobre a renda profissional: alíquotas nas categorias de receita e imposto ≈ no valor livre e em Planejamento"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposto sobre rendimentos profissionais: taxas por categoria de rendimento, imposto ≈ no montante disponível e no Planeamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог на профессиональный доход: ставки у категорий доходов, налог ≈ в свободной сумме и в «Планировании»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Андоз аз даромади касбӣ: меъёрҳо барои категорияҳои даромад, андози ≈ дар маблағи озод ва Банақшагирӣ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesleki gelir vergisi: gelir kategorilerine göre oranlar, harcanabilir tutarda ve Planlama’da yaklaşık vergi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Податок на професійний дохід: ставки на категоріях доходів, податок ≈ у вільній сумі та «Плануванні»"
          }
        },
        "uz": {
