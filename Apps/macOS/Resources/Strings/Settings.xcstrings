    "report.crashHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq sistem jurnallarını özü oxumur. Hesabatlar ~/Library/Logs/DiagnosticReports qovluğundadır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма не чытае сістэмныя журналы самастойна. Справаздачы знаходзяцца ў ~/Library/Logs/DiagnosticReports."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace sama systémové protokoly nečte. Zprávy najdete v ~/Library/Logs/DiagnosticReports."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anwendung liest die Systemprotokolle nicht selbst. Die Berichte liegen in ~/Library/Logs/DiagnosticReports."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application does not read the system logs itself. The reports are in ~/Library/Logs/DiagnosticReports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación no lee por sí misma los registros del sistema. Los informes están en ~/Library/Logs/DiagnosticReports."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application ne lit pas elle-même les journaux du système. Les rapports sont dans ~/Bibliothèque/Logs/DiagnosticReports."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածն ինքնուրույն չի կարդում համակարգային մատյանները։ Հաշվետվությունները գտնվում են ~/Library/Logs/DiagnosticReports պանակում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non legge direttamente i log di sistema. I rapporti si trovano in ~/Library/Logs/DiagnosticReports."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションがシステムログを自動的に読み取ることはありません。レポートは~/Library/Logs/DiagnosticReportsにあります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპი სისტემურ ჟურნალებს თავად არ კითხულობს. ანგარიშები მდებარეობს აქ: ~/Library/Logs/DiagnosticReports."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба жүйе журналдарын өзі оқымайды. Есептер ~/Library/Logs/DiagnosticReports ішінде."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмо системалык журналдарды өзү окубайт. Отчеттор ~/Library/Logs/DiagnosticReports папкасында жайгашкан."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app leest de systeemlogboeken niet zelf. De rapporten staan in ~/Library/Logs/DiagnosticReports."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie odczytuje samodzielnie dzienników systemowych. Raporty znajdują się w ~/Library/Logs/DiagnosticReports."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não lê os registros do sistema. Os relatórios estão em ~/Library/Logs/DiagnosticReports."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação não lê os registos do sistema. Os relatórios encontram-se em ~/Library/Logs/DiagnosticReports."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не читает системные журналы само. Отчёты лежат в ~/Library/Logs/DiagnosticReports."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома журналҳои системаро худаш намехонад. Гузоришҳо дар ~/Library/Logs/DiagnosticReports ҷойгиранд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama sistem günlüklerini kendisi okumaz. Raporlar ~/Library/Logs/DiagnosticReports konumundadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок не читає системні журнали самостійно. Звіти лежать у ~/Library/Logs/DiagnosticReports."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova tizim jurnallarini o‘zi o‘qimaydi. Hisobotlar ~/Library/Logs/DiagnosticReports manzilida joylashgan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不会自行读取系统日志。报告位于 ~/Library/Logs/DiagnosticReports。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不會自行讀取系統日誌。報告位於 ~/Library/Logs/DiagnosticReports。"
          }
        }
      }
    },
    "report.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Problem yarandıqda təqdim etmək üçün bir fayl. Burada jurnal, versiyalar və saylar var — məbləğlər, adlar və təsvirlər yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адзін файл для перадачы ў выпадку праблемы. Ён змяшчае журнал, версіі і колькасныя даныя, але не сумы, назвы і апісанні."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden soubor k předání při potížích. Obsahuje protokol, verze a počty — nikdy částky, jména ani popisy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei zum Weitergeben, wenn etwas nicht funktioniert. Sie enthält das Journal, Versionen und Zählungen — nie Beträge, Namen oder Beschreibungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One file to hand over when something breaks. It holds the journal, versions and counts — never amounts, names or descriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo archivo para entregar cuando algo se rompe. Contiene el diario, versiones y recuentos — nunca importes, nombres ni descripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul fichier à transmettre quand quelque chose casse. Il contient le journal, les versions et des compteurs — jamais de montants, de noms ni de descriptions."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկ ֆայլ՝ խնդրի դեպքում փոխանցելու համար։ Այն պարունակում է մատյանը, տարբերակներն ու քանակները, բայց ոչ գումարներ, անուններ կամ նկարագրություններ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un unico file da fornire in caso di problemi. Contiene log, versioni e conteggi, mai importi, nomi o descrizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生したときに送るファイルです。ログ、バージョン、件数が含まれます。金額、名前、説明は含まれません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთი ფაილი პრობლემის შემთხვევაში გადასაცემად. შეიცავს ჟურნალს, ვერსიებსა და რაოდენობებს — არასდროს თანხებს, სახელებს ან აღწერებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақау болғанда жіберуге арналған бір файл. Онда журнал, нұсқалар мен сандар бар — сомалар, атаулар мен сипаттамалар болмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ката чыкканда жөнөтө турган бир файл. Анда журнал, версиялар жана сандар бар — суммалар, аттар же сүрөттөмөлөр жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén bestand om te delen als er iets misgaat. Het bevat het logboek, versies en aantallen, maar nooit bedragen, namen of beschrijvingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden plik do przekazania w razie problemów. Zawiera dziennik, wersje i liczby — nigdy kwoty, nazwy ani opisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo para enviar quando ocorrer um problema. Contém o registro, versões e contagens — nunca valores, nomes ou descrições."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ficheiro para enviar quando algo falha. Contém o registo, versões e contagens — nunca valores, nomes ou descrições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один файл, который можно отдать на разбор, когда что-то сломалось. В нём журнал, версии и количества — и никогда суммы, имена или описания."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Як файл барои фиристодан ҳангоми мушкилот. Он журнал, версияҳо ва шумораҳоро дар бар мегирад — маблағҳо, номҳо ва тавсифҳо ҳаргиз дохил намешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sorun oluştuğunda paylaşabileceğiniz tek bir dosya. Günlük, sürümler ve sayıları içerir; tutarları, adları veya açıklamaları içermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один файл, який можна передати, коли щось не працює. Містить журнал, версії й лічильники — без сум, імен та описів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosozlik yuz berganda yuborish uchun bitta fayl. Unda jurnal, versiyalar va sonlar bor — summalar, nomlar va tavsiflar yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现问题时可提供此文件。文件包含日志、版本和数量，不含金额、名称或描述。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生問題時可提供此檔案。檔案包含日誌、版本和數量，不含金額、名稱或描述。"
          }
        }
      }
    },
    "report.interrupted": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlki seans başa çatmayıb: tətbiq dayandırılıb və ya qəzaya uğrayıb. Problem hesabatı nə baş verdiyini göstərəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Папярэдні сеанс не завяршыўся: праграма была спынена або адбылся збой. Справаздача аб праблеме дапаможа высветліць прычыну."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předchozí relace nebyla ukončena: aplikace byla zastavena nebo spadla. Hlášení problému pomůže zjistit, co se stalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung vor dieser ist nicht beendet worden: Die Anwendung wurde gestoppt oder ist abgestürzt. Ein Problembericht sagt, was passiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session before this one did not end: the application was stopped or it crashed. A problem report will say what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión anterior no terminó: la aplicación se detuvo o se cayó. Un informe del problema dirá qué pasó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session précédente ne s'est pas terminée : l'application a été arrêtée ou elle a planté. Un rapport de problème dira ce qui s'est passé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախորդ աշխատաշրջանը չի ավարտվել․ հավելվածը դադարեցվել է կամ խափանվել։ Խնդրի հաշվետվությունը կօգնի պարզել պատճառը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione precedente non si è conclusa: l’app è stata interrotta o si è arrestata in modo anomalo. Un rapporto può aiutare a capire cosa è successo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のセッションは正常に終了しませんでした。アプリケーションが停止されたか、クラッシュしました。問題レポートで原因を確認できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წინა სესია არ დასრულდა: აპი შეჩერდა ან ავარიულად გაითიშა. პრობლემის ანგარიში აჩვენებს, რა მოხდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдыңғы сеанс аяқталмаған: қолданба тоқтатылған немесе істен шыққан. Мәселе есебі не болғанын көрсетеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мурунку сеанс аяктаган жок: колдонмо токтотулган же ката менен жабылган. Көйгөй тууралуу отчет эмне болгонун көрсөтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vorige sessie is niet beëindigd: de app is gestopt of vastgelopen. Een probleemrapport laat zien wat er is gebeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzednia sesja nie została zakończona: aplikację zatrzymano lub wystąpiła awaria. Raport problemu pomoże ustalić przyczynę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão anterior não foi encerrada: o app foi interrompido ou apresentou uma falha. Um relatório de problema mostrará o que aconteceu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão anterior não terminou: a aplicação foi interrompida ou falhou. Um relatório de problema ajudará a perceber o que aconteceu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс перед этим не завершился: приложение остановили или оно упало. Отчёт о проблеме покажет, что случилось."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанси қаблӣ ба анҷом нарасид: барнома қатъ шуд ё ба садама дучор шуд. Гузориши мушкилот нишон медиҳад, ки чӣ рӯй дод."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki oturum sona ermedi: uygulama durduruldu veya çöktü. Sorun raporu ne olduğunu gösterecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередній сеанс не завершився: застосунок зупинено або стався збій. Звіт про проблему пояснить, що сталося."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldingi seans yakunlanmagan: ilova to‘xtatilgan yoki ishdan chiqqan. Muammo hisoboti nima yuz berganini ko‘rsatadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次会话未正常结束：App 被停止或发生崩溃。问题报告可帮助了解原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次工作階段未正常結束：App 已停止或當機。問題報告會說明發生的狀況。"
          }
        }
      }
    },
    "report.offer.collect": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabat topla…"
          }
