    "archive.import.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the app is replaced by what is inside the archive. A copy of the current state is written first, and the app restarts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что есть в приложении, заменится содержимым архива. Копия текущего состояния будет сделана заранее, затем приложение перезапустится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе в застосунку буде замінено вмістом архіву. Спочатку збережеться копія поточного стану, потім застосунок перезапуститься."
          }
        }
      }
    },
    "archive.import.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive could not be opened"
