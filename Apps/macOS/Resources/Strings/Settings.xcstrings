    "settings.hints.burnoutHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In «Worth a look», at most once a week: a week with many more small purchases you could do without than usual"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Merece una mirada», como mucho una vez por semana: una semana con muchas más compras pequeñas prescindibles que de costumbre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Стоит посмотреть», не чаще раза в неделю: за неделю мелких необязательных покупок заметно больше обычного"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «Варто переглянути», не частіше разу на тиждень: тиждень із набагато більшою кількістю необов'язкових дрібних покупок, ніж зазвичай"
          }
        }
      }
    },
    "settings.hints.burnoutNeedsEssentials": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the necessary spending in Categories («Necessary spending») — without it the hint cannot tell a treat from groceries and stays silent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque el gasto necesario en Categorías («Gasto necesario») — sin ello, la sugerencia no distingue un capricho de la compra de comida y calla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте необходимые траты в «Категориях» («Необходимая трата») — без них подсказка не отличит мелочь от продуктов и молчит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте необхідні витрати в категоріях («Необхідні витрати») — без цього підказка не відрізняє приємну дрібницю від продуктів і мовчить."
          }
        }
      }
    },
    "settings.hints.creditHistory": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind about the credit history"
