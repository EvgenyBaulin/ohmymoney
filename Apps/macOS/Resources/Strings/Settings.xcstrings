    "backups.compareArchive.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an archive of the transfer and see how it differs from the database now. Nothing is written to either; an archive with a password asks for it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra un archivo de traslado y vea en qué se diferencia de la base de datos de ahora. No se escribe nada en ninguno de los dos; un archivo con contraseña la pide antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une archive de transfert et voyez en quoi elle diffère de la base actuelle. Rien n'est écrit dans l'un ni dans l'autre ; une archive protégée par mot de passe le demande d'abord."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте архив переноса и посмотрите, чем он отличается от базы сейчас. Ни в базу, ни в архив ничего не пишется; архив с паролем сначала спросит его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте архів перенесення й перегляньте відмінності від поточної бази. Нічого не записується в жоден із них; для архіву з паролем спочатку потрібно ввести пароль."
          }
        }
      }
    },
