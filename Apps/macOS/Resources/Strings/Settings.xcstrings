      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is read-only: an import is not possible. Leave the mode first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим «Только просмотр»: импорт недоступен. Сначала выйдите из режима."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок у режимі лише перегляду: імпорт неможливий. Спочатку вийдіть із режиму."
          }
        }
      }
    },
    "archive.import.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load this archive?"
