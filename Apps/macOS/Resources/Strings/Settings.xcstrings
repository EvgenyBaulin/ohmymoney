    "report.readme.why": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал запісваецца так, каб нічога з гэтага ў яго не трапіла: кожнае значэнне ў радку журнала мае тып, і ніводзін з іх не з’яўляецца грашыма, імем або назвай. Гэта правяраецца тэстам на базе даных з вядомымі значэннямі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Journal ist so geschrieben, dass nichts davon hinein gelangt: Ein Wert in einer Journalzeile hat einen Typ, und keine seiner Arten ist Geld, ein Name oder ein Titel. Ein Test prüft das an einer Datenbank mit bekannten Werten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal is written so that none of this gets into it: a value in a line of the journal has a type, and none of its kinds is money, a name or a title. A test checks it on a database of known values."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diario se escribe de forma que nada de esto entre en él: un valor de una línea del diario tiene un tipo, y ninguno de sus tipos es dinero, un nombre o un título. Una prueba lo comprueba sobre una base de datos de valores conocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal est écrit de façon à ce que rien de tout cela ne s'y glisse : une valeur dans une ligne du journal a un type, et aucun de ces types n'est un montant, un nom ou un titre. Un test le vérifie sur une base aux valeurs connues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il log è progettato per escludere questi dati: ogni valore registrato ha un tipo, e nessun tipo corrisponde a denaro, nomi o titoli. Un test lo verifica su un database con valori noti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журналға мұның ешқайсысы түспейтіндей жазылады: әр мәннің түрі бар, олардың арасында ақша, есім не атау жоқ. Бұл белгілі мәндері бар дерекқормен сыналады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziennik jest zapisywany tak, aby żadne z tych danych do niego nie trafiły: każda wartość w dzienniku ma typ, a żaden z nich nie oznacza pieniędzy ani nazwy. Test sprawdza to na bazie danych o znanych wartościach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro é feito para que nada disso seja incluído: cada valor em uma linha tem um tipo, e nenhum deles é dinheiro, nome ou título. Um teste verifica isso em um banco de dados com valores conhecidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал пишется так, что перечисленного в него не попадает: у значения в строке журнала есть тип, и среди его видов нет ни денег, ни имени, ни названия. Это проверяется тестом на базе с заведомыми значениями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük, bu bilgilerin hiçbiri kaydedilmeyecek şekilde yazılır: günlükteki her değerin bir türü vardır ve bu türlerin hiçbiri para veya ad içermez. Bir test, bunu değerleri bilinen bir veritabanında denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал побудовано так, щоб ці дані до нього не потрапляли: значення в рядку журналу має тип, серед яких немає грошей, імені чи назви. Тест перевіряє це на базі з відомими значеннями."
          }
        }
      }
    },
