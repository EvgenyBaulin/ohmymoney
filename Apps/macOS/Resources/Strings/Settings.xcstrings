    "references.rowMenuHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Birləşdirin, arxivə atın, bərpa edin və ya silin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аб’яднаць, перанесці ў архіў, аднавіць або выдаліць"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučit, archivovat, obnovit nebo smazat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenführen, ins Archiv legen, zurückholen oder löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge, put in the archive, bring back or delete"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionar, pasar al archivo, recuperar o eliminar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner, mettre aux archives, ramener ou supprimer"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միավորել, արխիվացնել, վերականգնել կամ ջնջել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisci, archivia, ripristina o elimina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統合、アーカイブ、復元、削除"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაერთიანება, არქივში გადატანა, აღდგენა ან წაშლა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біріктіру, мұрағаттау, қайтару немесе жою"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бириктирүү, архивдөө, калыбына келтирүү же өчүрүү"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvoegen, archiveren, terugzetten of verwijderen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scal, archiwizuj, przywróć lub usuń"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesclar, arquivar, restaurar ou apagar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar, arquivar, restaurar ou apagar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединить, убрать в архив, вернуть или удалить"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Якҷо кардан, бойгонӣ кардан, барқарор кардан ё нест кардан"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştir, arşivle, geri getir veya sil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об'єднати, архівувати, повернути або видалити"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Birlashtirish, arxivlash, tiklash yoki o‘chirish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并、归档、恢复或删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併、封存、還原或刪除"
          }
        }
      }
    },
