    "backups.failure.folderNotRemembered": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запомніць выбраную папку, таму копіі ў яе не захоўваюцца. Выберыце іншую папку"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Ordner konnte nicht gemerkt werden, daher gehen Kopien nicht dorthin. Wählen Sie einen anderen Ordner"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen folder could not be remembered, so copies do not go there. Choose another folder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo recordar la carpeta elegida, así que las copias no van allí. Elija otra carpeta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier choisi n'a pas pu être retenu, donc les copies n'y vont pas. Choisissez un autre dossier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile memorizzare la cartella scelta, quindi le copie non vengono salvate lì. Scegli un’altra cartella"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған қалтаны есте сақтау мүмкін болмады, сондықтан көшірмелер сонда бармайды. Басқа қалтаны таңдаңыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można było zapamiętać wybranego folderu, więc kopie nie są w nim zapisywane. Wybierz inny folder"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a pasta escolhida, por isso as cópias não são enviadas para ela. Escolha outra pasta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранную папку не удалось запомнить, поэтому копии туда не идут. Выберите другую папку"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasör hatırlanamadı, bu yüzden kopyalar oraya kaydedilmiyor. Başka bir klasör seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запам'ятати вибрану папку, тому копії туди не потрапляють. Виберіть іншу папку"
          }
        }
      }
    },
    "backups.failure.mirrorUnavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося адкрыць выбраную папку. Выберыце яе зноў, інакш копіі не будуць у яе захоўвацца"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Ordner kann nicht geöffnet werden. Wählen Sie ihn erneut, sonst erreichen Kopien ihn nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen folder cannot be opened. Choose it again, or copies will not reach it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir la carpeta elegida. Elíjala de nuevo, o las copias no llegarán a ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier choisi ne peut pas être ouvert. Choisissez-le à nouveau, sinon les copies ne l'atteindront pas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la cartella scelta. Sceglila di nuovo, altrimenti le copie non verranno salvate lì"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған қалтаны ашу мүмкін емес. Оны қайта таңдаңыз, әйтпесе көшірмелер сонда жетпейді"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć wybranego folderu. Wybierz go ponownie, aby kopie mogły być w nim zapisywane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir a pasta escolhida. Escolha-a novamente para que as cópias sejam enviadas para ela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная папка не открывается. Выберите её заново — иначе копии туда не попадут"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasör açılamıyor. Klasörü yeniden seçin, aksi takdirde kopyalar oraya kaydedilmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана папка не відкривається. Виберіть її знову, інакше копії туди не потраплять"
          }
        }
      }
    },
