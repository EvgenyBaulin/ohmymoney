    "settings.entry.orderHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перацягніце поле ўгору або ўніз. Панэль ↓ паказвае палі ў гэтым парадку, і Tab перамяшчае па іх у тым жа парадку. Тып аперацыі заўсёды застаецца зверху; «Падзяліць», «Аплачана за кагосьці» і «У крэдыт» — знізу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie ein Feld nach oben oder unten. Das Bedienfeld ↓ zeigt seine Felder in dieser Reihenfolge, und Tab geht in ihr durch sie. Die Art des Vorgangs bleibt immer oben; „Teilen“, „Für jemand anderen bezahlt“ und „Auf Kredit“ bleiben unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a field up or down. The ↓ panel shows its fields in this order, and Tab moves through them in it. The type of the operation always stays on top; “Split”, “Paid for someone” and “On credit” stay at the bottom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un campo arriba o abajo. El panel ↓ muestra sus campos en este orden, y Tab se mueve por ellos en ese orden. El tipo de la operación siempre queda arriba; «Dividir», «Pagado por otro» y «A crédito» quedan abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un champ vers le haut ou le bas. Le panneau ↓ affiche ses champs dans cet ordre, et Tab les parcourt dans le même ordre. Le type de l'opération reste toujours en haut ; « Répartir », « Payé pour quelqu'un » et « À crédit » restent en bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un campo verso l’alto o il basso. Il pannello ↓ mostra i campi in questo ordine e Tab li scorre nello stesso ordine. Il tipo di operazione resta sempre in cima; “Dividi”, “Pagato per qualcuno” e “A credito” restano in fondo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өрісті жоғары не төмен сүйреңіз. ↓ панелі өрістерді осы ретпен көрсетеді, Tab та осы ретпен ауысады. Операция түрі әрқашан жоғарыда, “Бөлу”, “Біреу үшін төледім” және “Несиеге” төменде қалады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij pole w górę lub w dół. Pola w panelu ↓ będą wyświetlane w tej kolejności, a klawisz Tab będzie między nimi przechodzić. Typ operacji zawsze pozostaje na górze, a „Podziel”, „Zapłacono za kogoś” i „Na kredyt” — na dole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um campo para cima ou para baixo. O painel ↓ mostra os campos nessa ordem, e Tab percorre os campos nessa mesma ordem. O tipo de operação fica sempre no topo; “Dividir”, “Pago para alguém” e “A crédito” ficam na parte inferior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите поле выше или ниже. В этом порядке панель ↓ показывает поля, и в нём же Tab переходит между ними. Тип операции всегда сверху, «Разделить», «За другого» и «В кредит» — внизу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alanı yukarı veya aşağı sürükleyin. ↓ panelinde alanlar bu sırada görünür ve Tab tuşuyla bu sırada geçilir. İşlem türü her zaman üstte; “Böl”, “Başkası için ödendi” ve “Veresiye” altta kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть поле вгору або вниз. Панель ↓ показує поля в цьому порядку, і Tab переходить між ними так само. Вид операції завжди зверху; «Розбити», «Оплачено за іншого» та «У кредит» — знизу."
          }
        }
      }
    },
