    "categories.pastQuality.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni keyfiyyət keçmiş əməliyyatlara tətbiq edilsin?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ужыць новую якасць да мінулых аперацый?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít novou kvalitu i na minulé transakce?"
          }
