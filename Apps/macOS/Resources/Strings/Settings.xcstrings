    "settings.appearance.accentHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız sistem rəngləri: onlar tünd mövzuya və «Kontrastı artır» ayarına avtomatik uyğunlaşır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі сістэмныя колеры: яны аўтаматычна прыстасоўваюцца да цёмнай тэмы і налады «Павялічыць кантраснасць»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používají se jen systémové barvy, které se automaticky přizpůsobí tmavému vzhledu a volbě «Zvýšit kontrast»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Systemfarben: Sie folgen dem dunklen Design und „Kontrast erhöhen“ von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System colours only: they follow the dark theme and «Increase contrast» by themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo colores del sistema: siguen por sí solos el tema oscuro y «Aumentar contraste»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs système uniquement : elles suivent d'elles-mêmes le thème sombre et « Augmenter le contraste »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն համակարգային գույներ․ դրանք ինքնաբերաբար հարմարվում են մուգ թեմային և «Բարձրացնել հակադրությունը» կարգավորմանը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo colori di sistema: si adattano automaticamente al tema scuro e a «Aumenta contrasto»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムカラーのみ使用します。ダークテーマと「コントラストを上げる」に自動的に対応します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ სისტემური ფერები: ისინი ავტომატურად ერგება მუქ თემას და «კონტრასტის გაზრდის» პარამეტრს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек жүйелік түстер: қараңғы тақырып пен «Контрастты арттыру» параметріне автоматты түрде бейімделеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Системалык түстөр гана: алар караңгы темага жана «Контрастты жогорулатуу» жөндөөсүнө автоматтык түрдө ыңгайлашат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen systeemkleuren: ze passen zich automatisch aan de donkere weergave en «Verhoog contrast» aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko kolory systemowe: automatycznie dostosowują się do trybu ciemnego i opcji «Zwiększ kontrast»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas cores do sistema: elas se adaptam ao tema escuro e à opção «Aumentar contraste» automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas cores do sistema: adaptam-se automaticamente ao tema escuro e a «Aumentar contraste»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвета системные: они сами подстраиваются под тёмную тему и «Увеличить контраст»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо рангҳои системавӣ: онҳо ба мавзӯи тира ва «Баланд бардоштани контраст» мутобиқ мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sistem renkleri: Koyu temaya ve «Kontrastı artır» ayarına otomatik uyum sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише системні кольори: вони самі враховують темну тему й підвищений контраст."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat tizim ranglari: ular qorong‘i mavzu va «Kontrastni oshirish» sozlamasiga avtomatik moslashadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用系统颜色，自动适应深色主题和“增强对比度”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅使用系統色彩，會自動配合深色主題和「增加對比」。"
          }
        }
      }
    },
