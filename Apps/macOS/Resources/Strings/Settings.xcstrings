    "categories.delete.busy": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вялікае змяненне яшчэ захоўваецца. Пачакайце і паспрабуйце зноў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine große Änderung wird noch geschrieben. Einen Moment, dann versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large change is still being written. A moment, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía se está escribiendo un cambio grande. Un momento, y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une modification importante est encore en cours d'écriture. Un instant, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una modifica estesa è ancora in fase di salvataggio. Attendi un momento e riprova."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлкен өзгеріс әлі жазылып жатыр. Сәл күтіп, қайталап көріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa zapisywanie dużej zmiany. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma alteração grande ainda está sendo salva. Aguarde um momento e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большая правка ещё пишется. Секунду, и попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük bir değişiklik hâlâ kaydediliyor. Biraz bekleyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Велика зміна ще записується. Зачекайте мить і спробуйте знову."
          }
        }
      }
    },
    "categories.delete.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыя не выдалена: на яе яшчэ ёсць спасылкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
