    "export.replace.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У папцы ўжо ёсць файлы з такімі назвамі. Яны будуць заменены новымі; астатняе ў папцы не зменіцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner enthält schon Dateien mit den Namen des Exports. Sie werden durch die neuen ersetzt; sonst wird nichts im Ordner berührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder already has files with the names of the export. They will be replaced by the new ones; nothing else in the folder is touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta ya tiene archivos con los nombres de la exportación. Se reemplazarán por los nuevos; nada más de la carpeta se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier contient déjà des fichiers portant les noms de l'export. Ils seront remplacés par les nouveaux ; rien d'autre dans le dossier n'est touché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella contiene già file con gli stessi nomi. Saranno sostituiti dai nuovi file; il resto della cartella rimarrà invariato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалтада экспорт атымен файлдар бар. Олар жаңаларымен ауыстырылады; қалтадағы басқа ештеңеге тиілмейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке уже есть файлы с именами выгрузки. Они будут заменены новыми; остальное в папке не тронуто."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці вже є файли з назвами експорту. Їх буде замінено новими; решта вмісту папки не зміниться."
          }
        }
      }
    },
