    "backups.freeUp.nothing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinəcək heç nə yoxdur: silinə bilən nüsxələr artıq silinib. Yeniləmədən əvvəl yaradılmış nüsxələr saxlanılır; köhnələrini «Bir ildən köhnələri sil» ilə silə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма чаго выдаляць: усе копіі, якія можна выдаліць, ужо выдалены. Копіі перад абнаўленнем застаюцца; старыя можна выдаліць праз «Выдаліць старэйшыя за год»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není co smazat: kopie, které lze odstranit, už byly smazány. Kopie vytvořené před aktualizací zůstávají; staré můžete odstranit volbou «Smazat starší než rok»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nichts zu löschen: Die Kopien, die gehen dürfen, sind schon weg. Kopien vor einem Update bleiben; die alten können Sie mit „Älter als ein Jahr löschen“ entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nothing to delete: the copies that may go are already gone. Copies made before an update stay; you can remove the old ones with «Delete older than a year»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que eliminar: las copias que podían irse ya no están. Las copias hechas antes de una actualización se quedan; puede quitar las antiguas con «Eliminar las de más de un año»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a rien à supprimer : les copies qui peuvent partir sont déjà parties. Les copies faites avant une mise à jour restent ; vous pouvez retirer les anciennes avec « Supprimer celles de plus d'un an »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջելու բան չկա․ թույլատրված բոլոր պատճեններն արդեն ջնջված են։ Թարմացումից առաջ ստեղծված պատճենները պահպանվում են․ հները կարող եք ջնջել «Ջնջել մեկ տարուց հին պատճենները» գործողությամբ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è nulla da eliminare: le copie eliminabili sono già state rimosse. Le copie create prima di un aggiornamento vengono conservate; puoi rimuovere quelle vecchie con «Elimina quelle più vecchie di un anno»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除できるコピーはすでに削除されています。アップデート前に作成したコピーは残ります。古いものは「1年より前のコピーを削除」で削除できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წასაშლელი არაფერია: ასლები, რომელთა წაშლაც შესაძლებელია, უკვე წაშლილია. განახლებამდე შექმნილი ასლები შენარჩუნდება; ძველების წაშლა შეგიძლიათ ბრძანებით «წელზე ძველის წაშლა»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоятын ештеңе жоқ: жойылуы мүмкін көшірмелер бұрыннан жоқ. Жаңартудан бұрын жасалған көшірмелер қалады; ескілерін «Бір жылдан ескісін жою» арқылы алып тастауға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өчүрө турган эч нерсе жок: өчүрүүгө мүмкүн болгон көчүрмөлөр эбак өчүрүлгөн. Жаңыртууга чейин түзүлгөн көчүрмөлөр сакталат; эскилерин «Бир жылдан эскилерин өчүрүү» аркылуу өчүрө аласыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets te verwijderen: de kopieën die weg mogen, zijn al verwijderd. Kopieën van vóór een update blijven behouden; oude kopieën kun je verwijderen met «Verwijder ouder dan een jaar»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma nic do usunięcia: kopie, które można usunąć, zostały już usunięte. Kopie sprzed uaktualnienia pozostają; starsze możesz usunąć za pomocą opcji «Usuń starsze niż rok»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada para apagar: as cópias que podem ser removidas já foram apagadas. As cópias feitas antes de uma atualização são mantidas; você pode apagar as antigas com «Apagar cópias com mais de um ano»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada para apagar: as cópias que podiam ser removidas já foram apagadas. As cópias criadas antes de uma atualização são mantidas; pode apagar as mais antigas com «Apagar cópias com mais de um ano»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалять нечего: копии, которые можно убрать, уже убраны. Копии «перед обновлением» остаются; старые можно убрать кнопкой «Удалить старше года»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чизе барои нест кардан нест: нусхаҳои нестшаванда аллакай нест шудаанд. Нусхаҳои пеш аз навсозӣ сохташуда мемонанд; нусхаҳои кӯҳнаро бо «Нест кардани нусхаҳои аз як сол кӯҳна» нест карда метавонед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinecek bir şey yok: silinebilecek kopyalar zaten silinmiş. Güncelleme öncesi oluşturulan kopyalar korunur; eskilerini «Bir Yıldan Eskileri Sil» ile silebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає що видаляти: усі придатні для видалення копії вже прибрано. Копії перед оновленнями залишаються; старі можна видалити через «Видалити старше року»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘chirish uchun hech narsa yo‘q: o‘chirilishi mumkin bo‘lgan nusxalar allaqachon o‘chirilgan. Yangilanishdan oldingi nusxalar saqlanadi; eskilarini «Bir yildan eskilarini o‘chirish» orqali o‘chirishingiz mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可删除的内容：可删除的副本已全部删除。更新前创建的副本会保留；你可以使用«删除超过一年的副本»移除旧副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可刪除的項目：可移除的副本均已刪除。更新前製作的副本會保留；你可以使用「刪除超過一年的副本」移除舊副本。"
          }
        }
      }
    },
    "backups.freeUp.stillLow": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra da 1 GB-dan az boş yer qalacaq və burada silinəcək başqa heç nə yoxdur. Yeniləmədən əvvəl yaradılmış nüsxələr saxlanılır; köhnələrini «Bir ildən köhnələri sil» ilə silə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нават пасля гэтага застанецца менш за 1 ГБ вольнага месца, а выдаляць тут больш няма чаго. Копіі перад абнаўленнем застаюцца; старыя можна выдаліць праз «Выдаліць старэйшыя за год»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I potom bude volné místo menší než 1 GB a další kopie zde už nelze smazat. Kopie vytvořené před aktualizací zůstávají; staré můžete odstranit volbou «Smazat starší než rok»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch dann wären weniger als 1 GB frei, und hier gibt es nichts mehr zu löschen. Kopien vor einem Update bleiben; die alten können Sie mit „Älter als ein Jahr löschen“ entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even then less than 1 GB will be free, and there is nothing more to delete here. Copies made before an update stay; you can remove the old ones with «Delete older than a year»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aun así quedará menos de 1 GB libre, y aquí no hay nada más que eliminar. Las copias hechas antes de una actualización se quedan; puede quitar las antiguas con «Eliminar las de más de un año»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même alors, moins de 1 Go sera libre, et il n'y a rien d'autre à supprimer ici. Les copies faites avant une mise à jour restent ; vous pouvez retirer les anciennes avec « Supprimer celles de plus d'un an »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նույնիսկ դրանից հետո 1 ԳԲ-ից քիչ ազատ տարածք կմնա, և այստեղ ջնջելու այլ բան չկա։ Թարմացումից առաջ ստեղծված պատճենները պահպանվում են․ հները կարող եք ջնջել «Ջնջել մեկ տարուց հին պատճենները» գործողությամբ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche dopo questa operazione resterà libero meno di 1 GB e non ci sarà altro da eliminare qui. Le copie create prima di un aggiornamento vengono conservate; puoi rimuovere quelle vecchie con «Elimina quelle più vecchie di un anno»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除後も空き容量は1 GB未満で、ここで削除できるものはほかにありません。アップデート前に作成したコピーは残ります。古いものは「1年より前のコピーを削除」で削除できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამის შემდეგაც 1 GB-ზე ნაკლები თავისუფალი ადგილი დარჩება და აქ მეტი წასაშლელი არაფერია. განახლებამდე შექმნილი ასლები შენარჩუნდება; ძველების წაშლა შეგიძლიათ ბრძანებით «წელზე ძველის წაშლა»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осыдан кейін де 1 ГБ-тан аз бос орын қалады, және мұнда жоятын ештеңе қалмады. Жаңартудан бұрын жасалған көшірмелер қалады; ескілерін «Бір жылдан ескісін жою» арқылы алып тастауға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошондо да 1 ГБдан аз бош орун калат жана бул жерде өчүрө турган башка эч нерсе жок. Жаңыртууга чейин түзүлгөн көчүрмөлөр сакталат; эскилерин «Бир жылдан эскилерин өчүрүү» аркылуу өчүрө аласыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook dan is er minder dan 1 GB vrij en kan hier niets meer worden verwijderd. Kopieën van vóór een update blijven behouden; oude kopieën kun je verwijderen met «Verwijder ouder dan een jaar»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet po usunięciu pozostanie mniej niż 1 GB wolnego miejsca i nie będzie tu już nic do usunięcia. Kopie sprzed uaktualnienia pozostają; starsze możesz usunąć za pomocą opcji «Usuń starsze niż rok»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo assim, haverá menos de 1 GB livre e não há mais nada para apagar aqui. As cópias feitas antes de uma atualização são mantidas; você pode apagar as antigas com «Apagar cópias com mais de um ano»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo assim, ficará menos de 1 GB livre e não há mais nada para apagar aqui. As cópias criadas antes de uma atualização são mantidas; pode apagar as mais antigas com «Apagar cópias com mais de um ano»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже после этого свободно останется меньше 1 ГБ, а удалять здесь больше нечего. Копии «перед обновлением» остаются; старые можно убрать кнопкой «Удалить старше года»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳатто баъд аз ин ҳам камтар аз 1 GB ҷойи холӣ мемонад ва дар ин ҷо чизи дигаре барои нест кардан нест. Нусхаҳои пеш аз навсозӣ сохташуда мемонанд; нусхаҳои кӯҳнаро бо «Нест кардани нусхаҳои аз як сол кӯҳна» нест карда метавонед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra bile 1 GB'tan az boş alan kalacak ve burada silinecek başka bir şey yok. Güncelleme öncesi oluşturulan kopyalar korunur; eskilerini «Bir Yıldan Eskileri Sil» ile silebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіть після цього залишиться менше 1 GB, а тут більше нічого видаляти. Копії перед оновленнями залишаються; старі можна видалити через «Видалити старше року»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shundan keyin ham 1 GB dan kam joy bo‘sh bo‘ladi va bu yerda o‘chirish uchun boshqa hech narsa yo‘q. Yangilanishdan oldingi nusxalar saqlanadi; eskilarini «Bir yildan eskilarini o‘chirish» orqali o‘chirishingiz mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使删除后，可用空间仍不足 1 GB，且此处没有更多可删除的内容。更新前创建的副本会保留；你可以使用«删除超过一年的副本»移除旧副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使如此，可用空間仍將少於 1 GB，且此處沒有其他可刪除的項目。更新前製作的副本會保留；你可以使用「刪除超過一年的副本」移除舊副本。"
          }
        }
      }
    },
