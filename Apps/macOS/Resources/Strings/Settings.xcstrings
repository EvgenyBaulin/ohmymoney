    "settings.planning.freeMoneyHorizonHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold back commitments for the next 30 days or until the nearest income. Future income is not added. With no upcoming income, use 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descuenta los compromisos de los próximos 30 días o hasta el ingreso más cercano. Los ingresos futuros no se suman. Si no hay ingresos próximos, se usan 30 días."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывать обязательства на ближайшие 30 дней или до ближайшего дохода. Будущие доходы не прибавляются. Если ближайшего дохода нет — 30 дней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервувати зобов'язання на наступні 30 днів або до найближчого доходу. Майбутній дохід не додається. Якщо доходу не очікується, використовується 30 днів."
          }
        }
      }
    },
