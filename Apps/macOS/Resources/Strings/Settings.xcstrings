    "backups.afterImport.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data came from an archive, and folders chosen on another Mac do not travel with it. Choose where copies of the backups go — for example, a folder in iCloud Drive. Until then the copies stay on this Mac only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные загружены из архива, а папки, выбранные на другом Mac, с ним не переносятся. Выберите, куда класть копии бэкапов, — например, папку в iCloud Drive. Пока она не выбрана, копии остаются только на этом Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані надійшли з архіву, а папки, вибрані на іншому Mac, не переносяться. Виберіть місце для резервних копій — наприклад, папку в iCloud Drive. Доти копії залишатимуться лише на цьому Mac."
          }
        }
      }
    },
    "backups.afterImport.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder for copies"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку для копий"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку для копій"
          }
        }
      }
    },
