    "settings.entry.order": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order of the fields in the ↓ panel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок полей в панели ↓"
          }
        }
      }
    },
    "settings.entry.orderHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a field up or down. The ↓ panel shows its fields in this order, and Tab moves through them in it. The type of the operation always stays on top; “Split”, “Paid for someone” and “On credit” stay at the bottom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите поле выше или ниже. В этом порядке панель ↓ показывает поля, и в нём же Tab переходит между ними. Тип операции всегда сверху, «Разделить», «За другого» и «В кредит» — внизу."
          }
        }
      }
    },
    "settings.entry.reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить"
          }
        }
      }
    },
    "settings.entry.returnHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return in the open ↓ panel saves the operation wherever the cursor is; in an open menu Return picks the item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Return в открытой панели ↓ сохраняет операцию, где бы ни был курсор; в открытом списке Return выбирает пункт."
          }
        }
      }
    },
    "settings.entry.style": {
      "extractionState": "manual",
      "localizations": {
