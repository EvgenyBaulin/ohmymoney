    "integrity.never": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ yoxlanılmayıb. Həftədə bir dəfə avtomatik yoxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Яшчэ не правяралася. Праверка адбываецца аўтаматычна раз на тыдзень."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nezkontrolováno. Kontrola probíhá automaticky jednou týdně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht geprüft. Sie wird einmal in der Woche von selbst geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not checked yet. It is checked by itself once a week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha comprobado. Se comprueba sola una vez por semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore vérifiée. Elle se vérifie toute seule une fois par semaine."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ չի ստուգվել։ Ավտոմատ ստուգվում է շաբաթը մեկ անգամ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora verificato. La verifica viene eseguita automaticamente una volta alla settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ確認されていません。週に1回自動的に確認されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არ შემოწმებულა. ავტომატურად მოწმდება კვირაში ერთხელ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әлі тексерілмеген. Апта сайын өздігінен тексеріледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча текшериле элек. Аптасына бир жолу автоматтык түрдө текшерилет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet gecontroleerd. De database wordt wekelijks automatisch gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie sprawdzono. Baza jest sprawdzana automatycznie raz w tygodniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não verificado. A verificação ocorre automaticamente uma vez por semana."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não verificado. A verificação é automática, uma vez por semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё не проверялась. Сама проверяется раз в неделю."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз санҷида нашудааст. Санҷиш ҳар ҳафта худкор анҷом мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz denetlenmedi. Haftada bir otomatik olarak denetlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще не перевірено. Автоматична перевірка — раз на тиждень."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
