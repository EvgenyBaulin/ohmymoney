    "report.readme.why": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal is written so that none of this gets into it: a value in a line of the journal has a type, and none of its kinds is money, a name or a title. A test checks it on a database of known values."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diario se escribe de forma que nada de esto entre en él: un valor de una línea del diario tiene un tipo, y ninguno de sus tipos es dinero, un nombre o un título. Una prueba lo comprueba sobre una base de datos de valores conocidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал пишется так, что перечисленного в него не попадает: у значения в строке журнала есть тип, и среди его видов нет ни денег, ни имени, ни названия. Это проверяется тестом на базе с заведомыми значениями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал побудовано так, щоб ці дані до нього не потрапляли: значення в рядку журналу має тип, серед яких немає грошей, імені чи назви. Тест перевіряє це на базі з відомими значеннями."
          }
        }
      }
    },
