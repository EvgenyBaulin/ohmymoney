        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубльге бағам: банктің кестесі әлі жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Рублга карата курс: банктын таблицасы азырынча жок"
