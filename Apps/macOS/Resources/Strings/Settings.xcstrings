        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նպատակների գումարը հաշվառված է ամփոփման հաշիվներում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risparmi per gli obiettivi sono su conti nel riepilogo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標の積立金を集計対象の口座で管理"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიზნების თანხა მიმოხილვის ანგარიშებზეა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат ақшасы жиынтықтағы шоттарда"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Максаттардын акчасы серептеги эсептерде сакталат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doelgeld staat op rekeningen in het overzicht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środki na cele są na kontach w zestawieniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro das metas está nas contas do resumo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro dos objetivos está em contas no resumo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги целей лежат на счетах в сводке"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ҳадафҳо дар ҳисобҳои шарҳи умумӣ аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef parası özetteki hesaplarda tutuluyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші цілей лежать на рахунках у підсумку"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maqsad pullari umumiy ko‘rinishdagi hisoblarda saqlanadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标资金存放在摘要中的账户里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標資金存於摘要中的帳戶"
          }
        }
      }
    },
    "settings.planning.includesGoalsHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv olduqda, məqsədlərə ayrılmış pul «Xərcləmək olar» məbləğindən çıxılır. Məqsəd pulu icmaldan kənar hesabda saxlanılırsa, söndürün."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі ўключана, сума «Можна выдаткаваць» не ўключае грошы, ужо адкладзеныя на мэты. Выключыце, калі грошы на мэты захоўваюцца на рахунку па-за аглядам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je-li volba zapnutá, částka k útratě nezahrnuje peníze vložené do cílů. Vypněte ji, pokud jsou peníze na cíle na účtu mimo přehled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeschaltet lässt „Kann ausgegeben werden“ das bereits in Ziele gelegte Geld weg. Ausschalten, wenn das Zielgeld auf einem Konto außerhalb der Übersicht liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, «can spend» leaves out the money already put into goals. Turn it off when goal money is kept on an account outside the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado, «se puede gastar» no incluye el dinero ya aportado a objetivos. Desactívelo cuando el dinero de los objetivos se guarde en una cuenta fuera del resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé, « peut dépenser » exclut l'argent déjà mis dans les objectifs. Désactivez quand l'argent des objectifs est gardé sur un compte hors du récapitulatif."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացված լինելու դեպքում նպատակներին արդեն հատկացված գումարը չի ներառվում «Կարելի է ծախսել» գումարում։ Անջատեք, եթե նպատակների գումարը պահվում է ամփոփումից դուրս գտնվող հաշվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, «Disponibile da spendere» esclude i risparmi già destinati agli obiettivi. Disattivalo se sono su un conto fuori dal riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、目標に積み立てた金額を「使えるお金」から差し引きます。集計対象外の口座で管理している場合はオフにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართვისას მიზნებში უკვე გადადებული თანხა არ შედის დასახარჯ თანხაში. გამორთეთ, თუ მიზნების თანხა მიმოხილვის გარეთ არსებულ ანგარიშზე ინახება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосулы болса, «жұмсауға болады» сомасына мақсаттарға салынған ақша кірмейді. Мақсат ақшасы жиынтыққа кірмейтін шотта болса, өшіріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күйгүзүлгөндө, максаттарга бөлүнгөн акча «Сарптоого болот» суммасынан чыгарылат. Максаттардын акчасы серепке кирбеген эсепте сакталса, өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit aanstaat, wordt geld dat al voor doelen is gereserveerd niet meegeteld bij «vrij te besteden». Zet dit uit als doelgeld op een rekening buiten het overzicht staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy opcja jest włączona, środki odłożone na cele są wyłączone z kwoty dostępnej do wydania. Wyłącz ją, jeśli środki na cele są na koncie poza zestawieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, «pode gastar» exclui o dinheiro já destinado a metas. Desative quando o dinheiro das metas estiver em uma conta fora do resumo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, «Pode gastar» exclui o dinheiro já colocado em objetivos. Desative se o dinheiro dos objetivos estiver numa conta fora do resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, «можно тратить» не считает деньги, уже отложенные на цели. Выключите, если деньги целей лежат на счёте вне сводки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми фаъол будан, маблағи аллакай ба ҳадафҳо гузошташуда аз «Барои харҷ дастрас» хориҷ мешавад. Агар маблағи ҳадафҳо дар ҳисоби берун аз шарҳи умумӣ бошад, хомӯш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken hedeflere ayrılmış para «Harcanabilir» tutarına katılmaz. Hedef parası özet dışındaki bir hesapta tutuluyorsa kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ввімкнено, «Можна витрачати» не враховує вже відкладені на цілі гроші. Вимкніть, якщо гроші цілей зберігаються на рахунку поза підсумком."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoqilganda, maqsadlarga ajratilgan pul «Sarflash mumkin» summasiga kirmaydi. Maqsad puli umumiy ko‘rinishga kirmaydigan hisobda saqlansa, o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，“可支配金额”不包含已存入目标的资金。如果目标资金存放在摘要以外的账户中，请关闭此项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，「可支出」不含已存入目標的金額。若目標資金存於摘要以外的帳戶，請關閉此選項。"
          }
        }
      }
    },
