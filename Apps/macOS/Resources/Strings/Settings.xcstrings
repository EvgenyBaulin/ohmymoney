    "names.other.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Іншыя варыянты гэтай назвы для радка ўводу. Напрыклад: Starbucks — sbux, starbs."
