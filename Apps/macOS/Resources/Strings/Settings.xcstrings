        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Киреше бөлүштүрүлгөндө салык ушул эсепке которулат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het verdelen van inkomsten wordt de belasting naar deze rekening overgeboekt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podział przychodu przenosi podatek na to konto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A distribuição de uma receita transfere o imposto para esta conta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A distribuição de um rendimento transfere o imposto para esta conta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распределение дохода переводит налог на этот счёт"
