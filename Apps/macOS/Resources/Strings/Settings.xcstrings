    "settings.entry.returnHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return in the open ↓ panel saves the operation wherever the cursor is; in an open menu Return picks the item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intro en el panel ↓ abierto guarda la operación donde esté el cursor; en un menú abierto, Intro elige el elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour dans le panneau ↓ ouvert enregistre l'opération où que se trouve le curseur ; dans un menu ouvert, Retour choisit l'élément."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Return в открытой панели ↓ сохраняет операцию, где бы ни был курсор; в открытом списке Return выбирает пункт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Return на відкритій панелі ↓ зберігає операцію незалежно від положення курсора; у відкритому меню Return вибирає пункт."
          }
        }
      }
    },
