    "references.usage.used": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкарыстоўваецца ў %@, у тым ліку ў кошыку. Выдаліць нельга: аб’яднайце з іншым запісам або перанясіце ў архіў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genutzt von %@, auch im Papierkorb. Er kann nicht gelöscht werden: Führen Sie ihn mit einem anderen Eintrag zusammen oder legen Sie ihn ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by %@, the bin included. It cannot be deleted: merge it into another record or put it in the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo usa %@, también la papelera. No se puede eliminar: fusiónelo con otro registro o pásela al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé par %@, corbeille comprise. Il ne peut pas être supprimé : fusionnez-le avec un autre enregistrement ou mettez-le aux archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato da %@, inclusi gli elementi nel cestino. Non può essere eliminato: uniscilo a un altro elemento o archivialo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ қолданады, себеттегілерді қоса алғанда. Жоюға болмайды: басқа жазбамен біріктіріңіз немесе мұрағаттаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używana przez: %@, również w koszu. Nie można jej usunąć: scal ją z inną pozycją lub zarchiwizuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em uso por %@, incluindo a lixeira. Não pode ser apagado: mescle com outro registro ou arquive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется: %@ — корзина тоже считается. Удалить нельзя: можно объединить с другой записью или убрать в архив."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarafından kullanılıyor, çöp kutusundakiler dahil. Silinemez: başka bir kayıtla birleştirin veya arşivleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується в %@, зокрема в кошику. Не можна видалити: об'єднайте з іншим записом або архівуйте."
          }
        }
      }
    },
    "references.yearly": {
