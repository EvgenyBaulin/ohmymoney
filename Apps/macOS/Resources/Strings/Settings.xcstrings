    "settings.planning.savingsTarget": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hədəf yığım payı: %lld%%"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мэтавая доля зберажэнняў: %lld%%"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cílový podíl úspor: %lld%%"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zielanteil der Ersparnisse: %lld %%"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target savings share: %lld%%"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte objetivo de ahorro: %lld%%"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part d'épargne visée : %lld%%"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խնայողությունների նպատակային բաժինը՝ %lld%%"
          }
        },
        "it": {
