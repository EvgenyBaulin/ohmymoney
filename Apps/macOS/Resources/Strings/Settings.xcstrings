    "references.usage.used": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tərəfindən istifadə olunur, səbətdəkilər də daxil olmaqla. Silmək olmaz: başqa qeydlə birləşdirin və ya arxivə atın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкарыстоўваецца ў %@, у тым ліку ў кошыку. Выдаліць нельга: аб’яднайце з іншым запісам або перанясіце ў архіў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá se v: %@, včetně koše. Nelze ho smazat: slučte ho s jiným záznamem nebo ho archivujte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genutzt von %@, auch im Papierkorb. Er kann nicht gelöscht werden: Führen Sie ihn mit einem anderen Eintrag zusammen oder legen Sie ihn ins Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by %@, the bin included. It cannot be deleted: merge it into another record or put it in the archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo usa %@, también la papelera. No se puede eliminar: fusiónelo con otro registro o pásela al archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé par %@, corbeille comprise. Il ne peut pas être supprimé : fusionnez-le avec un autre enregistrement ou mettez-le aux archives."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգտագործվում է՝ %@, ներառյալ աղբարկղը։ Հնարավոր չէ ջնջել․ միավորեք մեկ այլ գրառման կամ արխիվացրեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato da %@, inclusi gli elementi nel cestino. Non può essere eliminato: uniscilo a un altro elemento o archivialo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で使用されています（ゴミ箱内を含む）。削除するには、別の項目に統合するか、アーカイブしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოიყენება: %@, ურნის ჩათვლით. მისი წაშლა შეუძლებელია: გააერთიანეთ სხვა ჩანაწერთან ან გადაიტანეთ არქივში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ қолданады, себеттегілерді қоса алғанда. Жоюға болмайды: басқа жазбамен біріктіріңіз немесе мұрағаттаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ колдонот, анын ичинде таштандыдагылар да бар. Өчүрүүгө болбойт: башка жазуу менен бириктириңиз же архивдеңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt door %@, inclusief de prullenmand. Verwijderen is niet mogelijk. Voeg het samen met een ander record of archiveer het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używana przez: %@, również w koszu. Nie można jej usunąć: scal ją z inną pozycją lub zarchiwizuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em uso por %@, incluindo a lixeira. Não pode ser apagado: mescle com outro registro ou arquive."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado por %@, incluindo no lixo. Não pode ser apagado: combine-o com outro registo ou arquive-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется: %@ — корзина тоже считается. Удалить нельзя: можно объединить с другой записью или убрать в архив."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар %@ истифода мешавад, аз ҷумла дар сабад. Онро нест кардан мумкин нест: бо сабти дигар якҷо кунед ё ба бойгонӣ гузоред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarafından kullanılıyor, çöp kutusundakiler dahil. Silinemez: başka bir kayıtla birleştirin veya arşivleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується в %@, зокрема в кошику. Не можна видалити: об'єднайте з іншим записом або архівуйте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyidagilarda ishlatiladi: %@, jumladan savatdagilarda. Uni o‘chirib bo‘lmaydi: boshqa yozuvga birlashtiring yoki arxivlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由%@使用，包括废纸篓中的项目。无法删除：请将其合并到另一条记录或归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 %@ 使用，包括垃圾桶內的項目。無法刪除；請合併至其他記錄或封存。"
          }
        }
      }
    },
