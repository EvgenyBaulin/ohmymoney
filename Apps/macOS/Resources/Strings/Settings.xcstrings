          "stringUnit": {
            "state": "translated",
            "value": "Bloku istədiyiniz yerə sürüşdürün. Bu sıra köçürmə arxivi ilə digər Mac-a da köçürülür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перацягніце блок на патрэбнае месца. Парадак пераносіцца на іншы Mac разам з архівам пераносу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte blok na požadované místo. Pořadí se přenese na jiný Mac spolu s přenosovým archivem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Block auf den Platz, den er einnehmen soll. Die Reihenfolge wandert mit dem Übertragungsarchiv auf einen anderen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a block onto the place it should take. The order moves to another Mac with the transfer archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un bloque al lugar que debe ocupar. El orden se traslada a otro Mac con el archivo de traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un bloc à la place qu'il doit occuper. L'ordre voyage vers un autre Mac avec l'archive de transfert."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քաշեք բլոկը ցանկալի տեղը։ Հերթականությունը փոխանցման արխիվով կտեղափոխվի մյուս Mac։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un blocco nella posizione desiderata. L’ordine viene trasferito a un altro Mac con l’archivio di trasferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックを目的の位置にドラッグします。順序は移行アーカイブで別のMacに引き継がれます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაათრიეთ ბლოკი სასურველ ადგილზე. რიგი გადატანის არქივთან ერთად სხვა Mac-ზეც გადავა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокты қалаған орнына сүйреңіз. Реті тасымалдау мұрағатымен басқа Mac құрылғысына көшеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокту керектүү орунга сүйрөңүз. Ирет көчүрүү архиви менен башка Mac'ка да өтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een blok naar de gewenste plek. De volgorde gaat met het overdrachtsarchief mee naar een andere Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij blok w wybrane miejsce. Kolejność jest przenoszona na inny Mac w archiwum transferowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um bloco para a posição desejada. A ordem é transferida para outro Mac com o arquivo de transferência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um bloco para a posição pretendida. A ordem é transferida para outro Mac com o arquivo de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите блок на место, которое он должен занять. Порядок переезжает на другой Mac вместе с архивом переноса."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокро ба ҷои дилхоҳ кашед. Тартиб бо бойгонии интиқол ба Mac-и дигар мегузарад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bloğu istediğiniz yere sürükleyin. Sıralama, aktarım arşiviyle başka bir Mac'e taşınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть блок на потрібне місце. Порядок переноситься на інший Mac з архівом перенесення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokni kerakli joyga torting. Tartib ko‘chirish arxivi bilan boshqa Mac’ga o‘tadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将区块拖移到所需位置。此顺序会随传输归档转移到另一台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將區塊拖移至所需位置。此順序會隨轉移封存檔移至另一部 Mac。"
          }
        }
      }
    },
