    "settings.planning.cushionOut": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehtiyat fondunu sərbəst məbləğə daxil etmə"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўключаць падушку ў свабодную суму"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezahrnovat rezervu do volné částky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Polster aus dem freien Betrag heraushalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the cushion out of the free sum"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar el colchón fuera de la suma libre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclure le matelas de la somme libre"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահուստը չներառել ազատ գումարում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escludi la riserva dalla somma disponibile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "備えを自由に使える金額から除外"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბალიშის გამოკლება თავისუფალი თანხიდან"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорды бос сомаға қоспау"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Корду бош суммадан алып салуу"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de buffer buiten het vrije bedrag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz poduszkę z wolnej kwoty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir a reserva do valor livre"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir a reserva do montante disponível"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не считать подушку в свободной сумме"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Захираро ба маблағи озод дохил накардан"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik yastığını kullanılabilir tutarın dışında tut"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не включати подушку до вільної суми"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaxirani erkin summaga kiritmaslik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从可用金额中排除应急储备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從可用金額中排除預備金"
          }
        }
      }
    },
    "settings.planning.cushionOutHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Standart olaraq aktivdir. Xülasədə ehtiyat fondunun pulu sərbəst məbləğdən çıxılır. Onu daxil etmək üçün söndürün."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключана па змаўчанні. Грошы падушкі ў зводцы не ўваходзяць у свабодную суму. Выключыце, каб уключыць іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím stavu zapnuto. Peníze v rezervě se v přehledu nezapočítávají do volné částky. Vypnutím je zahrnete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig eingeschaltet. Das Geld des Polsters in der Übersicht wird vom freien Betrag zurückgehalten. Ausschalten, um es einzurechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. The cushion money in the summary is held back from the free sum. Turn off to include it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto. El dinero del colchón del resumen se descuenta de la suma libre. Desactívelo para incluirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut. L'argent du matelas dans le récapitulatif est mis de côté pour la somme libre. Désactivez pour l'y inclure."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լռելյայն միացված է։ Ամփոփման մեջ պահուստի գումարը հանվում է ազատ գումարից։ Անջատեք՝ այն ներառելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo di default. Nel riepilogo, il denaro della riserva viene escluso dalla somma disponibile. Disattiva per includerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでオンです。概要の備えの金額は自由に使える金額から除外されます。含めるにはオフにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაგულისხმევად ჩართულია. შეჯამებაში ბალიშის თანხა თავისუფალ თანხას აკლდება. მის ჩასათვლელად გამორთეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдепкіде қосулы. Жиынтықтағы қор ақшасы бос сомадан алынады. Қосу үшін өшіріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Демейки боюнча күйүк. Кордогу акча жыйынтыктагы бош суммага кошулбайт. Кошуу үчүн өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard ingeschakeld. De buffer in het overzicht wordt buiten het vrije bedrag gehouden. Schakel uit om deze mee te tellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie włączone. Środki poduszki w podsumowaniu są wyłączone z wolnej kwoty. Wyłącz, aby je uwzględnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por padrão. O dinheiro da reserva no resumo é descontado do valor livre. Desative para incluí-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por predefinição. O dinheiro da reserva no resumo é excluído do montante disponível. Desative para o incluir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию включено. Деньги подушки в сводке вычитаются из свободной суммы. Выключите, чтобы учитывать их как свободные."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо нобаёнӣ фаъол аст. Маблағи захира дар ҷамъбаст аз маблағи озод ҷудо нигоҳ дошта мешавад. Барои дохил кардани он хомӯш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saptanmış olarak açıktır. Özetteki güvenlik yastığı parası kullanılabilir tutara katılmaz. Dahil etmek için kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово ввімкнено. Гроші подушки в підсумку утримуються з вільної суми. Вимкніть, щоб ураховувати їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukut bo‘yicha yoqilgan. Umumiy ko‘rinishda zaxira puli erkin summadan chiqariladi. Uni kiritish uchun o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认开启。摘要中的应急储备不会计入可用金额。关闭后将其计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設開啟。摘要中的預備金不計入可用金額。關閉以將其計入。"
          }
        }
      }
    },
