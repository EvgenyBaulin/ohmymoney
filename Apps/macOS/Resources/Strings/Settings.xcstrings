    "settings.planning.cushionHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehtiyat fondunun hesabları və hədəfi «Kapital» bölməsində, zəruri kateqoriyalar isə orada və ya Kateqoriyalarda seçilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахункі падушкі і яе мэта задаюцца ў раздзеле «Капітал»; неабходныя катэгорыі — там жа або ў катэгорыях."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účty rezervy a její cíl nastavíte v části «Kapitál»; nutné kategorie tamtéž nebo v kategoriích."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konten des Polsters und sein Ziel werden unter „Kapital“ festgelegt; notwendige Kategorien dort oder unter Kategorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accounts of the cushion and its goal are set on «Capital»; essential categories — there or in Categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas del colchón y su objetivo se fijan en «Capital»; las categorías esenciales, ahí o en Categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes du matelas et son objectif se règlent dans « Capital » ; les catégories essentielles, là-bas ou dans Catégories."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահուստի հաշիվներն ու նպատակը սահմանվում են «Կապիտալ» բաժնում, իսկ անհրաժեշտ կատեգորիաները՝ այնտեղ կամ «Կատեգորիաներ» բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I conti della riserva e il suo obiettivo si impostano in «Capitale»; le categorie essenziali si impostano lì o in Categorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "備えに使う口座と目標額は「資産」で設定します。必要なカテゴリは「資産」または「カテゴリ」で設定します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბალიშის ანგარიშები და მიზანი განისაზღვრება «კაპიტალში»; აუცილებელი კატეგორიები — იქვე ან კატეგორიებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қор шоттары мен мақсаты «Капитал» бөлімінде; қажетті санаттар сонда немесе Санаттарда беріледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кордун эсептери жана максаты «Капитал» бөлүмүндө; зарыл категориялар ошол жерде же Категорияларда коюлат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rekeningen en het doel van de buffer stel je in onder «Vermogen»; noodzakelijke categorieën daar of in Categorieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konta poduszki i jej cel ustawisz w sekcji «Kapitał»; niezbędne kategorie — tam lub w Kategoriach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As contas da reserva e sua meta são definidas em «Capital»; as categorias essenciais, lá ou em Categorias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As contas da reserva e o respetivo objetivo são definidos em «Capital»; as categorias essenciais, aí ou em Categorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета подушки и её цель — в «Капитале»; необходимые категории — там же или в «Категориях»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобҳои захира ва ҳадафи он дар «Сармоя» танзим мешаванд; категорияҳои зарурӣ — дар он ҷо ё дар Категорияҳо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik yastığının hesapları ve hedefi «Sermaye» bölümünde; zorunlu kategoriler ise orada veya Kategoriler'de ayarlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки подушки та її ціль задаються в «Капіталі»; необхідні категорії — там або в категоріях."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaxira hisoblari va uning maqsadi «Kapital»da, zarur toifalar esa o‘sha yerda yoki Toifalarda belgilanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 «资产» 中设置应急储备的账户和目标；必要支出类别可在此处或“类别”中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預備金帳戶和目標可在「資產」中設定；必要支出類別可在該處或「類別」中設定。"
          }
        }
      }
    },
