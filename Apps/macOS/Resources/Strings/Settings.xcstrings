    "categories.delete.free": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» нідзе не выкарыстоўваецца. ⌘Z верне яе назад."
          }
        },
