    "settings.planning.goalValuationHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At today's rate — when the goal's money is kept in its currency. At the rates of the contributions — when it is kept in rubles: each contribution counts with the rubles of its day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По сегодняшнему курсу — если деньги цели лежат в её валюте. По курсу взносов — если они лежат в рублях: каждый взнос считается рублями своего дня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За сьогоднішнім курсом — коли гроші цілі зберігаються в її валюті. За курсами внесків — коли в рублях: кожен внесок враховується в рублях свого дня."
          }
        }
      }
    },
