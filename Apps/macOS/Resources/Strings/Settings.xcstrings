    },
    "backups.failure.folderNotRemembered": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş qovluğu yadda saxlamaq mümkün olmadı, buna görə nüsxələr ora göndərilmir. Başqa qovluq seçin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запомніць выбраную папку, таму копіі ў яе не захоўваюцца. Выберыце іншую папку"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybranou složku se nepodařilo zapamatovat, takže se do ní kopie neukládají. Vyberte jinou složku"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Ordner konnte nicht gemerkt werden, daher gehen Kopien nicht dorthin. Wählen Sie einen anderen Ordner"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen folder could not be remembered, so copies do not go there. Choose another folder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo recordar la carpeta elegida, así que las copias no van allí. Elija otra carpeta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier choisi n'a pas pu être retenu, donc les copies n'y vont pas. Choisissez un autre dossier"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց հիշել ընտրված պանակը, ուստի պատճենները չեն ուղարկվում այնտեղ։ Ընտրեք մեկ այլ պանակ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile memorizzare la cartella scelta, quindi le copie non vengono salvate lì. Scegli un’altra cartella"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダを保存できなかったため、コピーはそこに保存されません。別のフォルダを選択してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არჩეული საქაღალდის დამახსოვრება ვერ მოხერხდა, ამიტომ ასლები იქ არ გადაიგზავნება. აირჩიეთ სხვა საქაღალდე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған қалтаны есте сақтау мүмкін болмады, сондықтан көшірмелер сонда бармайды. Басқа қалтаны таңдаңыз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тандалган папканы эстеп калуу мүмкүн болгон жок, андыктан көчүрмөлөр ал жакка сакталбайт. Башка папканы тандаңыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gekozen map kon niet worden onthouden. Kopieën worden daar niet bewaard. Kies een andere map"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można było zapamiętać wybranego folderu, więc kopie nie są w nim zapisywane. Wybierz inny folder"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a pasta escolhida, por isso as cópias não são enviadas para ela. Escolha outra pasta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a pasta escolhida, pelo que as cópias não são enviadas para lá. Escolha outra pasta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранную папку не удалось запомнить, поэтому копии туда не идут. Выберите другую папку"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷузвдони интихобшударо дар хотир нигоҳ дошта нашуд, аз ин рӯ нусхаҳо ба он фиристода намешаванд. Ҷузвдони дигарро интихоб кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasör hatırlanamadı, bu yüzden kopyalar oraya kaydedilmiyor. Başka bir klasör seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запам'ятати вибрану папку, тому копії туди не потрапляють. Виберіть іншу папку"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlangan jildni eslab qolib bo‘lmadi, shuning uchun nusxalar u yerga yuborilmaydi. Boshqa jildni tanlang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法记住选定的文件夹，副本不会存入该文件夹。请选择其他文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法記住所選檔案夾，因此副本不會儲存到該處。請選擇其他檔案夾"
          }
        }
      }
    },
    "backups.failure.mirrorUnavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş qovluğu açmaq mümkün deyil. Onu yenidən seçin, əks halda nüsxələr ora göndərilməyəcək"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося адкрыць выбраную папку. Выберыце яе зноў, інакш копіі не будуць у яе захоўвацца"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybranou složku nelze otevřít. Vyberte ji znovu, jinak se do ní kopie neuloží"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Ordner kann nicht geöffnet werden. Wählen Sie ihn erneut, sonst erreichen Kopien ihn nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen folder cannot be opened. Choose it again, or copies will not reach it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir la carpeta elegida. Elíjala de nuevo, o las copias no llegarán a ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier choisi ne peut pas être ouvert. Choisissez-le à nouveau, sinon les copies ne l'atteindront pas"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հնարավոր չէ բացել ընտրված պանակը։ Կրկին ընտրեք այն, այլապես պատճենները չեն հասնի այնտեղ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la cartella scelta. Sceglila di nuovo, altrimenti le copie non verranno salvate lì"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダを開けません。選択し直さないと、コピーはそこに保存されません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არჩეული საქაღალდის გახსნა შეუძლებელია. აირჩიეთ ის ხელახლა, წინააღმდეგ შემთხვევაში ასლები იქ არ გადაიგზავნება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған қалтаны ашу мүмкін емес. Оны қайта таңдаңыз, әйтпесе көшірмелер сонда жетпейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тандалган папканы ачуу мүмкүн эмес. Аны кайра тандаңыз, болбосо көчүрмөлөр ал жакка сакталбайт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gekozen map kan niet worden geopend. Kies deze opnieuw, anders worden kopieën daar niet bewaard"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć wybranego folderu. Wybierz go ponownie, aby kopie mogły być w nim zapisywane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir a pasta escolhida. Escolha-a novamente para que as cópias sejam enviadas para ela"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível abrir a pasta escolhida. Escolha-a novamente, caso contrário as cópias não serão enviadas para lá"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная папка не открывается. Выберите её заново — иначе копии туда не попадут"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҷузвдони интихобшударо кушода намешавад. Онро аз нав интихоб кунед, вагарна нусхаҳо ба он намерасанд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasör açılamıyor. Klasörü yeniden seçin, aksi takdirde kopyalar oraya kaydedilmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана папка не відкривається. Виберіть її знову, інакше копії туди не потраплять"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlangan jildni ochib bo‘lmadi. Uni qayta tanlang, aks holda nusxalar u yerga yetib bormaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开选定的文件夹。请重新选择，否则副本将无法存入该文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟所選檔案夾。請重新選擇，否則副本將無法儲存到該處"
          }
        }
      }
    },
