        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar a cópia. Nada foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить копию. Ничего не заменено."
