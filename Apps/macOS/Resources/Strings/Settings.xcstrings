    "names.other.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adı daxiletmə sətrində yazdığınız digər formalar. Məsələn: Starbucks — sbux, starbs."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Іншыя варыянты гэтай назвы для радка ўводу. Напрыклад: Starbucks — sbux, starbs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další podoby názvu, které zadáváte do řádku pro zadávání. Například: Starbucks — sbux, starbs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Arten, wie Sie diesen Namen in der Eingabezeile tippen. Zum Beispiel: Starbucks — sbux, starbs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other ways you type this name in the entry line. For example: Starbucks — sbux, starbs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras formas de escribir este nombre en la línea de entrada. Por ejemplo: Starbucks — sbux, starbs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'autres façons de taper ce nom dans la ligne de saisie. Par exemple : Starbucks — sbux, starbs."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անվան այլ տարբերակները, որոնք մուտքագրում եք գրառման տողում։ Օրինակ՝ Starbucks — sbux, starbs։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altri modi in cui inserisci questo nome. Per esempio: Starbucks — sbux, starbs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄で使う別の名前。例: Starbucks — sbux、starbs。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ სახელის სხვა ფორმები, რომლებსაც შეყვანის ველში იყენებთ. მაგალითად: Starbucks — sbux, starbs."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Енгізу жолында осы атауды жазудың басқа нұсқалары. Мысалы: Starbucks — sbux, starbs."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул атты киргизүү сабында жазуунун башка жолдору. Мисалы: Starbucks — sbux, starbs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere manieren waarop je deze naam in het invoerveld typt. Bijvoorbeeld: Starbucks — sbux, starbs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne sposoby wpisywania tej nazwy w polu wprowadzania. Na przykład: Starbucks — sbux, starbs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras formas de digitar este nome no campo de entrada. Por exemplo: Starbucks — sbux, starbs."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras formas de escrever este nome na linha de introdução. Por exemplo: Starbucks — sbux, starbs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как ещё вы пишете это название в строке ввода. Например: Пятёрочка — пятёрка, 5ка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаклҳои дигари ворид кардани ин ном дар сатри воридкунӣ. Масалан: Starbucks — sbux, starbs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adı giriş satırında yazarken kullandığınız diğer adlar. Örneğin: Starbucks — sbux, starbs."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші способи введення цієї назви в рядку вводу. Наприклад: Starbucks — sbux, starbs."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiritish satrida bu nomni yozishning boshqa usullari. Masalan: Starbucks — sbux, starbs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输入栏中输入此名称的其他方式。例如：Starbucks — sbux、starbs。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入欄中輸入此名稱的其他方式。例如：Starbucks — sbux、starbs。"
          }
        }
      }
