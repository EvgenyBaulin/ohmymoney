      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One file to hand over when something breaks. It holds the journal, versions and counts — never amounts, names or descriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo archivo para entregar cuando algo se rompe. Contiene el diario, versiones y recuentos — nunca importes, nombres ni descripciones."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один файл, который можно отдать на разбор, когда что-то сломалось. В нём журнал, версии и количества — и никогда суммы, имена или описания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один файл, який можна передати, коли щось не працює. Містить журнал, версії й лічильники — без сум, імен та описів."
          }
        }
      }
    },
    "report.interrupted": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session before this one did not end: the application was stopped or it crashed. A problem report will say what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión anterior no terminó: la aplicación se detuvo o se cayó. Un informe del problema dirá qué pasó."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс перед этим не завершился: приложение остановили или оно упало. Отчёт о проблеме покажет, что случилось."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередній сеанс не завершився: застосунок зупинено або стався збій. Звіт про проблему пояснить, що сталося."
          }
        }
      }
    },
