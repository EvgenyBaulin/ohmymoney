    "settings.planning.listLengthHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payments, subscriptions, expected incomes and goals show the nearest first and the rest behind «Show all». A block can set its own number in its header."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagos, suscripciones, ingresos previstos y objetivos muestran primero los más cercanos y el resto tras «Mostrar todo». Un bloque puede poner su propio número en su cabecera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements, abonnements, revenus attendus et objectifs montrent d'abord les plus proches, et le reste derrière « Tout afficher ». Un bloc peut régler son propre nombre dans son en-tête."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежи, подписки, поступления и цели показывают ближайшие, остальные — за «Показать все». Блок может задать своё число в своём заголовке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежі, підписки, очікувані доходи й цілі показують найближче, а решту — за «Показати все». Кожен блок може мати власну кількість у заголовку."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлемдер, жазылымдар, күтілетін кірістер мен мақсаттар алдымен ең жақынын көрсетеді, қалғаны «Барлығын көрсету» артында. Әр блоктың тақырыбында өз санын қоюға болады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen, Abos, erwartete Einnahmen und Ziele zeigen die nächsten zuerst und den Rest hinter „Alle anzeigen“. Ein Block kann seine eigene Zahl in seiner Kopfzeile setzen."
          }
        }
      }
    },
