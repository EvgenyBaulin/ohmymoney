    "settings.privacy.lockRefused": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пацверджана — блакіроўка застаецца выключанай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht bestätigt — die Sperre bleibt aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not confirmed — the lock stays off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No confirmado — el bloqueo sigue desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non confirmé — le verrou reste désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non confermato: il blocco resta disattivato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Расталмады — құлып өшірулі қалады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie potwierdzono — blokada pozostaje wyłączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não confirmado — o bloqueio continua desativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не подтверждено — блокировка не включена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmadı; kilit kapalı kalacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не підтверджено — блокування залишається вимкненим."
          }
        }
      }
    },
    "settings.privacy.lockUnavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На гэтым Mac няма ні Touch ID, ні пароля ўваходу — уключыць блакіроўку немагчыма."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat weder Touch ID noch ein Anmeldepasswort — die Sperre kann nicht eingeschaltet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has neither Touch ID nor a login password — the lock cannot be turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene ni Touch ID ni contraseña de inicio de sesión — el bloqueo no se puede activar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n'a ni Touch ID ni mot de passe de session — le verrou ne peut pas être activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non dispone di Touch ID né di una password di accesso: non è possibile attivare il blocco."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл Mac құрылғысында Touch ID де, кіру құпиясөзі де жоқ — құлыпты қосу мүмкін емес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie ma Touch ID ani hasła logowania — nie można włączyć blokady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não tem Touch ID nem senha de início de sessão — o bloqueio não pode ser ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Mac нет ни Touch ID, ни пароля для входа — блокировку не включить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te Touch ID veya giriş parolası yok; kilit açılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому Mac немає ні Touch ID, ні пароля входу — блокування неможливо ввімкнути."
          }
        }
      }
    },
    "settings.privacy.noPassword": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зададзены — для разблакіроўкі выкарыстоўваюцца Touch ID і пароль Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht festgelegt — Touch ID und das Passwort des Mac öffnen die Sperre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set — Touch ID and the password of the Mac open the lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin fijar — Touch ID y la contraseña del Mac abren el bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non défini — Touch ID et le mot de passe du Mac ouvrent le verrou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non impostata: usa Touch ID o la password del Mac per sbloccare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орнатылмаған — құлыпты Touch ID және Mac құпиясөзі ашады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono — blokadę można otworzyć za pomocą Touch ID lub hasła Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não definida — o Touch ID e a senha do Mac desbloqueiam o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не задан — блокировку открывают Touch ID и пароль Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlanmadı; kilit Touch ID ve Mac parolasıyla açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не задано — блокування відкривається через Touch ID і пароль Mac."
          }
        }
      }
    },
    "settings.privacy.notInDataSet": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У наборы даных і навучальным рэжыме блакіроўка выключана: іх даныя выдуманыя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sperre ist in einem Datensatz und im Lernprogramm aus: Deren Bücher sind erfunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock is off in a data set and in the tutorial: their books are made up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo está desactivado en un conjunto de datos y en el tutorial: sus cuentas son inventadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrou est désactivé dans un jeu de données et dans le didacticiel : leurs comptes sont inventés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco è disattivato nei set di dati e nel tutorial: i loro dati sono fittizi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер жиынында және оқытуда құлып өшірулі: ондағы есептер ойдан шығарылған."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokada jest wyłączona w zestawie danych i w samouczku: ich dane są fikcyjne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio fica desativado em conjuntos de dados e no tutorial: os lançamentos são fictícios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В наборе данных и в учебном режиме блокировки нет: там учёт выдуманный."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veri setlerinde ve öğreticide kilit kapalıdır; kayıtlar örnektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У наборі даних і навчанні блокування вимкнено: облік там вигаданий."
          }
        }
      }
    },
