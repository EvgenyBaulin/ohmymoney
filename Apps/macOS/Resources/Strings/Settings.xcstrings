    "settings.selfEmployed.deductionLeft.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мой налог» bölməsinə baxın: 10,000 ₽ vergi güzəşti bir dəfə verilir və bitənədək dərəcəni 4%-dən 3%-ə, 6%-dən 4%-ə endirir. Sahə boş olduqda vergi güzəştsiz hesablanır və bir qədər çox pul ayrılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Глядзіце ў «Мой налог»: вылік 10 000 ₽ даецца адзін раз і зніжае стаўку з 4% да 3% і з 6% да 4%, пакуль не скончыцца. Пакуль поле пустое, падатак разлічваецца без выліку — адкладаецца крыху больш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Viz «Мой налог»: odpočet 10 000 ₽ se poskytuje jednorázově a do vyčerpání snižuje sazbu 4 % → 3 % a 6 % → 4 %. Je-li pole prázdné, daň se počítá bez odpočtu a odkládá se o něco více."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siehe „Mein Steuer“: Der Abzug von 10.000 ₽ wird einmal gewährt und senkt den Satz 4 % → 3 % und 6 % → 4 %, bis er aufgebraucht ist. Solange das Feld leer ist, wird die Steuer ohne ihn berechnet — es wird etwas mehr beiseitegelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See «Мой налог»: the deduction of 10,000 ₽ is given once and lowers the rate 4% → 3% and 6% → 4% until it runs out. While the field is empty the tax is counted without it — a little more is put aside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea «Mi impuesto»: la deducción de 10 000 ₽ se da una vez y baja el tipo del 4 % al 3 % y del 6 % al 4 % hasta agotarse. Mientras el campo esté vacío, el impuesto se calcula sin ella — se aparta un poco más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir « Mon impôt » : la déduction de 10 000 ₽ est accordée une fois et ramène le taux de 4 % à 3 % et de 6 % à 4 % jusqu'à épuisement. Tant que le champ est vide, l'impôt est calculé sans elle — on met un peu plus de côté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեսեք «Мой налог»-ում․ 10,000 ₽ նվազեցումը տրվում է մեկ անգամ և իջեցնում է դրույքաչափը՝ 4% → 3% և 6% → 4%, մինչև սպառվելը։ Քանի դեռ դաշտը դատարկ է, հարկը հաշվվում է առանց նվազեցման, և մի փոքր ավելի գումար է առանձնացվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta «Мой налог»: la detrazione di 10,000 ₽ è concessa una sola volta e riduce le aliquote da 4% → 3% e da 6% → 4% fino al suo esaurimento. Se il campo è vuoto, l’imposta viene calcolata senza detrazione e viene accantonato un importo leggermente maggiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Мой налог」で確認してください。10,000 ₽の控除は一度だけ付与され、使い切るまで税率が4% → 3%、6% → 4%に下がります。空欄の場合、控除なしで税額を計算するため、少し多めに確保されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იხილეთ «Мой налог»: 10,000 ₽-ის გამოქვითვა ერთხელ გაიცემა და ამოწურვამდე განაკვეთებს ამცირებს: 4% → 3% და 6% → 4%. სანამ ველი ცარიელია, გადასახადი გამოქვითვის გარეშე ითვლება — ოდნავ მეტი თანხა გადაიდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мой налог» ішінен қараңыз: 10 000 ₽ шегерім бір рет беріледі және таусылғанша мөлшерлемені 4% → 3% және 6% → 4% азайтады. Өріс бос болса, салық шегерімсіз есептеледі — сәл көбірек ақша қалдырылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мой налог» кызматын караңыз: 10,000 ₽ чегерүү бир жолу берилет жана түгөнгөнгө чейин ченди 4% → 3% жана 6% → 4% төмөндөтөт. Талаа бош болсо, салык чегерүүсүз эсептелет — бир аз көбүрөөк акча бөлүнөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie «Мой налог»: de aftrek van 10.000 ₽ wordt eenmalig toegekend en verlaagt het tarief van 4% naar 3% en van 6% naar 4% totdat de aftrek op is. Zolang het veld leeg is, wordt de belasting zonder aftrek berekend en iets meer opzijgezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź w «Мой налог»: ulga w wysokości 10 000 ₽ jest przyznawana jednorazowo i do wyczerpania obniża stawki z 4% do 3% oraz z 6% do 4%. Gdy pole jest puste, podatek jest liczony bez ulgi, więc odkładana kwota jest nieco wyższa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte «Мой налог»: a dedução de 10.000 ₽ é concedida uma vez e reduz as alíquotas de 4% → 3% e 6% → 4% até se esgotar. Enquanto o campo estiver vazio, o imposto será calculado sem ela — um pouco mais será reservado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte «Мой налог»: a dedução de 10 000 ₽ é atribuída uma vez e reduz a taxa de 4% → 3% e de 6% → 4% até se esgotar. Enquanto o campo estiver vazio, o imposto é calculado sem a dedução — é reservado um pouco mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите в «Мой налог»: вычет 10,000 ₽ даётся один раз и снижает ставку 4 % → 3 % и 6 % → 4 %, пока не кончится. Пока поле пусто, налог считается без вычета — отложится чуть больше."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба «Мой налог» нигаред: тарҳи 10,000 ₽ як бор дода мешавад ва то тамом шуданаш меъёрро аз 4% ба 3% ва аз 6% ба 4% паст мекунад. То холӣ будани майдон андоз бе он ҳисоб мешавад — каме бештар ҷудо карда мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мой налог» uygulamasına bakın: 10.000 ₽ indirim bir kez verilir ve bitene kadar oranı %4 → %3 ve %6 → %4 olarak düşürür. Alan boşken vergi indirimsiz hesaplanır ve biraz daha fazla para ayrılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дивіться «Мой налог»: відрахування 10,000 ₽ надається один раз і зменшує ставки 4% → 3% та 6% → 4%, доки не вичерпається. Якщо поле порожнє, податок рахується без нього — відкладається трохи більше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мой налог»ga qarang: 10,000 ₽ chegirma bir marta beriladi va tugaguncha stavkani 4% → 3% va 6% → 4% gacha kamaytiradi. Maydon bo‘sh bo‘lsa, soliq chegirmasiz hisoblanadi — biroz ko‘proq pul ajratiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请查看“Мой налог”：10,000 ₽ 的减免额仅提供一次，在用完之前，税率从 4% 降至 3%，从 6% 降至 4%。留空时，计算税额不计入减免，因此预留的金额会稍多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請參閱 «Мой налог»：10,000 ₽ 的扣除額僅提供一次，使用完畢前可將稅率由 4% 降至 3%，以及由 6% 降至 4%。欄位留空時，計稅不會套用扣除額，預留的稅款會稍多。"
          }
        }
      }
    },
