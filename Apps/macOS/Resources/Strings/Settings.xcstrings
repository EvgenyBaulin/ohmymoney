    "settings.anomalies.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksək həssaslıq daha çox hal tapır və daha tez-tez soruşur; aşağı həssaslıq yalnız aşkar uyğunsuzluqları bildirir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокая адчувальнасць знаходзіць больш анамалій і часцей пытаецца; нізкая паведамляе толькі пра відавочныя адхіленні."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší citlivost najde více odchylek a častěji se ptá. Nižší upozorní jen na zjevné odchylky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine höhere Empfindlichkeit findet mehr und fragt öfter; eine niedrigere sagt nur, was eindeutig nicht passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher sensitivity finds more and asks more often; a lower one only says what is plainly out of place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sensibilidad mayor encuentra más y pregunta con más frecuencia; una menor solo señala lo que está claramente fuera de lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sensibilité plus élevée en trouve davantage et demande plus souvent ; une plus basse ne signale que ce qui est manifestement hors norme."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բարձր զգայունությունն ավելի շատ դեպքեր է գտնում և ավելի հաճախ հարցնում․ ցածրը ցույց է տալիս միայն ակնհայտ շեղումները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sensibilità più alta rileva più anomalie e chiede conferma più spesso; una più bassa segnala solo quelle evidenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "感度を高くすると、より多くの異常を検出し、確認の頻度が増えます。低くすると、明らかな異常のみ通知します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაღალი მგრძნობელობა მეტ ანომალიას პოულობს და უფრო ხშირად გეკითხებათ; დაბალი კი მხოლოდ აშკარა შეუსაბამობებს აჩვენებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоғары сезімталдық көбірек ауытқу тауып, жиірек сұрайды; төмені тек айқын ауытқуларды көрсетеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сезгичтик жогору болсо, көбүрөөк таап, бат-бат сурайт; төмөн болсо, айкын айырмачылыктарды гана көрсөтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hogere gevoeligheid vindt meer en stelt vaker vragen. Een lagere gevoeligheid meldt alleen duidelijke afwijkingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższa czułość wykrywa więcej i częściej pyta; niższa wskazuje tylko wyraźnie nietypowe operacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sensibilidade maior encontra mais anomalias e pergunta com mais frequência; uma menor avisa apenas sobre o que está claramente fora do padrão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sensibilidade mais alta deteta mais e pergunta mais vezes; uma mais baixa assinala apenas o que está claramente fora do normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше чувствительность, тем больше находок и вопросов; низкая говорит только о явно выбивающемся."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳассосияти баланд бештар меёбад ва мепурсад; ҳассосияти паст танҳо номувофиқатиҳои ошкорро нишон медиҳад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek hassasiyet daha fazla işlem bulur ve daha sık sorar; düşük hassasiyet yalnızca açıkça olağan dışı olanları bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вища чутливість знаходить більше й запитує частіше; нижча повідомляє лише про явно незвичне."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuqori sezgirlik ko‘proq holatni topadi va tez-tez so‘raydi; past sezgirlik faqat yaqqol holatlarni ko‘rsatadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵敏度越高，发现的异常越多，询问也越频繁；灵敏度越低，只提示明显的异常。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較高的靈敏度會找出更多異常並更常詢問；較低的靈敏度只會提示明顯的異常。"
          }
        }
      }
    },
