        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ағымдағы деректерді алдын ала көшіру мүмкін болмады, сондықтан ештеңе ауыстырылмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Учурдагы маалыматтын көчүрмөсү түзүлгөн жок, ошондуктан эч нерсе алмаштырылган жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kon geen kopie van de huidige gegevens worden gemaakt. Er is niets vervangen."
