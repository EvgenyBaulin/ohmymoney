    "settings.entry.style.line": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line at the bottom of the window"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Línea en la parte inferior de la ventana"
          }
        },
        "ru": {
          "stringUnit": {
