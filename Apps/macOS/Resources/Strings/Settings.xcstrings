          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атау бос болмауы керек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аты бош болбошу керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een naam mag niet leeg zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa nie może być pusta."
          }
        },
        "pt-BR": {
          "stringUnit": {
