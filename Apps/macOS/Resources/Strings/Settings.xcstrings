    "backups.restore.newer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта копія створана ў навейшай версіі OhMyMoney. Абнавіце праграму, каб аднавіць яе. Нічога не заменена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie wurde von einer neueren Version von OhMyMoney geschrieben: Aktualisieren Sie die App, um sie wiederherzustellen. Nichts wurde ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy was written by a newer version of OhMyMoney: update the app to restore it. Nothing was replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia la escribió una versión más reciente de OhMyMoney: actualice la app para restaurarla. No se reemplazó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie a été écrite par une version plus récente d'OhMyMoney : mettez l'app à jour pour la restaurer. Rien n'a été remplacé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia è stata creata con una versione più recente di OhMyMoney: aggiorna l’app per ripristinarla. Nessun dato è stato sostituito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл көшірмені OhMyMoney-дің жаңа нұсқасы жазған: оны қалпына келтіру үшін қолданбаны жаңартыңыз. Ештеңе ауыстырылмады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia pochodzi z nowszej wersji OhMyMoney. Uaktualnij aplikację, aby ją przywrócić. Żadne dane nie zostały zastąpione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia foi criada por uma versão mais recente do OhMyMoney. Atualize o app para restaurá-la. Nada foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту копию записала более новая версия OhMyMoney: чтобы восстановить её, обновите приложение. Ничего не заменено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kopya, OhMyMoney’nin daha yeni bir sürümüyle oluşturulmuş. Geri yüklemek için uygulamayı güncelleyin. Hiçbir veri değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю копію записала новіша версія OhMyMoney: оновіть застосунок для відновлення. Нічого не замінено."
          }
        }
      }
    },
    "backups.restore.noSafetyCopy": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося стварыць копію бягучых даных, таму нічога не заменена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Daten konnten vorher nicht kopiert werden, daher wurde nichts ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current data could not be copied first, so nothing was replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes no se pudieron copiar los datos actuales, así que no se reemplazó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données actuelles n'ont pas pu être copiées d'abord, donc rien n'a été remplacé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile copiare prima i dati attuali. Nessun dato è stato sostituito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ағымдағы деректерді алдын ала көшіру мүмкін болмады, сондықтан ештеңе ауыстырылмады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć kopii bieżących danych, więc żadne dane nie zostały zastąpione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível copiar os dados atuais antes da restauração. Nada foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сначала сохранить копию текущих данных, поэтому ничего не заменено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut veriler önce kopyalanamadığı için hiçbir veri değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося спочатку скопіювати поточні дані, тому нічого не замінено."
          }
        }
      }
    },
    "backups.restore.readOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма працуе ў рэжыме толькі для чытання. Каб аднавіць копію, спачатку выйдзіце з гэтага рэжыму."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist nur lesbar: Eine Kopie kann nicht wiederhergestellt werden. Verlassen Sie zuerst den Modus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is read-only: a copy cannot be restored. Leave the mode first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app está en solo lectura: no se puede restaurar una copia. Salga antes del modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app est en lecture seule : une copie ne peut pas être restaurée. Quittez d'abord ce mode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app è in sola lettura: impossibile ripristinare una copia. Esci prima da questa modalità."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба тек оқу режимінде: көшірмені қалпына келтіру мүмкін емес. Алдымен режимнен шығыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja działa w trybie tylko do odczytu. Aby przywrócić kopię, wyłącz ten tryb."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app está em modo somente leitura. Saia desse modo para restaurar uma cópia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён режим «Только просмотр»: восстановить копию нельзя. Сначала выйдите из режима."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama salt okunur modda olduğu için kopya geri yüklenemiyor. Önce bu moddan çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок у режимі лише перегляду: відновлення копії неможливе. Спочатку вийдіть із режиму."
          }
        }
      }
    },
