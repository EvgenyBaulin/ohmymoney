    "export.replace.body": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qovluqda ixrac edilən fayllarla eyni adlı fayllar var. Onlar yeniləri ilə əvəz ediləcək; qovluqdakı digər fayllara toxunulmayacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У папцы ўжо ёсць файлы з такімі назвамі. Яны будуць заменены новымі; астатняе ў папцы не зменіцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složka už obsahuje soubory se stejnými názvy. Budou nahrazeny novými soubory; ostatní obsah složky zůstane beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner enthält schon Dateien mit den Namen des Exports. Sie werden durch die neuen ersetzt; sonst wird nichts im Ordner berührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder already has files with the names of the export. They will be replaced by the new ones; nothing else in the folder is touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta ya tiene archivos con los nombres de la exportación. Se reemplazarán por los nuevos; nada más de la carpeta se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier contient déjà des fichiers portant les noms de l'export. Ils seront remplacés par les nouveaux ; rien d'autre dans le dossier n'est touché."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պանակում արդեն կան արտահանվող ֆայլերի անուններով ֆայլեր։ Դրանք կփոխարինվեն նորերով․ պանակի մյուս բովանդակությունը չի փոխվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella contiene già file con gli stessi nomi. Saranno sostituiti dai nuovi file; il resto della cartella rimarrà invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出すファイルと同じ名前のファイルがフォルダにあります。これらのファイルは置き換えられます。フォルダ内のほかのファイルは変更されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საქაღალდეში უკვე არის ფაილები იმავე სახელებით. ისინი ახლით ჩანაცვლდება; საქაღალდეში სხვა არაფერი შეიცვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалтада экспорт атымен файлдар бар. Олар жаңаларымен ауыстырылады; қалтадағы басқа ештеңеге тиілмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Папкада экспорттолуучу файлдар менен бирдей аталыштагы файлдар бар. Алар жаңылары менен алмаштырылат; папкадагы башка файлдар өзгөрбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De map bevat al bestanden met dezelfde namen als de exportbestanden. Deze worden vervangen door de nieuwe bestanden. De rest van de map blijft ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder zawiera już pliki o takich samych nazwach. Zostaną zastąpione nowymi plikami. Pozostała zawartość folderu nie ulegnie zmianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta já contém arquivos com os mesmos nomes dos arquivos exportados. Eles serão substituídos pelos novos; os demais arquivos não serão alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta já contém ficheiros com os nomes dos ficheiros a exportar. Serão substituídos pelos novos; os restantes ficheiros não serão alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке уже есть файлы с именами выгрузки. Они будут заменены новыми; остальное в папке не тронуто."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҷузвдон аллакай файлҳо бо номҳои содиршаванда ҳастанд. Онҳо бо файлҳои нав иваз мешаванд; ба дигар чизҳои ҷузвдон даст расонда намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörde dışa aktarılacak dosyalarla aynı ada sahip dosyalar var. Bunlar yenileriyle değiştirilir; klasördeki diğer öğeler değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці вже є файли з назвами експорту. Їх буде замінено новими; решта вмісту папки не зміниться."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jildda eksport fayllari bilan bir xil nomli fayllar bor. Ular yangilari bilan almashtiriladi; jilddagi boshqa fayllar o‘zgarmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹中已有与导出文件同名的文件。这些文件将被新文件替换，文件夹中的其他内容不会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案夾中已有與輸出檔案同名的檔案，這些檔案將被取代。檔案夾中的其他內容不受影響。"
          }
        }
      }
    },
