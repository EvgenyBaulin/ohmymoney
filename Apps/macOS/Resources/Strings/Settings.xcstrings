    "settings.privacy.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden amounts read «•••» on every screen and chart; what you type and the exported files stay as they are. The lock asks for the password of OhMyMoney, Touch ID or the password of this Mac when OhMyMoney opens, after the idle time and when the Mac sleeps or locks its screen; calculations and backups go on behind it. Five wrong passwords pause the field for 30 seconds. All of it is kept on this Mac only; the password — as a hash in its Keychain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытые суммы видны как «•••» на всех экранах и графиках; то, что вы вводите, и выгруженные файлы не меняются. Блокировка просит пароль OhMyMoney, Touch ID или пароль этого Mac при открытии OhMyMoney, после простоя и когда Mac засыпает или блокирует экран; расчёты и копии за ней идут как обычно. После пяти неверных паролей поле ждёт 30 секунд. Всё это хранится только на этом Mac, пароль — хешем в связке ключей."
          }
        }
      }
    },
