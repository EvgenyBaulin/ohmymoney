            "state": "translated",
            "value": "გამოვიყენოთ ახალი შეფასება წინა ოპერაციებისთვის?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа сапа өткен операцияларға қолданылсын ба?"
