    "references.delete.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На яго нішто не спасылаецца: ні аперацыі, у тым ліку ў кошыку, ні планы, ні даўгі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verweist darauf: kein Vorgang, auch die im Papierkorb nicht, kein Plan, keine Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing refers to it: no operation, the ones in the bin included, no plan, no debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada hace referencia a él: ninguna operación, tampoco las de la papelera, ningún plan ni deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'y réfère : aucune opération, celles de la corbeille comprises, aucun plan, aucune dette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è usato da alcuna operazione, nemmeno nel cestino, né da piani o debiti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оған ештеңе сілтеме жасамайды: себеттегілерді қоса алғанда, операция да, жоспар да, қарыз да жоқ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На это ничто не ссылается: ни операции, в том числе в корзине, ни планы, ни долги."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо не посилається на цей запис: ні операції, зокрема в кошику, ні плани, ні борги."
          }
        }
      }
    },
