    "categories.delete.busy": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вялікае змяненне яшчэ захоўваецца. Пачакайце і паспрабуйце зноў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine große Änderung wird noch geschrieben. Einen Moment, dann versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large change is still being written. A moment, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía se está escribiendo un cambio grande. Un momento, y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une modification importante est encore en cours d'écriture. Un instant, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una modifica estesa è ancora in fase di salvataggio. Attendi un momento e riprova."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлкен өзгеріс әлі жазылып жатыр. Сәл күтіп, қайталап көріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большая правка ещё пишется. Секунду, и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Велика зміна ще записується. Зачекайте мить і спробуйте знову."
          }
        }
      }
    },
    "categories.delete.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыя не выдалена: на яе яшчэ ёсць спасылкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorie wurde nicht gelöscht: Noch etwas verweist auf sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category was not deleted: something still points at it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoría no se eliminó: algo todavía apunta a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie n'a pas été supprimée : quelque chose y fait encore référence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoria non è stata eliminata: è ancora in uso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санат жойылмады: оған әлі бір нәрсе сілтейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория не удалена: на неё что-то ещё ссылается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорію не видалено: на неї ще є посилання."
          }
        }
      }
    },
    "categories.delete.failedAfterMove": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі перамешчаны, але катэгорыя не выдалена: на яе яшчэ ёсць спасылкі. ⌘Z адменіць перамяшчэнне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorgänge sind verschoben, aber die Kategorie wurde nicht gelöscht: Noch etwas verweist auf sie. ⌘Z nimmt die Verschiebung zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations have moved, but the category was not deleted: something still points at it. ⌘Z takes the move back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones se movieron, pero la categoría no se eliminó: algo todavía apunta a ella. ⌘Z deshace el traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations ont été déplacées, mais la catégorie n'a pas été supprimée : quelque chose y fait encore référence. ⌘Z reprend le déplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni sono state spostate, ma la categoria non è stata eliminata perché è ancora in uso. Premi ⌘Z per annullare lo spostamento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар көшті, бірақ санат жойылмады: оған әлі бір нәрсе сілтейді. ⌘Z көшуді қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции перенесены, а категория не удалена: на неё ещё что-то ссылается. ⌘Z вернёт их обратно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції перенесено, але категорію не видалено: на неї ще є посилання. ⌘Z скасовує перенесення."
          }
        }
      }
    },
    "categories.delete.failedAfterMove.touch": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі перамешчаны, але катэгорыя не выдалена: на яе яшчэ ёсць спасылкі. “Адмяніць” верне аперацыі назад."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorgänge sind verschoben, aber die Kategorie wurde nicht gelöscht: Noch etwas verweist auf sie. „Rückgängig“ nimmt die Verschiebung zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations have moved, but the category was not deleted: something still points at it. “Undo” takes the move back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones se movieron, pero la categoría no se eliminó: algo todavía apunta a ella. «Deshacer» deshace el traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations ont été déplacées, mais la catégorie n'a pas été supprimée : quelque chose y fait encore référence. « Annuler » reprend le déplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni sono state spostate, ma la categoria non è stata eliminata perché è ancora in uso. Tocca “Annulla” per annullare lo spostamento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар көшті, бірақ санат жойылмады: оған әлі бір нәрсе сілтейді. «Болдырмау» көшуді қайтарады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции перенесены, а категория не удалена: на неё ещё что-то ссылается. «Отменить» вернёт их обратно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції перенесено, але категорію не видалено: на неї ще є посилання. «Скасувати дію» повертає операції."
          }
        }
      }
    },
