        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Turkum o‘chirilmadi: unga hali ham havola mavjud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未删除类别：仍有项目引用此类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除類別：仍有項目使用此類別。"
          }
        }
      }
    },
    "categories.delete.failedAfterMove": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyatlar köçürüldü, lakin kateqoriya silinmədi: ona hələ də istinad var. Köçürməni ⌘Z ilə geri ala bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі перамешчаны, але катэгорыя не выдалена: на яе яшчэ ёсць спасылкі. ⌘Z адменіць перамяшчэнне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace byly přesunuty, ale kategorii se nepodařilo smazat: stále se na ni něco odkazuje. Přesun vrátíte pomocí ⌘Z."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorgänge sind verschoben, aber die Kategorie wurde nicht gelöscht: Noch etwas verweist auf sie. ⌘Z nimmt die Verschiebung zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations have moved, but the category was not deleted: something still points at it. ⌘Z takes the move back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones se movieron, pero la categoría no se eliminó: algo todavía apunta a ella. ⌘Z deshace el traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations ont été déplacées, mais la catégorie n'a pas été supprimée : quelque chose y fait encore référence. ⌘Z reprend le déplacement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործարքները տեղափոխվել են, բայց կատեգորիան չի ջնջվել․ այն դեռ օգտագործվում է։ ⌘Z-ը հետ է շրջում տեղափոխումը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni sono state spostate, ma la categoria non è stata eliminata perché è ancora in uso. Premi ⌘Z per annullare lo spostamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引は移動しましたが、参照が残っているためカテゴリは削除されませんでした。⌘Zで移動を取り消せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაციები გადატანილია, მაგრამ კატეგორია არ წაიშალა: ის ჯერ კიდევ გამოიყენება. გადატანის გასაუქმებლად დააჭირეთ ⌘Z."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар көшті, бірақ санат жойылмады: оған әлі бір нәрсе сілтейді. ⌘Z көшуді қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операциялар жылдырылды, бирок категория өчүрүлгөн жок: ал дагы эле колдонулууда. Жылдырууну ⌘Z менен артка кайтарсаңыз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transacties zijn verplaatst, maar de categorie is niet verwijderd: er wordt nog naar verwezen. Met ⌘Z maak je de verplaatsing ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje zostały przeniesione, ale nie usunięto kategorii, ponieważ nadal jest używana. Naciśnij ⌘Z, aby cofnąć przeniesienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações foram movidas, mas a categoria não foi apagada porque ainda está em uso. Pressione ⌘Z para desfazer a movimentação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações foram movidas, mas a categoria não foi apagada porque ainda está a ser usada. Prima ⌘Z para desfazer a deslocação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции перенесены, а категория не удалена: на неё ещё что-то ссылается. ⌘Z вернёт их обратно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиётҳо кӯчонда шуданд, аммо категория нест карда нашуд: чизе ҳоло ҳам ба он истинод мекунад. Барои бекор кардани кӯчонидан ⌘Z-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemler taşındı ancak kategori silinmedi: Hâlâ ona bağlı veriler var. Taşımayı ⌘Z ile geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції перенесено, але категорію не видалено: на неї ще є посилання. ⌘Z скасовує перенесення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatsiyalar ko‘chirildi, ammo turkum o‘chirilmadi: unga hali ham havola mavjud. Ko‘chirishni ⌘Z bilan bekor qilish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已移动，但类别未删除：仍有项目引用此类别。按 ⌘Z 可撤销移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已移動，但無法刪除類別：仍有項目使用此類別。按下 ⌘Z 可還原移動。"
          }
        }
      }
    },
