    "settings.forWhom.peopleHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У любой аперацыі можна выбраць чалавека замест аднаго з пяці пунктаў. У раздзеле «Для каго» ў аналітыцы яны ўлічваюцца асобна. Сувязі, іншыя імёны і аб’яднанне — у даведніках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Person kann bei jedem Vorgang statt einer der fünf gesetzt werden, und „Für wen“ in der Auswertung zählt sie getrennt. Beziehungen, weitere Namen und Zusammenführen stehen in den Nachschlagewerken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A person can be set on any operation instead of one of the five, and «For whom» in Analytics counts them separately. Relations, other names and merging are in Reference books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona se puede poner en cualquier operación en lugar de una de las cinco, y «Para quién» en la Analítica las cuenta por separado. Las relaciones, otros nombres y la fusión están en Libros de referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne peut être choisie sur n'importe quelle opération à la place de l'une des cinq, et « Pour qui » dans l'Analyse les compte à part. Les liens, les autres noms et les fusions se trouvent dans les Références."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi assegnare una persona a qualsiasi operazione al posto di una delle cinque voci. In Analisi, «Per chi» le conteggia separatamente. Relazioni, altri nomi e unione si trovano negli elenchi di riferimento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кез келген операцияда осы бесеудің орнына адамды таңдауға болады, Талдаудағы «Кімге» оларды бөлек есептейді. Қатынастар, басқа атаулар және біріктіру Анықтамалықтарда."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человека можно указать у любой операции вместо одного из пяти значений, и в «На кого» аналитики он считается отдельно. Отношение, другие названия и слияние — в «Справочниках»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На будь-якій операції можна вказати людину замість одного з п'яти варіантів, і «Для кого» в аналітиці врахує її окремо. Зв'язки, інші імена та об'єднання — у довідниках."
          }
        }
      }
    },
