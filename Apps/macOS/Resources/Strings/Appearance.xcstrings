    "appearance.contrast.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключана павышаная кантраснасць: праграма паказвае кантрасную тэму."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Kontrast erhöhen“ ist eingeschaltet: Die App zeigt das Design „Kontrast“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase Contrast is on: the app shows the Contrast theme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Aumentar contraste» está activado: la app muestra el tema de Contraste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Augmenter le contraste » est activé : l'application affiche le thème Contraste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta contrasto è attivo: l’app mostra il tema Contrasto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Контрасты арттыру» қосулы: қолданба Контраст тақырыбын көрсетеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрастты жогорулатуу күйүк: колдонмодо контраст темасы көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączono zwiększony kontrast: aplikacja wyświetla motyw Kontrast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A opção Aumentar Contraste está ativada: o app mostra o tema Contraste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено «Увеличить контраст»: приложение показывает тему «Контраст»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«Афзоиши контраст» фаъол аст: барнома мавзӯи контрастиро нишон медиҳад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrastı Artır açık: uygulama Kontrast temasını gösteriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено підвищений контраст: застосунок показує тему «Контраст»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrastni oshirish yoqilgan: ilovada Kontrast mavzusi ko‘rsatilmoqda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟「增加對比」，App 會顯示「對比」主題。"
          }
        }
      }
    },
