    "appearance.preview.fewData": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадайце некалькі аперацый, каб убачыць іх у гэтай тэме."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie ein paar Vorgänge hinzu, dann zeigt sich das Design an ihnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add some operations and the theme will show on them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada algunas operaciones y el tema se verá en ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez quelques opérations et le thème s'affichera dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi alcune operazioni per vedere il tema applicato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірнеше операция қосыңыз — тақырып соларда көрінеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир нече операция кошуңуз, ошондо тема аларда көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj kilka operacji, aby zobaczyć na nich motyw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione algumas operações para ver o tema nelas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте операции, и тема покажется на них."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чанд амалиёт илова кунед, то мавзӯъро дар онҳо бинед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç işlem ekleyin; tema bunlarda gösterilsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте кілька операцій, щоб побачити тему на них."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Amallar qo‘shing va ularda mavzu qanday ko‘rinishini ko‘ring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入一些交易，即可查看主題效果。"
          }
        }
      }
    },
    "appearance.preview.noWrites": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічога не зменіцца, пакуль вы не націснеце «Ужыць»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ändert sich, bis Sie „Übernehmen“ drücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes until you press Apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada cambia hasta que pulse «Aplicar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change tant que vous n'appuyez pas sur « Appliquer »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nulla finché non premi Applica."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Қолдану» басылғанша ештеңе өзгермейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Колдонуу» басылмайынча эч нерсе өзгөрбөйт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się nie zmieni, dopóki nie klikniesz Zastosuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda até você tocar em Aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не изменится, пока вы не нажмёте «Применить»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То пахши «Татбиқ» чизе тағйир намеёбад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygula’ya basana kadar hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не зміниться, доки ви не натиснете «Застосувати»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qo‘llash tugmasi bosilmaguncha hech narsa o‘zgarmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下「套用」前不會變更任何內容。"
          }
        }
      }
    },
