{
  "sourceLanguage": "en",
  "strings": {
    "appearance.accent.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accent repaints buttons and selection over the chosen theme. «Like the theme» uses the theme's own."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент перекрашивает кнопки и выделение поверх выбранной темы. «Как в теме» берёт цвет самой темы."
          }
        }
      }
    },
    "appearance.accent.theme": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like the theme"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в теме"
          }
        }
      }
    },
    "appearance.contrast.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase Contrast is on: the app shows the Contrast theme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено «Увеличить контраст»: приложение показывает тему «Контраст»."
          }
        }
      }
    },
    "appearance.preview.amountsHidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts are hidden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммы скрыты."
          }
        }
      }
    },
    "appearance.preview.apply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить"
          }
        }
      }
    },
    "appearance.preview.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
