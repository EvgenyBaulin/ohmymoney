{
  "sourceLanguage": "en",
  "strings": {
    "appearance.accent.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колер акцэнту змяняе колер кнопак і вылучэння ў выбранай тэме. «Як у тэме» выкарыстоўвае яе колер."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Akzentfarbe färbt Schaltflächen und Auswahl im gewählten Design. „Wie das Design“ nimmt die eigene Farbe des Designs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accent repaints buttons and selection over the chosen theme. «Like the theme» uses the theme's own."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore in risalto si applica ai pulsanti e alle selezioni del tema scelto. «Come il tema» usa il colore del tema."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент түймелер мен таңдауды таңдалған тақырыпқа бояйды. «Тақырып сияқты» — тақырыптың өз түсі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент перекрашивает кнопки и выделение поверх выбранной темы. «Как в теме» берёт цвет самой темы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент змінює колір кнопок і виділення поверх вибраної теми. «Як у темі» використовує її власний колір."
          }
        }
      }
    },
    "appearance.accent.theme": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Як у тэме"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie das Design"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like the theme"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come il tema"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тақырып сияқты"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в теме"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як у темі"
          }
        }
      }
    },
    "appearance.contrast.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключана павышаная кантраснасць: праграма паказвае кантрасную тэму."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Kontrast erhöhen“ ist eingeschaltet: Die App zeigt das Design „Kontrast“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase Contrast is on: the app shows the Contrast theme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta contrasto è attivo: l’app mostra il tema Contrasto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Контрасты арттыру» қосулы: қолданба Контраст тақырыбын көрсетеді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено «Увеличить контраст»: приложение показывает тему «Контраст»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено підвищений контраст: застосунок показує тему «Контраст»."
          }
        }
      }
    },
