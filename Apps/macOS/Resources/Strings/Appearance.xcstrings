            "value": "Аталыш активдүү өтмөктө гана"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Etykieta tylko na aktywnej karcie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome apenas na aba ativa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись только у активной вкладки"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ном танҳо дар ҷадвали фаъол"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket yalnızca etkin sekmede"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпис лише на активній вкладці"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom faqat faol varaqda"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅顯示目前分頁的標籤"
          }
        }
      }
    },
    "appearance.tabLabels.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Па змаўчанні кожная ўкладка на ніжняй панэлі мае назву. Уключыце, каб назва была толькі на адкрытай укладцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig zeigt jeder Tab der unteren Leiste seinen Namen. Schalten Sie dies ein, um den Namen nur am geöffneten Tab zu behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default every tab of the bottom bar shows its name. Turn this on to keep the name on the open tab only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, cada pestaña de la barra inferior muestra su nombre. Actívelo para mantener el nombre solo en la pestaña abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, chaque onglet de la barre du bas affiche son nom. Activez cette option pour ne garder le nom que sur l'onglet ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di default, ogni pannello della barra inferiore mostra il proprio nome. Attiva questa opzione per mostrare solo il nome del pannello aperto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдепкіде төменгі жолақтың әр қойындысы өз атауын көрсетеді. Оны қосқанда атау тек ашық қойындыда қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Демейки боюнча төмөнкү тилкедеги ар бир өтмөктүн аталышы көрсөтүлөт. Аталыш ачык өтмөктө гана көрүнүшү үчүн күйгүзүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie każda karta na dolnym pasku ma nazwę. Włącz tę opcję, aby pokazywać nazwę tylko na otwartej karcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, todas as abas da barra inferior mostram seus nomes. Ative esta opção para mostrar apenas o nome da aba aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию у каждой вкладки нижней панели видно название. Включите, чтобы название оставалось только у открытой вкладки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Одатан номи ҳар ҷадвал дар навори поён нишон дода мешавад. Инро фаъол кунед, то ном танҳо дар ҷадвали кушода бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt çubuktaki her sekmenin adı saptanmış olarak gösterilir. Adı yalnızca açık sekmede göstermek için bunu açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвичай кожна вкладка нижньої панелі показує свою назву. Увімкніть, щоб залишити назву лише на відкритій вкладці."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatda pastki paneldagi har bir varaqning nomi ko‘rsatiladi. Nom faqat ochiq varaqda ko‘rinishi uchun buni yoqing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設會顯示底部分頁列中所有分頁的名稱。開啟後，只會顯示目前分頁的名稱。"
          }
        }
      }
    },
