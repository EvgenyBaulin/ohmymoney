    "appearance.tabLabels.activeOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label only on the active tab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre solo en la pestaña activa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись только у активной вкладки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпис лише на активній вкладці"
          }
        }
      }
    },
    "appearance.tabLabels.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default every tab of the bottom bar shows its name. Turn this on to keep the name on the open tab only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, cada pestaña de la barra inferior muestra su nombre. Actívelo para mantener el nombre solo en la pestaña abierta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию у каждой вкладки нижней панели видно название. Включите, чтобы название оставалось только у открытой вкладки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвичай кожна вкладка нижньої панелі показує свою назву. Увімкніть, щоб залишити назву лише на відкритій вкладці."
          }
        }
      }
    },
    "appearance.theme.chosen": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрана"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрано"
          }
        }
      }
    },
    "appearance.themes.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A theme sets every colour of the app. Click one to see it on your own data before you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema define todos los colores de la app. Haga clic en uno para verlo con sus propios datos antes de elegir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема задаёт все цвета приложения. Нажмите на тему, чтобы увидеть её на своих данных, прежде чем выбрать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема визначає всі кольори застосунку. Натисніть, щоб переглянути її на своїх даних перед вибором."
          }
        }
      }
    },
