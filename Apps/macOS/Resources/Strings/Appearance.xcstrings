    "appearance.tabLabels.activeOnly": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва толькі на актыўнай укладцы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschriftung nur am aktiven Tab"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label only on the active tab"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Etichetta solo sul pannello attivo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атауы тек ашық қойындыда"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись только у активной вкладки"
          }
        },
        "uk": {
