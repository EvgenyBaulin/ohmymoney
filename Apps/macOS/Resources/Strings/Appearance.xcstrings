{
  "sourceLanguage": "en",
  "strings": {
    "appearance.accent.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колер акцэнту змяняе колер кнопак і вылучэння ў выбранай тэме. «Як у тэме» выкарыстоўвае яе колер."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Akzentfarbe färbt Schaltflächen und Auswahl im gewählten Design. „Wie das Design“ nimmt die eigene Farbe des Designs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accent repaints buttons and selection over the chosen theme. «Like the theme» uses the theme's own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acento colorea los botones y la selección sobre el tema elegido. «Como el tema» usa el propio del tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accent recolore les boutons et la sélection selon le thème choisi. « Comme le thème » prend celui du thème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore in risalto si applica ai pulsanti e alle selezioni del tema scelto. «Come il tema» usa il colore del tema."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент түймелер мен таңдауды таңдалған тақырыпқа бояйды. «Тақырып сияқты» — тақырыптың өз түсі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент тандалган темадагы баскычтардын жана тандалган нерселердин түсүн өзгөртөт. «Темадагыдай» теманын өз түсүн колдонот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolor akcentu zmienia wygląd przycisków i zaznaczeń w wybranym motywie. Opcja „Jak w motywie” używa jego koloru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor de destaque altera os botões e as seleções no tema escolhido. «Como o tema» usa a cor do próprio tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент перекрашивает кнопки и выделение поверх выбранной темы. «Как в теме» берёт цвет самой темы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранги таъкид тугмаҳо ва интихобро дар мавзӯи интихобшуда ранг мекунад. «Мисли мавзӯъ» ранги худи мавзӯъро истифода мебарад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurgu rengi, seçilen temadaki düğmeleri ve seçimleri renklendirir. «Tema gibi» temanın kendi rengini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент змінює колір кнопок і виділення поверх вибраної теми. «Як у темі» використовує її власний колір."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksent tanlangan mavzudagi tugmalar va tanlov rangini o‘zgartiradi. «Mavzu kabi» mavzuning o‘z rangidan foydalanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強調色會套用至所選主題的按鈕和選取項目。「與主題相同」會使用主題本身的顏色。"
          }
        }
      }
    },
