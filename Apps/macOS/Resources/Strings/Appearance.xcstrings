{
  "sourceLanguage": "en",
  "strings": {
    "appearance.accent.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accent repaints buttons and selection over the chosen theme. «Like the theme» uses the theme's own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acento colorea los botones y la selección sobre el tema elegido. «Como el tema» usa el propio del tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент перекрашивает кнопки и выделение поверх выбранной темы. «Как в теме» берёт цвет самой темы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент змінює колір кнопок і виділення поверх вибраної теми. «Як у темі» використовує її власний колір."
          }
        }
      }
    },
    "appearance.accent.theme": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like the theme"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como el tema"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в теме"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як у темі"
          }
        }
      }
    },
    "appearance.contrast.note": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase Contrast is on: the app shows the Contrast theme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Aumentar contraste» está activado: la app muestra el tema de Contraste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено «Увеличить контраст»: приложение показывает тему «Контраст»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено підвищений контраст: застосунок показує тему «Контраст»."
          }
        }
      }
    },
    "appearance.preview.amountsHidden": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts are hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los importes están ocultos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммы скрыты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суми приховано."
          }
        }
      }
    },
