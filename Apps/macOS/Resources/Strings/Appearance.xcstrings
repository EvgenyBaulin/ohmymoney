    "appearance.themes.hint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэма вызначае ўсе колеры праграмы. Націсніце на тэму, каб убачыць яе на сваіх даных перад выбарам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Design legt jede Farbe der App fest. Klicken Sie auf eines, um es an Ihren eigenen Daten zu sehen, bevor Sie wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A theme sets every colour of the app. Click one to see it on your own data before you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema define todos los colores de la app. Haga clic en uno para verlo con sus propios datos antes de elegir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un thème définit toutes les couleurs de l'application. Cliquez sur l'un d'eux pour le voir sur vos propres données avant de choisir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema definisce tutti i colori dell’app. Fai clic su un tema per vederlo applicato ai tuoi dati prima di sceglierlo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тақырып қолданбаның барлық түсін белгілейді. Таңдамас бұрын өз деректеріңізде көру үшін бірін басыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема колдонмонун бардык түстөрүн аныктайт. Тандоодон мурун өз дайындарыңызда көрүү үчүн теманы басыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motyw określa wszystkie kolory aplikacji. Kliknij motyw, aby przed wyborem zobaczyć go na swoich danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tema define todas as cores do app. Selecione um para vê-lo nos seus dados antes de escolhê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема задаёт все цвета приложения. Нажмите на тему, чтобы увидеть её на своих данных, прежде чем выбрать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мавзӯъ ҳамаи рангҳои барномаро муайян мекунад. Якеро пахш кунед, то пеш аз интихоб онро дар маълумоти худ бинед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, uygulamanın tüm renklerini belirler. Seçmeden önce verilerinizde görmek için bir temaya tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема визначає всі кольори застосунку. Натисніть, щоб переглянути її на своїх даних перед вибором."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavzu ilovaning barcha ranglarini belgilaydi. Tanlashdan oldin ma’lumotlaringizda qanday ko‘rinishini ko‘rish uchun mavzuni bosing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題會設定 App 的所有顏色。選取前，按一下主題即可使用你的資料預覽。"
          }
        }
      }
    },
