      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные"
          }
        }
      }
    },
    "appearance.preview.fewData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add some operations and the theme will show on them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте операции, и тема покажется на них."
          }
        }
      }
    },
    "appearance.preview.noWrites": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes until you press Apply."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не изменится, пока вы не нажмёте «Применить»."
          }
        }
      }
    },
