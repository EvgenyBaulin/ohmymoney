        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин моҳ пардохти дигар нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay başka ödeme yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього місяця більше платежів немає"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy boshqa to‘lov yo‘q"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月无需再付款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月無須再付款"
          }
        }
      }
    },
    "form.pay.closesTermHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödəniş aylıq ödənişdən az olsa da, aylıq ödəniş edilmiş sayılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж лічыцца ўнесеным, хоць яго сума меншая за штомесячную."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Splátka se označí jako zaplacená, i když je tato platba nižší než měsíční splátka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fälligkeit gilt als bezahlt, auch wenn diese Zahlung kleiner ist als die monatliche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The due counts as paid although this payment is smaller than the monthly one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vencimiento cuenta como pagado aunque este pago sea menor que el mensual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'échéance compte comme payée, bien que ce paiement soit plus petit que la mensualité."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսական վճարը կհամարվի կատարված, թեև այս վճարումն ավելի փոքր է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rata risulta pagata anche se questo pagamento è inferiore a quello mensile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月の支払額より少なくても、今月分は支払い済みになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადასახადი დაფარულად ჩაითვლება, მიუხედავად იმისა, რომ ეს თანხა თვიურ გადასახადზე ნაკლებია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл төлем айлықтан кіші болса да, міндеттеме төленген деп саналады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 납입액이 월 납입액보다 적어도 납입 완료로 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул төлөм айлык төлөмдөн аз болсо да, мөөнөттөгү төлөм төлөндү деп саналат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De termijn geldt als betaald, ook al is deze betaling lager dan het maandbedrag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rata zostanie uznana za zapłaconą, choć ta wpłata jest od niej niższa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parcela será considerada paga, mesmo que este pagamento seja menor que o mensal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A prestação é considerada paga, embora este pagamento seja inferior ao valor mensal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок будет считаться оплаченным, хотя платёж меньше ежемесячного."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пардохти моҳона иҷрошуда ҳисоб мешавад, гарчанде ин пардохт аз он камтар аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödeme aylık tutardan az olsa da taksit ödenmiş sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж зараховано як сплачений, хоча він менший за місячний."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu to‘lov oylik to‘lovdan kam bo‘lsa ham, oylik to‘lov to‘langan deb hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虽然此笔付款少于月供，仍将本期视为已付。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雖然此筆付款低於每月還款額，仍將本期款項標記為已付。"
          }
        }
      }
    },
    "form.pay.expense": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditlərdə xərc kimi qeyd olunur və borc azalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдатак у катэгорыі «Пазыкі», а доўг памяншаецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výdaj v kategorii Půjčky a snížení dluhu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe in „Kredite“, und die Schuld sinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense in Loans, and the debt goes down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gasto en Préstamos, y la deuda baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense dans Crédits, et la dette baisse."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծախս «Վարկեր» բաժնում, իսկ պարտքը նվազում է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una spesa in Prestiti e il debito diminuisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ローン」に支出が記録され、負債が減ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯი სესხებში, ხოლო ვალი მცირდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Несиедегі» шығыс, ал берешек азаяды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대출 지출로 기록되고 부채가 줄어듭니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Насыяларда чыгаша жазылып, карыз азаят."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een uitgave in Leningen; de schuld neemt af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatek w kategorii Pożyczki, a dług maleje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma despesa em Empréstimos, e a dívida diminui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma despesa em Empréstimos e a dívida diminui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход в «Кредитах», и долг уменьшится."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷот дар «Қарзҳо» ва кам шудани қарз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediler'e gider kaydedilir ve borç azalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрата в «Кредитах», а борг зменшується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditlar bo‘limida xarajat qayd etiladi va qarz kamayadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“贷款”中记一笔支出，并减少债务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「貸款」記錄支出，並減少債務。"
          }
        }
      }
    },
    "form.pay.notExpense": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız borc azalır: alış xərc kimi qeyd olunub."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Памяншаецца толькі доўг: выдаткам была пакупка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sníží se jen dluh: výdajem byl nákup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Schuld sinkt: Der Kauf war die Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the debt goes down: the purchase was the expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo baja la deuda: el gasto fue la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la dette baisse : c'est l'achat qui était la dépense."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն պարտքն է նվազում․ ծախսն արդեն գրանցվել է գնման պահին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminuisce solo il debito: l'acquisto era la spesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負債のみが減ります。購入時に支出は記録済みです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ ვალი მცირდება: ხარჯი უკვე აღირიცხა შეძენისას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек берешек азаяды: шығыс — сатып алу болған."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부채만 줄어듭니다. 구매 시 지출이 기록되었습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карыз гана азаят: сатып алуу чыгаша катары жазылган."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de schuld neemt af: de aankoop was de uitgave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maleje tylko dług: wydatek zapisano przy zakupie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a dívida diminui: a compra já foi registrada como despesa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a dívida diminui: a compra foi a despesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только уменьшит долг: расходом была сама покупка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо қарз кам мешавад: харид ҳамчун хароҷот сабт шуда буд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca borç azalır: Gider, satın alma sırasında kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише борг зменшується: витратою була покупка."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat qarz kamayadi: xarid xarajat sifatida qayd etilgan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅减少债务：购买时已记为支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅減少債務：購買時已記錄支出。"
          }
        }
      }
    },
    "form.pay.over": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, qalıqdan (%1$@) %2$@ çoxdur. Borc bağlansa, artıq məbləğ silinər; açıq qalsa, −%2$@ göstərilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта на %2$@ больш за рэшту (%1$@). Пры закрыцці доўгу розніца спішацца; калі пакінуць яго адкрытым, будзе паказана −%2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je o %2$@ více, než zbývá (%1$@). Při uzavření se rozdíl odepíše; otevřený dluh zobrazí −%2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %2$@ mehr, als übrig ist (%1$@). Beendet, schreibt die Schuld es ab; offen gelassen, zeigt sie −%2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is %2$@ more than is left (%1$@). Closed, the debt writes it off; left open, it shows −%2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es %2$@ más de lo que queda (%1$@). Cerrada, la deuda da de baja ese exceso; abierta, muestra −%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est %2$@ de plus que ce qui reste (%1$@). Clôturée, la dette passe ce surplus en pertes ; laissée ouverte, elle affiche −%2$@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա %2$@-ով ավելի է մնացորդից (%1$@)։ Փակելու դեպքում տարբերությունը դուրս է գրվում, բաց թողնելու դեպքում ցուցադրվում է −%2$@։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %2$@ in più del residuo (%1$@). Se chiudi il debito, la differenza viene annullata; se lo lasci aperto, mostra −%2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残額（%1$@）を%2$@超えています。完済すると超過分は消去され、未完済のままにすると−%2$@と表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს დარჩენილ თანხაზე (%1$@) %2$@-ით მეტია. დახურვისას სხვაობა ჩამოიწერება; ღიად დატოვებისას გამოჩნდება −%2$@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қалғаннан (%1$@) %2$@ артық. Жабылса, берешек оны есептен шығарады; ашық қалса, −%2$@ көрсетіледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 금액(%1$@)보다 %2$@ 많습니다. 부채를 정리하면 초과분이 소멸되고, 유지하면 −%2$@로 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул калган суммадан (%1$@) %2$@ көп. Карыз жабылса, ашыгы эсептен чыгарылат; ачык калса, −%2$@ көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is %2$@ meer dan het restant (%1$@). Bij sluiten wordt het verschil kwijtgescholden; blijft de schuld open, dan wordt −%2$@ weergegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To o %2$@ więcej niż pozostało (%1$@). Po zamknięciu długu nadwyżka zostanie odpisana; jeśli pozostanie otwarty, pokaże −%2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é %2$@ a mais que o saldo restante (%1$@). Ao quitar, a diferença é baixada; se a dívida continuar aberta, ela mostrará −%2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São mais %2$@ do que o valor em dívida (%1$@). Se liquidar a dívida, a diferença é anulada; se a mantiver em aberto, mostra −%2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это на %2$@ больше остатка (%1$@). Закрытый долг спишет лишнее, открытый покажет остаток −%2$@."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин аз бақия (%1$@) ба андозаи %2$@ зиёд аст. Агар қарз баста шавад, зиёдатӣ соқит мешавад; агар кушода монад, −%2$@ нишон дода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kalan tutardan (%1$@) %2$@ fazla. Borç kapatılırsa fazla tutar silinir; açık bırakılırsa −%2$@ görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це на %2$@ більше, ніж лишилося (%1$@). Закритий борг списує це; відкритий показує −%2$@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qolgan summadan (%1$@) %2$@ ko‘p. Qarz yopilsa, ortiqcha summa hisobdan chiqariladi; ochiq qolsa, −%2$@ ko‘rsatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比剩余欠款（%1$@）多出%2$@。结清债务将核销多余金额；保留债务则显示−%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超出剩餘金額（%1$@）%2$@。結清債務時會沖銷超額部分；保留債務時則顯示 −%2$@。"
          }
        }
      }
    },
    "form.pay.overSurplus": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, qalıqdan (%1$@) %2$@ çoxdur. Borc qalan məbləğlə bağlanır, %2$@ isə Əlavə ödənişlərdə gəlirə yazılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта на %2$@ больш за рэшту (%1$@). Доўг закрыецца на суму рэшты, а %2$@ пойдзе ў даход у катэгорыі «Даплаты»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je o %2$@ více, než zbývá (%1$@). Dluh se doplatí zbývající částkou a %2$@ se připíše jako příjem v kategorii Příplatky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %2$@ mehr, als übrig ist (%1$@). Die Schuld endet mit dem Rest, und %2$@ wird als Einnahme bei den Aufschlägen verbucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is %2$@ more than is left (%1$@). The debt closes with what is left, and %2$@ goes to income in Surcharges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es %2$@ más de lo que queda (%1$@). La deuda se cierra con lo que queda, y %2$@ va a ingresos en Recargos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est %2$@ de plus que ce qui reste (%1$@). La dette se clôt avec ce qui reste, et %2$@ va en revenu dans Surplus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա %2$@-ով ավելի է մնացորդից (%1$@)։ Պարտքը փակվում է մնացորդի չափով, իսկ %2$@-ը գրանցվում է որպես եկամուտ «Հավելավճարներ» բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %2$@ in più del residuo (%1$@). Il debito si chiude con il residuo e %2$@ vanno nelle entrate in Maggiorazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残額（%1$@）を%2$@超えています。残額を支払って完済し、%2$@は「追加料金」の収入になります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს დარჩენილ თანხაზე (%1$@) %2$@-ით მეტია. ვალი დარჩენილი თანხით დაიხურება, ხოლო %2$@ შემოსავლად აღირიცხება კატეგორიაში „ზედმეტი გადახდები“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қалғаннан (%1$@) %2$@ артық. Берешек қалғанмен жабылады, ал %2$@ «Үстемақылардағы» табысқа кетеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 금액(%1$@)보다 %2$@ 많습니다. 남은 금액만큼 부채가 정리되고 %2$@은 추가 수입으로 기록됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул калган суммадан (%1$@) %2$@ көп. Карыз калган суммага жабылып, %2$@ Кошумча төлөмдөрдөгү кирешеге кошулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is %2$@ meer dan het restant (%1$@). De schuld wordt met het restant gesloten en %2$@ gaat naar inkomsten in Toeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To o %2$@ więcej niż pozostało (%1$@). Dług zostanie zamknięty pozostałą kwotą, a %2$@ trafi do przychodów w kategorii Dopłaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é %2$@ a mais que o saldo restante (%1$@). A dívida é quitada pelo saldo restante, e %2$@ é registrado como receita em Acréscimos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São mais %2$@ do que o valor em dívida (%1$@). A dívida é liquidada pelo valor restante e %2$@ são registados como receita em Acréscimos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это на %2$@ больше остатка (%1$@). Долг закроется остатком, а %2$@ станут доходом в «Доплатах»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин аз бақия (%1$@) ба андозаи %2$@ зиёд аст. Қарз бо бақия баста мешавад ва %2$@ ба даромади «Иловапардохтҳо» меравад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kalan tutardan (%1$@) %2$@ fazla. Borç kalan tutarla kapanır ve %2$@, Ek Ödemeler'e gelir olarak kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це на %2$@ більше, ніж лишилося (%1$@). Борг закривається з тим, що лишилося, а %2$@ іде в доходи в «Надбавках»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qolgan summadan (%1$@) %2$@ ko‘p. Qarz qolgan summa bilan yopiladi, %2$@ esa Qo‘shimcha to‘lovlarda daromadga o‘tadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比剩余欠款（%1$@）多出%2$@。剩余欠款将被结清，%2$@将在“附加款”中记为收入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超出剩餘金額（%1$@）%2$@。剩餘金額用於結清債務，%2$@ 記為「附加費」收入。"
          }
        }
      }
    },
    "form.pay.returned": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şəxs pulu qaytarıb: gəlir deyil, borc azalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чалавек вярнуў грошы: гэта не даход, доўг памяншаецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze vrácené dlužníkem: nejde o příjem, dluh se sníží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Menschen zurückgegebenes Geld: keine Einnahme, die Schuld sinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money returned by the person: not income, the debt goes down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinero devuelto por la persona: no es ingreso, la deuda baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argent rendu par la personne : ce n'est pas un revenu, la dette baisse."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անձի վերադարձրած գումարը եկամուտ չէ․ պարտքը նվազում է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Denaro restituito dalla persona: non è un'entrata, il debito diminuisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手から返金されました。収入にはならず、負債が減ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პირის მიერ დაბრუნებული თანხა: შემოსავალი არ არის, ვალი მცირდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адам қайтарған ақша: табыс емес, берешек азаяды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방이 돌려준 돈입니다. 수입으로 기록되지 않고 부채가 줄어듭니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адам кайтарган акча: киреше эмес, карыз азаят."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugbetaald door de persoon: geen inkomsten, de schuld neemt af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot pieniędzy od tej osoby nie jest przychodem: dług maleje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinheiro devolvido pela pessoa: não é receita, a dívida diminui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinheiro devolvido pela pessoa: não é receita, a dívida diminui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги вернул человек: это не доход, долг уменьшится."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пулро шахс баргардонд: даромад нест, қарз кам мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişinin geri ödediği para: Gelir sayılmaz, borç azalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші повернула людина: це не дохід, а борг зменшується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odam qaytargan pul: daromad emas, qarz kamayadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方还款：减少债务，不计为收入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方歸還的款項不記為收入，只減少債務。"
          }
        }
      }
    },
