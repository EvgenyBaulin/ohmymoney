    "debts.delete.journal": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Доўг і яго журнал (%lld запісы) будуць выдалены. Гэты доўг больш не будзе ўлічвацца ў напамінах і свабоднай суме."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Доўг і яго журнал (%lld запісаў) будуць выдалены. Гэты доўг больш не будзе ўлічвацца ў напамінах і свабоднай суме."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Доўг і яго журнал (%lld запіс) будуць выдалены. Гэты доўг больш не будзе ўлічвацца ў напамінах і свабоднай суме."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Доўг і яго журнал (%lld запісу) будуць выдалены. Гэты доўг больш не будзе ўлічвацца ў напамінах і свабоднай суме."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Schuld und ihr Journal (%lld Eintrag) werden gelöscht. Erinnerungen und der freie Betrag enthalten diese Schuld nicht mehr."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Schuld und ihr Journal (%lld Einträge) werden gelöscht. Erinnerungen und der freie Betrag enthalten diese Schuld nicht mehr."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The debt and its journal (%lld entry) will be deleted. Reminders and the free sum will no longer include this debt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The debt and its journal (%lld entries) will be deleted. Reminders and the free sum will no longer include this debt."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Il debito e il relativo registro (%lld voci) verranno eliminati. I promemoria e la somma disponibile non includeranno più questo debito."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Il debito e il relativo registro (%lld voce) verranno eliminati. I promemoria e la somma disponibile non includeranno più questo debito."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Il debito e il relativo registro (%lld voci) verranno eliminati. I promemoria e la somma disponibile non includeranno più questo debito."
                }
              }
            }
          }
        },
        "kk": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Берешек пен оның журналы (%lld жазба) жойылады. Еске салғыштар мен бос қаржыда бұл берешек енді болмайды."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Берешек пен оның журналы (%lld жазба) жойылады. Еске салғыштар мен бос қаржыда бұл берешек енді болмайды."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Долг и его журнал (%lld записи) будут удалены. Долг перестанет учитываться в напоминаниях и свободной сумме."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Долг и его журнал (%lld записей) будут удалены. Долг перестанет учитываться в напоминаниях и свободной сумме."
                }
