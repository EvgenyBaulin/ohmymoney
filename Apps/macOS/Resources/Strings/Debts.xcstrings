            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Борг і його журнал (%lld записи) буде видалено. Нагадування й вільна сума більше не враховуватимуть цей борг."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Борг і його журнал (%lld записів) буде видалено. Нагадування й вільна сума більше не враховуватимуть цей борг."
