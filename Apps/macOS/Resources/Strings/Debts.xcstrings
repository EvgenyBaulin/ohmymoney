        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lawine spart ≈ %@ Zinsen und %@ gegenüber dem Schneeball."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The avalanche saves ≈ %@ of interest and %@ against the snowball."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La avalancha ahorra ≈ %@ de intereses y %@ frente a la bola de nieve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'avalanche économise ≈ %@ d'intérêts et %@ par rapport à la boule de neige."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La valanga fa risparmiare ≈ %@ di interessi e %@ rispetto alla palla di neve."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аваланш снежболға қарағанда ≈ %@ пайыз және %@ үнемдейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawina pozwala zaoszczędzić ≈ %@ na odsetkach i %@ względem śnieżnej kuli."
          }
        },
        "pt-BR": {
          "stringUnit": {
