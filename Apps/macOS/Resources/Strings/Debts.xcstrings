    "form.balance.negative": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доўг не можа быць меншы за нуль."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was geschuldet wird, kann nicht unter null liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is owed cannot be below zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se debe no puede ser menor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est dû ne peut pas être inférieur à zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importo dovuto non può essere inferiore a zero."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек нөлден төмен бола алмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota do spłaty nie może być mniejsza od zera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo devedor não pode ser menor que zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток не может быть меньше нуля."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan borç sıfırın altında olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума боргу не може бути меншою за нуль."
          }
        },
