            "value": "Это платёж вперёд"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пардохти пешакӣ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecek taksitlerin ödemesi"
          }
        },
        "uk": {
