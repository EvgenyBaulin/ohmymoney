    "debts.journal.closesTermHelp": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödənişlə bildirilib: bu ay daha ödəniş olmayacaq"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты плацёж закрывае ўсе плацяжы за месяц"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Touto platbou potvrzujete, že tento měsíc už nebudou další platby"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser Zahlung gesagt: keine weiteren Zahlungen in diesem Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Said with this payment: no more payments this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se indicó con este pago: no habrá más pagos este mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiqué avec ce paiement : plus de paiements ce mois-ci"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս վճարմամբ նշվել է, որ այս ամիս այլ վճարումներ չեն լինի"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questo pagamento non sono previsti altri pagamenti per questo mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支払いで今月分の返済を完了"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ გადახდით მონიშნულია: ამ თვეში გადახდები აღარ იქნება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы төлеммен айтылған: осы айда басқа төлем жоқ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결제로 이번 달 상환이 완료되었음을 표시합니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул төлөм менен айдын төлөмдөрү аяктаганы белгиленди"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze betaling aangegeven: deze maand volgen geen betalingen meer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta płatność oznacza koniec spłat w tym miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pagamento encerra os pagamentos do mês"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pagamento indica que não haverá mais pagamentos este mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сказано при этом платеже: в этом месяце больше платежей не будет"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо ин пардохт нишон дода шуд: ин моҳ дигар пардохт нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödeme ile bu ay başka ödeme yapılmayacağı belirtildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сказано цим платежем: більше платежів цього місяця не буде"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushbu to‘lov bilan belgilangan: bu oy boshqa to‘lov yo‘q"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次还款后，本月无需再还款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表示本次付款後，本月無須再付款"
          }
        }
      }
    },
