    "form.name.isAnAccount": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» artıq hesabdır. Kredit kartı borc deyil, mənfi balanslı hesab kimi saxlanılır — əks halda borc iki dəfə çıxılar. Borc kredit və ya taksit üçündür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ужо з'яўляецца рахункам. Крэдытная картка захоўваецца як рахунак з адмоўным балансам, а не як доўг — інакш доўг будзе адлічаны двойчы. Доўг прызначаны для пазыкі або растэрміноўкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» už je účet. Kreditní karta se vede jako účet se záporným zůstatkem, ne jako dluh — jinak by se její dluh odečetl dvakrát. Dluh slouží pro půjčku nebo splátkový prodej."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits ein Konto. Eine Kreditkarte wird als Konto mit Saldo im Minus geführt, nicht als Schuld — sonst wird ihre Schuld zweimal abgezogen. Eine Schuld ist für einen Kredit oder eine Ratenzahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» is an account already. A credit card is kept as an account with a minus balance, not as a debt — or its debt is taken off twice. A debt is for a loan or an instalment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya es una cuenta. Una tarjeta de crédito se guarda como cuenta con saldo negativo, no como deuda — o su deuda se restaría dos veces. La deuda es para un préstamo o un plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà un compte. Une carte de crédit se garde comme compte au solde négatif, pas comme une dette — sinon sa dette est retirée deux fois. Une dette sert pour un crédit ou un échéancier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»-ն արդեն հաշիվ է։ Վարկային քարտը պահվում է որպես բացասական մնացորդով հաշիվ, ոչ թե պարտք, այլապես պարտքը երկու անգամ կհաշվվի։ Պարտքը նախատեսված է վարկի կամ ապառիկի համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è già un conto. Una carta di credito si registra come conto con saldo negativo, non come debito, altrimenti il debito viene conteggiato due volte. Un debito serve per prestiti e rate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»はすでに口座です。クレジットカードは負債ではなく、残高がマイナスの口座として管理します。負債としても記録すると、二重に差し引かれます。負債はローンや分割払いに使います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» უკვე ანგარიშადაა დამატებული. საკრედიტო ბარათი უარყოფითი ნაშთის მქონე ანგარიშად ინახება და არა ვალად — თორემ ვალი ორჯერ გამოიქვითება. ვალი სესხისთვის ან განვადებისთვისაა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» бұрыннан есеп-шот. Кредиттік карта теріс теңгерімі бар есеп-шот ретінде сақталады, берешек ретінде емес — әйтпесе оның берешегі екі рет алынады. Берешек — несие немесе бөліп төлеу үшін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»은 이미 계좌입니다. 신용카드는 부채가 아닌 마이너스 잔액의 계좌로 관리합니다. 부채로도 등록하면 두 번 차감됩니다. 부채는 대출이나 할부에 사용합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» мурунтан эле эсеп болуп саналат. Кредиттик карта карыз катары эмес, терс баланстуу эсеп катары сакталат — болбосо карыз эки жолу кемитилет. Карыз насыя же бөлүп төлөө үчүн колдонулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» is al een rekening. Een creditcard wordt bijgehouden als rekening met een negatief saldo, niet als schuld. Anders wordt de schuld dubbel afgetrokken. Een schuld is bedoeld voor een lening of betaling in termijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» jest już kontem. Kartę kredytową zapisz jako konto z ujemnym saldem, a nie jako dług — inaczej dług zostanie odliczony dwa razy. Dług służy do zapisywania pożyczek i rat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» já é uma conta. Um cartão de crédito é mantido como conta com saldo negativo, não como dívida — senão, a dívida é descontada duas vezes. Use uma dívida para empréstimos ou parcelamentos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» já é uma conta. Um cartão de crédito é registado como uma conta com saldo negativo, não como uma dívida — caso contrário, a dívida é descontada duas vezes. Uma dívida serve para um empréstimo ou uma compra a prestações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — это уже счёт. Кредитную карту ведут счётом с отрицательным остатком, а не долгом: иначе её долг вычтется дважды. Долг заводят для кредита или рассрочки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» аллакай ҳисоб аст. Корти кредитӣ ҳамчун ҳисоб бо бақияи манфӣ нигоҳ дошта мешавад, на ҳамчун қарз — вагарна қарз ду бор кам мешавад. Қарз барои вом ё хариди қисмӣ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» zaten bir hesap. Kredi kartı, borç olarak değil, eksi bakiyeli bir hesap olarak tutulur; aksi takdirde borcu iki kez düşülür. Borç, kredi veya taksit içindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» вже є рахунком. Кредитна картка зберігається як рахунок з мінусовим залишком, а не як борг — інакше її борг буде віднято двічі. Борг — для кредиту або розстрочки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» allaqachon hisob sifatida mavjud. Kredit karta qarz emas, manfiy balansli hisob sifatida saqlanadi — aks holda uning qarzi ikki marta hisoblanadi. Qarz kredit yoki bo‘lib to‘lash uchun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»已是一个账户。信用卡应记为负余额账户，而不是债务，否则会重复扣除欠款。债务适用于贷款或分期付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已是帳戶。信用卡應記為負餘額帳戶，而非債務，否則債務會被扣除兩次。債務適用於貸款或分期付款。"
          }
        }
      }
    },
