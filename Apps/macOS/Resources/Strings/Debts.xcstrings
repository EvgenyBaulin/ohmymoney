    "form.adjust.negative": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніжэй за нуль: гэта азначае, што аплачана на %@ больш за доўг. Вы гэта мелі на ўвазе?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter null: Das heißt, es wurden %@ mehr bezahlt, als geschuldet war. Ist das gemeint?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below zero: that says %@ more was paid than owed. Is that what you mean?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de cero: eso dice que se pagaron %@ más de lo que se debía. ¿Es lo que quiere decir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous zéro : cela signifie que %@ de plus ont été payés que dus. Est-ce bien votre intention ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto zero: indica che sono stati pagati %@ in più del dovuto. È corretto?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөлден төмен: бұл берешектен %@ артық төленгенін білдіреді. Солай ма?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej zera: oznacza to, że spłacono o %@ więcej niż wynosił dług. Czy o to chodzi?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo de zero: isso indica que foram pagos %@ a mais que o devido. É isso mesmo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше нуля: выходит, заплачено на %@ больше долга. Так и задумано?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırın altında: Bu, borçtan %@ fazla ödendiği anlamına gelir. Bunu mu demek istediniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче нуля: це означає, що сплачено на %@ більше, ніж винні. Це те, що ви мали на увазі?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Noldan kam: bu qarzdan %@ ko‘proq to‘langanini bildiradi. Shuni nazarda tutdingizmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於零代表已付款超過應付金額 %@。確定要這樣設定嗎？"
          }
        }
      }
    },
