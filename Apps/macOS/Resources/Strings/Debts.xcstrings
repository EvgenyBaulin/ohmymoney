            "value": "Upravte text podle sebe. Příští připomenutí začne vašimi slovy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern Sie den Text so, wie Sie es sagen würden: Die nächste Erinnerung beginnt mit Ihren Worten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit the text as you would say it: the next reminder starts from your words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite el texto como lo diría usted: el siguiente recordatorio parte de sus palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez le texte comme vous le diriez : la prochaine relance part de vos mots."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խմբագրեք տեքստը ձեր բառերով․ հաջորդ հիշեցումը կսկսվի դրանցից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica il testo come preferisci: il prossimo promemoria partirà dalle tue parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の言葉に合わせて編集してください。次回もこの文章が使われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეცვალეთ ტექსტი თქვენი სიტყვებით: შემდეგი შეხსენებაც ამ ტექსტით დაიწყება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мәтінді өзіңіз айтатындай түзетіңіз: келесі еске салу сіздің сөзіңізден басталады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 말투에 맞게 수정하세요. 다음 알림에도 이 문구가 사용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстти өзүңүз айткандай оңдоңуз: кийинки эскертүү сиздин сөздөрүңүз менен башталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de tekst aan zoals je het zelf zou zeggen. De volgende herinnering begint met jouw woorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień tekst na własne słowa: kolejne przypomnienie zacznie się od nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite o texto com suas palavras: o próximo lembrete usará este texto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite o texto à sua maneira: o próximo lembrete usará as suas palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поправьте текст, как сказали бы сами: следующее напоминание начнётся с ваших слов."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Матнро бо суханони худ нависед: ёдрасии оянда аз ҳамин матн оғоз мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni kendi sözlerinizle düzenleyin: Sonraki hatırlatma bu metinle başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть текст так, як сказали б самі: наступне нагадування почнеться з ваших слів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Matnni o‘z so‘zlaringiz bilan tahrirlang: keyingi eslatma shu matndan boshlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的习惯编辑文字，下次提醒将以此为基础。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用自己的語氣編輯文字，下次提醒會沿用你的文字。"
          }
        }
      }
    },
    "nudge.template": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Salam, {name}! Mümkün olanda {amount}[ — {for} üçün][, {date} tarixinədək] qaytara bilərsən?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прывітанне, {name}! Ці можаш вярнуць {amount}[ за {for}][ да {date}], калі будзе магчымасць?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj {name}! Můžeš mi prosím vrátit {amount}[ za {for}][ do {date}], až budeš moct?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo {name}! Kannst du {amount}[ für {for}][ bis {date}] zurückgeben, wenn es passt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi {name}! Could you give back {amount}[ for {for}][ by {date}] when you can?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola, {name}! ¿Podrías devolver {amount}[ por {for}][ antes del {date}] cuando puedas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour {name} ! Pourriez-vous rendre {amount}[ pour {for}][ avant le {date}] quand vous le pourrez ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բարև, {name}։ Կարո՞ղ ես վերադարձնել {amount}[՝ {for}-ի համար][ մինչև {date}], երբ կարողանաս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao {name}! Potresti restituirmi {amount}[ per {for}][ entro {date}] quando puoi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{name}さん、こんにちは！[ {for}の]{amount}を[ {date}までに]都合のよいときに返してもらえますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამარჯობა, {name}! შეძლებ, როცა მოახერხებ, დამიბრუნო {amount}[ — {for}][, {date}-მდე]?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сәлем, {name}! Ыңғайлы кезде {amount}[ {for} үшін][ {date} дейін] қайтара аласыз ба?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕, {name}! 시간 될 때 {amount}[ ({for})][, {date}까지] 돌려줄 수 있을까?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Салам, {name}! Мүмкүн болгондо {amount}[ — {for} үчүн][, {date} чейин] кайтарып бере аласыңбы?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoi {name}! Zou je {amount}[ voor {for}][ vóór {date}] kunnen terugbetalen als het je uitkomt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć {name}! Czy możesz oddać {amount}[ za {for}][ do {date}], gdy będziesz mieć możliwość?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oi, {name}! Você pode me devolver {amount}[ de {for}][ até {date}] quando puder?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, {name}! Podes devolver-me {amount}[ de {for}][ até {date}] quando puderes?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{имя}, привет! Вернёшь {сумма}[ за {за что}][ до {дата}], когда сможешь?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Салом, {name}! Метавонӣ {amount}-ро[ барои {for}][ то {date}], вақте ки имкон дорӣ, баргардонӣ?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba {name}! Müsait olduğunda[ {for} için] {amount} tutarını[ {date} tarihine kadar] geri verebilir misin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Привіт, {name}! Коли буде змога, поверни, будь ласка, {amount}[ за {for}][ до {date}]?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Salom, {name}! Imkoning bo‘lganda {amount}ni[ {for} uchun][ {date}gacha] qaytarib bera olasanmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嗨，{name}！方便的时候可以把{amount}[（{for}）][在{date}前]还给我吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嗨，{name}！方便的話，可以把{amount}[的{for}][在{date}前]還給我嗎？"
          }
        }
      }
    },
