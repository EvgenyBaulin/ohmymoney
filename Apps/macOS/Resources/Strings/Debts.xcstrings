          }
        }
      }
    },
    "debts.toggleMessage": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменіцца ўлік усіх плацяжоў па гэтым доўгу, у тым ліку мінулых: як выдаткаў у раздзеле «Пазыкі» або толькі як памяншэння доўгу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ändert, wie jede Zahlung dieser Schuld zählt, auch die vergangenen: als Ausgabe in „Kredite“ oder nur als kleinere Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes how every payment of this debt counts, the past ones included: as an expense in Loans, or only as a smaller debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cambia cómo cuenta cada pago de esta deuda, también los pasados: como gasto en Préstamos, o solo como una deuda menor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela change la façon dont chaque paiement de cette dette compte, y compris les anciens : comme dépense dans Crédits, ou seulement comme une dette réduite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia il modo in cui vengono conteggiati tutti i pagamenti di questo debito, inclusi quelli passati: come spesa in Prestiti o solo come riduzione del debito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл берешектің әр төлемі қалай есептелетінін өзгертеді, өткендері де кіреді: «Несиедегі» шығыс ретінде не тек азайған берешек ретінде."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieni to sposób rozliczania wszystkich spłat tego długu, także wcześniejszych: jako wydatków w kategorii Pożyczki lub tylko jako zmniejszenia długu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso altera como todos os pagamentos desta dívida são contabilizados, inclusive os anteriores: como despesa em Empréstimos ou apenas como redução da dívida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это меняет учёт всех платежей по этому долгу, в том числе прошлых: расход в «Кредитах» или только уменьшение долга."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, geçmiş ödemeler dahil bu borcun tüm ödemelerinin nasıl sayılacağını değiştirir: Krediler'de gider olarak veya yalnızca borcun azalması olarak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це змінює те, як зараховується кожен платіж за цим боргом, включно з минулими: як витрата в «Кредитах» або лише як менший борг."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qarzning barcha to‘lovlari, jumladan avvalgilari ham qanday hisoblanishini o‘zgartiradi: ular «Qarzlar»da xarajat sifatida yoki faqat qarzni kamaytiruvchi to‘lov sifatida hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會更改此債務所有付款的計算方式，包括過去的付款：計為貸款支出，或僅減少債務。"
          }
        }
      }
    },
