    "ladder.avalanche.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəl ən yüksək faizli borc: ən az faiz ödənişi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку найбольшая стаўка: найменшыя працэнты."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve nejvyšší sazba: nejméně zaplacených úroků."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst der höchste Zinssatz: die wenigsten Zinsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The highest rate first: the least interest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero el tipo más alto: los intereses más bajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux le plus élevé d'abord : le moins d'intérêts."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սկզբում՝ ամենաբարձր տոկոսադրույքը․ ավելի քիչ տոկոսներ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima il tasso più alto: meno interessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金利の高い順に返済し、利息を抑えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ ყველაზე მაღალი განაკვეთი: ნაკლები პროცენტი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең жоғары мөлшерлеме бірінші: ең аз пайыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이율이 높은 부채부터 상환하여 이자를 줄입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адегенде эң жогорку чен: пайыз азыраак төлөнөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogste rente eerst: de minste rente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw najwyższe oprocentowanie: najmniej odsetek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maior taxa primeiro: menos juros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa mais alta primeiro: menos juros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала самая высокая ставка — меньше всего процентов."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аввал фоизи баландтарин: фоизи умумӣ камтар мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce en yüksek faiz: En az faiz ödemesi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу найвища ставка: найменше відсотків."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval eng yuqori stavka: eng kam foiz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先偿还利率最高的债务，利息最少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先還利率最高的債務，支付的利息最少。"
          }
        }
      }
    },
    "ladder.card.avalanche": {
      "extractionState": "manual",
      "localizations": {
