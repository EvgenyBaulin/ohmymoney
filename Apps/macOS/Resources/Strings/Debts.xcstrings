    "schedule.card.mainLater": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З %@ — асноўны графік; плацеж разлічваецца па доўгу на гэты дзень"
          }
        },
        "de": {
          "stringUnit": {
