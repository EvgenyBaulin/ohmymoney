          "stringUnit": {
            "state": "translated",
            "value": "購入時に支出を記録し、返済で負債を減額"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯი ერთხელ აისახება, გადახდები კი მხოლოდ ვალს ამცირებს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "шығыс бір рет, төлемдер тек берешекті азайтады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출은 한 번 기록하고 납부금은 부채만 줄입니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "чыгым бир жолу жазылат, төлөмдөр карызды гана азайтат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "de uitgave wordt eenmaal geboekt; betalingen verlagen alleen de schuld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "wydatek jednorazowy, raty tylko zmniejszają dług"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a despesa é registrada uma vez; os pagamentos apenas reduzem a dívida"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "a despesa é registada uma vez; os pagamentos apenas reduzem a dívida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "расход один раз при покупке, платежи уменьшают долг"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "харҷ як бор сабт мешавад, пардохтҳо танҳо қарзро кам мекунанд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "gider bir kez kaydedilir, ödemeler yalnızca borcu azaltır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "витрата один раз, платежі лише зменшують борг"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "xarajat bir marta yoziladi, to‘lovlar faqat qarzni kamaytiradi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支出只计一次，之后还款仅减少欠款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出只計一次，之後付款僅減少債務"
          }
        }
      }
    },
