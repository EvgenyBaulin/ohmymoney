    "instalmentReturn.markup.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доўг таксама паменшыцца на %@: пераплату па яшчэ не аплачаных частках. Сумы частак застануцца ранейшымі; выплаты скончацца раней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schuld sinkt außerdem um %@: die Überzahlung der noch nicht gezahlten Raten. Die Raten behalten ihre Beträge; die Zahlungen enden früher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The debt also goes down by %@: the overpayment of the parts not paid yet. The parts keep their amounts; the payments end earlier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La deuda también baja en %@: el sobrepago de los plazos aún no pagados. Los plazos conservan sus importes; los pagos terminan antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dette baisse aussi de %@ : le trop-perçu des tranches pas encore payées. Les tranches gardent leurs montants ; les paiements s'arrêtent plus tôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il debito diminuisce anche di %@: il costo aggiuntivo delle rate non ancora pagate. Gli importi delle rate restano invariati; i pagamenti terminano prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек %@ азаяды: әлі төленбеген бөліктердің артық төлемі. Бөліктердің сомасы сол қалады; төлемдер ертерек аяқталады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dług zmaleje też o %@: nadpłatę za niezapłacone jeszcze raty. Kwoty rat pozostaną bez zmian, a spłata zakończy się wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A dívida também diminui em %@: o acréscimo das parcelas ainda não pagas. Os valores das parcelas permanecem iguais; os pagamentos terminam antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долг уменьшится ещё на %@: переплата неоплаченных частей. Суммы частей прежние, платежи закончатся раньше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borç ayrıca %@ azalır: Henüz ödenmemiş taksitlerin vade farkı. Taksit tutarları değişmez; ödemeler daha erken biter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Борг також зменшується на %@: переплата за ще не сплачені частини. Частини лишаються на своїх сумах, платежі закінчуються раніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarz yana %@ ga kamayadi: bu hali to‘lanmagan qismlarning ortiqcha to‘lovidir. Qismlar summasi o‘zgarmaydi; to‘lovlar ertaroq tugaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "債務將再減少 %@，即未付款期數的加價金額。各期金額不變，付款將提早結束。"
          }
        }
      }
    },
