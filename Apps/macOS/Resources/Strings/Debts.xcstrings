        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Said with this payment: no more payments this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se indicó con este pago: no habrá más pagos este mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiqué avec ce paiement : plus de paiements ce mois-ci"
