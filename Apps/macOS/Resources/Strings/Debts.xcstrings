    "debts.delete.cash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money that changed hands through the journal stays in the account balances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero que pasó por el diario se mantiene en los saldos de las cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent qui a transité par le journal reste dans les soldes des comptes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги, которые по журналу переходили из рук в руки, остаются в остатках счетов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші, що пройшли через журнал, лишаються в залишках рахунків."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli importi trasferiti tramite il registro rimangono nei saldi dei conti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал арқылы қолдан-қолға өткен ақша есеп-шот теңгерімдерінде қалады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы, перададзеныя праз журнал, застануцца ў балансах рахункаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld, das über das Journal den Besitzer wechselte, bleibt in den Kontosalden."
          }
        }
      }
    },
