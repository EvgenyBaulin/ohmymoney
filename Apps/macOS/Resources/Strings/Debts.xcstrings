    "debts.closedCaption": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доўг закрыты. Каб дадаваць плацяжы, запісы і пераводы, спачатку адкрыйце яго зноў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schuld ist beendet. Zahlungen, Einträge und Überweisungen gelten für offene Schulden: Öffnen Sie sie zuerst wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The debt is closed. Payments, entries and transfers are for open debts: reopen it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La deuda está cerrada. Los pagos, apuntes y transferencias son para deudas abiertas: primero reábrala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dette est clôturée. Les paiements, saisies et virements concernent les dettes ouvertes : rouvrez-la d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il debito è chiuso. Per aggiungere pagamenti, voci o trasferimenti, riaprilo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек жабық. Төлемдер, жазбалар және аударымдар ашық берешектерге арналған: алдымен оны қайта ашыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dług jest zamknięty. Aby dodać płatność, wpis lub przelew, najpierw otwórz go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A dívida está encerrada. Para adicionar pagamentos, lançamentos ou transferências, reabra-a primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долг закрыт. Платежи, записи и переносы — только у открытых долгов: сначала верните его в открытые."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu borç kapalı. Ödeme, kayıt ve transfer eklemek için önce borcu yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Борг закрито. Платежі, записи й перекази належать відкритим боргам: спершу відкрийте його знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarz yopilgan. To‘lovlar, yozuvlar va o‘tkazmalar faqat ochiq qarzlar uchun: avval qarzni qayta oching."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "債務已結清。請先重新開啟，才能付款、新增記錄或轉帳。"
          }
        }
      }
    },
