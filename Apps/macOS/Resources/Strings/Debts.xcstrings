    "wizard.markup.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the plan costs above the price, all parts together: it is spent part by part."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cuesta el plan por encima del precio, todas las partes juntas: se gasta parte a parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que coûte le plan au-dessus du prix, toutes tranches confondues : il se dépense tranche par tranche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько рассрочка стоит сверх цены, за все части: тратится частями, с каждым платежом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки план коштує понад ціну, усі частини разом: сплачується по частинах."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il costo totale del piano oltre al prezzo, distribuito tra tutte le rate: viene registrato come spesa rata per rata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоспар бағадан қанша артық тұратыны, барлық бөлік бірге: ол бөлік-бөлік жұмсалады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Агульная сума звыш цаны: яна ўлічваецца як расход часткамі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der Plan über dem Preis kostet, alle Raten zusammen: Er wird Rate für Rate ausgegeben."
          }
        }
      }
    },
