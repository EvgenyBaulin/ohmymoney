    "pledge.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pledge is not spending: it is money owed back to you. A week before the day it is reminded of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una garantía no es gasto: es dinero que le deben devolver. Una semana antes del día se le recuerda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Залог — не трата, а деньги, которые вам вернут. За неделю до срока будет напоминание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застава — не витрата: це гроші, які вам мають повернути. За тиждень до дня нагадаємо."
          }
        }
      }
    },
