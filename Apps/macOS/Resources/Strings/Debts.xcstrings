          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un relevé n'a pas été réglé : toute la dette de la carte est désormais exigible"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քաղվածքը չի վճարվել․ քարտի ամբողջ գումարն այժմ պարտք է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un estratto conto non è stato pagato: ora l’intero importo della carta è un debito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求が未払いです。カードの利用残高全額が借入になりました"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამონაწერის გადახდის ვადა გასულია: ბარათის მთელი თანხა ახლა ვალია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үзінді төленбей қалды: картаның бүкіл берешегі енді қарыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제일을 놓쳐 카드 미상환액 전체가 빚으로 처리됩니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көчүрмө өз убагында төлөнгөн жок: эми картанын бүт калдыгы карыз болуп эсептелет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een afschrift is niet betaald: de volledige creditcardschuld is nu opeisbaar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie spłacono wyciągu: całe zadłużenie karty jest teraz długiem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fatura não foi paga: agora, todo o saldo do cartão é uma dívida"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um extrato não foi pago: todo o saldo do cartão está agora em dívida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок выписки пропущен: вся задолженность по карте теперь долг"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муҳлати пардохти иқтибос гузашт: ҳоло тамоми маблағи корт қарз аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ekstre ödenmedi. Kartın tüm bakiyesi artık borçtur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виписку пропущено: весь борг по картці тепер є боргом"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobot to‘lovi o‘tkazib yuborildi: endi kartadagi butun summa qarz hisoblanadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账单未按时还款，信用卡全部欠款现已计为债务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳單未按時繳清：信用卡全部欠款現已列為債務"
          }
        }
      }
    },
