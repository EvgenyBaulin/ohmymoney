    "pledge.writeOff.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Girovun qalan hissəsi seçilmiş kateqoriyada xərc kimi qeydə alınır və girov bağlanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэшта закладу стане выдаткам у выбранай катэгорыі, а заклад закрыецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývající část zálohy se stane výdajem ve vybrané kategorii a záloha se uzavře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was von der Sicherheitsleistung übrig ist, wird zur Ausgabe in der gewählten Kategorie, und die Sicherheitsleistung wird beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is left of the pledge becomes spending in the category chosen, and the pledge closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que queda de la garantía pasa a ser gasto en la categoría elegida, y la garantía se cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste de la caution devient une dépense dans la catégorie choisie, et la caution se clôt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրավի մնացորդը դառնում է ընտրված կատեգորիայի ծախս, և գրավը փակվում է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo residuo del deposito diventa una spesa nella categoria scelta e il deposito viene chiuso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "預け金の残額を選択したカテゴリの支出として計上し、預け金を終了します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გირაოს დარჩენილი თანხა არჩეულ კატეგორიაში ხარჯად ჩაიწერება და გირაო დაიხურება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кепілдіктен қалғаны таңдалған санатта шығысқа айналады, ал кепілдік жабылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 보증금은 선택한 카테고리의 지출로 처리되고 보증금이 종료됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күрөөнүн калдыгы тандалган категориядагы чыгашага айланат жана күрөө жабылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De resterende borg wordt een uitgave in de gekozen categorie en de borg wordt afgesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostała kwota kaucji stanie się wydatkiem w wybranej kategorii, a kaucja zostanie zamknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor restante da caução se torna uma despesa na categoria escolhida, e a caução é encerrada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor restante da caução passa a despesa na categoria escolhida e a caução é encerrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток залога станет тратой в выбранной категории, залог закроется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи гарав ба хароҷоти категорияи интихобшуда мегузарад ва гарав баста мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depozitonun kalan tutarı seçilen kategoride harcama olur ve depozito kapatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що лишилося від застави, стає витратою в обраній категорії, а застава закривається."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Garovning qolgan qismi tanlangan toifadagi xarajatga aylanadi va garov yopiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余押金将计入所选类别的支出，押金记录随之关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘押金會計入所選類別的支出，並結清押金。"
          }
        }
      }
    },
