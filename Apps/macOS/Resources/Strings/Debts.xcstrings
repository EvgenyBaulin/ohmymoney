    "costs.pskGap": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesablanmış faiz dərəcəsi müqavilədəki kreditin tam dəyərindən %@ faiz bəndi fərqlənir. Bütün komissiyaların daxil edildiyini yoxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічаная стаўка адрозніваецца ад поўнага кошту ў дамове на %@ п. п. — праверце, ці ўведзены ўсе камісіі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypočtená sazba se liší od celkových nákladů ve smlouvě o %@ p. b. Zkontrolujte, zda jsou zadány všechny poplatky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der errechnete Satz weicht von den Gesamtkosten laut Vertrag um %@ Prozentpunkte ab — prüfen Sie, ob jede Gebühr eingetragen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worked-out rate differs from the contract's full cost by %@ p.p. — check that every fee is entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tasa calculada difiere del coste total del contrato en %@ p.p. — compruebe que se han introducido todas las comisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux calculé diffère du coût total du contrat de %@ point(s) — vérifiez que chaque frais est saisi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվարկված տոկոսադրույքը պայմանագրի լրիվ արժեքից տարբերվում է %@ տոկոսային կետով․ ստուգեք, որ բոլոր միջնորդավճարները մուտքագրված են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso calcolato differisce dal costo totale del contratto di %@ punti percentuali. Verifica di aver inserito tutte le commissioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算された金利は契約上の実質金利と%@ポイント異なります。すべての手数料が入力されているか確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოთვლილი განაკვეთი ხელშეკრულების სრული ღირებულებისგან %@ პროცენტული პუნქტით განსხვავდება — შეამოწმეთ, შეყვანილია თუ არა ყველა საკომისიო."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептелген мөлшерлеме шарттағы толық шығыстан %@ п.п. өзгешеленеді — әр комиссия енгізілгенін тексеріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산된 금리가 계약서의 총대출비용률과 %@%p 다릅니다. 모든 수수료를 입력했는지 확인하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептелген чен келишимдеги толук нарктан %@ пайыздык пунктка айырмаланат — бардык комиссиялар киргизилгенин текшериңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het berekende percentage wijkt %@ procentpunt af van de totale kosten in het contract. Controleer of alle kosten zijn ingevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczona stopa różni się od całkowitego kosztu z umowy o %@ p.p. — sprawdź, czy dodano wszystkie opłaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa calculada difere do custo total do contrato em %@ p.p. — confira se todas as tarifas foram informadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa calculada difere do custo total do contrato em %@ p.p. — verifique se introduziu todas as comissões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расчёт расходится с ПСК договора на %@ п. п. — проверьте, все ли комиссии внесены."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Меъёри ҳисобшуда аз арзиши пурраи шартнома ба %@ банди фоизӣ фарқ мекунад — ворид шудани ҳамаи комиссияҳоро санҷед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplanan oran, sözleşmedeki toplam maliyet oranından %@ yüzde puan farklı. Tüm ücretlerin girildiğini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розрахована ставка відрізняється від повної вартості за договором на %@ п.п. — перевірте, чи введено всі комісії."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblangan stavka shartnomadagi to‘liq qiymatdan %@ foiz bandiga farq qiladi — barcha komissiyalar kiritilganini tekshiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算出的利率与合同综合成本相差 %@ 个百分点，请检查是否已输入所有费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算出的利率與合約的總費用率相差 %@ 個百分點，請確認已輸入所有費用。"
          }
        }
      }
    },
