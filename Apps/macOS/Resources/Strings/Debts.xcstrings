        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda rata tylko zmniejsza dług"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada parcela apenas reduz a dívida"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada prestação apenas reduz a dívida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая часть только уменьшает долг"
