    "ladder.never": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя плацяжы не погасяць даўгі: дадайце грошы звыш іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlungen tilgen die Schulden nicht: Legen Sie Geld darüber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payments do not pay the debts off: add money above them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pagos no cancelan las deudas: añada dinero por encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements ne remboursent pas les dettes : ajoutez de l'argent au-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pagamenti non estinguono i debiti: aggiungi un importo extra."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлемдер берешектерді жаппайды: үстіне ақша қосыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te wpłaty nie wystarczą na spłatę długów: dodaj więcej środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pagamentos não quitam as dívidas. Adicione um valor extra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежи не закрывают долги — добавьте сумму сверх."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödemeler borçları kapatmaya yetmiyor: Ek tutar ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежі не погашають боргів: додайте гроші понад них."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu to‘lovlar qarzlarni qoplamaydi: qo‘shimcha pul qo‘shing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的還款額無法還清債務，請增加額外還款。"
          }
        }
      }
    },
