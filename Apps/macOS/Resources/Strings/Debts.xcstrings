        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული ნაწილი მხოლოდ ვალს ამცირებს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр бөлік тек берешекті азайтады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 회차 납입액은 부채에서만 차감됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир бөлүк карызды гана азайтат"
