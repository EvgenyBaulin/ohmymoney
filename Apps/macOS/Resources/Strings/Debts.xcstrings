    "costs.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dəfə ödənilən məbləğ həmin gün xərc sayılır; kreditə daxil edilən məbləğ isə borcu artırır. Sığortadan adətən 30 gün ərzində imtina etmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разавы плацёж улічваецца як выдатак у дзень аплаты; сума, уключаная ў крэдыт, павялічвае доўг. Страхоўку звычайна можна вярнуць цягам 30 дзён."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorázově zaplacený náklad se započítá jako výdaj v den platby; náklad zahrnutý do úvěru zvýší dluh. Pojištění lze obvykle do 30 dnů zrušit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosten, die einmal gezahlt werden, sind eine Ausgabe an ihrem Tag; sind sie im Kredit enthalten, erhöhen sie stattdessen die Schuld. Eine Versicherung lässt sich meist innerhalb von 30 Tagen zurückgeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cost paid once is an expense on its day; one included in the loan grows the debt instead. Insurance can usually be given back within 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coste pagado una vez es un gasto en su día; uno incluido en el préstamo aumenta la deuda. El seguro suele poder devolverse en 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coût payé une fois est une dépense à sa date ; un coût inclus dans le crédit fait au contraire grossir la dette. L'assurance peut en général être remboursée dans les 30 jours."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկ անգամ վճարվող գումարը ծախս է վճարման օրը, իսկ վարկի մեջ ներառվածը մեծացնում է պարտքը։ Ապահովագրությունը սովորաբար կարելի է վերադարձնել 30 օրվա ընթացքում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un costo pagato una sola volta è una spesa nel giorno del pagamento; se incluso nel prestito, aumenta il debito. Di solito puoi recedere dall’assicurazione entro 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一括払いの費用は支払日の支出になり、ローンに含める費用は借入額に加算されます。保険は通常、30日以内なら解約できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთჯერადი გადასახადი ხარჯად გადახდის დღეს აღირიცხება; სესხში შეტანილი კი ვალს ზრდის. დაზღვევის დაბრუნება, როგორც წესი, 30 დღეშია შესაძლებელი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір рет төленетін шығын — күні шығыс болып саналады; несиеге кірген шығын орнына берешекті өсіреді. Сақтандыруды әдетте 30 күн ішінде қайтаруға болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시불 비용은 지불한 날의 지출로 기록됩니다. 대출에 포함된 비용은 빚에 더해집니다. 보험은 보통 30일 이내에 해지할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир жолу төлөнгөн чыгым ошол күнкү чыгашага кирет; насыяга кошулганы карызды көбөйтөт. Камсыздандыруудан адатта 30 күндүн ичинде баш тартып, акчасын кайтарып алса болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige kosten zijn uitgaven op de betaaldatum; kosten die in de lening zijn opgenomen, verhogen de schuld. Een verzekering kan meestal binnen 30 dagen worden opgezegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koszt opłacony jednorazowo jest wydatkiem w dniu płatności; doliczony do kredytu zwiększa zadłużenie. Z ubezpieczenia zwykle można zrezygnować w ciągu 30 dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um custo pago uma vez é uma despesa no dia do pagamento; um custo incluído no empréstimo aumenta a dívida. Geralmente, é possível cancelar o seguro e receber o valor de volta em até 30 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um custo pago uma vez é uma despesa nesse dia; um custo incluído no empréstimo aumenta a dívida. Geralmente, é possível cancelar um seguro no prazo de 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовый расход записывается тратой в свой день; включённый в кредит — увеличивает долг. Страховку обычно можно вернуть в течение 30 дней."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти якдафъаина дар рӯзи пардохт сабт мешавад; хароҷоти ба қарз дохилшуда маблағи қарзро зиёд мекунад. Одатан суғуртаро дар давоми 30 рӯз баргардондан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez ödenen masraf, ödendiği gün gider olarak kaydedilir; krediye eklenen masraf ise borcu artırır. Sigorta genellikle 30 gün içinde iptal edilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрата, сплачена разово, — це витрата в її день; включена в кредит, вона натомість збільшує борг. Страховку зазвичай можна повернути протягом 30 днів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir marta to‘langan xarajat o‘sha kungi chiqim hisoblanadi; kreditga kiritilgani esa qarzni oshiradi. Sug‘urtani odatda 30 kun ichida qaytarish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性支付的费用计为当天支出；计入贷款的费用会增加债务。保险通常可在 30 天内退保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次支付的費用會計為當日支出；計入貸款的費用則會增加債務。保險通常可在 30 天內退保。"
          }
        }
      }
    },
