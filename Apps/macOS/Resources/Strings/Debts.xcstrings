    "debts.delete.owedLater": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» bu borcu sonra qaytarsa, məbləğ gəlir kimi qeydə alınacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі «%@» верне грошы пазней, гэта будзе ўлічана як даход."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud «%@» dluh později splatí, bude platba zaznamenána jako příjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlt „%@“ dies später zurück, wird es als Einnahme erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If «%@» pays this back later, it will be recorded as income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si «%@» devuelve esto más tarde, se registrará como ingreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si « %@ » rembourse plus tard, ce sera noté comme revenu."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե «%@»-ն հետագայում վերադարձնի այս գումարը, այն կգրանցվի որպես եկամուտ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se «%@» restituirà l’importo in seguito, verrà registrato come entrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で«%@»から返済された場合、収入として記録されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ «%@» ამ თანხას მოგვიანებით დააბრუნებს, ის შემოსავლად აღირიცხება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Егер «%@» бұны кейін қайтарса, ол табыс ретінде жазылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 «%@»에게서 돈을 돌려받으면 수입으로 기록됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эгер «%@» бул карызды кийин кайтарса, ал киреше катары жазылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als «%@» dit later terugbetaalt, wordt het als inkomen geboekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli «%@» zwróci te pieniądze później, zostaną zapisane jako przychód."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se «%@» pagar essa dívida mais tarde, o valor será registrado como receita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se «%@» pagar mais tarde, o pagamento será registado como receita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если «%@» потом вернёт эти деньги, они запишутся доходом."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Агар «%@» ин маблағро дертар баргардонад, он ҳамчун даромад сабт мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» bu borcu daha sonra öderse ödeme gelir olarak kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо «%@» поверне це пізніше, це буде записано як дохід."
          }
        },
        "uz": {
          "stringUnit": {
