    "debts.delete.journal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The debt and its journal (%lld entry) will be deleted. Reminders and the free sum will no longer include this debt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The debt and its journal (%lld entries) will be deleted. Reminders and the free sum will no longer include this debt."
                }
              }
            }
          }
        },
