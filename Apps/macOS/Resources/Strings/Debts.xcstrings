        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro movimentado através do histórico mantém-se nos saldos das contas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги, которые по журналу переходили из рук в руки, остаются в остатках счетов."
          }
