    "form.monthPaid": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж за гэты месяц ужо ўнесены?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung für diesen Monat ist schon erfolgt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's payment already made?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya se hizo el pago de este mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mensualité de ce mois est-elle déjà payée ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rata di questo mese è già stata pagata?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдағы төлем бұрын төленді ме?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rata za ten miesiąc została już opłacona?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento deste mês já foi feito?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёж за этот месяц уже сделан?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın ödemesi yapıldı mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж цього місяця вже зроблено?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy to‘lovi allaqachon amalga oshirilganmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月款項已付？"
          }
        }
      }
    },
    "form.monthPaid.ask": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сёння дзень плацяжу. Пазначце, ці ўлічаны сённяшні плацёж у рэшце вышэй. Без гэтага захаваць не атрымаецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist der Zahlungstag. Sagen Sie, ob der Saldo oben nach der heutigen Zahlung gilt — vorher können Sie nicht sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is the payment day. Say whether the balance above is after today's payment — you cannot save before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy es día de pago. Indique si el saldo de arriba es después del pago de hoy: antes no se puede guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui est le jour de paiement. Dites si le solde ci-dessus est établi après le paiement d'aujourd'hui — vous ne pouvez pas enregistrer avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi è il giorno della rata. Indica se il saldo sopra include già il pagamento di oggi: è necessario per salvare."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін — төлем күні. Жоғарыдағы берешек бүгінгі төлемнен кейін ме, айтыңыз — бұрын сақтау мүмкін емес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś jest dzień płatności. Określ, czy saldo powyżej uwzględnia dzisiejszą spłatę. Jest to wymagane do zapisania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje é o dia do pagamento. Informe se o saldo acima é posterior ao pagamento de hoje para poder salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня день платежа. Скажите, указан ли остаток уже после сегодняшнего платежа, — без ответа не сохранить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün ödeme günü. Kaydetmeden önce yukarıdaki bakiyenin bugünkü ödemeden sonraki tutar olup olmadığını belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні день платежу. Скажіть, чи залишок вище вже після сьогоднішнього платежу, — раніше зберегти не можна."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun to‘lov kuni. Yuqoridagi qarz qoldig‘i bugungi to‘lovdan keyingi miqdormi? Javob bermasdan saqlab bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天是付款日。請確認上述餘額是否已扣除今天的付款，才能儲存。"
          }
        }
      }
    },
    "form.monthPaid.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«Так»: першы плацёж — у наступным месяцы. «Не»: сёння."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ja“: Die erste fällige Zahlung ist die des nächsten Monats. „Nein“: Sie ist die von heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«Yes»: the first payment owed is next month's. «No»: it is today's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sí»: el primer pago debido es el del mes que viene. «No»: es el de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Oui » : la première échéance due est celle du mois prochain. « Non » : c'est celle d'aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sì»: la prima rata dovuta è quella del mese prossimo. «No»: è quella di oggi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Иә»: бірінші міндетті төлем келесі айдікі. «Жоқ»: ол бүгінгі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Tak»: pierwsza rata do zapłaty przypada w przyszłym miesiącu. «Nie»: przypada dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sim»: o primeiro pagamento devido é o do mês que vem. «Não»: é o de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Да»: первый платёж к оплате — в следующем месяце. «Нет»: сегодняшний."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Evet»: İlk ödeme gelecek ay yapılacak. «Hayır»: İlk ödeme bugün yapılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Так»: перший платіж, що належить, — наступного місяця. «Ні»: він сьогоднішній."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ha»: birinchi to‘lov keyingi oyda. «Yo‘q»: bugun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«是»：首次應付款為下個月。«否»：首次應付款為今天。"
          }
        }
      }
    },
