    "split.invalid": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kateqoriya seçin. Ödənişlər alışın qiymətini qarşılamalı, müsbət olmalı və alış tarixindən başlayaraq tarix sırasına uyğun gəlməlidir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце катэгорыю. Плацяжы павінны пакрываць кошт пакупкі, быць дадатнымі і ісці па парадку дат, пачынаючы з дня пакупкі або пазней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte kategorii. Splátky musí pokrýt cenu nákupu, být kladné a následovat po sobě podle data, nejdříve v den nákupu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Kategorie. Die Zahlungen müssen den Kaufpreis decken, positiv sein und in zeitlicher Reihenfolge ab dem Kaufdatum liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a category. Payments must cover the purchase price, be positive and follow date order, starting on or after the purchase date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una categoría. Los pagos deben cubrir el importe de la compra, ser positivos y seguir un orden cronológico, a partir de la fecha de compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une catégorie. Les paiements doivent couvrir le prix d’achat, être positifs et suivre l’ordre des dates, à partir de la date d’achat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք կատեգորիա։ Վճարումները պետք է ծածկեն գնման գինը, լինեն դրական և հաջորդեն ըստ ամսաթվի՝ սկսած գնման օրվանից կամ դրանից հետո։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una categoria. I pagamenti devono coprire il prezzo d’acquisto, essere positivi e seguire l’ordine delle date, a partire dalla data di acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリを選択してください。支払額はすべて正の値で、合計が購入額以上になる必要があります。支払日は購入日以降で、日付順に設定してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ კატეგორია. გადახდები უნდა ფარავდეს შეძენის ფასს, იყოს დადებითი და თარიღის მიხედვით დალაგებული, შეძენის დღიდან ან მის შემდეგ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санатты таңдаңыз. Төлемдер сатып алу құнын жабуы, оң болуы және сатып алу күнінен бастап күн ретімен орналасуы тиіс."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리를 선택하세요. 납부금 합계는 구매 금액 이상이어야 하며, 각 납부금은 0보다 커야 합니다. 날짜는 구매일 이후부터 순서대로 입력하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияны тандаңыз. Төлөмдөр сатып алуунун баасын жабышы, оң сан болушу жана сатып алуу күнүнөн баштап ирети менен жайгашышы керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een categorie. De betalingen moeten samen de aankoopprijs dekken, positief zijn en op datum staan, vanaf de aankoopdatum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kategorię. Raty muszą pokrywać cenę zakupu, być dodatnie i następować po sobie, począwszy od dnia zakupu lub później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma categoria. Os pagamentos devem cobrir o valor da compra, ser positivos e seguir a ordem das datas, a partir da data da compra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma categoria. Os pagamentos têm de cobrir o preço da compra, ser positivos e seguir a ordem das datas, a partir da data da compra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите категорию. Платежи должны покрывать цену покупки, быть больше нуля и идти по порядку дат, начиная со дня покупки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияро интихоб кунед. Пардохтҳо бояд нархи харидро пӯшонанд, мусбат бошанд ва аз рӯзи харид ё баъд аз он бо тартиби сана ҷойгир шаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kategori seçin. Ödemeler satın alma tutarını karşılamalı, pozitif olmalı ve satın alma tarihinde veya sonrasında başlayarak tarih sırasını izlemelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть категорію. Платежі мають покривати вартість покупки, бути додатними й розташовуватися за датою, починаючи з дати покупки або пізніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Turkumni tanlang. To‘lovlar xarid narxini qoplashi, musbat bo‘lishi va xarid sanasidan boshlab sana tartibida joylashishi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择类别。还款总额须覆盖购买价格，各期金额须大于零，日期须按顺序排列，且不早于购买日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇類別。付款總額須涵蓋購買價格，金額須大於零，日期須依序排列，且不早於購買日期。"
          }
        }
      }
    },
