    "review.card.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredit kartı həm hesab, həm də borc kimi saxlanılır: borcu iki dəfə hesablanır. Yalnız hesabı saxlayın — borc silinəcək, faiz dərəcəsi kartın şərtlərinə köçürüləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта крэдытная картка захавана і як рахунак, і як доўг: яе доўг улічваецца двойчы. Пакіньце толькі рахунак — доўг будзе выдалены, а яго стаўка пяройдзе ва ўмовы карткі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato kreditní karta je vedena jako účet i jako dluh, takže se její dluh počítá dvakrát. Ponechte jen účet — dluh se smaže a jeho sazba se přenese do podmínek karty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kreditkarte ist sowohl als Konto als auch als Schuld geführt: Ihre Schuld wird zweimal gezählt. Behalten Sie nur das Konto — die Schuld wird gelöscht, ihr Zinssatz geht in die Bedingungen der Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This credit card is kept both as an account and as a debt: its debt is counted twice. Keep only the account — the debt is deleted, its rate goes to the card's terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarjeta de crédito se guarda a la vez como cuenta y como deuda: su deuda se cuenta dos veces. Conserve solo la cuenta — la deuda se elimina y su tipo pasa a las condiciones de la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette carte de crédit est gardée à la fois comme compte et comme dette : sa dette est comptée deux fois. Gardez seulement le compte — la dette est supprimée, son taux passe dans les conditions de la carte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս վարկային քարտը գրանցված է և՛ որպես հաշիվ, և՛ որպես պարտք․ դրա պարտքը հաշվվում է երկու անգամ։ Պահեք միայն հաշիվը․ պարտքը կջնջվի, իսկ տոկոսադրույքը կփոխանցվի քարտի պայմաններին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa carta di credito è registrata sia come conto che come debito: il debito viene conteggiato due volte. Mantieni solo il conto: il debito verrà eliminato e il suo tasso sarà trasferito alle condizioni della carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このクレジットカードは口座と借り入れの両方に登録されているため、負債が二重に計上されています。口座だけを残し、借り入れを削除して金利をカードの条件に移します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს საკრედიტო ბარათი შენახულია როგორც ანგარიშად, ისე დავალიანებად: მისი დავალიანება ორჯერ ითვლება. დატოვეთ მხოლოდ ანგარიში — დავალიანება წაიშლება, მისი განაკვეთი კი ბარათის პირობებში გადავა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кредиттік карта және есеп-шот, және берешек ретінде сақталған: оның берешегі екі рет саналады. Тек есеп-шотты қалдырыңыз — берешек жойылады, оның мөлшерлемесі картаның шарттарына көшеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 신용카드가 계좌와 채무로 모두 등록되어 채무가 두 번 계산됩니다. 계좌만 유지하면 채무가 삭제되고 이율은 카드 조건으로 옮겨집니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул кредиттик карта эсеп жана карыз катары катталган: карызы эки жолу эсептелүүдө. Эсеп гана калат — карыз өчүрүлүп, анын чени картанын шарттарына өтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze creditcard wordt zowel als rekening als schuld bijgehouden: de schuld wordt dubbel geteld. Behoud alleen de rekening. De schuld wordt verwijderd en de rente wordt overgenomen in de kaartvoorwaarden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta karta kredytowa jest zapisana jako konto i jako zobowiązanie, więc zadłużenie jest liczone podwójnie. Zostaw tylko konto — zobowiązanie zostanie usunięte, a jego oprocentowanie trafi do warunków karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cartão de crédito está registrado como conta e como dívida: o saldo devedor é contado duas vezes. Mantenha apenas a conta — a dívida será apagada e sua taxa passará para as condições do cartão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cartão de crédito está registado como conta e como dívida: a dívida é contada duas vezes. Mantenha apenas a conta — a dívida será apagada e a taxa passará para as condições do cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта кредитка ведётся и счётом, и долгом — её долг считается дважды. Оставьте только счёт: долг удалится, его ставка перейдёт в условия карты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин корти кредитӣ ҳам ҳамчун ҳисоб ва ҳам ҳамчун қарз нигоҳ дошта мешавад: қарзи он ду бор ҳисоб мешавад. Танҳо ҳисобро нигоҳ доред — қарз нест мешавад ва меъёри он ба шартҳои корт мегузарад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredi kartı hem hesap hem de borç olarak tutuluyor; borcu iki kez sayılıyor. Yalnızca hesabı tutun; borç silinir ve faiz oranı kart koşullarına aktarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю кредитну картку зберігано і як рахунок, і як борг: її борг враховано двічі. Лишіть лише рахунок — борг видаляється, а його ставка переходить до умов картки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredit karta ham hisob, ham qarz sifatida saqlangan: qarzi ikki marta hisoblanmoqda. Faqat hisobni qoldiring — qarz o‘chiriladi, uning stavkasi karta shartlariga o‘tkaziladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张信用卡同时记录为账户和欠款，欠款被重复计算。仅保留账户后，欠款记录将删除，其利率将转入信用卡条款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張信用卡同時記錄為帳戶和債務，債務因此被重複計算。請只保留帳戶：債務會被刪除，利率會移至卡片條件。"
          }
        }
      }
    },
    "review.done": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün borclar üzrə suallar cavablandırılıb."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На ўсе пытанні пра даўгі атрыманы адказы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny dluhy jsou vyřešeny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Schuld ist beantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every debt is answered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las deudas están respondidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque dette a une réponse."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բոլոր պարտքերի հարցերը պատասխանված են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai risposto per tutti i debiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての借り入れを確認しました。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველა დავალიანების კითხვას პასუხი გაეცა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық берешектерге жауап берілген."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 채무를 확인했습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бардык карыздар боюнча жооп берилди."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vragen over schulden zijn beantwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udzielono odpowiedzi dla wszystkich zobowiązań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as dívidas foram revisadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as dívidas foram revistas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На все вопросы отвечено."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба саволҳои ҳамаи қарзҳо ҷавоб дода шуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm borçlarla ilgili sorular yanıtlandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На кожен борг дано відповідь."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha qarzlar ko‘rib chiqildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已回答所有欠款问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有債務均已確認。"
          }
        }
      }
    },
    "review.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cavab verənədək heç nə yenidən hesablanmır. «Sonra» seçimi sualı başqa vaxt yenidən göstərəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль вы не адкажаце, новыя разлікі не выконваюцца. «Пазней» адкладзе пытанне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud neodpovíte, nic se znovu nepřepočítá. Volba «Později» otázku připomene jindy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird neu berechnet, bis Sie antworten. „Später“ fragt ein andermal erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is worked out anew until you answer. «Later» asks again another time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se vuelve a calcular hasta que responda. «Más tarde» vuelve a preguntar otro día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est recalculé tant que vous n'avez pas répondu. « Plus tard » redemande une autre fois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչև պատասխանելը նոր հաշվարկ չի արվում։ «Ավելի ուշ» ընտրելու դեպքում հարցը կրկին կտրվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non verrà ricalcolato nulla finché non rispondi. Con «Più tardi» la domanda verrà riproposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が完了するまで再計算されません。«あとで»を選ぶと、後でもう一度確認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სანამ პასუხს არ გასცემთ, არაფერი გადაითვლება. «მოგვიანებით» კითხვას სხვა დროს შეგახსენებთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жауап бергенге дейін ештеңе қайтадан есептелмейді. «Кейін» басқа уақытта қайта сұрайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하기 전까지 다시 계산하지 않습니다. «나중에»를 선택하면 다음에 다시 묻습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жооп бергенге чейин эч нерсе кайра эсептелбейт. «Кийинчерээк» тандасаңыз, суроо кайра берилет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets opnieuw berekend totdat je antwoord geeft. Met «Later» wordt de vraag een andere keer opnieuw gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki nie odpowiesz, nic nie zostanie przeliczone. Wybierz «Później», aby wrócić do pytania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada será recalculado até você responder. «Depois» perguntará novamente em outro momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada será recalculado até responder. «Mais tarde» volta a perguntar noutra altura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не пересчитывается, пока вы не ответите. «Позже» — спросим в другой раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То ҷавоб додан чизе аз нав ҳисоб намешавад. Бо интихоби «Баъдтар» савол боз дода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlayana kadar hiçbir şey yeniden hesaplanmaz. «Daha Sonra» seçeneği soruyu tekrar sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не перераховується, доки ви не відповісте. «Пізніше» запитає знову іншим разом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
