    "instalmentReturn.markup.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borc daha %@ azalır: bu, ödənilməmiş hissələrin əlavə ödənişidir. Hissələrin məbləği dəyişmir; ödənişlər daha tez bitir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доўг таксама паменшыцца на %@: пераплату па яшчэ не аплачаных частках. Сумы частак застануцца ранейшымі; выплаты скончацца раней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dluh se také sníží o %@: přeplatek za dosud nezaplacené splátky. Výše splátek zůstane stejná, splácení skončí dříve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schuld sinkt außerdem um %@: die Überzahlung der noch nicht gezahlten Raten. Die Raten behalten ihre Beträge; die Zahlungen enden früher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The debt also goes down by %@: the overpayment of the parts not paid yet. The parts keep their amounts; the payments end earlier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La deuda también baja en %@: el sobrepago de los plazos aún no pagados. Los plazos conservan sus importes; los pagos terminan antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dette baisse aussi de %@ : le trop-perçu des tranches pas encore payées. Les tranches gardent leurs montants ; les paiements s'arrêtent plus tôt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պարտքը նվազում է նաև %@-ով՝ դեռ չվճարված մասերի գերավճարի չափով։ Մասերի գումարները չեն փոխվում, վճարումները շուտ են ավարտվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il debito diminuisce anche di %@: il costo aggiuntivo delle rate non ancora pagate. Gli importi delle rate restano invariati; i pagamenti terminano prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未払い分の上乗せ額%@も負債から差し引かれます。各回の金額は変わらず、支払いが早く終わります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალი დამატებით %@-ით შემცირდება: ეს ჯერ გადაუხდელი ნაწილების ზედმეტი გადასახადია. ნაწილების თანხები უცვლელი დარჩება; გადახდები ადრე დასრულდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек %@ азаяды: әлі төленбеген бөліктердің артық төлемі. Бөліктердің сомасы сол қалады; төлемдер ертерек аяқталады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 납입하지 않은 회차의 할부 수수료 %@도 부채에서 차감됩니다. 회차별 금액은 그대로 유지되고 납입이 일찍 끝납니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карыз дагы %@ азаят: бул төлөнө элек бөлүктөрдүн ашыкча төлөмү. Бөлүктөрдүн суммасы өзгөрбөйт; төлөмдөр эрте аяктайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schuld neemt ook af met %@: de meerkosten van de nog niet betaalde termijnen. De termijnbedragen blijven gelijk; de betalingen stoppen eerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dług zmaleje też o %@: nadpłatę za niezapłacone jeszcze raty. Kwoty rat pozostaną bez zmian, a spłata zakończy się wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A dívida também diminui em %@: o acréscimo das parcelas ainda não pagas. Os valores das parcelas permanecem iguais; os pagamentos terminam antes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A dívida também diminui %@: o acréscimo das prestações ainda por pagar. Os valores das prestações mantêm-se; os pagamentos terminam mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долг уменьшится ещё на %@: переплата неоплаченных частей. Суммы частей прежние, платежи закончатся раньше."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қарз боз ба андозаи %@ кам мешавад: ин изофапулии қисмҳои ҳанӯз пардохтнашуда аст. Маблағи қисмҳо тағйир намеёбад; пардохтҳо барвақттар анҷом меёбанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borç ayrıca %@ azalır: Henüz ödenmemiş taksitlerin vade farkı. Taksit tutarları değişmez; ödemeler daha erken biter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Борг також зменшується на %@: переплата за ще не сплачені частини. Частини лишаються на своїх сумах, платежі закінчуються раніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarz yana %@ ga kamayadi: bu hali to‘lanmagan qismlarning ortiqcha to‘lovidir. Qismlar summasi o‘zgarmaydi; to‘lovlar ertaroq tugaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "债务还将减少%@，即未付期数的额外费用。各期金额不变，还款将提前结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "債務將再減少 %@，即未付款期數的加價金額。各期金額不變，付款將提早結束。"
          }
        }
      }
    },
