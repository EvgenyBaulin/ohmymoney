    },
    "schedule.graceKind.programme": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State programme (40% → 60% → 100% of interest)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programa estatal (40 % → 60 % → 100 % de los intereses)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
