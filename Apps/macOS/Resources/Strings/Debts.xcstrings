    "debts.card.counted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This money is already in the balance of the account. The debt here is only a view: it is in no total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dinero ya está en el saldo de la cuenta. La deuda aquí es solo una vista: no entra en ningún total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet argent est déjà dans le solde du compte. La dette ici n'est qu'un aperçu : elle n'entre dans aucun total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти деньги уже в остатке счёта. Долг здесь только показ: в итоги он не входит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці гроші вже є в залишку рахунку. Борг тут — лише подання: він не входить до жодного підсумку."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo importo è già incluso nel saldo del conto. Il debito mostrato qui non è incluso in alcun totale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ақша есеп-шоттың теңгерімінде бар. Мұндағы берешек — тек көрініс: ол ешбір жиынға кірмейді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя грошы ўжо ўлічаны ў балансе рахунку. Доўг паказаны для даведкі і не ўваходзіць у вынікі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Geld steckt bereits im Saldo des Kontos. Die Schuld hier ist nur eine Ansicht: Sie geht in keine Summe ein."
          }
        }
      }
    },
