        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalanche: the debt with the highest rate first — the least overpaid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalancha: primero la deuda con el tipo más alto — menos sobrepagado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalanche : la dette au taux le plus élevé d'abord — le moins de surpaiement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձնահյուս․ սկզբում՝ ամենաբարձր տոկոսադրույքով պարտքը, ավելի քիչ գերավճար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valanga: prima il debito con il tasso più alto, per pagare meno interessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アバランチ：金利の高い負債から返済し、利息を抑えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზვავი: ჯერ ყველაზე მაღალი განაკვეთის მქონე ვალი — ნაკლები ზედმეტი გადასახადი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аваланш: ең жоғары мөлшерлемелі берешек бірінші — ең аз артық төлем."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애벌랜치: 이율이 높은 부채부터 상환하여 이자를 줄입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көчкү: адегенде чени эң жогору карыз — ашыкча төлөм азыраак."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawine: de schuld met de hoogste rente eerst — de laagste rentekosten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawina: najpierw dług z najwyższym oprocentowaniem — najmniejsza nadpłata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalanche: a dívida com maior taxa primeiro — menos juros pagos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalanche: a dívida com a taxa mais alta primeiro — paga menos juros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лавина: сначала долг с самой высокой ставкой — меньше переплата."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарма: аввал қарзи бо фоизи баландтарин — изофапулӣ камтар мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çığ: Önce faizi en yüksek borç; toplamda daha az ödeme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лавина: спершу борг з найвищою ставкою — найменше переплати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘chki: avval eng yuqori stavkali qarz — eng kam ortiqcha to‘lov."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪崩法：优先偿还利率最高的债务，额外支出最少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雪崩法：先還利率最高的債務，支付的利息最少。"
          }
        }
      }
    },
