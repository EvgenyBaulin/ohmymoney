    "instalmentReturn.markup.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доўг таксама паменшыцца на %@: пераплату па яшчэ не аплачаных частках. Сумы частак застануцца ранейшымі; выплаты скончацца раней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schuld sinkt außerdem um %@: die Überzahlung der noch nicht gezahlten Raten. Die Raten behalten ihre Beträge; die Zahlungen enden früher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The debt also goes down by %@: the overpayment of the parts not paid yet. The parts keep their amounts; the payments end earlier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il debito diminuisce anche di %@: il costo aggiuntivo delle rate non ancora pagate. Gli importi delle rate restano invariati; i pagamenti terminano prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек %@ азаяды: әлі төленбеген бөліктердің артық төлемі. Бөліктердің сомасы сол қалады; төлемдер ертерек аяқталады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долг уменьшится ещё на %@: переплата неоплаченных частей. Суммы частей прежние, платежи закончатся раньше."
          }
        }
      }
    },
