    "form.transfer.tooMuch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu borcun qalığından çoxdur: ən çox qalıq məbləği köçürmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш за рэшту гэтага доўгу: можна перанесці не больш за ўсю рэшту."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Více, než zbývá z tohoto dluhu: převést lze nejvýše celý zůstatek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr, als auf dieser Schuld übrig ist: Eine Überweisung verschiebt höchstens alles davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than is left on this debt: a transfer moves at most all of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es más de lo que queda en esta deuda: una transferencia mueve como máximo todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus que ce qui reste sur cette dette : un virement en déplace au plus la totalité."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը գերազանցում է պարտքի մնացորդը․ կարելի է փոխանցել առավելագույնը ամբողջ մնացորդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera il residuo del debito: puoi trasferire al massimo l'intero residuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負債の残額を超えています。移動できるのは残額までです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ვალის ნაშთზე მეტია: მაქსიმუმ დარჩენილი თანხის გადატანაა შესაძლებელი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл берешектегі қалғаннан көп: аударым одан көбін, яғни бәрін ғана көшіре алады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 부채보다 많습니다. 남은 금액까지만 옮길 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул карыздын калдыгынан көп: которуу менен эң көп дегенде калган сумма өтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meer dan het restant van deze schuld: je kunt maximaal het volledige restant overboeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Więcej niż pozostało do spłaty: można przenieść najwyżej cały dług."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor excede o saldo desta dívida. Uma transferência pode mover, no máximo, todo o saldo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Excede o valor em dívida: só pode transferir até ao valor restante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше, чем осталось по долгу: перенести можно не больше остатка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз бақияи ин қарз зиёд аст: танҳо то маблағи бақия интиқол додан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu borcun kalanından fazla: En fazla borcun tamamı aktarılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це більше, ніж лишилося за цим боргом: переказ переносить не більше за весь борг."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qarzning qolgan summasidan ko‘p: ko‘pi bilan qolgan summani o‘tkazish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过此债务的剩余金额：最多只能转移全部剩余金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過此債務的剩餘金額：最多只能轉移全部餘額。"
          }
        }
      }
    },
