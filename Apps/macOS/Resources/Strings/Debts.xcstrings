    "schedule.order.ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer this — the loan is not saved without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda esto — sin ello no se guarda el préstamo."
          }
        },
        "ru": {
