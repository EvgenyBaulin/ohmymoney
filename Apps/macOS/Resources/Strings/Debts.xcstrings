    "pause.termShift": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апошні плацёж пераносіцца з %1$@ на %2$@ (прапушчана плацяжоў: %3$@)."
          }
        },
        "de": {
