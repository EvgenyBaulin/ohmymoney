    "ladder.card.snowball": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snowball: the smallest debt first — the first one goes sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bola de nieve: primero la deuda más pequeña — la primera se cierra antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boule de neige : la plus petite dette d'abord — la première se termine plus vite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снежный ком: сначала самый маленький долг — первый уйдёт быстрее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Снігова куля: спершу найменший борг — перший закривається швидше."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Palla di neve: prima il debito più piccolo, per estinguerlo prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Снежбол: ең кіші берешек бірінші — біріншісі тезірек жабылады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Снежны ком: спачатку найменшы доўг — першы доўг знікне раней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneeball: zuerst die kleinste Schuld — die erste ist früher weg."
          }
        }
      }
    },
