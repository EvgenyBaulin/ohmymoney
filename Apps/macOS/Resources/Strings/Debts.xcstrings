    "ladder.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Штомесяц уносяцца мінімальныя плацяжы па ўсіх даўгах, а дадатковыя грошы ідуць на першы доўг у чарзе. Пасля яго пагашэння плацёж пераходзіць да наступнага."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Monat die Mindestzahlungen aller Schulden und das Geld darüber in die erste Schuld der Reihenfolge; eine abbezahlte Schuld gibt ihre Zahlung weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every month the minimum payments of all debts, and the money above into the first debt of the order; a debt paid off passes its payment on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mes se pagan los mínimos de todas las deudas, y el dinero sobrante va a la primera deuda del orden; la deuda saldada pasa su pago a la siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mois, les paiements minimum de toutes les dettes, et l'argent en surplus va sur la première dette de l'ordre ; une dette soldée transmet son paiement à la suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni mese paghi il minimo su tutti i debiti e versi l'importo extra sul primo debito in elenco. Quando un debito è estinto, il suo pagamento passa al successivo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр ай сайын барлық берешектің ең аз төлемі, ал үстіндегі ақша реттілік бойынша бірінші берешекке жіберіледі; жабылған берешектің төлемі келесісіне өтеді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co miesiąc spłacane są minimalne raty wszystkich długów, a dodatkowe środki trafiają na pierwszy dług w kolejności. Rata spłaconego długu przechodzi na następny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mês, pague o mínimo de todas as dívidas e aplique o valor extra na primeira dívida da ordem. Ao quitar uma dívida, seu pagamento passa para a próxima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый месяц — минимальные платежи всех долгов, а деньги сверх — в первый по порядку; закрытый долг отдаёт свой платёж следующему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ay tüm borçların asgari ödemeleri yapılır ve ek tutar sıradaki ilk borca ayrılır. Kapanan borcun ödemesi sıradakine aktarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щомісяця мінімальні платежі за всіма боргами, а гроші понад них — у перший борг черги; погашений борг передає свій платіж далі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har oy barcha qarzlarning eng kam to‘lovlari to‘lanadi, qo‘shimcha pul esa ro‘yxatdagi birinchi qarzga yo‘naltiriladi. Qarz yopilgach, uning to‘lovi keyingisiga o‘tadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月先支付所有債務的最低還款額，再將額外金額用於償還排序第一的債務；還清一筆後，其還款額會用於下一筆。"
          }
        }
      }
    },
