    "schedule.graceKind.programme.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditin ilk ilində faizin 40%-i, ikinci ilində 60%-i, üçüncü ildən hamısı ödənilir. Ödənilməyən hissə silinmir: əsas qrafik başlayanda borca əlavə olunur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "40% працэнтаў у першы год крэдыту, 60% у другі, усе працэнты з трэцяга. Неаплачаная частка не даруецца: яна дадаецца да доўгу з пачаткам асноўнага графіка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V prvním roce úvěru 40% úroků, ve druhém 60%, od třetího roku všechny. Nezaplacená část se nepromíjí: při zahájení hlavního splátkového kalendáře se přičte k dluhu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "40 % der Zinsen im ersten Jahr des Kredits, 60 % im zweiten, ab dem dritten alle. Der nicht bezahlte Teil wird nicht erlassen: Er kommt zur Schuld, wenn der Hauptplan beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "40% of the interest in the first year of the loan, 60% in the second, all of it from the third. The part not paid is not forgiven: it joins the debt when the main schedule starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 40 % de los intereses en el primer año del préstamo, el 60 % en el segundo y todos desde el tercero. La parte no pagada no se perdona: se suma a la deuda cuando empieza el calendario principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "40 % des intérêts la première année du crédit, 60 % la deuxième, la totalité à partir de la troisième. La part non payée n'est pas remise : elle s'ajoute à la dette au début de l'échéancier principal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վարկի առաջին տարում՝ տոկոսների 40%-ը, երկրորդում՝ 60%-ը, երրորդից՝ ամբողջը։ Չվճարված մասը չի ներվում․ այն ավելանում է պարտքին՝ հիմնական ժամանակացույցի սկզբում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 40% degli interessi nel primo anno del prestito, il 60% nel secondo e il totale dal terzo. La parte non pagata non viene condonata: si aggiunge al debito all'inizio del piano principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "借入開始から1年目は利息の40%、2年目は60%、3年目以降は全額を支払います。未払い分は免除されず、通常返済の開始時に借入残高に加算されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სესხის პირველ წელს — პროცენტის 40%, მეორეში — 60%, მესამედან — სრულად. გადაუხდელი ნაწილი არ ჩამოიწერება: ძირითადი გრაფიკის დაწყებისას ის დავალიანებას დაემატება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Несие жылының бірінші жылында пайыздың 40%, екіншісінде 60%, үшіншіден бастап толық. Төленбеген бөлігі кешірілмейді: негізгі кесте басталғанда берешекке қосылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대출 첫해에는 이자의 40%, 둘째 해에는 60%, 셋째 해부터는 전액을 납부합니다. 납부하지 않은 이자는 면제되지 않고 본 상환 일정이 시작될 때 원금에 더해집니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Насыянын биринчи жылында пайыздын 40%, экинчи жылында 60%, үчүнчү жылдан тартып толугу менен төлөнөт. Төлөнбөгөн бөлүгү кечилбейт: негизги график башталганда карызга кошулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "40% van de rente in het eerste jaar van de lening, 60% in het tweede jaar en alles vanaf het derde jaar. Het onbetaalde deel wordt niet kwijtgescholden: het wordt bij de schuld opgeteld wanneer het hoofdschema ingaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "40% odsetek w pierwszym roku kredytu, 60% w drugim, całość od trzeciego. Niespłacona część nie jest umarzana — zostanie dodana do zadłużenia na początku harmonogramu głównego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "40% dos juros no primeiro ano do empréstimo, 60% no segundo e o total a partir do terceiro. A parte não paga não é perdoada: ela é adicionada à dívida quando o cronograma principal começa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "40% dos juros no primeiro ano do empréstimo, 60% no segundo e a totalidade a partir do terceiro. A parte não paga não é perdoada: é adicionada à dívida quando começa o plano principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "40 % начисленных процентов в первый год кредита, 60 % — во второй, с третьего — все. Неоплаченная часть не прощается: она добавится к долгу, когда начнётся основной график."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "40% фоиз дар соли якуми қарз, 60% дар соли дуюм ва ҳамааш аз соли сеюм. Қисми пардохтнашуда бахшида намешавад: ҳангоми оғози ҷадвали асосӣ ба қарз илова мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredinin ilk yılında faizin %40'ı, ikinci yılında %60'ı, üçüncü yıldan itibaren tamamı ödenir. Ödenmeyen kısım silinmez; ana ödeme planı başladığında borca eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "40 % відсотків у перший рік кредиту, 60 % — у другий, з третього — усі. Несплачена частина не списується: вона додається до боргу, коли починається основний розклад."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditning birinchi yilida foizning 40%, ikkinchi yilida 60%, uchinchi yildan hammasi. To‘lanmagan qismi kechirilmaydi: asosiy jadval boshlanganda qarzga qo‘shiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贷款第一年支付利息的 40%，第二年支付 60%，第三年起全额支付。未付部分不会免除，将在主要还款计划开始时计入欠款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貸款第一年支付利息的 40%，第二年支付 60%，第三年起全額支付。未付的部分不會免除，會在主要還款計畫開始時計入債務。"
          }
        }
      }
    },
