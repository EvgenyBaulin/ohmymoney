          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По госпрограмме (40 % → 60 % → 100 % процентов)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Державна програма (40 % → 60 % → 100 % відсотків)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Programma statale (40% → 60% → 100% degli interessi)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мемлекеттік бағдарлама (пайыздың 40% → 60% → 100%)"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзяржпраграма (40% → 60% → 100% працэнтаў)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Staatsprogramm (40 % → 60 % → 100 % der Zinsen)"
          }
        }
      }
    },
    "schedule.graceKind.programme.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "40% of the interest in the first year of the loan, 60% in the second, all of it from the third. The part not paid is not forgiven: it joins the debt when the main schedule starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 40 % de los intereses en el primer año del préstamo, el 60 % en el segundo y todos desde el tercero. La parte no pagada no se perdona: se suma a la deuda cuando empieza el calendario principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "40 % des intérêts la première année du crédit, 60 % la deuxième, la totalité à partir de la troisième. La part non payée n'est pas remise : elle s'ajoute à la dette au début de l'échéancier principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "40 % начисленных процентов в первый год кредита, 60 % — во второй, с третьего — все. Неоплаченная часть не прощается: она добавится к долгу, когда начнётся основной график."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "40 % відсотків у перший рік кредиту, 60 % — у другий, з третього — усі. Несплачена частина не списується: вона додається до боргу, коли починається основний розклад."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 40% degli interessi nel primo anno del prestito, il 60% nel secondo e il totale dal terzo. La parte non pagata non viene condonata: si aggiunge al debito all'inizio del piano principale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Несие жылының бірінші жылында пайыздың 40%, екіншісінде 60%, үшіншіден бастап толық. Төленбеген бөлігі кешірілмейді: негізгі кесте басталғанда берешекке қосылады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "40% працэнтаў у першы год крэдыту, 60% у другі, усе працэнты з трэцяга. Неаплачаная частка не даруецца: яна дадаецца да доўгу з пачаткам асноўнага графіка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "40 % der Zinsen im ersten Jahr des Kredits, 60 % im zweiten, ab dem dritten alle. Der nicht bezahlte Teil wird nicht erlassen: Er kommt zur Schuld, wenn der Hauptplan beginnt."
          }
        }
      }
    },
