    "prepay.forward": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта плацеж наперад"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist eine Vorauszahlung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is a payment ahead"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un pago por adelantado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un paiement d'avance"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un pagamento anticipato delle rate"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл алдағы төлем"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wpłata na poczet rat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma antecipação de parcelas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это платёж вперёд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecek taksitlerin ödemesi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це платіж наперед"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oldindan to‘lov"
          }
        },
