    "debts.delete.cash": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы, перададзеныя праз журнал, застануцца ў балансах рахункаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld, das über das Journal den Besitzer wechselte, bleibt in den Kontosalden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money that changed hands through the journal stays in the account balances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero que pasó por el diario se mantiene en los saldos de las cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent qui a transité par le journal reste dans les soldes des comptes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli importi trasferiti tramite il registro rimangono nei saldi dei conti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал арқылы қолдан-қолға өткен ақша есеп-шот теңгерімдерінде қалады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieniądze przekazane za pośrednictwem dziennika pozostaną w saldach kont."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro movimentado pelo histórico permanece nos saldos das contas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги, которые по журналу переходили из рук в руки, остаются в остатках счетов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Defter üzerinden el değiştiren para hesap bakiyelerinde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші, що пройшли через журнал, лишаються в залишках рахунків."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnal orqali berilgan yoki olingan pul hisob qoldiqlarida qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過日誌記錄的資金往來會保留在帳戶餘額中。"
          }
        }
      }
    },
    "debts.delete.category": {
