    "form.monthPaid.ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is the payment day. Say whether the balance above is after today's payment — you cannot save before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy es día de pago. Indique si el saldo de arriba es después del pago de hoy: antes no se puede guardar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня день платежа. Скажите, указан ли остаток уже после сегодняшнего платежа, — без ответа не сохранить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні день платежу. Скажіть, чи залишок вище вже після сьогоднішнього платежу, — раніше зберегти не можна."
          }
        }
      }
    },
    "form.monthPaid.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«Yes»: the first payment owed is next month's. «No»: it is today's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sí»: el primer pago debido es el del mes que viene. «No»: es el de hoy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Да»: первый платёж к оплате — в следующем месяце. «Нет»: сегодняшний."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Так»: перший платіж, що належить, — наступного місяця. «Ні»: він сьогоднішній."
          }
        }
      }
    },
