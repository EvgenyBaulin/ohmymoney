    "debts.closedCaption": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borc bağlanıb. Ödəniş, qeyd və köçürmə üçün əvvəlcə borcu yenidən açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доўг закрыты. Каб дадаваць плацяжы, запісы і пераводы, спачатку адкрыйце яго зноў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dluh je uzavřený. Pro platby, záznamy a převody ho nejprve znovu otevřete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schuld ist beendet. Zahlungen, Einträge und Überweisungen gelten für offene Schulden: Öffnen Sie sie zuerst wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The debt is closed. Payments, entries and transfers are for open debts: reopen it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La deuda está cerrada. Los pagos, apuntes y transferencias son para deudas abiertas: primero reábrala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dette est clôturée. Les paiements, saisies et virements concernent les dettes ouvertes : rouvrez-la d'abord."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պարտքը փակված է։ Վճարումներ, գրառումներ և փոխանցումներ կատարելու համար նախ վերաբացեք այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il debito è chiuso. Per aggiungere pagamenti, voci o trasferimenti, riaprilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この借入は完済しています。支払い、記録、振替を行うには、先に再開してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალი დახურულია. გადახდები, ჩანაწერები და გადარიცხვები მხოლოდ ღია ვალებისთვისაა ხელმისაწვდომი: ჯერ ხელახლა გახსენით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек жабық. Төлемдер, жазбалар және аударымдар ашық берешектерге арналған: алдымен оны қайта ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료된 빚입니다. 결제, 기록 및 이체를 하려면 먼저 다시 여세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карыз жабылган. Төлөмдөр, жазуулар жана которуулар ачык карыздар үчүн жеткиликтүү: адегенде карызды кайра ачыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schuld is afgesloten. Heropen deze om betalingen, boekingen of overboekingen toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dług jest zamknięty. Aby dodać płatność, wpis lub przelew, najpierw otwórz go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A dívida está encerrada. Para adicionar pagamentos, lançamentos ou transferências, reabra-a primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A dívida está fechada. Para adicionar pagamentos, registos ou transferências, volte a abri-la primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долг закрыт. Платежи, записи и переносы — только у открытых долгов: сначала верните его в открытые."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қарз пӯшида аст. Барои пардохт, сабт ва интиқол аввал онро боз кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu borç kapalı. Ödeme, kayıt ve transfer eklemek için önce borcu yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Борг закрито. Платежі, записи й перекази належать відкритим боргам: спершу відкрийте його знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarz yopilgan. To‘lovlar, yozuvlar va o‘tkazmalar faqat ochiq qarzlar uchun: avval qarzni qayta oching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此债务已结清。还款、记账和转账仅适用于未结清的债务，请先重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "債務已結清。請先重新開啟，才能付款、新增記錄或轉帳。"
          }
        }
      }
    },
