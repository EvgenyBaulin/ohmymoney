      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər ay bütün borcların minimum ödənişləri edilir, əlavə məbləğ isə sıradakı ilk borca yönəldilir. Bağlanan borcun ödənişi növbəti borca keçir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Штомесяц уносяцца мінімальныя плацяжы па ўсіх даўгах, а дадатковыя грошы ідуць на першы доўг у чарзе. Пасля яго пагашэння плацёж пераходзіць да наступнага."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý měsíc zaplatíte minimální splátky všech dluhů a peníze navíc dáte na první dluh v pořadí. Splátka splaceného dluhu se přidá k dalšímu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Monat die Mindestzahlungen aller Schulden und das Geld darüber in die erste Schuld der Reihenfolge; eine abbezahlte Schuld gibt ihre Zahlung weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every month the minimum payments of all debts, and the money above into the first debt of the order; a debt paid off passes its payment on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mes se pagan los mínimos de todas las deudas, y el dinero sobrante va a la primera deuda del orden; la deuda saldada pasa su pago a la siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mois, les paiements minimum de toutes les dettes, et l'argent en surplus va sur la première dette de l'ordre ; une dette soldée transmet son paiement à la suivante."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն ամիս վճարվում են բոլոր պարտքերի նվազագույն վճարները, իսկ լրացուցիչ գումարն ուղղվում է հերթի առաջին պարտքին։ Մարված պարտքի վճարումն անցնում է հաջորդին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni mese paghi il minimo su tutti i debiti e versi l'importo extra sul primo debito in elenco. Quando un debito è estinto, il suo pagamento passa al successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月すべての負債の最低額を支払い、追加分を返済順の最初の負債に充てます。完済後はその支払額を次の負債に回します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველთვიურად იხდით ყველა ვალის მინიმალურ გადასახადს, დამატებით თანხას კი — რიგში პირველ ვალზე. დაფარული ვალის გადასახადი შემდეგზე გადადის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр ай сайын барлық берешектің ең аз төлемі, ал үстіндегі ақша реттілік бойынша бірінші берешекке жіберіледі; жабылған берешектің төлемі келесісіне өтеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매달 모든 부채의 최소 납입액을 내고 추가 금액은 순서에 따라 첫 번째 부채에 납입합니다. 부채를 완납하면 해당 납입액을 다음 부채에 더합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай сайын бардык карыздардын эң аз төлөмдөрү төлөнөт, ал эми кошумча акча тизмедеги биринчи карызга жумшалат. Карыз жабылганда анын төлөмү кийинкисине өтөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaal elke maand het minimumbedrag voor alle schulden en besteed het extra bedrag aan de eerste schuld in de volgorde. Is een schuld afgelost, dan gaat de betaling naar de volgende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co miesiąc spłacane są minimalne raty wszystkich długów, a dodatkowe środki trafiają na pierwszy dług w kolejności. Rata spłaconego długu przechodzi na następny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mês, pague o mínimo de todas as dívidas e aplique o valor extra na primeira dívida da ordem. Ao quitar uma dívida, seu pagamento passa para a próxima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os meses, pague o mínimo de cada dívida e aplique o valor adicional na primeira dívida da ordem. Quando uma dívida é liquidada, o seu pagamento passa para a seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый месяц — минимальные платежи всех долгов, а деньги сверх — в первый по порядку; закрытый долг отдаёт свой платёж следующему."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳар моҳ пардохти ҳадди ақали ҳамаи қарзҳо ва маблағи иловагӣ ба қарзи аввали навбат дода мешавад; пас аз пӯшидани қарз, пардохти он ба қарзи оянда мегузарад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ay tüm borçların asgari ödemeleri yapılır ve ek tutar sıradaki ilk borca ayrılır. Kapanan borcun ödemesi sıradakine aktarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щомісяця мінімальні платежі за всіма боргами, а гроші понад них — у перший борг черги; погашений борг передає свій платіж далі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har oy barcha qarzlarning eng kam to‘lovlari to‘lanadi, qo‘shimcha pul esa ro‘yxatdagi birinchi qarzga yo‘naltiriladi. Qarz yopilgach, uning to‘lovi keyingisiga o‘tadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月先偿还所有债务的最低还款额，再将额外金额用于偿还顺序中的第一笔债务；还清一笔后，其还款额将用于下一笔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月先支付所有債務的最低還款額，再將額外金額用於償還排序第一的債務；還清一筆後，其還款額會用於下一筆。"
          }
        }
      }
    },
