    "refinance.explain": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Новы крэдыт пагасіў гэты. Будуць запісаны абодва: новы крэдыт і плацеж, які закрывае гэты. Адмена скасуе абодва запісы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Kredit hat diesen abgelöst. Hier werden beide zugleich erfasst: der neue Kredit und eine Zahlung, die diesen beendet. Rückgängig nimmt beides zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new loan paid this one off. This records both at once: the new loan, and a payment that closes this one. Undo takes both back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuevo préstamo canceló este. Esto registra las dos cosas a la vez: el nuevo préstamo y un pago que cierra este. Deshacer quita ambas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau crédit solde celui-ci. Cela note les deux d'un coup : le nouveau crédit, et un paiement qui clôt celui-ci. Annuler retire les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo prestito ha estinto questo debito. Verranno registrati entrambi: il nuovo prestito e il pagamento che chiude questo debito. Annullando, verranno rimossi entrambi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа несие бұрынғысын жапты. Бұл екеуін бірден жазады: жаңа несие және осы несиені жабатын төлем. Болдырмау екеуін де қайтарады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy kredyt spłacił ten kredyt. Zapiszemy jednocześnie nowy kredyt i wpłatę zamykającą obecny. Cofnięcie usunie oba zapisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo empréstimo quitou este. Registre os dois de uma vez: o novo empréstimo e o pagamento que quita este. Ao desfazer, ambos são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый кредит погасил этот. Запись делает всё сразу: заводит новый кредит и платёж, который закрывает этот. Отмена возвращает оба."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredi yeni bir krediyle kapatıldı. Bu işlem hem yeni krediyi hem de bu krediyi kapatan ödemeyi kaydeder. Geri alındığında ikisi de kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Новий кредит погасив цей. Тут записуються одразу обидва: новий кредит і платіж, що закриває цей. Скасування повертає обидва."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredit yangi kredit bilan yopildi. Ikkalasi birdan qayd etiladi: yangi kredit va bunisini yopadigan to‘lov. Bekor qilinsa, ikkalasi ham qaytariladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆貸款已由新貸款清償。此操作會同時記錄新貸款及結清此貸款的還款。撤銷時會一併撤銷兩者。"
          }
        }
      }
    },
