    "costs.pskGap": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічаная стаўка адрозніваецца ад поўнага кошту ў дамове на %@ п. п. — праверце, ці ўведзены ўсе камісіі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der errechnete Satz weicht von den Gesamtkosten laut Vertrag um %@ Prozentpunkte ab — prüfen Sie, ob jede Gebühr eingetragen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worked-out rate differs from the contract's full cost by %@ p.p. — check that every fee is entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tasa calculada difiere del coste total del contrato en %@ p.p. — compruebe que se han introducido todas las comisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux calculé diffère du coût total du contrat de %@ point(s) — vérifiez que chaque frais est saisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasso calcolato differisce dal costo totale del contratto di %@ punti percentuali. Verifica di aver inserito tutte le commissioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептелген мөлшерлеме шарттағы толық шығыстан %@ п.п. өзгешеленеді — әр комиссия енгізілгенін тексеріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczona stopa różni się od całkowitego kosztu z umowy o %@ p.p. — sprawdź, czy dodano wszystkie opłaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa calculada difere do custo total do contrato em %@ p.p. — confira se todas as tarifas foram informadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расчёт расходится с ПСК договора на %@ п. п. — проверьте, все ли комиссии внесены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplanan oran, sözleşmedeki toplam maliyet oranından %@ yüzde puan farklı. Tüm ücretlerin girildiğini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розрахована ставка відрізняється від повної вартості за договором на %@ п.п. — перевірте, чи введено всі комісії."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblangan stavka shartnomadagi to‘liq qiymatdan %@ foiz bandiga farq qiladi — barcha komissiyalar kiritilganini tekshiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算出的利率與合約的總費用率相差 %@ 個百分點，請確認已輸入所有費用。"
          }
        }
      }
    },
