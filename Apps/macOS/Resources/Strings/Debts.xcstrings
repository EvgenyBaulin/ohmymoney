    "review.card.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта крэдытная картка захавана і як рахунак, і як доўг: яе доўг улічваецца двойчы. Пакіньце толькі рахунак — доўг будзе выдалены, а яго стаўка пяройдзе ва ўмовы карткі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kreditkarte ist sowohl als Konto als auch als Schuld geführt: Ihre Schuld wird zweimal gezählt. Behalten Sie nur das Konto — die Schuld wird gelöscht, ihr Zinssatz geht in die Bedingungen der Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This credit card is kept both as an account and as a debt: its debt is counted twice. Keep only the account — the debt is deleted, its rate goes to the card's terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarjeta de crédito se guarda a la vez como cuenta y como deuda: su deuda se cuenta dos veces. Conserve solo la cuenta — la deuda se elimina y su tipo pasa a las condiciones de la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette carte de crédit est gardée à la fois comme compte et comme dette : sa dette est comptée deux fois. Gardez seulement le compte — la dette est supprimée, son taux passe dans les conditions de la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa carta di credito è registrata sia come conto che come debito: il debito viene conteggiato due volte. Mantieni solo il conto: il debito verrà eliminato e il suo tasso sarà trasferito alle condizioni della carta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл кредиттік карта және есеп-шот, және берешек ретінде сақталған: оның берешегі екі рет саналады. Тек есеп-шотты қалдырыңыз — берешек жойылады, оның мөлшерлемесі картаның шарттарына көшеді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta karta kredytowa jest zapisana jako konto i jako zobowiązanie, więc zadłużenie jest liczone podwójnie. Zostaw tylko konto — zobowiązanie zostanie usunięte, a jego oprocentowanie trafi do warunków karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cartão de crédito está registrado como conta e como dívida: o saldo devedor é contado duas vezes. Mantenha apenas a conta — a dívida será apagada e sua taxa passará para as condições do cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта кредитка ведётся и счётом, и долгом — её долг считается дважды. Оставьте только счёт: долг удалится, его ставка перейдёт в условия карты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredi kartı hem hesap hem de borç olarak tutuluyor; borcu iki kez sayılıyor. Yalnızca hesabı tutun; borç silinir ve faiz oranı kart koşullarına aktarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю кредитну картку зберігано і як рахунок, і як борг: її борг враховано двічі. Лишіть лише рахунок — борг видаляється, а його ставка переходить до умов картки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kredit karta ham hisob, ham qarz sifatida saqlangan: qarzi ikki marta hisoblanmoqda. Faqat hisobni qoldiring — qarz o‘chiriladi, uning stavkasi karta shartlariga o‘tkaziladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張信用卡同時記錄為帳戶和債務，債務因此被重複計算。請只保留帳戶：債務會被刪除，利率會移至卡片條件。"
          }
        }
      }
    },
    "review.done": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На ўсе пытанні пра даўгі атрыманы адказы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Schuld ist beantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every debt is answered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las deudas están respondidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque dette a une réponse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai risposto per tutti i debiti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық берешектерге жауап берілген."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udzielono odpowiedzi dla wszystkich zobowiązań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as dívidas foram revisadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На все вопросы отвечено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm borçlarla ilgili sorular yanıtlandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На кожен борг дано відповідь."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha qarzlar ko‘rib chiqildi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有債務均已確認。"
          }
        }
      }
    },
    "review.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль вы не адкажаце, новыя разлікі не выконваюцца. «Пазней» адкладзе пытанне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird neu berechnet, bis Sie antworten. „Später“ fragt ein andermal erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is worked out anew until you answer. «Later» asks again another time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se vuelve a calcular hasta que responda. «Más tarde» vuelve a preguntar otro día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est recalculé tant que vous n'avez pas répondu. « Plus tard » redemande une autre fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non verrà ricalcolato nulla finché non rispondi. Con «Più tardi» la domanda verrà riproposta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жауап бергенге дейін ештеңе қайтадан есептелмейді. «Кейін» басқа уақытта қайта сұрайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki nie odpowiesz, nic nie zostanie przeliczone. Wybierz «Później», aby wrócić do pytania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada será recalculado até você responder. «Depois» perguntará novamente em outro momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не пересчитывается, пока вы не ответите. «Позже» — спросим в другой раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlayana kadar hiçbir şey yeniden hesaplanmaz. «Daha Sonra» seçeneği soruyu tekrar sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не перераховується, доки ви не відповісте. «Пізніше» запитає знову іншим разом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Javob bermaguningizcha hech narsa qayta hisoblanmaydi. «Keyinroq» tanlansa, yana so‘raladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
