    "schedule.graceKind.interest.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər ay indiyədək götürülmüş məbləğin faizi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожны месяц — працэнты на ўжо атрыманыя грошы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý měsíc úroky z dosud čerpané částky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Monat — die Zinsen auf das bisher abgerufene Geld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each month — the interest on the money drawn so far."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mes — los intereses sobre el dinero dispuesto hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mois — les intérêts sur l'argent tiré jusqu'ici."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն ամիս՝ արդեն օգտագործված գումարի տոկոսները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni mese, gli interessi sull'importo erogato fino a quel momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その時点までの借入額に対する利息を毎月支払います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველთვიურად — იმ დროისთვის ათვისებული თანხის პროცენტი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр ай — алынған ақшаға есептелген пайыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 지금까지 실행한 금액의 이자를 납부합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай сайын — ушул күнгө чейин алынган акчанын пайызы."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke maand de rente over het tot dan toe opgenomen bedrag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co miesiąc odsetki od dotychczas wypłaconej kwoty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mês, os juros sobre o valor liberado até então."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os meses — os juros sobre o montante utilizado até à data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый месяц — проценты на уже полученные деньги."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳар моҳ — фоиз аз маблағи то он вақт гирифташуда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ay, o ana kadar kullanılan tutarın faizi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щомісяця — відсотки на вже взяті гроші."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har oy — shu paytgacha olingan pul bo‘yicha foizlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月支付截至当时已提取金额的利息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月支付截至當時已撥款金額的利息。"
          }
        }
      }
    },
