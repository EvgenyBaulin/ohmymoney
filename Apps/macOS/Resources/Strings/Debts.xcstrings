    "prepay.paymentDayOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank takes an early repayment only on a payment day: the money lowers the debt on the next one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco acepta una amortización anticipada solo en día de pago: el dinero reduce la deuda en el siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque n'accepte un remboursement anticipé que le jour de paiement : l'argent réduit la dette au paiement suivant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк принимает досрочку только в день платежа: деньги уменьшат долг в ближайший."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк приймає дострокове погашення лише в день платежу: гроші зменшують борг у наступний."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca accetta rimborsi anticipati solo il giorno della rata: il denaro riduce il debito alla prossima scadenza."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк мерзімнен бұрын өтеуді тек төлем күні қабылдайды: ақша келесі төлем күні берешекті азайтады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк прымае датэрміновае пагашэнне толькі ў дзень плацяжу: грошы паменшаць доўг у наступны такі дзень."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank nimmt eine vorzeitige Rückzahlung nur an einem Zahlungstag an: Das Geld senkt die Schuld am nächsten."
          }
        }
      }
    },
