            "value": "Пачынаючы з плацяжу"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab der Fälligkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the due"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde el vencimiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir de l'échéance"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla scadenza"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мерзімнен бастап"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od terminu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir do vencimento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С платежа"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu vadeden itibaren"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від платежу"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘lov muddatidan boshlab"
          }
        },
