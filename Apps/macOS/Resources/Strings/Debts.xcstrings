    "form.moneyMoved": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы перададзены (пазычаны цяпер)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld hat den Besitzer gewechselt (jetzt geliehen oder verliehen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money changed hands (borrowed or lent now)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero se entregó (prestado o dado ahora)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent a changé de mains (emprunté ou prêté maintenant)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro è stato scambiato (prestato o ricevuto ora)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша қолдан-қолға өтті (қазір қарызға алынды немесе берілді)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazano pieniądze (pożyczono teraz)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro mudou de mãos (emprestado ou recebido agora)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги перешли из рук в руки (взял или дал сейчас)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el değiştirdi (şimdi borç alındı veya verildi)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші переходять із рук у руки (позичаю або позичаю зараз)"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul berildi yoki olindi (hozir qarzga olindi yoki berildi)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "款項已轉移（現在借入或借出）"
          }
        }
      }
    },
    "form.moneyMovedToday": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы перададзены сёння"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld hat heute den Besitzer gewechselt"
          }
        },
        "en": {
          "stringUnit": {
