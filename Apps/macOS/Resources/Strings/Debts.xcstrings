    "debts.payoff": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayda %@ artıq ödəməklə borc %@ daha tez bağlanar"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі плаціць на %@ больш за месяц, доўг будзе пагашаны на %@ раней"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při splácení o %@ měsíčně navíc bude dluh splacen o %@ dříve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie %@ im Monat mehr zahlen, wäre sie %@ früher beendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paying %@ a month more would close it %@ earlier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar %@ al mes más la cerraría %@ antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer %@ de plus par mois la fermerait %@ plus tôt"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսական %@ ավելի վճարելով՝ պարտքը կփակվի %@ շուտ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagando %@ in più al mese, si estingue %@ prima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月%@を追加返済すると、%@早く完済できます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვეში %@-ით მეტის გადახდით ვალი %@-ით ადრე დაიფარება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айына тағы %@ төлесеңіз, ол %@ ертерек жабылады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 %@ 더 상환하면 %@ 일찍 갚을 수 있음"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айына %@ көбүрөөк төлөсөңүз, карыз %@ эрте жабылат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met %@ meer per maand is de schuld %@ eerder afgelost"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłata o %@ więcej miesięcznie pozwoli spłacić dług o %@ wcześniej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar %@ a mais por mês quitaria a dívida %@ antes"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar mais %@ por mês liquidaria a dívida %@ mais cedo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если платить на %@ в месяц больше, закроется на %@ раньше"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Агар ҳар моҳ %@ бештар пардохт кунед, қарз %@ барвақттар баста мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayda %@ daha fazla ödeyerek borcu %@ daha erken kapatabilirsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо платити на %@ на місяць більше, його закриють на %@ раніше"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyiga %@ ko‘proq to‘lansa, qarz %@ oldin yopiladi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月多还 %@ 可提前 %@ 还清"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月多付 %@，可提前 %@ 還清"
          }
        }
      }
    },
    "debts.payoffNever": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödənişlə borc heç vaxt bağlanmaz: faizləri ödəmir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры такім плацяжы доўг ніколі не будзе пагашаны: ён не пакрывае працэнты"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při této splátce nebude dluh nikdy splacen: nepokrývá úroky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei dieser Zahlung endet die Schuld nie: Sie deckt die Zinsen nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this payment the debt never closes: it does not cover the interest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con este pago la deuda nunca se cierra: no cubre los intereses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ce paiement, la dette ne se clôt jamais : il ne couvre pas les intérêts"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս վճարով պարտքը երբեք չի փակվի․ այն չի ծածկում տոկոսները"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questa rata il debito non si estingue: non copre gli interessi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この返済額では利息をまかなえないため、完済できません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ გადასახადით ვალი ვერ დაიფარება: ის პროცენტს არ ფარავს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл төлем кезінде берешек ешқашан жабылмайды: ол пайызды жаппайды"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 납입금으로는 이자도 갚지 못해 채무가 줄지 않음"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул төлөм пайыздарды жаппайт, карыз эч качан жабылбайт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze betaling wordt de schuld nooit afgelost: de rente wordt niet gedekt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy tej racie dług nigdy nie zostanie spłacony: rata nie pokrywa odsetek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com esse pagamento, a dívida nunca será quitada: ele não cobre os juros"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com este pagamento, a dívida nunca é liquidada: não cobre os juros"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При таком платеже долг не закроется: он не покрывает проценты"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо ин пардохт қарз ҳеҷ гоҳ баста намешавад: он фоизро намепӯшонад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödeme faizi karşılamadığı için borç hiç kapanmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цього платежу борг ніколи не закриється: він не покриває відсотків"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu to‘lov foizlarni qoplamaydi, shuning uchun qarz hech qachon yopilmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按此金额还款无法还清债务：还款额不足以支付利息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以此金額付款無法還清債務，因為不足以支付利息"
          }
        }
      }
    },
