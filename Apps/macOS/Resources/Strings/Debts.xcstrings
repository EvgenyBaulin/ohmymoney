    "form.pay.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the debt: this payment pays it off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la deuda: este pago la salda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturer la dette : ce paiement la solde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть долг: этот платёж его гасит"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити борг: цей платіж його погашає"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi il debito: questo pagamento lo estingue"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешекті жабу: бұл төлем оны толық жабады"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыць доўг: гэты плацёж пагашае яго"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuld beenden: Diese Zahlung tilgt sie ganz"
          }
        }
      }
    },
    "form.pay.closesTerm": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more payments this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No habrá más pagos este mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de paiements ce mois-ci"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце больше платежей не будет"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього місяця більше платежів немає"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда басқа төлем жоқ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro pagamento questo mese"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш плацяжоў у гэтым месяцы няма"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine weiteren Zahlungen in diesem Monat"
          }
        }
      }
    },
    "form.pay.closesTermHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The due counts as paid although this payment is smaller than the monthly one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vencimiento cuenta como pagado aunque este pago sea menor que el mensual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'échéance compte comme payée, bien que ce paiement soit plus petit que la mensualité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок будет считаться оплаченным, хотя платёж меньше ежемесячного."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж зараховано як сплачений, хоча він менший за місячний."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rata risulta pagata anche se questo pagamento è inferiore a quello mensile."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл төлем айлықтан кіші болса да, міндеттеме төленген деп саналады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж лічыцца ўнесеным, хоць яго сума меншая за штомесячную."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fälligkeit gilt als bezahlt, auch wenn diese Zahlung kleiner ist als die monatliche."
          }
        }
      }
    },
    "form.pay.expense": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense in Loans, and the debt goes down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gasto en Préstamos, y la deuda baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense dans Crédits, et la dette baisse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход в «Кредитах», и долг уменьшится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрата в «Кредитах», а борг зменшується."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una spesa in Prestiti e il debito diminuisce."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Несиедегі» шығыс, ал берешек азаяды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдатак у катэгорыі «Пазыкі», а доўг памяншаецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe in „Kredite“, und die Schuld sinkt."
          }
        }
      }
    },
    "form.pay.notExpense": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the debt goes down: the purchase was the expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo baja la deuda: el gasto fue la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la dette baisse : c'est l'achat qui était la dépense."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только уменьшит долг: расходом была сама покупка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише борг зменшується: витратою була покупка."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminuisce solo il debito: l'acquisto era la spesa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек берешек азаяды: шығыс — сатып алу болған."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Памяншаецца толькі доўг: выдаткам была пакупка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Schuld sinkt: Der Kauf war die Ausgabe."
          }
        }
      }
    },
    "form.pay.over": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is %2$@ more than is left (%1$@). Closed, the debt writes it off; left open, it shows −%2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es %2$@ más de lo que queda (%1$@). Cerrada, la deuda da de baja ese exceso; abierta, muestra −%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est %2$@ de plus que ce qui reste (%1$@). Clôturée, la dette passe ce surplus en pertes ; laissée ouverte, elle affiche −%2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это на %2$@ больше остатка (%1$@). Закрытый долг спишет лишнее, открытый покажет остаток −%2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це на %2$@ більше, ніж лишилося (%1$@). Закритий борг списує це; відкритий показує −%2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %2$@ in più del residuo (%1$@). Se chiudi il debito, la differenza viene annullata; se lo lasci aperto, mostra −%2$@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қалғаннан (%1$@) %2$@ артық. Жабылса, берешек оны есептен шығарады; ашық қалса, −%2$@ көрсетіледі."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта на %2$@ больш за рэшту (%1$@). Пры закрыцці доўгу розніца спішацца; калі пакінуць яго адкрытым, будзе паказана −%2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %2$@ mehr, als übrig ist (%1$@). Beendet, schreibt die Schuld es ab; offen gelassen, zeigt sie −%2$@."
          }
        }
      }
    },
    "form.pay.overSurplus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is %2$@ more than is left (%1$@). The debt closes with what is left, and %2$@ goes to income in Surcharges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es %2$@ más de lo que queda (%1$@). La deuda se cierra con lo que queda, y %2$@ va a ingresos en Recargos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est %2$@ de plus que ce qui reste (%1$@). La dette se clôt avec ce qui reste, et %2$@ va en revenu dans Surplus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это на %2$@ больше остатка (%1$@). Долг закроется остатком, а %2$@ станут доходом в «Доплатах»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це на %2$@ більше, ніж лишилося (%1$@). Борг закривається з тим, що лишилося, а %2$@ іде в доходи в «Надбавках»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %2$@ in più del residuo (%1$@). Il debito si chiude con il residuo e %2$@ vanno nelle entrate in Maggiorazioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қалғаннан (%1$@) %2$@ артық. Берешек қалғанмен жабылады, ал %2$@ «Үстемақылардағы» табысқа кетеді."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта на %2$@ больш за рэшту (%1$@). Доўг закрыецца на суму рэшты, а %2$@ пойдзе ў даход у катэгорыі «Даплаты»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %2$@ mehr, als übrig ist (%1$@). Die Schuld endet mit dem Rest, und %2$@ wird als Einnahme bei den Aufschlägen verbucht."
          }
        }
      }
    },
    "form.pay.returned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money returned by the person: not income, the debt goes down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinero devuelto por la persona: no es ingreso, la deuda baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argent rendu par la personne : ce n'est pas un revenu, la dette baisse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги вернул человек: это не доход, долг уменьшится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші повернула людина: це не дохід, а борг зменшується."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Denaro restituito dalla persona: non è un'entrata, il debito diminuisce."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адам қайтарған ақша: табыс емес, берешек азаяды."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чалавек вярнуў грошы: гэта не даход, доўг памяншаецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Menschen zurückgegebenes Geld: keine Einnahme, die Schuld sinkt."
          }
        }
      }
    },
