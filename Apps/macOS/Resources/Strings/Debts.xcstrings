    "debts.delete.owedLater": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі «%@» верне грошы пазней, гэта будзе ўлічана як даход."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlt „%@“ dies später zurück, wird es als Einnahme erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If «%@» pays this back later, it will be recorded as income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si «%@» devuelve esto más tarde, se registrará como ingreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si « %@ » rembourse plus tard, ce sera noté comme revenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se «%@» restituirà l’importo in seguito, verrà registrato come entrata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Егер «%@» бұны кейін қайтарса, ол табыс ретінде жазылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli «%@» zwróci te pieniądze później, zostaną zapisane jako przychód."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se «%@» pagar essa dívida mais tarde, o valor será registrado como receita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если «%@» потом вернёт эти деньги, они запишутся доходом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» bu borcu daha sonra öderse ödeme gelir olarak kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо «%@» поверне це пізніше, це буде записано як дохід."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar «%@» bu qarzni keyinroq qaytarsa, u kirim sifatida qayd etiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若「%@」日後還款，將記錄為收入。"
          }
        }
      }
    },
    "debts.delete.purchase": {
      "extractionState": "manual",
      "localizations": {
        "be": {
