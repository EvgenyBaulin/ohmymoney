    "ladder.snowball.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəl ən kiçik qalıq: ilk borc daha tez bağlanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку найменшая рэшта: першы доўг знікне раней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve nejnižší zůstatek: první dluh splatíte dříve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst der kleinste Saldo: die erste Schuld ist früher weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The smallest balance first: the first debt goes sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero el saldo más pequeño: la primera deuda se cierra antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus petit solde d'abord : la première dette se termine plus vite."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սկզբում՝ ամենափոքր մնացորդը․ առաջին պարտքն ավելի շուտ է մարվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima il saldo più piccolo: il primo debito si estingue prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残額の少ない順に返済し、最初の完済を早めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ ყველაზე მცირე ნაშთი: პირველი ვალი უფრო ადრე დაიფარება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең кіші қалдық бірінші: бірінші берешек тезірек жабылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액이 작은 부채부터 상환하여 첫 부채를 더 빨리 정리합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адегенде эң кичине калдык: биринчи карыз эрте жабылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinste saldo eerst: de eerste schuld is sneller afgelost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw najmniejsze saldo: szybciej znika pierwszy dług."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menor saldo primeiro: a primeira dívida é quitada mais cedo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo mais baixo primeiro: a primeira dívida fica paga mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала самый маленький остаток — первый долг уйдёт быстрее."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аввал бақияи хурдтарин: қарзи аввал зудтар пӯшида мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce en küçük bakiye: İlk borç daha erken kapanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу найменший залишок: перший борг закривається швидше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval eng kichik qoldiq: birinchi qarz tezroq yopiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先偿还余额最小的债务，更快还清第一笔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先還餘額最小的債務，更快還清第一筆。"
          }
        }
      }
    },
