    "pledge.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Заклад — не выдатак: гэта грошы, якія вам павінны вярнуць. Напамін прыйдзе за тыдзень да даты вяртання."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sicherheitsleistung ist keine Ausgabe: Es ist Geld, das Ihnen zurückgegeben wird. Eine Woche vor dem Tag wird daran erinnert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pledge is not spending: it is money owed back to you. A week before the day it is reminded of."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un deposito cauzionale non è una spesa: è denaro che ti deve essere restituito. Riceverai un promemoria una settimana prima della scadenza."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кепілдік — шығыс емес: ол сізге қайтарылуы тиіс ақша. Күнге дейін бір апта бұрын еске салады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Залог — не трата, а деньги, которые вам вернут. За неделю до срока будет напоминание."
          }
        }
      }
    },
    "pledge.loss.note": {
