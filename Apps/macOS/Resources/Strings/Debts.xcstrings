    "form.monthPaid": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın ödənişi artıq edilib?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж за гэты месяц ужо ўнесены?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Splátka za tento měsíc už je zaplacená?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung für diesen Monat ist schon erfolgt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's payment already made?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya se hizo el pago de este mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mensualité de ce mois est-elle déjà payée ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվա վճարն արդե՞ն կատարված է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rata di questo mese è già stata pagata?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月分は返済済みですか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვის გადასახადი უკვე გადახდილია?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдағы төлем бұрын төленді ме?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 납입금을 이미 납부했습니까?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айдын төлөмү төлөндүбү?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaling van deze maand al gedaan?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rata za ten miesiąc została już opłacona?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento deste mês já foi feito?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento deste mês já foi feito?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёж за этот месяц уже сделан?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пардохти ин моҳ аллакай анҷом шудааст?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın ödemesi yapıldı mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж цього місяця вже зроблено?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy to‘lovi allaqachon amalga oshirilganmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月已还款？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月款項已付？"
          }
        }
      }
    },
    "form.monthPaid.ask": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün ödəniş günüdür. Yuxarıdakı qalığın bugünkü ödənişdən sonrakı məbləğ olub-olmadığını seçin. Seçmədən yadda saxlamaq olmaz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сёння дзень плацяжу. Пазначце, ці ўлічаны сённяшні плацёж у рэшце вышэй. Без гэтага захаваць не атрымаецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes je den splátky. Uveďte, zda je výše uvedený zůstatek po dnešní splátce. Bez toho nelze uložit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist der Zahlungstag. Sagen Sie, ob der Saldo oben nach der heutigen Zahlung gilt — vorher können Sie nicht sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is the payment day. Say whether the balance above is after today's payment — you cannot save before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy es día de pago. Indique si el saldo de arriba es después del pago de hoy: antes no se puede guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui est le jour de paiement. Dites si le solde ci-dessus est établi après le paiement d'aujourd'hui — vous ne pouvez pas enregistrer avant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօր վճարման օրն է։ Նշեք՝ վերևի մնացորդը այսօրվա վճարումի՞ց հետո է։ Առանց դրա հնարավոր չէ պահպանել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi è il giorno della rata. Indica se il saldo sopra include già il pagamento di oggi: è necessario per salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は返済日です。上記の残高が今日の返済後の金額かどうかを選択してください。選択するまで保存できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღეს გადახდის დღეა. მიუთითეთ, ასახავს თუ არა ზემოთ მოცემული ნაშთი დღევანდელ გადახდას. მანამდე შენახვა შეუძლებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін — төлем күні. Жоғарыдағы берешек бүгінгі төлемнен кейін ме, айтыңыз — бұрын сақтау мүмкін емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 납입일입니다. 위 잔액이 오늘 납입금을 반영한 금액인지 선택해야 저장할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүн төлөм күнү. Жогорудагы калдык бүгүнкү төлөмдөн кийинкиси экенин көрсөтүңүз. Ансыз сактоо мүмкүн эмес."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag is de betaaldag. Geef aan of het saldo hierboven na de betaling van vandaag is. Anders kun je niet bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś jest dzień płatności. Określ, czy saldo powyżej uwzględnia dzisiejszą spłatę. Jest to wymagane do zapisania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje é o dia do pagamento. Informe se o saldo acima é posterior ao pagamento de hoje para poder salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje é o dia de pagamento. Indique se o saldo acima já inclui o pagamento de hoje para poder guardar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня день платежа. Скажите, указан ли остаток уже после сегодняшнего платежа, — без ответа не сохранить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имрӯз рӯзи пардохт аст. Нишон диҳед, ки бақияи боло пас аз пардохти имрӯза аст ё не. Бе ин захира карда намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün ödeme günü. Kaydetmeden önce yukarıdaki bakiyenin bugünkü ödemeden sonraki tutar olup olmadığını belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні день платежу. Скажіть, чи залишок вище вже після сьогоднішнього платежу, — раніше зберегти не можна."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun to‘lov kuni. Yuqoridagi qarz qoldig‘i bugungi to‘lovdan keyingi miqdormi? Javob bermasdan saqlab bo‘lmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天是还款日。请说明上方余额是否已扣除今天的还款，然后才能存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天是付款日。請確認上述餘額是否已扣除今天的付款，才能儲存。"
          }
        }
      }
    },
    "form.monthPaid.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Bəli»: ilk ödəniş gələn ayadır. «Xeyr»: bu günədir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«Так»: першы плацёж — у наступным месяцы. «Не»: сёння."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ano»: první splátka je splatná příští měsíc. «Ne»: je splatná dnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ja“: Die erste fällige Zahlung ist die des nächsten Monats. „Nein“: Sie ist die von heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«Yes»: the first payment owed is next month's. «No»: it is today's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sí»: el primer pago debido es el del mes que viene. «No»: es el de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Oui » : la première échéance due est celle du mois prochain. « Non » : c'est celle d'aujourd'hui."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Այո»՝ հաջորդ վճարումը հաջորդ ամիս է։ «Ոչ»՝ այսօր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sì»: la prima rata dovuta è quella del mese prossimo. «No»: è quella di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "«はい»: 最初の返済は来月です。«いいえ»: 今日です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«დიახ»: პირველი გადასახადი მომდევნო თვეშია. «არა»: დღეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Иә»: бірінші міндетті төлем келесі айдікі. «Жоқ»: ол бүгінгі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«예»: 첫 납입일은 다음 달입니다. «아니요»: 오늘입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ооба»: биринчи төлөм кийинки айда. «Жок»: бүгүн."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ja»: de eerstvolgende betaling is volgende maand. «Nee»: die is vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Tak»: pierwsza rata do zapłaty przypada w przyszłym miesiącu. «Nie»: przypada dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sim»: o primeiro pagamento devido é o do mês que vem. «Não»: é o de hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sim»: o primeiro pagamento devido é o do próximo mês. «Não»: é o de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Да»: первый платёж к оплате — в следующем месяце. «Нет»: сегодняшний."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ҳа»: пардохти аввал моҳи оянда аст. «Не»: имрӯз аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Evet»: İlk ödeme gelecek ay yapılacak. «Hayır»: İlk ödeme bugün yapılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Так»: перший платіж, що належить, — наступного місяця. «Ні»: він сьогоднішній."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ha»: birinchi to‘lov keyingi oyda. «Yo‘q»: bugun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«是»：首次应还款为下月。«否»：首次应还款为今天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«是»：首次應付款為下個月。«否»：首次應付款為今天。"
          }
        }
      }
    },
