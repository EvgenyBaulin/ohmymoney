    "form.pay.close": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыць доўг: гэты плацёж пагашае яго"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuld beenden: Diese Zahlung tilgt sie ganz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the debt: this payment pays it off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la deuda: este pago la salda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturer la dette : ce paiement la solde"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi il debito: questo pagamento lo estingue"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешекті жабу: бұл төлем оны толық жабады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij dług: ta wpłata go spłaca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar a dívida com este pagamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть долг: этот платёж его гасит"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borcu kapat: Bu ödeme borcu bitiriyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити борг: цей платіж його погашає"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarzni yopish: bu to‘lov uni to‘liq qoplaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結清債務：此筆付款將還清債務"
          }
        }
      }
    },
    "form.pay.closesTerm": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш плацяжоў у гэтым месяцы няма"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine weiteren Zahlungen in diesem Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more payments this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No habrá más pagos este mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de paiements ce mois-ci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro pagamento questo mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда басқа төлем жоқ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez dalszych wpłat w tym miesiącu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem mais pagamentos neste mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце больше платежей не будет"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay başka ödeme yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього місяця більше платежів немає"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy boshqa to‘lov yo‘q"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月無須再付款"
          }
        }
      }
    },
    "form.pay.closesTermHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж лічыцца ўнесеным, хоць яго сума меншая за штомесячную."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fälligkeit gilt als bezahlt, auch wenn diese Zahlung kleiner ist als die monatliche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The due counts as paid although this payment is smaller than the monthly one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vencimiento cuenta como pagado aunque este pago sea menor que el mensual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'échéance compte comme payée, bien que ce paiement soit plus petit que la mensualité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rata risulta pagata anche se questo pagamento è inferiore a quello mensile."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл төлем айлықтан кіші болса да, міндеттеме төленген деп саналады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rata zostanie uznana za zapłaconą, choć ta wpłata jest od niej niższa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parcela será considerada paga, mesmo que este pagamento seja menor que o mensal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок будет считаться оплаченным, хотя платёж меньше ежемесячного."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödeme aylık tutardan az olsa da taksit ödenmiş sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж зараховано як сплачений, хоча він менший за місячний."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu to‘lov oylik to‘lovdan kam bo‘lsa ham, oylik to‘lov to‘langan deb hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雖然此筆付款低於每月還款額，仍將本期款項標記為已付。"
          }
        }
      }
    },
    "form.pay.expense": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдатак у катэгорыі «Пазыкі», а доўг памяншаецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe in „Kredite“, und die Schuld sinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An expense in Loans, and the debt goes down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gasto en Préstamos, y la deuda baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dépense dans Crédits, et la dette baisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una spesa in Prestiti e il debito diminuisce."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Несиедегі» шығыс, ал берешек азаяды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatek w kategorii Pożyczki, a dług maleje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma despesa em Empréstimos, e a dívida diminui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход в «Кредитах», и долг уменьшится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediler'e gider kaydedilir ve borç azalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрата в «Кредитах», а борг зменшується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditlar bo‘limida xarajat qayd etiladi va qarz kamayadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「貸款」記錄支出，並減少債務。"
          }
        }
      }
    },
    "form.pay.notExpense": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Памяншаецца толькі доўг: выдаткам была пакупка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Schuld sinkt: Der Kauf war die Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the debt goes down: the purchase was the expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo baja la deuda: el gasto fue la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la dette baisse : c'est l'achat qui était la dépense."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminuisce solo il debito: l'acquisto era la spesa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек берешек азаяды: шығыс — сатып алу болған."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maleje tylko dług: wydatek zapisano przy zakupie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a dívida diminui: a compra já foi registrada como despesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только уменьшит долг: расходом была сама покупка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca borç azalır: Gider, satın alma sırasında kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише борг зменшується: витратою була покупка."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat qarz kamayadi: xarid xarajat sifatida qayd etilgan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅減少債務：購買時已記錄支出。"
          }
        }
      }
    },
    "form.pay.over": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта на %2$@ больш за рэшту (%1$@). Пры закрыцці доўгу розніца спішацца; калі пакінуць яго адкрытым, будзе паказана −%2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %2$@ mehr, als übrig ist (%1$@). Beendet, schreibt die Schuld es ab; offen gelassen, zeigt sie −%2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is %2$@ more than is left (%1$@). Closed, the debt writes it off; left open, it shows −%2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es %2$@ más de lo que queda (%1$@). Cerrada, la deuda da de baja ese exceso; abierta, muestra −%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est %2$@ de plus que ce qui reste (%1$@). Clôturée, la dette passe ce surplus en pertes ; laissée ouverte, elle affiche −%2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %2$@ in più del residuo (%1$@). Se chiudi il debito, la differenza viene annullata; se lo lasci aperto, mostra −%2$@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қалғаннан (%1$@) %2$@ артық. Жабылса, берешек оны есептен шығарады; ашық қалса, −%2$@ көрсетіледі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To o %2$@ więcej niż pozostało (%1$@). Po zamknięciu długu nadwyżka zostanie odpisana; jeśli pozostanie otwarty, pokaże −%2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é %2$@ a mais que o saldo restante (%1$@). Ao quitar, a diferença é baixada; se a dívida continuar aberta, ela mostrará −%2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это на %2$@ больше остатка (%1$@). Закрытый долг спишет лишнее, открытый покажет остаток −%2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kalan tutardan (%1$@) %2$@ fazla. Borç kapatılırsa fazla tutar silinir; açık bırakılırsa −%2$@ görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це на %2$@ більше, ніж лишилося (%1$@). Закритий борг списує це; відкритий показує −%2$@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qolgan summadan (%1$@) %2$@ ko‘p. Qarz yopilsa, ortiqcha summa hisobdan chiqariladi; ochiq qolsa, −%2$@ ko‘rsatiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超出剩餘金額（%1$@）%2$@。結清債務時會沖銷超額部分；保留債務時則顯示 −%2$@。"
          }
        }
      }
    },
    "form.pay.overSurplus": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта на %2$@ больш за рэшту (%1$@). Доўг закрыецца на суму рэшты, а %2$@ пойдзе ў даход у катэгорыі «Даплаты»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind %2$@ mehr, als übrig ist (%1$@). Die Schuld endet mit dem Rest, und %2$@ wird als Einnahme bei den Aufschlägen verbucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is %2$@ more than is left (%1$@). The debt closes with what is left, and %2$@ goes to income in Surcharges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es %2$@ más de lo que queda (%1$@). La deuda se cierra con lo que queda, y %2$@ va a ingresos en Recargos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est %2$@ de plus que ce qui reste (%1$@). La dette se clôt avec ce qui reste, et %2$@ va en revenu dans Surplus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %2$@ in più del residuo (%1$@). Il debito si chiude con il residuo e %2$@ vanno nelle entrate in Maggiorazioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қалғаннан (%1$@) %2$@ артық. Берешек қалғанмен жабылады, ал %2$@ «Үстемақылардағы» табысқа кетеді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To o %2$@ więcej niż pozostało (%1$@). Dług zostanie zamknięty pozostałą kwotą, a %2$@ trafi do przychodów w kategorii Dopłaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é %2$@ a mais que o saldo restante (%1$@). A dívida é quitada pelo saldo restante, e %2$@ é registrado como receita em Acréscimos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это на %2$@ больше остатка (%1$@). Долг закроется остатком, а %2$@ станут доходом в «Доплатах»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kalan tutardan (%1$@) %2$@ fazla. Borç kalan tutarla kapanır ve %2$@, Ek Ödemeler'e gelir olarak kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це на %2$@ більше, ніж лишилося (%1$@). Борг закривається з тим, що лишилося, а %2$@ іде в доходи в «Надбавках»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qolgan summadan (%1$@) %2$@ ko‘p. Qarz qolgan summa bilan yopiladi, %2$@ esa Qo‘shimcha to‘lovlarda daromadga o‘tadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超出剩餘金額（%1$@）%2$@。剩餘金額用於結清債務，%2$@ 記為「附加費」收入。"
          }
        }
      }
    },
    "form.pay.returned": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чалавек вярнуў грошы: гэта не даход, доўг памяншаецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Menschen zurückgegebenes Geld: keine Einnahme, die Schuld sinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money returned by the person: not income, the debt goes down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinero devuelto por la persona: no es ingreso, la deuda baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argent rendu par la personne : ce n'est pas un revenu, la dette baisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Denaro restituito dalla persona: non è un'entrata, il debito diminuisce."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адам қайтарған ақша: табыс емес, берешек азаяды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot pieniędzy od tej osoby nie jest przychodem: dług maleje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinheiro devolvido pela pessoa: não é receita, a dívida diminui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги вернул человек: это не доход, долг уменьшится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişinin geri ödediği para: Gelir sayılmaz, borç azalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші повернула людина: це не дохід, а борг зменшується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odam qaytargan pul: daromad emas, qarz kamayadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方歸還的款項不記為收入，只減少債務。"
          }
        }
      }
    },
