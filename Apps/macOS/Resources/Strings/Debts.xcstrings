    "debts.card.missed": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж па выпісцы да %@ прапушчаны: цяпер уся запазычанасць па картцы лічыцца доўгам"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abrechnung vom %@ wurde versäumt: Die ganze Schuld der Karte ist jetzt eine Schuld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The statement due %@ was missed: the whole debt of the card is a debt now"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento dell’estratto conto con scadenza %@ non è stato effettuato: ora l’intero importo della carta è un debito"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күнгі үзінді төленбей қалды: картаның бүкіл берешегі енді қарыз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок выписки %@ пропущен: вся задолженность по карте теперь долг"
          }
        }
      }
    },
    "debts.card.missedNoDay": {
