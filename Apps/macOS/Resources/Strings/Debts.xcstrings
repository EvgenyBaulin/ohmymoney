    "debts.card.counted": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя грошы ўжо ўлічаны ў балансе рахунку. Доўг паказаны для даведкі і не ўваходзіць у вынікі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Geld steckt bereits im Saldo des Kontos. Die Schuld hier ist nur eine Ansicht: Sie geht in keine Summe ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This money is already in the balance of the account. The debt here is only a view: it is in no total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dinero ya está en el saldo de la cuenta. La deuda aquí es solo una vista: no entra en ningún total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet argent est déjà dans le solde du compte. La dette ici n'est qu'un aperçu : elle n'entre dans aucun total."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo importo è già incluso nel saldo del conto. Il debito mostrato qui non è incluso in alcun totale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ақша есеп-шоттың теңгерімінде бар. Мұндағы берешек — тек көрініс: ол ешбір жиынға кірмейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pieniądze są już uwzględnione w saldzie konta. Dług jest tu tylko podglądem i nie jest uwzględniany w sumach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dinheiro já está no saldo da conta. A dívida é exibida aqui apenas para consulta e não entra em nenhum total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти деньги уже в остатке счёта. Долг здесь только показ: в итоги он не входит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tutar zaten hesap bakiyesine dahildir. Buradaki borç yalnızca gösterim amaçlıdır ve hiçbir toplama dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці гроші вже є в залишку рахунку. Борг тут — лише подання: він не входить до жодного підсумку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pul hisob qoldig‘iga kiritilgan. Bu yerdagi qarz faqat ko‘rsatish uchun: u jami summalarga kirmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆金額已計入帳戶餘額。此處僅顯示債務，不計入任何總額。"
          }
        }
      }
    },
