    "nudge.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змяніце тэкст, як сказалі б вы: наступны напамін пачнецца з вашых слоў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern Sie den Text so, wie Sie es sagen würden: Die nächste Erinnerung beginnt mit Ihren Worten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit the text as you would say it: the next reminder starts from your words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite el texto como lo diría usted: el siguiente recordatorio parte de sus palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez le texte comme vous le diriez : la prochaine relance part de vos mots."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica il testo come preferisci: il prossimo promemoria partirà dalle tue parole."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мәтінді өзіңіз айтатындай түзетіңіз: келесі еске салу сіздің сөзіңізден басталады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień tekst na własne słowa: kolejne przypomnienie zacznie się od nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite o texto com suas palavras: o próximo lembrete usará este texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поправьте текст, как сказали бы сами: следующее напоминание начнётся с ваших слов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni kendi sözlerinizle düzenleyin: Sonraki hatırlatma bu metinle başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть текст так, як сказали б самі: наступне нагадування почнеться з ваших слів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Matnni o‘z so‘zlaringiz bilan tahrirlang: keyingi eslatma shu matndan boshlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用自己的語氣編輯文字，下次提醒會沿用你的文字。"
          }
        }
      }
    },
    "nudge.template": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прывітанне, {name}! Ці можаш вярнуць {amount}[ за {for}][ да {date}], калі будзе магчымасць?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo {name}! Kannst du {amount}[ für {for}][ bis {date}] zurückgeben, wenn es passt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi {name}! Could you give back {amount}[ for {for}][ by {date}] when you can?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola, {name}! ¿Podrías devolver {amount}[ por {for}][ antes del {date}] cuando puedas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour {name} ! Pourriez-vous rendre {amount}[ pour {for}][ avant le {date}] quand vous le pourrez ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao {name}! Potresti restituirmi {amount}[ per {for}][ entro {date}] quando puoi?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сәлем, {name}! Ыңғайлы кезде {amount}[ {for} үшін][ {date} дейін] қайтара аласыз ба?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć {name}! Czy możesz oddać {amount}[ za {for}][ do {date}], gdy będziesz mieć możliwość?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oi, {name}! Você pode me devolver {amount}[ de {for}][ até {date}] quando puder?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{имя}, привет! Вернёшь {сумма}[ за {за что}][ до {дата}], когда сможешь?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba {name}! Müsait olduğunda[ {for} için] {amount} tutarını[ {date} tarihine kadar] geri verebilir misin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Привіт, {name}! Коли буде змога, поверни, будь ласка, {amount}[ за {for}][ до {date}]?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Salom, {name}! Imkoning bo‘lganda {amount}ni[ {for} uchun][ {date}gacha] qaytarib bera olasanmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嗨，{name}！方便的話，可以把{amount}[的{for}][在{date}前]還給我嗎？"
          }
        }
      }
    },
