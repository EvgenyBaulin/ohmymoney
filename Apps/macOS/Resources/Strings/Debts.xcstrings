    "form.name.isAnAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» is an account already. A credit card is kept as an account with a minus balance, not as a debt — or its debt is taken off twice. A debt is for a loan or an instalment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya es una cuenta. Una tarjeta de crédito se guarda como cuenta con saldo negativo, no como deuda — o su deuda se restaría dos veces. La deuda es para un préstamo o un plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà un compte. Une carte de crédit se garde comme compte au solde négatif, pas comme une dette — sinon sa dette est retirée deux fois. Une dette sert pour un crédit ou un échéancier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — это уже счёт. Кредитную карту ведут счётом с отрицательным остатком, а не долгом: иначе её долг вычтется дважды. Долг заводят для кредита или рассрочки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» вже є рахунком. Кредитна картка зберігається як рахунок з мінусовим залишком, а не як борг — інакше її борг буде віднято двічі. Борг — для кредиту або розстрочки."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è già un conto. Una carta di credito si registra come conto con saldo negativo, non come debito, altrimenti il debito viene conteggiato due volte. Un debito serve per prestiti e rate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» бұрыннан есеп-шот. Кредиттік карта теріс теңгерімі бар есеп-шот ретінде сақталады, берешек ретінде емес — әйтпесе оның берешегі екі рет алынады. Берешек — несие немесе бөліп төлеу үшін."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ужо з'яўляецца рахункам. Крэдытная картка захоўваецца як рахунак з адмоўным балансам, а не як доўг — інакш доўг будзе адлічаны двойчы. Доўг прызначаны для пазыкі або растэрміноўкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits ein Konto. Eine Kreditkarte wird als Konto mit Saldo im Minus geführt, nicht als Schuld — sonst wird ihre Schuld zweimal abgezogen. Eine Schuld ist für einen Kredit oder eine Ratenzahlung."
          }
        }
      }
    },
