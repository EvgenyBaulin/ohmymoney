    "debts.toggleMessage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, əvvəlki ödənişlər də daxil olmaqla, bu borcun bütün ödənişlərinin necə hesablandığını dəyişir: Kreditlər bölməsində xərc kimi və ya yalnız borcun azalması kimi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменіцца ўлік усіх плацяжоў па гэтым доўгу, у тым ліку мінулых: як выдаткаў у раздзеле «Пазыкі» або толькі як памяншэння доўгу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se změní způsob započítání všech splátek tohoto dluhu včetně minulých: jako výdajů v Půjčkách, nebo jen jako snížení dluhu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ändert, wie jede Zahlung dieser Schuld zählt, auch die vergangenen: als Ausgabe in „Kredite“ oder nur als kleinere Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes how every payment of this debt counts, the past ones included: as an expense in Loans, or only as a smaller debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cambia cómo cuenta cada pago de esta deuda, también los pasados: como gasto en Préstamos, o solo como una deuda menor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela change la façon dont chaque paiement de cette dette compte, y compris les anciens : comme dépense dans Crédits, ou seulement comme une dette réduite."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա փոխում է այս պարտքի բոլոր վճարումների հաշվառումը, ներառյալ նախորդները՝ որպես ծախս «Վարկեր»-ում կամ միայն որպես պարտքի նվազում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia il modo in cui vengono conteggiati tutti i pagamenti di questo debito, inclusi quelli passati: come spesa in Prestiti o solo come riduzione del debito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この債務のすべての返済について、過去の返済も含め、「ローン」の支出として計上するか、債務残高の減少としてのみ記録するかを変更します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიცვლება ამ ვალის ყველა გადახდის აღრიცხვა, წინა გადახდების ჩათვლით: როგორც ხარჯი სესხებში ან მხოლოდ ვალის შემცირება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл берешектің әр төлемі қалай есептелетінін өзгертеді, өткендері де кіреді: «Несиедегі» шығыс ретінде не тек азайған берешек ретінде."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채무의 모든 상환금이 대출 항목의 지출로 처리될지, 채무만 줄이는 것으로 처리될지 변경합니다. 이전 상환금에도 적용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул карыздын бардык төлөмдөрү, мурункулары да, кандай эсептелерин өзгөртөт: «Насыялар» бөлүмүндө чыгаша катары же карызды азайтуу катары гана."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wijzigt hoe elke betaling van deze schuld meetelt, ook eerdere betalingen: als uitgave onder Leningen of alleen als verlaging van de schuld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieni to sposób rozliczania wszystkich spłat tego długu, także wcześniejszych: jako wydatków w kategorii Pożyczki lub tylko jako zmniejszenia długu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso altera como todos os pagamentos desta dívida são contabilizados, inclusive os anteriores: como despesa em Empréstimos ou apenas como redução da dívida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto altera a forma como todos os pagamentos desta dívida são contabilizados, incluindo os anteriores: como despesa em Empréstimos ou apenas como redução da dívida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это меняет учёт всех платежей по этому долгу, в том числе прошлых: расход в «Кредитах» или только уменьшение долга."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарзи ҳисоб кардани ҳамаи пардохтҳои ин қарз, аз ҷумла пардохтҳои гузашта, тағйир меёбад: ҳамчун хароҷот дар «Қарзҳо» ё танҳо ҳамчун кам шудани қарз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, geçmiş ödemeler dahil bu borcun tüm ödemelerinin nasıl sayılacağını değiştirir: Krediler'de gider olarak veya yalnızca borcun azalması olarak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це змінює те, як зараховується кожен платіж за цим боргом, включно з минулими: як витрата в «Кредитах» або лише як менший борг."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qarzning barcha to‘lovlari, jumladan avvalgilari ham qanday hisoblanishini o‘zgartiradi: ular «Qarzlar»da xarajat sifatida yoki faqat qarzni kamaytiruvchi to‘lov sifatida hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会更改此债务所有还款的计入方式，包括过去的还款：计为贷款支出，或仅减少债务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會更改此債務所有付款的計算方式，包括過去的付款：計為貸款支出，或僅減少債務。"
          }
        }
      }
    },
    "debts.toggleTitle": {
