    "split.accountingHint": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışın tam məbləği alış tarixində xərc kimi qeydə alınır. Ödənişlər borcu azaldır; komissiya hissə-hissə «Komissiyalar» bölməsində xərc kimi qeydə alınır. Tarixləri və məbləğləri xidmətin cədvəlinə uyğunlaşdırın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Поўны кошт пакупкі ўлічваецца як расход у дзень пакупкі. Плацяжы пагашаюць доўг, а камісія ўлічваецца часткамі ў катэгорыі «Камісіі». Змяніце даты або сумы паводле графіка сэрвісу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celá cena nákupu se započítá do výdajů v den nákupu. Splátky snižují dluh; poplatek se postupně započítává do výdajů v kategorii Poplatky. Data a částky upravte podle splátkového kalendáře služby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der volle Kaufpreis wird am Kaufdatum als Ausgabe erfasst. Zahlungen tilgen die Schuld; Gebühren werden anteilig als Ausgabe erfasst. Passe Datum und Betrag an den Zahlungsplan des Dienstes an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full purchase price is spent on the purchase date. Payments repay the debt; commission is spent in Fees in parts. Adjust any date or amount to match the service schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe total se registra como gasto en la fecha de compra. Los pagos saldan la deuda; la comisión se registra por partes en Comisiones. Ajusta las fechas o los importes al calendario del servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix total est dépensé à la date d’achat. Les paiements remboursent la dette ; la commission est répartie dans les frais. Modifiez les dates ou les montants selon l’échéancier du service."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գնման ամբողջ գինը ծախս է համարվում գնման օրը։ Վճարումները մարում են պարտքը, իսկ միջնորդավճարը մաս-մաս գրանցվում է «Միջնորդավճարներ» բաժնում։ Փոխեք ամսաթվերը կամ գումարները՝ ծառայության ժամանակացույցին համապատասխան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intero importo viene speso alla data di acquisto. I pagamenti rimborsano il debito; le commissioni vengono registrate a rate in Commissioni. Modifica date e importi in base al piano del servizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入日に購入額の全額を支出として記録します。各回の支払いは元金の返済とし、手数料は分割して「手数料」に記録します。サービスの予定に合わせて日付や金額を変更できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეძენის სრული ფასი შეძენის დღეს იხარჯება. გადახდები ფარავს ვალს; საკომისიო ნაწილ-ნაწილ აისახება «საკომისიოებში». შეცვალეთ თარიღები და თანხები სერვისის გრაფიკის შესაბამისად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алудың толық құны сатып алынған күні шығысқа жазылады. Төлемдер қарызды өтейді; комиссия «Комиссиялар» санатына бөліп жазылады. Күндер мен сомаларды қызмет кестесіне сай өзгертіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매일에 구매 금액 전액이 지출됩니다. 납부금은 원금을 상환하며 수수료는 나누어 수수료 항목에 지출됩니다. 서비스 일정에 맞게 날짜와 금액을 조정하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алуунун толук баасы сатып алынган күнү чыгымдалат. Төлөмдөр карызды жабат; комиссия «Комиссиялар» бөлүмүндө бөлүп чыгымдалат. Күндөрдү жана суммаларды кызматтын графигине жараша өзгөртүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volledige aankoopprijs wordt geboekt op de aankoopdatum. Betalingen lossen de schuld af; commissie wordt in delen geboekt onder Kosten. Pas datums en bedragen aan het schema van de dienst aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała cena zakupu jest wydatkiem w dniu zakupu. Raty spłacają dług, a prowizja jest rozliczana w częściach w kategorii Opłaty. Dostosuj daty i kwoty do harmonogramu usługi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor total da compra é registrado na data da compra. Os pagamentos quitam a dívida; a comissão é registrada em Tarifas, em partes. Ajuste as datas e os valores conforme o cronograma do serviço."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço total da compra é registado na data da compra. Os pagamentos amortizam a dívida; a comissão é registada em Preçário por partes. Ajuste as datas ou os valores ao plano do serviço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка — расход целиком в день покупки. Платежи погашают долг, комиссия учитывается частями в «Комиссиях». Измените любую дату или сумму по графику сервиса."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нархи пурраи харид дар рӯзи харид харҷ мешавад. Пардохтҳо қарзро мепӯшонанд; комиссия қисм-қисм дар «Комиссияҳо» харҷ мешавад. Сана ё маблағро мувофиқи ҷадвали хизматрасонӣ тағйир диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma tutarının tamamı satın alma tarihinde harcanır. Ödemeler borcu kapatır; komisyon, Ücretler altında parça parça harcanır. Tarihleri ve tutarları hizmetin takvimine göre düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повна вартість покупки враховується в дату покупки. Платежі погашають борг, а комісія частинами враховується в категорії «Комісії». Змініть дати або суми відповідно до графіка сервісу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xaridning to‘liq narxi xarid kunida xarajatga yoziladi. To‘lovlar qarzni so‘ndiradi; komissiya «Komissiyalar»da qismlarga bo‘lib xarajatga yoziladi. Xizmat jadvaliga moslash uchun sana yoki summani o‘zgartiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买全款计入购买当日的支出。分期还款用于偿还欠款，手续费分期计入手续费支出。可调整日期和金额，以符合服务商的还款计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買當日計入全額支出。每筆付款償還債務，手續費則分次計入「費用」。可調整日期或金額以符合服務的付款計畫。"
          }
        }
      }
    },
