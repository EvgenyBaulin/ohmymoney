    "ladder.card.snowball": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Снежны ком: спачатку найменшы доўг — першы доўг знікне раней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneeball: zuerst die kleinste Schuld — die erste ist früher weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snowball: the smallest debt first — the first one goes sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bola de nieve: primero la deuda más pequeña — la primera se cierra antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boule de neige : la plus petite dette d'abord — la première se termine plus vite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Palla di neve: prima il debito più piccolo, per estinguerlo prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Снежбол: ең кіші берешек бірінші — біріншісі тезірек жабылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śnieżna kula: najpierw najmniejszy dług — szybciej znika pierwszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bola de neve: a menor dívida primeiro — a primeira é quitada mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снежный ком: сначала самый маленький долг — первый уйдёт быстрее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartopu: Önce en küçük borç; ilk borç daha erken kapanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Снігова куля: спершу найменший борг — перший закривається швидше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qor to‘pi: avval eng kichik qarz — birinchi qarz tezroq yopiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雪球法：先還金額最小的債務，更快還清第一筆。"
          }
        }
      }
    },
