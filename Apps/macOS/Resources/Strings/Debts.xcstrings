    "prepay.forward": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is a payment ahead"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un pago por adelantado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это платёж вперёд"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
