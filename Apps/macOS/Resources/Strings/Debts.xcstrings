    "pledge.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Girov xərc deyil: bu, sizə qaytarılmalı olan puldur. Tarixdən bir həftə əvvəl xatırladılacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Заклад — не выдатак: гэта грошы, якія вам павінны вярнуць. Напамін прыйдзе за тыдзень да даты вяртання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záloha není výdaj: jsou to peníze, které vám mají být vráceny. Připomeneme ji týden před termínem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sicherheitsleistung ist keine Ausgabe: Es ist Geld, das Ihnen zurückgegeben wird. Eine Woche vor dem Tag wird daran erinnert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pledge is not spending: it is money owed back to you. A week before the day it is reminded of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una garantía no es gasto: es dinero que le deben devolver. Una semana antes del día se le recuerda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une caution n'est pas une dépense : c'est de l'argent qu'on vous doit. Un rappel part une semaine avant la date."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրավը ծախս չէ․ դա գումար է, որը պետք է վերադարձնեն ձեզ։ Հիշեցումը՝ վերադարձի օրվանից մեկ շաբաթ առաջ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un deposito cauzionale non è una spesa: è denaro che ti deve essere restituito. Riceverai un promemoria una settimana prima della scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "預け金は支出ではなく、返金されるお金です。返金予定日の1週間前に通知します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გირაო ხარჯი არ არის: ეს თანხა უნდა დაგიბრუნდეთ. დაბრუნების დღემდე ერთი კვირით ადრე შეგახსენებთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кепілдік — шығыс емес: ол сізге қайтарылуы тиіс ақша. Күнге дейін бір апта бұрын еске салады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증금은 지출이 아닌 돌려받을 돈입니다. 반환일 일주일 전에 알려줍니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күрөө чыгаша эмес: бул сизге кайтарылчу акча. Мөөнөтүнө бир жума калганда эскертилет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een borg is geen uitgave: je krijgt dit geld terug. Je ontvangt een week van tevoren een herinnering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaucja nie jest wydatkiem — to pieniądze, które mają do Ciebie wrócić. Przypomnimy o niej tydzień przed terminem zwrotu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma caução não é uma despesa: é um valor que deve ser devolvido a você. Um lembrete será enviado uma semana antes da data."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma caução não é uma despesa: é dinheiro a devolver-lhe. Receberá um lembrete uma semana antes da data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Залог — не трата, а деньги, которые вам вернут. За неделю до срока будет напоминание."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гарав хароҷот нест: ин пулест, ки бояд ба шумо баргардонанд. Як ҳафта пеш аз муҳлат ёдрас мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depozito harcama değildir; size geri ödenecek paradır. İade tarihinden bir hafta önce hatırlatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застава — не витрата: це гроші, які вам мають повернути. За тиждень до дня нагадаємо."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Garov xarajat emas: bu sizga qaytarilishi kerak bo‘lgan pul. Belgilangan kundan bir hafta oldin eslatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "押金不计为支出：这笔钱应退还给你。到期前一周会提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "押金不是支出，而是應退還給你的款項。到期前一週會提醒你。"
          }
        }
      }
    },
