    "debts.delete.owedLater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If «%@» pays this back later, it will be recorded as income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si «%@» devuelve esto más tarde, se registrará como ingreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si « %@ » rembourse plus tard, ce sera noté comme revenu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если «%@» потом вернёт эти деньги, они запишутся доходом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо «%@» поверне це пізніше, це буде записано як дохід."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se «%@» restituirà l’importo in seguito, verrà registrato come entrata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Егер «%@» бұны кейін қайтарса, ол табыс ретінде жазылады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі «%@» верне грошы пазней, гэта будзе ўлічана як даход."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlt „%@“ dies später zurück, wird es als Einnahme erfasst."
          }
        }
      }
    },
    "debts.delete.purchase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
