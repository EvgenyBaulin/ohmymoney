    "debts.payoff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paying %@ a month more would close it %@ earlier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar %@ al mes más la cerraría %@ antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer %@ de plus par mois la fermerait %@ plus tôt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если платить на %@ в месяц больше, закроется на %@ раньше"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо платити на %@ на місяць більше, його закриють на %@ раніше"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagando %@ in più al mese, si estingue %@ prima"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айына тағы %@ төлесеңіз, ол %@ ертерек жабылады"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі плаціць на %@ больш за месяц, доўг будзе пагашаны на %@ раней"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie %@ im Monat mehr zahlen, wäre sie %@ früher beendet"
          }
        }
      }
    },
    "debts.payoffNever": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this payment the debt never closes: it does not cover the interest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con este pago la deuda nunca se cierra: no cubre los intereses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ce paiement, la dette ne se clôt jamais : il ne couvre pas les intérêts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При таком платеже долг не закроется: он не покрывает проценты"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цього платежу борг ніколи не закриється: він не покриває відсотків"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questa rata il debito non si estingue: non copre gli interessi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл төлем кезінде берешек ешқашан жабылмайды: ол пайызды жаппайды"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры такім плацяжы доўг ніколі не будзе пагашаны: ён не пакрывае працэнты"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei dieser Zahlung endet die Schuld nie: Sie deckt die Zinsen nicht"
          }
        }
      }
    },
