      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld operation of it stays in Transactions and in the balances; it becomes neither income nor spending."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld operations of it stay in Transactions and in the balances; they become neither income nor spending."
                }
