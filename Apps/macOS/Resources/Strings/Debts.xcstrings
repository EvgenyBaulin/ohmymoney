          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul bugun berildi yoki olindi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "款項已於今天轉移"
          }
        }
      }
