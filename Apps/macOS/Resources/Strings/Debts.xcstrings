    "wizard.markup.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün hissələr üzrə qiymətdən əlavə ödənilən məbləğ; hissə-hissə xərc kimi qeydə alınır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Агульная сума звыш цаны: яна ўлічваецца як расход часткамі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celková částka nad cenu nákupu, rozdělená do splátek. Do výdajů se započítává postupně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der Plan über dem Preis kostet, alle Raten zusammen: Er wird Rate für Rate ausgegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the plan costs above the price, all parts together: it is spent part by part."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cuesta el plan por encima del precio, todas las partes juntas: se gasta parte a parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que coûte le plan au-dessus du prix, toutes tranches confondues : il se dépense tranche par tranche."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գնից բարձր ընդհանուր գումարը՝ բոլոր մասերով միասին․ ծախսը գրանցվում է մաս-մաս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il costo totale del piano oltre al prezzo, distribuito tra tutte le rate: viene registrato come spesa rata per rata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入額に上乗せされる金額の合計です。支払いごとに支出として記録されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფასზე დამატებული მთლიანი თანხა: ის ნაწილ-ნაწილ აისახება ხარჯად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоспар бағадан қанша артық тұратыны, барлық бөлік бірге: ол бөлік-бөлік жұмсалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 금액에 더해지는 전체 비용입니다. 납부할 때마다 나누어 지출됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Баадан ашык төлөнүүчү жалпы сумма: бөлүк-бөлүгү менен чыгымдалат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De totale meerprijs van alle termijnen samen. Deze wordt per deel geboekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączny koszt ponad cenę zakupu, rozliczany w częściach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor total do plano acima do preço, somando todas as parcelas. É registrado como despesa aos poucos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O custo total do plano acima do preço, registado como despesa por partes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько рассрочка стоит сверх цены, за все части: тратится частями, с каждым платежом."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи умумии иловагӣ ба нархи харид: он қисм-қисм харҷ мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm taksitlerin toplamında fiyatın üzerindeki tutar; parça parça harcanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки план коштує понад ціну, усі частини разом: сплачується по частинах."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Narxga qo‘shiladigan jami ustama: qismlarga bo‘lib xarajatga yoziladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
