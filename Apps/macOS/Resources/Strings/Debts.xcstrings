      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is an account with a minus, not a debt: its limit, statement and grace period are the terms of the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito es una cuenta con signo menos, no una deuda: su límite, extracto y periodo de gracia son las condiciones de la cuenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитка — это счёт с минусом, а не долг: лимит, выписка и льготный период — условия счёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитна картка — це рахунок з мінусом, а не борг: її ліміт, виписка й пільговий період — це умови рахунку."
          }
        }
      }
    },
