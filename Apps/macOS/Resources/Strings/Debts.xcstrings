    "debts.delete.cash": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnalda qeydə alınmış pul hərəkətləri hesabların balansında qalacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы, перададзеныя праз журнал, застануцца ў балансах рахункаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze převedené prostřednictvím deníku zůstanou v zůstatcích účtů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld, das über das Journal den Besitzer wechselte, bleibt in den Kontosalden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money that changed hands through the journal stays in the account balances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero que pasó por el diario se mantiene en los saldos de las cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent qui a transité par le journal reste dans les soldes des comptes."
