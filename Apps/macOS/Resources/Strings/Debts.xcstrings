    "costs.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cost paid once is an expense on its day; one included in the loan grows the debt instead. Insurance can usually be given back within 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coste pagado una vez es un gasto en su día; uno incluido en el préstamo aumenta la deuda. El seguro suele poder devolverse en 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coût payé une fois est une dépense à sa date ; un coût inclus dans le crédit fait au contraire grossir la dette. L'assurance peut en général être remboursée dans les 30 jours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовый расход записывается тратой в свой день; включённый в кредит — увеличивает долг. Страховку обычно можно вернуть в течение 30 дней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрата, сплачена разово, — це витрата в її день; включена в кредит, вона натомість збільшує борг. Страховку зазвичай можна повернути протягом 30 днів."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un costo pagato una sola volta è una spesa nel giorno del pagamento; se incluso nel prestito, aumenta il debito. Di solito puoi recedere dall’assicurazione entro 30 giorni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір рет төленетін шығын — күні шығыс болып саналады; несиеге кірген шығын орнына берешекті өсіреді. Сақтандыруды әдетте 30 күн ішінде қайтаруға болады."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разавы плацёж улічваецца як выдатак у дзень аплаты; сума, уключаная ў крэдыт, павялічвае доўг. Страхоўку звычайна можна вярнуць цягам 30 дзён."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosten, die einmal gezahlt werden, sind eine Ausgabe an ihrem Tag; sind sie im Kredit enthalten, erhöhen sie stattdessen die Schuld. Eine Versicherung lässt sich meist innerhalb von 30 Tagen zurückgeben."
          }
        }
      }
    },
