    "prepay.forward": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, qabaqcadan ödənişdir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта плацеж наперад"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatit splátky"
          }
        },
        "de": {
          "stringUnit": {
