    "ladder.snowball.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку найменшая рэшта: першы доўг знікне раней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst der kleinste Saldo: die erste Schuld ist früher weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The smallest balance first: the first debt goes sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero el saldo más pequeño: la primera deuda se cierra antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus petit solde d'abord : la première dette se termine plus vite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima il saldo più piccolo: il primo debito si estingue prima."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең кіші қалдық бірінші: бірінші берешек тезірек жабылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw najmniejsze saldo: szybciej znika pierwszy dług."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menor saldo primeiro: a primeira dívida é quitada mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала самый маленький остаток — первый долг уйдёт быстрее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce en küçük bakiye: İlk borç daha erken kapanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу найменший залишок: перший борг закривається швидше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval eng kichik qoldiq: birinchi qarz tezroq yopiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先還餘額最小的債務，更快還清第一筆。"
          }
        }
      }
    },
