    "form.adjust.negative": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırdan aşağıdır: bu, borcdan %@ artıq ödənildiyi deməkdir. Bunu nəzərdə tutursunuz?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніжэй за нуль: гэта азначае, што аплачана на %@ больш за доўг. Вы гэта мелі на ўвазе?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnota pod nulou znamená, že bylo zaplaceno o %@ více, než činil dluh. Je to tak?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter null: Das heißt, es wurden %@ mehr bezahlt, als geschuldet war. Ist das gemeint?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below zero: that says %@ more was paid than owed. Is that what you mean?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de cero: eso dice que se pagaron %@ más de lo que se debía. ¿Es lo que quiere decir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous zéro : cela signifie que %@ de plus ont été payés que dus. Est-ce bien votre intention ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զրոյից ցածր է․ սա նշանակում է, որ վճարվել է պարտքից %@ ավելի։ Դա՞ նկատի ունեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto zero: indica che sono stati pagati %@ in più del dovuto. È corretto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高がマイナスです。債務額より%@多く返済したことになります。よろしいですか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნულზე ნაკლებია: ეს ნიშნავს, რომ ვალზე %@-ით მეტი გადაიხადეთ. ამას გულისხმობთ?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөлден төмен: бұл берешектен %@ артық төленгенін білдіреді. Солай ма?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0 미만이면 채무보다 %@ 더 상환한 것으로 표시됩니다. 맞습니까?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөлдөн төмөн: карыздан %@ көбүрөөк төлөнгөнүн билдирет. Ушундайбы?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onder nul: dit betekent dat er %@ meer is betaald dan verschuldigd. Bedoel je dat?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej zera: oznacza to, że spłacono o %@ więcej niż wynosił dług. Czy o to chodzi?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo de zero: isso indica que foram pagos %@ a mais que o devido. É isso mesmo?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo de zero: indica que foram pagos mais %@ do que o devido. É isso que pretende?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше нуля: выходит, заплачено на %@ больше долга. Так и задумано?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Камтар аз сифр: ин маънои онро дорад, ки аз маблағи қарз %@ бештар пардохт шудааст. Ҳаминро дар назар доред?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırın altında: Bu, borçtan %@ fazla ödendiği anlamına gelir. Bunu mu demek istediniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче нуля: це означає, що сплачено на %@ більше, ніж винні. Це те, що ви мали на увазі?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Noldan kam: bu qarzdan %@ ko‘proq to‘langanini bildiradi. Shuni nazarda tutdingizmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于零：这表示多还了 %@。确定要这样做吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於零代表已付款超過應付金額 %@。確定要這樣設定嗎？"
          }
        }
      }
    },
