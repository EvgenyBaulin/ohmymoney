    "tranche.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranş bankın təhsil haqqı üçün ödədiyi məbləğdir: həmin gün «Təhsil» bölməsində xərc kimi qeydə alınır və borc bu məbləğ qədər artır. Kredit ödənişlərində yalnız faiz xərc sayılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Транш — грошы, якія банк пералічыў за навучанне: расход у катэгорыі «Адукацыя» ў гэты дзень, на які павялічваецца доўг. Плацяжы па крэдыце тады не лічацца расходамі, акрамя выплачаных працэнтаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranše jsou peníze, které banka zaplatila za školné. V daný den se započítají do výdajů v kategorii «Vzdělání» a dluh o ně vzroste. Splátky půjčky pak nejsou výdajem, s výjimkou úroků."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tranche ist Geld, das die Bank für die Studiengebühren gezahlt hat: eine Ausgabe in „Bildung“ an ihrem Tag, und die Schuld wächst um sie. Zahlungen des Kredits sind dann keine Ausgaben, außer den Zinsen, die sie bezahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tranche is money the bank paid for tuition: an expense in «Education» on its day, and the debt grows by it. Payments of the loan are not expenses then, except the interest they pay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tramo es dinero que el banco pagó por la matrícula: un gasto en «Educación» en su día, y la deuda crece en esa cantidad. Los pagos del préstamo no son gasto entonces, salvo los intereses que cubren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tranche est l'argent versé par la banque pour les études : une dépense dans « Études » à sa date, et la dette grossit d'autant. Les paiements du crédit ne sont alors pas des dépenses, sauf les intérêts qu'ils règlent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տրանշը ուսման համար բանկի վճարած գումարն է․ այդ օրը այն գրանցվում է որպես ծախս «Կրթություն» կատեգորիայում, իսկ պարտքն ավելանում է այդ գումարով։ Վարկի վճարումները ծախս չեն համարվում, բացի մարվող տոկոսներից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tranche è una somma versata dalla banca per gli studi: viene registrata come spesa in «Istruzione» alla sua data e aumenta il debito. I rimborsi del prestito non sono spese, a eccezione degli interessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "融資実行分は、銀行が学費として支払った金額です。支払日に「教育」の支出として記録され、負債も同額増えます。ローンの返済額のうち、利息のみが支出になります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტრანში არის სწავლისთვის ბანკის მიერ გადახდილი თანხა: ის გადახდის დღეს აისახება ხარჯად «განათლებაში» და იმავე ოდენობით ზრდის ვალს. სესხის გადახდები ხარჯად არ ითვლება, მათში შემავალი პროცენტის გარდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транш — банк оқу ақысына төлеген ақша: ол күнінде «Білімдегі» шығыс болады, ал берешек соншаға өседі. Бұл кезде несие төлемдері шығыс болмайды, тек төлейтін пайыз ғана."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대출금은 은행이 학비로 지급한 금액입니다. 지급일에 «교육» 항목에 지출로 기록되고 부채가 늘어납니다. 이후 대출 상환액은 이자를 제외하고 지출로 기록되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Транш — банк окуу үчүн төлөгөн акча: ошол күнү «Билим берүү» бөлүмүнө чыгым катары жазылат жана карыз ушул суммага көбөйөт. Насыя төлөмдөрүнүн пайыздан башка бөлүгү чыгым болуп эсептелбейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tranche is een bedrag dat de bank voor collegegeld heeft betaald: een uitgave in «Onderwijs» op die dag. De schuld neemt met dit bedrag toe. Aflossingen zijn geen uitgaven, behalve de betaalde rente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transza to kwota wypłacona przez bank za naukę: wydatek w kategorii «Edukacja» w dniu wypłaty, o który rośnie dług. Spłaty kredytu nie są wtedy wydatkami, z wyjątkiem odsetek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma parcela é o valor pago pelo banco à instituição de ensino: uma despesa em «Educação» na data do pagamento, que aumenta a dívida. Os pagamentos do empréstimo não são despesas, exceto os juros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tranche é o montante pago pelo banco pelas propinas: é uma despesa em «Educação» nessa data e aumenta a dívida. Os pagamentos do empréstimo não são despesas, exceto os juros pagos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транш — деньги, которые банк заплатил за учёбу: расход в «Образовании» в его день, и долг растёт на эту сумму. Платежи по кредиту тогда не расход, кроме процентов в них."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транш маблағест, ки бонк барои таҳсил пардохтааст: дар ҳамон рӯз дар «Таҳсил» харҷ мешавад ва қарз ба ин маблағ меафзояд. Пардохтҳои қарз харҷ нестанд, ба истиснои фоизи онҳо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilim, bankanın öğrenim ücreti için ödediği paradır: O gün «Eğitim» altında gider olarak kaydedilir ve borç bu tutarda artar. Kredi ödemelerinde yalnızca ödenen faiz gider sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транш — це гроші, які банк перерахував за навчання: витрата в «Освіті» в його день, а борг зростає на цю суму. Платежі за кредитом тоді не є витратами, окрім відсотків, які вони покривають."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Transh — bank o‘qish uchun to‘lagan pul: shu kuni «Ta’lim» turkumida xarajat yoziladi va qarz shu summaga oshadi. Kredit to‘lovlarining faqat foiz qismi xarajat hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每笔放款是银行支付的学费：当天计入«教育»支出，欠款相应增加。此后的贷款还款不计为支出，其中支付的利息除外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撥款是銀行支付的學費：當日計入«教育»支出，債務也會增加相同金額。之後的貸款還款不計為支出，利息除外。"
          }
        }
      }
    },
    "tranche.planned.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarix hələ gəlməyib: planlaşdırılmış tranş cədvəldə nəzərə alınır və borc həmin gün artır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты дзень яшчэ наперадзе: запланаваны транш улічваецца ў графіку, а доўг павялічыцца ў гэты дзень."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento den ještě nenastal: plánovaná tranše se započítá do kalendáře a dluh v daný den vzroste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tag liegt noch vor Ihnen: eine geplante Tranche — der Zeitplan rechnet sie ein, und die Schuld wächst an diesem Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day is still ahead: a planned tranche — the schedule counts it, and the debt grows on that day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día todavía no ha llegado: es un tramo previsto — el calendario lo cuenta, y la deuda crece ese día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date n'est pas encore passée : une tranche prévue — l'échéancier la compte, et la dette grossit ce jour-là."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օրը դեռ չի հասել․ պլանավորված տրանշը ներառված է ժամանակացույցում, իսկ պարտքն ավելանում է այդ օրը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data è futura: il piano include la tranche prevista e il debito aumenterà quel giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "融資実行予定日が来ると、負債が増えます。この予定は返済予定に反映されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თარიღი ჯერ არ დამდგარა: დაგეგმილი ტრანში გრაფიკში გათვალისწინებულია, ვალი კი იმ დღეს გაიზრდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күн әлі алда: бұл жоспарланған транш — кесте оны санайды, ал берешек сол күні өседі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 지급일이 지나지 않았습니다. 예정된 대출금은 일정에 반영되며 해당 날짜에 부채가 늘어납니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул күн али келе элек: пландалган транш графикте эсептелет, ал эми карыз ошол күнү көбөйөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze dag ligt nog in de toekomst: het schema houdt rekening met de geplande tranche en de schuld neemt op die dag toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta data jeszcze nie nadeszła: planowana transza jest uwzględniona w harmonogramie, a dług wzrośnie w tym dniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data ainda está por vir: o cronograma considera a parcela planejada, e a dívida aumenta nessa data."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A data ainda não chegou: esta tranche está prevista no plano e aumentará a dívida nesse dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День ещё впереди — это плановый транш: график его учитывает, а долг вырастет в этот день."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин рӯз ҳанӯз нарасидааст: транши банақшагирифташуда дар ҷадвал ба ҳисоб гирифта мешавад ва қарз дар ҳамон рӯз меафзояд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarih henüz gelmedi: Planlanan dilim takvaba dahil edilir ve borç o gün artar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "День ще попереду: запланований транш — розклад його враховує, а борг зросте в цей день."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana hali kelmagan: rejalashtirilgan transh jadvalda hisobga olinadi, qarz esa o‘sha kuni oshadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期尚未到来：计划内放款已计入还款计划，欠款将在当天增加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日期尚未到來：這是預定撥款，還款計畫會計入，債務將於當日增加。"
          }
        }
      }
    },
