    "form.moneyMoved": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul verilib və ya alınıb (indi borc alınıb və ya verilib)"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы перададзены (пазычаны цяпер)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze změnily majitele (nyní vypůjčené nebo půjčené)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld hat den Besitzer gewechselt (jetzt geliehen oder verliehen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money changed hands (borrowed or lent now)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero se entregó (prestado o dado ahora)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent a changé de mains (emprunté ou prêté maintenant)"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը փոխանցվել է (այժմ վերցվել կամ տրվել է պարտքով)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro è stato scambiato (prestato o ricevuto ora)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お金のやり取りがあった（今回借りた、または貸した）"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა გადაეცა (ახლა ისესხეთ ან გაასესხეთ)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша қолдан-қолға өтті (қазір қарызға алынды немесе берілді)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돈을 주고받음(지금 빌리거나 빌려줌)"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча берилди же алынды"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld is overgedragen (nu geleend of uitgeleend)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazano pieniądze (pożyczono teraz)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro mudou de mãos (emprestado ou recebido agora)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Houve transferência de dinheiro (emprestado agora)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги перешли из рук в руки (взял или дал сейчас)"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пул дода ё гирифта шуд (ҳоло қарз гирифта ё дода шуд)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el değiştirdi (şimdi borç alındı veya verildi)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші переходять із рук у руки (позичаю або позичаю зараз)"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul berildi yoki olindi (hozir qarzga olindi yoki berildi)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资金已转移（现在借入或借出）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "款項已轉移（現在借入或借出）"
          }
        }
      }
    },
