    "wizard.card.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крэдытная картка — гэта рахунак з мінусам, а не доўг: яе ліміт, выпіска і льготны перыяд — умовы рахунку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte ist ein Konto mit einem Minus, keine Schuld: Ihr Limit, die Abrechnung und die zinsfreie Frist sind die Bedingungen des Kontos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is an account with a minus, not a debt: its limit, statement and grace period are the terms of the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito es una cuenta con signo menos, no una deuda: su límite, extracto y periodo de gracia son las condiciones de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit est un compte au solde négatif, pas une dette : son plafond, son relevé et sa période de grâce sont les conditions du compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta di credito è un conto che può andare in negativo, non un debito: limite, estratto conto e periodo senza interessi sono condizioni del conto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта — теріс теңгерімі бар есеп-шот, берешек емес: оның лимиті, үзіндісі және кейінге қалдыру кезеңі — есеп-шоттың шарттары."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta kredytowa to konto z saldem ujemnym, a nie dług: limit, wyciąg i okres bezodsetkowy to warunki konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão de crédito é uma conta com saldo negativo. O limite, a fatura e o prazo sem juros são condições da conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитка — это счёт с минусом, а не долг: лимит, выписка и льготный период — условия счёта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi kartı bir borç değil, eksi bakiyeli bir hesaptır: Limiti, ekstresi ve faizsiz dönemi hesap koşullarıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитна картка — це рахунок з мінусом, а не борг: її ліміт, виписка й пільговий період — це умови рахунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit karta — manfiy qoldiqli hisob. Limit, ko‘chirma va imtiyozli davr uning shartlaridir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡是可為負數的帳戶，不是債務；額度、帳單和免息期是帳戶條款。"
          }
        }
      }
    },
