    "split.invalid": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце катэгорыю. Плацяжы павінны пакрываць кошт пакупкі, быць дадатнымі і ісці па парадку дат, пачынаючы з дня пакупкі або пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Kategorie. Die Zahlungen müssen den Kaufpreis decken, positiv sein und in zeitlicher Reihenfolge ab dem Kaufdatum liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a category. Payments must cover the purchase price, be positive and follow date order, starting on or after the purchase date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una categoría. Los pagos deben cubrir el importe de la compra, ser positivos y seguir un orden cronológico, a partir de la fecha de compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une catégorie. Les paiements doivent couvrir le prix d’achat, être positifs et suivre l’ordre des dates, à partir de la date d’achat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una categoria. I pagamenti devono coprire il prezzo d’acquisto, essere positivi e seguire l’ordine delle date, a partire dalla data di acquisto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санатты таңдаңыз. Төлемдер сатып алу құнын жабуы, оң болуы және сатып алу күнінен бастап күн ретімен орналасуы тиіс."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kategorię. Raty muszą pokrywać cenę zakupu, być dodatnie i następować po sobie, począwszy od dnia zakupu lub później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma categoria. Os pagamentos devem cobrir o valor da compra, ser positivos e seguir a ordem das datas, a partir da data da compra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите категорию. Платежи должны покрывать цену покупки, быть больше нуля и идти по порядку дат, начиная со дня покупки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kategori seçin. Ödemeler satın alma tutarını karşılamalı, pozitif olmalı ve satın alma tarihinde veya sonrasında başlayarak tarih sırasını izlemelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть категорію. Платежі мають покривати вартість покупки, бути додатними й розташовуватися за датою, починаючи з дати покупки або пізніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Turkumni tanlang. To‘lovlar xarid narxini qoplashi, musbat bo‘lishi va xarid sanasidan boshlab sana tartibida joylashishi kerak."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇類別。付款總額須涵蓋購買價格，金額須大於零，日期須依序排列，且不早於購買日期。"
          }
        }
      }
    },
