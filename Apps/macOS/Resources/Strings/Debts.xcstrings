        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մատյանում գրանցված փոխանցված գումարները մնում են հաշիվների մնացորդներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli importi trasferiti tramite il registro rimangono nei saldi dei conti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴に記録されたお金のやり取りは口座残高に残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჟურნალში აღრიცხული გადაცემული თანხა ანგარიშების ნაშთებში რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал арқылы қолдан-қолға өткен ақша есеп-шот теңгерімдерінде қалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장부에 기록된 거래 금액은 계좌 잔액에 그대로 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал аркылуу берилген жана алынган акча эсептердин калдыгында калат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld dat via het journaal is overgemaakt, blijft in de rekeningsaldi staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieniądze przekazane za pośrednictwem dziennika pozostaną w saldach kont."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
