    "pledge.writeOff.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is left of the pledge becomes spending in the category chosen, and the pledge closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que queda de la garantía pasa a ser gasto en la categoría elegida, y la garantía se cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste de la caution devient une dépense dans la catégorie choisie, et la caution se clôt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток залога станет тратой в выбранной категории, залог закроется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що лишилося від застави, стає витратою в обраній категорії, а застава закривається."
          }
        },
        "it": {
          "stringUnit": {
