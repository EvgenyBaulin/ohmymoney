    "pledge.writeOff.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэшта закладу стане выдаткам у выбранай катэгорыі, а заклад закрыецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was von der Sicherheitsleistung übrig ist, wird zur Ausgabe in der gewählten Kategorie, und die Sicherheitsleistung wird beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is left of the pledge becomes spending in the category chosen, and the pledge closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que queda de la garantía pasa a ser gasto en la categoría elegida, y la garantía se cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste de la caution devient une dépense dans la catégorie choisie, et la caution se clôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo residuo del deposito diventa una spesa nella categoria scelta e il deposito viene chiuso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кепілдіктен қалғаны таңдалған санатта шығысқа айналады, ал кепілдік жабылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostała kwota kaucji stanie się wydatkiem w wybranej kategorii, a kaucja zostanie zamknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor restante da caução se torna uma despesa na categoria escolhida, e a caução é encerrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток залога станет тратой в выбранной категории, залог закроется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depozitonun kalan tutarı seçilen kategoride harcama olur ve depozito kapatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що лишилося від застави, стає витратою в обраній категорії, а застава закривається."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Garovning qolgan qismi tanlangan toifadagi xarajatga aylanadi va garov yopiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘押金會計入所選類別的支出，並結清押金。"
          }
        }
      }
    },
    "pledge.writeOff.title": {
      "extractionState": "manual",
