    "prepay.anyDay": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank erkən ödənişi istənilən gün qəbul edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк прымае датэрміновае пагашэнне ў любы дзень."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka přijímá mimořádnou splátku kterýkoli den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank nimmt eine vorzeitige Rückzahlung an jedem Tag an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank takes an early repayment on any day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco acepta una amortización anticipada en cualquier día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque accepte un remboursement anticipé à n'importe quel jour."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկն ընդունում է վաղաժամ մարում ցանկացած օր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca accetta rimborsi anticipati in qualsiasi giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行はいつでも繰上返済を受け付けます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკი ვადამდე დაფარვას ნებისმიერ დღეს იღებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк мерзімнен бұрын өтеуді кез келген күні қабылдайды."
          }
        },
        "ko": {
          "stringUnit": {
