    "typed.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sum holds for this due and the ones after it, until a later early repayment works the payment out again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suma vale para este vencimiento y los siguientes, hasta que una amortización anticipada posterior vuelva a calcular el pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La somme vaut pour cette échéance et les suivantes, jusqu'à ce qu'un remboursement anticipé ultérieur recalcule le paiement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма действует с этого платежа и дальше — пока досрочка позже не пересчитает платёж."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця сума діє для цього платежу й наступних, доки пізніше дострокове погашення не перерахує платіж."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importo vale per questa scadenza e per le successive, finché un rimborso anticipato non ricalcola la rata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сома осы мерзім мен одан кейінгілер үшін сақталады, кейінірек мерзімнен бұрын өтеу төлемді қайта есептегенше."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума дзейнічае для гэтага і наступных плацяжоў, пакуль пазнейшае датэрміновае пагашэнне не пералічыць яе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Summe gilt für diese Fälligkeit und die danach, bis eine spätere vorzeitige Rückzahlung die Zahlung neu berechnet."
          }
        }
      }
    },
