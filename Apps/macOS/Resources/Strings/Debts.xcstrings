    "schedule.card.mainLater": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarixindən əsas qrafik; ödəniş həmin günün borcuna görə hesablanır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З %@ — асноўны графік; плацеж разлічваецца па доўгу на гэты дзень"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od %@ — hlavní splátkový kalendář; splátka se vypočítá podle dluhu k tomuto dni"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab %@ — der Hauptplan; seine Zahlung wird aus der Schuld an jenem Tag berechnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %@ — the main schedule; its payment is worked out from the debt on that day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde el %@ — el calendario principal; su pago se calcula según la deuda de ese día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir du %@ — l'échéancier principal ; son paiement se calcule à partir de la dette ce jour-là"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ից՝ հիմնական ժամանակացույց․ վճարումը հաշվարկվում է այդ օրվա պարտքից"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal %@ — piano principale; la rata sarà calcolata in base al debito di quel giorno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から通常返済。当日の借入残高から返済額を計算します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-დან — ძირითადი გრაფიკი; გადასახდელი იმ დღის დავალიანებით გამოითვლება"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ бастап — негізгі кесте; оның төлемі сол күнгі берешектен есептеледі"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@부터 본 상환 일정 시작. 해당 날짜의 채무를 기준으로 납부액이 계산됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тартып — негизги график; төлөм ошол күнкү карыздан эсептелет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf %@ — het hoofdschema; de termijn wordt berekend op basis van de schuld op die dag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od %@ — harmonogram główny; rata zostanie obliczona na podstawie zadłużenia z tego dnia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de %@ — cronograma principal; a parcela será calculada com base na dívida nessa data"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de %@ — plano principal; a prestação é calculada com base na dívida desse dia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С %@ — основной график; платёж посчитается по долгу на тот день"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз %@ — ҷадвали асосӣ; пардохт аз рӯи қарзи он рӯз ҳисоб мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinden itibaren ana ödeme planı; ödeme o günkü borca göre hesaplanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З %@ — основний розклад; його платіж рахується від боргу того дня"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dan — asosiy jadval; to‘lov o‘sha kungi qarzdan hisoblanadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 起执行主要还款计划；还款额将按当日欠款计算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自 %@ 起按主要還款計畫還款；還款額依當日債務計算"
          }
        }
      }
    },
