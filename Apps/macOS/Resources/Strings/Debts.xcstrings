    "debts.card.counted": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pul artıq hesabın balansına daxildir. Buradakı borc yalnız məlumat üçün göstərilir və heç bir yekuna daxil edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя грошы ўжо ўлічаны ў балансе рахунку. Доўг паказаны для даведкі і не ўваходзіць у вынікі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto peníze jsou už zahrnuty v zůstatku účtu. Dluh je zde jen pro přehled a nezapočítává se do součtů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Geld steckt bereits im Saldo des Kontos. Die Schuld hier ist nur eine Ansicht: Sie geht in keine Summe ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This money is already in the balance of the account. The debt here is only a view: it is in no total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dinero ya está en el saldo de la cuenta. La deuda aquí es solo una vista: no entra en ningún total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet argent est déjà dans le solde du compte. La dette ici n'est qu'un aperçu : elle n'entre dans aucun total."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գումարն արդեն ներառված է հաշվի մնացորդում։ Այստեղ պարտքը միայն ցուցադրվում է և ներառված չէ որևէ ընդհանուր գումարում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo importo è già incluso nel saldo del conto. Il debito mostrato qui non è incluso in alcun totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この金額は口座残高に含まれています。ここでの借入は表示用で、合計には含まれません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს თანხა უკვე შედის ანგარიშის ნაშთში. აქ ვალი მხოლოდ სანახავადაა და ჯამებში არ შედის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ақша есеп-шоттың теңгерімінде бар. Мұндағы берешек — тек көрініс: ол ешбір жиынға кірмейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 금액은 이미 계좌 잔액에 포함되어 있습니다. 여기 표시된 빚은 조회용이며 합계에 포함되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул акча эсептин калдыгына мурунтан кирген. Карыз бул жерде маалымат үчүн гана көрсөтүлөт жана жыйынтыктарга кошулбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bedrag staat al in het saldo van de rekening. De schuld wordt hier alleen weergegeven en telt nergens mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pieniądze są już uwzględnione w saldzie konta. Dług jest tu tylko podglądem i nie jest uwzględniany w sumach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dinheiro já está no saldo da conta. A dívida é exibida aqui apenas para consulta e não entra em nenhum total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dinheiro já está incluído no saldo da conta. A dívida apresentada aqui não está incluída em nenhum total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти деньги уже в остатке счёта. Долг здесь только показ: в итоги он не входит."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин маблағ аллакай дар бақияи ҳисоб аст. Қарз дар ин ҷо танҳо барои намоиш аст ва ба ҳеҷ ҷамъе дохил намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tutar zaten hesap bakiyesine dahildir. Buradaki borç yalnızca gösterim amaçlıdır ve hiçbir toplama dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці гроші вже є в залишку рахунку. Борг тут — лише подання: він не входить до жодного підсумку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pul hisob qoldig‘iga kiritilgan. Bu yerdagi qarz faqat ko‘rsatish uchun: u jami summalarga kirmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这笔金额已计入账户余额。此处仅显示债务，不计入任何总额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆金額已計入帳戶餘額。此處僅顯示債務，不計入任何總額。"
          }
        }
      }
    },
