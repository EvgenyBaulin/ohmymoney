    "form.pay.close": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borcu bağla: bu ödəniş borcu tam ödəyir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыць доўг: гэты плацёж пагашае яго"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzavřít dluh: tato platba ho splatí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuld beenden: Diese Zahlung tilgt sie ganz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the debt: this payment pays it off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la deuda: este pago la salda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturer la dette : ce paiement la solde"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փակել պարտքը․ այս վճարումն ամբողջությամբ մարում է այն"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi il debito: questo pagamento lo estingue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負債を完済する：この支払いで完済"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალის დახურვა: ეს გადახდა სრულად ფარავს მას"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешекті жабу: бұл төлем оны толық жабады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부채 정리: 이번 납입으로 완납"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карызды жабуу: бул төлөм аны толук жабат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuld sluiten: deze betaling lost haar af"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij dług: ta wpłata go spłaca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar a dívida com este pagamento"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquidar a dívida: este pagamento salda-a"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть долг: этот платёж его гасит"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бастани қарз: ин пардохт онро мепӯшонад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borcu kapat: Bu ödeme borcu bitiriyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити борг: цей платіж його погашає"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarzni yopish: bu to‘lov uni to‘liq qoplaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结清债务：此笔付款将还清欠款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結清債務：此筆付款將還清債務"
          }
        }
      }
    },
