    "prepay.paymentDayOnly": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank erkən ödənişi yalnız ödəniş günü qəbul edir: məbləğ növbəti ödəniş günü borcu azaldır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк прымае датэрміновае пагашэнне толькі ў дзень плацяжу: грошы паменшаць доўг у наступны такі дзень."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka přijímá mimořádnou splátku pouze v den splátky: peníze sníží dluh v nejbližší den splátky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank nimmt eine vorzeitige Rückzahlung nur an einem Zahlungstag an: Das Geld senkt die Schuld am nächsten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank takes an early repayment only on a payment day: the money lowers the debt on the next one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco acepta una amortización anticipada solo en día de pago: el dinero reduce la deuda en el siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque n'accepte un remboursement anticipé que le jour de paiement : l'argent réduit la dette au paiement suivant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկն ընդունում է վաղաժամ մարում միայն վճարման օրը․ գումարը կնվազեցնի պարտքը հաջորդ վճարման օրը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La banca accetta rimborsi anticipati solo il giorno della rata: il denaro riduce il debito alla prossima scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行は返済日にのみ繰上返済を受け付けます。次の返済日に借入残高が減ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკი ვადამდე დაფარვას მხოლოდ გადახდის დღეს იღებს: თანხა დავალიანებას მომდევნო გადახდის დღეს ამცირებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк мерзімнен бұрын өтеуді тек төлем күні қабылдайды: ақша келесі төлем күні берешекті азайтады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행에서 납부일에만 중도 상환을 받습니다. 다음 납부일에 원금이 줄어듭니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк мөөнөтүнөн мурда төлөмдү төлөм күнү гана кабыл алат: акча карызды кийинки төлөм күнү азайтат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bank verwerkt een extra aflossing alleen op een betaaldag: de schuld wordt op de volgende betaaldag verlaagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank przyjmuje wcześniejszą spłatę tylko w dniu raty — pieniądze zmniejszą zadłużenie w najbliższym terminie raty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco aceita amortização antecipada apenas no dia do pagamento: o valor reduz a dívida na próxima parcela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco só aceita reembolsos antecipados no dia da prestação: o valor reduz a dívida no próximo dia de pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк принимает досрочку только в день платежа: деньги уменьшат долг в ближайший."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонк пардохти пеш аз муҳлатро танҳо дар рӯзи пардохт қабул мекунад: маблағ дар рӯзи пардохти навбатӣ қарзро кам мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka yalnızca taksit gününde erken ödeme kabul eder; para, bir sonraki taksit gününde borcu azaltır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк приймає дострокове погашення лише в день платежу: гроші зменшують борг у наступний."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank muddatidan oldin to‘lovni faqat to‘lov kunida qabul qiladi: pul keyingi to‘lov kunida qarzni kamaytiradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行仅在还款日接受提前还款：款项将在下一个还款日减少欠款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行僅在還款日接受提前還款：這筆錢會在下一個還款日減少債務。"
          }
        }
      }
    },
