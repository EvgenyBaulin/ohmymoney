    "debts.payoff": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі плаціць на %@ больш за месяц, доўг будзе пагашаны на %@ раней"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie %@ im Monat mehr zahlen, wäre sie %@ früher beendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paying %@ a month more would close it %@ earlier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar %@ al mes más la cerraría %@ antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer %@ de plus par mois la fermerait %@ plus tôt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagando %@ in più al mese, si estingue %@ prima"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айына тағы %@ төлесеңіз, ол %@ ертерек жабылады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpłata o %@ więcej miesięcznie pozwoli spłacić dług o %@ wcześniej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar %@ a mais por mês quitaria a dívida %@ antes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если платить на %@ в месяц больше, закроется на %@ раньше"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayda %@ daha fazla ödeyerek borcu %@ daha erken kapatabilirsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо платити на %@ на місяць більше, його закриють на %@ раніше"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyiga %@ ko‘proq to‘lansa, qarz %@ oldin yopiladi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月多付 %@，可提前 %@ 還清"
          }
        }
      }
    },
    "debts.payoffNever": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры такім плацяжы доўг ніколі не будзе пагашаны: ён не пакрывае працэнты"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei dieser Zahlung endet die Schuld nie: Sie deckt die Zinsen nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this payment the debt never closes: it does not cover the interest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con este pago la deuda nunca se cierra: no cubre los intereses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ce paiement, la dette ne se clôt jamais : il ne couvre pas les intérêts"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questa rata il debito non si estingue: non copre gli interessi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл төлем кезінде берешек ешқашан жабылмайды: ол пайызды жаппайды"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy tej racie dług nigdy nie zostanie spłacony: rata nie pokrywa odsetek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com esse pagamento, a dívida nunca será quitada: ele não cobre os juros"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При таком платеже долг не закроется: он не покрывает проценты"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödeme faizi karşılamadığı için borç hiç kapanmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цього платежу борг ніколи не закриється: він не покриває відсотків"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu to‘lov foizlarni qoplamaydi, shuning uchun qarz hech qachon yopilmaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以此金額付款無法還清債務，因為不足以支付利息"
          }
        }
      }
    },
