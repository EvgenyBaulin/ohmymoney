    "schedule.order.ask": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкажыце на гэтае пытанне, каб захаваць крэдыт."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworten Sie das — der Kredit wird ohne Antwort nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer this — the loan is not saved without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda esto — sin ello no se guarda el préstamo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à cette question — le crédit n'est pas enregistré sans elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi per salvare il prestito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осыған жауап беріңіз — онсыз несие сақталмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedz na to pytanie, aby zapisać kredyt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda para salvar o empréstimo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответьте — без ответа долг не сохранить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu yanıtlayın; kredi bu bilgi olmadan kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідайте — без цього кредит не зберігається."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga javob bering — usiz kredit saqlanmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先回答此問題，否則無法儲存貸款。"
          }
        }
      }
    },
    "schedule.order.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«Спачатку працэнты»: плацёж спачатку пакрывае працэнты, налічаныя з папярэдняга плацяжу, а рэшта памяншае доўг."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zuerst die Zinsen“: Eine Zahlung deckt zuerst die Zinsen seit der letzten Zahlung, der Rest senkt die Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«Interest first»: a payment first pays the interest accrued since the payment before, the rest lowers the debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Primero los intereses»: un pago cubre antes los intereses devengados desde el pago anterior; el resto reduce la deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Intérêts d'abord » : un paiement règle d'abord les intérêts courus depuis le paiement précédent, le reste réduit la dette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Prima gli interessi»: ogni pagamento copre prima gli interessi maturati dal pagamento precedente; il resto riduce il debito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Алдымен пайыз»: төлем алдымен алдыңғы төлемнен бері жиналған пайызды жабады, қалғаны берешекті азайтады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Najpierw odsetki»: wpłata najpierw pokrywa odsetki naliczone od poprzedniej wpłaty, a reszta zmniejsza dług."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Juros primeiro»: cada pagamento cobre os juros acumulados desde o pagamento anterior; o restante reduz a dívida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сначала проценты»: платёж сначала гасит проценты, накопленные с прошлого платежа, остальное уменьшает долг."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Önce faiz»: Ödeme önce önceki ödemeden beri biriken faizi karşılar, kalanı borcu azaltır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Спершу відсотки»: платіж спочатку покриває відсотки, нараховані від попереднього платежу, а решта зменшує борг."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Avval foizlar»: to‘lov avval oldingi to‘lovdan beri hisoblangan foizlarni qoplaydi, qolgani qarzni kamaytiradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«先還利息»：每筆還款先支付上次還款後累計的利息，其餘金額用於償還本金。"
          }
        }
      }
    },
