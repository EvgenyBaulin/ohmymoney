    "debts.card.missed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarixli çıxarış üzrə ödəniş gecikib: kartın bütün qalığı artıq borc sayılır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж па выпісцы да %@ прапушчаны: цяпер уся запазычанасць па картцы лічыцца доўгам"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výpis splatný %@ nebyl uhrazen: celý zůstatek karty je nyní dluhem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abrechnung vom %@ wurde versäumt: Die ganze Schuld der Karte ist jetzt eine Schuld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The statement due %@ was missed: the whole debt of the card is a debt now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pagó el extracto con vencimiento el %@: toda la deuda de la tarjeta es ya una deuda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relevé du %@ n'a pas été réglé : toute la dette de la carte est désormais exigible"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ մարման ժամկետով քաղվածքը չի վճարվել․ քարտի ամբողջ գումարն այժմ պարտք է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento dell’estratto conto con scadenza %@ non è stato effettuato: ora l’intero importo della carta è un debito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が支払期限の請求が未払いです。カードの利用残高全額が借入になりました"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ის ამონაწერის გადახდის ვადა გასულია: ბარათის მთელი თანხა ახლა ვალია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күнгі үзінді төленбей қалды: картаның бүкіл берешегі енді қарыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 결제일을 놓쳐 카드 미상환액 전체가 빚으로 처리됩니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлөө мөөнөтү %@ болгон көчүрмө төлөнгөн жок: эми картанын бүт калдыгы карыз болуп эсептелет"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het afschrift met betaaldatum %@ is niet betaald: de volledige creditcardschuld is nu opeisbaar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie spłacono wyciągu z terminem %@: całe zadłużenie karty jest teraz długiem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fatura com vencimento em %@ não foi paga: agora, todo o saldo do cartão é uma dívida"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O extrato com vencimento em %@ não foi pago: todo o saldo do cartão está agora em dívida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок выписки %@ пропущен: вся задолженность по карте теперь долг"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муҳлати пардохти иқтибос то %@ гузашт: ҳоло тамоми маблағи корт қарз аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son ödeme tarihi %@ olan ekstre ödenmedi. Kartın tüm bakiyesi artık borçtur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виписку від %@ пропущено: весь борг по картці тепер є боргом"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sanasidagi hisobot to‘lovi o‘tkazib yuborildi: endi kartadagi butun summa qarz hisoblanadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未按 %@ 到期的账单还款，信用卡全部欠款现已计为债务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未在 %@ 繳清帳單：信用卡全部欠款現已列為債務"
          }
        }
      }
    },
    "debts.card.missedNoDay": {
