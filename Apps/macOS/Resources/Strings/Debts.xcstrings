    "instalmentReturn.markup.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The debt also goes down by %@: the overpayment of the parts not paid yet. The parts keep their amounts; the payments end earlier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La deuda también baja en %@: el sobrepago de los plazos aún no pagados. Los plazos conservan sus importes; los pagos terminan antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долг уменьшится ещё на %@: переплата неоплаченных частей. Суммы частей прежние, платежи закончатся раньше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Борг також зменшується на %@: переплата за ще не сплачені частини. Частини лишаються на своїх сумах, платежі закінчуються раніше."
          }
        }
      }
    },
