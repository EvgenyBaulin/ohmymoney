    "schedule.order.ask": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buna cavab verin — əks halda kredit saxlanılmayacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкажыце на гэтае пытанне, каб захаваць крэдыт."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovězte na tuto otázku. Bez odpovědi se půjčka neuloží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworten Sie das — der Kredit wird ohne Antwort nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer this — the loan is not saved without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda esto — sin ello no se guarda el préstamo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à cette question — le crédit n'est pas enregistré sans elle."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատասխանեք այս հարցին․ առանց դրա վարկը չի պահպանվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi per salvare il prestito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択してください。選択しないとローンを保存できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უპასუხეთ ამ კითხვას — ამის გარეშე სესხი არ შეინახება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осыған жауап беріңіз — онсыз несие сақталмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변해야 대출이 저장됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Буга жооп бериңиз — ансыз насыя сакталбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord deze vraag om de lening te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedz na to pytanie, aby zapisać kredyt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda para salvar o empréstimo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda para guardar o empréstimo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответьте — без ответа долг не сохранить."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба ин ҷавоб диҳед — бе он қарз нигоҳ дошта намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu yanıtlayın; kredi bu bilgi olmadan kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідайте — без цього кредит не зберігається."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga javob bering — usiz kredit saqlanmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先回答此问题，否则无法存储贷款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先回答此問題，否則無法儲存貸款。"
          }
        }
      }
    },
    "schedule.order.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Əvvəlcə faiz»: ödəniş əvvəlcə son ödənişdən bəri hesablanmış faizi ödəyir, qalanı borcu azaldır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«Спачатку працэнты»: плацёж спачатку пакрывае працэнты, налічаныя з папярэдняга плацяжу, а рэшта памяншае доўг."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nejdřív úroky»: splátka nejprve pokryje úroky od předchozí splátky, zbytek sníží dluh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zuerst die Zinsen“: Eine Zahlung deckt zuerst die Zinsen seit der letzten Zahlung, der Rest senkt die Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«Interest first»: a payment first pays the interest accrued since the payment before, the rest lowers the debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Primero los intereses»: un pago cubre antes los intereses devengados desde el pago anterior; el resto reduce la deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Intérêts d'abord » : un paiement règle d'abord les intérêts courus depuis le paiement précédent, le reste réduit la dette."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Նախ տոկոսները»․ վճարումից նախ մարվում են նախորդ վճարումից հետո կուտակված տոկոսները, իսկ մնացածը նվազեցնում է պարտքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Prima gli interessi»: ogni pagamento copre prima gli interessi maturati dal pagamento precedente; il resto riduce il debito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「利息を優先」：返済額を前回の返済以降に発生した利息に充当し、残りを元金に充当します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«ჯერ პროცენტი»: გადახდა ჯერ წინა გადახდის შემდეგ დარიცხულ პროცენტს ფარავს, დარჩენილი თანხა კი ვალს ამცირებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Алдымен пайыз»: төлем алдымен алдыңғы төлемнен бері жиналған пайызды жабады, қалғаны берешекті азайтады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "«이자 우선»: 이전 납부일 이후 발생한 이자를 먼저 갚고 나머지는 원금을 갚습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Адегенде пайыз»: төлөм адегенде мурунку төлөмдөн бери чегерилген пайызды жабат, калганы карызды азайтат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Eerst rente»: een betaling voldoet eerst de rente sinds de vorige betaling. De rest verlaagt de schuld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Najpierw odsetki»: wpłata najpierw pokrywa odsetki naliczone od poprzedniej wpłaty, a reszta zmniejsza dług."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Juros primeiro»: cada pagamento cobre os juros acumulados desde o pagamento anterior; o restante reduz a dívida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Juros primeiro»: cada pagamento cobre primeiro os juros acumulados desde o pagamento anterior. O restante reduz a dívida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сначала проценты»: платёж сначала гасит проценты, накопленные с прошлого платежа, остальное уменьшает долг."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«Аввал фоиз»: пардохт аввал фоизи аз пардохти пешина ҷамъшударо мепӯшонад, боқимонда қарзро кам мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Önce faiz»: Ödeme önce önceki ödemeden beri biriken faizi karşılar, kalanı borcu azaltır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Спершу відсотки»: платіж спочатку покриває відсотки, нараховані від попереднього платежу, а решта зменшує борг."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Avval foizlar»: to‘lov avval oldingi to‘lovdan beri hisoblangan foizlarni qoplaydi, qolgani qarzni kamaytiradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "«优先还利息»：每笔还款先支付自上次还款以来产生的利息，剩余部分用于偿还本金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«先還利息»：每筆還款先支付上次還款後累計的利息，其餘金額用於償還本金。"
          }
        }
      }
    },
