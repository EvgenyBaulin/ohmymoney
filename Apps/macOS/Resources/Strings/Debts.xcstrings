    "parts.how.once": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xərc bir dəfə — alış günü qeyd edilib"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдатак запісаны адзін раз — у дзень пакупкі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výdaj byl zaznamenán jednou — v den nákupu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe wurde einmal erfasst — am Tag des Kaufs"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expense was recorded once — on the day of the purchase"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gasto se registró una vez — el día de la compra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dépense a été notée une fois — le jour de l'achat"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծախսը գրանցվել է մեկ անգամ՝ գնման օրը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La spesa è stata registrata una sola volta, il giorno dell'acquisto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出は購入日に一度だけ記録されます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხარჯი ერთხელ აღირიცხა — შეძენის დღეს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шығыс бір рет жазылды — сатып алу күні"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출은 구매일에 한 번 기록되었습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чыгаша бир жолу — сатып алган күнү жазылган"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgave is eenmaal geregistreerd, op de dag van aankoop"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatek zapisano raz — w dniu zakupu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A despesa foi registrada uma vez, no dia da compra"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A despesa foi registada uma vez — no dia da compra"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход записан один раз — в день покупки"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷот як бор — дар рӯзи харид сабт шуд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gider bir kez, satın alma gününde kaydedildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрату записано один раз — у день покупки"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajat bir marta — xarid kuni qayd etilgan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支出已在购买当天一次性记账"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出只在購買當天記錄一次"
          }
        }
      }
