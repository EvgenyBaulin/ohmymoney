    "form.monthPaid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month's payment already made?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya se hizo el pago de este mes?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёж за этот месяц уже сделан?"
          }
        },
        "uk": {
