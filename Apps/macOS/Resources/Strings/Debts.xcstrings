    "ladder.card.snowball": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qartopu: əvvəl ən kiçik borc — ilk borc daha tez bağlanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Снежны ком: спачатку найменшы доўг — першы доўг знікне раней."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sněhová koule: nejprve nejmenší dluh — první splatíte dříve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneeball: zuerst die kleinste Schuld — die erste ist früher weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snowball: the smallest debt first — the first one goes sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bola de nieve: primero la deuda más pequeña — la primera se cierra antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boule de neige : la plus petite dette d'abord — la première se termine plus vite."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձնագունդ․ սկզբում՝ ամենափոքր պարտքը, առաջին պարտքն ավելի շուտ է մարվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Palla di neve: prima il debito più piccolo, per estinguerlo prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スノーボール：残額の少ない負債から返済し、最初の完済を早めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თოვლის გუნდა: ჯერ ყველაზე მცირე ვალი — პირველი ვალი უფრო ადრე დაიფარება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Снежбол: ең кіші берешек бірінші — біріншісі тезірек жабылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스노볼: 금액이 작은 부채부터 상환하여 첫 부채를 더 빨리 정리합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кар тоголок: адегенде эң кичине карыз — биринчи карыз эрте жабылат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneeuwbal: de kleinste schuld eerst — de eerste is sneller afgelost."
          }
        },
        "pl": {
          "stringUnit": {
