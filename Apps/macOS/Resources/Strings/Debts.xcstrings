    "schedule.graceKind.interest.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each month — the interest on the money drawn so far."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mes — los intereses sobre el dinero dispuesto hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mois — les intérêts sur l'argent tiré jusqu'ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый месяц — проценты на уже полученные деньги."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
