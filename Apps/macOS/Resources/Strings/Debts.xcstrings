    "form.transfer.tooMuch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Больш за рэшту гэтага доўгу: можна перанесці не больш за ўсю рэшту."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr, als auf dieser Schuld übrig ist: Eine Überweisung verschiebt höchstens alles davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than is left on this debt: a transfer moves at most all of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es más de lo que queda en esta deuda: una transferencia mueve como máximo todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus que ce qui reste sur cette dette : un virement en déplace au plus la totalité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera il residuo del debito: puoi trasferire al massimo l'intero residuo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл берешектегі қалғаннан көп: аударым одан көбін, яғни бәрін ғана көшіре алады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Więcej niż pozostało do spłaty: można przenieść najwyżej cały dług."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor excede o saldo desta dívida. Uma transferência pode mover, no máximo, todo o saldo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше, чем осталось по долгу: перенести можно не больше остатка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu borcun kalanından fazla: En fazla borcun tamamı aktarılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це більше, ніж лишилося за цим боргом: переказ переносить не більше за весь борг."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qarzning qolgan summasidan ko‘p: ko‘pi bilan qolgan summani o‘tkazish mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過此債務的剩餘金額：最多只能轉移全部餘額。"
          }
        }
      }
    },
