    "pause.endsBeforeStart": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апошні дзень ранейшы за першы: паўза не захавана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Tag liegt vor dem ersten. Die Pause wird nicht gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last day is before the first: the pause is not saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último día es anterior al primero: no se ha guardado la pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier jour précède le premier : la pause n’est pas enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultimo giorno precede il primo: la sospensione non viene salvata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы күн бірінші күннен бұрын: үзіліс сақталмады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni dzień przypada przed pierwszym. Przerwa nie zostanie zapisana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O último dia é anterior ao primeiro: a pausa não foi salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний день раньше первого: пауза не сохранится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son gün ilk günden önce: erteleme kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останній день передує першому: паузу не збережено."
          }
        }
      }
    },
