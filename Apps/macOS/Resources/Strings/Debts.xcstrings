          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro mudou de mãos hoje"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги перешли сегодня"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bugün el değiştirdi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
