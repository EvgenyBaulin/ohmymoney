        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты плацёж закрывае ўсе плацяжы за месяц"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser Zahlung gesagt: keine weiteren Zahlungen in diesem Monat"
