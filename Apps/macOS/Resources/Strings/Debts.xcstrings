    "debts.card.missed": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж па выпісцы да %@ прапушчаны: цяпер уся запазычанасць па картцы лічыцца доўгам"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abrechnung vom %@ wurde versäumt: Die ganze Schuld der Karte ist jetzt eine Schuld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The statement due %@ was missed: the whole debt of the card is a debt now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pagó el extracto con vencimiento el %@: toda la deuda de la tarjeta es ya una deuda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relevé du %@ n'a pas été réglé : toute la dette de la carte est désormais exigible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento dell’estratto conto con scadenza %@ non è stato effettuato: ora l’intero importo della carta è un debito"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күнгі үзінді төленбей қалды: картаның бүкіл берешегі енді қарыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie spłacono wyciągu z terminem %@: całe zadłużenie karty jest teraz długiem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fatura com vencimento em %@ não foi paga: agora, todo o saldo do cartão é uma dívida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок выписки %@ пропущен: вся задолженность по карте теперь долг"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son ödeme tarihi %@ olan ekstre ödenmedi. Kartın tüm bakiyesi artık borçtur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виписку від %@ пропущено: весь борг по картці тепер є боргом"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sanasidagi hisobot to‘lovi o‘tkazib yuborildi: endi kartadagi butun summa qarz hisoblanadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未在 %@ 繳清帳單：信用卡全部欠款現已列為債務"
          }
        }
      }
    },
