      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is a payment ahead"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это платёж вперёд"
          }
        },
