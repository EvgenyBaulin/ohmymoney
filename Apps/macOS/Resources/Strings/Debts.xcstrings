          }
        }
      }
    },
    "prepay.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money above the payment lowers the debt. «Shorten the term» keeps the payment and ends the loan sooner; «Lower the payment» keeps the term and works out a smaller payment. «It is a payment ahead» — the money pays the next payments, as any payment does. Say what the bank did."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero por encima del pago reduce la deuda. «Acortar el plazo» mantiene el pago y termina el préstamo antes; «Bajar el pago» mantiene el plazo y calcula un pago menor. «Es un pago por adelantado» — el dinero cubre los pagos siguientes, como cualquier pago. Indique lo que hizo el banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги сверх платежа уменьшают долг. «Уменьшить срок» — платёж прежний, кредит кончится раньше; «Уменьшить платёж» — срок прежний, платёж пересчитается меньше. «Это платёж вперёд» — деньги закроют следующие платежи, как обычный платёж. Выберите то, что сделал банк."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші понад платіж зменшують борг. «Скоротити строк» зберігає платіж і завершує кредит раніше; «Зменшити платіж» зберігає строк і розраховує менший платіж. «Це платіж наперед» — гроші йдуть на наступні платежі, як і будь-який платіж. Зазначте, що зробив банк."
          }
        }
      }
    },
    "prepay.payment": {
