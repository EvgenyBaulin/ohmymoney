        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл алдағы төлем"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선납"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул алдын ала төлөм"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is een vooruitbetaling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wpłata na poczet rat"
          }
        },
        "pt-BR": {
