    "typed.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğ bu və sonrakı ödənişlərə aiddir; növbəti vaxtından əvvəl ödəniş zamanı yenidən hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума дзейнічае для гэтага і наступных плацяжоў, пакуль пазнейшае датэрміновае пагашэнне не пералічыць яе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částka platí pro tuto i následující splátky, dokud ji další mimořádná splátka znovu nepřepočítá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Summe gilt für diese Fälligkeit und die danach, bis eine spätere vorzeitige Rückzahlung die Zahlung neu berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sum holds for this due and the ones after it, until a later early repayment works the payment out again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suma vale para este vencimiento y los siguientes, hasta que una amortización anticipada posterior vuelva a calcular el pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La somme vaut pour cette échéance et les suivantes, jusqu'à ce qu'un remboursement anticipé ultérieur recalcule le paiement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը գործում է այս և հաջորդ վճարումների համար, մինչև հերթական վաղաժամ մարումից հետո վճարումը վերահաշվարկվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importo vale per questa scadenza e per le successive, finché un rimborso anticipato non ricalcola la rata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この返済日以降はこの金額が適用されます。その後、繰上返済によって返済額が再計算されるまで有効です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა მოქმედებს ამ და მომდევნო გადახდებზე, სანამ შემდგომი ვადამდელი დაფარვა მას ხელახლა არ გადაანგარიშებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сома осы мерзім мен одан кейінгілер үшін сақталады, кейінірек мерзімнен бұрын өтеу төлемді қайта есептегенше."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 금액은 선택한 납부일부터 적용되며, 이후 중도 상환으로 납부금이 다시 계산될 때까지 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сумма ушул жана кийинки төлөмдөргө, мөөнөтүнөн мурда төлөгөндөн кийин төлөм кайра эсептелгенге чейин колдонулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bedrag geldt vanaf deze vervaldatum, totdat een latere vervroegde aflossing de betaling opnieuw berekent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kwota obowiązuje dla tego i kolejnych terminów, dopóki późniejsza nadpłata nie przeliczy raty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor se aplica a este vencimento e aos seguintes, até que uma amortização antecipada recalcule o pagamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este valor aplica-se a este vencimento e aos seguintes, até que uma amortização antecipada recalcule o pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма действует с этого платежа и дальше — пока досрочка позже не пересчитает платёж."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин маблағ барои ҳамин ва пардохтҳои минбаъда амал мекунад, то пардохти пеш аз муҳлати навбатӣ онро аз нав ҳисоб кунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tutar, sonraki bir erken ödeme tutarı yeniden hesaplatana kadar bu ve sonraki vadelerde geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця сума діє для цього платежу й наступних, доки пізніше дострокове погашення не перерахує платіж."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu summa ushbu va keyingi to‘lovlar uchun amal qiladi. Keyingi muddatidan oldin to‘lov summani qayta hisoblaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此金额适用于本期及后续各期，直到再次提前还款并重新计算还款额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此金額適用於該期及之後各期，直到再次提前還款而重新計算。"
          }
        }
      }
    },
