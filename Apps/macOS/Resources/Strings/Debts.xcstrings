    "debts.parts": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlar üçün ödənilib, geri qaytarılacaq"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аплачана за іншых, чакаецца вяртанне"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplaceno za ostatní, čeká na vrácení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für sie bezahlt, wartet auf Rückzahlung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid for them, waiting to come back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagados por ellos, pendientes de devolución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payé pour eux, en attente de retour"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարել եմ ուրիշի փոխարեն, սպասում եմ վերադարձին"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagato per loro, in attesa di rimborso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立替金の回収待ち"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მათ ნაცვლად გადახდილი, დაბრუნების მოლოდინში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Олар үшін төленген, қайтуын күтуде"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 지불하고 받을 돈"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алар үчүн төлөндү, кайтарылышы күтүлүүдө"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor hen betaald, wacht op terugbetaling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłacono za innych, do zwrotu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago por outras pessoas, a receber"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago por outros, à espera de reembolso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заплачено за него, ждёт возврата"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои онҳо пардохт шуд, бозгашт дар назар аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlar adına ödendi, geri ödenmesi bekleniyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплачено за них, чекаємо повернення"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ular uchun to‘landi, qaytarilishi kutilmoqda"
