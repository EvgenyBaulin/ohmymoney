    "split.accountingHint": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Поўны кошт пакупкі ўлічваецца як расход у дзень пакупкі. Плацяжы пагашаюць доўг, а камісія ўлічваецца часткамі ў катэгорыі «Камісіі». Змяніце даты або сумы паводле графіка сэрвісу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der volle Kaufpreis wird am Kaufdatum als Ausgabe erfasst. Zahlungen tilgen die Schuld; Gebühren werden anteilig als Ausgabe erfasst. Passe Datum und Betrag an den Zahlungsplan des Dienstes an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full purchase price is spent on the purchase date. Payments repay the debt; commission is spent in Fees in parts. Adjust any date or amount to match the service schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe total se registra como gasto en la fecha de compra. Los pagos saldan la deuda; la comisión se registra por partes en Comisiones. Ajusta las fechas o los importes al calendario del servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix total est dépensé à la date d’achat. Les paiements remboursent la dette ; la commission est répartie dans les frais. Modifiez les dates ou les montants selon l’échéancier du service."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intero importo viene speso alla data di acquisto. I pagamenti rimborsano il debito; le commissioni vengono registrate a rate in Commissioni. Modifica date e importi in base al piano del servizio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алудың толық құны сатып алынған күні шығысқа жазылады. Төлемдер қарызды өтейді; комиссия «Комиссиялар» санатына бөліп жазылады. Күндер мен сомаларды қызмет кестесіне сай өзгертіңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała cena zakupu jest wydatkiem w dniu zakupu. Raty spłacają dług, a prowizja jest rozliczana w częściach w kategorii Opłaty. Dostosuj daty i kwoty do harmonogramu usługi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor total da compra é registrado na data da compra. Os pagamentos quitam a dívida; a comissão é registrada em Tarifas, em partes. Ajuste as datas e os valores conforme o cronograma do serviço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка — расход целиком в день покупки. Платежи погашают долг, комиссия учитывается частями в «Комиссиях». Измените любую дату или сумму по графику сервиса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma tutarının tamamı satın alma tarihinde harcanır. Ödemeler borcu kapatır; komisyon, Ücretler altında parça parça harcanır. Tarihleri ve tutarları hizmetin takvimine göre düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повна вартість покупки враховується в дату покупки. Платежі погашають борг, а комісія частинами враховується в категорії «Комісії». Змініть дати або суми відповідно до графіка сервісу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xaridning to‘liq narxi xarid kunida xarajatga yoziladi. To‘lovlar qarzni so‘ndiradi; komissiya «Komissiyalar»da qismlarga bo‘lib xarajatga yoziladi. Xizmat jadvaliga moslash uchun sana yoki summani o‘zgartiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買當日計入全額支出。每筆付款償還債務，手續費則分次計入「費用」。可調整日期或金額以符合服務的付款計畫。"
          }
        }
      }
    },
