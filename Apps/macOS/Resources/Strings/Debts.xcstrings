    "ladder.avalanche.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку найбольшая стаўка: найменшыя працэнты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst der höchste Zinssatz: die wenigsten Zinsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The highest rate first: the least interest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero el tipo más alto: los intereses más bajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux le plus élevé d'abord : le moins d'intérêts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima il tasso più alto: meno interessi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең жоғары мөлшерлеме бірінші: ең аз пайыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw najwyższe oprocentowanie: najmniej odsetek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maior taxa primeiro: menos juros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала самая высокая ставка — меньше всего процентов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce en yüksek faiz: En az faiz ödemesi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу найвища ставка: найменше відсотків."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval eng yuqori stavka: eng kam foiz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先還利率最高的債務，支付的利息最少。"
          }
        }
      }
    },
    "ladder.card.avalanche": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Лавіна: спачатку доўг з найбольшай стаўкай — найменшая пераплата."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawine: zuerst die Schuld mit dem höchsten Zinssatz — am wenigsten überzahlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalanche: the debt with the highest rate first — the least overpaid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalancha: primero la deuda con el tipo más alto — menos sobrepagado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalanche : la dette au taux le plus élevé d'abord — le moins de surpaiement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valanga: prima il debito con il tasso più alto, per pagare meno interessi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аваланш: ең жоғары мөлшерлемелі берешек бірінші — ең аз артық төлем."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawina: najpierw dług z najwyższym oprocentowaniem — najmniejsza nadpłata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalanche: a dívida com maior taxa primeiro — menos juros pagos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лавина: сначала долг с самой высокой ставкой — меньше переплата."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çığ: Önce faizi en yüksek borç; toplamda daha az ödeme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лавина: спершу борг з найвищою ставкою — найменше переплати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘chki: avval eng yuqori stavkali qarz — eng kam ortiqcha to‘lov."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雪崩法：先還利率最高的債務，支付的利息最少。"
          }
        }
      }
    },
