    "ladder.never": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödənişlər borcları bağlamır: əlavə məbləğ ayırın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя плацяжы не погасяць даўгі: дадайце грошы звыш іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto splátky dluhy nesplatí. Přidejte peníze navíc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlungen tilgen die Schulden nicht: Legen Sie Geld darüber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payments do not pay the debts off: add money above them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pagos no cancelan las deudas: añada dinero por encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements ne remboursent pas les dettes : ajoutez de l'argent au-dessus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս վճարումները չեն մարում պարտքերը․ ավելացրեք լրացուցիչ գումար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pagamenti non estinguono i debiti: aggiungi un importo extra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支払額では完済できません。追加返済額を増やしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ გადახდებით ვალები ვერ დაიფარება: დაამატეთ თანხა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлемдер берешектерді жаппайды: үстіне ақша қосыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 납입액으로는 부채를 갚을 수 없습니다. 추가 납입액을 늘리세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул төлөмдөр карыздарды жабууга жетпейт: кошумча акча бөлүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze betalingen los je de schulden niet af. Voeg een extra bedrag toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te wpłaty nie wystarczą na spłatę długów: dodaj więcej środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pagamentos não quitam as dívidas. Adicione um valor extra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes pagamentos não liquidam as dívidas: acrescente um valor adicional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежи не закрывают долги — добавьте сумму сверх."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин пардохтҳо қарзҳоро намепӯшонанд: маблағи иловагӣ ҷудо кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödemeler borçları kapatmaya yetmiyor: Ek tutar ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежі не погашають боргів: додайте гроші понад них."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu to‘lovlar qarzlarni qoplamaydi: qo‘shimcha pul qo‘shing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前还款额无法还清债务，请增加额外还款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的還款額無法還清債務，請增加額外還款。"
          }
        }
      }
    },
