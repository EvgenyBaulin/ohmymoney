    "wizard.card.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit kartı borc deyil, mənfi balanslı hesabdır: limit, çıxarış və güzəşt müddəti hesabın şərtləridir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крэдытная картка — гэта рахунак з мінусам, а не доўг: яе ліміт, выпіска і льготны перыяд — умовы рахунку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditní karta je účet se záporným zůstatkem, nikoli dluh. Limit, výpis a bezúročné období jsou podmínky účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreditkarte ist ein Konto mit einem Minus, keine Schuld: Ihr Limit, die Abrechnung und die zinsfreie Frist sind die Bedingungen des Kontos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit card is an account with a minus, not a debt: its limit, statement and grace period are the terms of the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de crédito es una cuenta con signo menos, no una deuda: su límite, extracto y periodo de gracia son las condiciones de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de crédit est un compte au solde négatif, pas une dette : son plafond, son relevé et sa période de grâce sont les conditions du compte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վարկային քարտը բացասական մնացորդով հաշիվ է, ոչ թե պարտք․ դրա սահմանաչափը, քաղվածքը և արտոնյալ ժամկետը հաշվի պայմաններն են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta di credito è un conto che può andare in negativo, non un debito: limite, estratto conto e periodo senza interessi sono condizioni del conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットカードは残高がマイナスになる口座です。利用限度額、明細、無利息期間は口座の条件として設定します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საკრედიტო ბარათი უარყოფითი ნაშთის მქონე ანგარიშია და არა ვალი: ლიმიტი, ამონაწერი და საშეღავათო პერიოდი ანგარიშის პირობებია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік карта — теріс теңгерімі бар есеп-шот, берешек емес: оның лимиті, үзіндісі және кейінге қалдыру кезеңі — есеп-шоттың шарттары."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신용카드는 부채가 아닌 마이너스 계좌입니다. 한도, 명세서 및 무이자 기간은 계좌의 조건입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттик карта — карыз эмес, терс калдыгы бар эсеп: анын лимити, көчүрмөсү жана жеңилдетилген мөөнөтү эсептин шарттарына кирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een creditcard is een rekening met een negatief saldo. De limiet, het afschrift en de rentevrije periode zijn onderdeel van de rekeningvoorwaarden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta kredytowa to konto z saldem ujemnym, a nie dług: limit, wyciąg i okres bezodsetkowy to warunki konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão de crédito é uma conta com saldo negativo. O limite, a fatura e o prazo sem juros são condições da conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão de crédito é uma conta com saldo negativo, não uma dívida: o limite, o extrato e o período sem juros são condições da conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитка — это счёт с минусом, а не долг: лимит, выписка и льготный период — условия счёта."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Корти кредитӣ ҳисоб бо бақияи манфист, на қарз: лимит, ҳисобот ва давраи имтиёзнок шартҳои ҳисобанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi kartı bir borç değil, eksi bakiyeli bir hesaptır: Limiti, ekstresi ve faizsiz dönemi hesap koşullarıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитна картка — це рахунок з мінусом, а не борг: її ліміт, виписка й пільговий період — це умови рахунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit karta — manfiy qoldiqli hisob. Limit, ko‘chirma va imtiyozli davr uning shartlaridir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡是可透支的账户，不是欠款：额度、账单和免息期属于账户条款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡是可為負數的帳戶，不是債務；額度、帳單和免息期是帳戶條款。"
          }
        }
      }
    },
