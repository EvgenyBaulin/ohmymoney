    "cushion.goal.byMonth": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мэта — %1$@ (%2$@): адкладвайце %3$@ штомесяц да %4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel — %1$@ (%2$@): %3$@ im Monat beiseitelegen bis %4$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal — %1$@ (%2$@): put aside %3$@ a month until %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo — %1$@ (%2$@): aparte %3$@ al mes hasta el %4$@"
