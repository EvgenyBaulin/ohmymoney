        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳадаф — %1$@ (%2$@): то %4$@ ҳар моҳ %3$@ ҷудо кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef — %1$@ (%2$@): %4$@ tarihine kadar ayda %3$@ biriktirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціль — %1$@ (%2$@): відкладати по %3$@ на місяць до %4$@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maqsad — %1$@ (%2$@): %4$@ gacha har oy %3$@ jamg‘aring"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標 — %1$@（%2$@）：每月存入 %3$@，直到 %4$@"
