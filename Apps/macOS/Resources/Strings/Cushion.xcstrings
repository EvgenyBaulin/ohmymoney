        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel — %1$@ (%2$@): odkładaj %3$@ miesięcznie do %4$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta — %1$@ (%2$@): guarde %3$@ por mês até %4$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель — %1$@ (%2$@): откладывайте %3$@ в месяц до %4$@"
