    "cushion.setup.suggested": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Звычайныя неабходныя катэгорыі ўжо пазначаны: праверце і захавайце іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die üblichen notwendigen Kategorien sind angekreuzt: Prüfen Sie sie und sichern Sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The usual essential categories are ticked: check them and save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Están marcadas las categorías esenciales habituales: revíselas y guarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories essentielles habituelles sont cochées : vérifiez-les et enregistrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le categorie essenziali più comuni sono selezionate: controllale e salva."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі маңызды санаттар белгіленді: тексеріп, сақтаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаттагы зарыл категориялар белгиленди: текшерип, сактаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczono typowe niezbędne kategorie. Sprawdź je i zachowaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias essenciais mais comuns estão selecionadas. Confira e salve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечены обычные необходимые категории — проверьте и сохраните."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияҳои маъмулии зарурӣ интихоб шудаанд: онҳоро санҷед ва захира кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaygın temel kategoriler seçildi: Kontrol edip kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначено звичайні необхідні категорії: перевірте їх і збережіть."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatdagi zarur toifalar belgilandi. Ularni tekshiring va saqlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已勾選常見的必要類別，請確認後儲存。"
          }
        }
      }
    },
