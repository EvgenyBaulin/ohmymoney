    "cushion.goal.none": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мэты пакуль няма: пазначце, на колькі месяцаў павінна хапіць падушкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Ziel: Sagen Sie, wie viele Monate das Polster decken soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No goal yet: say how many months the cushion should cover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay objetivo: indique cuántos meses debe cubrir el colchón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'objectif : indiquez pour combien de mois le matelas doit tenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun obiettivo: indica quanti mesi deve coprire il fondo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат әлі жоқ: жастық неше айға жетуі керектігін айтыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak celu: określ, na ile miesięcy ma wystarczyć poduszka."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель не задана: скажите, на сколько месяцев нужна подушка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hedef yok: Güvencenin kaç ay yeteceğini belirleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цілі ще немає: скажіть, на скільки місяців має вистачати подушки."
          }
        }
      }
    },
