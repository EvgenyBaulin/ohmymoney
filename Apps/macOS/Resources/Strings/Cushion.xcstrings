    "cushion.noAccounts": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehtiyat hesablarını seçin. Burada ehtiyatın gəlirsiz neçə aya çatacağı göstəriləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазначце рахункі падушкі, каб убачыць, на колькі месяцаў яе хопіць без даходу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte účty rezervy a uvidíte, na kolik měsíců vám bez příjmu vystačí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie die Konten des Polsters, dann zeigt sich hier, wie viele Monate es ohne Einnahmen reicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the accounts of the cushion, and this will show how many months it lasts without income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque las cuentas del colchón y aquí se verá cuántos meses dura sin ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez les comptes du matelas : ici s'affichera combien de mois il tient sans revenu."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշեք պահուստի հաշիվները՝ տեսնելու համար, թե քանի ամիս այն կբավականացնի առանց եկամտի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona i conti del fondo per vedere quanti mesi copre senza entrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生活防衛資金の口座を選択すると、収入がなくても何か月分を確保できるか表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონიშნეთ რეზერვის ანგარიშები და ნახავთ, რამდენ თვეს გეყოფათ შემოსავლის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық есеп-шоттарын белгілеңіз — сонда ол табыссыз неше айға жететіні көрсетіледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비상금 계좌를 선택하면 소득 없이 몇 개월을 생활할 수 있는지 표시됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Камдык каражаттын эсептерин белгилеңиз. Ошондо анын кирешесиз канча айга жетери көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer de rekeningen voor je buffer om te zien hoeveel maanden je zonder inkomen vooruit kunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz konta poduszki, aby zobaczyć, na ile miesięcy wystarczy bez dochodów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione as contas da reserva para ver quantos meses ela dura sem renda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione as contas da reserva para ver quantos meses duraria sem rendimentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте счета подушки — и здесь будет видно, на сколько месяцев её хватит без дохода."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобҳои захираро интихоб кунед, то бинед, ки он бе даромад ба чанд моҳ мерасад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvence hesaplarını seçin; gelir olmadan kaç ay yeteceği gösterilsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте рахунки подушки, і тут буде видно, на скільки місяців її вистачить без доходів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaxira hisoblarini belgilang. Shunda zaxira daromadsiz necha oyga yetishi ko‘rsatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记应急储备账户，即可查看没有收入时可维持的月数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記備用金帳戶，即可查看沒有收入時可支應的月數。"
          }
        }
      }
    },
    "cushion.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumat kifayət deyil: məcburi xərclər üçün 3 tam ay lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова даных: для разліку абавязковых выдаткаў патрэбны 3 поўныя месяцы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostatek dat: pro výpočet povinných výdajů jsou potřeba 3 celé měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Daten: Die Pflichtausgaben brauchen 3 volle Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough data: the obligatory spending needs 3 full months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos insuficientes: el gasto obligatorio necesita 3 meses completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données insuffisantes : les dépenses obligatoires demandent 3 mois complets."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալները բավարար չեն․ պարտադիր ծախսերի համար անհրաժեշտ է 3 ամբողջական ամիս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati insufficienti: servono 3 mesi interi di spese obbligatorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データが不足しています。必須支出の算出には丸3か月分のデータが必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემები არ არის საკმარისი: საჭიროა 3 სრული თვის სავალდებულო ხარჯები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер жеткіліксіз: міндетті шығысқа 3 толық ай керек."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 부족합니다. 필수 지출을 계산하려면 3개월의 전체 데이터가 필요합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат жетишсиз: милдеттүү чыгымдарды эсептөө үчүн 3 толук ай керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet genoeg gegevens: er zijn 3 volledige maanden aan verplichte uitgaven nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych: potrzebne są obowiązkowe wydatki z 3 pełnych miesięcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados insuficientes: são necessários 3 meses completos de gastos obrigatórios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados insuficientes: são necessários 3 meses completos de despesas obrigatórias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных: для обязательных трат нужно 3 полных месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумот кофӣ нест: барои ҳисоб кардани хароҷоти ҳатмӣ 3 моҳи пурра лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli veri yok: Zorunlu harcamalar için 3 tam ay gerekli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Даних поки мало: для обов'язкових витрат потрібні 3 повні місяці."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumot yetarli emas: majburiy xarajatlar uchun 3 to‘liq oy kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据不足：计算必要支出需要3个完整月的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料不足：必要支出需要 3 個完整月份的資料。"
          }
        }
      }
    },
