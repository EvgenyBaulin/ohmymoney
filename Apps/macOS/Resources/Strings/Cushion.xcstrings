    "cushion.noAccounts": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазначце рахункі падушкі, каб убачыць, на колькі месяцаў яе хопіць без даходу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie die Konten des Polsters, dann zeigt sich hier, wie viele Monate es ohne Einnahmen reicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the accounts of the cushion, and this will show how many months it lasts without income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque las cuentas del colchón y aquí se verá cuántos meses dura sin ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez les comptes du matelas : ici s'affichera combien de mois il tient sans revenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona i conti del fondo per vedere quanti mesi copre senza entrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық есеп-шоттарын белгілеңіз — сонда ол табыссыз неше айға жететіні көрсетіледі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz konta poduszki, aby zobaczyć, na ile miesięcy wystarczy bez dochodów."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте счета подушки — и здесь будет видно, на сколько месяцев её хватит без дохода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvence hesaplarını seçin; gelir olmadan kaç ay yeteceği gösterilsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте рахунки подушки, і тут буде видно, на скільки місяців її вистачить без доходів."
          }
        }
      }
    },
    "cushion.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова даных: для разліку абавязковых выдаткаў патрэбны 3 поўныя месяцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Daten: Die Pflichtausgaben brauchen 3 volle Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough data: the obligatory spending needs 3 full months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos insuficientes: el gasto obligatorio necesita 3 meses completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données insuffisantes : les dépenses obligatoires demandent 3 mois complets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati insufficienti: servono 3 mesi interi di spese obbligatorie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер жеткіліксіз: міндетті шығысқа 3 толық ай керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych: potrzebne są obowiązkowe wydatki z 3 pełnych miesięcy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных: для обязательных трат нужно 3 полных месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli veri yok: Zorunlu harcamalar için 3 tam ay gerekli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Даних поки мало: для обов'язкових витрат потрібні 3 повні місяці."
          }
        }
      }
    },
