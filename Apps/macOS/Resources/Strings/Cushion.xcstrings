    "cushion.setup.accountsHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesablardakı bütün valyutalarda olan vəsait ehtiyatı təşkil edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на гэтых рахунках ва ўсіх валютах складаюць падушку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze na těchto účtech tvoří rezervu ve všech měnách."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld dieser Konten, in jeder ihrer Währungen, ist das Polster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money of these accounts, every currency of it, is the cushion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de estas cuentas, en todas sus divisas, es el colchón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent de ces comptes, dans toutes ses devises, est le matelas."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հաշիվների գումարը՝ բոլոր արժույթներով, կազմում է պահուստը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il denaro su questi conti, in qualsiasi valuta, costituisce il fondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの口座の全通貨の残高が生活防衛資金になります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ანგარიშებზე არსებული თანხა ყველა ვალუტაში რეზერვს შეადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы есеп-шоттардың ақшасы, барлық валютасымен, жастық болып саналады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계좌에 있는 모든 통화의 금액이 비상금에 포함됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул эсептердеги бардык валютадагы акча камдык каражатты түзөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al het geld op deze rekeningen, in elke valuta, vormt je buffer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie środki na tych kontach, we wszystkich walutach, tworzą poduszkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o dinheiro dessas contas, em qualquer moeda, compõe a reserva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o dinheiro destas contas, em qualquer moeda, constitui a reserva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги этих счетов во всех их валютах — подушка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тамоми маблағи ин ҳисобҳо, бо ҳар асъор, захираро ташкил медиҳад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesaplardaki tüm para birimleri güvenceye dahildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші цих рахунків, кожна їхня валюта, і є подушкою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hisoblar barcha valyutalardagi mablag‘lari bilan zaxirani tashkil qiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些账户中的所有资金，无论币种，均计入应急储备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些帳戶中所有幣別的資金都計入備用金。"
          }
        }
      }
    },
