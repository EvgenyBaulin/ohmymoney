    "cushion.goal.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ hədəf yoxdur: ehtiyatın neçə aya çatmalı olduğunu seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мэты пакуль няма: пазначце, на колькі месяцаў павінна хапіць падушкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím bez cíle: určete, na kolik měsíců má rezerva vystačit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Ziel: Sagen Sie, wie viele Monate das Polster decken soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No goal yet: say how many months the cushion should cover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay objetivo: indique cuántos meses debe cubrir el colchón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'objectif : indiquez pour combien de mois le matelas doit tenir."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նպատակ դեռ չկա․ նշեք, թե քանի ամսվա համար է պետք պահուստը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun obiettivo: indica quanti mesi deve coprire il fondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標はまだありません。何か月分を備えるか設定してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიზანი ჯერ არ არის: მიუთითეთ, რამდენ თვეს უნდა ეყოს რეზერვი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат әлі жоқ: жастық неше айға жетуі керектігін айтыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 목표가 없습니다. 비상금으로 생활할 개월 수를 설정하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча максат жок: камдык каражат канча айга жетиши керектигин көрсөтүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen doel: geef aan hoeveel maanden de buffer moet dekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak celu: określ, na ile miesięcy ma wystarczyć poduszka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem meta ainda: informe quantos meses a reserva deve cobrir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem objetivo: indique quantos meses a reserva deve cobrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель не задана: скажите, на сколько месяцев нужна подушка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳадаф ҳанӯз нест: шумораи моҳҳоеро, ки захира бояд пӯшонад, нишон диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hedef yok: Güvencenin kaç ay yeteceğini belirleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цілі ще немає: скажіть, на скільки місяців має вистачати подушки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali maqsad yo‘q: zaxira necha oyga yetishi kerakligini belgilang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置目标：请选择应急储备需覆盖的月数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定目標：請設定備用金應涵蓋的月數。"
          }
        }
      }
    },
