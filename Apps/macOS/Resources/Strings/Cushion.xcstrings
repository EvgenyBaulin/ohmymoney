    "cushion.setup.essentialHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаткі, ад якіх нельга адмовіцца. Разам з плацяжамі, падпіскамі і даўгамі яны складаюць абавязковыя выдаткі за месяц."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgaben, die nicht aufhören können. Zusammen mit Zahlungen, Abos und Schulden ergeben sie die Pflichtausgaben eines Monats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending that cannot stop. With the payments, subscriptions and debts it makes the obligatory spending of a month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto que no puede parar. Junto con los pagos, suscripciones y deudas forma el gasto obligatorio de un mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses qui ne peuvent pas s'arrêter. Avec les paiements, abonnements et dettes, elles forment les dépenses obligatoires d'un mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spese a cui non puoi rinunciare. Insieme a pagamenti, abbonamenti e debiti, costituiscono le spese obbligatorie mensili."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тоқтатуға болмайтын шығыс. Төлемдермен, жазылымдармен және берешектермен бірге ол айдың міндетті шығысын құрайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Токтотууга болбой турган чыгымдар. Алар төлөмдөр, жазылуулар жана карыздар менен бирге айлык милдеттүү чыгымдарды түзөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatki, z których nie można zrezygnować. Wraz z płatnościami, subskrypcjami i długami tworzą obowiązkowe wydatki miesięczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastos indispensáveis. Com pagamentos, assinaturas e dívidas, formam os gastos obrigatórios do mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты, без которых не обойтись. Вместе с платежами, подписками и долгами это обязательные траты месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоте, ки қатъ кардан мумкин нест. Онҳо бо пардохтҳо, обунаҳо ва қарзҳо хароҷоти ҳатмии моҳро ташкил медиҳанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeçilemeyen harcamalar. Ödemeler, abonelikler ve borçlarla birlikte aylık zorunlu harcamaları oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати, які не можна зупинити. Разом із платежами, підписками й боргами вони становлять обов'язкові витрати за місяць."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘xtatib bo‘lmaydigan xarajatlar. Ular to‘lovlar, obunalar va qarzlar bilan birga oylik majburiy xarajatlarni tashkil qiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法中斷的支出，與付款、訂閱和債務合計為每月必要支出。"
          }
        }
      }
    },
