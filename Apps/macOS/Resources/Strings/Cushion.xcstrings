          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Están marcadas las categorías esenciales habituales: revíselas y guarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories essentielles habituelles sont cochées : vérifiez-les et enregistrez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սովորական անհրաժեշտ կատեգորիաներն ընտրված են․ ստուգեք և պահեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le categorie essenziali più comuni sono selezionate: controllale e salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般的な必須カテゴリが選択されています。確認して保存してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩვეულებრივი აუცილებელი კატეგორიები მონიშნულია: შეამოწმეთ და შეინახეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі маңызды санаттар белгіленді: тексеріп, сақтаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 필수 카테고리가 선택되어 있습니다. 확인 후 저장하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаттагы зарыл категориялар белгиленди: текшерип, сактаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gebruikelijke essentiële categorieën zijn geselecteerd. Controleer ze en bewaar je keuze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczono typowe niezbędne kategorie. Sprawdź je i zachowaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias essenciais mais comuns estão selecionadas. Confira e salve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias essenciais habituais estão assinaladas: reveja-as e guarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечены обычные необходимые категории — проверьте и сохраните."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияҳои маъмулии зарурӣ интихоб шудаанд: онҳоро санҷед ва захира кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaygın temel kategoriler seçildi: Kontrol edip kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначено звичайні необхідні категорії: перевірте їх і збережіть."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatdagi zarur toifalar belgilandi. Ularni tekshiring va saqlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已勾选常见的必要支出类别，请检查后存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已勾選常見的必要類別，請確認後儲存。"
          }
        }
      }
    },
