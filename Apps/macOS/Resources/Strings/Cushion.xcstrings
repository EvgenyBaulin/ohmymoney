    "cushion.setup.suggested": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən çox istifadə olunan vacib kateqoriyalar seçilib: yoxlayın və yadda saxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Звычайныя неабходныя катэгорыі ўжо пазначаны: праверце і захавайце іх."
          }
