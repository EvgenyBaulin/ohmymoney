    "cushion.setup.essentialHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgaben, die nicht aufhören können. Zusammen mit Zahlungen, Abos und Schulden ergeben sie die Pflichtausgaben eines Monats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending that cannot stop. With the payments, subscriptions and debts it makes the obligatory spending of a month."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Траты, без которых не обойтись. Вместе с платежами, подписками и долгами это обязательные траты месяца."
          }
        }
      }
    },
