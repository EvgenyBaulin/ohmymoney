        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati insufficienti: servono 3 mesi interi di spese obbligatorie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер жеткіліксіз: міндетті шығысқа 3 толық ай керек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат жетишсиз: милдеттүү чыгымдарды эсептөө үчүн 3 толук ай керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych: potrzebne są obowiązkowe wydatki z 3 pełnych miesięcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados insuficientes: são necessários 3 meses completos de gastos obrigatórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных: для обязательных трат нужно 3 полных месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумот кофӣ нест: барои ҳисоб кардани хароҷоти ҳатмӣ 3 моҳи пурра лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli veri yok: Zorunlu harcamalar için 3 tam ay gerekli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Даних поки мало: для обов'язкових витрат потрібні 3 повні місяці."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumot yetarli emas: majburiy xarajatlar uchun 3 to‘liq oy kerak."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料不足：必要支出需要 3 個完整月份的資料。"
          }
        }
      }
    },
