          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezbędne wydatki"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необходимые траты"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel harcamalar"
          }
        },
        "uk": {
