    "inspector.closedMessage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişiklikləri yadda saxlayın və ya ləğv edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Захавайце або адхіліце іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie sie oder verwerfen Sie sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save them, or let them go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guárdelos, o descártelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez-les, ou abandonnez-les."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահեք կամ չեղարկեք դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvale o scartale."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეინახეთ ან უარყავით ცვლილებები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақтаңыз немесе алып тастаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аларды сактаңыз же жокко чыгарыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz je lub odrzuć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve ou descarte as alterações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde-as ou descarte-as."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить их или отказаться от них."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Онҳоро захира кунед ё бекор кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri kaydedin veya vazgeçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть їх або відмовтеся."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarishlarni saqlang yoki bekor qiling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存或捨棄更改。"
          }
        }
      }
    },
    "inspector.closedTitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İnspektor yadda saxlanılmamış dəyişikliklərlə bağlandı"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Інспектар закрыўся з незахаванымі зменамі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inspektor wurde mit nicht gespeicherten Änderungen geschlossen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The inspector closed with changes you have not saved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inspector se cerró con cambios sin guardar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau s'est fermé avec des modifications non enregistrées"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեսուչը փակվել է չպահված փոփոխություններով"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ispettore è stato chiuso con modifiche non salvate"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ინსპექტორი შეუნახავი ცვლილებებით დაიხურა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Инспектор сақталмаған өзгерістермен жабылды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Инспектор сакталбаган өзгөртүүлөр менен жабылды"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspektor zamknięto z niezapisanymi zmianami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O inspetor foi fechado com alterações não salvas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O inspetor foi fechado com alterações por guardar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инспектор закрылся, а изменения не сохранены"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Панели тафсилот бо тағйироти захиранашуда баста шуд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetçi, kaydedilmemiş değişikliklerle kapatıldı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інспектор закрився із незбереженими змінами"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspektor saqlanmagan o‘zgarishlar bilan yopildi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視器關閉時有未儲存的更改"
          }
        }
      }
    },
