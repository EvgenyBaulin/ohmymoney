            "state": "translated",
            "value": "⌘Z ҳама чизро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z tüm değişiklikleri geri alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z повертає все."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z hammasini qaytaradi."
