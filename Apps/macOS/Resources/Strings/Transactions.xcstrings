    "transactions.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No operations yet. Type the first one in the floating entry line at the bottom of the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay operaciones. Escriba la primera en la línea de entrada flotante de la parte inferior de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'opérations. Saisissez la première dans la ligne de saisie flottante en bas de la fenêtre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операций пока нет. Введите первую в плавающей строке ввода внизу окна."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцій ще немає. Введіть першу в плаваючому рядку вводу внизу вікна."
          }
        }
      }
    },
    "transactions.error.linkedRefundChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund cannot be more than what is left of the purchase to refund, and keeps the purchase’s currency and type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución no puede ser mayor que lo que queda de la compra por devolver, y mantiene la divisa y el tipo de la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement ne peut pas dépasser ce qui reste de l'achat à rembourser, et garde la devise et le type de l'achat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат не может быть больше того, что осталось вернуть по покупке, и остаётся в её валюте и типе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення не може бути більшим за те, що лишилося від покупки для повернення, і зберігає валюту й вид покупки."
          }
        }
      }
    },
    "transactions.error.partlyReturnedPartChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some money for this part has come back already: its amount, currency, type and “paid for someone else” stay as they are — delete that money back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya volvió parte del dinero de esta parte: su importe, divisa, tipo y «pagado por otro» se quedan como están — elimine antes ese dinero devuelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de l'argent de cette part a déjà été rendue : son montant, sa devise, son type et « payé pour quelqu'un d'autre » restent tels quels — supprimez d'abord cet argent rendu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За эту часть уже вернули часть денег: её сумма, валюта, тип и «за другого» не меняются — сначала удалите этот возврат денег."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цю частину вже частково повернули гроші: її сума, валюта, вид і «сплачено за іншого» лишаються як є — спершу видаліть повернені гроші."
          }
        }
      }
    },
    "transactions.error.purchaseHasRefunds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund takes money back from this purchase — delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución quita dinero de esta compra — elimine antes la devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement retire de l'argent à cet achat — supprimez d'abord le remboursement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По покупке оформлен возврат — сначала удалите возврат."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення забирає з цієї покупки гроші — спершу видаліть повернення."
          }
        }
      }
    },
    "transactions.error.refundExceedsRemaining": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is more than is left of the purchase to refund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es más de lo que queda de la compra por devolver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est plus que ce qui reste de l'achat à rembourser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это больше, чем осталось вернуть по покупке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це більше, ніж лишилося від покупки для повернення."
          }
        }
      }
    },
    "transactions.error.refundNotPositive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund must be more than zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución debe ser mayor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement doit être supérieur à zéro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма возврата должна быть больше нуля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення має бути більше нуля."
          }
        }
      }
    },
    "transactions.error.refundNotRefundable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This purchase cannot be refunded: it is paid for someone else, on credit, a debt payment or a goal contribution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra no se puede devolver: está pagada por otro, a crédito, es un pago de deuda o una aportación a un objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat ne peut pas être remboursé : il est payé pour quelqu'un d'autre, à crédit, un paiement de dette ou une contribution à un objectif."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту покупку нельзя вернуть: она за другого, в кредит, платёж по долгу или взнос на цель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю покупку не можна повернути: її сплачено за іншого, у кредит, як платіж за боргом або як внесок у ціль."
          }
        }
      }
    },
    "transactions.error.refundOtherCurrency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund is made in the currency of the purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución se hace en la divisa de la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement se fait dans la devise de l'achat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат делается в валюте покупки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення робиться у валюті покупки."
          }
        }
      }
    },
    "transactions.error.refundedPartChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund takes money back from this purchase: its currency, type, “paid for someone else” and credit stay as they are — delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución quita dinero de esta compra: su divisa, tipo, «pagado por otro» y crédito se quedan como están — elimine antes la devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement retire de l'argent à cet achat : sa devise, son type, « payé pour quelqu'un d'autre » et le crédit restent tels quels — supprimez d'abord le remboursement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По покупке оформлен возврат: её валюта, тип, «за другого» и «В кредит» не меняются — сначала удалите возврат."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення забирає з цієї покупки гроші: її валюта, вид, «сплачено за іншого» і кредит лишаються як є — спершу видаліть повернення."
          }
        }
      }
    },
    "transactions.error.refundedPartReduced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The part cannot be less than what its refunds already took back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte no puede ser menor de lo que ya quitaron sus devoluciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part ne peut pas être inférieure à ce que ses remboursements ont déjà retiré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть не может стать меньше того, что по ней уже вернули."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частина не може бути меншою за те, що її повернення вже забрали."
          }
        }
      }
    },
    "transactions.error.refundedPartRemoved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund takes money back from this part — delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución quita dinero de esta parte — elimine antes la devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement retire de l'argent à cette part — supprimez d'abord le remboursement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этой части покупки оформлен возврат — сначала удалите возврат."
          }
        },
        "uk": {
