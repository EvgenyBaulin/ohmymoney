    "store.failure.other": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumat bazasına yazmaq mümkün olmadı və heç nə dəyişmədi. Xəta jurnaldadır (Kömək → Problem hesabatı topla…)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць даныя ў базу. Нічога не змянілася. Памылка ў журнале (Даведка → Сабраць справаздачу аб праблеме…)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Databáze zápis nepřijala a nic se nezměnilo. Chyba je v protokolu (Nápověda → Shromáždit hlášení o problému…)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank hat die Schreibung nicht angenommen, und nichts hat sich geändert. Der Fehler steht im Journal (Hilfe → Problembericht erstellen…)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database didn’t accept the write, and nothing changed. The error is in the journal (Help → Collect a Problem Report…)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó la escritura, y no cambió nada. El error está en el diario (Ayuda → Reunir informe del problema…)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté l'écriture, et rien n'a changé. L'erreur est dans le journal (Aide → Créer un rapport de problème…)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների բազան չընդունեց գրառումը, և ոչինչ չփոխվեց։ Սխալը գրանցված է մատյանում (Օգնություն → Հավաքել խնդրի հաշվետվություն…)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database non ha accettato la scrittura. Non è stato modificato nulla. L’errore è nel registro (Aiuto → Raccogli un rapporto sul problema…)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースに書き込めなかったため、変更されませんでした。エラーはジャーナルに記録されています（ヘルプ → 問題レポートを収集…）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ბაზამ ჩანაწერი არ მიიღო და არაფერი შეცვლილა. შეცდომა ჟურნალშია (დახმარება → პრობლემის ანგარიშის შეგროვება…)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор жазуды қабылдамады, ештеңе өзгермеді. Қате журналда (Анықтама → Мәселе туралы есеп жинау…)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалыматтар базасына жазуу ишке ашкан жок, эч нерсе өзгөргөн жок. Ката журналда (Жардам → Көйгөй тууралуу отчетту чогултуу…)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De database heeft de wijziging niet geaccepteerd. Er is niets veranderd. De fout staat in het logboek (Help → Verzamel een probleemrapport…)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza danych nie przyjęła zapisu. Nic się nie zmieniło. Błąd znajduje się w dzienniku (Pomoc → Zbierz raport o problemie…)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados não aceitou a gravação e nada foi alterado. O erro está no registro (Ajuda → Coletar Relatório de Problema…)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A base de dados não aceitou a gravação e nada foi alterado. O erro está no registo (Ajuda → Recolher um relatório de problema…)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База не приняла запись — ничего не изменилось. Ошибка записана в журнал («Справка» → «Собрать отчёт о проблеме…»)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойгоҳи додаҳо сабтро қабул накард ва чизе тағйир наёфт. Хато дар журнал аст (Кумак → Ҷамъоварии гузориши мушкилот…)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanına yazılamadı ve hiçbir şey değişmedi. Hata günlüğe kaydedildi (Yardım → Sorun Raporu Topla…)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База не прийняла запис, і нічого не змінилося. Помилка є в журналі (Довідка → Зібрати звіт про проблему…)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasiga yozib bo‘lmadi, hech narsa o‘zgarmadi. Xato jurnalda (Yordam → Muammo hisobotini yig‘ish…)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据库未接受写入，未做任何更改。错误已记录在日志中（帮助 → 收集问题报告…）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫無法寫入，未更改任何內容。錯誤已記錄在日誌中（輔助說明 → 收集問題報告⋯）。"
          }
        }
      }
    },
    "store.failure.planOutdated": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulun hara yönələcəyini seçərkən bu əməliyyatlardan bəziləri başqa yerdə dəyişdirilib, buna görə köçürmə artıq onlara uyğun gəlmir. Heç nə dəyişmədi: əməliyyatları seçib dəyişikliyi yenidən edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль вы выбіралі, куды накіраваць грошы, некаторыя з гэтых аперацый змяніліся ў іншым месцы, таму перавод больш ім не адпавядае. Нічога не змянілася: выберыце аперацыі і паўтарыце змену."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé z těchto operací se během výběru cíle peněz změnily jinde, takže jim převod už neodpovídá. Nic se nezměnilo: vyberte operace a proveďte změnu znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige dieser Vorgänge haben sich anderswo geändert, während Sie wählten, wohin das Geld geht; die Überweisung passt daher nicht mehr. Nichts hat sich geändert: Wählen Sie die Vorgänge aus und machen Sie die Änderung erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of these operations changed elsewhere while you were choosing where the money goes, so the transfer no longer matches them. Nothing changed: select the operations and make the change again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas de estas operaciones cambiaron en otro sitio mientras elegía adónde va el dinero, así que la transferencia ya no les corresponde. No cambió nada: seleccione las operaciones y haga el cambio de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines de ces opérations ont changé ailleurs pendant que vous choisissiez où va l'argent, donc le virement ne leur correspond plus. Rien n'a changé : sélectionnez les opérations et refaites la modification."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչ ընտրում էիք, թե ուր փոխանցել գումարը, այս գործարքներից մի քանիսն այլ տեղում փոխվել են, ուստի փոխանցումն այլևս չի համապատասխանում դրանց։ Ոչինչ չի փոխվել․ ընտրեք գործարքները և կրկին կատարեք փոփոխությունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune operazioni sono state modificate altrove mentre sceglievi la destinazione del denaro, quindi il trasferimento non corrisponde più. Non è stato modificato nulla: seleziona le operazioni e ripeti la modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振替先を選択している間に、一部の取引が別の場所で変更されたため、振替が一致しなくなりました。変更は保存されていません。取引を選択し直して、もう一度変更してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფულის დანიშნულების არჩევისას ზოგი ოპერაცია სხვაგან შეიცვალა, ამიტომ გადარიცხვა მათ აღარ შეესაბამება. არაფერი შეცვლილა: მონიშნეთ ოპერაციები და ხელახლა შეცვალეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша қайда түсетінін таңдаған кезде кейбір операциялар басқа жерде өзгерді, сондықтан аударым оларға енді сәйкес емес. Ештеңе өзгермеді: операцияларды таңдап, өзгерісті қайталаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча кайда кетерин тандап жатканда, бул операциялардын айрымдары башка жерде өзгөргөн. Ошондуктан которуу аларга дал келбей калды. Эч нерсе өзгөргөн жок: операцияларды тандап, өзгөртүүнү кайра киргизиңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige van deze transacties zijn elders gewijzigd terwijl je koos waar het geld naartoe gaat. De overboeking komt daardoor niet meer overeen. Er is niets veranderd: selecteer de transacties en wijzig ze opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre operacje zmieniły się w innym miejscu podczas wybierania celu środków, więc przelew już do nich nie pasuje. Nic się nie zmieniło: zaznacz operacje i ponów zmianę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas dessas operações foram alteradas em outro lugar enquanto você escolhia o destino do dinheiro. Por isso, a transferência não corresponde mais a elas. Nada foi alterado: selecione as operações e faça a alteração novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas destas operações foram alteradas noutro local enquanto escolhia o destino do dinheiro, pelo que a transferência já não corresponde às mesmas. Nada foi alterado: selecione as operações e volte a fazer a alteração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы выбирали, куда перевести деньги, часть этих операций изменилась в другом месте, и перевод им больше не соответствует. Ничего не изменилось: выделите операции и повторите изменение."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми интихоби самти пул баъзе аз ин амалиёт дар ҷои дигар тағйир ёфтанд, аз ин рӯ интиқол дигар ба онҳо мувофиқат намекунад. Чизе тағйир наёфт: амалиётро интихоб кунед ва тағйиротро аз нав ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranın nereye gideceğini seçerken bu işlemlerden bazıları başka bir yerde değiştirildi. Bu yüzden transfer artık onlarla eşleşmiyor. Hiçbir şey değişmedi: İşlemleri seçip değişikliği yeniden yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі з цих операцій змінилися деінде, поки ви вибирали, куди йдуть гроші, тож переказ їм більше не відповідає. Нічого не змінено: виберіть операції й зробіть зміну знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul qayerga yo‘naltirilishini tanlayotganingizda ayrim operatsiyalar boshqa joyda o‘zgartirilgan, shuning uchun o‘tkazma endi ularga mos kelmaydi. Hech narsa o‘zgarmadi: operatsiyalarni tanlab, qayta o‘zgartiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择资金去向时，其中部分交易已在其他位置更改，因此转账不再与其匹配。未做任何更改：请重新选择交易并更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇款項去向時，部分交易已在其他位置更改，因此轉帳不再相符。未更改任何內容，請重新選取交易並進行更改。"
          }
        }
      }
    },
    "store.failure.undo": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri almaq mümkün olmadı"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося скасаваць"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se vrátit akci"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht rückgängig gemacht werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t undo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo deshacer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation impossible"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց հետարկել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile annullare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せませんでした"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერ გაუქმდა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Болдырмау мүмкін болмады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Артка кайтаруу мүмкүн болгон жок"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongedaan maken mislukt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się cofnąć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desfazer"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desfazer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить не удалось"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бекор кардан муяссар нашуд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri alınamadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося скасувати"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekor qilib bo‘lmadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法復原"
          }
        }
      }
    },
    "store.failure.undoOther": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumat bazasına yazmaq mümkün olmadı. Heç nə dəyişmədi və addım saxlanıldı: ⌘Z ilə yenidən cəhd edin. Xəta jurnaldadır (Kömək → Problem hesabatı topla…)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць даныя ў базу. Нічога не змянілася, дзеянне засталося: націсніце ⌘Z, каб паспрабаваць зноў. Памылка ў журнале (Даведка → Сабраць справаздачу аб праблеме…)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Databáze zápis nepřijala. Nic se nezměnilo a krok zůstává zachován: stisknutím ⌘Z to zkusíte znovu. Chyba je v protokolu (Nápověda → Shromáždit hlášení o problému…)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank hat die Schreibung nicht angenommen. Nichts hat sich geändert, und der Schritt bleibt: ⌘Z versucht es erneut. Der Fehler steht im Journal (Hilfe → Problembericht erstellen…)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database didn’t accept the write. Nothing changed, and the step stays: ⌘Z will try it again. The error is in the journal (Help → Collect a Problem Report…)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó la escritura. No cambió nada, y el paso se queda: ⌘Z lo volverá a intentar. El error está en el diario (Ayuda → Reunir informe del problema…)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté l'écriture. Rien n'a changé, et l'étape reste : ⌘Z la retentera. L'erreur est dans le journal (Aide → Créer un rapport de problème…)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների բազան չընդունեց գրառումը։ Ոչինչ չի փոխվել, և քայլը մնում է․ ⌘Z-ը կրկին կփորձի հետարկել այն։ Սխալը գրանցված է մատյանում (Օգնություն → Հավաքել խնդրի հաշվետվություն…)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database non ha accettato la scrittura. Non è stato modificato nulla e il passaggio resta disponibile: premi ⌘Z per riprovare. L’errore è nel registro (Aiuto → Raccogli un rapporto sul problema…)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースに書き込めなかったため、変更されませんでした。操作は取り消し履歴に残っています。⌘Zでもう一度試せます。エラーはジャーナルに記録されています（ヘルプ → 問題レポートを収集…）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ბაზამ ჩანაწერი არ მიიღო. არაფერი შეცვლილა და ნაბიჯი შენარჩუნდა: ⌘Z ხელახლა სცდის მის გაუქმებას. შეცდომა ჟურნალშია (დახმარება → პრობლემის ანგარიშის შეგროვება…)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор жазуды қабылдамады. Ештеңе өзгермеді, қадам сақталады: ⌘Z қайта әрекет етеді. Қате журналда (Анықтама → Мәселе туралы есеп жинау…)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалыматтар базасына жазуу ишке ашкан жок. Эч нерсе өзгөргөн жок, аракет тизмеде калды: ⌘Z аны кайра артка кайтарууга аракет кылат. Ката журналда (Жардам → Көйгөй тууралуу отчетту чогултуу…)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De database heeft de wijziging niet geaccepteerd. Er is niets veranderd en de stap blijft staan: met ⌘Z probeer je het opnieuw. De fout staat in het logboek (Help → Verzamel een probleemrapport…)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza danych nie przyjęła zapisu. Nic się nie zmieniło, a czynność pozostaje do cofnięcia: naciśnij ⌘Z, aby spróbować ponownie. Błąd znajduje się w dzienniku (Pomoc → Zbierz raport o problemie…)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados não aceitou a gravação. Nada foi alterado e a etapa foi mantida: ⌘Z tentará desfazê-la novamente. O erro está no registro (Ajuda → Coletar Relatório de Problema…)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A base de dados não aceitou a gravação. Nada foi alterado e a ação mantém-se: prima ⌘Z para tentar novamente. O erro está no registo (Ajuda → Recolher um relatório de problema…)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База не приняла запись. Ничего не изменилось, шаг остался: ⌘Z попробует его снова. Ошибка записана в журнал («Справка» → «Собрать отчёт о проблеме…»)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойгоҳи додаҳо сабтро қабул накард. Чизе тағйир наёфт ва қадам боқӣ монд: ⌘Z онро аз нав мекӯшад. Хато дар журнал аст (Кумак → Ҷамъоварии гузориши мушкилот…)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanına yazılamadı. Hiçbir şey değişmedi ve adım yerinde duruyor: ⌘Z ile yeniden deneyebilirsiniz. Hata günlüğe kaydedildi (Yardım → Sorun Raporu Topla…)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База не прийняла запис. Нічого не змінилося, а крок лишається: ⌘Z спробує знову. Помилка є в журналі (Довідка → Зібрати звіт про проблему…)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasiga yozib bo‘lmadi. Hech narsa o‘zgarmadi, amal bekor qilinmadi: ⌘Z bilan qayta urinib ko‘ring. Xato jurnalda (Yordam → Muammo hisobotini yig‘ish…)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据库未接受写入。未做任何更改，该步骤仍保留：按⌘Z可重试。错误已记录在日志中（帮助 → 收集问题报告…）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫無法寫入，未更改任何內容，操作仍保留。按下 ⌘Z 可再試一次。錯誤已記錄在日誌中（輔助說明 → 收集問題報告⋯）。"
          }
        }
      }
    },
    "store.failure.undoOther.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumat bazasına yazmaq mümkün olmadı. Heç nə dəyişmədi və addım saxlanıldı: “Geri al” ilə yenidən cəhd edin. Xəta jurnaldadır (Parametrlər → Kömək → Problem hesabatı topla)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць даныя ў базу. Нічога не змянілася, дзеянне засталося: націсніце “Скасаваць”, каб паспрабаваць зноў. Памылка ў журнале (Налады → Даведка → Сабраць справаздачу аб праблеме)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Databáze zápis nepřijala. Nic se nezměnilo a krok zůstává zachován: volbou „Zpět“ to zkusíte znovu. Chyba je v protokolu (Nastavení → Nápověda → Shromáždit hlášení o problému)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank hat die Schreibung nicht angenommen. Nichts hat sich geändert, und der Schritt bleibt: „Rückgängig“ versucht es erneut. Der Fehler steht im Journal (Einstellungen → Hilfe → Problembericht erstellen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database didn’t accept the write. Nothing changed, and the step stays: “Undo” will try it again. The error is in the journal (Settings → Help → Collect a Problem Report)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó la escritura. No cambió nada, y el paso se queda: «Deshacer» lo volverá a intentar. El error está en el diario (Ajustes → Ayuda → Reunir informe del problema)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté l'écriture. Rien n'a changé, et l'étape reste : « Annuler » la retentera. L'erreur est dans le journal (Réglages → Aide → Créer un rapport de problème)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների բազան չընդունեց գրառումը։ Ոչինչ չի փոխվել, և քայլը մնում է․ “Հետարկել” հրամանը կրկին կփորձի հետարկել այն։ Սխալը գրանցված է մատյանում (Կարգավորումներ → Օգնություն → Հավաքել խնդրի հաշվետվություն)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database non ha accettato la scrittura. Non è stato modificato nulla e il passaggio resta disponibile: tocca “Annulla” per riprovare. L’errore è nel registro (Impostazioni → Aiuto → Raccogli un rapporto sul problema)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースに書き込めなかったため、変更されませんでした。操作は取り消し履歴に残っています。「取り消す」でもう一度試せます。エラーはジャーナルに記録されています（設定 → ヘルプ → 問題レポートを収集）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ბაზამ ჩანაწერი არ მიიღო. არაფერი შეცვლილა და ნაბიჯი შენარჩუნდა: “გაუქმება” ხელახლა სცდის მის გაუქმებას. შეცდომა ჟურნალშია (პარამეტრები → დახმარება → პრობლემის ანგარიშის შეგროვება)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор жазуды қабылдамады. Ештеңе өзгермеді, қадам сақталады: “Болдырмау” қайта әрекет етеді. Қате журналда (Баптаулар → Анықтама → Мәселе туралы есеп жинау)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалыматтар базасына жазуу ишке ашкан жок. Эч нерсе өзгөргөн жок, аракет тизмеде калды: «Артка кайтаруу» аны кайра артка кайтарууга аракет кылат. Ката журналда (Жөндөөлөр → Жардам → Көйгөй тууралуу отчетту чогултуу)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De database heeft de wijziging niet geaccepteerd. Er is niets veranderd en de stap blijft staan: met ‘Herstel’ probeer je het opnieuw. De fout staat in het logboek (Instellingen → Help → Verzamel een probleemrapport)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza danych nie przyjęła zapisu. Nic się nie zmieniło, a czynność pozostaje do cofnięcia: stuknij „Cofnij”, aby spróbować ponownie. Błąd znajduje się w dzienniku (Ustawienia → Pomoc → Zbierz raport o problemie)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados não aceitou a gravação. Nada foi alterado e a etapa foi mantida: “Desfazer” tentará desfazê-la novamente. O erro está no registro (Ajustes → Ajuda → Coletar Relatório de Problema)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A base de dados não aceitou a gravação. Nada foi alterado e a ação mantém-se: toque em “Desfazer” para tentar novamente. O erro está no registo (Definições → Ajuda → Recolher um relatório de problema)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База не приняла запись. Ничего не изменилось, шаг остался: «Отменить» попробует его снова. Ошибка записана в журнал."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойгоҳи додаҳо сабтро қабул накард. Чизе тағйир наёфт ва қадам боқӣ монд: “Бекор кардан” онро аз нав мекӯшад. Хато дар журнал аст (Танзимот → Кумак → Ҷамъоварии гузориши мушкилот)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanına yazılamadı. Hiçbir şey değişmedi ve adım yerinde duruyor: “Geri Al” ile yeniden deneyebilirsiniz. Hata günlüğe kaydedildi (Ayarlar → Yardım → Sorun Raporu Topla)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База не прийняла запис. Нічого не змінилося, а крок лишається: «Скасувати» спробує знову. Помилка є в журналі (Налаштування → Довідка → Зібрати звіт про проблему)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasiga yozib bo‘lmadi. Hech narsa o‘zgarmadi, amal bekor qilinmadi: “Bekor qilish” bilan qayta urinib ko‘ring. Xato jurnalda (Sozlamalar → Yordam → Muammo hisobotini yig‘ish)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据库未接受写入。未做任何更改，该步骤仍保留：轻点“撤销”可重试。错误已记录在日志中（设置 → 帮助 → 收集问题报告）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫無法寫入，未更改任何內容，操作仍保留。點一下「復原」可再試一次。錯誤已記錄在日誌中（設定 → 輔助說明 → 收集問題報告）。"
          }
        }
      }
    },
    "store.failure.undoTied": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonrakı dəyişikliklərdən biri bu addımdan asılıdır — məsələn, əməliyyat bu addımda yaradılmış kateqoriyaya aid edilib — və ya bu addım sonradan silinmiş elementə istinad edən bir şeyi bərpa edir. Heç nə dəyişmədi və addım saxlanıldı: əvvəlcə bunu düzəldin, sonra yenidən geri alın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ад гэтага дзеяння залежыць штосьці зробленае пазней — напрыклад, аперацыя ў створанай ім катэгорыі. Або дзеянне вяртае элемент, які спасылаецца на выдалены пазней элемент. Нічога не змянілася, дзеянне засталося: выпраўце гэта і паспрабуйце скасаваць зноў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto kroku závisí některá pozdější akce — například operace zařazená do kategorie, kterou tento krok vytvořil — nebo by tento krok obnovil položku odkazující na něco, co už bylo smazáno. Nic se nezměnilo a krok zůstává zachován: nejprve to vyřešte a pak zkuste akci vrátit znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas, das danach getan wurde, hängt von diesem Schritt ab — zum Beispiel wurde ein Vorgang unter einer Kategorie eingeordnet, die er selbst angelegt hat —, oder der Schritt bringt etwas zurück, das auf ein seither gelöschtes Ding zeigt. Nichts hat sich geändert, und der Schritt bleibt: Klären Sie das, dann machen Sie erneut rückgängig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something done since depends on this step — for example, an operation was filed under a category it created — or the step brings back something that points at a thing deleted since. Nothing changed, and the step stays: sort that out, then undo again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo hecho después depende de este paso — por ejemplo, una operación se archivó en una categoría que ese paso creó — o el paso devuelve algo que apunta a una cosa eliminada desde entonces. No cambió nada, y el paso se queda: resuelva eso y deshaga de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose fait depuis dépend de cette étape — par exemple, une opération a été classée dans une catégorie qu'elle avait créée — ou l'étape rétablirait quelque chose qui renvoie à un élément supprimé depuis. Rien n'a changé, et l'étape reste : réglez cela, puis annulez à nouveau."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հետագայում կատարված որևէ գործողություն կախված է այս քայլից, օրինակ՝ գործարքը ավելացվել է այս քայլով ստեղծված կատեգորիայում, կամ այս քայլը վերականգնում է մի բան, որը հղվում է ավելի ուշ ջնջված տվյալների։ Ոչինչ չի փոխվել, և քայլը մնում է․ նախ լուծեք խնդիրը, ապա կրկին հետարկեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’azione successiva dipende da questo passaggio, ad esempio un’operazione è stata assegnata a una categoria che ha creato, oppure il passaggio ripristina un elemento che ne indica uno eliminato in seguito. Non è stato modificato nulla e il passaggio resta disponibile: risolvi il problema, poi riprova ad annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作に依存する操作が後で行われたか（作成したカテゴリに取引が追加された場合など）、取り消すと、その後削除された項目を参照するデータが復元されます。変更は保存されず、操作は取り消し履歴に残っています。問題を解決してから、もう一度取り消してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ნაბიჯზე დამოკიდებულია მოგვიანებით შესრულებული მოქმედება — მაგალითად, მის მიერ შექმნილ კატეგორიას ოპერაცია მიაკუთვნეთ — ან ამ ნაბიჯის გაუქმება აღადგენს ჩანაწერს, რომელიც მოგვიანებით წაშლილ ელემენტს უკავშირდება. არაფერი შეცვლილა და ნაბიჯი შენარჩუნდა: ჯერ მოაგვარეთ ეს და შემდეგ ხელახლა გააუქმეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейін жасалған әрекет осы қадамға тәуелді — мысалы, операция осы қадам жасаған санатқа тіркелген — немесе қадам кейін жойылған нысанға сілтейтін жазбаны қайтарады. Ештеңе өзгермеді, қадам сақталады: тәуелділікті шешіп, қайта болдырмаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кийинки аракеттердин бири бул кадамга көз каранды — мисалы, операция ал түзгөн категорияга кошулган — же бул кадам кийин өчүрүлгөн нерсеге шилтеме берген нерсени калыбына келтирет. Эч нерсе өзгөргөн жок, аракет тизмеде калды: адегенде муну чечип, анан кайра артка кайтарыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een latere wijziging is afhankelijk van deze stap, bijvoorbeeld een transactie die is ingedeeld bij een categorie die met deze stap is aangemaakt. Of deze stap herstelt iets dat verwijst naar iets wat later is verwijderd. Er is niets veranderd en de stap blijft staan: los dit op en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Późniejsza czynność zależy od tej czynności — na przykład operację przypisano do utworzonej w niej kategorii — lub jej cofnięcie przywróciłoby odwołanie do usuniętego później elementu. Nic się nie zmieniło, a czynność pozostaje do cofnięcia. Usuń zależność i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ação posterior depende desta etapa — por exemplo, uma operação foi atribuída a uma categoria criada por ela — ou a etapa restaura algo que faz referência a um item apagado depois. Nada foi alterado e a etapa foi mantida: resolva isso e tente desfazer novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ação posterior depende desta — por exemplo, uma operação foi atribuída a uma categoria criada por esta ação — ou esta ação restaura algo que aponta para um elemento entretanto apagado. Nada foi alterado e a ação mantém-se: resolva a situação e volte a desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От этого шага зависит сделанное позже — например, на созданную им категорию уже записана операция, — или он возвращает то, что ссылается на удалённое с тех пор. Ничего не изменилось, шаг остался: уладьте это и отмените снова."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амали баъдӣ аз ин қадам вобаста аст — масалан, амалиёт ба категорияи дар ин қадам сохташуда дохил шудааст — ё ин қадам чизеро бармегардонад, ки ба чизи баъдтар нестшуда ишора мекунад. Чизе тағйир наёфт ва қадам боқӣ монд: аввал инро ҳал кунед, сипас аз нав бекор кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki bir işlem bu adıma bağlı. Örneğin, bir işlem bu adımda oluşturulan bir kategoriye eklenmiş olabilir. Ya da bu adım, daha sonra silinmiş bir öğeye başvuran bir şeyi geri getiriyor olabilir. Hiçbir şey değişmedi ve adım yerinde duruyor: Önce bunu düzeltin, ardından yeniden geri alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від цього кроку вже щось залежить — наприклад, операцію віднесено до категорії, яку він створив, — або крок повертає щось, що вказує на річ, видалену відтоді. Нічого не змінилося, а крок лишається: розберіться з цим і скасуйте знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyingi amallardan biri shu amalga bog‘liq — masalan, operatsiya shu amal yaratgan kategoriyaga kiritilgan — yoki bu amal keyinroq o‘chirilgan narsaga havola qiluvchi ma’lumotni tiklaydi. Hech narsa o‘zgarmadi, amal bekor qilinmadi: avval buni hal qiling, so‘ng qayta urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此后的操作依赖于该步骤，例如交易被归入该步骤创建的类别；或者该步骤会恢复指向后来已删除项目的内容。未做任何更改，该步骤仍保留：请先解决这些问题，再重新撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後的操作相依於此步驟，例如將交易歸入此步驟建立的類別；或者此步驟會還原參照了後來已刪除項目的內容。未更改任何內容，操作仍保留。請先解決問題，再試一次復原。"
          }
        }
      }
    },
