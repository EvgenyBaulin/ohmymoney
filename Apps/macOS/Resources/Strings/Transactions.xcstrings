    "inspector.unsavedMessage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa əməliyyat açılır. Yadda saxlanılmamış dəyişikliklər itiriləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрываецца іншая аперацыя. Незахаваныя змены будуць страчаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Vorgang wird geöffnet. Nicht gespeicherte Änderungen gehen verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another operation is being opened. Changes that are not saved will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está abriendo otra operación. Los cambios que no se guarden se perderán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre opération est en train d'être ouverte. Les modifications non enregistrées seront perdues."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացվում է մեկ այլ գործարք։ Չպահված փոփոխությունները կկորչեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai aprendo un'altra operazione. Le modifiche non salvate andranno perse."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იხსნება სხვა ოპერაცია. შეუნახავი ცვლილებები დაიკარგება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа операция ашылуда. Сақталмаған өзгерістер жоғалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Башка операция ачылууда. Сакталбаган өзгөртүүлөр жоголот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwierana jest inna operacja. Niezapisane zmiany zostaną utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra operação está sendo aberta. As alterações não salvas serão perdidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a ser aberta outra operação. As alterações não guardadas serão perdidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывается другая операция. Несохранённые правки пропадут."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёти дигар кушода мешавад. Тағйироти захиранашуда гум мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir işlem açılıyor. Kaydedilmemiş değişiklikler kaybolacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривається інша операція. Незбережені зміни буде втрачено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa amal ochilmoqda. Saqlanmagan o‘zgarishlar yo‘qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即將開啟另一筆交易，未儲存的更改將會遺失。"
          }
        }
      }
    },
    "inspector.unsavedTitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu əməliyyatda dəyişikliklər yadda saxlanılsın?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Захаваць змены ў гэтай аперацыі?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderungen an diesem Vorgang speichern?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the changes to this operation?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Guardar los cambios de esta operación?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer les modifications de cette opération ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահե՞լ այս գործարքի փոփոխությունները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi salvare le modifiche a questa operazione?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეინახოთ ამ ოპერაციის ცვლილებები?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы операцияның өзгерістерін сақтау керек пе?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул операциядагы өзгөртүүлөр сакталсынбы?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachować zmiany w tej operacji?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar as alterações desta operação?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar as alterações a esta operação?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить правки этой операции?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйироти ин амалиёт захира карда шаванд?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemdeki değişiklikler kaydedilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти зміни цієї операції?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu amaldagi o‘zgarishlar saqlansinmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要儲存對此交易的更改嗎？"
          }
        }
      }
    },
    "operations.chip.all": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
