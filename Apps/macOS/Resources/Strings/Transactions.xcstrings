    "store.failure.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database didn’t accept the write, and nothing changed. The error is in the journal (Help → Collect a Problem Report…)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó la escritura, y no cambió nada. El error está en el diario (Ayuda → Reunir informe del problema…)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté l'écriture, et rien n'a changé. L'erreur est dans le journal (Aide → Créer un rapport de problème…)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База не приняла запись — ничего не изменилось. Ошибка записана в журнал («Справка» → «Собрать отчёт о проблеме…»)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База не прийняла запис, і нічого не змінилося. Помилка є в журналі (Довідка → Зібрати звіт про проблему…)."
          }
        }
      }
    },
    "store.failure.planOutdated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of these operations changed elsewhere while you were choosing where the money goes, so the transfer no longer matches them. Nothing changed: select the operations and make the change again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas de estas operaciones cambiaron en otro sitio mientras elegía adónde va el dinero, así que la transferencia ya no les corresponde. No cambió nada: seleccione las operaciones y haga el cambio de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines de ces opérations ont changé ailleurs pendant que vous choisissiez où va l'argent, donc le virement ne leur correspond plus. Rien n'a changé : sélectionnez les opérations et refaites la modification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы выбирали, куда перевести деньги, часть этих операций изменилась в другом месте, и перевод им больше не соответствует. Ничего не изменилось: выделите операции и повторите изменение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі з цих операцій змінилися деінде, поки ви вибирали, куди йдуть гроші, тож переказ їм більше не відповідає. Нічого не змінено: виберіть операції й зробіть зміну знову."
          }
        }
      }
    },
    "store.failure.undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t undo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo deshacer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation impossible"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить не удалось"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося скасувати"
          }
        }
      }
    },
    "store.failure.undoOther": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database didn’t accept the write. Nothing changed, and the step stays: ⌘Z will try it again. The error is in the journal (Help → Collect a Problem Report…)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó la escritura. No cambió nada, y el paso se queda: ⌘Z lo volverá a intentar. El error está en el diario (Ayuda → Reunir informe del problema…)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté l'écriture. Rien n'a changé, et l'étape reste : ⌘Z la retentera. L'erreur est dans le journal (Aide → Créer un rapport de problème…)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База не приняла запись. Ничего не изменилось, шаг остался: ⌘Z попробует его снова. Ошибка записана в журнал («Справка» → «Собрать отчёт о проблеме…»)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База не прийняла запис. Нічого не змінилося, а крок лишається: ⌘Z спробує знову. Помилка є в журналі (Довідка → Зібрати звіт про проблему…)."
          }
        }
      }
    },
    "store.failure.undoOther.touch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database didn’t accept the write. Nothing changed, and the step stays: “Undo” will try it again. The error is in the journal (Settings → Help → Collect a Problem Report)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó la escritura. No cambió nada, y el paso se queda: «Deshacer» lo volverá a intentar. El error está en el diario (Ajustes → Ayuda → Reunir informe del problema)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté l'écriture. Rien n'a changé, et l'étape reste : « Annuler » la retentera. L'erreur est dans le journal (Réglages → Aide → Créer un rapport de problème)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База не приняла запись. Ничего не изменилось, шаг остался: «Отменить» попробует его снова. Ошибка записана в журнал."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База не прийняла запис. Нічого не змінилося, а крок лишається: «Скасувати» спробує знову. Помилка є в журналі (Налаштування → Довідка → Зібрати звіт про проблему)."
          }
        }
      }
    },
    "store.failure.undoTied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something done since depends on this step — for example, an operation was filed under a category it created — or the step brings back something that points at a thing deleted since. Nothing changed, and the step stays: sort that out, then undo again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo hecho después depende de este paso — por ejemplo, una operación se archivó en una categoría que ese paso creó — o el paso devuelve algo que apunta a una cosa eliminada desde entonces. No cambió nada, y el paso se queda: resuelva eso y deshaga de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose fait depuis dépend de cette étape — par exemple, une opération a été classée dans une catégorie qu'elle avait créée — ou l'étape rétablirait quelque chose qui renvoie à un élément supprimé depuis. Rien n'a changé, et l'étape reste : réglez cela, puis annulez à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От этого шага зависит сделанное позже — например, на созданную им категорию уже записана операция, — или он возвращает то, что ссылается на удалённое с тех пор. Ничего не изменилось, шаг остался: уладьте это и отмените снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від цього кроку вже щось залежить — наприклад, операцію віднесено до категорії, яку він створив, — або крок повертає щось, що вказує на річ, видалену відтоді. Нічого не змінилося, а крок лишається: розберіться з цим і скасуйте знову."
          }
        }
      }
    },
