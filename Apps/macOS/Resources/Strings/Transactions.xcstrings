    "inspector.closedMessage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişiklikləri yadda saxlayın və ya ləğv edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Захавайце або адхіліце іх."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte je, nebo zahoďte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie sie oder verwerfen Sie sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save them, or let them go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guárdelos, o descártelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez-les, ou abandonnez-les."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահեք կամ չեղարկեք դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvale o scartale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存するか、変更を破棄してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეინახეთ ან უარყავით ცვლილებები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақтаңыз немесе алып тастаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аларды сактаңыз же жокко чыгарыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de wijzigingen of negeer ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz je lub odrzuć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve ou descarte as alterações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde-as ou descarte-as."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить их или отказаться от них."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Онҳоро захира кунед ё бекор кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri kaydedin veya vazgeçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть їх або відмовтеся."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarishlarni saqlang yoki bekor qiling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储更改，或放弃更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存或捨棄更改。"
          }
        }
      }
    },
    "inspector.closedTitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İnspektor yadda saxlanılmamış dəyişikliklərlə bağlandı"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Інспектар закрыўся з незахаванымі зменамі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspektor byl zavřen s neuloženými změnami"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inspektor wurde mit nicht gespeicherten Änderungen geschlossen"
          }
        },
        "en": {
