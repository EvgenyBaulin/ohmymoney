        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desfazer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить не удалось"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бекор кардан муяссар нашуд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri alınamadı"
          }
