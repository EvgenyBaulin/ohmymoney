    "transactions.transfers.feesDeleted": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onların komissiyaları, %@, da silinir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Іх камісіі, %@, будуць выдалены разам з імі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S nimi se smažou i jejich poplatky ve výši %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Gebühren, %@, werden mit ihnen gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their fees, %@, are deleted with them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus comisiones, %@, se eliminan con ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs frais, %@, sont supprimés avec eux."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դրանց միջնորդավճարները՝ %@, նույնպես կջնջվեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le relative commissioni, %@, vengono eliminate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手数料%@も一緒に削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მათი საკომისიო, %@, მათთან ერთად წაიშლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Олармен бірге %@ комиссиялары да жойылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алардын комиссиялары, %@, кошо өчүрүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bijbehorende kosten, %@, worden ook verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiązane opłaty, %@, również zostaną usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarifas, %@, serão apagadas junto com elas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As respetivas comissões, %@, são apagadas juntamente com as transferências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их комиссии, %@, удаляются вместе с ними."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳаққи хидмати онҳо, %@, ҳамроҳашон нест карда мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tutarındaki ücretleri de onlarla birlikte silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їхні комісії, %@, видаляються разом із ними."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ularning %@ miqdoridagi komissiyasi ham o‘chiriladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其手续费%@也将一并删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相關手續費 %@ 也會一併刪除。"
          }
        }
      }
    },
