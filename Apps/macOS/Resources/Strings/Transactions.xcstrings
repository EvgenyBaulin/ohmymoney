            "value": "Kun jami"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当日合计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當日總計"
          }
        }
      }
    },
