        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "„გაუქმება“ ყველაფერს აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“Болдырмау” бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“Артка кайтаруу” баарын калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Cofnij” cofa wszystkie zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Desfazer” reverte todas as alterações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Desfazer” repõe tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отменить» вернёт всё обратно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "“Бекор кардан” ҳама чизро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
