    "transactions.dataStale": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlar yenilənmədi — %@ tarixindəki vəziyyət göstərilir · yenidən cəhd üçün ⌘R"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даныя не абноўлены — паказаны стан на %@ · ⌘R, каб паспрабаваць зноў"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data se nepodařilo aktualizovat — zobrazen stav k %@ · zkuste to znovu stisknutím ⌘R"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten wurden nicht aktualisiert — angezeigt Stand %@ · ⌘R zum erneuten Versuch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data was not refreshed — showing it as of %@ · ⌘R to retry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos no se actualizaron — se muestran a fecha de %@ · ⌘R para reintentar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données n'ont pas été actualisées — affichées au %@ · ⌘R pour réessayer"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալները չեն թարմացվել․ ցուցադրվում են %@ դրությամբ · ⌘R՝ կրկին փորձելու համար"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati non aggiornati: mostrati al %@ · ⌘R per riprovare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを更新できませんでした — %@時点のデータを表示中 · ⌘Rで再試行"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემები არ განახლებულა — ნაჩვენებია %@ მდგომარეობით · ხელახლა საცდელად დააჭირეთ ⌘R"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деректер жаңармады — %@ кезіндегі көрініс · қайталау үшін ⌘R"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат жаңыртылган жок — %@ учурундагы абалы көрсөтүлүүдө · кайра аракет кылуу үчүн ⌘R"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens zijn niet bijgewerkt. Weergave van %@ · ⌘R om opnieuw te proberen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie odświeżono danych — stan na %@ · ⌘R, aby spróbować ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados não foram atualizados — exibindo dados de %@ · ⌘R para tentar novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados não foram atualizados — apresentados à data de %@ · ⌘R para tentar novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные не обновились — показаны на %@ · ⌘R — повторить"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Додаҳо нав нашуданд — ҳолати %@ нишон дода мешавад · ⌘R барои кӯшиши дубора"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler yenilenmedi — %@ tarihindeki veriler gösteriliyor · Yeniden denemek için ⌘R"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані не оновлювалися — показано станом на %@ · ⌘R, щоб спробувати знову"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar yangilanmadi — %@ holatiga ko‘rsatilmoqda · qayta urinish uchun ⌘R"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据未刷新，显示的是%@时的数据 · 按⌘R重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料未重新整理，顯示截至 %@ 的資料 · 按 ⌘R 再試一次"
          }
        }
      }
    },
