    "operations.columns.resetHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Standart sütunlar, onların sırası və eni bərpa edilir, filtrlər və axtarış sıfırlanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартныя слупкі, іх парадак і шырыня, без фільтраў і пошуку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardspalten, ihre Reihenfolge und Breiten, ohne Filter und Suche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The standard columns, their order and widths, and no filters or search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las columnas estándar, su orden y anchuras, y sin filtros ni búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les colonnes standard, leur ordre et leurs largeurs, sans filtres ni recherche."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստանդարտ սյունակներ, դրանց հերթականությունն ու լայնությունը՝ առանց զտիչների և որոնման։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina le colonne standard, il loro ordine e la loro larghezza e rimuove filtri e ricerca."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სტანდარტული სვეტები, მათი რიგი და სიგანე; ფილტრებისა და ძებნის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартты бағандар, олардың реті мен ені, сүзгілер мен іздеусіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандарттык мамычалар, алардын тартиби жана туурасы калыбына келтирилет, чыпкалар менен издөө тазаланат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca domyślne kolumny, ich kolejność i szerokość oraz usuwa filtry i wyszukiwanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura as colunas, a ordem e a largura padrão e remove os filtros e a busca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe as colunas, a ordem e as larguras predefinidas e limpa os filtros e a pesquisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычные столбцы, их порядок и ширина, без фильтров и поиска."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сутунҳои стандартӣ, тартиб ва паҳнои онҳо барқарор шуда, филтрҳо ва ҷустуҷӯ пок мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standart sütunları, sıralarını ve genişliklerini geri yükler; filtreleri ve aramayı temizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартні колонки, їхній порядок і ширина, без фільтрів і пошуку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Standart ustunlar, ularning tartibi va kengligi tiklanadi, filtrlar va qidiruv tozalanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原標準欄位、順序和寬度，並清除篩選條件和搜尋。"
          }
        }
      }
    },
