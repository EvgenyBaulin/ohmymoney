    "bulk.reason.closedByReimbursement": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "bir hissəsinin pulu qaytarılıb — əvvəlcə həmin qaytarmanı silin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "за частку вернуты грошы — спачатку выдаліце гэтае вяртанне"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "za část byly vráceny peníze – nejprve smažte jejich vrácení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "für einen Teil davon wurde Geld zurückgegeben — löschen Sie zuerst diese Rückzahlung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "money was given back for a part of it — delete that reimbursement first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "por una de sus partes ya se devolvió dinero — elimine antes esa devolución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "de l'argent a été rendu pour une de ses parts — supprimez d'abord ce remboursement"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "մի մասի գումարը վերադարձվել է. նախ ջնջեք վերադարձը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "una parte è stata rimborsata: elimina prima il rimborso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部が返金済みです。先にその返金を削除してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი ნაწილისთვის თანხა დაბრუნდა — ჯერ ეს დაბრუნება წაშალეთ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "бір бөлігіне ақша қайтарылған — алдымен сол қайтаруды жойыңыз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "бир бөлүгүнүн акчасы кайтарылган — адегенде ошол кайтарууну өчүрүңүз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "een deel is terugbetaald — verwijder eerst de terugbetaling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zwrócono pieniądze za część operacji — najpierw usuń ten zwrot"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "uma parte foi devolvida — apague a devolução primeiro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "foi devolvido dinheiro por uma parte — apague primeiro esse reembolso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "за часть уже вернули деньги — сначала удалите этот возврат"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "маблағи як қисми он баргардонда шудааст — аввал он баргардониданро нест кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bir kısmı için para geri verildi; önce bu geri ödemeyi silin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "за частину з нього повернули гроші — спершу видаліть це повернення"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "bir qismi uchun pul qaytarilgan — avval pul qaytarilishini o‘chiring"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分款项已退还，请先删除该笔退款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一部分已獲還款，請先刪除該筆還款"
          }
        }
      }
    },
    "bulk.reason.creditPurchase": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "kreditlə alınıb — Borclar bölməsində dəyişdirilir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "куплена ў крэдыт — змяняецца ў раздзеле «Даўгі»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "nákup na úvěr – mění se v Dluzích"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "auf Kredit gekauft — geändert unter „Schulden“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "bought on credit — changed in Debts"
