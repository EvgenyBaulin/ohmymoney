    "bulk.deleteAndReopen": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sil və «%@» borcunu yenidən aç"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаліць і зноў адкрыць доўг «%@»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuld „%@“ löschen und wieder öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete and Reopen the Debt «%@»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar y reabrir la deuda «%@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer et rouvrir la dette « %@ »"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջել և կրկին բացել «%@» պարտքը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina e riapri il debito «%@»"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წაშლა და ვალის «%@» ხელახლა გახსნა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жою және «%@» қарызын қайта ашу"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» карызын өчүрүп, кайра ачуу"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń i otwórz ponownie dług «%@»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar e Reabrir a Dívida «%@»"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar e reabrir a dívida «%@»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить и открыть долг «%@»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нест кардан ва боз кушодани қарзи «%@»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» Borcunu Sil ve Yeniden Aç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити й відкрити знову борг «%@»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘chirish va «%@» qarzini qayta ochish"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除並重新開啟債務 «%@»"
          }
        }
      }
    },
    "bulk.deleteClosedDebt": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödəniş borcu bağlayıb: %@. Ödəniş silindikdə borc yenidən yaranacaq, lakin siz onu yenidən açmasanız, bağlı qalacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацёж закрыў доўг: %@. Пасля выдалення плацяжу доўг зноў будзе нявыплачаны, але застанецца закрытым, пакуль вы яго не адкрыеце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung hat eine Schuld beendet: %@. Wird sie gelöscht, ist wieder Geld darauf geschuldet, und die Schuld bleibt beendet, bis Sie sie wieder öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment closed a debt: %@. Once it is deleted money is owed on it again, and the debt stays closed unless you reopen it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago cerró una deuda: %@. Una vez eliminado, vuelve a deberse dinero en ella, y la deuda se queda cerrada salvo que la reabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement a clôturé une dette : %@. Une fois supprimé, de l'argent est de nouveau dû dessus, et la dette reste clôturée tant que vous ne la rouvrez pas."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարումը փակել է պարտքը՝ %@։ Այն ջնջելուց հետո գումարը կրկին պարտք կլինի, բայց պարտքը փակ կմնա, մինչև այն կրկին բացեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento ha chiuso un debito: %@. Se lo elimini, l'importo sarà di nuovo dovuto, ma il debito resterà chiuso finché non lo riapri."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ გადახდით დაიფარა ვალი: %@. წაშლის შემდეგ თანხა ისევ გადასახდელი იქნება, თუმცა ვალი დახურული დარჩება, თუ ხელახლა არ გახსნით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлем қарызды жапқан: %@. Оны жойған соң қайтадан берешек пайда болады, ал қайта ашпасаңыз, қарыз жабық қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төлөм карызды жапкан: %@. Төлөм өчүрүлгөндөн кийин карыз кайра пайда болот, бирок аны кайра ачмайынча жабык бойдон калат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta spłata zamknęła dług: %@. Po jej usunięciu kwota znów będzie do spłaty, ale dług pozostanie zamknięty, dopóki nie otworzysz go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento quitou uma dívida: %@. Ao apagá-lo, o valor volta a ser devido, mas a dívida permanece encerrada até que você a reabra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento liquidou uma dívida: %@. Se o apagar, o valor volta a estar em dívida, mas a dívida permanece fechada até a reabrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёж закрыл долг: %@. После удаления по нему снова должны, а сам долг останется закрытым, если его не открыть."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин пардохт қарзро пӯшонд: %@. Пас аз нест кардани он, маблағ боз қарздор мешавад, аммо қарз то боз кушоданаш пӯшида мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ödeme bir borcu kapattı: %@. Ödeme silinirse borç yeniden doğar ve yeniden açılmadığı sürece kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж закрив борг: %@. Щойно його видалять, гроші знову будуть винні за ним, і борг лишиться закритим, доки його не відкриють знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu to‘lov qarzni yopgan: %@. To‘lov o‘chirilsa, qarz yana mavjud bo‘ladi, ammo qayta ochilmaguncha yopiq qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆付款已結清債務：%@。刪除後，該債務將再次出現欠款，但除非重新開啟，否則仍會保持結清。"
          }
        }
      }
    },
    "bulk.deleteDebtPayment": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borc ödənişləri müvafiq borclardan da silinir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Плацяжы па даўгах таксама выдаляюцца з адпаведных даўгоў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen auf Schulden werden auch von ihren Schulden abgezogen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payments on debts are taken off their debts too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pagos de deudas también se quitan de sus deudas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements de dettes sont aussi retirés de leurs dettes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պարտքերի վճարումները ջնջվում են նաև դրանց պարտքերից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pagamenti dei debiti vengono rimossi anche dai relativi debiti."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალის გადახდები შესაბამის ვალებსაც მოაკლდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қарыз төлемдері қарыздарынан да алынады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карыз төлөмдөрү тиешелүү карыздардан да алынат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spłaty zostaną też usunięte z powiązanych długów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pagamentos de dívidas também são removidos delas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pagamentos de dívidas também são removidos das respetivas dívidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежи по долгам снимаются и с самих долгов."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пардохтҳои қарз аз қарзҳои дахлдор низ хориҷ мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borç ödemeleri ilgili borçlardan da düşülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежі за боргами також знімаються з цих боргів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarz to‘lovlari tegishli qarzlardan ham ayiriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "債務付款也會從對應的債務中移除。"
          }
        }
      }
    },
    "bulk.deleteReimbursement": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytarılan pulla birlikdə onun artığı və ya əskikliyi də silinir, bağladığı hissələr isə yenidən qaytarılmağı gözləyir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разам з вернутымі грашыма выдаляецца іх лішак або нястача, а закрытыя імі часткі зноў чакаюць вяртання."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgegebenes Geld nimmt seinen Überschuss oder Fehlbetrag mit, und die Teile, die es beendet hat, warten darauf, erneut zurückgezahlt zu werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money given back takes its surplus or shortfall along, and the parts it closed wait to be paid back again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero devuelto arrastra su excedente o déficit, y las partes que cerró vuelven a esperar su devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent rendu entraîne avec lui son surplus ou son manque, et les parts qu'il a clôturées attendent de nouveau d'être remboursées."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերադարձված գումարի հետ ջնջվում է նաև դրա ավելցուկը կամ պակասուրդը, իսկ դրանով փակված մասերը կրկին սպասում են վերադարձի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rimborso viene eliminato insieme all'eventuale eccedenza o differenza e le parti che aveva saldato tornano da rimborsare."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაბრუნებულ თანხასთან ერთად წაიშლება მისი ზედმეტობა ან დანაკლისიც, მის მიერ დაფარული ნაწილები კი ისევ დასაბრუნებელი გახდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтарылған ақшамен бірге артық не кем сома да алынады, ал жапқан бөліктері қайта қайтаруды күтеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кайтарылган акчанын ашыгы же кеми да кошо өчүрүлөт, ал эми ал жапкан бөлүктөр кайра кайтарууну күтөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie zwrotu usuwa też jego nadwyżkę lub niedobór. Rozliczone nim części znów będą oczekiwać na zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao remover a devolução, seu excedente ou valor faltante também é removido, e as partes que ela quitou voltam a aguardar pagamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao remover o dinheiro devolvido, o excedente ou valor em falta também é removido e as partes que liquidou voltam a aguardar reembolso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с возвратом денег удалятся его излишек или недостача, а закрытые им части снова будут ждать возврата."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми нест кардани маблағи баргардондашуда, барзиёдӣ ё камомади он низ нест мешавад ва қисмҳои пӯшидааш боз интизори баргардонидан мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri verilen para, fazlası veya eksiğiyle birlikte silinir ve kapattığı kısımlar yeniden ödenmeyi bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернені гроші забирають із собою свій надлишок чи нестачу, а частини, які вони закрили, знову чекають на повернення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytarilgan pul bilan uning ortiqcha yoki kam summasi ham o‘chiriladi, u qoplagan qismlar esa yana qaytarilishini kutadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除還款時，相關的多付或少付金額也會一併移除，已還清的部分將重新等待還款。"
          }
        }
      }
    },
