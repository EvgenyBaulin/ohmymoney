        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "эсептен алына турган сумманы эсептөөгө курс жок"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "er is nog geen koers om het afgeschreven bedrag te berekenen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "brak kursu potrzebnego do obliczenia kwoty obciążenia konta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ainda não há taxa para calcular o valor debitado da conta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "ainda não há taxa para calcular o valor debitado na conta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ещё нет курса, чтобы посчитать, сколько списано со счёта"
