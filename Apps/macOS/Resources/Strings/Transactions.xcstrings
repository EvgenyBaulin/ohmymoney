    "operations.columns.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Якія слупкі паказваць, у якім парадку і якой шырыні. Перацягніце радок або скарыстайцеся стрэлкамі, каб перамясціць яго. Апісанне і сума паказваюцца заўсёды."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Spalten gezeigt werden, in welcher Reihenfolge und wie breit. Ziehen Sie eine Zeile oder verschieben Sie sie mit den Pfeilen. Beschreibung und Betrag werden immer gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which columns are shown, in what order and how wide. Drag a row or use the arrows to move it. The description and the amount are always shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué columnas se muestran, en qué orden y con qué anchura. Arrastre una fila o use las flechas para moverla. La descripción y el importe siempre se muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelles colonnes sont affichées, dans quel ordre et quelle largeur. Faites glisser une ligne ou utilisez les flèches pour la déplacer. La description et le montant sont toujours affichés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali colonne mostrare, il loro ordine e la loro larghezza. Trascina una riga o usa le frecce per spostarla. La descrizione e l'importo sono sempre visibili."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрсетілетін бағандар, олардың реті мен ені. Жолды сүйреңіз немесе көрсеткілермен жылжытыңыз. Сипаттама мен сома әрдайым көрсетіледі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие столбцы видны, в каком порядке и какой ширины. Строку можно перетащить или сдвинуть стрелками. Описание и сумма видны всегда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Які колонки показувати, у якому порядку й якої ширини. Перетягніть рядок або скористайтеся стрілками, щоб перемістити. Опис і суму показано завжди."
          }
        }
      }
    },
