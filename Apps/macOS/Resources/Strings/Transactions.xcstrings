    "editor.reconcileDifference.locked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine Abgleichdifferenz: Ihr Betrag, Ihre Art, Ihr Konto, Ihre Währung und Ihr Datum folgen von selbst, wenn Sie vor der Zählung Vorgänge hinzufügen oder korrigieren. Löschen Sie sie, und die Differenz dieser Zählung wird nicht mehr erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reconciliation difference: its amount, type, account, currency and date follow by themselves when you add or fix operations before the count. Delete it, and this count's difference will no longer be recorded."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл — салыстыру айырмасы: санауға дейінгі операцияларды қосқанда не түзеткенде сомасы, түрі, шоты, валютасы мен күні автоматты өзгереді. Оны жойсаңыз, осы санаудың айырмасы енді жазылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это разница сверки: сумма, тип, счёт, валюта и дата меняются сами, когда вы добавляете или правите операции до сверки. Удалите её — и разница этой сверки больше не будет записываться."
          }
        }
      }
    },
