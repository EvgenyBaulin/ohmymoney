    "bulk.reason.reconciliationDifference": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "bu, tutuşdurma fərqidir: hesabı sayımdan götürülür və heç vaxt Məqsədlərə və ya tətbiqin kateqoriyasına aid edilmir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "гэта розніца зверкі: яе рахунак вызначаецца падлікам, і яна не трапляе ў мэты або катэгорыі праграмы"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "jde o rozdíl při kontrole zůstatku: účet se přebírá z kontroly a rozdíl se nikdy nezařazuje do cílů ani kategorií aplikace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "es ist eine Abgleichdifferenz: Ihr Konto kommt aus der Zählung, und sie geht nie in Ziele oder eine Kategorie der App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "it is a reconciliation difference: its account comes from the count, and it never goes to Goals or a category of the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "es una diferencia de conciliación: su cuenta sale del recuento, y nunca va a Objetivos ni a una categoría de la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "c'est un écart de rapprochement : son compte vient du comptage, et il ne va jamais dans les Objectifs ni dans une catégorie de l'app"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "համադրման տարբերություն է. հաշիվը վերցվում է հաշվարկից, և այն չի դասվում նպատակների կամ հավելվածի կատեգորիաների մեջ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "è una differenza di riconciliazione: il conto dipende dal conteggio e non viene mai assegnata a Obiettivi o a una categoria dell'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高照合の差額です。口座は照合時のものになり、目標やアプリのカテゴリには追加されません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს შეჯერების სხვაობაა: მისი ანგარიში დათვლით განისაზღვრება და ის არ მიეკუთვნება მიზნებს ან აპის კატეგორიას"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "бұл — салыстыру айырмасы: шоты санаудан алынады, Мақсаттарға не қолданба санатына кірмейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "бул салыштыруу айырмасы: анын эсеби эсептөөдөн алынат жана ал эч качан «Максаттарга» же колдонмонун категориясына кирбейт"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "het is een telverschil: de rekening volgt uit de telling en het verschil wordt nooit aan doelen of een categorie van de app toegewezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "to różnica z uzgodnienia: jej konto wynika ze stanu konta i nie jest ona przypisywana do celów ani kategorii aplikacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "é uma diferença de conciliação: sua conta vem da contagem, e ela não é atribuída a Metas nem a uma categoria do app"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "é uma diferença de reconciliação: a conta é a da contagem e nunca é atribuída a Objetivos ou a uma categoria da aplicação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "это разница сверки: счёт у неё от сверки, а в «Цели» и системные категории она не переносится"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "ин фарқи санҷиши бақия аст: ҳисобаш аз санҷиш гирифта мешавад ва он ба ҳадафҳо ё категорияи барнома дохил намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bir mutabakat farkı: hesabı sayımdan alınır ve hiçbir zaman Hedefler'e veya uygulamadaki bir kategoriye aktarılmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "це різниця звірки: її рахунок береться з обліку, і вона ніколи не потрапляє до цілей чи категорії застосунку"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "bu hisobni tekshirish farqi: hisobi tekshiruvdan olinadi va u maqsad yoki ilova turkumiga kiritilmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是对账差额：其账户由盘点决定，且不会计入目标或 App 的类别"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是對帳差額：帳戶由盤點決定，且不會歸入目標或 App 的類別"
          }
        }
      }
    },
