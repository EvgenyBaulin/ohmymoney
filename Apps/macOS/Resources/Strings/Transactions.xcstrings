    "operations.columns.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Göstərilən sütunları, sırasını və enini seçin. Sətiri köçürmək üçün sürüşdürün və ya oxlardan istifadə edin. Təsvir və məbləğ həmişə göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Якія слупкі паказваць, у якім парадку і якой шырыні. Перацягніце радок або скарыстайцеся стрэлкамі, каб перамясціць яго. Апісанне і сума паказваюцца заўсёды."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte sloupce, jejich pořadí a šířku. Pořadí změníte přetažením řádku nebo pomocí šipek. Popis a částka se zobrazují vždy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Spalten gezeigt werden, in welcher Reihenfolge und wie breit. Ziehen Sie eine Zeile oder verschieben Sie sie mit den Pfeilen. Beschreibung und Betrag werden immer gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which columns are shown, in what order and how wide. Drag a row or use the arrows to move it. The description and the amount are always shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué columnas se muestran, en qué orden y con qué anchura. Arrastre una fila o use las flechas para moverla. La descripción y el importe siempre se muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelles colonnes sont affichées, dans quel ordre et quelle largeur. Faites glisser une ligne ou utilisez les flèches pour la déplacer. La description et le montant sont toujours affichés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք ցուցադրվող սյունակները, դրանց հերթականությունն ու լայնությունը։ Տողը տեղափոխելու համար քաշեք այն կամ օգտագործեք սլաքները։ Նկարագրությունն ու գումարը միշտ ցուցադրվում են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali colonne mostrare, il loro ordine e la loro larghezza. Trascina una riga o usa le frecce per spostarla. La descrizione e l'importo sono sempre visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する列、順序、幅を設定します。行をドラッグするか、矢印で移動できます。内容と金額は常に表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ სვეტები, მათი რიგი და სიგანე. გადასატანად გადაათრიეთ მწკრივი ან გამოიყენეთ ისრები. აღწერა და თანხა ყოველთვის ჩანს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрсетілетін бағандар, олардың реті мен ені. Жолды сүйреңіз немесе көрсеткілермен жылжытыңыз. Сипаттама мен сома әрдайым көрсетіледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көрсөтүлүүчү мамычалар, алардын тартиби жана туурасы. Жылдыруу үчүн сапты сүйрөңүз же жебелерди колдонуңуз. Сүрөттөмө менен сумма дайыма көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies welke kolommen worden getoond, in welke volgorde en hoe breed. Sleep een rij of gebruik de pijlen om deze te verplaatsen. De omschrijving en het bedrag worden altijd getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz widoczne kolumny, ich kolejność i szerokość. Przeciągnij wiersz lub użyj strzałek, aby go przenieść. Opis i kwota są zawsze widoczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as colunas exibidas, a ordem e a largura. Arraste uma linha ou use as setas para movê-la. A descrição e o valor são sempre exibidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as colunas a mostrar, a sua ordem e largura. Arraste uma linha ou use as setas para a mover. A descrição e o valor são sempre mostrados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие столбцы видны, в каком порядке и какой ширины. Строку можно перетащить или сдвинуть стрелками. Описание и сумма видны всегда."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сутунҳои намоён, тартиб ва паҳнои онҳо. Барои ҷойивазкунӣ сатрро кашед ё тирчаҳоро истифода баред. Тавсиф ва маблағ ҳамеша намоёнанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterilecek sütunları, sıralarını ve genişliklerini seçin. Bir satırı sürükleyin veya taşımak için okları kullanın. Açıklama ve tutar her zaman gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Які колонки показувати, у якому порядку й якої ширини. Перетягніть рядок або скористайтеся стрілками, щоб перемістити. Опис і суму показано завжди."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘rsatiladigan ustunlar, ularning tartibi va kengligi. Qatorni torting yoki surish uchun strelkalardan foydalaning. Tavsif va summa doim ko‘rsatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择显示的列，并调整其顺序和宽度。拖移行或使用箭头可调整顺序。描述和金额始终显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要顯示的欄位、順序和寬度。拖移列或使用箭頭來更改順序。說明和金額一律顯示。"
          }
        }
      }
    },
