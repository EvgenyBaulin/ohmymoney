    "bulk.undoHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z bütün dəyişiklikləri geri alır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z адменіць усе змены."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stisknutím ⌘Z vše vrátíte zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z bringt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z reprend tout."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z-ը հետ է բերում ամեն ինչ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ripristina tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Zですべて元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ყველაფერს აღადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z баарын калыбына келтирет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ⌘Z maak je alles ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z cofa wszystkie zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z desfaz todas as alterações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z repõe tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z вернёт всё обратно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ҳама чизро бармегардонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z tüm değişiklikleri geri alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z повертає все."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z hammasini qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 ⌘Z 可撤销所有更改。"
          }
