    "transactions.error.settlingRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer that keeps the archived account at zero cannot be written: the other account is in the archive now or does not hold the currency. Nothing was saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia que deja la cuenta archivada en cero no se puede escribir: la otra cuenta ahora está en el archivo o no tiene la divisa. No se guardó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le virement qui maintient le compte archivé à zéro ne peut pas être noté : l'autre compte est désormais aux archives ou ne détient pas la devise. Rien n'a été enregistré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод, который держит счёт в архиве на нуле, записать нельзя: другой счёт теперь в архиве или не держит эту валюту. Ничего не сохранено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переказ, що тримає архівний рахунок на нулі, не можна записати: інший рахунок тепер в архіві або не має цієї валюти. Нічого не збережено."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағатталған шотты нөлде ұстайтын аударымды жазу мүмкін емес: екінші шот қазір мұрағатта не валютаны қолдамайды. Ештеңе сақталмады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Überweisung, die das Konto im Archiv auf null hält, kann nicht geschrieben werden: Das andere Konto ist jetzt im Archiv oder führt die Währung nicht. Nichts wurde gespeichert."
          }
        }
      }
    },
