    "bulk.undoHint.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Geri al” bütün dəyişiklikləri geri alır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«Адмяніць» адменіць усе змены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Rückgängig“ bringt alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Undo” brings everything back."
          }
