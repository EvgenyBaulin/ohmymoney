    "bulk.reason.closedByReimbursement": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "für einen Teil davon wurde Geld zurückgegeben — löschen Sie zuerst diese Rückzahlung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "money was given back for a part of it — delete that reimbursement first"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "бір бөлігіне ақша қайтарылған — алдымен сол қайтаруды жойыңыз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "за часть уже вернули деньги — сначала удалите этот возврат"
          }
        }
      }
    },
    "bulk.reason.creditPurchase": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "auf Kredit gekauft — geändert unter „Schulden“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "bought on credit — changed in Debts"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "несиеге алынған — Қарыздарда өзгертіледі"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "покупка в кредит — меняется в разделе «Долги»"
          }
        }
      }
    },
    "bulk.reason.creditPurchasePaid": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darauf wurden schon Raten bezahlt — löschen Sie sie zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalments were already paid on it — delete them first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөліп төлеу төлемдері жасалған — алдымен оларды жойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По покупке уже платили — сначала удалите платежи."
          }
        }
      }
    },
    "bulk.reason.debtPayment": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "es ist eine Zahlung auf eine Schuld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "it is a payment on a debt"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "бұл — қарыз төлемі"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "это платёж по долгу"
          }
        }
      }
    },
    "bulk.reason.fieldNotForKind": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahme und Geld zurück haben dieses Feld nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "income and money given back have no such field"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "кіріс пен қайтарылған ақшада мұндай өріс жоқ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "у дохода и возврата денег нет такого поля"
          }
        }
      }
    },
    "bulk.reason.goalContribution": {
      "extractionState": "manual",
      "localizations": {
