    "transactions.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ əməliyyat yoxdur. İlk əməliyyatı pəncərənin aşağısındakı üzən giriş sətrinə yazın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацый пакуль няма. Увядзіце першую ў плаваючым радку ўнізе акна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné operace. První zadejte do plovoucího řádku ve spodní části okna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Vorgänge. Tippen Sie den ersten in die schwebende Eingabezeile unten im Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No operations yet. Type the first one in the floating entry line at the bottom of the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay operaciones. Escriba la primera en la línea de entrada flotante de la parte inferior de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'opérations. Saisissez la première dans la ligne de saisie flottante en bas de la fenêtre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ գործարքներ չկան։ Առաջինը մուտքագրեք պատուհանի ներքևի շարժական մուտքի տողում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna operazione. Inserisci la prima nella riga di inserimento mobile in fondo alla finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引はまだありません。ウインドウ下部の入力欄に最初の取引を入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაციები ჯერ არ არის. შეიყვანეთ პირველი ოპერაცია ფანჯრის ქვედა ნაწილში, მცურავ ველში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әлі операция жоқ. Алғашқысын терезенің төменгі жағындағы қалқымалы енгізу жолына жазыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча операциялар жок. Биринчисин терезенин ылдый жагындагы калкыма киргизүү сабына жазыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen transacties. Voer de eerste in via de zwevende invoerregel onder in het venster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak operacji. Wpisz pierwszą w pływającym polu u dołu okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma operação ainda. Digite a primeira na linha de entrada flutuante na parte inferior da janela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há operações. Introduza a primeira na linha de entrada flutuante, na parte inferior da janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операций пока нет. Введите первую в плавающей строке ввода внизу окна."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз амалиёт нест. Аввалинашро дар сатри вуруд дар поёни равзана нависед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz işlem yok. İlk işlemi pencerenin altındaki giriş satırına yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операцій ще немає. Введіть першу в плаваючому рядку вводу внизу вікна."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali operatsiyalar yo‘q. Birinchisini oyna pastidagi kiritish maydoniga yozing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无交易。在窗口底部的浮动输入栏中输入第一笔交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無交易。請在視窗底部的浮動輸入列輸入第一筆交易。"
          }
        }
      }
    },
    "transactions.error.linkedRefundChanged": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytarılan məbləğ alışdan qaytarılmamış qalan məbləğdən çox ola bilməz və alışın valyutası və növü ilə eyni qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне не можа перавышаць рэшту сумы пакупкі, даступную для вяртання. Яго валюта і тып супадаюць з пакупкай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrácená částka nesmí přesáhnout zbývající část nákupu a musí mít stejnou měnu a typ jako nákup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erstattung kann nicht mehr sein als das, was vom Kauf zum Erstatten übrig ist, und behält die Währung und Art des Kaufs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund cannot be more than what is left of the purchase to refund, and keeps the purchase’s currency and type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución no puede ser mayor que lo que queda de la compra por devolver, y mantiene la divisa y el tipo de la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement ne peut pas dépasser ce qui reste de l'achat à rembourser, et garde la devise et le type de l'achat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերադարձվող գումարը չի կարող գերազանցել գնման վերադարձման ենթակա մնացորդը և պետք է պահպանի գնման արժույթն ու տեսակը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rimborso non può superare l’importo ancora rimborsabile dell’acquisto e mantiene la valuta e il tipo dell’acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金額は購入の未返金額を超えることはできません。通貨と種類は購入時と同じになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დასაბრუნებელი თანხა არ უნდა აღემატებოდეს შენაძენის დარჩენილ თანხას. ის ინარჩუნებს შენაძენის ვალუტასა და ტიპს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтарым сатып алудың қайтаруға қалған сомасынан аспауы керек, оның валютасы мен түрі сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кайтарым сатып алуудан кайтарыла турган калган суммадан ашпашы керек жана сатып алуунун валютасы менен түрү сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een terugbetaling kan niet hoger zijn dan het resterende bedrag van de aankoop en behoudt de valuta en het type van de aankoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot nie może przekraczać kwoty pozostałej do zwrotu i zachowuje walutę oraz typ zakupu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso não pode ser maior que o valor restante da compra e mantém a moeda e o tipo da compra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso não pode exceder o montante da compra ainda por reembolsar e mantém a moeda e o tipo da compra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат не может быть больше того, что осталось вернуть по покупке, и остаётся в её валюте и типе."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи баргардонидашуда аз бақияи харид зиёд буда наметавонад ва асъору навъи харидро нигоҳ медорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İade, satın alma tutarının iade edilebilir kalan kısmını aşamaz; satın alma işleminin para birimini ve türünü korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення не може бути більшим за те, що лишилося від покупки для повернення, і зберігає валюту й вид покупки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytariladigan summa xaridning qaytarilmagan qismidan oshmasligi va xaridning valyutasi hamda turiga mos bo‘lishi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款不能超过此笔消费的剩余可退款金额，且须使用消费原有的货币和类型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款不能超過購買項目剩餘可退的金額，且須使用購買時的貨幣和類型。"
          }
        }
      }
    },
    "transactions.error.partlyReturnedPartChanged": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hissə üçün pulun bir qismi artıq qaytarılıb: onun məbləği, valyutası, növü və “başqası üçün ödənilib” seçimi dəyişdirilə bilməz — əvvəlcə qaytarılan pulu silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Частка грошай за гэту частку ўжо вернута: яе сума, валюта, тып і адзнака “аплачана за іншага” застаюцца без змен. Спачатку выдаліце вяртанне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Část peněz za tuto položku už byla vrácena: její částka, měna, typ a volba „zaplaceno za někoho jiného“ zůstávají beze změny — nejprve smažte vrácení peněz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Teil ist schon Geld zurückgekommen: Sein Betrag, seine Währung, Art und „für jemand anderen bezahlt“ bleiben, wie sie sind — löschen Sie zuerst dieses Geld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some money for this part has come back already: its amount, currency, type and “paid for someone else” stay as they are — delete that money back first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya volvió parte del dinero de esta parte: su importe, divisa, tipo y «pagado por otro» se quedan como están — elimine antes ese dinero devuelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de l'argent de cette part a déjà été rendue : son montant, sa devise, son type et « payé pour quelqu'un d'autre » restent tels quels — supprimez d'abord cet argent rendu."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս մասի գումարի մի մասն արդեն վերադարձվել է․ գումարը, արժույթը, տեսակը և “վճարված է ուրիշի համար” նշումը մնում են անփոփոխ։ Նախ ջնջեք այդ վերադարձը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte del denaro per questa quota è già stata restituita: importo, valuta, tipo e “pagato per altri” restano invariati. Elimina prima la restituzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この明細は一部返金済みです。金額、通貨、種類、「他の人の分」の設定を変更するには、先に返金を削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ნაწილის თანხის ნაწილი უკვე დაბრუნდა: მისი თანხა, ვალუტა, ტიპი და “სხვისთვის გადახდილი” უცვლელი რჩება — ჯერ წაშალეთ დაბრუნებული თანხა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы бөліктің ақшасы ішінара қайтарылған: сомасы, валютасы, түрі және “басқа адам үшін төленген” белгісі өзгермейді — алдымен қайтарылған ақшаны жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул бөлүк үчүн акчанын бир бөлүгү кайтарылган: анын суммасы, валютасы, түрү жана «башка бирөө үчүн төлөнгөн» белгиси өзгөрбөйт — адегенде кайтарылган акчаны өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor dit deel is al geld terugontvangen. Het bedrag, de valuta, het type en ‘betaald voor iemand anders’ blijven ongewijzigd. Verwijder eerst de terugbetaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część środków została już zwrócona: kwota, waluta, typ i ustawienie „opłacono za kogoś” pozostają bez zmian. Najpierw usuń zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do dinheiro desta parte já foi devolvida: o valor, a moeda, o tipo e “pago para outra pessoa” permanecem como estão — apague primeiro a devolução."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já foi devolvido algum dinheiro desta parte: o montante, a moeda, o tipo e a opção “pago por outra pessoa” mantêm-se — apague primeiro a devolução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За эту часть уже вернули часть денег: её сумма, валюта, тип и «за другого» не меняются — сначала удалите этот возврат денег."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қисме аз пули ин ҳисса аллакай баргардонда шудааст: маблағ, асъор, навъ ва “барои каси дигар пардохтшуда” бетағйир мемонанд — аввал пули баргаштаро нест кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısmın bir miktarı zaten geri alındı. Tutarı, para birimi, türü ve “başkası için ödendi” durumu değiştirilemez — önce geri alınan parayı silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цю частину вже частково повернули гроші: її сума, валюта, вид і «сплачено за іншого» лишаються як є — спершу видаліть повернені гроші."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qism uchun pulning bir qismi allaqachon qaytarilgan: uning summasi, valyutasi, turi va “boshqa kishi uchun to‘langan” belgisi o‘zgarmaydi — avval qaytgan pulni o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此部分已有退款：其金额、货币、类型和“为他人付款”设置保持不变，请先删除退款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此部分已有款項退回，金額、貨幣、類型和「代他人支付」須維持不變。請先刪除該筆退回款項。"
          }
        }
      }
    },
    "transactions.error.purchaseHasRefunds": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alış üçün pul qaytarılıb — əvvəlcə qaytarılmanı silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для гэтай пакупкі ёсць вяртанне — спачатку выдаліце яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K tomuto nákupu existuje vrácení peněz — nejprve ho smažte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erstattung nimmt Geld von diesem Kauf zurück — löschen Sie zuerst die Erstattung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund takes money back from this purchase — delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución quita dinero de esta compra — elimine antes la devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement retire de l'argent à cet achat — supprimez d'abord le remboursement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գնման համար գումար է վերադարձվել․ նախ ջնջեք վերադարձը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rimborso restituisce denaro per questo acquisto. Elimina prima il rimborso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この購入には返金があります。先に返金を削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ შენაძენზე თანხა დაბრუნებულია — ჯერ წაშალეთ დაბრუნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы сатып алудан қайтарыммен ақша алынған — алдымен қайтарымды жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сатып алуу үчүн акча кайтарылган — адегенде кайтарымды өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze aankoop is een terugbetaling geregistreerd. Verwijder eerst de terugbetaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tego zakupu przypisano zwrot. Najpierw go usuń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um reembolso desta compra — apague o reembolso primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe um reembolso desta compra — apague primeiro o reembolso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По покупке оформлен возврат — сначала удалите возврат."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баргардонидани пул ба ин харид вобаста аст — аввал онро нест кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu satın alma işlemine ait bir iade var — önce iadeyi silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення забирає з цієї покупки гроші — спершу видаліть повернення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu xarid uchun pul qaytarilgan — avval qaytarishni o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此笔消费已有退款，请先删除退款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此購買項目已有退款，請先刪除退款。"
          }
        }
      }
    },
    "transactions.error.refundExceedsRemaining": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu məbləğ alışdan qaytarılmamış qalan məbləğdən çoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта больш за рэшту сумы пакупкі, даступную для вяртання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je více, než zbývá z nákupu vrátit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist mehr, als vom Kauf zum Erstatten übrig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is more than is left of the purchase to refund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es más de lo que queda de la compra por devolver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est plus que ce qui reste de l'achat à rembourser."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը գերազանցում է գնման վերադարձման ենթակա մնացորդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importo supera quello ancora rimborsabile dell’acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の未返金額を超えています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა აღემატება შენაძენის დასაბრუნებელ ნაშთს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сатып алудың қайтаруға қалған сомасынан көп."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сатып алуудан кайтарыла турган калган суммадан көп."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is meer dan het resterende bedrag van de aankoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kwota przekracza pozostałą kwotę zakupu do zwrotu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse valor é maior que o restante da compra a reembolsar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este montante excede o valor da compra ainda por reembolsar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это больше, чем осталось вернуть по покупке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин аз бақияи маблағи харид барои баргардонидан зиёд аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tutar, satın alma işleminin iade edilebilir kalan kısmını aşıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це більше, ніж лишилося від покупки для повернення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu summa xaridning qaytarilmagan qismidan oshadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额超过此笔消费的剩余可退款金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金額超過此購買項目剩餘可退的金額。"
          }
        }
      }
    },
    "transactions.error.refundNotPositive": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytarılan məbləğ sıfırdan çox olmalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума вяртання павінна быць большай за нуль."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrácená částka musí být větší než nula."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erstattung muss über null liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund must be more than zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución debe ser mayor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement doit être supérieur à zéro."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերադարձվող գումարը պետք է զրոյից մեծ լինի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rimborso deve essere maggiore di zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金額は0より大きくする必要があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დასაბრუნებელი თანხა ნულზე მეტი უნდა იყოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтарым нөлден үлкен болуы керек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кайтарым нөлдөн көп болушу керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een terugbetaling moet hoger zijn dan nul."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota zwrotu musi być większa od zera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso deve ser maior que zero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso tem de ser superior a zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма возврата должна быть больше нуля."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи баргардонидашуда бояд аз сифр зиёд бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İade sıfırdan büyük olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення має бути більше нуля."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytariladigan summa noldan katta bo‘lishi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款金额必须大于零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款金額須大於零。"
          }
        }
      }
    },
    "transactions.error.refundNotRefundable": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alış üçün pul qaytarıla bilməz: alış başqası üçün ödənilib, kreditlə alınıb, borc ödənişidir və ya məqsədə yatırılan məbləğdir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для гэтай пакупкі нельга зрабіць вяртанне: яна аплачана за іншага, у крэдыт або з'яўляецца выплатай доўгу ці ўнёскам на мэту."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento nákup nelze vrátit: byl zaplacen za někoho jiného, na úvěr, jde o splátku dluhu nebo příspěvek na cíl."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf kann nicht erstattet werden: Er ist für jemand anderen bezahlt, auf Kredit, eine Zahlung auf eine Schuld oder ein Beitrag zu einem Ziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This purchase cannot be refunded: it is paid for someone else, on credit, a debt payment or a goal contribution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra no se puede devolver: está pagada por otro, a crédito, es un pago de deuda o una aportación a un objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat ne peut pas être remboursé : il est payé pour quelqu'un d'autre, à crédit, un paiement de dette ou une contribution à un objectif."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գնումը հնարավոր չէ վերադարձնել․ այն վճարվել է ուրիշի համար, ապառիկ է, պարտքի մարում է կամ նպատակի համար ներդրում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo acquisto non può essere rimborsato: è pagato per altri, a credito, è un pagamento di un debito o un contributo a un obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この購入は返金できません。他の人の分、クレジット払い、借金の返済、または目標への入金です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ შენაძენზე თანხა ვერ დაბრუნდება: ის სხვისთვისაა გადახდილი, კრედიტითაა შეძენილი, ვალის გადახდაა ან მიზნისთვის შენატანია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сатып алуды қайтаруға болмайды: басқа адам үшін төленген, несиеге алынған, қарыз төлемі не мақсатқа жарна."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сатып алууну кайтаруу мүмкүн эмес: ал башка бирөө үчүн төлөнгөн, кредитке алынган, карыз төлөмү же максатка салым болуп саналат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze aankoop kan niet worden terugbetaald: deze is betaald voor iemand anders, op krediet, een schuldaflossing of een bijdrage aan een doel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zwrócić tego zakupu: został opłacony za kogoś innego, na kredyt albo jest spłatą długu lub wpłatą na cel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra não pode ser reembolsada: ela foi paga para outra pessoa, feita a crédito ou é um pagamento de dívida ou uma contribuição para uma meta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra não pode ser reembolsada: foi paga por outra pessoa, foi feita a crédito, é um pagamento de dívida ou uma contribuição para um objetivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту покупку нельзя вернуть: она за другого, в кредит, платёж по долгу или взнос на цель."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули ин харидро баргардонидан мумкин нест: он барои каси дигар пардохт шудааст, қарзӣ аст, пардохти қарз ё саҳм ба ҳадаф аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu satın alma işlemi iade edilemez: Başkası için ödenmiş, kredili, borç ödemesi veya hedef katkısı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю покупку не можна повернути: її сплачено за іншого, у кредит, як платіж за боргом або як внесок у ціль."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu xarid uchun pulni qaytarib bo‘lmaydi: u boshqa kishi uchun yoki kreditga to‘langan, qarz to‘lovi yoki maqsadga badal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此笔消费无法退款：它属于为他人付款、赊账、还债或目标存款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此購買項目無法退款：它是代他人支付、賒帳、債務付款或目標存款。"
          }
        }
      }
    },
    "transactions.error.refundOtherCurrency": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul alışın valyutasında qaytarılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вяртанне робіцца ў валюце пакупкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze se vracejí v měně nákupu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erstattung erfolgt in der Währung des Kaufs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund is made in the currency of the purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución se hace en la divisa de la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement se fait dans la devise de l'achat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարը վերադարձվում է գնման արժույթով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rimborso viene effettuato nella valuta dell’acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金は購入時と同じ通貨で行います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა ბრუნდება შენაძენის ვალუტაში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайтарым сатып алу валютасында жасалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кайтарым сатып алуунун валютасында жүргүзүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een terugbetaling gebeurt in de valuta van de aankoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwrot jest dokonywany w walucie zakupu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso é feito na moeda da compra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reembolso é feito na moeda da compra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат делается в валюте покупки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пул бо асъори харид баргардонда мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İade, satın alma işleminin para biriminde yapılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення робиться у валюті покупки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul xarid valyutasida qaytariladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款须使用消费时的货币。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款須使用購買時的貨幣。"
          }
        }
      }
    },
    "transactions.error.refundedPartChanged": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alış üçün pul qaytarılıb: onun valyutası, növü, “başqası üçün ödənilib” seçimi və kredit dəyişdirilə bilməz — əvvəlcə qaytarılmanı silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для гэтай пакупкі ёсць вяртанне: яе валюта, тып, адзнака “аплачана за іншага” і крэдыт застаюцца без змен. Спачатку выдаліце вяртанне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K tomuto nákupu existuje vrácení peněz: jeho měna, typ, volba „zaplaceno za někoho jiného“ a úvěr zůstávají beze změny — nejprve smažte vrácení peněz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erstattung nimmt Geld von diesem Kauf zurück: Seine Währung, Art, „für jemand anderen bezahlt“ und Kredit bleiben, wie sie sind — löschen Sie zuerst die Erstattung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund takes money back from this purchase: its currency, type, “paid for someone else” and credit stay as they are — delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución quita dinero de esta compra: su divisa, tipo, «pagado por otro» y crédito se quedan como están — elimine antes la devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement retire de l'argent à cet achat : sa devise, son type, « payé pour quelqu'un d'autre » et le crédit restent tels quels — supprimez d'abord le remboursement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գնման համար գումար է վերադարձվել․ արժույթը, տեսակը, “վճարված է ուրիշի համար” նշումն ու ապառիկը մնում են անփոփոխ։ Նախ ջնջեք վերադարձը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rimborso restituisce denaro per questo acquisto: valuta, tipo, “pagato per altri” e credito restano invariati. Elimina prima il rimborso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この購入には返金があります。通貨、種類、「他の人の分」の設定、クレジットを変更するには、先に返金を削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ შენაძენზე თანხა დაბრუნებულია: მისი ვალუტა, ტიპი, “სხვისთვის გადახდილი” და კრედიტი უცვლელი რჩება — ჯერ წაშალეთ დაბრუნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы сатып алудан қайтарыммен ақша алынған: валютасы, түрі, “басқа адам үшін төленген” белгісі мен несиесі өзгермейді — алдымен қайтарымды жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сатып алуу үчүн акча кайтарылган: анын валютасы, түрү, «башка бирөө үчүн төлөнгөн» белгиси жана кредити өзгөрбөйт — адегенде кайтарымды өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze aankoop is een terugbetaling geregistreerd. De valuta, het type, ‘betaald voor iemand anders’ en het krediet blijven ongewijzigd. Verwijder eerst de terugbetaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tego zakupu przypisano zwrot: waluta, typ, ustawienie „opłacono za kogoś” i kredyt pozostają bez zmian. Najpierw usuń zwrot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um reembolso desta compra: a moeda, o tipo, “pago para outra pessoa” e o crédito permanecem como estão — apague o reembolso primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe um reembolso desta compra: a moeda, o tipo, a opção “pago por outra pessoa” e o crédito mantêm-se — apague primeiro o reembolso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По покупке оформлен возврат: её валюта, тип, «за другого» и «В кредит» не меняются — сначала удалите возврат."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баргардонидани пул ба ин харид вобаста аст: асъор, навъ, “барои каси дигар пардохтшуда” ва қарз бетағйир мемонанд — аввал баргардонидани пулро нест кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu satın alma işlemine ait bir iade var. Para birimi, türü, “başkası için ödendi” ve kredi durumu değiştirilemez — önce iadeyi silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення забирає з цієї покупки гроші: її валюта, вид, «сплачено за іншого» і кредит лишаються як є — спершу видаліть повернення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu xarid uchun pul qaytarilgan: uning valyutasi, turi, “boshqa kishi uchun to‘langan” belgisi va krediti o‘zgarmaydi — avval qaytarishni o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此笔消费已有退款：其货币、类型、“为他人付款”和赊账设置保持不变，请先删除退款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此購買項目已有退款，貨幣、類型、「代他人支付」和賒帳須維持不變。請先刪除退款。"
          }
        }
      }
    },
    "transactions.error.refundedPartReduced": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hissənin məbləği artıq qaytarılmış məbləğdən az ola bilməz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума часткі не можа быць меншай за ўжо вернутую суму."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částka této položky nesmí být nižší než již vrácená částka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Teil kann nicht kleiner sein als das, was seine Erstattungen schon zurückgenommen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The part cannot be less than what its refunds already took back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte no puede ser menor de lo que ya quitaron sus devoluciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part ne peut pas être inférieure à ce que ses remboursements ont déjà retiré."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մասի գումարը չի կարող պակաս լինել դրա համար արդեն վերադարձված գումարից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota non può essere inferiore all’importo già rimborsato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細の金額を返金済みの金額より少なくすることはできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაწილის თანხა უკვე დაბრუნებულ თანხაზე ნაკლები ვერ იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлік бұрынғы қайтарымдар сомасынан аз болмауы керек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүктүн суммасы буга чейин кайтарылган суммадан аз болбошу керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het deel kan niet lager zijn dan het al terugbetaalde bedrag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota części nie może być niższa niż suma przypisanych do niej zwrotów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parte não pode ser menor que o valor já devolvido pelos reembolsos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A parte não pode ser inferior ao montante já reembolsado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть не может стать меньше того, что по ней уже вернули."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ҳисса аз пули аллакай баргардондашуда кам буда наметавонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısım, iadelerle geri alınan tutardan az olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частина не може бути меншою за те, що її повернення вже забрали."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qism summasi allaqachon qaytarilgan summadan kam bo‘lishi mumkin emas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此部分的金额不能低于已退款金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此部分的金額不能低於已退還的金額。"
          }
        }
      }
    },
    "transactions.error.refundedPartRemoved": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hissə üçün pul qaytarılıb — əvvəlcə qaytarılmanı silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для гэтай часткі ёсць вяртанне — спачатку выдаліце яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K této položce existuje vrácení peněz — nejprve ho smažte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erstattung nimmt Geld von diesem Teil zurück — löschen Sie zuerst die Erstattung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refund takes money back from this part — delete the refund first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una devolución quita dinero de esta parte — elimine antes la devolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remboursement retire de l'argent à cette part — supprimez d'abord le remboursement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս մասի համար գումար է վերադարձվել․ նախ ջնջեք վերադարձը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rimborso restituisce denaro per questa quota. Elimina prima il rimborso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この明細には返金があります。先に返金を削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ნაწილზე თანხა დაბრუნებულია — ჯერ წაშალეთ დაბრუნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы бөліктен қайтарыммен ақша алынған — алдымен қайтарымды жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул бөлүк үчүн акча кайтарылган — адегенде кайтарымды өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor dit deel is een terugbetaling geregistreerd. Verwijder eerst de terugbetaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tej części przypisano zwrot. Najpierw go usuń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um reembolso desta parte — apague o reembolso primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe um reembolso desta parte — apague primeiro o reembolso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этой части покупки оформлен возврат — сначала удалите возврат."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баргардонидани пул ба ин ҳисса вобаста аст — аввал онро нест кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısma ait bir iade var — önce iadeyi silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення забирає з цієї частини гроші — спершу видаліть повернення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qism uchun pul qaytarilgan — avval qaytarishni o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此部分已有退款，请先删除退款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此部分已有退款，請先刪除退款。"
          }
        }
      }
    },
    "transactions.error.settlingRefused": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivdəki hesabın qalığını sıfırda saxlayan köçürməni qeydə almaq mümkün olmadı: digər hesab indi arxivdədir və ya həmin valyutanı dəstəkləmir. Heç nə saxlanmadı."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць перавод, які падтрымлівае нулявы баланс архіўнага рахунку: другі рахунак цяпер у архіве або не падтрымлівае гэту валюту. Нічога не захавана."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Převod, který udržuje zůstatek archivovaného účtu na nule, nelze zapsat: druhý účet je nyní v archivu nebo nepodporuje danou měnu. Nic se neuložilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Überweisung, die das Konto im Archiv auf null hält, kann nicht geschrieben werden: Das andere Konto ist jetzt im Archiv oder führt die Währung nicht. Nichts wurde gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer that keeps the archived account at zero cannot be written: the other account is in the archive now or does not hold the currency. Nothing was saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia que deja la cuenta archivada en cero no se puede escribir: la otra cuenta ahora está en el archivo o no tiene la divisa. No se guardó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le virement qui maintient le compte archivé à zéro ne peut pas être noté : l'autre compte est désormais aux archives ou ne détient pas la devise. Rien n'a été enregistré."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց գրանցել արխիվացված հաշվի մնացորդը զրոյացնող փոխանցումը․ մյուս հաշիվն այժմ արխիվում է կամ չի պարունակում այդ արժույթը։ Ոչինչ չի պահպանվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare il trasferimento che mantiene a zero il conto archiviato: l’altro conto è ora in archivio o non dispone della valuta. Non è stato salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済みの口座を残高ゼロにする振替を保存できません。振替先の口座がアーカイブされているか、対象の通貨を扱っていません。変更は保存されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არქივში გადატანილი ანგარიშის ნულოვანი ნაშთის შესანარჩუნებლად საჭირო გადარიცხვა ვერ ჩაიწერა: მეორე ანგარიში ახლა არქივშია ან ამ ვალუტას არ შეიცავს. არაფერი შენახულა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағатталған шотты нөлде ұстайтын аударымды жазу мүмкін емес: екінші шот қазір мұрағатта не валютаны қолдамайды. Ештеңе сақталмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивделген эсептин балансын нөлдө кармаган которууну сактоо мүмкүн эмес: башка эсеп азыр архивде же анда бул валюта жок. Эч нерсе сакталган жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De overboeking die de gearchiveerde rekening op nul houdt, kan niet worden bewaard: de andere rekening is nu gearchiveerd of ondersteunt de valuta niet. Er is niets bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać przelewu zerującego saldo zarchiwizowanego konta: drugie konto jest teraz w archiwum lub nie obsługuje tej waluty. Nic nie zapisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registrar a transferência que mantém a conta arquivada com saldo zero: a outra conta está arquivada ou não aceita a moeda. Nada foi salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível registar a transferência que mantém o saldo da conta arquivada a zero: a outra conta está agora arquivada ou não tem essa moeda. Nada foi guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод, который держит счёт в архиве на нуле, записать нельзя: другой счёт теперь в архиве или не держит эту валюту. Ничего не сохранено."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Интиқоле, ки бақияи ҳисоби бойгониро сифр нигоҳ медорад, сабт нашуд: ҳисоби дигар ҳоло дар бойгонӣ аст ё ин асъорро надорад. Чизе нигоҳ дошта нашуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenen hesabın bakiyesini sıfırda tutan transfer kaydedilemedi: Diğer hesap artık arşivde veya bu para birimini desteklemiyor. Hiçbir şey kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переказ, що тримає архівний рахунок на нулі, не можна записати: інший рахунок тепер в архіві або не має цієї валюти. Нічого не збережено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivlangan hisobni nolda ushlab turuvchi o‘tkazmani saqlab bo‘lmadi: boshqa hisob hozir arxivda yoki unda bu valyuta yo‘q. Hech narsa saqlanmadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储用于将已归档账户余额归零的转账：另一个账户现已归档或不支持该货币。未存储任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存用來將封存帳戶餘額歸零的轉帳：另一個帳戶已封存或不支援此貨幣。未儲存任何內容。"
          }
        }
      }
    },
