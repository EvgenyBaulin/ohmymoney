    "operations.search.prompt": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün tarixçədə axtar: sözlər, kateqoriya, məkan, hesab, məbləğ"
