    "store.failure.other": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumat bazasına yazmaq mümkün olmadı və heç nə dəyişmədi. Xəta jurnaldadır (Kömək → Problem hesabatı topla…)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося запісаць даныя ў базу. Нічога не змянілася. Памылка ў журнале (Даведка → Сабраць справаздачу аб праблеме…)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank hat die Schreibung nicht angenommen, und nichts hat sich geändert. Der Fehler steht im Journal (Hilfe → Problembericht erstellen…)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database didn’t accept the write, and nothing changed. The error is in the journal (Help → Collect a Problem Report…)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó la escritura, y no cambió nada. El error está en el diario (Ayuda → Reunir informe del problema…)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté l'écriture, et rien n'a changé. L'erreur est dans le journal (Aide → Créer un rapport de problème…)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների բազան չընդունեց գրառումը, և ոչինչ չփոխվեց։ Սխալը գրանցված է մատյանում (Օգնություն → Հավաքել խնդրի հաշվետվություն…)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database non ha accettato la scrittura. Non è stato modificato nulla. L’errore è nel registro (Aiuto → Raccogli un rapporto sul problema…)."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ბაზამ ჩანაწერი არ მიიღო და არაფერი შეცვლილა. შეცდომა ჟურნალშია (დახმარება → პრობლემის ანგარიშის შეგროვება…)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор жазуды қабылдамады, ештеңе өзгермеді. Қате журналда (Анықтама → Мәселе туралы есеп жинау…)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалыматтар базасына жазуу ишке ашкан жок, эч нерсе өзгөргөн жок. Ката журналда (Жардам → Көйгөй тууралуу отчетту чогултуу…)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza danych nie przyjęła zapisu. Nic się nie zmieniło. Błąd znajduje się w dzienniku (Pomoc → Zbierz raport o problemie…)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados não aceitou a gravação e nada foi alterado. O erro está no registro (Ajuda → Coletar Relatório de Problema…)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A base de dados não aceitou a gravação e nada foi alterado. O erro está no registo (Ajuda → Recolher um relatório de problema…)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База не приняла запись — ничего не изменилось. Ошибка записана в журнал («Справка» → «Собрать отчёт о проблеме…»)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойгоҳи додаҳо сабтро қабул накард ва чизе тағйир наёфт. Хато дар журнал аст (Кумак → Ҷамъоварии гузориши мушкилот…)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanına yazılamadı ve hiçbir şey değişmedi. Hata günlüğe kaydedildi (Yardım → Sorun Raporu Topla…)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База не прийняла запис, і нічого не змінилося. Помилка є в журналі (Довідка → Зібрати звіт про проблему…)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasiga yozib bo‘lmadi, hech narsa o‘zgarmadi. Xato jurnalda (Yordam → Muammo hisobotini yig‘ish…)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫無法寫入，未更改任何內容。錯誤已記錄在日誌中（輔助說明 → 收集問題報告⋯）。"
          }
        }
      }
    },
    "store.failure.planOutdated": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulun hara yönələcəyini seçərkən bu əməliyyatlardan bəziləri başqa yerdə dəyişdirilib, buna görə köçürmə artıq onlara uyğun gəlmir. Heç nə dəyişmədi: əməliyyatları seçib dəyişikliyi yenidən edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль вы выбіралі, куды накіраваць грошы, некаторыя з гэтых аперацый змяніліся ў іншым месцы, таму перавод больш ім не адпавядае. Нічога не змянілася: выберыце аперацыі і паўтарыце змену."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige dieser Vorgänge haben sich anderswo geändert, während Sie wählten, wohin das Geld geht; die Überweisung passt daher nicht mehr. Nichts hat sich geändert: Wählen Sie die Vorgänge aus und machen Sie die Änderung erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of these operations changed elsewhere while you were choosing where the money goes, so the transfer no longer matches them. Nothing changed: select the operations and make the change again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas de estas operaciones cambiaron en otro sitio mientras elegía adónde va el dinero, así que la transferencia ya no les corresponde. No cambió nada: seleccione las operaciones y haga el cambio de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines de ces opérations ont changé ailleurs pendant que vous choisissiez où va l'argent, donc le virement ne leur correspond plus. Rien n'a changé : sélectionnez les opérations et refaites la modification."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչ ընտրում էիք, թե ուր փոխանցել գումարը, այս գործարքներից մի քանիսն այլ տեղում փոխվել են, ուստի փոխանցումն այլևս չի համապատասխանում դրանց։ Ոչինչ չի փոխվել․ ընտրեք գործարքները և կրկին կատարեք փոփոխությունը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune operazioni sono state modificate altrove mentre sceglievi la destinazione del denaro, quindi il trasferimento non corrisponde più. Non è stato modificato nulla: seleziona le operazioni e ripeti la modifica."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფულის დანიშნულების არჩევისას ზოგი ოპერაცია სხვაგან შეიცვალა, ამიტომ გადარიცხვა მათ აღარ შეესაბამება. არაფერი შეცვლილა: მონიშნეთ ოპერაციები და ხელახლა შეცვალეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша қайда түсетінін таңдаған кезде кейбір операциялар басқа жерде өзгерді, сондықтан аударым оларға енді сәйкес емес. Ештеңе өзгермеді: операцияларды таңдап, өзгерісті қайталаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча кайда кетерин тандап жатканда, бул операциялардын айрымдары башка жерде өзгөргөн. Ошондуктан которуу аларга дал келбей калды. Эч нерсе өзгөргөн жок: операцияларды тандап, өзгөртүүнү кайра киргизиңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre operacje zmieniły się w innym miejscu podczas wybierania celu środków, więc przelew już do nich nie pasuje. Nic się nie zmieniło: zaznacz operacje i ponów zmianę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas dessas operações foram alteradas em outro lugar enquanto você escolhia o destino do dinheiro. Por isso, a transferência não corresponde mais a elas. Nada foi alterado: selecione as operações e faça a alteração novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas destas operações foram alteradas noutro local enquanto escolhia o destino do dinheiro, pelo que a transferência já não corresponde às mesmas. Nada foi alterado: selecione as operações e volte a fazer a alteração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы выбирали, куда перевести деньги, часть этих операций изменилась в другом месте, и перевод им больше не соответствует. Ничего не изменилось: выделите операции и повторите изменение."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми интихоби самти пул баъзе аз ин амалиёт дар ҷои дигар тағйир ёфтанд, аз ин рӯ интиқол дигар ба онҳо мувофиқат намекунад. Чизе тағйир наёфт: амалиётро интихоб кунед ва тағйиротро аз нав ворид кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranın nereye gideceğini seçerken bu işlemlerden bazıları başka bir yerde değiştirildi. Bu yüzden transfer artık onlarla eşleşmiyor. Hiçbir şey değişmedi: İşlemleri seçip değişikliği yeniden yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі з цих операцій змінилися деінде, поки ви вибирали, куди йдуть гроші, тож переказ їм більше не відповідає. Нічого не змінено: виберіть операції й зробіть зміну знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul qayerga yo‘naltirilishini tanlayotganingizda ayrim operatsiyalar boshqa joyda o‘zgartirilgan, shuning uchun o‘tkazma endi ularga mos kelmaydi. Hech narsa o‘zgarmadi: operatsiyalarni tanlab, qayta o‘zgartiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇款項去向時，部分交易已在其他位置更改，因此轉帳不再相符。未更改任何內容，請重新選取交易並進行更改。"
          }
        }
      }
    },
    "store.failure.undo": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri almaq mümkün olmadı"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося скасаваць"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht rückgängig gemacht werden"
          }
        },
        "en": {
