            "state": "translated",
            "value": "Պահե՞լ այս գործարքի փոփոխությունները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi salvare le modifiche a questa operazione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取引への変更を保存しますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეინახოთ ამ ოპერაციის ცვლილებები?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы операцияның өзгерістерін сақтау керек пе?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул операциядагы өзгөртүүлөр сакталсынбы?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen in deze transactie bewaren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachować zmiany w tej operacji?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar as alterações desta operação?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar as alterações a esta operação?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить правки этой операции?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағйироти ин амалиёт захира карда шаванд?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemdeki değişiklikler kaydedilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти зміни цієї операції?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu amaldagi o‘zgarishlar saqlansinmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储对此交易的更改？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要儲存對此交易的更改嗎？"
          }
        }
      }
