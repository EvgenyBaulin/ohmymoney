      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht gelöscht werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t delete"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
