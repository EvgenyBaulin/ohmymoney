    "inspector.unsavedMessage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa əməliyyat açılır. Yadda saxlanılmamış dəyişikliklər itiriləcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрываецца іншая аперацыя. Незахаваныя змены будуць страчаны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevírá se jiná operace. Neuložené změny budou ztraceny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Vorgang wird geöffnet. Nicht gespeicherte Änderungen gehen verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another operation is being opened. Changes that are not saved will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está abriendo otra operación. Los cambios que no se guarden se perderán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre opération est en train d'être ouverte. Les modifications non enregistrées seront perdues."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացվում է մեկ այլ գործարք։ Չպահված փոփոխությունները կկորչեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai aprendo un'altra operazione. Le modifiche non salvate andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の取引を開きます。保存されていない変更は失われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იხსნება სხვა ოპერაცია. შეუნახავი ცვლილებები დაიკარგება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа операция ашылуда. Сақталмаған өзгерістер жоғалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Башка операция ачылууда. Сакталбаган өзгөртүүлөр жоголот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een andere transactie geopend. Niet-bewaarde wijzigingen gaan verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwierana jest inna operacja. Niezapisane zmiany zostaną utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra operação está sendo aberta. As alterações não salvas serão perdidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a ser aberta outra operação. As alterações não guardadas serão perdidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывается другая операция. Несохранённые правки пропадут."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёти дигар кушода мешавад. Тағйироти захиранашуда гум мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir işlem açılıyor. Kaydedilmemiş değişiklikler kaybolacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривається інша операція. Незбережені зміни буде втрачено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa amal ochilmoqda. Saqlanmagan o‘zgarishlar yo‘qoladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开另一笔交易。未存储的更改将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即將開啟另一筆交易，未儲存的更改將會遺失。"
          }
        }
      }
    },
    "inspector.unsavedTitle": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu əməliyyatda dəyişikliklər yadda saxlanılsın?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
