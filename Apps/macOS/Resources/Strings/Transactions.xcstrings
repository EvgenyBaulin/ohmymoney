    "bulk.reason.closedByReimbursement": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "bir hissəsinin pulu qaytarılıb — əvvəlcə həmin qaytarmanı silin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "за частку вернуты грошы — спачатку выдаліце гэтае вяртанне"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "für einen Teil davon wurde Geld zurückgegeben — löschen Sie zuerst diese Rückzahlung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "money was given back for a part of it — delete that reimbursement first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "por una de sus partes ya se devolvió dinero — elimine antes esa devolución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "de l'argent a été rendu pour une de ses parts — supprimez d'abord ce remboursement"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "մի մասի գումարը վերադարձվել է. նախ ջնջեք վերադարձը"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "una parte è stata rimborsata: elimina prima il rimborso"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი ნაწილისთვის თანხა დაბრუნდა — ჯერ ეს დაბრუნება წაშალეთ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "бір бөлігіне ақша қайтарылған — алдымен сол қайтаруды жойыңыз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "бир бөлүгүнүн акчасы кайтарылган — адегенде ошол кайтарууну өчүрүңүз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zwrócono pieniądze za część operacji — najpierw usuń ten zwrot"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "uma parte foi devolvida — apague a devolução primeiro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "foi devolvido dinheiro por uma parte — apague primeiro esse reembolso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "за часть уже вернули деньги — сначала удалите этот возврат"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "маблағи як қисми он баргардонда шудааст — аввал он баргардониданро нест кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bir kısmı için para geri verildi; önce bu geri ödemeyi silin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "за частину з нього повернули гроші — спершу видаліть це повернення"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "bir qismi uchun pul qaytarilgan — avval pul qaytarilishini o‘chiring"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一部分已獲還款，請先刪除該筆還款"
          }
        }
      }
    },
    "bulk.reason.creditPurchase": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "kreditlə alınıb — Borclar bölməsində dəyişdirilir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "куплена ў крэдыт — змяняецца ў раздзеле «Даўгі»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "auf Kredit gekauft — geändert unter „Schulden“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "bought on credit — changed in Debts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "comprada a crédito — se cambia en Deudas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "acheté à crédit — modifié dans « Dettes »"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "գնվել է ապառիկ. փոխվում է «Պարտքեր» բաժնում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "acquisto a credito: si modifica in Debiti"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაყიდია კრედიტით — იცვლება ვალებში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "несиеге алынған — Қарыздарда өзгертіледі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "карызга алынган — «Карыздар» бөлүмүндө өзгөртүлөт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zakup na kredyt — zmiany w sekcji Długi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "compra a crédito — alterada em Dívidas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "comprado a crédito — altere em Dívidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "покупка в кредит — меняется в разделе «Долги»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "ба қарз харида шудааст — дар «Қарзҳо» тағйир дода мешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "krediyle alındı; Borçlar bölümünde değiştirilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "куплено в кредит — змінюється в «Боргах»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "kreditga olingan — Qarzlar bo‘limida o‘zgartiriladi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以信用購買，請在「債務」中更改"
          }
        }
      }
    },
    "bulk.reason.creditPurchasePaid": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Artıq taksitlər ödənilib — əvvəlcə onları silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Унёскі ўжо выплачваліся — спачатку выдаліце іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darauf wurden schon Raten bezahlt — löschen Sie sie zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalments were already paid on it — delete them first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se pagaron plazos de ella — elimínelos antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des tranches ont déjà été payées dessus — supprimez-les d'abord."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "ապառիկի վճարումներ արդեն կատարվել են. նախ ջնջեք դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono già state pagate delle rate: eliminale prima."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განვადების ნაწილი უკვე გადახდილია — ჯერ ეს გადახდები წაშალეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөліп төлеу төлемдері жасалған — алдымен оларды жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүп төлөөлөр жүргүзүлгөн — адегенде аларды өчүрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spłacono już raty — najpierw je usuń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcelas já foram pagas — apague-as primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já foram pagas prestações — apague-as primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По покупке уже платили — сначала удалите платежи."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қисмҳои пардохт аллакай пардохта шудаанд — аввал онҳоро нест кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taksitleri zaten ödendi; önce bunları silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За ним уже сплачено частини — спершу видаліть їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo‘lib to‘lash to‘lovlari allaqachon amalga oshirilgan — avval ularni o‘chiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已支付分期款，請先刪除相關付款。"
          }
        }
      }
    },
