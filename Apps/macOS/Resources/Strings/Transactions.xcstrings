        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "барои ҳисоб кардани маблағи аз ҳисоб гирифташаванда ҳанӯз қурб нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "hesaptan çekilecek tutarı hesaplamak için henüz kur yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "курсу ще немає, щоб порахувати, скільки списує рахунок"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
