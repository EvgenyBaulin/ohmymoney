        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z бәрін қайтарады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z баарын калыбына келтирет."
