{
  "sourceLanguage": "en",
  "strings": {
    "banksRu.cardCount.after": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün banklarda bir nəfərin aça biləcəyi %2$@ kartdan %1$@ kartınız var. Limit %3$@ tarixindən qüvvədədir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас %1$@ з %2$@ карт, дазволеных ва ўсіх банках. Ліміт дзейнічае з %3$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte %1$@ z %2$@ karet, které smíte mít ve všech bankách. Limit platí od %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$@ von %2$@ Karten, die eine Person bei allen Banken zusammen haben darf. Die Obergrenze gilt seit %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hold %1$@ of %2$@ cards a person may have across all banks. The cap has been in force since %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %1$@ de las %2$@ tarjetas permitidas entre todos los bancos. El límite está vigente desde el %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous détenez %1$@ cartes sur les %2$@ autorisées par personne, toutes banques confondues. Ce plafond s’applique depuis le %3$@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բոլոր բանկերում ունեք թույլատրելի %2$@ քարտից %1$@-ը։ Սահմանաչափը գործում է %3$@-ից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai %1$@ carte su un massimo di %2$@ presso tutte le banche. Il limite è in vigore dal %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全銀行で保有できるカード%2$@枚のうち、%1$@枚を保有しています。上限は%3$@から適用されています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველა ბანკში დასაშვები %2$@ ბარათიდან გაქვთ %1$@. ლიმიტი მოქმედებს %3$@-დან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық банкте ұстауға болатын %2$@ картаның %1$@ сізде бар. Шектеу %3$@ бастап күшінде."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 은행에서 보유할 수 있는 카드 %2$@개 중 %1$@개를 보유하고 있습니다. 한도는 %3$@부터 적용되었습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бардык банктар боюнча уруксат берилген %2$@ картанын %1$@ сизде бар. Чектөө %3$@ тартып күчүндө."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt %1$@ van de %2$@ kaarten die je bij alle banken samen mag hebben. De limiet geldt sinds %3$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz %1$@ z %2$@ kart, które można mieć we wszystkich bankach. Limit obowiązuje od %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem %1$@ de %2$@ cartões permitidos por pessoa em todos os bancos. O limite está em vigor desde %3$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem %1$@ de %2$@ cartões permitidos por pessoa em todos os bancos. O limite está em vigor desde %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карт во всех банках: %1$@ из %2$@ — столько можно держать на человека. Ограничение действует с %3$@."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шумо %1$@ аз %2$@ корти иҷозатдодашударо дар ҳамаи бонкҳо доред. Маҳдудият аз %3$@ амал мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm bankalarda sahip olunabilecek %2$@ kartın %1$@ kadarına sahipsiniz. Sınır %3$@ tarihinden beri yürürlükte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви маєте %1$@ із %2$@ карток, дозволених в усіх банках. Обмеження діє з %3$@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha banklarda bir kishiga ruxsat etilgan %2$@ ta kartadan sizda %1$@ ta bor. Cheklov %3$@dan amal qiladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có %1$@ trên tổng số %2$@ thẻ được phép có tại tất cả ngân hàng. Giới hạn có hiệu lực từ %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您持有 %1$@ 张银行卡，所有银行合计上限为 %2$@ 张。该上限自 %3$@ 起生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你持有 %1$@ 張卡，跨銀行持卡上限為 %2$@ 張。此上限自 %3$@ 起生效。"
          }
        }
      }
    },
