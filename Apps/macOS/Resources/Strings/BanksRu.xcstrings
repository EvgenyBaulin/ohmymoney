    "banksRu.cardCount.unused": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Картамі (%1$@) не плацілі %2$@ дзён або больш: закрыйце іх або карыстайцеся імі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Karten wurden seit mindestens %2$@ Tagen nicht zum Bezahlen genutzt. Schließe oder nutze sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cards nothing was paid with for %2$@ days or more: close or use them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarjetas sin pagos en %2$@ días o más: ciérralas o úsalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cartes inutilisées depuis au moins %2$@ jours : fermez-les ou utilisez-les."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ carte non sono state usate per pagare da almeno %2$@ giorni: chiudile o usale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ картамен %2$@ күн немесе одан көп уақыт төлем жасалмаған: жабыңыз немесе пайдаланыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kart bez płatności od co najmniej %2$@ dni: zamknij je lub z nich skorzystaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cartões sem pagamentos há %2$@ dias ou mais: cancele-os ou use-os."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карт, которыми не платили %2$@ дн. и дольше: %1$@ — закройте или пользуйтесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kart %2$@ gündür veya daha uzun süredir kullanılmadı: kapatın veya kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ карток без оплат протягом %2$@ днів або більше: закрийте їх або скористайтеся ними."
          }
        }
      }
    },
    "banksRu.cardCount.unusedNone": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе карты нядаўна выкарыстоўваліся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Karten wurden kürzlich genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every card was used lately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado todas las tarjetas recientemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les cartes ont été utilisées récemment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le carte sono state usate di recente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық карта жақында пайдаланылған."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie karty były ostatnio używane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os cartões foram usados recentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждой картой недавно платили."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kartlar yakın zamanda kullanıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі картки нещодавно використовувалися."
          }
        }
      }
    },
    "banksRu.cashback.note": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк за гэты год: каля %1$@. Звычайны кэшбэк не абкладаецца падаткам, але прызы і падарункі ад банка звыш %2$@ за год абкладаюцца; вялікі кэшбэк таксама прызнавалі даходам. Праграма не разлічвае падатак — удакладніце ў падатковай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Jahr erfasstes Cashback: etwa %1$@. Gewöhnliches Cashback ist steuerfrei. Für Gewinne und Geschenke einer Bank über %2$@ pro Jahr fallen Steuern an. Hohes Cashback wurde bereits als Einkommen gewertet. Die App berechnet keine Steuern. Erkundige dich beim Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback written this year: about %1$@. Ordinary cashback is not taxed, but prizes and gifts from a bank over %2$@ a year are, and a large cashback has been counted as income. The app works out no tax — check with the tax service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reembolsos registrados este año: unos %1$@. Los reembolsos habituales no tributan, pero los premios y regalos de un banco que superen %2$@ al año sí; también se ha considerado renta algún reembolso elevado. La app no calcula impuestos; consulta con la autoridad fiscal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback enregistré cette année : environ %1$@. Le cashback ordinaire n’est pas imposable, mais les prix et cadeaux d’une banque dépassant %2$@ par an le sont. Un cashback important a déjà été considéré comme un revenu. L’app ne calcule aucun impôt : vérifiez auprès du fisc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback registrato quest’anno: circa %1$@. Il cashback ordinario non è tassato, ma premi e regali di una banca oltre %2$@ all’anno sì; anche un cashback elevato è stato considerato reddito. L’app non calcola l’imposta: verifica con l’agenzia delle entrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Биыл енгізілген кэшбэк: шамамен %1$@. Кәдімгі кэшбэкке салық салынбайды, бірақ банктен алынған жүлделер мен сыйлықтардың жылына %2$@ асатын бөлігіне салық салынады; ірі кэшбэк те табыс деп танылған жағдайлар бар. Қолданба салықты есептемейді — салық қызметінен нақтылаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback zapisany w tym roku: około %1$@. Zwykły cashback nie jest opodatkowany, ale nagrody i prezenty od banku powyżej %2$@ rocznie już tak. Wysoki cashback bywa uznawany za dochód. Aplikacja nie oblicza podatku — sprawdź go w urzędzie skarbowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback registrado neste ano: cerca de %1$@. O cashback comum não é tributado, mas prêmios e presentes de um banco acima de %2$@ por ano são, e um cashback alto já foi considerado renda. O app não calcula impostos — consulte a autoridade fiscal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэка за год записано около %1$@. Обычный кэшбэк налогом не облагается, но призы и подарки от банка свыше %2$@ в год — облагаются, а крупный кэшбэк иногда относят к доходу. Налог приложение не считает — сверьтесь с ФНС."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yıl kaydedilen para iadesi: yaklaşık %1$@. Normal para iadeleri vergilendirilmez; ancak bankadan alınan ve yıllık %2$@ tutarını aşan ödül ve hediyeler vergilendirilir. Yüksek para iadeleri de gelir sayılmıştır. Uygulama vergi hesaplamaz; vergi dairesine danışın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешбек, записаний цього року: близько %1$@. Звичайний кешбек не оподатковується, але призи й подарунки від банку понад %2$@ на рік — так; великий кешбек також визнавали доходом. Застосунок не розраховує податок — уточніть у податковій службі."
          }
        }
      }
    },
    "banksRu.interest.due": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
