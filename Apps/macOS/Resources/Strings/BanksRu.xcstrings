        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — tỷ lệ thanh toán các khoản vay và thẻ trên thu nhập (thẻ được tính bằng 5 %% hạn mức)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — 贷款和信用卡还款额（信用卡按额度的 5 %% 计算）占收入的比例"
