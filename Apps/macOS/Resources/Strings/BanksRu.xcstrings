    "banksRu.interest.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стаўка — 13 %% для працэнтаў да 2,4 млн рублёў за год і 15 %% для сумы звыш гэтага; працэнты ва ўсіх банках сумуюцца. Удакладніце звесткі ў падатковай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Steuersatz beträgt 13 %% für Zinsen bis 2,4 Millionen Rubel pro Jahr und 15 %% darüber. Zinsen aller Banken werden zusammengerechnet. Prüfe die Beträge beim Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate is 13 %% up to 2.4 million rubles of interest a year and 15 %% above it; interest from all banks adds up. Check the figures with the tax service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo es del 13 %% para intereses de hasta 2,4 millones de rublos al año y del 15 %% para el exceso; se suman los intereses de todos los bancos. Comprueba las cifras con la autoridad fiscal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux est de 13 %% jusqu’à 2,4 millions de roubles d’intérêts par an, puis de 15 %% au-delà. Les intérêts de toutes les banques sont cumulés. Vérifiez les montants auprès du fisc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aliquota è del 13 %% fino a 2,4 milioni di rubli di interessi annui e del 15 %% oltre tale importo; gli interessi di tutte le banche si sommano. Verifica gli importi con l’agenzia delle entrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылына 2,4 млн рубльге дейінгі пайыздық табысқа 13 %%, одан асатын бөлігіне 15 %% мөлшерлеме қолданылады; барлық банктегі пайыздар қосылады. Деректерді салық қызметінен нақтылаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stawka wynosi 13 %% od odsetek do 2,4 mln rubli rocznie i 15 %% od nadwyżki. Odsetki ze wszystkich banków sumują się. Sprawdź kwoty w urzędzie skarbowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alíquota é de 13 %% até 2,4 milhões de rublos em juros por ano e 15 %% sobre o excedente; os juros de todos os bancos são somados. Confira os valores com a autoridade fiscal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка — 13 %% до 2,4 млн ₽ процентов в год и 15 %% сверху; проценты всех банков складываются. Сверьте цифры с ФНС."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık faiz gelirinin 2,4 milyon rubleye kadar olan kısmı için oran %% 13, üzerindeki kısım için %% 15'tir; tüm bankalardaki faiz gelirleri toplanır. Tutarları vergi dairesinden kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка — 13 %% для відсотків до 2,4 млн рублів на рік і 15 %% для суми понад цей поріг; відсотки в усіх банках підсумовуються. Перевірте суми в податковій службі."
          }
        }
      }
    },
