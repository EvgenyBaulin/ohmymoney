    "banksRu.pdn.bank": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — стаўленне плацяжоў па крэдытах і картах да даходу (для карты ўлічваецца 5 %% яе ліміту)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — Zahlungen für Kredite und Karten im Verhältnis zum Einkommen (bei Karten zählen 5 %% des Limits)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — payments on credits and cards (a card counts 5 %% of its limit) over income"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — pagos de créditos y tarjetas (para cada tarjeta se cuenta el 5 %% de su límite) respecto a los ingresos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : rapport entre les remboursements de crédits et de cartes (5 %% du plafond d’une carte) et les revenus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — rapporto tra pagamenti per prestiti e carte (per ogni carta si conta il 5 %% del limite) e reddito"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — несие мен карталар бойынша төлемдердің табысқа қатынасы (карта үшін лимиттің 5 %% есептеледі)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — stosunek spłat kredytów i kart do dochodu (dla karty liczy się 5 %% limitu)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — pagamentos de créditos e cartões (5 %% do limite de cada cartão) em relação à renda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — платежи по кредитам и картам (карта — 5 %% лимита) к доходу"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — kredi ve kart ödemelerinin gelire oranı (kart için limitin %% 5'i sayılır)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — відношення платежів за кредитами й картками до доходу (для картки враховується 5 %% ліміту)"
          }
        }
      }
    },
    "banksRu.pdn.cautious": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ калі банк улічыць 90 %% вашага даходу (%2$@) — даведачна, рашэнне прымае банк"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, wenn die Bank 90 %% deines Einkommens (%2$@) ansetzt. Dies dient zur Orientierung, die Bank entscheidet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ if the bank takes 90 %% of your income (%2$@) — a reference, the bank decides"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si el banco considera el 90 %% de tus ingresos (%2$@); es orientativo, el banco decide"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si la banque retient 90 %% de vos revenus (%2$@). À titre indicatif ; la banque décide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se la banca considera il 90 %% del tuo reddito (%2$@) — valore indicativo, decide la banca"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, егер банк табысыңыздың 90 %% (%2$@) есепке алса — бұл бағдар ғана, шешімді банк қабылдайды"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, jeśli bank uwzględni 90 %% Twojego dochodu (%2$@). To wartość orientacyjna — decyzję podejmuje bank."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se o banco considerar 90 %% da sua renda (%2$@) — valor de referência; o banco decide"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, если банк возьмёт 90 %% дохода (%2$@) — ориентир, решает банк"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka gelirinizin (%2$@) %% 90'ını esas alırsa %1$@ — bu bir tahmindir, kararı banka verir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, якщо банк врахує 90 %% вашого доходу (%2$@) — для довідки, рішення за банком"
          }
        }
      }
    },
