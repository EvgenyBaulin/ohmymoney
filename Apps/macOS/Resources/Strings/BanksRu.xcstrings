    "banksRu.interest.noTax": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz gəliri vergidən azad məbləğdən azdır: ödəniş yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнты меншыя за неабкладаемую суму: плаціць нічога не трэба."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úroky jsou pod hranicí osvobození od daně. Nemusíte nic platit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zinsen liegen unter dem Freibetrag. Es ist nichts zu zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest is below the sum free of tax: nothing to pay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses no superan el límite exento: no tienes que pagar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts sont inférieurs au montant exonéré : rien à payer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տոկոսները հարկից ազատված գումարից պակաս են․ վճարելու բան չկա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli interessi sono inferiori alla soglia esente: nessuna imposta da pagare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利息が非課税額を下回っているため、納税は不要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პროცენტი დასაბეგრ ზღვარზე ნაკლებია: გადასახდელი არაფერია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыздық табыс салық салынбайтын сомадан төмен: төлем жоқ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이자 소득이 비과세 한도 이하여서 납부할 세금이 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыздык киреше салык салынбаган суммадан аз: төлөм жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rente blijft onder de belastingvrije grens. Je hoeft niets te betalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsetki nie przekraczają kwoty wolnej od podatku. Nic do zapłaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros estão abaixo do limite de isenção: nada a pagar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros estão abaixo do valor isento: não há imposto a pagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты ниже необлагаемой суммы: платить нечего."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоизҳо аз маблағи аз андоз озод камтаранд: пардохт лозим нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz geliri vergiden muaf tutarın altında: ödenecek vergi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки менші за неоподатковувану суму: сплачувати нічого."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Foiz daromadi soliq solinmaydigan summadan kam: to‘lov yo‘q."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lãi dưới mức miễn thuế: không cần thanh toán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利息低于免税额度，无需缴税。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "利息低於免稅額，無須繳稅。"
          }
        }
      }
    },
    "banksRu.interest.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üçün faiz gəlirinə vergi: təxminən %2$@ — vergi xidmətinin bildirişi ilə %3$@ tarixinədək ödəyin. Təxmini hesablamadır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падатак на працэнты за %1$@: каля %2$@ — аплаціце да %3$@ паводле паведамлення падатковай. Папярэдні разлік."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Daň z úroků za %1$@: přibližně %2$@. Zaplaťte do %3$@ podle oznámení daňové správy. Jde o odhad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuer auf Zinsen für %1$@: etwa %2$@. Zahle nach Bescheid des Finanzamts bis %3$@. Dies ist eine Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax on interest for %1$@: about %2$@ — pay by %3$@ on the tax service's notice. An estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impuesto sobre los intereses de %1$@: unos %2$@; paga antes del %3$@ tras recibir la notificación de la autoridad fiscal. Es una estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impôt sur les intérêts de %1$@ : environ %2$@, à payer avant le %3$@ sur avis du fisc. Estimation."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ թ. տոկոսների հարկը՝ մոտ %2$@։ Վճարեք մինչև %3$@՝ հարկային ծառայության ծանուցմամբ։ Գումարը մոտավոր է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta sugli interessi per il %1$@: circa %2$@ — paga entro il %3$@ in base all’avviso dell’agenzia delle entrate. Importo stimato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の利息にかかる税額：約%2$@。税務当局からの通知に従い、%3$@までにお支払いください。概算です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ წლის პროცენტის გადასახადი: დაახლოებით %2$@ — გადაიხადეთ %3$@-მდე, საგადასახადო სამსახურის შეტყობინების საფუძველზე. თანხა სავარაუდოა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ үшін пайыздық табыс салығы: шамамен %2$@ — салық қызметінің хабарламасы бойынша %3$@ дейін төлеңіз. Болжалды есеп."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 이자 소득세: 약 %2$@. 세무 당국의 고지에 따라 %3$@까지 납부하세요. 추정 금액입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ үчүн пайыздык кирешеге салык: болжол менен %2$@ — салык кызматынын билдирүүсү боюнча %3$@ чейин төлөңүз. Бул болжолдуу эсеп."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Belasting op rente over %1$@: ongeveer %2$@. Betaal vóór %3$@ na ontvangst van de aanslag. Dit is een schatting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatek od odsetek za %1$@: około %2$@. Zapłać do %3$@ po otrzymaniu zawiadomienia z urzędu skarbowego. Kwota szacunkowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposto sobre juros de %1$@: cerca de %2$@ — pague até %3$@ após a notificação da autoridade fiscal. Valor estimado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposto sobre juros de %1$@: cerca de %2$@ — pague até %3$@ após notificação da autoridade tributária. Valor estimado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог с процентов за %1$@: около %2$@ — платить до %3$@ по уведомлению ФНС. Оценка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Андоз аз фоизҳо барои %1$@: тақрибан %2$@ — тибқи огоҳиномаи хадамоти андоз то %3$@ пардохт кунед. Ҳисоби тахминӣ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yılı faiz vergisi: yaklaşık %2$@ — vergi dairesinin bildirimi üzerine %3$@ tarihine kadar ödeyin. Bu tutar tahminidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Податок на відсотки за %1$@: близько %2$@ — сплатіть до %3$@ за повідомленням податкової служби. Орієнтовна сума."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uchun foiz daromadi solig‘i: taxminan %2$@ — soliq xizmati bildirishnomasiga ko‘ra %3$@gacha to‘lang. Bu taxminiy hisob."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuế trên lãi năm %1$@: khoảng %2$@ — thanh toán trước %3$@ theo thông báo của cơ quan thuế. Đây là số ước tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的利息税约为 %2$@，请根据税务部门的通知在 %3$@ 前缴纳。此为估算值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 年的利息稅額：約 %2$@。請依稅務機關通知於 %3$@ 前繳納。此為估算。"
          }
        }
      }
    },
