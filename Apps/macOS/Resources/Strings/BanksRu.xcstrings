            "value": "%1$@ — Zahlungen für Kredite und Karten im Verhältnis zum Einkommen (bei Karten zählen 5 %% des Limits)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — payments on credits and cards (a card counts 5 %% of its limit) over income"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — pagos de créditos y tarjetas (para cada tarjeta se cuenta el 5 %% de su límite) respecto a los ingresos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : rapport entre les remboursements de crédits et de cartes (5 %% du plafond d’une carte) et les revenus"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@՝ վարկերի և քարտերի վճարումների հարաբերակցությունը եկամտին (քարտի համար հաշվվում է սահմանաչափի 5 %%-ը)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — rapporto tra pagamenti per prestiti e carte (per ogni carta si conta il 5 %% del limite) e reddito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — 収入に対するローンとカードの返済額の割合（カードは限度額の5 %%で計算）"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — სესხებისა და ბარათების გადასახდელების შეფარდება შემოსავალთან (ბარათზე ითვლება ლიმიტის 5 %%)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — несие мен карталар бойынша төлемдердің табысқа қатынасы (карта үшін лимиттің 5 %% есептеледі)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — 소득 대비 대출 및 카드 상환액 비율. 카드는 한도의 5 %%로 계산"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — кредиттер жана карталар боюнча төлөмдөрдүн кирешеге катышы (карта үчүн лимиттин 5 %% эсептелет)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — betalingen voor leningen en kaarten (voor een kaart telt 5 %% van de limiet) ten opzichte van inkomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — stosunek spłat kredytów i kart do dochodu (dla karty liczy się 5 %% limitu)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — pagamentos de créditos e cartões (5 %% do limite de cada cartão) em relação à renda"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — pagamentos de créditos e cartões (cada cartão conta como 5 %% do limite) face aos rendimentos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — платежи по кредитам и картам (карта — 5 %% лимита) к доходу"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — таносуби пардохтҳои қарзу кортҳо ба даромад (барои корт 5 %% аз лимит ҳисоб мешавад)"
          }
        },
        "tr": {
          "stringUnit": {
