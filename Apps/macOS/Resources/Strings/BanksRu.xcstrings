        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üçün ≈ %2$@ məbləğinədək faiz gəliri vergidən azaddır (dekabrın əsas dərəcəsi məlum olanadək yekun deyil)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнты за %1$@ не абкладаюцца падаткам да ≈ %2$@ (сума ўдакладніцца пасля вызначэння ключавой стаўкі за снежань)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úroky za %1$@ jsou osvobozeny od daně přibližně do výše %2$@ (konečná částka bude známa po stanovení prosincové klíčové sazby)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinsen für %1$@ sind bis ≈ %2$@ steuerfrei. Der endgültige Betrag steht erst fest, wenn der Leitzins für Dezember bekannt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest for %1$@ is free of tax up to ≈ %2$@ (not final until the key rate of December is known)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intereses de %1$@ están exentos hasta ≈ %2$@ (no es definitivo hasta conocer el tipo de referencia de diciembre)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts de %1$@ sont exonérés d’impôt jusqu’à ≈ %2$@ (montant provisoire jusqu’à la publication du taux directeur de décembre)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ թ. տոկոսները չեն հարկվում մինչև ≈ %2$@ (վերջնական կդառնա, երբ հայտնի լինի դեկտեմբերի հիմնական դրույքաչափը)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli interessi per il %1$@ sono esenti da imposta fino a circa %2$@ (l’importo sarà definitivo quando sarà noto il tasso di riferimento di dicembre)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の利息は約%2$@まで非課税です（12月の政策金利が決まるまで確定しません）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ წლის პროცენტი არ იბეგრება ≈ %2$@-მდე (საბოლოო თანხა დეკემბრის ძირითადი განაკვეთის დადგენის შემდეგ გახდება ცნობილი)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ үшін пайыздық табыстың ≈ %2$@ дейінгі бөлігіне салық салынбайды (желтоқсандағы негізгі мөлшерлеме белгілі болғанша нақты емес)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 이자 소득은 약 %2$@까지 비과세됩니다. 12월 기준금리가 확정되면 금액이 정해집니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ үчүн пайыздык кирешенин ≈ %2$@ чейинки бөлүгүнө салык салынбайт (декабрь айындагы негизги чен белгилүү болгонго чейин так эмес)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rente over %1$@ is belastingvrij tot ≈ %2$@ (pas definitief als de beleidsrente van december bekend is)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsetki za %1$@ są wolne od podatku do około %2$@ (kwota nie jest ostateczna, dopóki nie będzie znana grudniowa stopa kluczowa)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Juros de %1$@ são isentos de imposto até ≈ %2$@ (valor sujeito à taxa básica de dezembro)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros de %1$@ estão isentos de imposto até ≈ %2$@ (valor não definitivo até ser conhecida a taxa de referência de dezembro)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты за %1$@ не облагаются до ≈ %2$@ (окончательно — после декабрьского заседания ЦБ)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоизҳо барои %1$@ то ≈ %2$@ аз андоз озоданд (то маълум шудани меъёри асосии моҳи декабр маблағ ниҳоӣ нест)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yılı faiz gelirinin yaklaşık %2$@ tutarına kadarı vergiden muaftır (aralık ayı politika faizi belirlenene kadar kesinleşmez)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсотки за %1$@ не оподатковуються в межах ≈ %2$@ (сума не остаточна, доки невідома ключова ставка за грудень)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uchun ≈ %2$@gacha foiz daromadiga soliq solinmaydi (dekabrdagi asosiy stavka ma’lum bo‘lmaguncha aniq emas)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lãi năm %1$@ được miễn thuế đến ≈ %2$@ (chưa chính thức cho đến khi biết lãi suất chủ chốt tháng 12)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的利息免税额度约为 %2$@（需待 12 月基准利率确定后才能最终确认）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 年的利息免稅額約為 %2$@（須待 12 月的基準利率確定後才能定案）。"
          }
        }
      }
    },
    "banksRu.interest.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İllik 2,4 milyon rubladək faiz gəlirinə 13 %%, artıq hissəyə 15 %% vergi tətbiq olunur; bütün banklardan faizlər toplanır. Məbləğləri vergi xidmətindən dəqiqləşdirin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стаўка — 13 %% для працэнтаў да 2,4 млн рублёў за год і 15 %% для сумы звыш гэтага; працэнты ва ўсіх банках сумуюцца. Удакладніце звесткі ў падатковай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazba činí 13 %% z úroků do 2,4 milionu rublů ročně a 15 %% z částky nad tento limit. Úroky ze všech bank se sčítají. Ověřte si údaje u daňové správy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Steuersatz beträgt 13 %% für Zinsen bis 2,4 Millionen Rubel pro Jahr und 15 %% darüber. Zinsen aller Banken werden zusammengerechnet. Prüfe die Beträge beim Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate is 13 %% up to 2.4 million rubles of interest a year and 15 %% above it; interest from all banks adds up. Check the figures with the tax service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo es del 13 %% para intereses de hasta 2,4 millones de rublos al año y del 15 %% para el exceso; se suman los intereses de todos los bancos. Comprueba las cifras con la autoridad fiscal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux est de 13 %% jusqu’à 2,4 millions de roubles d’intérêts par an, puis de 15 %% au-delà. Les intérêts de toutes les banques sont cumulés. Vérifiez les montants auprès du fisc."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարեկան մինչև 2,4 միլիոն ռուբլի տոկոսների համար դրույքաչափը 13 %% է, ավել մասի համար՝ 15 %%։ Բոլոր բանկերի տոկոսները գումարվում են։ Տվյալները ճշտեք հարկային ծառայությունից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aliquota è del 13 %% fino a 2,4 milioni di rubli di interessi annui e del 15 %% oltre tale importo; gli interessi di tutte le banche si sommano. Verifica gli importi con l’agenzia delle entrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間利息の240万ルーブル以下の部分には13 %%、超える部分には15 %%の税率が適用されます。利息は全銀行分が合算されます。金額は税務当局にご確認ください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წელიწადში 2,4 მილიონ რუბლამდე პროცენტი იბეგრება 13 %%-ით, მეტზე — 15 %%-ით; ყველა ბანკის პროცენტი ჯამდება. მონაცემები გადაამოწმეთ საგადასახადო სამსახურში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылына 2,4 млн рубльге дейінгі пайыздық табысқа 13 %%, одан асатын бөлігіне 15 %% мөлшерлеме қолданылады; барлық банктегі пайыздар қосылады. Деректерді салық қызметінен нақтылаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연간 이자 소득 240만 루블까지는 13 %%, 초과분에는 15 %%가 적용됩니다. 모든 은행의 이자를 합산합니다. 세무 당국에 금액을 확인하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылдык пайыздык кирешенин 2,4 миллион рублга чейинки бөлүгүнө 13 %%, андан ашкан бөлүгүнө 15 %% салык салынат; бардык банктардагы пайыздар кошулат. Сандарды салык кызматынан тактаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het tarief is 13 %% tot 2,4 miljoen roebel rente per jaar en 15 %% daarboven. Rente van alle banken wordt opgeteld. Controleer de bedragen bij de belastingdienst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stawka wynosi 13 %% od odsetek do 2,4 mln rubli rocznie i 15 %% od nadwyżki. Odsetki ze wszystkich banków sumują się. Sprawdź kwoty w urzędzie skarbowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alíquota é de 13 %% até 2,4 milhões de rublos em juros por ano e 15 %% sobre o excedente; os juros de todos os bancos são somados. Confira os valores com a autoridade fiscal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa é de 13 %% até 2,4 milhões de rublos de juros por ano e de 15 %% acima desse valor; somam-se os juros de todos os bancos. Confirme os valores junto da autoridade tributária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка — 13 %% до 2,4 млн ₽ процентов в год и 15 %% сверху; проценты всех банков складываются. Сверьте цифры с ФНС."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Меъёр барои фоизҳои то 2,4 миллион рубл дар як сол 13 %% ва барои қисми зиёдтар 15 %% аст; фоизҳои ҳамаи бонкҳо ҷамъ мешаванд. Маблағҳоро бо хадамоти андоз санҷед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık faiz gelirinin 2,4 milyon rubleye kadar olan kısmı için oran %% 13, üzerindeki kısım için %% 15'tir; tüm bankalardaki faiz gelirleri toplanır. Tutarları vergi dairesinden kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставка — 13 %% для відсотків до 2,4 млн рублів на рік і 15 %% для суми понад цей поріг; відсотки в усіх банках підсумовуються. Перевірте суми в податковій службі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yillik foiz daromadining 2,4 million rublgacha bo‘lgan qismiga 13 %%, undan oshgan qismiga 15 %% soliq solinadi; barcha banklardagi foiz daromadlari qo‘shiladi. Summalarni soliq xizmatidan tekshiring."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuế suất là 13 %% cho phần lãi đến 2,4 triệu rúp mỗi năm và 15 %% cho phần vượt mức; lãi từ tất cả ngân hàng được cộng lại. Hãy kiểm tra số liệu với cơ quan thuế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每年利息不超过 240 万卢布的部分税率为 13 %%，超出部分为 15 %%；所有银行的利息合并计算。请向税务部门核实金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全年利息不超過 240 萬盧布的部分稅率為 13 %%，超過部分為 15 %%；所有銀行的利息合併計算。請向稅務機關確認金額。"
          }
        }
      }
    },
