    "banksRu.cardCount.unused": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kartla %2$@ gün və ya daha çox müddətdir ödəniş edilməyib: onları bağlayın və ya istifadə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Картамі (%1$@) не плацілі %2$@ дзён або больш: закрыйце іх або карыстайцеся імі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ karet nebylo použito k platbě %2$@ dní nebo déle. Zrušte je nebo je použijte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Karten wurden seit mindestens %2$@ Tagen nicht zum Bezahlen genutzt. Schließe oder nutze sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cards nothing was paid with for %2$@ days or more: close or use them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarjetas sin pagos en %2$@ días o más: ciérralas o úsalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cartes inutilisées depuis au moins %2$@ jours : fermez-les ou utilisez-les."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ քարտով %2$@ օր կամ ավելի վճարում չի արվել․ փակեք կամ օգտագործեք դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ carte non sono state usate per pagare da almeno %2$@ giorni: chiudile o usale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@日以上支払いに使われていないカードが%1$@枚あります。解約するか、使用してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ბარათით %2$@ დღე ან მეტია არ გადაგიხდიათ: დახურეთ ან გამოიყენეთ ისინი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ картамен %2$@ күн немесе одан көп уақыт төлем жасалмаған: жабыңыз немесе пайдаланыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@일 이상 결제에 사용하지 않은 카드가 %1$@개 있습니다. 해지하거나 사용하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ күн же андан көп убакыт төлөм жасалбаган карталар: %1$@. Аларды жабыңыз же колдонуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kaarten zijn %2$@ dagen of langer niet gebruikt. Hef ze op of gebruik ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kart bez płatności od co najmniej %2$@ dni: zamknij je lub z nich skorzystaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cartões sem pagamentos há %2$@ dias ou mais: cancele-os ou use-os."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cartões sem pagamentos há %2$@ dias ou mais: cancele-os ou use-os."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карт, которыми не платили %2$@ дн. и дольше: %1$@ — закройте или пользуйтесь."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо %1$@ корт дар давоми %2$@ рӯз ё бештар пардохт нашудааст: онҳоро бандед ё истифода баред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kart %2$@ gündür veya daha uzun süredir kullanılmadı: kapatın veya kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ карток без оплат протягом %2$@ днів або більше: закрийте їх або скористайтеся ними."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ta kartadan %2$@ kun yoki undan ko‘p vaqt to‘lov qilinmagan: ularni yoping yoki ishlating."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ thẻ chưa dùng để thanh toán trong ít nhất %2$@ ngày: hãy đóng hoặc sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 张银行卡已连续 %2$@ 天或更久未用于支付：请注销或使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 張卡已有 %2$@ 天以上未付款：請註銷或使用。"
          }
        }
      }
    },
