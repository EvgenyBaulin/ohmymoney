{
  "sourceLanguage": "en",
  "strings": {
    "banksRu.cardCount.after": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас %1$@ з %2$@ карт, дазволеных ва ўсіх банках. Ліміт дзейнічае з %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$@ von %2$@ Karten, die eine Person bei allen Banken zusammen haben darf. Die Obergrenze gilt seit %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hold %1$@ of %2$@ cards a person may have across all banks. The cap has been in force since %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %1$@ de las %2$@ tarjetas permitidas entre todos los bancos. El límite está vigente desde el %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous détenez %1$@ cartes sur les %2$@ autorisées par personne, toutes banques confondues. Ce plafond s’applique depuis le %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai %1$@ carte su un massimo di %2$@ presso tutte le banche. Il limite è in vigore dal %3$@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық банкте ұстауға болатын %2$@ картаның %1$@ сізде бар. Шектеу %3$@ бастап күшінде."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz %1$@ z %2$@ kart, które można mieć we wszystkich bankach. Limit obowiązuje od %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem %1$@ de %2$@ cartões permitidos por pessoa em todos os bancos. O limite está em vigor desde %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карт во всех банках: %1$@ из %2$@ — столько можно держать на человека. Ограничение действует с %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm bankalarda sahip olunabilecek %2$@ kartın %1$@ kadarına sahipsiniz. Sınır %3$@ tarihinden beri yürürlükte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви маєте %1$@ із %2$@ карток, дозволених в усіх банках. Обмеження діє з %3$@."
          }
        }
      }
    },
    "banksRu.cardCount.before": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас %1$@ з %2$@ карт, дазволеных ва ўсіх банках. Ліміт пачне дзейнічаць %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$@ von %2$@ Karten, die eine Person bei allen Banken zusammen haben darf. Die Obergrenze gilt ab %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hold %1$@ of %2$@ cards a person may have across all banks. The cap comes into force on %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %1$@ de las %2$@ tarjetas permitidas entre todos los bancos. El límite entra en vigor el %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous détenez %1$@ cartes sur les %2$@ autorisées par personne, toutes banques confondues. Ce plafond s’applique à partir du %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai %1$@ carte su un massimo di %2$@ presso tutte le banche. Il limite entra in vigore il %3$@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық банкте ұстауға болатын %2$@ картаның %1$@ сізде бар. Шектеу %3$@ бастап күшіне енеді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz %1$@ z %2$@ kart, które można mieć we wszystkich bankach. Limit zacznie obowiązywać %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem %1$@ de %2$@ cartões permitidos por pessoa em todos os bancos. O limite entra em vigor em %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карт во всех банках: %1$@ из %2$@ — столько можно держать на человека. Ограничение начнёт действовать %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm bankalarda sahip olunabilecek %2$@ kartın %1$@ kadarına sahipsiniz. Sınır %3$@ tarihinde yürürlüğe giriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви маєте %1$@ із %2$@ карток, дозволених в усіх банках. Обмеження набуде чинності %3$@."
          }
        }
      }
    },
    "banksRu.cardCount.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Улічваюцца толькі карты ў праграме; канчатковыя звесткі — у рэестры банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die in der App erfassten Karten werden gezählt. Maßgeblich ist das Register der Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the cards written in the app are counted; the bank's register has the last word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se cuentan las tarjetas registradas en la app; prevalece el registro del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les cartes enregistrées dans l’app sont comptées. Le registre de la banque fait foi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono contate solo le carte registrate nell’app; fa fede il registro della banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек қолданбаға енгізілген карталар саналады; нақты дерек банк тізілімінде."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczą się tylko karty dodane do aplikacji. Decydują dane banku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os cartões registrados no app são contados; prevalece o cadastro do banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считаются только карты, записанные в приложении; последнее слово — за реестром банков."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca uygulamaya eklenen kartlar sayılır; bankanın kayıtları esas alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховано лише картки, записані в застосунку. Остаточні дані — у реєстрі банку."
          }
        }
      }
    },
    "banksRu.cardCount.line": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Карты: %1$@ з %2$@ · можна яшчэ %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten: %1$@ von %2$@ · Platz für %3$@ weitere"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards: %1$@ of %2$@ · room for %3$@ more"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjetas: %1$@ de %2$@ · puedes tener %3$@ más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartes : %1$@ sur %2$@ · encore %3$@ possibles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte: %1$@ su %2$@ · puoi averne altre %3$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Карталар: %2$@ ішінен %1$@ · тағы %3$@ алуға болады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty: %1$@ z %2$@ · pozostało: %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões: %1$@ de %2$@ · cabem mais %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карт: %1$@ из %2$@ · ещё можно %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartlar: %1$@ / %2$@ · %3$@ kart daha alınabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картки: %1$@ із %2$@ · можна відкрити ще %3$@"
          }
        }
      }
    },
