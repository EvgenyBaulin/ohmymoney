    "banksRu.interest.note": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падатак на працэнты за %1$@: каля %2$@ — аплаціце да %3$@ паводле паведамлення падатковай. Папярэдні разлік."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuer auf Zinsen für %1$@: etwa %2$@. Zahle nach Bescheid des Finanzamts bis %3$@. Dies ist eine Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax on interest for %1$@: about %2$@ — pay by %3$@ on the tax service's notice. An estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impuesto sobre los intereses de %1$@: unos %2$@; paga antes del %3$@ tras recibir la notificación de la autoridad fiscal. Es una estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impôt sur les intérêts de %1$@ : environ %2$@, à payer avant le %3$@ sur avis du fisc. Estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta sugli interessi per il %1$@: circa %2$@ — paga entro il %3$@ in base all’avviso dell’agenzia delle entrate. Importo stimato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ үшін пайыздық табыс салығы: шамамен %2$@ — салық қызметінің хабарламасы бойынша %3$@ дейін төлеңіз. Болжалды есеп."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatek od odsetek za %1$@: około %2$@. Zapłać do %3$@ po otrzymaniu zawiadomienia z urzędu skarbowego. Kwota szacunkowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposto sobre juros de %1$@: cerca de %2$@ — pague até %3$@ após a notificação da autoridade fiscal. Valor estimado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог с процентов за %1$@: около %2$@ — платить до %3$@ по уведомлению ФНС. Оценка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yılı faiz vergisi: yaklaşık %2$@ — vergi dairesinin bildirimi üzerine %3$@ tarihine kadar ödeyin. Bu tutar tahminidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Податок на відсотки за %1$@: близько %2$@ — сплатіть до %3$@ за повідомленням податкової служби. Орієнтовна сума."
          }
        }
      }
