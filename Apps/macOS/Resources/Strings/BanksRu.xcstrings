    "banksRu.cashback.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu il qeydə alınan keşbek: təxminən %1$@. Adi keşbek vergiyə cəlb olunmur, lakin bankdan alınan və illik %2$@ məbləğini aşan mükafat və hədiyyələr vergiyə cəlb olunur; böyük məbləğli keşbek də gəlir sayıla bilər. Tətbiq vergi hesablamır — vergi xidmətindən dəqiqləşdirin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэк за гэты год: каля %1$@. Звычайны кэшбэк не абкладаецца падаткам, але прызы і падарункі ад банка звыш %2$@ за год абкладаюцца; вялікі кэшбэк таксама прызнавалі даходам. Праграма не разлічвае падатак — удакладніце ў падатковай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Letos zaznamenaný cashback: přibližně %1$@. Běžný cashback se nedaní, ale výhry a dary od banky nad %2$@ ročně ano. Za příjem byl považován i vysoký cashback. Aplikace daň nevypočítává. Ověřte si údaje u daňové správy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Jahr erfasstes Cashback: etwa %1$@. Gewöhnliches Cashback ist steuerfrei. Für Gewinne und Geschenke einer Bank über %2$@ pro Jahr fallen Steuern an. Hohes Cashback wurde bereits als Einkommen gewertet. Die App berechnet keine Steuern. Erkundige dich beim Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback written this year: about %1$@. Ordinary cashback is not taxed, but prizes and gifts from a bank over %2$@ a year are, and a large cashback has been counted as income. The app works out no tax — check with the tax service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reembolsos registrados este año: unos %1$@. Los reembolsos habituales no tributan, pero los premios y regalos de un banco que superen %2$@ al año sí; también se ha considerado renta algún reembolso elevado. La app no calcula impuestos; consulta con la autoridad fiscal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback enregistré cette année : environ %1$@. Le cashback ordinaire n’est pas imposable, mais les prix et cadeaux d’une banque dépassant %2$@ par an le sont. Un cashback important a déjà été considéré comme un revenu. L’app ne calcule aucun impôt : vérifiez auprès du fisc."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս տարի գրանցված քեշբեքը՝ մոտ %1$@։ Սովորական քեշբեքը չի հարկվում, սակայն բանկի մրցանակներն ու նվերները հարկվում են, եթե տարեկան գերազանցում են %2$@-ը։ Խոշոր քեշբեքը կարող է համարվել եկամուտ։ Հավելվածը հարկ չի հաշվարկում․ ճշտեք հարկային ծառայությունից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback registrato quest’anno: circa %1$@. Il cashback ordinario non è tassato, ma premi e regali di una banca oltre %2$@ all’anno sì; anche un cashback elevato è stato considerato reddito. L’app non calcola l’imposta: verifica con l’agenzia delle entrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今年登録されたキャッシュバック：約%1$@。通常のキャッシュバックは非課税ですが、銀行からの賞品や贈答品は年間%2$@を超えると課税されます。高額なキャッシュバックが所得とみなされた例もあります。アプリでは税額を計算しません。税務当局にご確認ください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წელს აღრიცხული ქეშბექი: დაახლოებით %1$@. ჩვეულებრივი ქეშბექი არ იბეგრება, მაგრამ ბანკის პრიზები და საჩუქრები იბეგრება, თუ წელიწადში %2$@-ს აღემატება. დიდი ქეშბექიც შეიძლება შემოსავლად ჩაითვალოს. აპი გადასახადს არ ითვლის — გადაამოწმეთ საგადასახადო სამსახურში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Биыл енгізілген кэшбэк: шамамен %1$@. Кәдімгі кэшбэкке салық салынбайды, бірақ банктен алынған жүлделер мен сыйлықтардың жылына %2$@ асатын бөлігіне салық салынады; ірі кэшбэк те табыс деп танылған жағдайлар бар. Қолданба салықты есептемейді — салық қызметінен нақтылаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올해 기록된 캐시백: 약 %1$@. 일반 캐시백은 과세되지 않지만, 은행의 경품과 선물은 연간 %2$@ 초과분에 과세되며 큰 금액의 캐시백이 소득으로 인정된 사례도 있습니다. 앱은 세금을 계산하지 않습니다. 세무 당국에 확인하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Быйыл жазылган кэшбэк: болжол менен %1$@. Кадимки кэшбэкке салык салынбайт, бирок банктан алынган байгелер менен белектер жылына %2$@ ашса, салык салынат. Чоң кэшбэк да киреше катары эсептелген учурлар болгон. Колдонмо салыкты эсептебейт — салык кызматынан тактаңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit jaar geregistreerde cashback: ongeveer %1$@. Gewone cashback is onbelast, maar over prijzen en cadeaus van een bank boven %2$@ per jaar betaal je belasting. Hoge cashback is eerder als inkomen aangemerkt. De app berekent geen belasting. Controleer dit bij de belastingdienst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback zapisany w tym roku: około %1$@. Zwykły cashback nie jest opodatkowany, ale nagrody i prezenty od banku powyżej %2$@ rocznie już tak. Wysoki cashback bywa uznawany za dochód. Aplikacja nie oblicza podatku — sprawdź go w urzędzie skarbowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback registrado neste ano: cerca de %1$@. O cashback comum não é tributado, mas prêmios e presentes de um banco acima de %2$@ por ano são, e um cashback alto já foi considerado renda. O app não calcula impostos — consulte a autoridade fiscal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cashback registado este ano: cerca de %1$@. O cashback normal não é tributado, mas os prémios e ofertas de um banco acima de %2$@ por ano são, e valores elevados de cashback já foram considerados rendimentos. A app não calcula impostos — consulte a autoridade tributária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэка за год записано около %1$@. Обычный кэшбэк налогом не облагается, но призы и подарки от банка свыше %2$@ в год — облагаются, а крупный кэшбэк иногда относят к доходу. Налог приложение не считает — сверьтесь с ФНС."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшбэки имсол сабтшуда: тақрибан %1$@. Кэшбэки одӣ андоз надорад, аммо бурдҳо ва туҳфаҳои бонк аз %2$@ дар як сол зиёд бошанд, андоз доранд. Кэшбэки калон низ метавонад даромад ҳисоб шавад. Барнома андозро ҳисоб намекунад — аз хадамоти андоз пурсед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yıl kaydedilen para iadesi: yaklaşık %1$@. Normal para iadeleri vergilendirilmez; ancak bankadan alınan ve yıllık %2$@ tutarını aşan ödül ve hediyeler vergilendirilir. Yüksek para iadeleri de gelir sayılmıştır. Uygulama vergi hesaplamaz; vergi dairesine danışın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешбек, записаний цього року: близько %1$@. Звичайний кешбек не оподатковується, але призи й подарунки від банку понад %2$@ на рік — так; великий кешбек також визнавали доходом. Застосунок не розраховує податок — уточніть у податковій службі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yil qayd etilgan keshbek: taxminan %1$@. Oddiy keshbekka soliq solinmaydi, ammo bankdan olingan yillik %2$@dan ortiq sovrin va sovg‘alarga soliq solinadi. Katta keshbek ham daromad deb hisoblangan holatlar bor. Ilova soliqni hisoblamaydi — soliq xizmatidan tekshiring."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tiền đã ghi trong năm nay: khoảng %1$@. Hoàn tiền thông thường không chịu thuế, nhưng giải thưởng và quà tặng từ ngân hàng trên %2$@ mỗi năm thì có; khoản hoàn tiền lớn cũng từng được tính là thu nhập. Ứng dụng không tính thuế — hãy kiểm tra với cơ quan thuế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今年记录的返现约为 %1$@。普通返现无需纳税，但银行奖品和礼品每年超过 %2$@ 的部分需要纳税，大额返现也曾被计入收入。App 不计算税额，请向税务部门核实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今年記錄的現金回饋：約 %1$@。一般現金回饋免稅，但銀行獎品和禮品每年超過 %2$@ 的部分須課稅，大額現金回饋也曾被列為收入。App 不計算稅額，請向稅務機關確認。"
          }
        }
      }
    },
    "banksRu.interest.due": {
