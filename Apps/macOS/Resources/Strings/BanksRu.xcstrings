    "banksRu.sbp.fee": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsuz limiti aşdıqda bank təxminən %1$@ komissiya tuta bilər (hər köçürmənin limiti aşan hissəsinin 0.5 %%-i, hər köçürmə üçün ən çox %2$@). Bankınızın şərtlərini yoxlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Звыш бясплатнага ліміту банк можа спагнаць каля %1$@ (0,5 %% ад часткі кожнага пераводу звыш ліміту, не больш за %2$@ за перавод). Праверце ўмовы банка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po překročení bezplatného limitu si banka může účtovat přibližně %1$@ (0,5 %% z části každého převodu nad limit, nejvýše %2$@ za převod). Ověřte si podmínky své banky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über dem kostenlosen Limit kann die Bank etwa %1$@ berechnen (0,5 %% des Betrags jeder Überweisung über dem Limit, höchstens %2$@ pro Überweisung). Prüfe die Konditionen deiner Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past the free limit the bank may take about %1$@ (0.5 %% of each transfer's part past it, at most %2$@ a transfer). Check your bank's conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al superar el límite gratuito, el banco puede cobrar unos %1$@ (el 0,5 %% de la parte de cada transferencia que supere el límite, hasta %2$@ por transferencia). Consulta las condiciones de tu banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà du plafond gratuit, la banque peut prélever environ %1$@ (0,5 %% de la part de chaque virement dépassant le plafond, avec un maximum de %2$@ par virement). Vérifiez les conditions de votre banque."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվճար սահմանաչափը գերազանցելու դեպքում բանկը կարող է գանձել մոտ %1$@ (յուրաքանչյուր փոխանցման՝ սահմանաչափը գերազանցող մասի 0,5 %%-ը, բայց ոչ ավելի, քան %2$@՝ մեկ փոխանցման համար)։ Ստուգեք ձեր բանկի պայմանները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oltre il limite gratuito, la banca potrebbe addebitare circa %1$@ (lo 0,5 %% della parte di ogni bonifico oltre il limite, fino a %2$@ per bonifico). Verifica le condizioni della tua banca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料上限を超えると、銀行から約%1$@の手数料がかかる場合があります（各送金の上限超過分の0.5 %%、1回あたり最大%2$@）。銀行の条件をご確認ください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უფასო ლიმიტის გადაჭარბებისას ბანკმა შეიძლება ჩამოგაჭრათ დაახლოებით %1$@ (თითოეული გადარიცხვის ლიმიტს გადაცილებული ნაწილის 0.5 %%, მაქსიმუმ %2$@ თითო გადარიცხვაზე). გადაამოწმეთ თქვენი ბანკის პირობები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тегін лимиттен асқан кезде банк шамамен %1$@ алуы мүмкін (әр аударымның лимиттен асқан бөлігінің 0.5 %%, бір аударым үшін ең көбі %2$@). Банкіңіздің шарттарын тексеріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 한도 초과 시 은행에서 약 %1$@의 수수료를 부과할 수 있습니다. 건별 한도 초과분의 0.5 %%, 이체당 최대 %2$@입니다. 은행의 이용 조건을 확인하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акысыз лимиттен ашканда банк болжол менен %1$@ алышы мүмкүн (ар бир которуунун лимиттен ашкан бөлүгүнүн 0,5 %%, бир которуу үчүн эң көп дегенде %2$@). Банкыңыздын шарттарын текшериңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boven de gratis limiet kan de bank ongeveer %1$@ in rekening brengen (0,5 %% van het deel van elke overboeking boven de limiet, maximaal %2$@ per overboeking). Controleer de voorwaarden van je bank."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po przekroczeniu darmowego limitu bank może pobrać około %1$@ (0,5 %% części każdego przelewu ponad limit, maksymalnie %2$@ za przelew). Sprawdź warunki banku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acima do limite gratuito, o banco pode cobrar cerca de %1$@ (0,5 %% da parcela de cada transferência que exceder o limite, até %2$@ por transferência). Confira as condições do banco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acima do limite gratuito, o banco pode cobrar cerca de %1$@ (0,5 %% da parte de cada transferência que excede o limite, até %2$@ por transferência). Consulte as condições do seu banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверх бесплатного лимита банк может взять около %1$@ (0,5 %% от части каждого перевода сверх лимита, не больше %2$@ за перевод). Уточните условия в банке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баъд аз лимити ройгон бонк метавонад тақрибан %1$@ ситонад (0,5 %% аз қисми ҳар интиқол, ки аз лимит зиёд аст, то %2$@ барои як интиқол). Шартҳои бонкатонро санҷед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz limit aşıldığında banka yaklaşık %1$@ ücret alabilir (her transferin limiti aşan kısmının %% 0,5'i, transfer başına en fazla %2$@). Bankanızın koşullarını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Понад безкоштовний ліміт банк може взяти близько %1$@ (0,5 %% від частини кожного переказу понад ліміт, не більше %2$@ за переказ). Перевірте умови вашого банку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepul limitdan oshganda bank taxminan %1$@ olishi mumkin (har bir o‘tkazmaning limitdan oshgan qismidan 0,5 %%, har bir o‘tkazma uchun ko‘pi bilan %2$@). Bank shartlarini tekshiring."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi vượt hạn mức miễn phí, ngân hàng có thể thu khoảng %1$@ (0,5 %% phần vượt mức của mỗi giao dịch, tối đa %2$@ mỗi giao dịch). Hãy kiểm tra điều kiện của ngân hàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出免费额度后，银行可能收取约 %1$@ 的手续费（每笔转账超出部分的 0.5 %%，每笔最多 %2$@）。请查看银行的具体条款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過免費額度後，銀行可能收取約 %1$@（每筆轉帳超額部分的 0.5 %%，每筆最多 %2$@）。請確認銀行條款。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
