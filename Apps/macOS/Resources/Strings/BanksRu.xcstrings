      }
    },
    "banksRu.pdn.cautious": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank gəlirinizin 90 %%-ni (%2$@) nəzərə alsa: %1$@ — təxmini göstəricidir, qərarı bank verir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ калі банк улічыць 90 %% вашага даходу (%2$@) — даведачна, рашэнне прымае банк"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ při započtení 90 %% vašeho příjmu (%2$@) bankou. Jde o orientační údaj, rozhoduje banka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, wenn die Bank 90 %% deines Einkommens (%2$@) ansetzt. Dies dient zur Orientierung, die Bank entscheidet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ if the bank takes 90 %% of your income (%2$@) — a reference, the bank decides"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si el banco considera el 90 %% de tus ingresos (%2$@); es orientativo, el banco decide"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si la banque retient 90 %% de vos revenus (%2$@). À titre indicatif ; la banque décide."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, եթե բանկը հաշվի առնի ձեր եկամտի 90 %%-ը (%2$@)։ Սա կողմնորոշիչ է․ որոշումը բանկինն է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se la banca considera il 90 %% del tuo reddito (%2$@) — valore indicativo, decide la banca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行が収入の90 %%（%2$@）を採用した場合は%1$@。参考値です。銀行の判断によります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, თუ ბანკი თქვენი შემოსავლის 90 %%-ს (%2$@) გაითვალისწინებს — საორიენტაციო მაჩვენებელია, გადაწყვეტილებას ბანკი იღებს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, егер банк табысыңыздың 90 %% (%2$@) есепке алса — бұл бағдар ғана, шешімді банк қабылдайды"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행이 소득의 90 %%(%2$@)를 인정할 경우 %1$@입니다. 참고용이며 은행이 결정합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк кирешеңиздин 90 %% эске алса, %1$@ (%2$@) — бул болжол, чечимди банк кабыл алат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ als de bank 90 %% van je inkomen (%2$@) meerekent. Dit is een richtlijn; de bank beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, jeśli bank uwzględni 90 %% Twojego dochodu (%2$@). To wartość orientacyjna — decyzję podejmuje bank."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se o banco considerar 90 %% da sua renda (%2$@) — valor de referência; o banco decide"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se o banco considerar 90 %% dos seus rendimentos (%2$@) — valor de referência; o banco decide"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, если банк возьмёт 90 %% дохода (%2$@) — ориентир, решает банк"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ агар бонк 90 %% даромади шуморо (%2$@) ба ҳисоб гирад — тахмин аст, бонк қарор мекунад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka gelirinizin (%2$@) %% 90'ını esas alırsa %1$@ — bu bir tahmindir, kararı banka verir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, якщо банк врахує 90 %% вашого доходу (%2$@) — для довідки, рішення за банком"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank daromadingizning 90 %%ini (%2$@) hisobga olsa, %1$@ — bu taxmin, qarorni bank qabul qiladi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nếu ngân hàng tính 90 %% thu nhập của bạn (%2$@) — chỉ để tham khảo, ngân hàng sẽ quyết định"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若银行按您收入的 90 %%（%2$@）计算，则为 %1$@。仅供参考，具体由银行决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若銀行採計你收入（%2$@）的 90 %%：%1$@。僅供參考，以銀行決定為準。"
          }
        }
      }
    },
