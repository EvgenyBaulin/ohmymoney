        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — kredit və kart ödənişlərinin gəlirə nisbəti (kart üzrə limitin 5 %%-i sayılır)"
          }
        },
        "be": {
          "stringUnit": {
