    "banksRu.sbp.fee": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Звыш бясплатнага ліміту банк можа спагнаць каля %1$@ (0,5 %% ад часткі кожнага пераводу звыш ліміту, не больш за %2$@ за перавод). Праверце ўмовы банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über dem kostenlosen Limit kann die Bank etwa %1$@ berechnen (0,5 %% des Betrags jeder Überweisung über dem Limit, höchstens %2$@ pro Überweisung). Prüfe die Konditionen deiner Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past the free limit the bank may take about %1$@ (0.5 %% of each transfer's part past it, at most %2$@ a transfer). Check your bank's conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al superar el límite gratuito, el banco puede cobrar unos %1$@ (el 0,5 %% de la parte de cada transferencia que supere el límite, hasta %2$@ por transferencia). Consulta las condiciones de tu banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà du plafond gratuit, la banque peut prélever environ %1$@ (0,5 %% de la part de chaque virement dépassant le plafond, avec un maximum de %2$@ par virement). Vérifiez les conditions de votre banque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oltre il limite gratuito, la banca potrebbe addebitare circa %1$@ (lo 0,5 %% della parte di ogni bonifico oltre il limite, fino a %2$@ per bonifico). Verifica le condizioni della tua banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тегін лимиттен асқан кезде банк шамамен %1$@ алуы мүмкін (әр аударымның лимиттен асқан бөлігінің 0.5 %%, бір аударым үшін ең көбі %2$@). Банкіңіздің шарттарын тексеріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po przekroczeniu darmowego limitu bank może pobrać około %1$@ (0,5 %% części każdego przelewu ponad limit, maksymalnie %2$@ za przelew). Sprawdź warunki banku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acima do limite gratuito, o banco pode cobrar cerca de %1$@ (0,5 %% da parcela de cada transferência que exceder o limite, até %2$@ por transferência). Confira as condições do banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверх бесплатного лимита банк может взять около %1$@ (0,5 %% от части каждого перевода сверх лимита, не больше %2$@ за перевод). Уточните условия в банке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz limit aşıldığında banka yaklaşık %1$@ ücret alabilir (her transferin limiti aşan kısmının %% 0,5'i, transfer başına en fazla %2$@). Bankanızın koşullarını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Понад безкоштовний ліміт банк може взяти близько %1$@ (0,5 %% від частини кожного переказу понад ліміт, не більше %2$@ за переказ). Перевірте умови вашого банку."
          }
        }
      }
    }
  },
  "version": "1.0"
}
