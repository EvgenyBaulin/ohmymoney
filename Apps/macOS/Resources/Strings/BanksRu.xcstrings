    "banksRu.cardCount.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız tətbiqdə qeyd olunan kartlar sayılır; dəqiq məlumat bankın reyestrindədir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Улічваюцца толькі карты ў праграме; канчатковыя звесткі — у рэестры банка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítají se jen karty zadané v aplikaci. Rozhodující je evidence banky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die in der App erfassten Karten werden gezählt. Maßgeblich ist das Register der Bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the cards written in the app are counted; the bank's register has the last word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se cuentan las tarjetas registradas en la app; prevalece el registro del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les cartes enregistrées dans l’app sont comptées. Le registre de la banque fait foi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվվում են միայն հավելվածում գրանցված քարտերը։ Վերջնական տվյալները բանկի գրանցամատյանում են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono contate solo le carte registrate nell’app; fa fede il registro della banca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに登録されたカードのみを集計しています。正確な情報は銀行の登録内容をご確認ください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ითვლება მხოლოდ აპში დამატებული ბარათები. საბოლოო მონაცემები ბანკის რეესტრშია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек қолданбаға енгізілген карталар саналады; нақты дерек банк тізілімінде."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 기록된 카드만 집계됩니다. 최종 내역은 은행에서 확인하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмого жазылган карталар гана эсептелет; так маалымат банкта."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen kaarten in de app worden geteld. Het register van de bank is leidend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczą się tylko karty dodane do aplikacji. Decydują dane banku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os cartões registrados no app são contados; prevalece o cadastro do banco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só são contados os cartões registados na app; prevalece o registo do banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считаются только карты, записанные в приложении; последнее слово — за реестром банков."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо кортҳои дар барнома сабтшуда ҳисоб мешаванд; маълумоти бонк дақиқтар аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca uygulamaya eklenen kartlar sayılır; bankanın kayıtları esas alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховано лише картки, записані в застосунку. Остаточні дані — у реєстрі банку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat ilovaga kiritilgan kartalar hisoblanadi; yakuniy ma’lumot bank reyestrida."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tính các thẻ đã ghi trong ứng dụng; thông tin của ngân hàng là căn cứ cuối cùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅统计 App 中记录的银行卡，具体以银行登记信息为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅計算 App 中記錄的卡片；以銀行登記資料為準。"
          }
        }
      }
    },
