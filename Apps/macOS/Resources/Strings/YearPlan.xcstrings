    "year.tax.question": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Летась было «%1$@» на суму %2$@. Запланаваць на %3$@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letztes Jahr gab es „%1$@“, %2$@. Für %3$@ planen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last year there was “%1$@”, %2$@. Plan it for %3$@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El año pasado hubo «%1$@», %2$@. ¿Planificarlo para %3$@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'an dernier il y avait « %1$@ », %2$@. Le prévoir pour %3$@ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anno scorso c’era “%1$@”, %2$@. Vuoi pianificarlo per %3$@?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Былтыр “%1$@” болды, %2$@. %3$@ күніне жоспарлау керек пе?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Былтыр «%1$@» үчүн %2$@ сарпталган. Аны %3$@ үчүн пландайсызбы?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zeszłym roku: „%1$@”, %2$@. Zaplanować na %3$@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No ano passado houve “%1$@”, %2$@. Planejar para %3$@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прошлом году был платёж «%1$@» на %2$@. Запланировать к %3$@?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Соли гузашта «%1$@» буд: %2$@. Онро барои %3$@ ба нақша гиред?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen yıl “%1$@” vardı: %2$@. %3$@ için planlansın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Минулого року було «%1$@», %2$@. Запланувати це на %3$@?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan yili “%1$@” bo‘lgan, %2$@. Uni %3$@ uchun rejalashtirasizmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去年有「%1$@」，金額為 %2$@。要將它加入 %3$@ 的計畫嗎？"
          }
        }
      }
    },
