        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кіріс 10 %%-дан артық өсті. Резервті %@ дейін арттыру керек пе?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochód wzrósł o ponad 10 %%. Zwiększyć bufor do %@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A receita aumentou mais de 10 %%. Aumentar a reserva para %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход вырос больше чем на 10 %%. Повысить буфер до %@?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
