    "year.range.both": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "as usual %1$@, as in a dear month %2$@"
          }
        },
        "es": {
          "stringUnit": {
