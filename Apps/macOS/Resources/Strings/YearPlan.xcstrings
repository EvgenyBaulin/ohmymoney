    "year.buffer.raise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income grew by more than 10 %%. Raise the buffer to %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso subió más de un 10 %%. ¿Subir el colchón a %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le revenu a augmenté de plus de 10 %%. Relever la réserve à %@ ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход вырос больше чем на 10 %%. Повысить буфер до %@?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід виріс більш як на 10 %%. Підвищити буфер до %@?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кіріс 10 %%-дан артық өсті. Резервті %@ дейін арттыру керек пе?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahme ist um mehr als 10 %% gewachsen. Den Puffer auf %@ erhöhen?"
