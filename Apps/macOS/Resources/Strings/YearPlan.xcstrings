    "year.buffer.form.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero switches the buffer off. The income of this month is noted with it: when income grows by more than 10 %, the app offers to raise the buffer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноль выключает буфер. Вместе с ним запоминается доход этого месяца: когда доход вырастет больше чем на 10 %, приложение предложит повысить буфер."
          }
        }
      }
    },
    "year.buffer.form.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buffer of the month"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер месяца"
          }
        }
      }
    },
    "year.buffer.free": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can spend to the end of the month: %1$@ (buffer %2$@ held back)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До конца месяца можно потратить: %1$@ (буфер %2$@ отложен)"
          }
        }
      }
    },
    "year.buffer.marks": {
