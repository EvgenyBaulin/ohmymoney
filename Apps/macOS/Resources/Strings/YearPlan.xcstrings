    "year.limits.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасля месяца павышаны ліміт вернецца да звычайнай сумы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein für einen Monat erhöhtes Limit kehrt danach zu seinem üblichen Betrag zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit raised for one month goes back to its usual amount after it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un límite subido para un mes vuelve a su importe habitual después"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plafond relevé pour un seul mois revient à son montant habituel ensuite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un limite aumentato per un mese torna all’importo abituale il mese successivo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір айға арттырылған лимит содан кейін әдеттегі сомасына қайтады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit podniesiony na jeden miesiąc wraca potem do zwykłej kwoty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um limite aumentado por um mês volta ao valor habitual depois"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит, поднятый на один месяц, после него возвращается к обычному"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aylığına artırılan limit, sonraki ay olağan tutarına döner"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт, піднятий на один місяць, після нього повертається до звичайної суми"
          }
        }
      }
    },
