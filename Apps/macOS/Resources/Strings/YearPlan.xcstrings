    "year.advice.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі прапановы: без вашага адказу нічога не запісваецца"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Angebote: Nichts wird geschrieben, bis Sie antworten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offers only: nothing is written until you answer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo propuestas: no se escribe nada hasta que responda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propositions seulement : rien n'est noté tant que vous n'avez pas répondu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo suggerimenti: nulla viene salvato finché non rispondi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек ұсыныстар: жауап бермейінше ештеңе жазылмайды"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сунуштар гана: жообуңузга чейин эч нерсе сакталбайт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To tylko propozycje. Nic nie zostanie zapisane bez Twojej odpowiedzi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas sugestões: nada é alterado até você responder"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только предложения: без вашего ответа ничего не записывается"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо пешниҳодҳо: то ҷавоби шумо чизе сабт намешавад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca öneriler: siz yanıtlayana kadar hiçbir şey kaydedilmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише пропозиції: нічого не записується, доки ви не відповісте"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat takliflar: javobingizsiz hech narsa yozilmaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供參考，回覆前不會記錄任何內容"
          }
        }
      }
    },
