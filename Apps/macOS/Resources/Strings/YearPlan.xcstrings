    "year.forecast.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Той жа месяц летась з улікам росту за апошнія тры месяцы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Monat im Vorjahr, um das Wachstum der letzten drei Monate erhöht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same month last year, grown by the last three months"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo mes del año pasado, crecido según los últimos tres meses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même mois l'an dernier, augmenté de la tendance des trois derniers mois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso mese dell’anno scorso, adeguato in base agli ultimi tre mesi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Былтырғы сол ай, соңғы үш ай өсімін ескеріп"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam miesiąc ubiegłego roku, z uwzględnieniem wzrostu z ostatnich trzech miesięcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo mês do ano passado, ajustado pela alta dos últimos três meses"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тот же месяц прошлого года с поправкой на рост последних трёх месяцев"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen yılın aynı ayı, son üç ayın artışına göre güncellendi"
