    "year.template.save.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The articles of the event and their shares of the budget are kept. The template is offered with the ready ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan los artículos del evento y sus partes del presupuesto. La plantilla se ofrece junto a las listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les postes de l'événement et leur part du budget sont gardés. Le modèle est proposé avec les modèles prêts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статьи события и их доли бюджета сохранятся. Шаблон появится рядом с готовыми."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Статті події та їхні частки бюджету зберігаються. Шаблон пропонується разом з готовими."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оқиға баптары мен бюджеттегі үлестері сақталады. Үлгі дайын үлгілермен бірге ұсынылады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Posten des Ereignisses und ihre Anteile am Budget bleiben erhalten. Die Vorlage wird zusammen mit den fertigen angeboten."
          }
        }
      }
    },
