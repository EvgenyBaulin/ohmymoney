    "year.reserve.question": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Здаецца, «%1$@» паўторыцца прыкладна на суму %2$@ каля %3$@. Пачаць адкладаць?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sieht so aus, als käme „%1$@“ wieder, etwa %2$@ um %3$@. Dafür ein Sparen beginnen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like “%1$@” comes again, about %2$@ around %3$@. Start a saving for it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que «%1$@» vuelve, unos %2$@ alrededor del %3$@. ¿Empezar un ahorro para ello?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On dirait que « %1$@ » revient, environ %2$@ vers %3$@. Commencer une épargne pour cela ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che “%1$@” si ripeta: circa %2$@ intorno a %3$@. Vuoi iniziare a risparmiare?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” қайта болатын сияқты, шамамен %2$@, уақыты %3$@. Оған жинауды бастау керек пе?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, снова «%1$@», около %2$@ ближе к %3$@. Завести копилку?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, «%1$@» повертається, близько %2$@ навколо %3$@. Почати накопичення на це?"
          }
        }
      }
    },
