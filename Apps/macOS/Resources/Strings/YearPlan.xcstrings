            "value": "Une partie en devise sans taux est laissée de côté du plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano non include un importo in una valuta senza tasso di cambio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бағамы жоқ валютадағы жазбалар жоспарға кірмейді."
          }
        },
        "ru": {
          "stringUnit": {
