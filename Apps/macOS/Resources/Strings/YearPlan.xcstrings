        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usual limit: %@. After this month it applies again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite habitual: %@. Tras este mes vuelve a aplicarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plafond habituel : %@. Après ce mois, il s'applique de nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычный лимит: %@. После этого месяца он действует снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звичайний ліміт: %@. Після цього місяця він знову діє."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі лимит: %@. Осы айдан кейін қайта қолданылады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übliches Limit: %@. Nach diesem Monat gilt es wieder."
          }
        }
      }
    },
    "year.limit.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: “%2$@” is usually about %3$@ against a limit of %4$@. Raise the limit for this month?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: «%2$@» suele rondar %3$@ frente a un límite de %4$@. ¿Subir el límite para este mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : « %2$@ » tourne d'habitude autour de %3$@ pour un plafond de %4$@. Relever le plafond pour ce mois ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: «%2$@» обычно около %3$@ при лимите %4$@. Поднять лимит на этот месяц?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: «%2$@» зазвичай близько %3$@ при ліміті %4$@. Підняти ліміт на цей місяць?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: “%2$@” әдетте шамамен %3$@, лимиті %4$@. Осы айдың лимитін арттыру керек пе?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: „%2$@“ liegt üblicherweise bei etwa %3$@ gegenüber einem Limit von %4$@. Das Limit für diesen Monat erhöhen?"
          }
        }
      }
    },
