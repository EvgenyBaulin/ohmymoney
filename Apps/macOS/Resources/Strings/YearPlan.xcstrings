            "value": "Лимиты под дорогие месяцы"
          }
        }
      }
    },
    "year.plan.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf eine Zahl, um zu öffnen, woher sie kommt, oder um dem Monat etwas hinzuzufügen. Graue Zahlen mit „Schätzung“ sind der Median der letzten sechs Monate Einnahmen, wo nichts erwartet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a figure to open what it comes from or to add something to the month. Grey figures marked “estimate” are the median of the last six months of income where nothing is expected."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санды басып, құрамын ашыңыз немесе айға бір нәрсе қосыңыз. “Болжам” деп белгіленген сұр сандар — кіріс күтілмеген айлар үшін соңғы алты ай кірісінің медианасы."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на цифру, чтобы открыть, откуда она, или добавить что-то в месяц. Серые цифры с пометкой «оценка» — медиана дохода за 6 месяцев там, где ничего не ожидается."
          }
        }
      }
    },
    "year.plan.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmen, Zahlungen, Ziele und große Ausgaben nach Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income, payments, goals and big spends by month"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлар бойынша кірістер, төлемдер, мақсаттар мен ірі шығындар"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходы, платежи, цели и крупные траты по месяцам"
          }
        }
      }
    },
