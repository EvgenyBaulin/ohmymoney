    "year.buffer.raise": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход вырас больш чым на 10 %%. Павялічыць рэзерв да %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahme ist um mehr als 10 %% gewachsen. Den Puffer auf %@ erhöhen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income grew by more than 10 %%. Raise the buffer to %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso subió más de un 10 %%. ¿Subir el colchón a %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le revenu a augmenté de plus de 10 %%. Relever la réserve à %@ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate sono aumentate di oltre il 10 %%. Vuoi aumentare il margine a %@?"
