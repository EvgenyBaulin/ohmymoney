    "year.template.save.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Артыкулы падзеі і іх долі ў бюджэце захаваюцца. Шаблон будзе даступны разам з гатовымі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Posten des Ereignisses und ihre Anteile am Budget bleiben erhalten. Die Vorlage wird zusammen mit den fertigen angeboten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The articles of the event and their shares of the budget are kept. The template is offered with the ready ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan los artículos del evento y sus partes del presupuesto. La plantilla se ofrece junto a las listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les postes de l'événement et leur part du budget sont gardés. Le modèle est proposé avec les modèles prêts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci dell’evento e le rispettive quote del budget vengono conservate. Il modello sarà disponibile insieme a quelli già pronti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оқиға баптары мен бюджеттегі үлестері сақталады. Үлгі дайын үлгілермен бірге ұсынылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycje wydarzenia i ich udziały w budżecie zostaną zachowane. Szablon będzie dostępny wśród gotowych szablonów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens do evento e suas parcelas do orçamento são mantidos. O modelo aparece junto aos modelos prontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статьи события и их доли бюджета сохранятся. Шаблон появится рядом с готовыми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinliğin kalemleri ve bütçedeki payları saklanır. Şablon, hazır şablonlarla birlikte sunulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Статті події та їхні частки бюджету зберігаються. Шаблон пропонується разом з готовими."
          }
        }
      }
    },
