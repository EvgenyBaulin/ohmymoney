    "year.hero.lowData": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гісторыя менш чым за год: сярэдняе за даступныя месяцы, без уліку сезоннасці."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger als ein Jahr Verlauf: der Durchschnitt der vorhandenen Monate, ohne Saisons."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than a year of history: the average of the months there are, no seasons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de un año de historial: la media de los meses que hay, sin temporadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins d'un an d'historique : la moyenne des mois disponibles, sans saisons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno di un anno di dati: media dei mesi disponibili, senza stagionalità."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарих бір жылдан аз: бар айлардың орташа мәні, маусымдарсыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарых бир жылга жете элек: бар айлардын орточо көрсөткүчү, мезгилдер эске алынбайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej niż rok historii: średnia z dostępnych miesięcy, bez uwzględnienia sezonowości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de um ano de histórico: média dos meses disponíveis, sem considerar a sazonalidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истории меньше года: среднее по имеющимся месяцам, без сезонов."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таърих камтар аз як сол аст: миёнаи моҳҳои мавҷуда, бе назардошти мавсим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yıldan az geçmiş: mevsimsellik olmadan mevcut ayların ortalaması."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історії менше року: середнє за наявні місяці, без сезонів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarix bir yildan kam: mavjud oylar o‘rtachasi, mavsumiylik hisobga olinmagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄未滿一年：採用現有月份的平均值，不計季節變化。"
          }
        }
      }
    },
    "year.hero.range": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "звычайна %1$@, у дарагія месяцы да %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wie üblich %1$@, in teuren Monaten bis %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "as usual %1$@, in dear months up to %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "lo habitual %1$@, en los meses caros hasta %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "d'habitude %1$@, dans les mois chers jusqu'à %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "di solito %1$@, nei mesi più costosi fino a %2$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "әдетте %1$@, қымбат айларда %2$@ дейін"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "адатта %1$@, чыгымы көп айларда %2$@ чейин"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zwykle %1$@, w droższych miesiącach do %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "geralmente %1$@, nos meses mais caros até %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "как обычно %1$@, в дорогие месяцы до %2$@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "одатан %1$@, дар моҳҳои серхарҷ то %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "genellikle %1$@, yüksek harcamalı aylarda %2$@ tutarına kadar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "як зазвичай %1$@, у дорогі місяці до %2$@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "odatda %1$@, xarajatlar ko‘p oylarda %2$@gacha"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平常為 %1$@，支出較高的月份最高為 %2$@"
          }
        }
      }
    },
    "year.item.estimate": {
