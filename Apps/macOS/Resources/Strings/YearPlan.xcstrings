    "year.buffer.form.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero switches the buffer off. The income of this month is noted with it: when income grows by more than 10 %, the app offers to raise the buffer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cero desactiva el colchón. Con él se anota el ingreso de este mes: cuando el ingreso sube más de un 10 %, la app ofrece subir el colchón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zéro désactive la réserve. Le revenu de ce mois y est noté : quand le revenu augmente de plus de 10 %, l'app propose de relever la réserve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноль выключает буфер. Вместе с ним запоминается доход этого месяца: когда доход вырастет больше чем на 10 %, приложение предложит повысить буфер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нуль вимикає буфер. Доходи цього місяця записуються разом із ним: коли дохід зростає більш як на 10 %, застосунок пропонує підвищити буфер."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөл резервті өшіреді. Осы айдың кірісімен бірге сақталады: кіріс 10 %-дан артық өссе, қолданба резервті арттыруды ұсынады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Null schaltet den Puffer aus. Die Einnahme dieses Monats wird damit vermerkt: Wächst die Einnahme um mehr als 10 %, bietet die App an, den Puffer zu erhöhen."
          }
        }
      }
    },
    "year.buffer.form.title": {
