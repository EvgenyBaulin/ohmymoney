    "year.buffer.form.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нуль адключае рэзерв. Разам з ім запісваецца даход за гэты месяц: калі даход вырасце больш чым на 10 %, праграма прапануе павялічыць рэзерв."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Null schaltet den Puffer aus. Die Einnahme dieses Monats wird damit vermerkt: Wächst die Einnahme um mehr als 10 %, bietet die App an, den Puffer zu erhöhen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero switches the buffer off. The income of this month is noted with it: when income grows by more than 10 %, the app offers to raise the buffer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cero desactiva el colchón. Con él se anota el ingreso de este mes: cuando el ingreso sube más de un 10 %, la app ofrece subir el colchón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zéro désactive la réserve. Le revenu de ce mois y est noté : quand le revenu augmente de plus de 10 %, l'app propose de relever la réserve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta zero per disattivare il margine. Viene registrata anche l’entrata di questo mese: se aumenta di oltre il 10 %, l’app propone di aumentare il margine."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөл резервті өшіреді. Осы айдың кірісімен бірге сақталады: кіріс 10 %-дан артық өссе, қолданба резервті арттыруды ұсынады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz zero, aby wyłączyć bufor. Dochód z tego miesiąca zostanie zapamiętany. Gdy wzrośnie o ponad 10 %, aplikacja zaproponuje zwiększenie bufora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina como zero para desativar a reserva. A receita deste mês é registrada com ela: quando a receita aumenta mais de 10 %, o app sugere aumentar a reserva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноль выключает буфер. Вместе с ним запоминается доход этого месяца: когда доход вырастет больше чем на 10 %, приложение предложит повысить буфер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfır girildiğinde pay kapatılır. Bu ayın geliri de kaydedilir: gelir %10'dan fazla artarsa uygulama payı artırmayı önerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нуль вимикає буфер. Доходи цього місяця записуються разом із ним: коли дохід зростає більш як на 10 %, застосунок пропонує підвищити буфер."
          }
        }
      }
    },
