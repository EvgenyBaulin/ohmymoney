    "year.hero.lowData": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гісторыя менш чым за год: сярэдняе за даступныя месяцы, без уліку сезоннасці."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger als ein Jahr Verlauf: der Durchschnitt der vorhandenen Monate, ohne Saisons."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than a year of history: the average of the months there are, no seasons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de un año de historial: la media de los meses que hay, sin temporadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins d'un an d'historique : la moyenne des mois disponibles, sans saisons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno di un anno di dati: media dei mesi disponibili, senza stagionalità."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарих бір жылдан аз: бар айлардың орташа мәні, маусымдарсыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej niż rok historii: średnia z dostępnych miesięcy, bez uwzględnienia sezonowości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de um ano de histórico: média dos meses disponíveis, sem considerar a sazonalidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истории меньше года: среднее по имеющимся месяцам, без сезонов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yıldan az geçmiş: mevsimsellik olmadan mevcut ayların ortalaması."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історії менше року: середнє за наявні місяці, без сезонів."
          }
        }
      }
    },
