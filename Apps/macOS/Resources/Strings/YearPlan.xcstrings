      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У план не ўключаны сумы ў валютах без курсу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas in einer Währung ohne Kurs bleibt aus dem Plan weg."
          }
        },
        "en": {
