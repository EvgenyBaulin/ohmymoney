    "year.buffer.raise": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход вырас больш чым на 10 %%. Павялічыць рэзерв да %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahme ist um mehr als 10 %% gewachsen. Den Puffer auf %@ erhöhen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income grew by more than 10 %%. Raise the buffer to %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso subió más de un 10 %%. ¿Subir el colchón a %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le revenu a augmenté de plus de 10 %%. Relever la réserve à %@ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate sono aumentate di oltre il 10 %%. Vuoi aumentare il margine a %@?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кіріс 10 %%-дан артық өсті. Резервті %@ дейін арттыру керек пе?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Киреше 10 %% ашык өстү. Резервди %@ чейин көбөйтүү керекпи?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochód wzrósł o ponad 10 %%. Zwiększyć bufor do %@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A receita aumentou mais de 10 %%. Aumentar a reserva para %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход вырос больше чем на 10 %%. Повысить буфер до %@?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромад беш аз 10 %% афзуд. Захира то %@ зиёд шавад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelir %%10'dan fazla arttı. Pay %@ tutarına yükseltilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід виріс більш як на 10 %%. Підвищити буфер до %@?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Daromad 10 %% dan ko‘proq oshdi. Zaxira %@gacha oshirilsinmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收入增加超過 10 %%。要將緩衝金提高至%@嗎？"
          }
        }
      }
    },
