    "year.buffer.free": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна патраціць да канца месяца: %1$@ (рэзерв %2$@ адкладзены)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis Monatsende können Sie ausgeben: %1$@ (Puffer %2$@ zurückgehalten)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can spend to the end of the month: %1$@ (buffer %2$@ held back)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede gastar hasta final de mes: %1$@ (colchón %2$@ retenido)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez dépenser jusqu'à la fin du mois : %1$@ (réserve %2$@ retenue)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi spendere fino a fine mese: %1$@ (margine accantonato: %2$@)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай соңына дейін жұмсауға болады: %1$@ (%2$@ резерві алынды)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do wydania do końca miesiąca: %1$@ (odłożono bufor %2$@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível para gastar até o fim do mês: %1$@ (reserva de %2$@ descontada)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До конца месяца можно потратить: %1$@ (буфер %2$@ отложен)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay sonuna kadar harcayabileceğiniz tutar: %1$@ (%2$@ pay ayrıldı)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До кінця місяця можна витратити: %1$@ (буфер %2$@ відкладено)"
          }
        }
      }
    },
