    "year.plan.withoutRate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У план не ўключаны сумы ў валютах без курсу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas in einer Währung ohne Kurs bleibt aus dem Plan weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something in a currency without a rate is left out of the plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo en una divisa sin tipo se deja fuera del plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie en devise sans taux est laissée de côté du plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano non include un importo in una valuta senza tasso di cambio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бағамы жоқ валютадағы жазбалар жоспарға кірмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу жок валютадагы айрым суммалар планга кирген жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W planie pominięto kwotę w walucie bez kursu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor em moeda sem cotação ficou fora do plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то в валюте без курса в плане не учтено."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағ бо асъори беқурб ба нақша дохил нашудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuru bulunmayan bir para birimindeki tutar plana dahil edilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дещо у валюті без курсу не входить до плану."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursi yo‘q valyutadagi mablag‘ rejaga kiritilmagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計畫不包含尚無匯率的貨幣項目。"
          }
        }
      }
    },
    "year.range.both": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "як звычайна — %1$@, як у дарагі месяц — %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wie üblich %1$@, wie in einem teuren Monat %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "as usual %1$@, as in a dear month %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "lo habitual %1$@, como en un mes caro %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "d'habitude %1$@, comme dans un mois cher %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "come al solito %1$@, come in un mese più costoso %2$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "әдеттегідей %1$@, қымбат айдағыдай %2$@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "адаттагыдай %1$@, чыгымы көп айдагыдай %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "jak zwykle %1$@, jak w droższym miesiącu %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "como de costume: %1$@, em um mês caro: %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "как обычно %1$@, как в дорогой месяц %2$@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "маъмулӣ %1$@, дар моҳи гарон %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "her zamanki gibi %1$@, masraflı bir ayda olduğu gibi %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "як зазвичай %1$@, як у дорогий місяць %2$@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "odatdagidek %1$@, serxarajat oydagidek %2$@"
          }
        },
