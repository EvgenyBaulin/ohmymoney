          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高支出月份限額"
          }
        }
      }
    },
    "year.plan.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсніце на лічбу, каб даведацца, з чаго яна складаецца, або нешта дадаць у месяц. Шэрыя лічбы з пазнакай «ацэнка» — медыяна даходаў за апошнія шэсць месяцаў, калі на месяц нічога не запланавана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf eine Zahl, um zu öffnen, woher sie kommt, oder um dem Monat etwas hinzuzufügen. Graue Zahlen mit „Schätzung“ sind der Median der letzten sechs Monate Einnahmen, wo nichts erwartet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a figure to open what it comes from or to add something to the month. Grey figures marked “estimate” are the median of the last six months of income where nothing is expected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse una cifra para ver de dónde sale o para añadir algo al mes. Las cifras grises marcadas «estimación» son la mediana de los últimos seis meses de ingresos donde no se prevé nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un chiffre pour voir d'où il vient ou ajouter quelque chose au mois. Les chiffres gris marqués « estimation » sont la médiane des six derniers mois de revenus là où rien n'est attendu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una cifra per vedere da cosa deriva o aggiungere qualcosa al mese. Le cifre grigie contrassegnate come “stima” sono la mediana delle entrate degli ultimi sei mesi, per i mesi in cui non sono previste entrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санды басып, құрамын ашыңыз немесе айға бір нәрсе қосыңыз. “Болжам” деп белгіленген сұр сандар — кіріс күтілмеген айлар үшін соңғы алты ай кірісінің медианасы."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сан эмнеден түзүлгөнүн көрүү же айга бир нерсе кошуу үчүн аны басыңыз. «Болжол» деп белгиленген боз сандар — киреше күтүлбөгөн айлар үчүн акыркы алты айдагы кирешенин медианасы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij kwotę, aby zobaczyć, skąd się wzięła, lub dodać coś do miesiąca. Szare kwoty oznaczone jako „szacunkowe” to mediana dochodów z ostatnich sześciu miesięcy, gdy nie przewidziano żadnych wpływów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um valor para ver sua origem ou adicionar algo ao mês. Valores em cinza marcados como “estimativa” são a mediana dos últimos seis meses de receitas, quando não há receitas previstas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на цифру, чтобы открыть, откуда она, или добавить что-то в месяц. Серые цифры с пометкой «оценка» — медиана дохода за 6 месяцев там, где ничего не ожидается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рақамро пахш кунед, то манбаи онро бинед ё ба моҳ чизе илова кунед. Рақамҳои хокистарӣ бо аломати «тахмин» медианаи даромади шаш моҳи охиранд, агар даромаде интизор набошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tutarın kaynağını görmek veya aya bir şey eklemek için tutara dokunun. “Tahmin” olarak işaretlenen gri tutarlar, gelir beklenmeyen aylarda son altı aylık gelirin medyanıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться цифри, щоб відкрити, звідки вона, або додати щось до місяця. Сірі цифри з позначкою «оцінка» — медіана доходів за останні шість місяців там, де нічого не очікується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Raqamning tarkibini ko‘rish yoki oyga biror narsa qo‘shish uchun unga bosing. “Taxmin” deb belgilangan kulrang raqamlar daromad kutilmagan oylar uchun oxirgi olti oylik daromadning medianasidir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下數字可查看來源或新增項目至該月份。標示為「估計」的灰色數字，是沒有預期收入的月份所用的過去六個月收入中位數。"
          }
        }
      }
    },
    "year.plan.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даходы, плацяжы, мэты і буйныя выдаткі па месяцах"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmen, Zahlungen, Ziele und große Ausgaben nach Monat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income, payments, goals and big spends by month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresos, pagos, objetivos y grandes gastos por mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenus, paiements, objectifs et grosses dépenses par mois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrate, pagamenti, obiettivi e grandi spese per mese"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлар бойынша кірістер, төлемдер, мақсаттар мен ірі шығындар"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлар боюнча киреше, төлөмдөр, максаттар жана ири чыгымдар"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochody, płatności, cele i duże wydatki według miesięcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receitas, pagamentos, metas e grandes gastos por mês"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходы, платежи, цели и крупные траты по месяцам"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромад, пардохтҳо, ҳадафҳо ва хароҷоти калон аз рӯи моҳ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylara göre gelir, ödemeler, hedefler ve büyük harcamalar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходи, платежі, цілі й великі витрати за місяцями"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylar bo‘yicha daromad, to‘lov, maqsad va yirik xarajatlar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按月查看收入、付款、目標和大額支出"
          }
        }
      }
    },
