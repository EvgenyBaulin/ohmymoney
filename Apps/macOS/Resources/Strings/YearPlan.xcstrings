    "year.limit.question": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: «%2$@» звычайна складае каля %3$@ пры ліміце %4$@. Павысіць ліміт на гэты месяц?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: „%2$@“ liegt üblicherweise bei etwa %3$@ gegenüber einem Limit von %4$@. Das Limit für diesen Monat erhöhen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: “%2$@” is usually about %3$@ against a limit of %4$@. Raise the limit for this month?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: «%2$@» suele rondar %3$@ frente a un límite de %4$@. ¿Subir el límite para este mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : « %2$@ » tourne d'habitude autour de %3$@ pour un plafond de %4$@. Relever le plafond pour ce mois ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: “%2$@” è di solito circa %3$@, con un limite di %4$@. Vuoi aumentare il limite per questo mese?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: “%2$@” әдетте шамамен %3$@, лимиті %4$@. Осы айдың лимитін арттыру керек пе?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: «%2$@» адатта %3$@ чамасында, чек — %4$@. Бул айдын чегин жогорулатасызбы?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: „%2$@” to zwykle około %3$@ przy limicie %4$@. Podnieść limit na ten miesiąc?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: “%2$@” costuma ficar em torno de %3$@, com limite de %4$@. Aumentar o limite para este mês?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: «%2$@» обычно около %3$@ при лимите %4$@. Поднять лимит на этот месяц?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: «%2$@» одатан тақрибан %3$@ аст, маҳдудият бошад %4$@. Маҳдудияти ин моҳ зиёд карда шавад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: “%2$@” genellikle %3$@ civarında, limit ise %4$@. Bu ay için limit artırılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: «%2$@» зазвичай близько %3$@ при ліміті %4$@. Підняти ліміт на цей місяць?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: “%2$@” odatda %3$@ atrofida, limit esa %4$@. Bu oy uchun limit oshirilsinmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：「%2$@」通常約為 %3$@，限額為 %4$@。要提高本月限額嗎？"
          }
        }
      }
    },
