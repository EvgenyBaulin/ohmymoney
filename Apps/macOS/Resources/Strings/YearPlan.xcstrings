    "year.buffer.marks.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазначце, што аплачана з рэзерву ў гэтым месяцы: рэзерв зменшыцца на гэтую суму. Больш нічога не зменіцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie, was der Puffer diesen Monat bezahlt hat: Der Puffer schrumpft um diesen Betrag. Sonst ändert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark what the buffer paid this month: the buffer shrinks by it. Nothing else changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque lo que pagó el colchón este mes: el colchón se reduce en eso. Nada más cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez ce que la réserve a payé ce mois-ci : la réserve diminue d'autant. Rien d'autre ne change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna le spese coperte dal margine questo mese: il margine si riduce di tale importo. Non cambia nient’altro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда резервтен төленгенді белгілеңіз: резерв сол сомаға азаяды. Басқа ештеңе өзгермейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте, что оплатил буфер в этом месяце: буфер уменьшится на эти суммы. Больше ничего не меняется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте, що буфер оплатив цього місяця: буфер зменшиться на цю суму. Нічого іншого не змінюється."
          }
        }
      }
    },
