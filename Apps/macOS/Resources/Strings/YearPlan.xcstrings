            "state": "translated",
            "value": "Le entrate sono aumentate di oltre il 10 %%. Vuoi aumentare il margine a %@?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кіріс 10 %%-дан артық өсті. Резервті %@ дейін арттыру керек пе?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
