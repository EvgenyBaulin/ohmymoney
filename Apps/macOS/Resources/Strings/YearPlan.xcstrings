    "year.buffer.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sum for the unexpected, apart from the cushion; it is held back from what you can spend"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suma para lo imprevisto, aparte del colchón de seguridad; se descuenta de lo que puede gastar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une somme pour l'imprévu, à part du matelas ; elle est retenue sur ce que vous pouvez dépenser"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма на непредвиденное отдельно от подушки; она вычитается из того, что можно тратить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума на непередбачене, окремо від подушки; вона відкладається з того, що можна витратити"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қордан бөлек, күтпеген жағдайларға арналған сома; жұмсауға болатын ақшадан алынады"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Summe für das Unerwartete, getrennt vom Polster; sie wird von dem abgezogen, was Sie ausgeben können"
          }
        }
      }
    },
