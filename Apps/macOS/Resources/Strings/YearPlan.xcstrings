            "value": "Marcar gastos del colchón…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer les dépenses sur la réserve…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
