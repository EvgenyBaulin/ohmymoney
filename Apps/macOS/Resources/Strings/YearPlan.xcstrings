    "year.buffer.free": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can spend to the end of the month: %1$@ (buffer %2$@ held back)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede gastar hasta final de mes: %1$@ (colchón %2$@ retenido)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez dépenser jusqu'à la fin du mois : %1$@ (réserve %2$@ retenue)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До конца месяца можно потратить: %1$@ (буфер %2$@ отложен)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До кінця місяця можна витратити: %1$@ (буфер %2$@ відкладено)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай соңына дейін жұмсауға болады: %1$@ (%2$@ резерві алынды)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis Monatsende können Sie ausgeben: %1$@ (Puffer %2$@ zurückgehalten)"
          }
        }
      }
    },
