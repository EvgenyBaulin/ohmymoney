    "year.buffer.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума на непрадбачанае, асобна ад фінансавай падушкі; яна адкладаецца з даступных сродкаў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Summe für das Unerwartete, getrennt vom Polster; sie wird von dem abgezogen, was Sie ausgeben können"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sum for the unexpected, apart from the cushion; it is held back from what you can spend"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suma para lo imprevisto, aparte del colchón de seguridad; se descuenta de lo que puede gastar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une somme pour l'imprévu, à part du matelas ; elle est retenue sur ce que vous pouvez dépenser"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una somma per gli imprevisti, separata dal fondo di sicurezza e sottratta a ciò che puoi spendere"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қордан бөлек, күтпеген жағдайларға арналған сома; жұмсауға болатын ақшадан алынады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota na nieprzewidziane wydatki, odkładana osobno od poduszki finansowej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor para imprevistos, separado da reserva de emergência e descontado do disponível para gastos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма на непредвиденное отдельно от подушки; она вычитается из того, что можно тратить"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birikimden ayrı olarak beklenmedik durumlar için ayrılan ve harcanabilir tutardan düşülen bir miktar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума на непередбачене, окремо від подушки; вона відкладається з того, що можна витратити"
          }
        }
      }
    },
