          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервтен шығынды белгілеу…"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервден кеткен чыгымдарды белгилөө…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz wydatki z bufora…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar gastos da reserva…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить траты из буфера…"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷот аз захираро қайд кардан…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paydan yapılan harcamaları işaretle…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначити витрати з буфера…"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaxiradan xarajatlarni belgilash…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記緩衝金支出…"
          }
        }
      }
    },
    "year.buffer.marks.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазначце, што аплачана з рэзерву ў гэтым месяцы: рэзерв зменшыцца на гэтую суму. Больш нічога не зменіцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie, was der Puffer diesen Monat bezahlt hat: Der Puffer schrumpft um diesen Betrag. Sonst ändert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark what the buffer paid this month: the buffer shrinks by it. Nothing else changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque lo que pagó el colchón este mes: el colchón se reduce en eso. Nada más cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez ce que la réserve a payé ce mois-ci : la réserve diminue d'autant. Rien d'autre ne change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna le spese coperte dal margine questo mese: il margine si riduce di tale importo. Non cambia nient’altro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда резервтен төленгенді белгілеңіз: резерв сол сомаға азаяды. Басқа ештеңе өзгермейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда резервден төлөнгөн чыгымдарды белгилеңиз: резерв ошол суммага азаят. Башка эч нерсе өзгөрбөйт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz wydatki pokryte w tym miesiącu z bufora. Bufor zostanie o nie pomniejszony. Nic więcej się nie zmieni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o que foi pago com a reserva neste mês. O valor será descontado da reserva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте, что оплатил буфер в этом месяце: буфер уменьшится на эти суммы. Больше ничего не меняется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти аз захира пардохтшударо дар ин моҳ қайд кунед: захира ба ҳамон маблағ кам мешавад. Дигар чизе тағйир намеёбад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay paydan karşılanan harcamaları işaretleyin: pay bu tutar kadar azalır. Başka hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте, що буфер оплатив цього місяця: буфер зменшиться на цю суму. Нічого іншого не змінюється."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy zaxiradan qoplangan xarajatlarni belgilang: zaxira shu miqdorga kamayadi. Boshqa hech narsa o‘zgarmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記本月由緩衝金支付的支出，緩衝金會扣除該金額。其他項目不受影響。"
          }
        }
      }
    },
