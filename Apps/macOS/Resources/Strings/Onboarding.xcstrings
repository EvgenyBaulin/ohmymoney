{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.account.existing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ужо ёсць у вашых запісах: яго аперацыі застануцца на ім"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon in Ihren Aufzeichnungen: Die Vorgänge bleiben darauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already in your records: its operations stay on it"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già presente: le sue operazioni restano associate"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазбаларыңызда бұрыннан бар: оның операциялары сонда қалады"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже есть в учёте: его операции остаются на нём"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже є в обліку: його операції залишаться на ньому"
          }
        }
      }
    },
