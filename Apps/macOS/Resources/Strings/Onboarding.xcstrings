    "onboarding.issue.nameIsOtherName": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва супадае з іншай назвай рахунку «%@» — змяніце яе ў наладах"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name entspricht einem weiteren Namen des Kontos „%@“ — ändern Sie ihn in den Einstellungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name matches another name of the account «%@» — change it in Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre coincide con otro nombre de la cuenta «%@» — cámbielo en Ajustes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom correspond à un autre nom du compte « %@ » — modifiez-le dans les Réglages"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անունը համընկնում է «%@» հաշվի այլ անվան հետ․ փոխեք այն Կարգավորումներում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome corrisponde a un altro nome del conto «%@» — modificalo nelle Impostazioni"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Атау «%@» есеп-шотының басқа атына сәйкес келеді — оны параметрлерде өзгертіңіз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул ат «%@» эсебинин башка атына дал келет — аны Жөндөөлөрдөн өзгөртүңүз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta nazwa jest inną nazwą konta «%@» — zmień ją w Ustawieniach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome corresponde a outro nome da conta «%@» — altere-o nos Ajustes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название совпадает с другим названием счёта «%@» — поправьте его в Настройках"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ном бо номи дигари ҳисоби «%@» яксон аст — онро дар Танзимот тағйир диҳед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad, «%@» hesabının başka bir adıyla eşleşiyor — Ayarlar’dan değiştirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва збігається з іншою назвою рахунку «%@» — змініть її в налаштуваннях"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nom «%@» hisobining boshqa nomiga mos keladi — uni Sozlamalarda o‘zgartiring"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此名稱與帳戶「%@」的其他名稱相同，請在「設定」中更改"
          }
        }
      }
    },
    "onboarding.issue.nameTaken": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Іншы рахунак ужо мае такую назву або выкарыстоўвае яе як дадатковую."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Konto hat diesen Namen bereits oder wird so genannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another account already has this name, or goes by it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
