          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte heißt „%@“ — wählen Sie einen anderen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card is called “%@” — choose another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta se llama «%@»: elija otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte s'appelle « %@ » — choisissez un autre nom."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քարտերից մեկը կոչվում է “%@”․ ընտրեք այլ անուն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carta si chiama “%@” — scegli un altro nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” деп аталған карта бар — басқа атау таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” аттуу карта бар — башка ат тандаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta ma nazwę “%@” — wybierz inną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão se chama “%@” — escolha outro nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так называется карта «%@» — выберите другое название."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Корте «%@» ном дорад — номи дигар интихоб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adlı bir kart var — başka bir ad seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка має назву «%@» — виберіть іншу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” nomli karta bor — boshqa nom tanlang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有卡片名為「%@」，請選擇其他名稱。"
          }
        }
      }
    },
