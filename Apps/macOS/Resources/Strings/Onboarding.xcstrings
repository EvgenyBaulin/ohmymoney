            "state": "translated",
            "value": "Konta z pustymi polami pozostaną nieuzgodnione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas com campos vazios não serão conciliadas."
          }
