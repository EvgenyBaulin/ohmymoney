{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.account.existing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ужо ёсць у вашых запісах: яго аперацыі застануцца на ім"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon in Ihren Aufzeichnungen: Die Vorgänge bleiben darauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already in your records: its operations stay on it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está en sus registros: sus operaciones se quedan en ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà dans vos saisies : ses opérations y restent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già presente: le sue operazioni restano associate"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазбаларыңызда бұрыннан бар: оның операциялары сонда қалады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest już w Twoich danych: operacje pozostaną na tym koncie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже есть в учёте: его операции остаются на нём"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlarınızda zaten var: işlemleri bu hesapta kalır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже є в обліку: його операції залишаться на ньому"
          }
        }
      }
    },
