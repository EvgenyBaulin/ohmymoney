    "onboarding.card.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашы рахункі яшчэ не наладжаны. Укажыце, дзе і колькі ў вас грошай, і з гэтага моманту баланс будзе падлічвацца аўтаматычна."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Konten sind noch nicht eingerichtet. Sagen Sie, wo Ihr Geld liegt und wie viel dort ist, dann werden die Salden von da an gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your accounts are not set up yet. Say where your money is and how much is there, and the balances are counted from then on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cuentas todavía no están configuradas. Diga dónde está su dinero y cuánto hay, y a partir de ahí se cuentan los saldos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos comptes ne sont pas encore configurés. Indiquez où se trouve votre argent et combien il y en a : les soldes sont comptés à partir de là."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր հաշիվները դեռ կարգավորված չեն։ Նշեք՝ որտեղ և որքան գումար ունեք, և այդ պահից մնացորդները կհաշվարկվեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora configurato i conti. Indica dove si trova il tuo denaro e quanto ce n’è: da quel momento i saldi saranno calcolati automaticamente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттарыңыз әлі бапталмаған. Ақшаңыз қайда екенін және қанша бар екенін айтыңыз — теңгерімдер содан бастап есептеледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептериңиз азырынча жөндөлө элек. Акчаңыз кайда жана канча экенин көрсөтүңүз. Калдыктар ошондон тартып эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konta nie są jeszcze skonfigurowane. Wskaż, gdzie są Twoje pieniądze i ile ich jest, a salda będą odtąd obliczane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas contas ainda não estão configuradas. Informe onde está seu dinheiro e quanto há em cada lugar. Os saldos serão calculados a partir daí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета ещё не настроены. Укажите, где лежат деньги и сколько там, — и остатки будут считаться дальше сами."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобҳои шумо ҳанӯз танзим нашудаанд. Нишон диҳед, ки пулатон дар куҷост ва чӣ қадар аст. Бақияҳо аз ҳамон лаҳза ҳисоб мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplarınız henüz ayarlanmadı. Paranızın nerede ve ne kadar olduğunu belirtin; bakiyeler o andan itibaren hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші рахунки ще не налаштовано. Укажіть, де ваші гроші й скільки їх, — відтоді залишки обчислюватимуться."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblaringiz hali sozlanmagan. Pul qayerda va qancha ekanini kiriting. Qoldiqlar shu paytdan boshlab hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未設定帳戶。輸入資金所在位置和金額，之後即可開始計算餘額。"
          }
        }
      }
    },
