        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro conto usa già questo nome, anche come nome alternativo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа есеп-шоттың атауы бірдей, не сол атпен аталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Башка эсептин ушундай аты же кошумча аты бар."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne konto ma już tę nazwę lub używa jej jako innej nazwy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra conta já tem este nome ou usa-o como nome alternativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое название уже есть у другого счёта — как название или как другое имя."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби дигар аллакай ин ном ё номи иловагиро дорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
