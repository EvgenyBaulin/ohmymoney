    "onboarding.issue.mainInExcludedGroup": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны рахунак не можа быць у групе па-за зводкай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptkonto kann nicht in einer Gruppe außerhalb der Übersicht sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be in a group out of the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta principal no puede estar en un grupo fuera del resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte principal ne peut pas être dans un groupe exclu du récapitulatif."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնական հաշիվը չի կարող լինել ամփոփումից դուրս խմբում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto principale non può appartenere a un gruppo escluso dal riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі есеп-шот қорытындыдан тыс топта бола алмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги эсеп жыйынтыкка кирбеген топто боло албайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto główne nie może należeć do grupy wyłączonej z podsumowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta principal não pode estar em um grupo fora do resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не может быть в группе вне сводки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби асосӣ наметавонад дар гурӯҳе бошад, ки ба ҷамъбаст дохил нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana hesap, özet dışında tutulan bir grupta olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний рахунок не може бути в групі поза підсумком."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy hisob umumiy hisobdan chiqarilgan guruhda bo‘la olmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要帳戶不能位於未計入總覽的群組中。"
          }
        }
      }
    },
    "onboarding.issue.nameArchived": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунак з такой назвай ёсць у архіве: аднавіце яго ў наладах або задайце гэтаму рахунку іншую назву."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein archiviertes Konto hat diesen Namen: Holen Sie es in den Einstellungen zurück, statt es erneut anzulegen, oder geben Sie diesem einen anderen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived account has this name: bring it back in Settings instead of adding it again, or give this one another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta archivada tiene este nombre: recupérela en Ajustes en lugar de añadirla de nuevo, o dé a esta otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte archivé porte ce nom : ramenez-le dans les Réglages au lieu de l'ajouter à nouveau, ou donnez un autre nom à celui-ci."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անունով արխիվացված հաշիվ կա․ նորից ավելացնելու փոխարեն վերականգնեք այն Կարգավորումներում կամ այս հաշվին այլ անուն տվեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conto archiviato ha già questo nome: ripristinalo nelle Impostazioni oppure scegli un altro nome."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағатталған есеп-шот осы атаумен бар: оны қайта қосудың орнына параметрлерде қайтарыңыз, немесе бұған басқа атау беріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мындай аталыштагы эсеп архивде бар: аны кайра кошпой, Жөндөөлөрдөн калыбына келтириңиз же бул эсепке башка ат бериңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowane konto ma tę nazwę. Przywróć je w Ustawieniach lub nadaj temu kontu inną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta arquivada tem este nome. Restaure-a nos Ajustes ou dê outro nome a esta conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт с таким названием есть в архиве — верните его в Настройках вместо нового или дайте этому другое название."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоби бойгонишудае ин номро дорад: ба ҷои иловаи дубора онро дар Танзимот барқарор кунед ё ба ин ҳисоб номи дигар диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adla arşivlenmiş bir hesap var: yeniden eklemek yerine onu Ayarlar’dan geri getirin veya bu hesaba başka bir ad verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В архіві є рахунок із такою назвою: поверніть його в налаштуваннях, а не додавайте знову, або виберіть іншу назву."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nomli hisob arxivda bor. Uni qayta qo‘shish o‘rniga Sozlamalarda tiklang yoki bunga boshqa nom bering."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已封存的帳戶使用了此名稱。請在「設定」中將其還原，或為此帳戶使用其他名稱。"
          }
        }
      }
    },
