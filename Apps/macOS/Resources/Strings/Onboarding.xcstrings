          "stringUnit": {
            "state": "translated",
            "value": "Рахункі з пустымі палямі застануцца незверанымі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten mit leeren Feldern bleiben unabgeglichen."
