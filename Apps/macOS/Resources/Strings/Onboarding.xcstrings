          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший рахунок уже має цю назву або використовує її як іншу назву."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa hisobda bu nom yoki uning muqobili bor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他帳戶已使用此名稱或將其作為別名。"
          }
        }
      }
    },
    "onboarding.issue.nameTakenByCard": {
