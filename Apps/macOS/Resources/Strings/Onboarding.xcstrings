    "onboarding.main.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі без указанага рахунку трапляюць на асноўны рахунак. Ён першы ва ўсіх спісах і заўсёды ўлічваецца ў зводцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorgang ohne genanntes Konto geht auf das Hauptkonto. Es steht in jeder Liste an erster Stelle und zählt immer in der Übersicht mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation that names no account goes to the main account. It is first in every list and always counts in the summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una operación que no nombra cuenta va a la cuenta principal. Va primera en todas las listas y siempre cuenta en el resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération qui ne nomme aucun compte va sur le compte principal. Il est en tête de chaque liste et compte toujours dans le récapitulatif."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց հաշվի նշման գործարքները գրանցվում են հիմնական հաշվին։ Այն առաջինն է բոլոր ցանկերում և միշտ ներառվում է ամփոփման մեջ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni senza un conto specificato vengono assegnate al conto principale. È il primo in ogni elenco ed è sempre incluso nel riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотты атамайтын операция негізгі есеп-шотқа түседі. Ол әр тізімде бірінші тұрады және қорытындыда әрқашан есептеледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсеп көрсөтүлбөгөн операция негизги эсепке жазылат. Ал бардык тизмелерде биринчи турат жана дайыма жыйынтыкка кошулат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje bez wskazanego konta trafiają na konto główne. Jest ono pierwsze na każdej liście i zawsze uwzględniane w podsumowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma operação sem conta indicada vai para a conta principal. Ela aparece primeiro em todas as listas e sempre entra no resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция без счёта попадает на основной счёт. Он первый во всех списках и всегда учитывается в сводке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёте, ки ҳисобаш нишон дода нашудааст, ба ҳисоби асосӣ мегузарад. Он дар ҳама рӯйхатҳо аввал аст ва ҳамеша ба ҷамъбаст дохил мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap belirtilmeyen işlemler ana hesaba gider. Ana hesap her listede ilk sıradadır ve her zaman özete dahil edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція без зазначеного рахунку потрапляє на основний. Він перший у кожному списку й завжди враховується в підсумку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisob ko‘rsatilmagan amal asosiy hisobga yoziladi. U barcha ro‘yxatlarda birinchi turadi va har doim umumiy hisobga qo‘shiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未指定帳戶的交易會歸入主要帳戶。主要帳戶會排在所有列表的最前面，並一律計入總覽。"
          }
        }
      }
    },
