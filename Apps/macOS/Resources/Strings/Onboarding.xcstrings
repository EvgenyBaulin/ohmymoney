{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.account.existing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ужо ёсць у вашых запісах: яго аперацыі застануцца на ім"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon in Ihren Aufzeichnungen: Die Vorgänge bleiben darauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already in your records: its operations stay on it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está en sus registros: sus operaciones se quedan en ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà dans vos saisies : ses opérations y restent"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արդեն կա ձեր գրառումներում․ գործարքները կմնան դրա վրա"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già presente: le sue operazioni restano associate"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазбаларыңызда бұрыннан бар: оның операциялары сонда қалады"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазууларыңызда бар: операциялары ошол эсепте калат"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest już w Twoich danych: operacje pozostaną na tym koncie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já está nos seus registros: as operações permanecem nela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже есть в учёте: его операции остаются на нём"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аллакай дар сабтҳои шумо: амалиётҳояш дар он мемонанд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlarınızda zaten var: işlemleri bu hesapta kalır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже є в обліку: його операції залишаться на ньому"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro‘yxatingizda bor: uning amallari saqlanadi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在記錄中：交易仍保留於此帳戶"
          }
        }
      }
    },
