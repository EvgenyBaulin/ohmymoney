    "onboarding.card.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашы рахункі яшчэ не наладжаны. Укажыце, дзе і колькі ў вас грошай, і з гэтага моманту баланс будзе падлічвацца аўтаматычна."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Konten sind noch nicht eingerichtet. Sagen Sie, wo Ihr Geld liegt und wie viel dort ist, dann werden die Salden von da an gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your accounts are not set up yet. Say where your money is and how much is there, and the balances are counted from then on."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora configurato i conti. Indica dove si trova il tuo denaro e quanto ce n’è: da quel momento i saldi saranno calcolati automaticamente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттарыңыз әлі бапталмаған. Ақшаңыз қайда екенін және қанша бар екенін айтыңыз — теңгерімдер содан бастап есептеледі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета ещё не настроены. Укажите, где лежат деньги и сколько там, — и остатки будут считаться дальше сами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші рахунки ще не налаштовано. Укажіть, де ваші гроші й скільки їх, — відтоді залишки обчислюватимуться."
          }
        }
      }
    },
