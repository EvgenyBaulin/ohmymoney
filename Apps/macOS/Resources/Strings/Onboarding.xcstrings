    "onboarding.main.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі без указанага рахунку трапляюць на асноўны рахунак. Ён першы ва ўсіх спісах і заўсёды ўлічваецца ў зводцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorgang ohne genanntes Konto geht auf das Hauptkonto. Es steht in jeder Liste an erster Stelle und zählt immer in der Übersicht mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation that names no account goes to the main account. It is first in every list and always counts in the summary."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni senza un conto specificato vengono assegnate al conto principale. È il primo in ogni elenco ed è sempre incluso nel riepilogo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шотты атамайтын операция негізгі есеп-шотқа түседі. Ол әр тізімде бірінші тұрады және қорытындыда әрқашан есептеледі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция без счёта попадает на основной счёт. Он первый во всех списках и всегда учитывается в сводке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція без зазначеного рахунку потрапляє на основний. Він перший у кожному списку й завжди враховується в підсумку."
          }
        }
      }
    },
