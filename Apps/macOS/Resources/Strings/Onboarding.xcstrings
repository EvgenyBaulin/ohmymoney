    "onboarding.groups.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money of a group out of the summary is not in the total or the free sum and is shown apart; its income and spending still count everywhere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги группы вне сводки не входят во «Всего» и в свободную сумму и показываются отдельно; её доходы и траты учитываются везде."
          }
        }
      }
    },
    "onboarding.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark where your money is and how much is there now. A balance you type becomes the account's first reconciliation: from then on its balance is what you counted plus everything that moved after it. An empty field means «don't know»: the account stays unreconciled, and its first count becomes its starting point."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте, где лежат ваши деньги и сколько там сейчас. Вписанный остаток станет первой сверкой счёта: дальше остаток — это посчитанное плюс всё, что прошло после. Пустое поле — «не знаю»: такой счёт останется несверенным, и его первая сверка станет точкой отсчёта."
          }
        }
      }
    },
    "onboarding.issue.emptyGroupName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every group needs a name."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой группы должно быть название."
          }
        }
      }
    },
    "onboarding.issue.emptyName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every account needs a name."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого счёта должно быть название."
          }
        }
      }
    },
    "onboarding.issue.groupNameArchived": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived group has this name: bring it back in Settings instead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа с таким названием есть в архиве — верните её в Настройках."
          }
        }
      }
    },
    "onboarding.issue.groupNameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two groups have the same name."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У двух групп одинаковое название."
          }
        }
      }
    },
    "onboarding.issue.mainInExcludedGroup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main account cannot be in a group out of the summary."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной счёт не может быть в группе вне сводки."
          }
        }
      }
    },
    "onboarding.issue.nameArchived": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived account has this name: bring it back in Settings instead of adding it again, or give this one another name."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт с таким названием есть в архиве — верните его в Настройках вместо нового или дайте этому другое название."
          }
        }
      }
    },
    "onboarding.issue.nameArchivedStored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived account has this name: give this account another name."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт с таким названием есть в архиве — дайте этому счёту другое название."
          }
        }
      }
    },
    "onboarding.issue.nameIsOtherName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name matches another name of the account «%@» — change it in Settings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название совпадает с другим названием счёта «%@» — поправьте его в Настройках"
          }
        }
      }
    },
    "onboarding.issue.nameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
