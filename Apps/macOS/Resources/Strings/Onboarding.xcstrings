    "onboarding.issue.groupNameArchived": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Група з такой назвай ёсць у архіве: аднавіце яе ў наладах."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine archivierte Gruppe hat diesen Namen: Holen Sie sie stattdessen in den Einstellungen zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived group has this name: bring it back in Settings instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo archivado tiene este nombre: recupérelo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe archivé porte ce nom : ramenez-le dans les Réglages à la place."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անունով արխիվացված խումբ կա․ վերականգնեք այն Կարգավորումներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gruppo archiviato ha già questo nome: ripristinalo nelle Impostazioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мұрағатталған топ осы атаумен бар: оның орнына оны параметрлерде қайтарыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мындай аталыштагы топ архивде бар: аны Жөндөөлөрдөн калыбына келтириңиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowana grupa ma tę nazwę. Przywróć ją w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um grupo arquivado tem este nome. Restaure-o nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа с таким названием есть в архиве — верните её в Настройках."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гурӯҳи бойгонишудае ин номро дорад: онро дар Танзимот барқарор кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adla arşivlenmiş bir grup var: onu Ayarlar’dan geri getirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В архіві є група з такою назвою: поверніть її в налаштуваннях."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nomli guruh arxivda bor. Uni Sozlamalarda tiklang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
