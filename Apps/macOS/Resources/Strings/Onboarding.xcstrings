    "onboarding.account.existing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already in your records: its operations stay on it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está en sus registros: sus operaciones se quedan en ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà dans vos saisies : ses opérations y restent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже есть в учёте: его операции остаются на нём"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже є в обліку: його операції залишаться на ньому"
