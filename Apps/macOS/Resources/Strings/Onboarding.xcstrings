    "onboarding.groups.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы групы па-за зводкай не ўваходзяць у агульную і свабодную сумы і паказваюцца асобна; яе даходы і выдаткі па-ранейшаму ўлічваюцца ўсюды."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld einer Gruppe, die aus der Übersicht herausgenommen ist, zählt nicht in der Summe oder im freien Betrag und wird separat angezeigt; ihre Einnahmen und Ausgaben zählen überall weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money of a group out of the summary is not in the total or the free sum and is shown apart; its income and spending still count everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de un grupo fuera del resumen no está en el total ni en la suma libre y se muestra aparte; sus ingresos y gastos siguen contando en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent d'un groupe exclu du récapitulatif n'est ni dans le total ni dans la somme libre et s'affiche à part ; ses revenus et dépenses comptent toujours partout."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփումից դուրս խմբի գումարը չի ներառվում ընդհանուր և ազատ գումարների մեջ և ցուցադրվում է առանձին․ դրա եկամուտներն ու ծախսերը շարունակում են ներառվել բոլոր հաշվարկներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro di un gruppo escluso dal riepilogo non è incluso nel totale né nella somma disponibile ed è mostrato a parte; le sue entrate e uscite sono comunque conteggiate ovunque."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдан тыс топтың ақшасы жиында да, бос қаржыда да болмайды және бөлек көрсетіледі; оның табысы мен шығысы әр жерде әлі есептеледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жыйынтыкка кирбеген топтун акчасы жалпы жана жеткиликтүү суммага кошулбай, өзүнчө көрсөтүлөт; киреше жана чыгашалары бардык жерде эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieniądze z grupy wyłączonej z podsumowania nie są wliczane do sumy ani dostępnych środków i są wyświetlane osobno. Jej przychody i wydatki są nadal wszędzie uwzględniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro de um grupo fora do resumo não entra no total nem no valor livre e é mostrado separadamente; suas receitas e despesas continuam sendo contabilizadas em todos os lugares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги группы вне сводки не входят во «Всего» и в свободную сумму и показываются отдельно; её доходы и траты учитываются везде."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пули гурӯҳе, ки ба ҷамъбаст дохил нест, дар маблағи умумӣ ё озод ҳисоб намешавад ва алоҳида нишон дода мешавад; даромад ва хароҷоти он ҳамоно дар ҳама ҷо ҳисоб мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özet dışında tutulan bir grubun parası toplama veya kullanılabilir tutara dahil edilmez ve ayrı gösterilir; gelir ve giderleri ise her yerde hesaba katılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші групи поза підсумком не входять до загальної та вільної суми й показуються окремо; її доходи та витрати враховуються всюди."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumiy hisobdan chiqarilgan guruh puli jami va erkin mablag‘ga qo‘shilmaydi, alohida ko‘rsatiladi. Uning kirim va chiqimlari esa hamma joyda hisobga olinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未計入總覽的群組資金會另外顯示，不計入總額或可用金額；其收入和支出仍會照常計算。"
          }
        }
      }
    },
    "onboarding.intro": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажыце, дзе і колькі ў вас цяпер грошай. Уведзены баланс стане першай зверкай рахунку: далей яго баланс будзе роўны ўведзенай суме з улікам усіх наступных аперацый. Пустое поле азначае «не ведаю»: рахунак застанецца незвераным, а першая зверка стане яго адпраўным пунктам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie, wo Ihr Geld liegt und wie viel jetzt dort ist. Ein eingetragener Saldo wird der erste Abgleich des Kontos: Von da an ist sein Saldo das Gezählte plus alles, was danach bewegt wurde. Ein leeres Feld heißt „unbekannt“: Das Konto bleibt unabgeglichen, und seine erste Zählung wird sein Ausgangspunkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark where your money is and how much is there now. A balance you type becomes the account's first reconciliation: from then on its balance is what you counted plus everything that moved after it. An empty field means «don't know»: the account stays unreconciled, and its first count becomes its starting point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque dónde está su dinero y cuánto hay ahora. Un saldo que escribe se convierte en la primera conciliación de la cuenta: a partir de ahí su saldo es lo que contó más todo lo que se movió después. Un campo vacío significa «no lo sé»: la cuenta queda sin conciliar y su primer recuento se convierte en su punto de partida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez où se trouve votre argent et combien il y en a maintenant. Un solde saisi devient le premier rapprochement du compte : à partir de là, son solde est ce que vous avez compté plus tout ce qui a bougé après. Un champ vide signifie « je ne sais pas » : le compte reste non rapproché, et son premier comptage devient son point de départ."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշեք՝ որտեղ և որքան գումար ունեք այժմ։ Ձեր մուտքագրած մնացորդը կդառնա հաշվի առաջին համադրումը․ դրանից հետո մնացորդը կլինի ձեր հաշված գումարը՝ գումարած դրան հաջորդած բոլոր շարժերը։ Դատարկ դաշտը նշանակում է «չգիտեմ»․ հաշիվը կմնա չհամադրված, իսկ առաջին հաշվարկը կդառնա դրա ելակետը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica dove si trova il tuo denaro e quanto ce n’è ora. Il saldo inserito diventa la prima riconciliazione del conto: da quel momento il saldo corrisponde all’importo rilevato più tutti i movimenti successivi. Un campo vuoto significa «non lo so»: il conto resta da riconciliare e il primo saldo rilevato diventa il suo punto di partenza."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақшаңыз қайда екенін және қазір қанша бар екенін белгілеңіз. Теріп енгізген теңгерім есеп-шоттың алғашқы салыстыруы болады: содан бастап оның теңгерімі — санағаныңыз плюс одан кейін қозғалған бәрі. Бос өріс «білмеймін» дегенді білдіреді: есеп-шот салыстырылмаған күйінде қалады, ал оның алғашқы санауы — бастапқы нүкте."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акчаңыз кайда жана азыр канча экенин көрсөтүңүз. Киргизген калдык эсептин биринчи текшерүүсү болот: андан кийин калдык сиз санаган сумма менен андан кийинки бардык кыймылдардын негизинде эсептелет. Бош талаа «билбейм» дегенди билдирет: эсеп текшерилбей калат, ал эми биринчи санак анын баштапкы чекити болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaż, gdzie są Twoje pieniądze i ile ich teraz jest. Wpisane saldo stanie się pierwszym uzgodnieniem konta: odtąd jego saldo będzie sumą wpisanej kwoty i późniejszych operacji. Puste pole oznacza «nie wiem»: konto pozostanie nieuzgodnione, a pierwsze zliczenie stanie się jego punktem wyjścia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe onde está seu dinheiro e quanto há em cada lugar agora. O saldo informado será a primeira conciliação da conta: a partir daí, o saldo será o valor contado mais todas as movimentações posteriores. Um campo vazio significa «não sei»: a conta permanece sem conciliação, e a primeira contagem será seu ponto de partida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте, где лежат ваши деньги и сколько там сейчас. Вписанный остаток станет первой сверкой счёта: дальше остаток — это посчитанное плюс всё, что прошло после. Пустое поле — «не знаю»: такой счёт останется несверенным, и его первая сверка станет точкой отсчёта."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нишон диҳед, ки пулатон дар куҷост ва ҳоло чӣ қадар аст. Бақияи воридкардаатон санҷиши аввалини ҳисоб мешавад: аз он пас бақия ба маблағи шумурдаатон бо дарназардошти ҳамаи амалиёти минбаъда баробар аст. Майдони холӣ маънои «намедонам»-ро дорад: ҳисоб бе санҷиши бақия мемонад ва санҷиши аввал нуқтаи оғози он мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranızın nerede ve şu anda ne kadar olduğunu belirtin. Girdiğiniz bakiye, hesabın ilk mutabakatı olur: o andan itibaren bakiyesi, saydığınız tutara sonraki tüm hareketler eklenerek hesaplanır. Boş alan «bilmiyorum» anlamına gelir: hesap mutabık sayılmaz ve ilk sayım başlangıç noktası olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть, де ваші гроші й скільки їх зараз. Введений залишок стане першою звіркою рахунку: відтоді залишок дорівнює звіреній сумі плюс усі наступні рухи. Порожнє поле означає «не знаю»: рахунок залишиться незвіреним, а перша звірка стане його початком обліку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulingiz qayerda va hozir qancha ekanini kiriting. Kiritilgan qoldiq hisobning birinchi solishtiruvi bo‘ladi: bundan keyin qoldiq shu summa va undan keyingi barcha harakatlar asosida hisoblanadi. Bo‘sh maydon «bilmayman» degani: hisob solishtirilmagan holda qoladi va birinchi hisoblangan qoldiq boshlang‘ich nuqta bo‘ladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標示資金所在位置和目前金額。輸入的餘額會成為帳戶的首次核對結果：此後，帳戶餘額即為核對金額加上後續所有收支。欄位留空表示「不知道」：帳戶會維持未核對狀態，首次核對金額將成為起始餘額。"
          }
        }
      }
    },
    "onboarding.issue.emptyGroupName": {
