    "onboarding.card.action": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten einrichten…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Up Accounts…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттарды баптау…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроить счета…"
          }
        },
        "uk": {
