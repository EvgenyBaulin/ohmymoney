    "onboarding.card.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your accounts are not set up yet. Say where your money is and how much is there, and the balances are counted from then on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета ещё не настроены. Укажите, где лежат деньги и сколько там, — и остатки будут считаться дальше сами."
          }
        }
      }
    },
