    "onboarding.emptyBalances": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts with empty fields stay unreconciled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas con campos vacíos quedan sin conciliar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes dont les champs sont vides restent non rapprochés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета с пустыми полями останутся несверенными."
