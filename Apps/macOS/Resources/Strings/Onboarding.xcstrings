    "onboarding.failure.changed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль гэта акно было адкрыта, рахункі змяніліся ў наладах. Спіс абноўлены: праверце яго і націсніце «Гатова» яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konten wurden in den Einstellungen geändert, während dies offen war. Die Liste ist jetzt aktuell: Prüfen Sie sie und drücken Sie noch einmal „Fertig“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accounts changed in Settings while this was open. The list is up to date now: check it and press Done again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas cambiaron en Ajustes mientras esto estaba abierto. La lista ya está al día: compruébela y pulse Listo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes ont changé dans les Réglages pendant que cela était ouvert. La liste est à jour maintenant : vérifiez-la et appuyez à nouveau sur Terminé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշիվները փոխվել են Կարգավորումներում, մինչ այս պատուհանը բաց էր։ Ցանկն այժմ թարմացված է․ ստուգեք այն և կրկին սեղմեք «Պատրաստ է»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I conti sono stati modificati nelle Impostazioni mentre questa schermata era aperta. L’elenco è aggiornato: controllalo e premi di nuovo Fine."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ашық тұрғанда есеп-шоттар параметрлерде өзгерді. Тізім енді жаңарған: оны тексеріп, «Дайын» түймесін қайта басыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул терезе ачык турганда эсептер Жөндөөлөрдө өзгөртүлдү. Тизме жаңыртылды: аны текшерип, «Даяр» баскычын кайра басыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konta zostały zmienione w Ustawieniach. Lista jest już aktualna: sprawdź ją i ponownie naciśnij Gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As contas foram alteradas nos Ajustes enquanto esta tela estava aberta. A lista está atualizada: confira e toque em OK novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока это было открыто, счета изменились в Настройках. Список обновлён: проверьте его и нажмите «Готово» ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳангоми кушода будани ин равзана ҳисобҳо дар Танзимот тағйир ёфтанд. Рӯйхат нав шуд: онро санҷед ва боз «Тайёр»-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekran açıkken hesaplar Ayarlar’da değişti. Liste güncellendi: kontrol edip yeniden Bitti’ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки вікно було відкрите, рахунки змінилися в налаштуваннях. Список оновлено: перевірте й знову натисніть «Готово»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oyna ochiq paytda hisoblar Sozlamalarda o‘zgartirildi. Ro‘yxat yangilandi: uni tekshirib, Tayyor tugmasini yana bosing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶在此畫面開啟期間於「設定」中變更。列表已更新：請檢查後再次按下「完成」。"
          }
        }
      }
    },
    "onboarding.failure.read": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося прачытаць балансы, таму пакуль нічога нельга падлічыць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Salden konnten nicht gelesen werden, daher kann noch nichts gezählt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balances could not be read, so nothing can be counted yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los saldos, así que todavía no se puede contar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes n'ont pas pu être lus, donc rien ne peut encore être compté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց կարդալ մնացորդները, ուստի առայժմ հնարավոր չէ հաշվարկ կատարել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i saldi. Per ora non è possibile calcolare nulla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теңгерімдерді оқу мүмкін болмады, сондықтан әлі ешнәрсе есептеуге болмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Калдыктар окулган жок, ошондуктан азырынча эсептөө мүмкүн эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać sald, więc nie można jeszcze nic obliczyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os saldos. Por enquanto, nada pode ser calculado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать остатки — посчитать пока нельзя."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияҳоро хонда нашуд, бинобар ин ҳоло ҳисоб кардан имкон надорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiyeler okunamadı, bu yüzden henüz hesaplama yapılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати залишки, тому обчислення ще неможливе."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoldiqlarni o‘qib bo‘lmadi, shuning uchun hozircha hisoblab bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取餘額，因此目前無法計算。"
          }
        }
      }
    },
    "onboarding.failure.write": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Налады не захаваны. Паспрабуйце яшчэ раз; прычына ў журнале."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung wurde nicht gespeichert. Versuchen Sie es erneut; im Journal steht der Grund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setup was not saved. Try again; the log has the reason."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración no se guardó. Inténtelo de nuevo; el diario indica el motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration n'a pas été enregistrée. Réessayez ; le journal indique la raison."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարգավորումները չպահվեցին։ Կրկին փորձեք․ պատճառը գրանցամատյանում է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurazione non salvata. Riprova; il motivo è nel registro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баптау сақталмады. Қайталап көріңіз; себебі журналда."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жөндөөлөр сакталган жок. Кайра аракет кылыңыз; себеби журналда көрсөтүлгөн."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano konfiguracji. Spróbuj ponownie; przyczynę znajdziesz w dzienniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração não foi salva. Tente novamente; o motivo está no registro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка не сохранилась. Попробуйте ещё раз; причина — в журнале."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танзимот захира нашуд. Боз кӯшиш кунед; сабаб дар гузориш аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar kaydedilmedi. Yeniden deneyin; nedeni günlükte bulabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування не збережено. Спробуйте ще раз; причина в журналі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlamalar saqlanmadi. Qayta urinib ko‘ring; sababi jurnalda ko‘rsatilgan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定未儲存。請再試一次；原因請查看記錄。"
          }
        }
      }
    },
