    "starter.subtitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Як вы жывяце? Выберыце адзін або некалькі варыянтаў — OhMyMoney дадасць катэгорыі, прыклады лімітаў і пліткі. Нічога не будзе выдалена або перайменавана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie leben Sie? Wählen Sie eine oder mehrere Möglichkeiten — OhMyMoney ergänzt Kategorien, Beispiel-Limits und Kacheln. Nichts wird entfernt oder umbenannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you live? Choose one or several — OhMyMoney adds categories, example limits and tiles. Nothing is removed or renamed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo vive? Elija uno o varios — OhMyMoney añade categorías, límites de ejemplo y mosaicos. No se elimina ni se renombra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment vivez-vous ? Choisissez-en un ou plusieurs — OhMyMoney ajoute des catégories, des exemples de plafonds et des tuiles. Rien n'est supprimé ni renommé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչպե՞ս եք ապրում։ Ընտրեք մեկ կամ մի քանի տարբերակ․ OhMyMoney-ն կավելացնի կատեգորիաներ, սահմանաչափերի օրինակներ և սալիկներ։ Ոչինչ չի հեռացվի կամ վերանվանվի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come vivi? Scegli una o più opzioni: OhMyMoney aggiungerà categorie, limiti di esempio e riquadri. Non verrà rimosso o rinominato nulla."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалай өмір сүресіз? Біреуін немесе бірнешеуін таңдаңыз — OhMyMoney санаттар, үлгі лимиттер және тақтайшалар қосады. Ештеңе өшірілмейді және аты өзгермейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жашооңуз кандай? Бир же бир нечесин тандаңыз — OhMyMoney категорияларды, үлгү лимиттерди жана плиткаларды кошот. Эч нерсе өчүрүлбөйт же аты өзгөртүлбөйт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak żyjesz? Wybierz jedną lub kilka opcji — OhMyMoney doda kategorie, przykładowe limity i kafelki. Nic nie zostanie usunięte ani przemianowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como é sua vida? Escolha uma ou mais opções — o OhMyMoney adiciona categorias, exemplos de limites e cartões. Nada é removido ou renomeado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как вы живёте? Выберите одно или несколько — OhMyMoney добавит категории, примеры лимитов и плитки. Ничего не удаляется и не переименовывается."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарзи зиндагии шумо чӣ гуна аст? Як ё якчанд вариантро интихоб кунед — OhMyMoney категорияҳо, лимитҳои намунавӣ ва сафолакҳоро илова мекунад. Ҳеҷ чиз нест ё тағйири ном намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl yaşıyorsunuz? Bir veya birkaç seçenek seçin — OhMyMoney kategoriler, örnek limitler ve kutucuklar eklesin. Hiçbir şey kaldırılmaz veya yeniden adlandırılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як ви живете? Виберіть один або кілька варіантів — OhMyMoney додасть категорії, приклади лімітів і плитки. Нічого не видаляється й не перейменовується."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Turmush tarzingiz qanday? Bir yoki bir nechtasini tanlang — OhMyMoney turkumlar, namunaviy limitlar va kartochkalarni qo‘shadi. Hech narsa o‘chirilmaydi yoki nomi o‘zgartirilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的生活方式是什麼？選擇一個或多個項目，OhMyMoney 就會加入類別、範例限額和圖塊。現有項目不會被移除或重新命名。"
          }
        }
      }
    },
