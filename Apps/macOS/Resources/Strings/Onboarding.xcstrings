    "onboarding.account.existing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon in Ihren Aufzeichnungen: Die Vorgänge bleiben darauf"
