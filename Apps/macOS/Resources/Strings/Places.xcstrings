          "stringUnit": {
            "state": "translated",
            "value": "Бул сиз адатта колдонгон карта."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de kaart die je meestal gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To karta, której zwykle używasz."
