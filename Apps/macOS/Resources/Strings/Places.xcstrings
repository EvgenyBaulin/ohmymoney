    "places.mark.categoryFooter": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerdə hələ alış olmadıqda istifadə olunur; sonra ən çox aldığınız kateqoriya seçilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкарыстоўваецца, пакуль у гэтым месцы няма пакупак. Пасля выбіраецца катэгорыя, у якой вы купляеце тут часцей за ўсё."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije se, dokud na tomto místě nejsou žádné nákupy. Poté se použije kategorie, ve které zde nakupujete nejčastěji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, solange es hier noch keine Käufe gibt. Danach wird die häufigste Kategorie verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used while the place has no purchases yet; later the category you buy there most often is taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa mientras no haya compras en el lugar. Después se usa la categoría en la que compras con más frecuencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé tant qu’aucun achat n’est enregistré ici. Ensuite, la catégorie la plus fréquente est utilisée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգտագործվում է, քանի դեռ վայրում գնումներ չկան։ Հետագայում ընտրվում է այն կատեգորիան, որից այստեղ ամենից հաճախ եք գնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata finché non ci sono acquisti per questo luogo; in seguito viene usata la categoria più frequente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所での購入履歴がない間に使われます。その後は、最もよく購入するカテゴリが使われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოიყენება, სანამ ამ ადგილას შესყიდვა არ გაქვთ. შემდეგ აირჩევა კატეგორია, რომელსაც აქ ყველაზე ხშირად ყიდულობთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл жерде әлі сатып алу болмаған кезде қолданылады; кейін ең жиі сатып алатын санат алынады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장소에 구매 내역이 없을 때 사용됩니다. 이후에는 가장 자주 구매하는 카테고리가 사용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул жерде сатып алуулар жок кезде колдонулат; кийин эң көп сатып алынган категория колдонулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt zolang er nog geen aankopen op deze plek zijn. Daarna wordt de categorie gebruikt waarin je hier het vaakst koopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używana do czasu pierwszego zakupu w tym miejscu. Później używana jest kategoria najczęstszych zakupów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada enquanto o local não tiver compras. Depois, será usada a categoria mais frequente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada enquanto não houver compras neste local. Depois, é usada a categoria mais frequente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, пока в этом месте нет покупок; потом берётся категория, которую вы там покупаете чаще всего."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "То замоне истифода мешавад, ки дар ин ҷой харид надоред; баъд категорияи харидҳои маъмултарини шумо интихоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerde henüz alışveriş yokken kullanılır. Daha sonra en sık alışveriş yaptığınız kategori seçilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується, доки тут немає покупок. Потім використовується категорія, у якій ви купуєте тут найчастіше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu joyda xaridlar bo‘lmaguncha ishlatiladi; keyin eng ko‘p xarid qilinadigan toifa tanlanadi."
          }
        }
      }
    },
