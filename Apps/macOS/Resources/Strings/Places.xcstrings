    "places.marks.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ nişan yoxdur. Ödəniş etdiyiniz yerdə durun və «Bu yeri nişanla»ya toxunun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма адзнак. Знаходзячыся ў месцы аплаты, націсніце «Адзначыць гэтае месца»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádná místa. Postavte se tam, kde platíte, a klepněte na «Označit toto místo»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Markierungen. Tippe beim Bezahlen auf «Diesen Ort markieren»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No marks yet. Stand where you pay and tap «Mark this place»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay marcas. Sitúate donde pagas y toca «Marcar este lugar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun repère. Placez-vous à l’endroit où vous payez et touchez «Marquer ce lieu»."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշումներ դեռ չկան։ Գնացեք վճարման վայր և հպեք «Նշել այս վայրը»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun luogo salvato. Vai nel luogo in cui paghi e tocca «Salva questo luogo»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録した場所はありません。支払いをする場所で「この場所を登録」をタップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონიშნული ადგილები ჯერ არ არის. დადექით გადახდის ადგილას და შეეხეთ «ამ ადგილის მონიშვნა»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әлі белгі жоқ. Төлем жасайтын жерге барып, «Осы жерді белгілеу» түймесін түртіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시한 장소가 없습니다. 결제하는 장소에서 «이 장소 표시»를 탭하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгилер жок. Төлөгөн жериңизде туруп, «Бул жерди белгилөө» баскычын басыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen markeringen. Ga staan waar je betaalt en tik op «Markeer deze plek»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak oznaczonych miejsc. Stań w miejscu, w którym płacisz, i stuknij «Oznacz to miejsce»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum local marcado. Vá até onde você paga e toque em «Marcar este local»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há locais marcados. No local onde paga, toque em «Marcar este local»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметок пока нет. Встаньте там, где платите, и нажмите «Отметить это место»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло нишонае нест. Дар ҷои пардохт истода, «Ин ҷойро нишон кунед»-ро пахш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz işaret yok. Ödeme yaptığınız yerde durup «Burayı işaretle»ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначок ще немає. Станьте там, де платите, і торкніть «Позначити це місце»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha belgilar yo‘q. To‘lov qiladigan joyda turib, «Bu joyni belgilash»ni bosing."
          }
        }
      }
    },
