        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ადგილის მონიშვნა ვერ მოხერხდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгі сақталмады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 저장하지 못했습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Белги сакталган жок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De markering is niet bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O local não foi salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить отметку."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нишона захира нашуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaret kaydedilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти позначку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgi saqlanmadi."
          }
        }
      }
    },
    "places.hints.footer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Standart olaraq sönülüdür. Nişanladığınız yerə yaxınlaşanda telefon orada hansı kartla ödəməyin daha sərfəli olduğunu bildirir. Məkanınız bu telefonda yoxlanılır və heç yerə göndərilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прадвызначана выключана. Калі вы набліжаецеся да адзначанага месца, тэлефон падказвае, якой карткай там больш выгадна плаціць. Ваша месцазнаходжанне правяраецца на гэтым тэлефоне і нікуды не адпраўляецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím stavu vypnuto. Když se přiblížíte k označenému místu, telefon vám řekne, kterou kartou se tam nejvíc vyplatí platit. Poloha se zjišťuje v tomto telefonu a nikam se neposílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig deaktiviert. In der Nähe eines markierten Ortes zeigt dir dein iPhone, welche Karte dort am besten ist. Dein Standort wird nur auf diesem Gerät geprüft und nicht gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When you come near a place you marked, the phone says which card pays best there. Your position is checked on this phone and never sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por omisión. Al acercarte a un lugar marcado, el teléfono te indica qué tarjeta ofrece más ventajas allí. Tu ubicación se comprueba en este teléfono y nunca se envía a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. À proximité d’un lieu marqué, le téléphone indique la carte la plus avantageuse. Votre position est vérifiée sur ce téléphone et n’est jamais envoyée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լռելյայն անջատված է։ Երբ մոտենաք նշված վայրին, հեռախոսը կհուշի՝ որ քարտով է այնտեղ առավել շահավետ վճարել։ Ձեր տեղադրությունը ստուգվում է այս հեռախոսում և ոչ մի տեղ չի ուղարկվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivati di default. Quando sei vicino a un luogo salvato, il telefono ti indica la carta più conveniente. La posizione viene verificata su questo telefono e non viene mai inviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフです。登録した場所に近づくと、最もお得なカードが通知されます。位置情報はこのデバイス上で確認され、外部に送信されることはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაგულისხმევად გამორთულია. მონიშნულ ადგილთან მიახლოებისას ტელეფონი გეტყვით, რომელი ბარათით გადახდაა იქ ყველაზე მომგებიანი. მდებარეობა მოწმდება ამ ტელეფონზე და არსად იგზავნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдепкіде өшірулі. Белгілеген жерге жақындағанда, телефон қай картамен төлеу тиімді екенін көрсетеді. Орналасқан жеріңіз осы телефонда тексеріледі және ешқайда жіберілмейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 꺼져 있습니다. 표시한 장소에 가까이 가면 어떤 카드로 결제하는 것이 가장 유리한지 알려줍니다. 위치는 이 기기에서 확인하며 어디에도 전송되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Демейкиде өчүк. Белгиленген жерге жакындаганда, телефон ал жерде кайсы карта менен төлөө пайдалуу экенин көрсөтөт. Жайгашкан жериңиз ушул телефондо текшерилет жана эч жакка жөнөтүлбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard uit. Als je in de buurt van een gemarkeerde plek komt, laat je telefoon zien met welke kaart je daar het voordeligst betaalt. Je locatie wordt op deze telefoon gecontroleerd en nergens naartoe gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie wyłączone. Gdy zbliżysz się do oznaczonego miejsca, telefon podpowie, którą kartą najlepiej tam zapłacić. Twoja lokalizacja jest sprawdzana na tym telefonie i nigdzie nie jest wysyłana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Ao se aproximar de um local marcado, o telefone informa qual cartão oferece a melhor vantagem ali. Sua localização é verificada neste telefone e nunca é enviada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por predefinição. Ao aproximar-se de um local marcado, o iPhone indica o cartão mais vantajoso. A localização é verificada neste dispositivo e nunca é enviada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено по умолчанию. Когда вы подходите к отмеченному месту, телефон говорит, какой картой там лучше платить. Ваше положение проверяется на этом телефоне и никуда не отправляется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо нобаёнӣ хомӯш аст. Вақте ба ҷои нишондодашуда наздик мешавед, телефон мегӯяд, ки кадом корт барои пардохт беҳтар аст. Ҷойгиршавӣ танҳо дар ҳамин телефон санҷида мешавад ва ба ҳеҷ куҷо фиристода намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saptanmış olarak kapalıdır. İşaretlediğiniz bir yere yaklaştığınızda telefon, orada hangi kartın daha avantajlı olduğunu söyler. Konumunuz bu telefonda kontrol edilir ve hiçbir yere gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово вимкнено. Коли ви наближаєтеся до позначеного місця, телефон підказує, якою карткою там вигідніше платити. Ваше місцеположення перевіряється на цьому телефоні й нікуди не надсилається."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatiy holatda o‘chiq. Belgilangan joyga yaqinlashganingizda, telefon qaysi karta bilan to‘lash foydaliroq ekanini bildiradi. Joylashuvingiz shu telefonda aniqlanadi va hech qayerga yuborilmaydi."
          }
        }
      }
    },
