{
  "sourceLanguage": "en",
  "strings": {
    "places.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mark was not saved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить отметку."
          }
        }
      }
    },
    "places.hints.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When you come near a place you marked, the phone says which card pays best there. Your position is checked on this phone and never sent anywhere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено по умолчанию. Когда вы подходите к отмеченному месту, телефон говорит, какой картой там лучше платить. Ваше положение проверяется на этом телефоне и никуда не отправляется."
          }
        }
      }
    },
    "places.hints.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hints near marked places"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказки рядом с отмеченными местами"
          }
        }
      }
    },
    "places.map.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark a place first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала отметьте место."
          }
        }
      }
    },
    "places.map.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The marks and what you spent at them are drawn on this phone. Nothing is sent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметки и траты в них рисуются на этом телефоне. Ничего не отправляется."
          }
        }
      }
    },
    "places.map.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map of spending"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта трат"
          }
        }
      }
    },
    "places.mark.cannotLocate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone could not tell where you are. Allow location for OhMyMoney in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не смог определить, где вы. Разрешите OhMyMoney доступ к геопозиции в настройках."
          }
        }
      }
    },
    "places.mark.category": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you buy here"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы здесь покупаете"
          }
        }
      }
    },
    "places.mark.categoryFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used while the place has no purchases yet; later the category you buy there most often is taken."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, пока в этом месте нет покупок; потом берётся категория, которую вы там покупаете чаще всего."
          }
        }
      }
    },
    "places.mark.here": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark this place"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить это место"
          }
        }
      }
    },
    "places.mark.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название"
          }
        }
      }
    },
    "places.mark.new": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New mark"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая отметка"
          }
        }
      }
    },
    "places.mark.noCategory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не указано"
          }
        }
      }
    },
    "places.mark.radius": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within %lld m"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В радиусе %lld м"
          }
        }
      }
    },
    "places.marks.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No marks yet. Stand where you pay and tap «Mark this place»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметок пока нет. Встаньте там, где платите, и нажмите «Отметить это место»."
          }
        }
      }
    },
    "places.marks.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметки"
          }
        }
      }
    },
    "places.notice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay with «%@» here: %@ for «%@»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь лучше платить «%@»: %@ за «%@»."
          }
        }
      }
    },
    "places.notice.bodyNoCategory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay with «%@» here: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь лучше платить «%@»: %@."
          }
        }
      }
    },
    "places.notice.someCard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a card"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "карта"
          }
        }
      }
    },
    "places.notice.usual": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the card you usually use."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы и так обычно платите ею."
          }
        }
      }
    },
    "places.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Места"
          }
        }
      }
    }
  },
  "version": "1.0"
}
