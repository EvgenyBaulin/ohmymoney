        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося захаваць адзнаку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místo se nepodařilo uložit."
          }
        },
        "de": {
