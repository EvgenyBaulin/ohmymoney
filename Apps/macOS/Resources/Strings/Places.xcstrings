    "places.map.footer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nişanlar və onlarda xərclədiyiniz məbləğlər bu telefonda göstərilir. Heç nə göndərilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адзнакі і выдаткі ў гэтых месцах паказваюцца на гэтым тэлефоне. Нічога не адпраўляецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označená místa a útraty na nich se zobrazují v tomto telefonu. Nic se nikam neposílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Markierungen und deine Ausgaben werden auf diesem Gerät angezeigt. Es werden keine Daten gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The marks and what you spent at them are drawn on this phone. Nothing is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las marcas y tus gastos en ellas se muestran en este teléfono. No se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les repères et vos dépenses associées sont affichés sur ce téléphone. Rien n’est envoyé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշումներն ու դրանցում կատարած ծախսերը ցուցադրվում են այս հեռախոսում։ Ոչինչ չի ուղարկվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I luoghi salvati e le relative spese sono visualizzati su questo telefono. Nessun dato viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録した場所とその場所での支出は、このデバイス上に表示されます。データは送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონიშნული ადგილები და მათზე გაწეული ხარჯები გამოისახება ამ ტელეფონზე. მონაცემები არსად იგზავნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгілер мен олардағы шығындар осы телефонда көрсетіледі. Ештеңе жіберілмейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시한 장소와 해당 장소에서 지출한 금액은 이 기기에 표시됩니다. 정보는 전송되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгилер жана ал жерлердеги чыгымдар ушул телефондо көрсөтүлөт. Эч нерсе жөнөтүлбөйт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De markeringen en je uitgaven op die plekken worden op deze telefoon weergegeven. Er wordt niets verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsca i wydatki są wyświetlane na tym telefonie. Nic nie jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os locais marcados e seus gastos neles são exibidos neste telefone. Nada é enviado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os locais marcados e as respetivas despesas são apresentados neste dispositivo. Não é enviado nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметки и траты в них рисуются на этом телефоне. Ничего не отправляется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нишонаҳо ва хароҷоти шумо дар ин ҷойҳо дар ҳамин телефон нишон дода мешаванд. Ҳеҷ чиз фиристода намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretler ve bu yerlerdeki harcamalarınız bu telefonda gösterilir. Hiçbir şey gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначки та витрати в цих місцях відображаються на цьому телефоні. Дані нікуди не надсилаються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgilar va ulardagi xarajatlar shu telefonda ko‘rsatiladi. Hech narsa yuborilmaydi."
          }
        }
      }
    },
