        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o cartão que você costuma usar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É o cartão que costuma usar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы и так обычно платите ею."
