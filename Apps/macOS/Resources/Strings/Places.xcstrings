    "places.mark.cannotLocate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon yerinizi müəyyən edə bilmədi. Ayarlarda OhMyMoney üçün məkana girişi aktiv edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэлефон не змог вызначыць ваша месцазнаходжанне. Дазвольце доступ да геалакацыі для OhMyMoney у Наладах."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon nedokázal zjistit vaši polohu. Povolte OhMyMoney přístup k poloze v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort konnte nicht ermittelt werden. Erlaube OhMyMoney in den Einstellungen den Zugriff auf deinen Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone could not tell where you are. Allow location for OhMyMoney in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono no ha podido determinar tu ubicación. Permite el acceso a la ubicación de OhMyMoney en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vous localiser. Autorisez OhMyMoney à accéder à votre position dans Réglages."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հեռախոսին չհաջողվեց որոշել ձեր տեղադրությունը։ Կարգավորումներում թույլատրեք OhMyMoney-ին օգտվել տեղադրությունից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rilevare la posizione. Consenti l'accesso alla posizione per OhMyMoney in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を取得できませんでした。「設定」でOhMyMoneyの位置情報を許可してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტელეფონმა მდებარეობა ვერ განსაზღვრა. პარამეტრებში მიეცით OhMyMoney-ს მდებარეობაზე წვდომა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон орналасқан жеріңізді анықтай алмады. Баптауларда OhMyMoney үшін геолокацияға рұқсат беріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치를 확인할 수 없습니다. 설정에서 OhMyMoney의 위치 접근을 허용하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон жайгашкан жериңизди аныктай алган жок. Жөндөөлөрдөн OhMyMoney үчүн геолокацияга уруксат бериңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon kon je locatie niet bepalen. Geef OhMyMoney toegang tot je locatie in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ustalić Twojej lokalizacji. Zezwól aplikacji OhMyMoney na dostęp do lokalizacji w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível determinar sua localização. Permita o acesso à localização para o OhMyMoney em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível determinar a sua localização. Permita o acesso à localização para OhMyMoney nas Definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не смог определить, где вы. Разрешите OhMyMoney доступ к геопозиции в настройках."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон ҷойгиршавии шуморо муайян карда натавонист. Дар Танзимот ба OhMyMoney дастрасӣ ба ҷойгиршавиро иҷозат диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon konumunuzu belirleyemedi. Ayarlar'da OhMyMoney için konum izni verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити ваше місцеположення. Дозвольте доступ до геопозиції для OhMyMoney у Параметрах."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon joylashuvingizni aniqlay olmadi. Sozlamalarda OhMyMoney uchun joylashuvga ruxsat bering."
          }
        }
      }
    },
