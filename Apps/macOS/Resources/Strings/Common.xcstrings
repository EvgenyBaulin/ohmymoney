    "privacy.password.rule": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən azı 4 simvol. Yalnız bu Mac-ın Açar Zəncirində heş kimi saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не менш за 4 знакі. Захоўваецца толькі на гэтым Mac у выглядзе хэша ў Звязцы ключоў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 4 Zeichen. Wird nur auf diesem Mac aufbewahrt, als Hash im Schlüsselbund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 4 characters. Kept on this Mac only, as a hash in its Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos 4 caracteres. Se guarda solo en este Mac, como hash en su Llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins 4 caractères. Conservé sur ce Mac seulement, sous forme d'empreinte dans son Trousseau."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առնվազն 4 նիշ։ Պահվում է միայն այս Mac-ի Keychain-ում՝ որպես հեշ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno 4 caratteri. Conservata solo su questo Mac come hash nel portachiavi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მინიმუმ 4 სიმბოლო. ინახება მხოლოდ ამ Mac-ის Keychain-ში, ჰეშის სახით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кемінде 4 таңба. Тек осы Mac-те, оның Keychain-інде хэш ретінде сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеминде 4 белги. Ушул Mac компьютериндеги Keychain'де хэш түрүндө гана сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co najmniej 4 znaki. Skrót hasła jest przechowywany tylko w pęku kluczy tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos 4 caracteres. Guardada apenas neste Mac, como um hash nas Chaves."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos 4 caracteres. Guardada apenas neste Mac, como hash na Porta-chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не короче 4 символов. Хранится только на этом Mac — хешем в связке ключей."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Камаш 4 аломат. Танҳо дар ин Mac ҳамчун ҳеш дар Keychain нигоҳ дошта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az 4 karakter. Yalnızca bu Mac’in Anahtar Zinciri’nde özet olarak saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щонайменше 4 символи. Зберігається лише на цьому Mac як хеш у В'язці ключів."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamida 4 ta belgi. Faqat ushbu Mac’da, Keychain’da xesh sifatida saqlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 4 個字元。僅以雜湊值儲存在這部 Mac 的鑰匙圈中。"
          }
        }
      }
    },
