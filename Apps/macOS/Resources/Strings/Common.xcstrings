          "stringUnit": {
            "state": "translated",
            "value": "Дерекқорды ашу мүмкін болмады"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il database"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося адкрыць базу даных"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank konnte nicht geöffnet werden"
          }
        }
      }
    },
    "error.database.applicationDamaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application is incomplete: the description of the database is missing from it. Install OhMyMoney again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación está incompleta: le falta la descripción de la base de datos. Vuelva a instalar OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application est incomplète : la description de la base y manque. Réinstallez OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение неполное: в нём нет описания базы данных. Установите OhMyMoney заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок неповний: у ньому немає опису бази даних. Установіть OhMyMoney знову."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба толық емес: онда дерекқордың сипаттамасы жоқ. OhMyMoney-ді қайта орнатыңыз."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’applicazione è incompleta: manca la descrizione del database. Installa di nuovo OhMyMoney."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма няпоўная: адсутнічае апісанне базы даных. Усталюйце OhMyMoney зноў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist unvollständig: Die Beschreibung der Datenbank fehlt. Installieren Sie OhMyMoney erneut."
          }
        }
      }
    },
    "error.database.copyBeforeUpdate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of the database could not be saved before the update. The database was not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar una copia de la base de datos antes de la actualización. La base de datos no se modificó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie de la base n'a pas pu être enregistrée avant la mise à jour. La base n'a pas été modifiée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед обновлением базы не удалось сохранить её копию. База не изменена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти копію бази даних перед оновленням. База даних не змінилася."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңартар алдында дерекқордың көшірмесін сақтау мүмкін болмады. Дерекқор өзгерген жоқ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare una copia del database prima dell’aggiornamento. Il database non è stato modificato."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося захаваць копію базы даных перад абнаўленнем. База даных не зменена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Update konnte keine Kopie der Datenbank gesichert werden. Die Datenbank wurde nicht verändert."
          }
        }
      }
    },
    "error.database.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database file is damaged, or it is not a database. Try again, or restore a copy; the file as it is now is kept first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de la base de datos está dañado o no es una base de datos. Inténtelo de nuevo o restaure una copia; primero se guarda el archivo tal como está ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de la base est endommagé, ou ce n'est pas une base. Réessayez, ou restaurez une copie ; le fichier tel qu'il est maintenant est d'abord conservé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл базы повреждён или это не база данных. Попробуйте ещё раз или восстановите копию; нынешний файл перед этим сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл бази даних пошкоджено або це не база даних. Спробуйте ще раз або відновіть копію; перед цим поточний файл буде збережено."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор файлы бүлінген, не ол дерекқор емес. Қайталап көріңіз немесе көшірмесін қалпына келтіріңіз; қазіргі файл алдын ала сақталады."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è danneggiato o non è un database. Riprova o ripristina una copia; il file attuale verrà prima conservato."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл базы даных пашкоджаны або не з'яўляецца базай даных. Паўтарыце спробу або аднавіце копію; бягучы файл будзе папярэдне захаваны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbankdatei ist beschädigt oder keine Datenbank. Versuchen Sie es erneut oder stellen Sie eine Kopie wieder her; die Datei in ihrem jetzigen Zustand wird vorher aufbewahrt."
          }
        }
      }
    },
    "error.database.dataSetMissing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data set has not been made yet: a Debug build makes it at launch with --generate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conjunto de datos todavía no se ha creado: una compilación de depuración lo crea al iniciarse con --generate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu de données n'a pas encore été créé : une version Debug le crée au lancement avec --generate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого набора данных ещё нет: его создаёт Debug-сборка при запуске с --generate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей набір даних ще не створено: збірка Debug створює його під час запуску з --generate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл деректер жиыны әлі жасалмаған: Debug құрастыру оны іске қосқанда --generate арқылы жасайды."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo set di dati non è ancora stato creato: una build Debug lo crea all’avvio con --generate."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты набор даных яшчэ не створаны: зборка Debug стварае яго пры запуску з --generate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Datensatz wurde noch nicht erstellt: Ein Debug-Build erstellt ihn beim Start mit --generate."
          }
        }
      }
    },
    "error.database.newerSchema": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database was written by a newer version of OhMyMoney. Update the app — or restore a copy made by this version; the database as it is now is kept first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos la escribió una versión más reciente de OhMyMoney. Actualice la app o restaure una copia hecha por esta versión; primero se guarda la base de datos tal como está ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base a été écrite par une version plus récente d'OhMyMoney. Mettez l'application à jour — ou restaurez une copie faite par cette version ; la base telle qu'elle est maintenant est d'abord conservée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу записала более новая версия OhMyMoney. Обновите приложение — или восстановите копию, сделанную этой версией; нынешняя база перед этим сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу даних записала новіша версія OhMyMoney. Оновіть застосунок або відновіть копію, створену цією версією; перед цим поточну базу буде збережено."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқорды OhMyMoney-дің жаңа нұсқасы жазған. Қолданбаны жаңартыңыз — не осы нұсқа жасаған көшірмені қалпына келтіріңіз; қазіргі дерекқор алдын ала сақталады."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database è stato scritto da una versione più recente di OhMyMoney. Aggiorna l’app o ripristina una copia creata con questa versione; il database attuale verrà prima conservato."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "База даных запісана ў навейшай версіі OhMyMoney. Абнавіце праграму або аднавіце копію, створаную гэтай версіяй; бягучая база даных будзе папярэдне захавана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank wurde von einer neueren Version von OhMyMoney geschrieben. Aktualisieren Sie die App — oder stellen Sie eine Kopie wieder her, die mit dieser Version erstellt wurde; die Datenbank in ihrem jetzigen Zustand wird vorher aufbewahrt."
          }
        }
      }
    },
    "error.database.other": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If that does not help, collect a problem report: Help → Collect a Problem Report…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtelo de nuevo. Si no ayuda, reúna un informe del problema: Ayuda → Reunir informe del problema…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez. Si cela ne suffit pas, créez un rapport de problème : Aide → Créer un rapport de problème…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте ещё раз. Если не поможет, соберите отчёт: Справка → Собрать отчёт о проблеме…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте ще раз. Якщо це не допоможе, зберіть звіт про проблему: Довідка → Зібрати звіт про проблему…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайталап көріңіз. Көмектеспесе, қате туралы есеп жинаңыз: Анықтама → Қате туралы есеп жинау…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova. Se il problema persiste, raccogli un rapporto sul problema: Aiuto → Raccogli un rapporto sul problema…"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паўтарыце спробу. Калі гэта не дапаможа, збярыце справаздачу аб праблеме: Даведка → Сабраць справаздачу аб праблеме…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es erneut. Hilft das nicht, erstellen Sie einen Problembericht: Hilfe → Problembericht erstellen…"
          }
        }
      }
    },
