    "replacement.giveUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give Up"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказаться"
          }
        }
      }
    },
    "replacement.notApplied.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data you had before is open, and the copy you chose is still waiting. Retry relaunches the app and tries again; Give Up keeps the data you have and drops the waiting copy — the file it came from stays where it is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыты прежние данные, а выбранная копия ждёт. «Повторить» перезапустит приложение и попробует ещё раз; «Отказаться» оставит текущие данные и уберёт ждущую копию — файл, из которого она взята, останется на месте."
          }
        }
      }
    },
    "replacement.notApplied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy was not put in place"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копию не удалось подставить"
          }
        }
      }
    },
    "replacement.refused.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of OhMyMoney cannot open the database you restored or imported: a newer version wrote it, or it is damaged. The data you had before is open; the file you chose stays where it is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия OhMyMoney не может открыть восстановленную или загруженную базу: её записала более новая версия, или она повреждена. Открыты прежние данные; выбранный файл остался на месте."
          }
        }
      }
    },
    "replacement.refused.title": {
      "extractionState": "manual",
      "localizations": {
