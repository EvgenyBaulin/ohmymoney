    "write.refused": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "База даных не прыняла змяненне. Паспрабуйце яшчэ раз. Калі гэта не дапаможа, збярыце справаздачу аб праблеме: Даведка → Сабраць справаздачу аб праблеме…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank hat die Änderung nicht übernommen. Versuchen Sie es erneut. Hilft das nicht, erstellen Sie einen Problembericht: Hilfe → Problembericht erstellen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database did not take the change. Try again. If that does not help, collect a problem report: Help → Collect a Problem Report…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos no aceptó el cambio. Inténtelo de nuevo. Si no ayuda, reúna un informe del problema: Ayuda → Reunir informe del problema…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas accepté la modification. Réessayez. Si cela ne suffit pas, créez un rapport de problème : Aide → Créer un rapport de problème…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database non ha registrato la modifica. Riprova. Se il problema persiste, raccogli un resoconto del problema: Aiuto → Raccogli un resoconto del problema…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор өзгерісті қабылдамады. Қайталап көріңіз. Көмектеспесе, қате туралы есеп жинаңыз: Анықтама → Қате туралы есеп жинау…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać zmiany w bazie danych. Spróbuj ponownie. Jeśli to nie pomoże, zbierz raport o problemie: Pomoc → Zbierz raport o problemie…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados não aceitou a alteração. Tente novamente. Se isso não ajudar, colete um relatório de problema: Ajuda → Coletar Relatório de Problema…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База данных не приняла изменение. Попробуйте ещё раз. Если не поможет, соберите отчёт: Справка → Собрать отчёт о проблеме…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik veri tabanına kaydedilemedi. Yeniden deneyin. Sorun sürerse bir sorun raporu toplayın: Yardım → Sorun Raporu Topla…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "База даних не прийняла зміну. Спробуйте ще раз. Якщо це не допоможе, зберіть звіт про проблему: Довідка → Зібрати звіт про проблему…"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarish ma’lumotlar bazasiga yozilmadi. Qayta urinib ko‘ring. Agar bu yordam bermasa, muammo hisobotini to‘plang: Yordam → Muammo hisobotini to‘plash…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫未接受更改。請再試一次。若問題持續發生，請收集問題報告：輔助說明 → 收集問題報告⋯"
          }
        }
      }
    },
