    "error.database.applicationDamaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq natamamdır: verilənlər bazasının təsviri yoxdur. OhMyMoney-ni yenidən quraşdırın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграма няпоўная: адсутнічае апісанне базы даных. Усталюйце OhMyMoney зноў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist unvollständig: Die Beschreibung der Datenbank fehlt. Installieren Sie OhMyMoney erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application is incomplete: the description of the database is missing from it. Install OhMyMoney again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación está incompleta: le falta la descripción de la base de datos. Vuelva a instalar OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application est incomplète : la description de la base y manque. Réinstallez OhMyMoney."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածն ամբողջական չէ․ տվյալների շտեմարանի նկարագրությունը բացակայում է։ Կրկին տեղադրեք OhMyMoney-ն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’applicazione è incompleta: manca la descrizione del database. Installa di nuovo OhMyMoney."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპი არასრულია: მონაცემთა ბაზის აღწერა აკლია. ხელახლა დააინსტალირეთ OhMyMoney."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба толық емес: онда дерекқордың сипаттамасы жоқ. OhMyMoney-ді қайта орнатыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмо толук эмес: маалымат базасынын сүрөттөмөсү жок. OhMyMoney’ни кайра орнотуңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja jest niekompletna: brakuje w niej opisu bazy danych. Zainstaluj OhMyMoney ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo está incompleto: falta a descrição do banco de dados. Instale o OhMyMoney novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação está incompleta: falta a descrição da base de dados. Instale OhMyMoney novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение неполное: в нём нет описания базы данных. Установите OhMyMoney заново."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома нопурра аст: тавсифи пойгоҳи додаҳо мавҷуд нест. OhMyMoney-ро аз нав насб кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama eksik: Veritabanı açıklaması bulunamadı. OhMyMoney’i yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок неповний: у ньому немає опису бази даних. Установіть OhMyMoney знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova to‘liq emas: unda ma’lumotlar bazasi tavsifi yo‘q. OhMyMoney’ni qayta o‘rnating."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不完整：缺少資料庫描述。請重新安裝 OhMyMoney。"
          }
        }
      }
    },
    "error.database.copyBeforeUpdate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniləmədən əvvəl verilənlər bazasının nüsxəsini saxlamaq mümkün olmadı. Verilənlər bazası dəyişdirilmədi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося захаваць копію базы даных перад абнаўленнем. База даных не зменена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Update konnte keine Kopie der Datenbank gesichert werden. Die Datenbank wurde nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of the database could not be saved before the update. The database was not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar una copia de la base de datos antes de la actualización. La base de datos no se modificó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie de la base n'a pas pu être enregistrée avant la mise à jour. La base n'a pas été modifiée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց թարմացումից առաջ պահել տվյալների շտեմարանի պատճենը։ Տվյալների շտեմարանը չի փոխվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare una copia del database prima dell’aggiornamento. Il database non è stato modificato."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განახლებამდე მონაცემთა ბაზის ასლის შენახვა ვერ მოხერხდა. მონაცემთა ბაზა არ შეცვლილა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңартар алдында дерекқордың көшірмесін сақтау мүмкін болмады. Дерекқор өзгерген жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңыртуудан мурун маалымат базасынын көчүрмөсүн сактоо мүмкүн болгон жок. Маалымат базасы өзгөртүлгөн жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zachować kopii bazy danych przed uaktualnieniem. Baza danych nie została zmieniona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar uma cópia do banco de dados antes da atualização. O banco de dados não foi alterado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar uma cópia da base de dados antes da atualização. A base de dados não foi alterada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед обновлением базы не удалось сохранить её копию. База не изменена."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Захира кардани нусхаи пойгоҳи додаҳо пеш аз навсозӣ муяссар нашуд. Пойгоҳи додаҳо тағйир наёфт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeden önce veritabanının bir kopyası kaydedilemedi. Veritabanı değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти копію бази даних перед оновленням. База даних не змінилася."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangilashdan oldin ma’lumotlar bazasi nusxasini saqlab bo‘lmadi. Baza o‘zgartirilmadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在更新前儲存資料庫拷貝。資料庫未遭更動。"
          }
        }
      }
    },
    "error.database.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilənlər bazası faylı zədələnib və ya verilənlər bazası deyil. Yenidən cəhd edin və ya nüsxəni bərpa edin; əvvəlcə faylın indiki vəziyyəti saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл базы даных пашкоджаны або не з'яўляецца базай даных. Паўтарыце спробу або аднавіце копію; бягучы файл будзе папярэдне захаваны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbankdatei ist beschädigt oder keine Datenbank. Versuchen Sie es erneut oder stellen Sie eine Kopie wieder her; die Datei in ihrem jetzigen Zustand wird vorher aufbewahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database file is damaged, or it is not a database. Try again, or restore a copy; the file as it is now is kept first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de la base de datos está dañado o no es una base de datos. Inténtelo de nuevo o restaure una copia; primero se guarda el archivo tal como está ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de la base est endommagé, ou ce n'est pas une base. Réessayez, ou restaurez une copie ; le fichier tel qu'il est maintenant est d'abord conservé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների շտեմարանի ֆայլը վնասված է կամ տվյալների շտեմարան չէ։ Կրկին փորձեք կամ վերականգնեք պատճենը․ նախ կպահվի ֆայլի ներկայիս տարբերակը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è danneggiato o non è un database. Riprova o ripristina una copia; il file attuale verrà prima conservato."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ბაზის ფაილი დაზიანებულია ან მონაცემთა ბაზას არ წარმოადგენს. სცადეთ ხელახლა ან აღადგინეთ ასლი; ფაილის ამჟამინდელი ვერსია ჯერ შენარჩუნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор файлы бүлінген, не ол дерекқор емес. Қайталап көріңіз немесе көшірмесін қалпына келтіріңіз; қазіргі файл алдын ала сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат базасынын файлы бузулган же ал маалымат базасы эмес. Кайра аракет кылыңыз же көчүрмөдөн калыбына келтириңиз; адегенде файл учурдагы абалында сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik bazy danych jest uszkodzony lub nie jest bazą danych. Spróbuj ponownie albo odtwórz kopię. Obecna wersja pliku zostanie wcześniej zachowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo do banco de dados está danificado ou não é um banco de dados. Tente novamente ou restaure uma cópia; o arquivo atual será preservado primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro da base de dados está danificado ou não é uma base de dados. Tente novamente ou restaure uma cópia; o ficheiro atual é preservado primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл базы повреждён или это не база данных. Попробуйте ещё раз или восстановите копию; нынешний файл перед этим сохранится."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли пойгоҳи додаҳо осеб дидааст ё пойгоҳи додаҳо нест. Боз кӯшиш кунед ё нусхаеро барқарор кунед; аввал файли ҷорӣ нигоҳ дошта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanı dosyası hasarlı veya bir veritabanı değil. Yeniden deneyin ya da bir kopyayı geri yükleyin; dosyanın geçerli hâli önce saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл бази даних пошкоджено або це не база даних. Спробуйте ще раз або відновіть копію; перед цим поточний файл буде збережено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasi fayli shikastlangan yoki u ma’lumotlar bazasi emas. Qayta urinib ko‘ring yoki nusxani tiklang; avval faylning hozirgi holati saqlab qo‘yiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫檔案已損壞，或該檔案並非資料庫。請重試或還原拷貝；目前的檔案會先予以保留。"
          }
        }
      }
    },
    "error.database.dataSetMissing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu məlumat dəsti hələ yaradılmayıb: Debug versiyası onu --generate ilə başladıqda yaradır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты набор даных яшчэ не створаны: зборка Debug стварае яго пры запуску з --generate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Datensatz wurde noch nicht erstellt: Ein Debug-Build erstellt ihn beim Start mit --generate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data set has not been made yet: a Debug build makes it at launch with --generate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conjunto de datos todavía no se ha creado: una compilación de depuración lo crea al iniciarse con --generate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu de données n'a pas encore été créé : une version Debug le crée au lancement avec --generate."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների այս հավաքածուն դեռ չի ստեղծվել․ Debug հավաքածուն այն ստեղծում է գործարկման ժամանակ՝ --generate պարամետրով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo set di dati non è ancora stato creato: una build Debug lo crea all’avvio con --generate."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ეს ნაკრები ჯერ არ შექმნილა: Debug ვერსია მას გაშვებისას --generate პარამეტრით ქმნის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл деректер жиыны әлі жасалмаған: Debug құрастыру оны іске қосқанда --generate арқылы жасайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул маалыматтар топтому түзүлө элек: Debug версиясы аны --generate менен иштетилгенде түзөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten zestaw danych nie został jeszcze utworzony: wersja Debug tworzy go podczas uruchamiania z opcją --generate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conjunto de dados ainda não foi criado: uma versão de depuração o cria ao iniciar com --generate."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conjunto de dados ainda não foi criado: uma compilação de depuração cria-o ao iniciar com --generate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого набора данных ещё нет: его создаёт Debug-сборка при запуске с --generate."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин маҷмӯи додаҳо ҳанӯз сохта нашудааст: версияи Debug онро ҳангоми оғоз бо --generate месозад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu veri kümesi henüz oluşturulmadı: Debug derlemesi, --generate ile başlatıldığında bunu oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей набір даних ще не створено: збірка Debug створює його під час запуску з --generate."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ma’lumotlar to‘plami hali yaratilmagan: Debug versiyasi uni --generate bilan ishga tushirilganda yaratadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料集尚未建立：Debug 版本會在使用 --generate 啟動時建立。"
          }
        }
      }
    },
    "error.database.newerSchema": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilənlər bazası OhMyMoney-nin daha yeni versiyası ilə yazılıb. Tətbiqi yeniləyin və ya bu versiyada yaradılmış nüsxəni bərpa edin; əvvəlcə verilənlər bazasının indiki vəziyyəti saxlanılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "База даных запісана ў навейшай версіі OhMyMoney. Абнавіце праграму або аднавіце копію, створаную гэтай версіяй; бягучая база даных будзе папярэдне захавана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank wurde von einer neueren Version von OhMyMoney geschrieben. Aktualisieren Sie die App — oder stellen Sie eine Kopie wieder her, die mit dieser Version erstellt wurde; die Datenbank in ihrem jetzigen Zustand wird vorher aufbewahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database was written by a newer version of OhMyMoney. Update the app — or restore a copy made by this version; the database as it is now is kept first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos la escribió una versión más reciente de OhMyMoney. Actualice la app o restaure una copia hecha por esta versión; primero se guarda la base de datos tal como está ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base a été écrite par une version plus récente d'OhMyMoney. Mettez l'application à jour — ou restaurez une copie faite par cette version ; la base telle qu'elle est maintenant est d'abord conservée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների շտեմարանը գրվել է OhMyMoney-ի ավելի նոր տարբերակով։ Թարմացրեք հավելվածը կամ վերականգնեք այս տարբերակով ստեղծված պատճենը․ նախ կպահվի տվյալների շտեմարանի ներկայիս տարբերակը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database è stato scritto da una versione più recente di OhMyMoney. Aggiorna l’app o ripristina una copia creata con questa versione; il database attuale verrà prima conservato."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ბაზა OhMyMoney-ის უფრო ახალი ვერსიითაა შექმნილი. განაახლეთ აპი ან აღადგინეთ ამ ვერსიით შექმნილი ასლი; მონაცემთა ბაზის ამჟამინდელი ვერსია ჯერ შენარჩუნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқорды OhMyMoney-дің жаңа нұсқасы жазған. Қолданбаны жаңартыңыз — не осы нұсқа жасаған көшірмені қалпына келтіріңіз; қазіргі дерекқор алдын ала сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат базасы OhMyMoney’нин жаңыраак версиясында жазылган. Колдонмону жаңыртыңыз же ушул версияда түзүлгөн көчүрмөдөн калыбына келтириңиз; адегенде маалымат базасы учурдагы абалында сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza danych została zapisana przez nowszą wersję OhMyMoney. Uaktualnij aplikację albo odtwórz kopię utworzoną przez tę wersję. Obecna baza danych zostanie wcześniej zachowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados foi gravado por uma versão mais recente do OhMyMoney. Atualize o aplicativo ou restaure uma cópia criada por esta versão; o banco de dados atual será preservado primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A base de dados foi criada por uma versão mais recente de OhMyMoney. Atualize a aplicação ou restaure uma cópia criada por esta versão; a base de dados atual é preservada primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу записала более новая версия OhMyMoney. Обновите приложение — или восстановите копию, сделанную этой версией; нынешняя база перед этим сохранится."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойгоҳи додаҳо бо версияи навтари OhMyMoney навишта шудааст. Барномаро нав кунед ё нусхаи бо ин версия сохташударо барқарор кунед; аввал пойгоҳи додаҳои ҷорӣ нигоҳ дошта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanı, OhMyMoney’in daha yeni bir sürümüyle yazılmış. Uygulamayı güncelleyin veya bu sürümle oluşturulmuş bir kopyayı geri yükleyin; veritabanının geçerli hâli önce saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу даних записала новіша версія OhMyMoney. Оновіть застосунок або відновіть копію, створену цією версією; перед цим поточну базу буде збережено."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasi OhMyMoney’ning yangiroq versiyasida yozilgan. Ilovani yangilang yoki shu versiyada yaratilgan nusxani tiklang; avval bazaning hozirgi holati saqlab qo‘yiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫由較新版本的 OhMyMoney 寫入。請更新 App，或還原由此版本建立的拷貝；目前的資料庫會先予以保留。"
          }
        }
      }
    },
    "error.database.other": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenidən cəhd edin. Kömək etməsə, problem hesabatı toplayın: Kömək → Problem hesabatı topla…"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паўтарыце спробу. Калі гэта не дапаможа, збярыце справаздачу аб праблеме: Даведка → Сабраць справаздачу аб праблеме…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es erneut. Hilft das nicht, erstellen Sie einen Problembericht: Hilfe → Problembericht erstellen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If that does not help, collect a problem report: Help → Collect a Problem Report…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtelo de nuevo. Si no ayuda, reúna un informe del problema: Ayuda → Reunir informe del problema…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez. Si cela ne suffit pas, créez un rapport de problème : Aide → Créer un rapport de problème…"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կրկին փորձեք։ Եթե դա չօգնի, հավաքեք խնդրի հաշվետվություն՝ Օգնություն → Հավաքել խնդրի հաշվետվություն…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova. Se il problema persiste, raccogli un rapporto sul problema: Aiuto → Raccogli un rapporto sul problema…"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სცადეთ ხელახლა. თუ ეს არ დაგეხმარათ, შეაგროვეთ პრობლემის ანგარიში: დახმარება → პრობლემის ანგარიშის შეგროვება…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайталап көріңіз. Көмектеспесе, қате туралы есеп жинаңыз: Анықтама → Қате туралы есеп жинау…"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кайра аракет кылыңыз. Жардам бербесе, көйгөй тууралуу отчет чогултуңуз: Жардам → Көйгөй тууралуу отчет чогултуу…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie. Jeśli to nie pomoże, zbierz raport o problemie: Pomoc → Zbierz raport o problemie…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente. Se isso não ajudar, colete um relatório de problema: Ajuda → Coletar Relatório de Problema…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente. Se o problema persistir, recolha um relatório de problemas: Ajuda → Recolher relatório de problemas…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте ещё раз. Если не поможет, соберите отчёт: Справка → Собрать отчёт о проблеме…"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Боз кӯшиш кунед. Агар ёрӣ надиҳад, гузориши мушкилотро ҷамъ кунед: Кӯмак → Ҷамъ кардани гузориши мушкилот…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden deneyin. Sorun sürerse bir sorun raporu oluşturun: Yardım → Sorun Raporu Oluştur…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте ще раз. Якщо це не допоможе, зберіть звіт про проблему: Довідка → Зібрати звіт про проблему…"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qayta urinib ko‘ring. Yordam bermasa, muammo hisobotini to‘plang: Yordam → Muammo hisobotini to‘plash…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試。若問題持續發生，請收集問題報告：輔助說明 → 收集問題報告⋯"
          }
        }
      }
    },
