    "update.unavailable.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сродак абнаўлення не запусціўся. Паспрабуйце пазней: праграма працягвае працаваць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aktualisierer wurde nicht gestartet. Versuchen Sie es später erneut: Die App funktioniert wie bisher weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The updater did not start. Try again later: the app keeps working as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El actualizador no se inició. Inténtelo más tarde: la app sigue funcionando como hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme de mise à jour n'a pas démarré. Réessayez plus tard : l'application continue de fonctionner comme avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento non è stato avviato. Riprova più tardi: l’app continua a funzionare normalmente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңартушы іске қосылмады. Кейінірек қайталап көріңіз: қолданба бұрынғыдай жұмыс істейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić narzędzia do aktualizacji. Spróbuj ponownie później. Aplikacja nadal działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atualizador não iniciou. Tente novamente mais tarde. O app continua funcionando normalmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модуль обновлений не запустился. Попробуйте позже — приложение работает как прежде."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleyici başlatılamadı. Daha sonra yeniden deneyin. Uygulama çalışmaya devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Засіб оновлення не запустився. Спробуйте пізніше: застосунок продовжує працювати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangilash xizmati ishga tushmadi. Keyinroq qayta urinib ko‘ring: ilova ishlashda davom etmoqda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新程式無法啟動。請稍後再試，App 仍可繼續使用。"
          }
        }
      }
    },
