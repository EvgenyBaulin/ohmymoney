    "replacement.notApplied.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data you had before is open, and the copy you chose is still waiting. Retry relaunches the app and tries again; Give Up keeps the data you have and drops the waiting copy — the file it came from stays where it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Están abiertos los datos que tenía antes, y la copia que eligió sigue en espera. Reintentar reinicia la app y lo intenta de nuevo; Desistir conserva los datos que tiene y descarta la copia en espera: el archivo del que procedía se queda donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données que vous aviez auparavant sont ouvertes, et la copie choisie attend toujours. Réessayer relance l'application et tente à nouveau ; Abandonner garde les données actuelles et écarte la copie en attente — le fichier d'origine reste à sa place."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыты прежние данные, а выбранная копия ждёт. «Повторить» перезапустит приложение и попробует ещё раз; «Отказаться» оставит текущие данные и уберёт ждущую копию — файл, из которого она взята, останется на месте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрито попередні дані, а вибрана копія ще очікує. Повторна спроба перезапускає застосунок і пробує знову; відмова залишає поточні дані та скасовує заміну — початковий файл копії залишається на місці."
          }
        }
      }
    },
    "replacement.notApplied.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
