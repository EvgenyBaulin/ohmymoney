    "privacy.password.explain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблакіраваныя вокны можна адкрыць гэтым паролем, праз Touch ID або з паролем гэтага Mac. У Звязцы ключоў гэтага Mac захоўваецца толькі хэш пароля — не ў кнігах і не ў архіве."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesperrten Fenster öffnen sich mit diesem Passwort sowie mit Touch ID oder dem Passwort dieses Mac. Gespeichert wird nur sein Hash, im Schlüsselbund dieses Mac — nicht in den Büchern und nicht im Archiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The locked windows open with this password, and with Touch ID or the password of this Mac. Only a hash of it is kept, in the Keychain of this Mac — not in the books and not in the archive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre bloccate si aprono con questa password, con Touch ID o con la password di questo Mac. Solo un hash della password viene conservato nel portachiavi di questo Mac, non nei libri né nell’archivio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құлыпталған терезелер осы құписөзбен, сондай-ақ Touch ID немесе осы Mac құписөзімен ашылады. Оның тек хэші сақталады — осы Mac-тің Keychain-інде, кітаптарда және мұрағатта емес."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокированные окна откроются этим паролем, а также по Touch ID или паролю этого Mac. Хранится только его хеш — в связке ключей этого Mac, не в учёте и не в архиве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблоковані вікна відкриваються за допомогою цього пароля, Touch ID або пароля цього Mac. Зберігається лише хеш пароля у В'язці ключів цього Mac — не в обліку й не в архіві."
          }
        }
      }
    },
