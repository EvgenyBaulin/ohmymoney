      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei, die sich nicht öffnen ließ, bleibt erhalten: als Kopie in der Liste der Kopien und unverändert im Ordner „beschädigt“ neben der Datenbank."
          }
        },
        "en": {
