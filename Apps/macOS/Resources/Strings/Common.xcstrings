          }
        }
      }
    },
    "error.database.newerSchema": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database was written by a newer version of OhMyMoney. Update the app — or restore a copy made by this version; the database as it is now is kept first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos la escribió una versión más reciente de OhMyMoney. Actualice la app o restaure una copia hecha por esta versión; primero se guarda la base de datos tal como está ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base a été écrite par une version plus récente d'OhMyMoney. Mettez l'application à jour — ou restaurez une copie faite par cette version ; la base telle qu'elle est maintenant est d'abord conservée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу записала более новая версия OhMyMoney. Обновите приложение — или восстановите копию, сделанную этой версией; нынешняя база перед этим сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу даних записала новіша версія OhMyMoney. Оновіть застосунок або відновіть копію, створену цією версією; перед цим поточну базу буде збережено."
          }
        }
      }
    },
    "error.database.other": {
      "comment": "Translation not verified by a native speaker.",
