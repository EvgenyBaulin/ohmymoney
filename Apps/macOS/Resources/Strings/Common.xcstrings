      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application is incomplete: the description of the database is missing from it. Install OhMyMoney again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación está incompleta: le falta la descripción de la base de datos. Vuelva a instalar OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение неполное: в нём нет описания базы данных. Установите OhMyMoney заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок неповний: у ньому немає опису бази даних. Установіть OhMyMoney знову."
          }
        }
      }
    },
    "error.database.copyBeforeUpdate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of the database could not be saved before the update. The database was not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar una copia de la base de datos antes de la actualización. La base de datos no se modificó."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед обновлением базы не удалось сохранить её копию. База не изменена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти копію бази даних перед оновленням. База даних не змінилася."
          }
        }
      }
    },
    "error.database.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database file is damaged, or it is not a database. Try again, or restore a copy; the file as it is now is kept first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de la base de datos está dañado o no es una base de datos. Inténtelo de nuevo o restaure una copia; primero se guarda el archivo tal como está ahora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл базы повреждён или это не база данных. Попробуйте ещё раз или восстановите копию; нынешний файл перед этим сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл бази даних пошкоджено або це не база даних. Спробуйте ще раз або відновіть копію; перед цим поточний файл буде збережено."
          }
        }
      }
    },
    "error.database.dataSetMissing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data set has not been made yet: a Debug build makes it at launch with --generate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conjunto de datos todavía no se ha creado: una compilación de depuración lo crea al iniciarse con --generate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого набора данных ещё нет: его создаёт Debug-сборка при запуске с --generate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей набір даних ще не створено: збірка Debug створює його під час запуску з --generate."
          }
        }
      }
    },
    "error.database.newerSchema": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database was written by a newer version of OhMyMoney. Update the app — or restore a copy made by this version; the database as it is now is kept first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos la escribió una versión más reciente de OhMyMoney. Actualice la app o restaure una copia hecha por esta versión; primero se guarda la base de datos tal como está ahora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу записала более новая версия OhMyMoney. Обновите приложение — или восстановите копию, сделанную этой версией; нынешняя база перед этим сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу даних записала новіша версія OhMyMoney. Оновіть застосунок або відновіть копію, створену цією версією; перед цим поточну базу буде збережено."
          }
        }
      }
    },
    "error.database.other": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If that does not help, collect a problem report: Help → Collect a Problem Report…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtelo de nuevo. Si no ayuda, reúna un informe del problema: Ayuda → Reunir informe del problema…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте ещё раз. Если не поможет, соберите отчёт: Справка → Собрать отчёт о проблеме…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте ще раз. Якщо це не допоможе, зберіть звіт про проблему: Довідка → Зібрати звіт про проблему…"
          }
        }
      }
    },
    "error.database.restore": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore from a Copy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar desde una copia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить из копии"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити з копії"
          }
        }
      }
    },
    "error.database.restoreKeeps": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file that did not open is kept: as a copy in the list of copies, and whole in the «damaged» folder next to the database."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo que no se abrió se conserva: como copia en la lista de copias, y completo en la carpeta «dañados» junto a la base de datos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, который не открылся, сохранится: копией в списке копий и целиком — в папке «damaged» рядом с базой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, який не відкрився, збережено: як копію в списку копій і повністю в папці «damaged» поруч із базою даних."
          }
        }
      }
    },
    "error.database.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database file could not be opened or written. Check the free space on the disk and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir ni escribir el archivo de la base de datos. Compruebe el espacio libre del disco e inténtelo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл базы не удалось открыть или записать. Проверьте свободное место на диске и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити або записати файл бази даних. Перевірте вільне місце на диску та спробуйте ще раз."
          }
        }
      }
    },
