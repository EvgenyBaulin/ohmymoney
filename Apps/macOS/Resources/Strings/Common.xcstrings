        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application is incomplete: the description of the database is missing from it. Install OhMyMoney again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение неполное: в нём нет описания базы данных. Установите OhMyMoney заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок неповний: у ньому немає опису бази даних. Установіть OhMyMoney знову."
          }
        }
      }
    },
    "error.database.copyBeforeUpdate": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Update konnte keine Kopie der Datenbank gesichert werden. Die Datenbank wurde nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of the database could not be saved before the update. The database was not changed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед обновлением базы не удалось сохранить её копию. База не изменена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти копію бази даних перед оновленням. База даних не змінилася."
          }
        }
      }
    },
    "error.database.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbankdatei ist beschädigt oder keine Datenbank. Versuchen Sie es erneut oder stellen Sie eine Kopie wieder her; die Datei in ihrem jetzigen Zustand wird vorher aufbewahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database file is damaged, or it is not a database. Try again, or restore a copy; the file as it is now is kept first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл базы повреждён или это не база данных. Попробуйте ещё раз или восстановите копию; нынешний файл перед этим сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл бази даних пошкоджено або це не база даних. Спробуйте ще раз або відновіть копію; перед цим поточний файл буде збережено."
          }
        }
      }
    },
    "error.database.dataSetMissing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Datensatz wurde noch nicht erstellt: Ein Debug-Build erstellt ihn beim Start mit --generate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data set has not been made yet: a Debug build makes it at launch with --generate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого набора данных ещё нет: его создаёт Debug-сборка при запуске с --generate."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей набір даних ще не створено: збірка Debug створює його під час запуску з --generate."
          }
        }
      }
    },
    "error.database.newerSchema": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank wurde von einer neueren Version von OhMyMoney geschrieben. Aktualisieren Sie die App — oder stellen Sie eine Kopie wieder her, die mit dieser Version erstellt wurde; die Datenbank in ihrem jetzigen Zustand wird vorher aufbewahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database was written by a newer version of OhMyMoney. Update the app — or restore a copy made by this version; the database as it is now is kept first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу записала более новая версия OhMyMoney. Обновите приложение — или восстановите копию, сделанную этой версией; нынешняя база перед этим сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу даних записала новіша версія OhMyMoney. Оновіть застосунок або відновіть копію, створену цією версією; перед цим поточну базу буде збережено."
          }
        }
      }
    },
    "error.database.other": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es erneut. Hilft das nicht, erstellen Sie einen Problembericht: Hilfe → Problembericht erstellen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If that does not help, collect a problem report: Help → Collect a Problem Report…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте ещё раз. Если не поможет, соберите отчёт: Справка → Собрать отчёт о проблеме…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте ще раз. Якщо це не допоможе, зберіть звіт про проблему: Довідка → Зібрати звіт про проблему…"
          }
        }
      }
    },
