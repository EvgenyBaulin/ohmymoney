    "update.unavailable.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniləmə xidməti başlamadı. Daha sonra yenidən cəhd edin; tətbiq işləməyə davam edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сродак абнаўлення не запусціўся. Паспрабуйце пазней: праграма працягвае працаваць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aktualisierer wurde nicht gestartet. Versuchen Sie es später erneut: Die App funktioniert wie bisher weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The updater did not start. Try again later: the app keeps working as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El actualizador no se inició. Inténtelo más tarde: la app sigue funcionando como hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme de mise à jour n'a pas démarré. Réessayez plus tard : l'application continue de fonctionner comme avant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թարմացման ծրագիրը չգործարկվեց։ Փորձեք ավելի ուշ․ հավելվածը շարունակում է աշխատել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento non è stato avviato. Riprova più tardi: l’app continua a funzionare normalmente."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განახლების შემოწმება ვერ დაიწყო. სცადეთ მოგვიანებით; აპი მუშაობას ჩვეულებრივ აგრძელებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңартушы іске қосылмады. Кейінірек қайталап көріңіз: қолданба бұрынғыдай жұмыс істейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңыртуу кызматы ишке кирген жок. Кийинчерээк кайталап көрүңүз: колдонмо иштей берет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić narzędzia do aktualizacji. Spróbuj ponownie później. Aplikacja nadal działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atualizador não iniciou. Tente novamente mais tarde. O app continua funcionando normalmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a atualização. Tente novamente mais tarde; a aplicação continua a funcionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модуль обновлений не запустился. Попробуйте позже — приложение работает как прежде."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Навсозӣ оғоз нашуд. Баъдтар дубора кӯшиш кунед. Барнома корашро идома медиҳад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleyici başlatılamadı. Daha sonra yeniden deneyin. Uygulama çalışmaya devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Засіб оновлення не запустився. Спробуйте пізніше: застосунок продовжує працювати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangilash xizmati ishga tushmadi. Keyinroq qayta urinib ko‘ring: ilova ishlashda davom etmoqda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新程式無法啟動。請稍後再試，App 仍可繼續使用。"
          }
        }
      }
    },
    "update.unavailable.title": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniləmələri indi yoxlamaq mümkün deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не ўдаецца праверыць абнаўленні"
