        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңыртууларды азыр текшерүү мүмкүн эмес"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz sprawdzić uaktualnień"
