    "privacy.password.keychain": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac-ın Açar Zənciri cavab vermədi — yenidən cəhd edin və ya Touch ID istifadə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Звязка ключоў гэтага Mac не адказала — паспрабуйце яшчэ раз або выкарыстайце Touch ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüsselbund dieses Mac hat nicht geantwortet — versuchen Sie es erneut oder nutzen Sie Touch ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Keychain of this Mac did not answer — try again, or use Touch ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Llavero de este Mac no respondió: inténtelo de nuevo o use Touch ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Trousseau de ce Mac n'a pas répondu — réessayez, ou utilisez Touch ID."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս Mac-ի Keychain-ը չպատասխանեց։ Փորձեք կրկին կամ օգտագործեք Touch ID-ն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portachiavi di questo Mac non ha risposto. Riprova o usa Touch ID."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ Mac-ის Keychain-მა არ უპასუხა — სცადეთ ხელახლა ან გამოიყენეთ Touch ID."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы Mac-тің Keychain-і жауап бермеді — қайталап көріңіз, не Touch ID пайдаланыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул Mac компьютериндеги Keychain жооп берген жок — кайталап көрүңүз же Touch ID колдонуңуз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pęk kluczy tego Maca nie odpowiada. Spróbuj ponownie lub użyj Touch ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Chaves deste Mac não responderam. Tente novamente ou use o Touch ID."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Porta-chaves deste Mac não respondeu. Tente novamente ou use o Touch ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связка ключей этого Mac не ответила — попробуйте ещё раз или используйте Touch ID."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain-и ин Mac ҷавоб надод. Бори дигар кӯшиш кунед ё Touch ID-ро истифода баред."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’in Anahtar Zinciri yanıt vermedi. Yeniden deneyin veya Touch ID’yi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В'язка ключів цього Mac не відповіла — спробуйте ще раз або скористайтеся Touch ID."
          }
        },
        "uz": {
          "stringUnit": {
