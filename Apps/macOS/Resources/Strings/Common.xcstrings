    "replacement.notApplied.message": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlki məlumatlarınız açıqdır və seçdiyiniz nüsxə hələ də gözləyir. Yenidən cəhd tətbiqi yenidən başladır və nüsxəni tətbiq etməyə çalışır; imtina isə mövcud məlumatlarınızı saxlayır və gözləyən nüsxəni ləğv edir — onun mənbə faylı yerində qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрыты вашы ранейшыя даныя, а выбраная копія ўсё яшчэ чакае прымянення. Паўторная спроба перазапусціць праграму; адмова пакіне вашы даныя і адхіліць копію, якая чакае. Файл, з якога яна ўзята, застанецца на месцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten, die Sie vorher hatten, sind geöffnet, und die gewählte Kopie wartet noch. „Erneut versuchen“ startet die App neu und probiert es noch einmal; „Aufgeben“ behält die Daten, die Sie haben, und verwirft die wartende Kopie — die Datei, aus der sie stammt, bleibt, wo sie ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data you had before is open, and the copy you chose is still waiting. Retry relaunches the app and tries again; Give Up keeps the data you have and drops the waiting copy — the file it came from stays where it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Están abiertos los datos que tenía antes, y la copia que eligió sigue en espera. Reintentar reinicia la app y lo intenta de nuevo; Desistir conserva los datos que tiene y descarta la copia en espera: el archivo del que procedía se queda donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données que vous aviez auparavant sont ouvertes, et la copie choisie attend toujours. Réessayer relance l'application et tente à nouveau ; Abandonner garde les données actuelles et écarte la copie en attente — le fichier d'origine reste à sa place."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացված են ձեր նախկին տվյալները, իսկ ընտրված պատճենը դեռ սպասում է։ Կրկին փորձելու դեպքում հավելվածը կվերագործարկվի և նորից կփորձի կիրառել պատճենը։ Հրաժարվելու դեպքում ձեր տվյալները կպահպանվեն, իսկ սպասող պատճենը կչեղարկվի։ Դրա սկզբնական ֆայլը կմնա իր տեղում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati precedenti sono aperti e la copia scelta è ancora in attesa. Riprova riavvia l’app e tenta di nuovo; Rinuncia mantiene i dati attuali e scarta la copia in attesa. Il file originale rimane dov’è."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გახსნილია თქვენი წინა მონაცემები, ხოლო არჩეული ასლი კვლავ მოლოდინშია. ხელახლა ცდა აპს ხელახლა გაუშვებს და ისევ სცდის; უარის თქმა მიმდინარე მონაცემებს შეინარჩუნებს და მომლოდინე ასლს გააუქმებს — საწყისი ფაილი თავის ადგილას დარჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұрынғы деректеріңіз ашық, таңдаған көшірмеңіз әлі күтуде. «Қайталау» қолданбаны қайта іске қосып, қайтадан көреді; «Бас тарту» бар деректерді сақтап, күтудегі көшірмені тастайды — ол шыққан файл өз орнында қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Мурунку дайындарыңыз ачык, ал эми сиз тандаган көчүрмө дагы эле күтүп турат. Кайталап көрүү колдонмону кайра иштетип, дагы бир жолу аракет кылат; баш тартуу учурдагы дайындарды сактап, күтүп турган көчүрмөнү жокко чыгарат — баштапкы файл ордунда калат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarte są dotychczasowe dane, a wybrana kopia nadal czeka na zastosowanie. Ponowienie spowoduje ponowne uruchomienie aplikacji i kolejną próbę. Rezygnacja zachowa dotychczasowe dane i odrzuci oczekującą kopię. Plik źródłowy pozostanie na swoim miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados anteriores estão abertos e a cópia escolhida ainda está aguardando. Tentar Novamente reinicia o app e tenta outra vez. Desistir mantém os dados atuais e descarta a cópia pendente. O arquivo de origem permanece no lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados anteriores estão abertos e a cópia escolhida continua pendente. Tentar novamente reinicia a aplicação e volta a tentar; Desistir mantém os dados atuais e descarta a cópia pendente — o ficheiro de origem permanece no mesmo local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыты прежние данные, а выбранная копия ждёт. «Повторить» перезапустит приложение и попробует ещё раз; «Отказаться» оставит текущие данные и уберёт ждущую копию — файл, из которого она взята, останется на месте."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маълумоти пешинаи шумо кушода аст ва нусхаи интихобшуда ҳанӯз дар интизорӣ аст. «Дубора кӯшиш кардан» барномаро бозоғоз мекунад ва аз нав кӯшиш мекунад; «Даст кашидан» маълумоти ҷориро нигоҳ медорад ва нусхаи интизоршударо бекор мекунад. Файли аслӣ дар ҷояш мемонад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki verileriniz açık ve seçtiğiniz kopya hâlâ bekliyor. Yeniden Dene, uygulamayı yeniden başlatıp tekrar dener; Vazgeç, mevcut verilerinizi korur ve bekleyen kopyayı kaldırır. Kaynak dosya yerinde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрито попередні дані, а вибрана копія ще очікує. Повторна спроба перезапускає застосунок і пробує знову; відмова залишає поточні дані та скасовує заміну — початковий файл копії залишається на місці."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvalgi ma’lumotlaringiz ochiq, tanlangan nusxa esa hali kutilmoqda. Qayta urinish ilovani qayta ishga tushirib, yana urinadi; bekor qilish esa joriy ma’lumotlarni saqlab, kutilayotgan nusxani bekor qiladi — manba fayl o‘z joyida qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前開啟的是原有資料，所選的副本仍在等待套用。「重試」會重新啟動 App 並再次嘗試；「放棄」會保留目前資料並捨棄等待中的副本，原始檔案會保留在原處。"
          }
        }
      }
    },
