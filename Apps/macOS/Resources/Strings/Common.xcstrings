    "relaunch.failed.helper": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney не ўдалося падрыхтаваць перазапуск: %@. Нічога не закрыта, праграма працягвае працаваць. Каб перазапусціць яе, выйдзіце з праграмы і адкрыйце яе зноў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney konnte seinen Neustart nicht vorbereiten: %@. Nichts wurde geschlossen, und die App funktioniert weiter. Zum Neustart beenden Sie sie und öffnen Sie sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney could not prepare its restart: %@. Nothing was closed, and the app keeps working. To restart it, quit it and open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney no pudo preparar su reinicio: %@. No se cerró nada y la app sigue funcionando. Para reiniciarla, ciérrela y ábrala de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney n'a pas pu préparer son redémarrage : %@. Rien n'a été fermé, et l'application continue de fonctionner. Pour la redémarrer, quittez-la puis ouvrez-la à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney non è riuscito a preparare il riavvio: %@. Non è stato chiuso nulla e l’app continua a funzionare. Per riavviarla, esci dall’app e riaprila."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney қайта іске қосуға дайындала алмады: %@. Ештеңе жабылмады, қолданба жұмыс істеп тұр. Қайта іске қосу үшін оны жауып, қайта ашыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney nie mogło przygotować ponownego uruchomienia: %@. Nic nie zostało zamknięte, a aplikacja nadal działa. Aby uruchomić ją ponownie, zamknij ją i otwórz jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney não conseguiu preparar a reinicialização: %@. Nada foi fechado e o app continua funcionando. Para reiniciá-lo, encerre-o e abra-o novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney не смогло подготовить перезапуск: %@. Ничего не закрыто, приложение продолжает работать. Чтобы перезапустить его, закройте и откройте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney yeniden başlatılmaya hazırlanamadı: %@. Hiçbir şey kapatılmadı ve uygulama çalışmaya devam ediyor. Yeniden başlatmak için uygulamadan çıkıp uygulamayı tekrar açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney не вдалося підготувати перезапуск: %@. Нічого не закрито, застосунок продовжує працювати. Щоб перезапустити його, закрийте й відкрийте знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney qayta ishga tushishga tayyorlana olmadi: %@. Hech narsa yopilmadi va ilova ishlashda davom etmoqda. Uni qayta ishga tushirish uchun ilovadan chiqib, yana oching."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 無法準備重新啟動：%@。所有內容均未關閉，App 仍可繼續使用。如要重新啟動，請結束 App 並再次開啟。"
          }
        }
      }
    },
