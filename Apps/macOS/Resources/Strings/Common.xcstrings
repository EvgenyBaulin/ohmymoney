    "error.database.restoreKeeps": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file that did not open is kept: as a copy in the list of copies, and whole in the «damaged» folder next to the database."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo que no se abrió se conserva: como copia en la lista de copias, y completo en la carpeta «dañados» junto a la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier qui ne s'est pas ouvert est conservé : sous forme de copie dans la liste des copies, et entier dans le dossier « endommagé » à côté de la base."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, который не открылся, сохранится: копией в списке копий и целиком — в папке «damaged» рядом с базой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, який не відкрився, збережено: як копію в списку копій і повністю в папці «damaged» поруч із базою даних."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашылмаған файл сақталады: көшірмелер тізімінде көшірме ретінде және дерекқордың қасындағы «бүлінген» қалтада толық күйінде."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file che non si è aperto viene conservato: come copia nell’elenco delle copie e per intero nella cartella «damaged» accanto al database."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, які не ўдалося адкрыць, захоўваецца як копія ў спісе копій і цалкам у папцы «damaged» побач з базай даных."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei, die sich nicht öffnen ließ, bleibt erhalten: als Kopie in der Liste der Kopien und unverändert im Ordner „beschädigt“ neben der Datenbank."
          }
        }
      }
    },
    "error.database.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database file could not be opened or written. Check the free space on the disk and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir ni escribir el archivo de la base de datos. Compruebe el espacio libre del disco e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de la base n'a pas pu être ouvert ni écrit. Vérifiez l'espace libre sur le disque et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл базы не удалось открыть или записать. Проверьте свободное место на диске и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити або записати файл бази даних. Перевірте вільне місце на диску та спробуйте ще раз."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор файлын ашу не жазу мүмкін болмады. Дискідегі бос орынды тексеріп, қайталап көріңіз."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire o scrivere il file del database. Controlla lo spazio libero sul disco e riprova."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося адкрыць файл базы даных або запісаць у яго. Праверце вольнае месца на дыску і паўтарыце спробу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbankdatei konnte nicht geöffnet oder geschrieben werden. Prüfen Sie den freien Speicherplatz auf dem Datenträger und versuchen Sie es erneut."
          }
        }
      }
    },
