          "stringUnit": {
            "state": "translated",
            "value": "Отказаться"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відмовитися"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
