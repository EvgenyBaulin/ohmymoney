    "error.database.restoreKeeps": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılmayan fayl saxlanılır: nüsxələr siyahısında nüsxə kimi və verilənlər bazasının yanındakı «damaged» qovluğunda bütöv şəkildə."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, які не ўдалося адкрыць, захоўваецца як копія ў спісе копій і цалкам у папцы «damaged» побач з базай даных."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei, die sich nicht öffnen ließ, bleibt erhalten: als Kopie in der Liste der Kopien und unverändert im Ordner „beschädigt“ neben der Datenbank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file that did not open is kept: as a copy in the list of copies, and whole in the «damaged» folder next to the database."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo que no se abrió se conserva: como copia en la lista de copias, y completo en la carpeta «dañados» junto a la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier qui ne s'est pas ouvert est conservé : sous forme de copie dans la liste des copies, et entier dans le dossier « endommagé » à côté de la base."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չբացված ֆայլը պահվում է որպես պատճեն՝ պատճենների ցանկում, և ամբողջությամբ՝ տվյալների շտեմարանի կողքի «damaged» պանակում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file che non si è aperto viene conservato: come copia nell’elenco delle copie e per intero nella cartella «damaged» accanto al database."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილი, რომელიც ვერ გაიხსნა, შენარჩუნებულია: ასლის სახით ასლების სიაში და სრულად «damaged» საქაღალდეში, მონაცემთა ბაზის გვერდით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашылмаған файл сақталады: көшірмелер тізімінде көшірме ретінде және дерекқордың қасындағы «бүлінген» қалтада толық күйінде."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ачылбаган файл көчүрмөлөр тизмесинде көчүрмө катары жана маалымат базасынын жанындагы «damaged» папкасында толук сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik, którego nie udało się otworzyć, zostanie zachowany jako kopia na liście kopii oraz w całości w folderze «damaged» obok bazy danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo que não foi aberto é preservado: como uma cópia na lista de cópias e integralmente na pasta «damaged» ao lado do banco de dados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro que não foi aberto é preservado: como cópia na lista de cópias e na íntegra na pasta «damaged» junto à base de dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, который не открылся, сохранится: копией в списке копий и целиком — в папке «damaged» рядом с базой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли кушоданашуда нигоҳ дошта мешавад: ҳамчун нусха дар рӯйхати нусхаҳо ва пурра дар ҷузвдони «damaged» дар паҳлуи пойгоҳи додаҳо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılamayan dosya, kopyalar listesinde bir kopya olarak ve veritabanının yanındaki «damaged» klasöründe eksiksiz olarak saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл, який не відкрився, збережено: як копію в списку копій і повністю в папці «damaged» поруч із базою даних."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochilmagan fayl saqlab qo‘yiladi: nusxalar ro‘yxatida nusxa sifatida va baza yonidagi «damaged» jildida to‘liq holda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開的檔案會保留為拷貝列表中的一份拷貝，完整檔案也會保留在資料庫旁的 «damaged» 檔案夾中。"
          }
        }
      }
    },
    "error.database.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilənlər bazası faylını açmaq və ya ona yazmaq mümkün olmadı. Diskdə boş yeri yoxlayın və yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося адкрыць файл базы даных або запісаць у яго. Праверце вольнае месца на дыску і паўтарыце спробу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbankdatei konnte nicht geöffnet oder geschrieben werden. Prüfen Sie den freien Speicherplatz auf dem Datenträger und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database file could not be opened or written. Check the free space on the disk and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir ni escribir el archivo de la base de datos. Compruebe el espacio libre del disco e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de la base n'a pas pu être ouvert ni écrit. Vérifiez l'espace libre sur le disque et réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց բացել տվյալների շտեմարանի ֆայլը կամ գրել դրա մեջ։ Ստուգեք սկավառակի ազատ տարածքը և կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire o scrivere il file del database. Controlla lo spazio libero sul disco e riprova."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ბაზის ფაილის გახსნა ან მასში ჩაწერა ვერ მოხერხდა. შეამოწმეთ დისკზე თავისუფალი ადგილი და სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор файлын ашу не жазу мүмкін болмады. Дискідегі бос орынды тексеріп, қайталап көріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат базасынын файлын ачуу же ага жазуу мүмкүн болгон жок. Дисктеги бош орунду текшерип, кайра аракет кылыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć pliku bazy danych ani zapisać w nim danych. Sprawdź ilość wolnego miejsca na dysku i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir ou gravar o arquivo do banco de dados. Verifique o espaço livre no disco e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir ou alterar o ficheiro da base de dados. Verifique o espaço livre no disco e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл базы не удалось открыть или записать. Проверьте свободное место на диске и попробуйте ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кушодан ё навиштани файли пойгоҳи додаҳо муяссар нашуд. Фазои холии дискро санҷед ва боз кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanı dosyası açılamadı veya dosyaya yazılamadı. Diskteki boş alanı denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити або записати файл бази даних. Перевірте вільне місце на диску та спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasi faylini ochib yoki unga yozib bo‘lmadi. Diskdagi bo‘sh joyni tekshiring va qayta urinib ko‘ring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開或寫入資料庫檔案。請檢查磁碟可用空間，然後重試。"
          }
        }
      }
    },
