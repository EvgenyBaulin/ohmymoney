    "travel.start.none": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Наперадзе няма паездак. Стварыце новую ніжэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Reise voraus. Legen Sie unten eine neue an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trip ahead. Make a new one below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún viaje próximo. Cree uno nuevo abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de voyage à venir. Créez-en un ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun viaggio in programma. Creane uno qui sotto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алда сапар жоқ. Төменде жаңасын жасаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдыда сапар жок. Төмөндөн жаңы сапар түзүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak nadchodzących podróży. Utwórz nową poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma viagem programada. Crie uma abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездок впереди нет. Заведите новую ниже."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сафаре дар пеш нест. Дар поён сафари нав созед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşan seyahat yok. Aşağıdan yeni bir seyahat oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попереду немає поїздок. Створіть нову нижче."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejalashtirilgan safar yo‘q. Quyida yangi safar yarating."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有即將到來的旅程。請在下方新增旅程。"
          }
        }
      }
    },
