    "travel.cards.noBest": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце камісію за канвертацыю, каб параўнаць карткі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie die Umrechnungsgebühr einer Karte ein, um die Karten zu vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the conversion fee of a card to compare the cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba la comisión de conversión de una tarjeta para comparar las tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les frais de conversion d'une carte pour comparer les cartes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la commissione di conversione di una carta per confrontare le carte."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Карталарды салыстыру үшін айырбастау комиссиясын енгізіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите комиссию конвертации карты, чтобы сравнить карты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть комісію конвертації картки, щоб порівняти картки."
          }
        }
      }
    },
