            "value": "此旅程沒有待償款項。"
          }
        }
      }
    },
    "travel.summary.settlement.note": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі даўгі перад вамі; даўгі паміж сябрамі не ўлічваюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur was Ihnen geschuldet wird; Schulden unter Freunden werden nicht geführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what is owed to you; debts between friends are not kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lo que se le debe a usted; las deudas entre amigos no se guardan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement ce qui vous est dû ; les dettes entre amis ne sont pas tenues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo gli importi dovuti a te; i debiti tra amici non vengono registrati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек сізге берешек есептеледі; достар арасындағы қарыздар жүргізілмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сизге болгон карыздар гана көрсөтүлөт; достордун өз ара карыздары эсептелбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko kwoty należne Tobie; długi między znajomymi nie są zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o que devem a você; dívidas entre amigos não são registradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только то, что должны вам; долги друзей друг другу не ведутся."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо қарзҳо ба шумо; қарзҳои байни дӯстон нигоҳ дошта намешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca size olan borçlar gösterilir; arkadaşlar arasındaki borçlar tutulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише те, що винні вам; борги між друзями не ведуться."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat sizga bo‘lgan qarzlar ko‘rsatiladi; do‘stlar orasidagi qarzlar yuritilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅記錄他人欠你的款項，不記錄朋友之間的欠款。"
          }
        }
      }
    },
