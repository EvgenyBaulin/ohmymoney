    "travel.start.none": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Наперадзе няма паездак. Стварыце новую ніжэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Reise voraus. Legen Sie unten eine neue an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trip ahead. Make a new one below."
          }
        },
        "es": {
          "stringUnit": {
