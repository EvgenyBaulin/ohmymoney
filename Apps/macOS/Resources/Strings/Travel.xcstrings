    "travel.cards.loss": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ — пры %3$@ гэта каштуе %4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ — bei %3$@ kostet sie %4$@"
          }
        },
        "en": {
          "stringUnit": {
