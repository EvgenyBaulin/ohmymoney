        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За гэтую паездку ніхто нічога не павінен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Reise schuldet niemand etwas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody owes anything for this trip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie debe nada por este viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne doit rien pour ce voyage."
          }
        },
        "it": {
          "stringUnit": {
