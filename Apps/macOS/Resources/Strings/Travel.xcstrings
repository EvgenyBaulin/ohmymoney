    "travel.cards.badFixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: type the fixed fee with its currency (three letters), or neither."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: escriba la comisión fija con su divisa (tres letras), o ninguna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: введите фиксированную комиссию вместе с валютой (три буквы) или ни то ни другое."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: введіть фіксовану комісію з її валютою (три літери) або нічого."
          }
        }
      }
    },
    "travel.cards.badPercent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: a percent is from 0 to 100, up to four places after the point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: un porcentaje va de 0 a 100, con hasta cuatro decimales."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: процент — от 0 до 100, не больше четырёх знаков после запятой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: відсоток — від 0 до 100, не більше чотирьох знаків після коми."
          }
        }
      }
    },
    "travel.cards.best": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best card abroad: %1$@ — %2$@ for converting; on %3$@ it costs %4$@"
