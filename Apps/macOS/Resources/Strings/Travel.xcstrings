        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этой поездке никто ничего не должен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цю поїздку ніхто нічого не винен."
          }
        }
      }
    },
    "travel.summary.settlement.note": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі даўгі перад вамі; даўгі паміж сябрамі не ўлічваюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur was Ihnen geschuldet wird; Schulden unter Freunden werden nicht geführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what is owed to you; debts between friends are not kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lo que se le debe a usted; las deudas entre amigos no se guardan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement ce qui vous est dû ; les dettes entre amis ne sont pas tenues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo gli importi dovuti a te; i debiti tra amici non vengono registrati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек сізге берешек есептеледі; достар арасындағы қарыздар жүргізілмейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только то, что должны вам; долги друзей друг другу не ведутся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише те, що винні вам; борги між друзями не ведуться."
          }
        }
      }
    },
