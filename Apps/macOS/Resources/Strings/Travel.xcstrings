        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшая карта за границей: %1$@ — %2$@ за конвертацию; на %3$@ это %4$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найкраща картка за кордоном: %1$@ — %2$@ за конвертацію; на %3$@ вона коштує %4$@"
