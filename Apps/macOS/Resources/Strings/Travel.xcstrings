    "travel.cards.badFixed": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: увядзіце фіксаваную камісію і яе валюту (тры літары) або пакіньце абодва палі пустымі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“: Tragen Sie die feste Gebühr mit ihrer Währung (drei Buchstaben) ein, oder keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: type the fixed fee with its currency (three letters), or neither."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: escriba la comisión fija con su divisa (tres letras), o ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » : saisissez les frais fixes avec leur devise (trois lettres), ou aucun des deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: inserisci la commissione fissa con la valuta (tre lettere), oppure lascia entrambi vuoti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: тұрақты комиссияны валютасымен (үш әріп) енгізіңіз немесе екеуін де бос қалдырыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: введите фиксированную комиссию вместе с валютой (три буквы) или ни то ни другое."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: введіть фіксовану комісію з її валютою (три літери) або нічого."
          }
        }
      }
    },
    "travel.cards.badPercent": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: працэнт павінен быць ад 0 да 100, не больш за чатыры знакі пасля коскі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“: Ein Prozentsatz liegt zwischen 0 und 100, mit höchstens vier Nachkommastellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: a percent is from 0 to 100, up to four places after the point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: un porcentaje va de 0 a 100, con hasta cuatro decimales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » : un pourcentage va de 0 à 100, avec quatre décimales au plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: inserisci una percentuale da 0 a 100, con al massimo quattro cifre decimali."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: пайыз 0-ден 100-ге дейін, нүктеден кейін төрт таңбаға дейін."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: процент — от 0 до 100, не больше четырёх знаков после запятой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: відсоток — від 0 до 100, не більше чотирьох знаків після коми."
          }
        }
      }
    },
    "travel.cards.best": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Найлепшая картка за мяжой: %1$@ — %2$@ за канвертацыю; пры %3$@ гэта каштуе %4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste Karte im Ausland: %1$@ — %2$@ für die Umrechnung; bei %3$@ kostet sie %4$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best card abroad: %1$@ — %2$@ for converting; on %3$@ it costs %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor tarjeta en el extranjero: %1$@ — %2$@ por la conversión; en %3$@ cuesta %4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleure carte à l'étranger : %1$@ — %2$@ pour la conversion ; sur %3$@ elle coûte %4$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Migliore carta all’estero: %1$@ — %2$@ per la conversione; su %3$@ costa %4$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шетелдегі ең тиімді карта: %1$@ — айырбастауға %2$@; %3$@ үшін құны %4$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшая карта за границей: %1$@ — %2$@ за конвертацию; на %3$@ это %4$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найкраща картка за кордоном: %1$@ — %2$@ за конвертацію; на %3$@ вона коштує %4$@"
          }
        }
      }
    },
