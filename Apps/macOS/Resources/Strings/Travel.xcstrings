    "travel.gain.note": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Змена кошту грошай у замежнай валюце ў рублях толькі праз змену курсу. Гэта не даход і не расход."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das Geld in Fremdwährungen in Rubel nur durch die Bewegung des Kurses gewonnen oder verloren hat. Keine Einnahme und keine Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the money in foreign currencies gained or lost in rubles only because the rate moved. Not income or expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ganó o perdió el dinero en divisas extranjeras solo en rublos porque se movió el tipo. No es ingreso ni gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l'argent en devises étrangères a gagné ou perdu en roubles seulement parce que le cours a bougé. Ce n'est ni un revenu ni une dépense."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il guadagno o la perdita in rubli del denaro in valuta estera dovuti alle sole variazioni del cambio. Non sono entrate né uscite."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шетел валютасындағы ақшаның тек бағам өзгерісінен рубльмен қосқан не жоғалтқан құны. Кіріс те, шығын да емес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana wartości pieniędzy w walutach obcych w rublach wynikająca wyłącznie ze zmiany kursu. Nie jest to przychód ani wydatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto o dinheiro em moedas estrangeiras ganhou ou perdeu em rublos apenas pela variação do câmbio. Não é receita nem despesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько рублей выиграли или потеряли деньги в валюте только из-за движения курса. Не доход и не расход."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yabancı para birimlerindeki paranın yalnızca kur değişimi nedeniyle ruble cinsinden kazancı veya kaybı. Gelir ya da gider değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що гроші в іноземних валютах виграли або програли в рублях лише тому, що курс змінився. Це не дохід і не витрата."
          }
        }
      }
    },
