    "travel.goal.help": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрэбная сума сабрана: стварыце паездку з гэтым бюджэтам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel hat seine Summe gesammelt: Machen Sie eine Reise mit diesem Budget."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The goal has gathered its target: make a trip with that budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo ya reunió su meta: haga un viaje con ese presupuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'objectif a atteint sa cible : faites un voyage avec ce budget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto l’obiettivo: crea un viaggio con questo budget."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат сомасы жиналды: осы бюджетпен сапар жасаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzbierano kwotę docelową. Utwórz podróż z tym budżetem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A meta foi atingida: crie uma viagem com esse orçamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель собрана: заведите поездку с этим бюджетом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef tutara ulaşıldı: Bu bütçeyle bir seyahat oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціль зібрала свою суму: зробіть поїздку з цим бюджетом."
          }
        }
      }
    },
