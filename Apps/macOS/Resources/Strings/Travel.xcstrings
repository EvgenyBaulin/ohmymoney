        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сапар үшін ешкім қарыз емес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt nie jest Ci nic winien za tę podróż."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém deve nada por esta viagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этой поездке никто ничего не должен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seyahat için kimsenin borcu yok."
          }
        },
        "uk": {
