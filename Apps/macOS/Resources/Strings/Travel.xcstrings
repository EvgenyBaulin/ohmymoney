    "travel.start.onHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Новыя аперацыі ствараюцца ў валюце паездкі і адносяцца да яе. Вярнуўшыся дадому, націсніце «Я вярнуўся»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Vorgänge beginnen in der Währung der Reise und werden darunter eingeordnet. Tippen Sie auf „Ich bin zurück“, wenn Sie zu Hause sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New operations start in the currency of the trip and are filed under it. Tap «I am back» when you are home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones nuevas empiezan en la divisa del viaje y se archivan bajo él. Pulse «Ya volví» cuando esté en casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles opérations se font dans la devise du voyage et y sont classées. Appuyez sur « Je suis rentré » quand vous êtes de retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove operazioni usano la valuta del viaggio e vengono associate a esso. Tocca «Sono tornato» quando sei a casa."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңа операциялар сапар валютасымен басталып, соған тіркеледі. Үйге оралғанда «Қайтып келдім» басыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые операции начинаются в валюте поездки и относятся к ней. Нажмите «Я вернулся», когда будете дома."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові операції йдуть у валюті поїздки і записуються за нею. Натисніть «Я вдома», коли повернетеся."
          }
        }
      }
    },
