    "travel.cards.badFixed": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: увядзіце фіксаваную камісію і яе валюту (тры літары) або пакіньце абодва палі пустымі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“: Tragen Sie die feste Gebühr mit ihrer Währung (drei Buchstaben) ein, oder keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: type the fixed fee with its currency (three letters), or neither."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: escriba la comisión fija con su divisa (tres letras), o ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » : saisissez les frais fixes avec leur devise (trois lettres), ou aucun des deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: inserisci la commissione fissa con la valuta (tre lettere), oppure lascia entrambi vuoti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: тұрақты комиссияны валютасымен (үш әріп) енгізіңіз немесе екеуін де бос қалдырыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: туруктуу комиссияны валютасы менен (үч тамга) киргизиңиз же экөөнү тең бош калтырыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: wpisz opłatę stałą i jej walutę (trzy litery) albo nie wpisuj żadnej z tych wartości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: digite a tarifa fixa e sua moeda (três letras), ou deixe ambos em branco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: введите фиксированную комиссию вместе с валютой (три буквы) или ни то ни другое."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: маблағи собит ва асъори онро (се ҳарф) ворид кунед ё ҳеҷ кадомро ворид накунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: Sabit ücreti para birimiyle (üç harf) birlikte girin veya ikisini de boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: введіть фіксовану комісію з її валютою (три літери) або нічого."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: qatʼiy komissiyani valyutasi bilan (uch harf) kiriting yoki ikkalasini ham bo‘sh qoldiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»：請輸入固定費用及其幣別（三個字母），或兩者皆留空。"
          }
        }
      }
    },
    "travel.cards.badPercent": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: працэнт павінен быць ад 0 да 100, не больш за чатыры знакі пасля коскі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“: Ein Prozentsatz liegt zwischen 0 und 100, mit höchstens vier Nachkommastellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: a percent is from 0 to 100, up to four places after the point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: un porcentaje va de 0 a 100, con hasta cuatro decimales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » : un pourcentage va de 0 à 100, avec quatre décimales au plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: inserisci una percentuale da 0 a 100, con al massimo quattro cifre decimali."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: пайыз 0-ден 100-ге дейін, нүктеден кейін төрт таңбаға дейін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: пайыз 0дөн 100гө чейин, үтүрдөн кийин төрт санга чейин болушу керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: wartość procentowa musi wynosić od 0 do 100 i mieć do czterech miejsc po przecinku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: a porcentagem deve ser de 0 a 100, com até quatro casas decimais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: процент — от 0 до 100, не больше четырёх знаков после запятой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: фоиз бояд аз 0 то 100 бошад, бо то чор рақам пас аз нуқта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: Yüzde 0 ile 100 arasında olmalı ve virgülden sonra en fazla dört basamak içermelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: відсоток — від 0 до 100, не більше чотирьох знаків після коми."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: foiz 0 dan 100 gacha, nuqtadan keyin to‘rt xonagacha bo‘lishi kerak."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»：百分比須介於 0 到 100 之間，最多四位小數。"
          }
        }
      }
    },
    "travel.cards.best": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Найлепшая картка за мяжой: %1$@ — %2$@ за канвертацыю; пры %3$@ гэта каштуе %4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste Karte im Ausland: %1$@ — %2$@ für die Umrechnung; bei %3$@ kostet sie %4$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best card abroad: %1$@ — %2$@ for converting; on %3$@ it costs %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor tarjeta en el extranjero: %1$@ — %2$@ por la conversión; en %3$@ cuesta %4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleure carte à l'étranger : %1$@ — %2$@ pour la conversion ; sur %3$@ elle coûte %4$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Migliore carta all’estero: %1$@ — %2$@ per la conversione; su %3$@ costa %4$@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шетелдегі ең тиімді карта: %1$@ — айырбастауға %2$@; %3$@ үшін құны %4$@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чет өлкөдө эң пайдалуу карта: %1$@ — алмаштыруу үчүн %2$@; %3$@ үчүн чыгым %4$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepsza karta za granicą: %1$@ — %2$@ za przewalutowanie; przy %3$@ koszt wynosi %4$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhor cartão no exterior: %1$@ — %2$@ de conversão; em %3$@ custa %4$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшая карта за границей: %1$@ — %2$@ за конвертацию; на %3$@ это %4$@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Беҳтарин корт дар сафар: %1$@ — %2$@ барои табдил; аз %3$@ хароҷот %4$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yurt dışında en iyi kart: %1$@ — dönüşüm için %2$@; %3$@ için maliyet %4$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найкраща картка за кордоном: %1$@ — %2$@ за конвертацію; на %3$@ вона коштує %4$@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chet el uchun eng yaxshi karta: %1$@ — konvertatsiya uchun %2$@; %3$@ uchun xarajat %4$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海外最佳卡片：%1$@，兌換費率 %2$@；%3$@ 需支付 %4$@"
          }
        }
      }
    },
