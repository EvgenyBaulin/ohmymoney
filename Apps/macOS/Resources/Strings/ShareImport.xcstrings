    "share.partial": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Некаторыя файлы захаваны. Адкрыйце OhMyMoney, каб праверыць іх, і абагульце астатнія файлы яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien wurden gespeichert. Öffnen Sie OhMyMoney, um sie zu prüfen, und teilen Sie die restlichen Dateien erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files were saved. Open OhMyMoney to review them, then share the remaining files again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardaron algunos archivos. Abra OhMyMoney para revisarlos, y después comparta de nuevo los archivos que faltan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers ont été enregistrés. Ouvrez OhMyMoney pour les vérifier, puis partagez de nouveau les fichiers restants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni file sono stati salvati. Apri OhMyMoney per verificarli, poi condividi di nuovo i file rimanenti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбір файлдар сақталды. Оларды тексеру үшін OhMyMoney ашыңыз, содан кейін қалған файлдарды қайта бөлісіңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre pliki zostały zachowane. Otwórz OhMyMoney, aby je sprawdzić, a następnie udostępnij pozostałe pliki ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos foram salvos. Abra o OhMyMoney para revisá-los e compartilhe os demais novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть файлов сохранена. Проверьте их в OhMyMoney, затем поделитесь оставшимися ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı dosyalar kaydedildi. Bunları incelemek için OhMyMoney’yi açın, ardından kalan dosyaları tekrar paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частину файлів збережено. Відкрийте OhMyMoney, щоб перевірити їх, а потім надішліть решту знову."
          }
        }
      }
    },
