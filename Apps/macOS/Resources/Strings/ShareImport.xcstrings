{
  "sourceLanguage": "en",
  "strings": {
    "share.close": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жабу"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити"
          }
        }
      }
    },
    "share.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geteilte Datei konnte nicht geöffnet werden. Teilen Sie sie erneut mit der neuesten Version von OhMyMoney."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared file could not be opened. Share it again with the latest version of OhMyMoney."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлісілген файлды ашу мүмкін болмады. OhMyMoney соңғы нұсқасынан қайта бөлісіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть переданный файл. Поделитесь им ещё раз с последней версией OhMyMoney."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити надісланий файл. Надішліть його знову з найновішої версії OhMyMoney."
          }
        }
      }
    },
    "share.draftSaved": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang wartet als Entwurf darauf, dass Sie ihn prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation is waiting in drafts for you to review."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция нобайларда тексеруіңізді күтуде."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция ждёт проверки в «Запишу потом»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція очікує перевірки в чернетках."
          }
        }
      }
    },
    "share.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geteilte Element konnte nicht gespeichert werden. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared item could not be saved. Please try again."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлісілген элементті сақтау мүмкін болмады. Қайталап көріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить. Попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти надісланий об'єкт. Спробуйте ще раз."
          }
        }
      }
    },
    "share.messageHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie diese Nachricht. OhMyMoney bietet den Vorgang als Entwurf an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check this message. OhMyMoney will offer the operation as a draft."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы хабарды тексеріңіз. OhMyMoney операцияны нобай ретінде ұсынады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте сообщение. OhMyMoney предложит операцию в «Запишу потом»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте це повідомлення. OhMyMoney запропонує операцію як чернетку."
          }
        }
      }
    },
    "share.messageTitle": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank-Nachricht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank message"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк хабары"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение банка"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення банку"
          }
        }
      }
    },
    "share.partial": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien wurden gespeichert. Öffnen Sie OhMyMoney, um sie zu prüfen, und teilen Sie die restlichen Dateien erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files were saved. Open OhMyMoney to review them, then share the remaining files again."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбір файлдар сақталды. Оларды тексеру үшін OhMyMoney ашыңыз, содан кейін қалған файлдарды қайта бөлісіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть файлов сохранена. Проверьте их в OhMyMoney, затем поделитесь оставшимися ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частину файлів збережено. Відкрийте OhMyMoney, щоб перевірити їх, а потім надішліть решту знову."
          }
        }
      }
    },
    "share.preparing": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteilte Dateien werden vorbereitet…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing shared files…"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлісілген файлдар дайындалуда…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка файлов…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготовка надісланих файлів…"
          }
        }
      }
    },
    "share.saveDraft": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Entwurf anbieten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer as draft"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нобай ретінде ұсыну"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Запишу потом»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запропонувати як чернетку"
          }
        }
      }
    },
    "share.saved": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Öffnen Sie OhMyMoney, um die geteilten Dateien zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Open OhMyMoney to review the shared files."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақталды. Бөлісілген файлдарды тексеру үшін OhMyMoney ашыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено. Откройте OhMyMoney, чтобы проверить файлы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено. Відкрийте OhMyMoney, щоб перевірити надіслані файли."
          }
        }
      }
    },
    "share.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen an OhMyMoney ist verfügbar, wenn App-Gruppen eingeschaltet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing to OhMyMoney will be available when App Groups are enabled."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "App Groups қосылғанда OhMyMoney қолданбасымен бөлісу қолжетімді болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача в OhMyMoney станет доступна после включения App Groups."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання в OhMyMoney стане доступним після ввімкнення App Groups."
          }
        }
      }
    },
    "share.unsupported": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie ein Bild, eine PDF oder eine Bank-Nachricht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a picture, PDF or bank message."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суретпен, PDF не банк хабарымен бөлісіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь картинкой, PDF или сообщением банка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішліть зображення, PDF або повідомлення банку."
          }
        }
      }
    }
  },
  "version": "1.0"
}
