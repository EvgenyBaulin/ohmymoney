    "share.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan faylı açmaq mümkün olmadı. Onu OhMyMoney-in son versiyası ilə yenidən paylaşın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося адкрыць абагулены файл. Абагульце яго яшчэ раз з апошняй версіяй OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geteilte Datei konnte nicht geöffnet werden. Teilen Sie sie erneut mit der neuesten Version von OhMyMoney."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared file could not be opened. Share it again with the latest version of OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el archivo compartido. Compártalo de nuevo con la última versión de OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier partagé n'a pas pu être ouvert. Partagez-le à nouveau avec la dernière version d'OhMyMoney."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց բացել համօգտագործված ֆայլը։ Կրկին համօգտագործեք այն OhMyMoney-ի վերջին տարբերակով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il file condiviso. Condividilo di nuovo con la versione più recente di OhMyMoney."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაზიარებული ფაილის გახსნა ვერ მოხერხდა. გააზიარეთ ის ხელახლა OhMyMoney-ის უახლესი ვერსიით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлісілген файлды ашу мүмкін болмады. OhMyMoney соңғы нұсқасынан қайта бөлісіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүшүлгөн файлды ачуу мүмкүн болгон жок. Аны OhMyMoney'нин акыркы версиясы менен кайра бөлүшүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć udostępnionego pliku. Udostępnij go ponownie przy użyciu najnowszej wersji OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o arquivo compartilhado. Compartilhe-o novamente com a versão mais recente do OhMyMoney."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o ficheiro partilhado. Partilhe-o novamente com a versão mais recente do OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть переданный файл. Поделитесь им ещё раз с последней версией OhMyMoney."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли мубодилашударо кушода нашуд. Онро бо версияи охирини OhMyMoney дубора мубодила кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan dosya açılamadı. OhMyMoney’nin en son sürümüyle tekrar paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити надісланий файл. Надішліть його знову з найновішої версії OhMyMoney."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulashilgan faylni ochib bo‘lmadi. Uni OhMyMoney’ning so‘nggi versiyasi orqali qayta ulashing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟分享的檔案。請使用最新版 OhMyMoney 再次分享。"
          }
        }
      }
    },
    "share.draftSaved": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyat yoxlamağınız üçün qaralamalarda gözləyir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыя чакае праверкі ў чарнавіках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang wartet als Entwurf darauf, dass Sie ihn prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation is waiting in drafts for you to review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación espera en borradores para que la revise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération attend dans les brouillons que vous la vérifiiez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործողությունը պահվել է սևագրերում՝ ստուգելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’operazione è nelle bozze, pronta per essere verificata."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოპერაცია მონახაზებში გელოდებათ გადასახედად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция нобайларда тексеруіңізді күтуде."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция карап чыгуу үчүн черновиктерде сакталды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja czeka w szkicach na sprawdzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação está nos rascunhos para revisão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação aguarda revisão nos rascunhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция ждёт проверки в «Запишу потом»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёт дар сиёҳнависҳо мунтазири баррасии шумост."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem, incelemeniz için taslaklara kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція очікує перевірки в чернетках."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Amal ko‘rib chiqishingiz uchun qoralamalarda saqlandi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已儲存至草稿，供你檢視。"
          }
        }
      }
    },
    "share.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan elementi saxlamaq mümkün olmadı. Yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося захаваць абагулены элемент. Паспрабуйце яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geteilte Element konnte nicht gespeichert werden. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared item could not be saved. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el elemento compartido. Inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément partagé n'a pas pu être enregistré. Réessayez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց պահել համօգտագործված տարրը։ Կրկին փորձեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’elemento condiviso. Riprova."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაზიარებული ელემენტის შენახვა ვერ მოხერხდა. სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлісілген элементті сақтау мүмкін болмады. Қайталап көріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүшүлгөн нерсени сактоо мүмкүн болгон жок. Кайталап көрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zachować udostępnionego elementu. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o item compartilhado. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o elemento partilhado. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить. Попробуйте ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маводи мубодилашударо захира нашуд. Дубора кӯшиш кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan öğe kaydedilemedi. Lütfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти надісланий об'єкт. Спробуйте ще раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulashilgan elementni saqlab bo‘lmadi. Qayta urinib ko‘ring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存分享的項目。請再試一次。"
          }
        }
      }
    },
    "share.messageHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesajı yoxlayın. OhMyMoney əməliyyatı qaralama kimi təklif edəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праверце паведамленне. OhMyMoney прапануе аперацыю як чарнавік."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie diese Nachricht. OhMyMoney bietet den Vorgang als Entwurf an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check this message. OhMyMoney will offer the operation as a draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise este mensaje. OhMyMoney ofrecerá la operación como borrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez ce message. OhMyMoney proposera l'opération comme brouillon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստուգեք այս հաղորդագրությունը։ OhMyMoney-ն կառաջարկի գործողությունը որպես սևագիր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il messaggio. OhMyMoney proporrà l’operazione come bozza."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეამოწმეთ შეტყობინება. OhMyMoney ოპერაციას მონახაზად შემოგთავაზებთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы хабарды тексеріңіз. OhMyMoney операцияны нобай ретінде ұсынады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул билдирүүнү текшериңиз. OhMyMoney операцияны черновик катары сунуштайт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź tę wiadomość. OhMyMoney zaproponuje operację jako szkic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira esta mensagem. O OhMyMoney oferecerá a operação como rascunho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira esta mensagem. O OhMyMoney irá propor a operação como rascunho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте сообщение. OhMyMoney предложит операцию в «Запишу потом»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин паёмро санҷед. OhMyMoney амалиётро ҳамчун сиёҳнавис пешниҳод мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesajı kontrol edin. OhMyMoney, işlemi taslak olarak sunacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте це повідомлення. OhMyMoney запропонує операцію як чернетку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu xabarni tekshiring. OhMyMoney amalni qoralama sifatida taklif qiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查這則訊息。OhMyMoney 會將交易存為草稿。"
          }
        }
      }
    },
