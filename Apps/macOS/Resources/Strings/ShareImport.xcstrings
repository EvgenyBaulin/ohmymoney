    "share.unavailable": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Абагульванне ў OhMyMoney стане даступным пасля ўключэння App Groups."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen an OhMyMoney ist verfügbar, wenn App-Gruppen eingeschaltet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing to OhMyMoney will be available when App Groups are enabled."
          }
        },
