    "share.damaged": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося адкрыць абагулены файл. Абагульце яго яшчэ раз з апошняй версіяй OhMyMoney."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geteilte Datei konnte nicht geöffnet werden. Teilen Sie sie erneut mit der neuesten Version von OhMyMoney."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared file could not be opened. Share it again with the latest version of OhMyMoney."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el archivo compartido. Compártalo de nuevo con la última versión de OhMyMoney."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier partagé n'a pas pu être ouvert. Partagez-le à nouveau avec la dernière version d'OhMyMoney."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il file condiviso. Condividilo di nuovo con la versione più recente di OhMyMoney."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлісілген файлды ашу мүмкін болмады. OhMyMoney соңғы нұсқасынан қайта бөлісіңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć udostępnionego pliku. Udostępnij go ponownie przy użyciu najnowszej wersji OhMyMoney."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o arquivo compartilhado. Compartilhe-o novamente com a versão mais recente do OhMyMoney."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть переданный файл. Поделитесь им ещё раз с последней версией OhMyMoney."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan dosya açılamadı. OhMyMoney’nin en son sürümüyle tekrar paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити надісланий файл. Надішліть його знову з найновішої версії OhMyMoney."
          }
        }
      }
    },
    "share.draftSaved": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыя чакае праверкі ў чарнавіках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang wartet als Entwurf darauf, dass Sie ihn prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation is waiting in drafts for you to review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación espera en borradores para que la revise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération attend dans les brouillons que vous la vérifiiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’operazione è nelle bozze, pronta per essere verificata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция нобайларда тексеруіңізді күтуде."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja czeka w szkicach na sprawdzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação está nos rascunhos para revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция ждёт проверки в «Запишу потом»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem, incelemeniz için taslaklara kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція очікує перевірки в чернетках."
          }
        }
      }
    },
    "share.failed": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося захаваць абагулены элемент. Паспрабуйце яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geteilte Element konnte nicht gespeichert werden. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared item could not be saved. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el elemento compartido. Inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément partagé n'a pas pu être enregistré. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’elemento condiviso. Riprova."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлісілген элементті сақтау мүмкін болмады. Қайталап көріңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zachować udostępnionego elementu. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o item compartilhado. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить. Попробуйте ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan öğe kaydedilemedi. Lütfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти надісланий об'єкт. Спробуйте ще раз."
          }
        }
      }
    },
    "share.messageHint": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праверце паведамленне. OhMyMoney прапануе аперацыю як чарнавік."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie diese Nachricht. OhMyMoney bietet den Vorgang als Entwurf an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check this message. OhMyMoney will offer the operation as a draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise este mensaje. OhMyMoney ofrecerá la operación como borrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez ce message. OhMyMoney proposera l'opération comme brouillon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il messaggio. OhMyMoney proporrà l’operazione come bozza."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы хабарды тексеріңіз. OhMyMoney операцияны нобай ретінде ұсынады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź tę wiadomość. OhMyMoney zaproponuje operację jako szkic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira esta mensagem. O OhMyMoney oferecerá a operação como rascunho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте сообщение. OhMyMoney предложит операцию в «Запишу потом»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesajı kontrol edin. OhMyMoney, işlemi taslak olarak sunacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте це повідомлення. OhMyMoney запропонує операцію як чернетку."
          }
        }
      }
    },
