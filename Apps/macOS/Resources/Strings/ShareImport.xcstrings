        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni file sono stati salvati. Apri OhMyMoney per verificarli, poi condividi di nuovo i file rimanenti."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზოგი ფაილი შენახულია. გასაცნობად გახსენით OhMyMoney, შემდეგ კი დარჩენილი ფაილები ხელახლა გააზიარეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбір файлдар сақталды. Оларды тексеру үшін OhMyMoney ашыңыз, содан кейін қалған файлдарды қайта бөлісіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айрым файлдар сакталды. Аларды карап чыгуу үчүн OhMyMoney'ни ачып, калган файлдарды кайра бөлүшүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre pliki zostały zachowane. Otwórz OhMyMoney, aby je sprawdzić, a następnie udostępnij pozostałe pliki ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos foram salvos. Abra o OhMyMoney para revisá-los e compartilhe os demais novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns ficheiros foram guardados. Abra o OhMyMoney para os rever e volte a partilhar os restantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть файлов сохранена. Проверьте их в OhMyMoney, затем поделитесь оставшимися ещё раз."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баъзе файлҳо захира шуданд. Барои баррасии онҳо OhMyMoney-ро кушоед ва файлҳои боқимондаро дубора мубодила кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı dosyalar kaydedildi. Bunları incelemek için OhMyMoney’yi açın, ardından kalan dosyaları tekrar paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частину файлів збережено. Відкрийте OhMyMoney, щоб перевірити їх, а потім надішліть решту знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrim fayllar saqlandi. Ularni ko‘rish uchun OhMyMoney’ni oching, so‘ng qolgan fayllarni qayta ulashing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分檔案已儲存。請開啟 OhMyMoney 檢視，然後再次分享其餘檔案。"
          }
        }
      }
