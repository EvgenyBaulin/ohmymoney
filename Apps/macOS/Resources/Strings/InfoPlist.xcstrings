            "value": "განბლოკეთ OhMyMoney Face ID-ით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ді Face ID арқылы ашыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney колдонмосун Face ID менен ачыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowuj OhMyMoney za pomocą Face ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o OhMyMoney com o Face ID."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o OhMyMoney com o Face ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать OhMyMoney с помощью Face ID."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ро бо Face ID кушоед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney'nin kilidini Face ID ile açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокування OhMyMoney за допомогою Face ID."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney’ni Face ID bilan oching."
          }
        },
