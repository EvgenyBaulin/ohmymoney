    "NSMicrophoneUsageDescription": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney выкарыстоўвае мікрафон для дыктоўкі запісаў на гэтай прыладзе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney nutzt das Mikrofon, um Einträge auf diesem Gerät zu diktieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney uses the microphone to dictate entries on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney usa el micrófono para dictar apuntes en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney utilise le micro pour dicter les saisies sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney usa il microfono per dettare le registrazioni su questo dispositivo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney микрофонды осы құрылғыда диктовка үшін пайдаланады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney używa mikrofonu do dyktowania wpisów na tym urządzeniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney использует микрофон для диктовки записей на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney, bu aygıtta kayıtları sesle yazdırmak için mikrofonu kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney використовує мікрофон для диктування записів на цьому пристрої."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney пераўтварае маўленне ў тэкст запісу на гэтай прыладзе, не адпраўляючы аўдыя для распазнавання ў воблаку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney wandelt Ihre Sprache auf diesem Gerät in Eingabetext um, ohne Audio zur Cloud-Erkennung zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney converts your speech into entry text on this device, without sending audio for cloud recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney convierte su voz en texto de apunte en este dispositivo, sin enviar audio para el reconocimiento en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney transforme votre voix en texte de saisie sur cet appareil, sans envoyer l'audio à une reconnaissance dans le nuage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney converte la voce nel testo delle registrazioni su questo dispositivo, senza inviare l’audio al cloud per il riconoscimento."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney сөзіңізді осы құрылғыда жазба мәтініне айналдырады, аудионы бұлттық тануға жібермей."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney zamienia mowę na tekst wpisu na tym urządzeniu, bez wysyłania nagrania do rozpoznawania w chmurze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney превращает речь в текст записи на этом устройстве, без отправки аудио для облачного распознавания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney, sesinizi bulutta tanınması için göndermeden bu aygıtta kayıt metnine dönüştürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney перетворює ваше мовлення на текст запису на цьому пристрої, не надсилаючи аудіо для розпізнавання в хмарі."
          }
        }
      }
    },
