    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney işarələdiyiniz yerə yaxınlaşdığınızı aşkar edərək ödəniş üçün ən uyğun kartı təklif edir. Məkanınız telefonda yoxlanılır və heç vaxt ondan kənara çıxmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney вызначае, калі вы набліжаецеся да пазначанага месца, каб прапанаваць найлепшую картку для аплаты. Ваша месцазнаходжанне правяраецца на тэлефоне і не пакідае яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney rozpozná, když se přiblížíte k označenému místu, a doporučí vám nejvhodnější kartu k placení. Vaše poloha se kontroluje v telefonu a nikdy ho neopustí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney erkennt, wenn du dich einem markierten Ort näherst, und schlägt dir die beste Karte zum Bezahlen vor. Dein Standort wird auf dem iPhone geprüft und bleibt dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney notices when you come near a place you marked, to suggest the best card to pay with. Your position is checked on the phone and never leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney detecta cuándo te acercas a un lugar marcado para sugerirte la mejor tarjeta con la que pagar. Tu ubicación se comprueba en el teléfono y nunca sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney détecte votre proximité avec un lieu enregistré pour vous suggérer la meilleure carte à utiliser. Votre position est vérifiée sur votre téléphone et ne le quitte jamais."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն նկատում է, երբ մոտենում եք նշված վայրին, և առաջարկում է վճարման համար լավագույն քարտը։ Ձեր գտնվելու վայրը ստուգվում է հեռախոսում և չի փոխանցվում այլուր։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney rileva quando ti avvicini a un luogo contrassegnato per suggerirti la carta migliore con cui pagare. La tua posizione viene verificata sul telefono e non viene mai condivisa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoneyは、登録した場所に近づくと、支払いに最適なカードを提案します。位置情報はこのiPhone上で確認され、外部に送信されることはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ამჩნევს, როცა მონიშნულ ადგილს უახლოვდებით, და გადახდისთვის საუკეთესო ბარათს გირჩევთ. თქვენი მდებარეობა მოწმდება მხოლოდ ტელეფონზე და მას არ ტოვებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney сіз белгілеген орынға жақындағаныңызды байқап, төлеуге ең тиімді картаны ұсынады. Орналасқан жеріңіз телефонда тексеріледі және одан тыс жіберілмейді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney가 표시한 장소에 가까이 가면 결제하기 가장 좋은 카드를 추천합니다. 위치는 기기에서 확인하며 외부로 전송되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney сиз белгилеген жерге жакындаганыңызды байкап, төлөө үчүн эң ылайыктуу картаны сунуштайт. Жайгашкан жериңиз телефондо текшерилет жана андан сыртка чыкпайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney merkt wanneer je in de buurt komt van een gemarkeerde plek en stelt de beste betaalkaart voor. Je locatie wordt op je telefoon gecontroleerd en blijft daar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney wykrywa, gdy zbliżasz się do oznaczonego miejsca, i proponuje najlepszą kartę do płatności. Twoja lokalizacja jest sprawdzana na telefonie i nigdy go nie opuszcza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney identifica quando você se aproxima de um local marcado para sugerir o melhor cartão para pagar. Sua localização é verificada no telefone e nunca sai dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney deteta quando se aproxima de um local marcado para sugerir o melhor cartão para pagar. A sua localização é verificada no telefone e nunca sai do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney замечает, когда вы подходите к отмеченному месту, чтобы подсказать, какой картой лучше платить. Ваше положение проверяется на телефоне и никуда не уходит."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney наздикшавии шуморо ба ҷойи қайдшуда пай мебарад, то корти беҳтаринро барои пардохт пешниҳод кунад. Ҷойгиршавии шумо дар телефон санҷида мешавад ва аз он берун намеравад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney, işaretlediğiniz bir yere yaklaştığınızda ödeme için en uygun kartı önerir. Konumunuz telefonda kontrol edilir ve asla dışarı aktarılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney помічає, коли ви наближаєтеся до позначеного місця, щоб підказати, якою карткою краще платити. Ваше місцеположення визначається на телефоні й не передається з нього."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney belgilangan joyga yaqinlashganingizni aniqlab, to‘lov uchun eng qulay kartani tavsiya qiladi. Joylashuvingiz telefonda aniqlanadi va undan tashqariga uzatilmaydi."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney seçdiyiniz yeri işarələmək üçün məkanınızı bir dəfə müəyyən edir. İşarələr və məkanınız bu telefonda qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney аднаразова вызначае ваша месцазнаходжанне, каб пазначыць выбранае месца. Адметкі і ваша месцазнаходжанне застаюцца на гэтым тэлефоне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney jednorázově zjistí vaši polohu, aby označila místo, které vyberete. Označená místa i vaše poloha zůstanou v tomto telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ermittelt einmalig deinen Standort, um einen ausgewählten Ort zu markieren. Die Markierungen und dein Standort bleiben auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney reads where you are once, to mark a place you choose. The marks and your position stay on this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney consulta tu ubicación una vez para marcar un lugar que elijas. Los lugares marcados y tu ubicación permanecen en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney utilise votre position une seule fois pour enregistrer un lieu de votre choix. Les lieux enregistrés et votre position restent sur ce téléphone."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն մեկ անգամ ստուգում է ձեր գտնվելու վայրը՝ ընտրված վայրը նշելու համար։ Նշումները և ձեր գտնվելու վայրը մնում են այս հեռախոսում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney rileva la tua posizione una sola volta per contrassegnare un luogo scelto da te. I luoghi contrassegnati e la tua posizione rimangono su questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoneyは、選択した場所を登録するために、現在地を一度だけ取得します。登録した場所と位置情報はこのiPhone内に保存されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ერთხელ ადგენს თქვენს მდებარეობას თქვენ მიერ არჩეული ადგილის მოსანიშნად. მონიშნული ადგილები და თქვენი მდებარეობა ამ ტელეფონზე რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney сіз таңдаған орынды белгілеу үшін орналасқан жеріңізді бір рет анықтайды. Белгілер мен орналасқан жеріңіз осы телефонда сақталады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney가 선택한 장소를 표시하기 위해 위치를 한 번 확인합니다. 표시한 장소와 위치는 이 기기에만 저장됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney сиз тандаган жерди белгилөө үчүн жайгашкан жериңизди бир жолу аныктайт. Белгилер жана жайгашкан жериңиз ушул телефондо сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney bepaalt eenmalig je locatie om een plek te markeren die je kiest. De markeringen en je locatie blijven op deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney jednorazowo odczytuje Twoją lokalizację, aby oznaczyć wybrane miejsce. Oznaczenia i Twoja lokalizacja pozostają na tym telefonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney verifica sua localização uma vez para marcar um local escolhido por você. As marcações e sua localização permanecem neste telefone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney acede à sua localização uma vez para marcar um local à sua escolha. Os locais marcados e a sua localização permanecem neste telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney один раз узнаёт, где вы, чтобы отметить выбранное вами место. Отметки и ваше положение остаются на этом телефоне."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney ҷойгиршавии шуморо як бор муайян мекунад, то ҷойи интихобкардаатонро қайд кунад. Нишонаҳо ва ҷойгиршавии шумо дар ин телефон мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney, seçtiğiniz bir yeri işaretlemek için konumunuzu bir kez okur. İşaretler ve konumunuz bu telefonda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney одноразово визначає ваше місцеположення, щоб позначити вибране вами місце. Позначки та ваше місцеположення залишаються на цьому телефоні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney siz tanlagan joyni belgilash uchun joylashuvingizni bir marta aniqlaydi. Belgilar va joylashuvingiz shu telefonda saqlanadi."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney bu cihazda qeydləri diktə etmək üçün mikrofondan istifadə edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney выкарыстоўвае мікрафон для дыктоўкі запісаў на гэтай прыладзе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney používá mikrofon k diktování záznamů na tomto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney nutzt das Mikrofon, um Einträge auf diesem Gerät zu diktieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney uses the microphone to dictate entries on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney usa el micrófono para dictar apuntes en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney utilise le micro pour dicter les saisies sur cet appareil."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն օգտագործում է խոսափողը՝ այս սարքում գրառումները թելադրելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney usa il microfono per dettare le registrazioni su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoneyは、このデバイスで入力内容を音声入力するためにマイクを使用します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney იყენებს მიკროფონს ამ მოწყობილობაზე ჩანაწერების კარნახისთვის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney микрофонды осы құрылғыда диктовка үшін пайдаланады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney는 이 기기에서 내역을 받아쓰기 위해 마이크를 사용합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney бул түзмөктө жазууларды үн менен киргизүү үчүн микрофонду колдонот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney gebruikt de microfoon om boekingen op dit apparaat te dicteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney używa mikrofonu do dyktowania wpisów na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney usa o microfone para ditar lançamentos neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney usa o microfone para ditar registos neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney использует микрофон для диктовки записей на этом устройстве."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney микрофонро барои дикта кардани сабтҳо дар ин дастгоҳ истифода мебарад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney, bu aygıtta kayıtları sesle yazdırmak için mikrofonu kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney використовує мікрофон для диктування записів на цьому пристрої."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney bu qurilmada yozuvlarni ovoz bilan kiritish uchun mikrofondan foydalanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 使用麦克风在此设备上听写记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 使用麥克風在此裝置上聽寫記錄。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney səsinizi tanınma üçün buluda göndərmədən bu cihazda qeyd mətninə çevirir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney пераўтварае маўленне ў тэкст запісу на гэтай прыладзе, не адпраўляючы аўдыя для распазнавання ў воблаку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney převádí řeč na text záznamů na tomto zařízení, aniž by odesílala zvuk ke cloudovému rozpoznávání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney wandelt Ihre Sprache auf diesem Gerät in Eingabetext um, ohne Audio zur Cloud-Erkennung zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney converts your speech into entry text on this device, without sending audio for cloud recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney convierte su voz en texto de apunte en este dispositivo, sin enviar audio para el reconocimiento en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney transforme votre voix en texte de saisie sur cet appareil, sans envoyer l'audio à une reconnaissance dans le nuage."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն ձեր խոսքը վերածում է գրառման տեքստի այս սարքում՝ առանց ձայնը ամպային ճանաչման ուղարկելու։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney converte la voce nel testo delle registrazioni su questo dispositivo, senza inviare l’audio al cloud per il riconoscimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoneyは、クラウドに音声を送信せずに、このデバイス上で音声をテキストに変換します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney თქვენს მეტყველებას ამ მოწყობილობაზე ჩანაწერის ტექსტად გარდაქმნის, აუდიოს ღრუბელში ამოსაცნობად გაგზავნის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney сөзіңізді осы құрылғыда жазба мәтініне айналдырады, аудионы бұлттық тануға жібермей."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney는 오디오를 클라우드로 보내 인식하지 않고 이 기기에서 음성을 내역 텍스트로 변환합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney аудиону булутка жөнөтпөстөн, сөзүңүздү ушул түзмөктө жазуу текстине айлантат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney zet je spraak op dit apparaat om in tekst voor boekingen, zonder audio naar de cloud te sturen voor herkenning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney zamienia mowę na tekst wpisu na tym urządzeniu, bez wysyłania nagrania do rozpoznawania w chmurze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney converte sua fala em texto para lançamentos neste dispositivo, sem enviar áudio para reconhecimento na nuvem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney converte a sua fala em texto de registo neste dispositivo, sem enviar áudio para reconhecimento na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney превращает речь в текст записи на этом устройстве, без отправки аудио для облачного распознавания."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney гуфтори шуморо дар ин дастгоҳ ба матни сабт табдил медиҳад, бе фиристодани садо барои шинохт дар абр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney, sesinizi bulutta tanınması için göndermeden bu aygıtta kayıt metnine dönüştürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney перетворює ваше мовлення на текст запису на цьому пристрої, не надсилаючи аудіо для розпізнавання в хмарі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney nutqingizni bulutga yubormasdan, shu qurilmada yozuv matniga aylantiradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 在此设备上将语音转换为记录文本，不会将音频发送至云端识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 在此裝置上將語音轉換為記錄文字，不會傳送音訊至雲端辨識。"
          }
        }
      }
    },
