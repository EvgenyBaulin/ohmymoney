    "NSMicrophoneUsageDescription": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney bu cihazda qeydləri diktə etmək üçün mikrofondan istifadə edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney выкарыстоўвае мікрафон для дыктоўкі запісаў на гэтай прыладзе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney nutzt das Mikrofon, um Einträge auf diesem Gerät zu diktieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney uses the microphone to dictate entries on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney usa el micrófono para dictar apuntes en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney utilise le micro pour dicter les saisies sur cet appareil."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն օգտագործում է խոսափողը՝ այս սարքում գրառումները թելադրելու համար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney usa il microfono per dettare le registrazioni su questo dispositivo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney იყენებს მიკროფონს ამ მოწყობილობაზე ჩანაწერების კარნახისთვის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney микрофонды осы құрылғыда диктовка үшін пайдаланады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney бул түзмөктө жазууларды үн менен киргизүү үчүн микрофонду колдонот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney używa mikrofonu do dyktowania wpisów na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney usa o microfone para ditar lançamentos neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney usa o microfone para ditar registos neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney использует микрофон для диктовки записей на этом устройстве."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney микрофонро барои дикта кардани сабтҳо дар ин дастгоҳ истифода мебарад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney, bu aygıtta kayıtları sesle yazdırmak için mikrofonu kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney використовує мікрофон для диктування записів на цьому пристрої."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney bu qurilmada yozuvlarni ovoz bilan kiritish uchun mikrofondan foydalanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 使用麥克風在此裝置上聽寫記錄。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney səsinizi tanınma üçün buluda göndərmədən bu cihazda qeyd mətninə çevirir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney пераўтварае маўленне ў тэкст запісу на гэтай прыладзе, не адпраўляючы аўдыя для распазнавання ў воблаку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney wandelt Ihre Sprache auf diesem Gerät in Eingabetext um, ohne Audio zur Cloud-Erkennung zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney converts your speech into entry text on this device, without sending audio for cloud recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney convierte su voz en texto de apunte en este dispositivo, sin enviar audio para el reconocimiento en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney transforme votre voix en texte de saisie sur cet appareil, sans envoyer l'audio à une reconnaissance dans le nuage."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ն ձեր խոսքը վերածում է գրառման տեքստի այս սարքում՝ առանց ձայնը ամպային ճանաչման ուղարկելու։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney converte la voce nel testo delle registrazioni su questo dispositivo, senza inviare l’audio al cloud per il riconoscimento."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney თქვენს მეტყველებას ამ მოწყობილობაზე ჩანაწერის ტექსტად გარდაქმნის, აუდიოს ღრუბელში ამოსაცნობად გაგზავნის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney сөзіңізді осы құрылғыда жазба мәтініне айналдырады, аудионы бұлттық тануға жібермей."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney аудиону булутка жөнөтпөстөн, сөзүңүздү ушул түзмөктө жазуу текстине айлантат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney zamienia mowę na tekst wpisu na tym urządzeniu, bez wysyłania nagrania do rozpoznawania w chmurze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney converte sua fala em texto para lançamentos neste dispositivo, sem enviar áudio para reconhecimento na nuvem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OhMyMoney converte a sua fala em texto de registo neste dispositivo, sem enviar áudio para reconhecimento na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney превращает речь в текст записи на этом устройстве, без отправки аудио для облачного распознавания."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney гуфтори шуморо дар ин дастгоҳ ба матни сабт табдил медиҳад, бе фиристодани садо барои шинохт дар абр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney, sesinizi bulutta tanınması için göndermeden bu aygıtta kayıt metnine dönüştürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney перетворює ваше мовлення на текст запису на цьому пристрої, не надсилаючи аудіо для розпізнавання в хмарі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney nutqingizni bulutga yubormasdan, shu qurilmada yozuv matniga aylantiradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney 在此裝置上將語音轉換為記錄文字，不會傳送音訊至雲端辨識。"
          }
        }
      }
    },
