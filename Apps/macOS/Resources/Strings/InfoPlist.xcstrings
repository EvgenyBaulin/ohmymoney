    "NSFaceIDUsageDescription": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney kilidini Face ID ilə açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблакіроўка OhMyMoney з дапамогай Face ID."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemykejte OhMyMoney pomocí Face ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie OhMyMoney mit Face ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock OhMyMoney with Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquee OhMyMoney con Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez OhMyMoney avec Face ID."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ապակողպեք OhMyMoney-ն Face ID-ով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca OhMyMoney con Face ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face IDでOhMyMoneyのロックを解除します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განბლოკეთ OhMyMoney Face ID-ით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ді Face ID арқылы ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID로 OhMyMoney를 잠금 해제합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney колдонмосун Face ID менен ачыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel OhMyMoney met Face ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowuj OhMyMoney za pomocą Face ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o OhMyMoney com o Face ID."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o OhMyMoney com o Face ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать OhMyMoney с помощью Face ID."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ро бо Face ID кушоед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney'nin kilidini Face ID ile açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокування OhMyMoney за допомогою Face ID."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney’ni Face ID bilan oching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用面容 ID 解锁 OhMyMoney。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID 解鎖 OhMyMoney。"
          }
        }
      }
