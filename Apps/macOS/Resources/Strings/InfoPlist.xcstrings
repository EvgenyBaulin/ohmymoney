    "NSFaceIDUsageDescription": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблакіроўка OhMyMoney з дапамогай Face ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie OhMyMoney mit Face ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock OhMyMoney with Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquee OhMyMoney con Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez OhMyMoney avec Face ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca OhMyMoney con Face ID."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney-ді Face ID арқылы ашыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowuj OhMyMoney za pomocą Face ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать OhMyMoney с помощью Face ID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney'nin kilidini Face ID ile açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокування OhMyMoney за допомогою Face ID."
          }
        }
      }
    },
