    "NSFaceIDUsageDescription": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "OhMyMoney kilidini Face ID ilə açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблакіроўка OhMyMoney з дапамогай Face ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie OhMyMoney mit Face ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock OhMyMoney with Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquee OhMyMoney con Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez OhMyMoney avec Face ID."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ապակողպեք OhMyMoney-ն Face ID-ով։"
          }
        },
        "it": {
