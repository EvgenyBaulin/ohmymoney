    "summaries.fact.weekendHeavier": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həftəsonları gündə iş günlərindəkindən %@ çox xərcləyirsiniz"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У выхадныя вы траціце на %@ больш за дзень, чым у будні"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O víkendech utratíte denně o %@ víc než ve všední dny"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Wochenende geben Sie pro Tag %@ mehr aus als an Werktagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At weekends you spend %@ more a day than on weekdays"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fines de semana gasta %@ más al día que entre semana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le week-end, vous dépensez %@ de plus par jour qu'en semaine"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հանգստյան օրերին օրական %@ ավելի եք ծախսում, քան աշխատանքային օրերին"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei fine settimana spendi %@ in più al giorno rispetto ai giorni feriali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末は平日より、1日あたり%@多く使っています"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შაბათ-კვირას დღეში %@-ით მეტს ხარჯავთ, ვიდრე სამუშაო დღეებში"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демалыста жұмыс күндерінен күніне %@ көп жұмсайсыз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Дем алыш күндөрү иш күндөрүнө караганда күнүнө %@ көбүрөөк сарптайсыз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In het weekend geef je per dag %@ meer uit dan doordeweeks"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W weekendy wydajesz dziennie o %@ więcej niż w dni powszednie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos fins de semana, você gasta %@ a mais por dia que nos dias úteis"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao fim de semana, gasta mais %@ por dia do que durante a semana"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выходные ты тратишь на %@ больше в день, чем в будни"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар рӯзҳои истироҳат шумо дар як рӯз %@ бештар аз рӯзҳои корӣ сарф мекунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonları günde hafta içine göre %@ daha fazla harcıyorsunuz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вихідні ви витрачаєте на %@ більше на день, ніж у будні"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Dam olish kunlari ish kunlariga nisbatan kuniga %@ ko‘proq sarflaysiz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周末的日均支出比工作日多%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週末的每日支出比平日多%@"
          }
        }
      }
