        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets te melden: meer gegevens nodig"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze za mało danych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dados suficientes"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dados suficientes"
          }
        },
        "ru": {
