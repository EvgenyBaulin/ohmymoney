    "summaries.pdf.askMessage": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумы схаваны на экране. У PDF іх можна паказаць або схаваць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beträge sind auf dem Bildschirm ausgeblendet. Die PDF kann sie zeigen oder weglassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts are hidden on the screen. The PDF can show them or leave them out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los importes están ocultos en la pantalla. El PDF puede mostrarlos o dejarlos fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les montants sont masqués à l'écran. Le PDF peut les afficher ou les omettre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli importi sono nascosti sullo schermo. Puoi mostrarli o escluderli dal PDF."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Экранда сомалар жасырылған. PDF ішінде көрсетуге не жасыруға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммалар экранда жашырылган. Аларды PDFке кошсоңуз же жашырсаңыз болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwoty są ukryte na ekranie. Możesz je pokazać lub pominąć w PDF-ie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores estão ocultos na tela. Você pode incluí-los ou não no PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране суммы скрыты. В PDF их можно оставить или убрать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағҳо дар экран пинҳонанд. Онҳоро дар PDF нишон додан ё пинҳон кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlar ekranda gizli. PDF'de gösterilebilir veya gizli tutulabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На екрані суми приховано. PDF може їх показувати або пропустити."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Summalar ekranda yashirilgan. Ularni PDF faylga kiritish yoki yashirish mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面上的金額已隱藏。PDF 可選擇顯示或隱藏金額。"
          }
        }
      }
    },
