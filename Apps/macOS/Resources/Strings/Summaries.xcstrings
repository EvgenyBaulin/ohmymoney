          "stringUnit": {
            "state": "translated",
            "value": "Letzte Woche wurde nichts ausgegeben, daher gibt es nichts zu vergleichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was spent last week, so there is nothing to compare with"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semana pasada no hubo gastos, así que no hay con qué comparar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été dépensé la semaine dernière, donc il n'y a rien à comparer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna spesa la settimana scorsa: impossibile fare un confronto"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен аптада шығын болмады, салыстыратын ештеңе жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөн аптада чыгаша болгон эмес, салыштырууга эч нерсе жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zeszłym tygodniu nic nie wydano, więc nie ma z czym porównać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve gastos na semana passada para comparar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На прошлой неделе трат не было, сравнивать не с чем"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳафтаи пеш харҷ набуд, барои муқоиса маълумот нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen hafta harcama yapılmadığı için karşılaştırma yapılamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Минулого тижня витрат не було, тож порівнювати не з чим"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan hafta xarajat bo‘lmagan, solishtirishning imkoni yo‘q"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上週沒有支出，無法比較"
          }
        }
      }
    },
