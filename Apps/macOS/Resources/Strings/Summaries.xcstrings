    "summaries.pdf.askMessage": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məbləğlər ekranda gizlədilib. PDF-də onları göstərmək və ya gizlətmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумы схаваны на экране. У PDF іх можна паказаць або схаваць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částky jsou na obrazovce skryté. V PDF je můžete zobrazit nebo vynechat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beträge sind auf dem Bildschirm ausgeblendet. Die PDF kann sie zeigen oder weglassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts are hidden on the screen. The PDF can show them or leave them out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los importes están ocultos en la pantalla. El PDF puede mostrarlos o dejarlos fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les montants sont masqués à l'écran. Le PDF peut les afficher ou les omettre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գումարները թաքցված են էկրանին։ PDF-ում դրանք կարելի է ցույց տալ կամ թաքցնել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli importi sono nascosti sullo schermo. Puoi mostrarli o escluderli dal PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上では金額が非表示になっています。PDFに金額を表示するかどうかを選べます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხები ეკრანზე დამალულია. PDF-ში შეგიძლიათ მათი ჩვენება ან გამოტოვება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Экранда сомалар жасырылған. PDF ішінде көрсетуге не жасыруға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммалар экранда жашырылган. Аларды PDFке кошсоңуз же жашырсаңыз болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedragen zijn verborgen op het scherm. Je kunt ze in de pdf tonen of weglaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwoty są ukryte na ekranie. Możesz je pokazać lub pominąć w PDF-ie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores estão ocultos na tela. Você pode incluí-los ou não no PDF."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores estão ocultos no ecrã. Pode incluí-los ou ocultá-los no PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране суммы скрыты. В PDF их можно оставить или убрать."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағҳо дар экран пинҳонанд. Онҳоро дар PDF нишон додан ё пинҳон кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlar ekranda gizli. PDF'de gösterilebilir veya gizli tutulabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На екрані суми приховано. PDF може їх показувати або пропустити."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Summalar ekranda yashirilgan. Ularni PDF faylga kiritish yoki yashirish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上的金额已隐藏。你可以选择是否在 PDF 中显示金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面上的金額已隱藏。PDF 可選擇顯示或隱藏金額。"
          }
        }
      }
    },
