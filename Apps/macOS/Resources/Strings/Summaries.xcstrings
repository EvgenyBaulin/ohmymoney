          "stringUnit": {
            "state": "translated",
            "value": "Чыгаша өткөн аптага караганда %@ көбөйдү"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgaven %@ hoger dan vorige week"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatki są o %@ wyższe niż w zeszłym tygodniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastos %@ maiores que na semana passada"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Despesas %@ superiores às da semana passada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расходов на %@ больше, чем на прошлой неделе"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Харҷ нисбат ба ҳафтаи пеш %@ бештар аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcama geçen haftaya göre %@ arttı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати на %@ більші, ніж минулого тижня"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajatlar o‘tgan haftaga nisbatan %@ ko‘p"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支出比上周增加了 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出比上週增加 %@"
          }
        }
      }
    },
    "summaries.line.weekNoPrevious": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Keçən həftə xərc olmayıb, müqayisə etmək mümkün deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мінулым тыднем выдаткаў не было, таму няма з чым параўнаць"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minulý týden nebyly žádné výdaje, není tedy s čím porovnávat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Woche wurde nichts ausgegeben, daher gibt es nichts zu vergleichen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was spent last week, so there is nothing to compare with"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semana pasada no hubo gastos, así que no hay con qué comparar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été dépensé la semaine dernière, donc il n'y a rien à comparer"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախորդ շաբաթ ծախսեր չեն եղել, ուստի համեմատելու բան չկա"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna spesa la settimana scorsa: impossibile fare un confronto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先週の支出がないため、比較できません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წინა კვირაში ხარჯი არ ყოფილა, ამიტომ შედარება შეუძლებელია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен аптада шығын болмады, салыстыратын ештеңе жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөн аптада чыгаша болгон эмес, салыштырууга эч нерсе жок"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorige week is niets uitgegeven, dus vergelijken is niet mogelijk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zeszłym tygodniu nic nie wydano, więc nie ma z czym porównać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve gastos na semana passada para comparar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve despesas na semana passada para comparar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На прошлой неделе трат не было, сравнивать не с чем"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳафтаи пеш харҷ набуд, барои муқоиса маълумот нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen hafta harcama yapılmadığı için karşılaştırma yapılamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Минулого тижня витрат не було, тож порівнювати не з чим"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan hafta xarajat bo‘lmagan, solishtirishning imkoni yo‘q"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上周没有支出，无法比较"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上週沒有支出，無法比較"
          }
        }
      }
