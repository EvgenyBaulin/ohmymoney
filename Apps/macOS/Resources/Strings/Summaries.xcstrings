    "summaries.board.empty.text": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcmal üçün əməliyyatları olan tamamlanmış həftə, ay və ya il lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для агляду патрэбны завершаны тыдзень, месяц або год з аперацыямі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehled vyžaduje dokončený týden, měsíc nebo rok s transakcemi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zusammenfassung braucht eine abgeschlossene Woche, einen Monat oder ein Jahr mit Vorgängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A summary needs a finished week, month or year with operations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen necesita una semana, un mes o un año terminado con operaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un récapitulatif demande une semaine, un mois ou une année terminés avec des opérations."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփման համար պետք է ավարտված շաբաթ, ամիս կամ տարի՝ գործարքներով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per il riepilogo serve una settimana, un mese o un anno concluso con operazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引のある週、月、または年が終わると、サマリーが表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯამებისთვის საჭიროა დასრულებული კვირა, თვე ან წელი ოპერაციებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытынды үшін операциялары бар аяқталған апта, ай не жыл қажет."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жыйынтык үчүн операциялар болгон аяктаган апта, ай же жыл керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een overzicht is een afgeronde week, maand of jaar met transacties nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowanie wymaga zakończonego tygodnia, miesiąca lub roku z operacjami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver um resumo, é preciso ter uma semana, um mês ou um ano encerrado com movimentações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver um resumo, é necessária uma semana, mês ou ano concluído com operações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна законченная неделя, месяц или год с операциями."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои хулоса ҳафта, моҳ ё соли анҷомёфта бо амалиёт лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özet için işlem içeren tamamlanmış bir hafta, ay veya yıl gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумку потрібні завершені тиждень, місяць або рік з операціями."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobot uchun amallari bor yakunlangan hafta, oy yoki yil kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要有交易记录的完整周、月或年才能生成汇总。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要有交易記錄的完整週、月或年才能顯示摘要。"
          }
        }
      }
    },
