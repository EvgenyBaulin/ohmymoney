    "summaries.board.empty.text": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для агляду патрэбны завершаны тыдзень, месяц або год з аперацыямі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zusammenfassung braucht eine abgeschlossene Woche, einen Monat oder ein Jahr mit Vorgängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A summary needs a finished week, month or year with operations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen necesita una semana, un mes o un año terminado con operaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un récapitulatif demande une semaine, un mois ou une année terminés avec des opérations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per il riepilogo serve una settimana, un mese o un anno concluso con operazioni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытынды үшін операциялары бар аяқталған апта, ай не жыл қажет."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жыйынтык үчүн операциялар болгон аяктаган апта, ай же жыл керек."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowanie wymaga zakończonego tygodnia, miesiąca lub roku z operacjami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver um resumo, é preciso ter uma semana, um mês ou um ano encerrado com movimentações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна законченная неделя, месяц или год с операциями."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои хулоса ҳафта, моҳ ё соли анҷомёфта бо амалиёт лозим аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özet için işlem içeren tamamlanmış bir hafta, ay veya yıl gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумку потрібні завершені тиждень, місяць або рік з операціями."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobot uchun amallari bor yakunlangan hafta, oy yoki yil kerak."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要有交易記錄的完整週、月或年才能顯示摘要。"
          }
        }
      }
    },
