    "summaries.line.noFact": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ deyiləcək bir şey yoxdur: daha çox məlumat lazımdır"
          }
        },
        "be": {
