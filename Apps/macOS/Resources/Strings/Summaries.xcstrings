    "summaries.empty": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль няма чаго паказаць: для агляду патрэбны завершаны тыдзень, месяц або год з аперацыямі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zu zeigen: Eine Zusammenfassung braucht eine abgeschlossene Woche, einen Monat oder ein Jahr mit Vorgängen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to show yet: a summary needs a finished week, month or year with operations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que mostrar: un resumen necesita una semana, un mes o un año terminado con operaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à montrer pour l'instant : un récapitulatif demande une semaine, un mois ou une année terminés avec des opérations"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nulla da mostrare: per il riepilogo serve una settimana, un mese o un anno concluso con operazioni"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге көрсететін ештеңе жоқ: қорытынды үшін операциялары бар аяқталған апта, ай не жыл қажет"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча көрсөтө турган эч нерсе жок: жыйынтык үчүн операциялар болгон аяктаган апта, ай же жыл керек"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze czego pokazać: podsumowanie wymaga zakończonego tygodnia, miesiąca lub roku z operacjami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para mostrar ainda: é preciso ter uma semana, um mês ou um ano encerrado com movimentações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего показать: нужна законченная неделя, месяц или год с операциями"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло чизе барои намоиш нест: барои хулоса ҳафта, моҳ ё соли анҷомёфта бо амалиёт лозим аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz gösterilecek bir şey yok: Özet için işlem içeren tamamlanmış bir hafta, ay veya yıl gerekir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки нічого показати: підсумку потрібні завершені тиждень, місяць або рік з операціями"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha ko‘rsatadigan ma’lumot yo‘q: hisobot uchun amallari bor yakunlangan hafta, oy yoki yil kerak"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無內容可顯示：需要有交易記錄的完整週、月或年才能顯示摘要"
          }
        }
      }
    },
    "summaries.fact.afterIncomeHeavier": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За тры дні пасля паступлення грошай вы траціце на %@ больш, чым звычайна"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den drei Tagen nach einem Geldeingang geben Sie %@ mehr aus als üblich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the three days after money arrives you spend %@ more than usual"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los tres días después de que llega el dinero gasta %@ más de lo habitual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les trois jours qui suivent l'arrivée d'argent, vous dépensez %@ de plus que d'habitude"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei tre giorni dopo un'entrata spendi %@ in più del solito"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақша түскеннен кейінгі үш күнде әдеттегіден %@ көп жұмсайсыз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акча түшкөндөн кийинки үч күндө адаттагыдан %@ көбүрөөк сарптайсыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciągu trzech dni po otrzymaniu pieniędzy wydajesz o %@ więcej niż zwykle"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos três dias após receber dinheiro, você gasta %@ a mais que o normal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В первые три дня после прихода денег ты тратишь на %@ больше обычного"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар се рӯзи пас аз гирифтани пул шумо %@ бештар аз маъмул сарф мекунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para geldikten sonraki üç günde normalden %@ daha fazla harcıyorsunuz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За три дні після надходження грошей ви витрачаєте на %@ більше, ніж зазвичай"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Pul kelganidan keyingi uch kunda odatdagidan %@ ko‘proq sarflaysiz"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收入入帳後的三天內，你的支出比平常多%@"
          }
        }
      }
    },
