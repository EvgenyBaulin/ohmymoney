    "statementLearning.row.learnedHelp": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запоўнена паводле аперацыі, якую вы ўвялі ўручную для такога ж тэксту гэтага банка. Змяніце аперацыю пасля загрузкі, і наступныя радкі будуць запоўнены з улікам змены."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einem Vorgang ausgefüllt, den Sie für denselben Text dieser Bank von Hand eingetragen haben. Ändern Sie den Vorgang nach dem Laden, dann folgen die nächsten Zeilen Ihrer Änderung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filled from an operation you typed by hand for the same text of this bank. Change the operation after loading, and the next lines follow your change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenada desde una operación que escribió a mano para el mismo texto de este banco. Cambie la operación después de cargar, y las líneas siguientes seguirán su cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rempli d'après une opération que vous avez saisie à la main pour le même texte de cette banque. Modifiez l'opération après le chargement, et les lignes suivantes suivront votre modification."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լրացվել է այս բանկի նույն տեքստի համար ձեր ձեռքով մուտքագրած գործարքից։ Ներմուծումից հետո փոխեք գործարքը, և հաջորդ տողերը կհետևեն ձեր փոփոխությանը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilata da un’operazione inserita a mano con lo stesso testo di questa banca. Modifica l’operazione dopo il caricamento e le righe successive seguiranno la modifica."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეივსო ამ ბანკის იმავე ტექსტისთვის ხელით შეყვანილი ოპერაციიდან. ჩატვირთვის შემდეგ შეცვალეთ ოპერაცია და მომდევნო სტრიქონებიც ამ ცვლილებას მიჰყვება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы банктің дәл осындай мәтініне қолмен енгізген операцияңыздан толтырылды. Жүктегеннен кейін операцияны өзгертсеңіз, келесі жолдар өзгерісіңізді ескереді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул банктын ушундай эле тексти үчүн кол менен киргизген операцияңыздан толтурулду. Жүктөгөндөн кийин операцияны өзгөртсөңүз, кийинки саптар да өзгөртүүгө жараша толтурулат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzupełniono na podstawie operacji wpisanej ręcznie dla tego samego tekstu z tego banku. Zmień operację po wczytaniu, a kolejne wiersze uwzględnią tę zmianę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenchido com base em uma operação que você digitou para o mesmo texto deste banco. Altere a operação após carregar, e as próximas linhas seguirão sua alteração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнено по операции, которую вы вводили руками для такого же текста этого банка. Поправите операцию после загрузки — следующие строки будут как после правки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз амалиёти дастӣ барои ҳамин матни бонк пур шуд. Пас аз боркунӣ амалиётро тағйир диҳед, то сатрҳои оянда бо тағйироти шумо пур шаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bankanın aynı açıklamasına sahip, elle girdiğiniz bir işlemden dolduruldu. Yükledikten sonra işlemi değiştirirseniz sonraki satırlar değişikliğinize göre doldurulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заповнено з операції, яку ви ввели вручну для такого самого тексту цього банку. Змініть операцію після завантаження — наступні рядки врахують цю зміну."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu bankdagi aynan shu matn uchun qo‘lda kiritgan amalingiz asosida to‘ldirildi. Yuklagandan so‘ng amalni o‘zgartirsangiz, keyingi qatorlarda ham shu o‘zgarish qo‘llanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你先前為此銀行相同文字手動輸入的交易填入。載入後更改交易，後續項目便會套用你的更改。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
