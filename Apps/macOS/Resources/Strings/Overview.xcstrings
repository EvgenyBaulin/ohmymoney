    "currencyChart.noRates": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсаў для гэтай пары пакуль няма: не ўдалося прачытаць табліцы банка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Paar gibt es noch keine Kurse: Die Tabellen der Bank konnten nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rates for this pair yet: the bank's tables could not be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay tipos para este par: no se pudieron leer las tablas del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de cours pour cette paire : les tableaux de la banque n'ont pas pu être lus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tasso disponibile per questa coppia: impossibile leggere le tabelle della banca."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл жұп үшін әзірге бағам жоқ: банктің кестелерін оқу мүмкін болмады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursów dla tej pary: nie udało się odczytać tabel banku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсов этой пары пока нет: таблицы ЦБ не прочитались."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parite için henüz kur yok: Bankanın kur tabloları okunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсів для цієї пари ще немає: таблиці банку не вдалося прочитати."
          }
        }
      }
    },
