    "calendar.legend.level": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün rəngi: xərclər həmişəkindən çox olduqda daha tünd görünür"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колер дня: выдаткі вышэйшыя за звычайныя; светлы — крыху, цёмны — значна"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Barva dne: výdaje nad obvyklou úroveň, světlejší znamená mírně, tmavší výrazně"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagesfüllung: Ausgaben über dem Üblichen; heller heißt wenig, dunkler heißt viel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day fill: spending above usual, lighter is a little, deeper is much"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relleno del día: gasto por encima de lo habitual; más claro es poco, más oscuro es mucho"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplissage du jour : dépenses au-dessus de l'habituel, plus clair pour un peu, plus foncé pour beaucoup"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օրվա գույնը՝ սովորականից ավելի ծախսեր. բացը՝ մի փոքր, մուգը՝ շատ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore del giorno: spesa superiore al solito; più chiaro indica poco, più scuro indica molto"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღის ფერი: ჩვეულებრივზე მეტი ხარჯი — ღია ფერი ოდნავ მეტს ნიშნავს, მუქი — ბევრად მეტს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күн түсі: әдеттегіден көп шығыс, ашығырағы — аз, қоюырағы — көп"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Күндүн түсү: адаттагыдан көп чыгым; ачык түс — бир аз, кочкул түс — алда канча көп"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnienie dnia: wydatki powyżej normy, jaśniejszy kolor oznacza nieco więcej, ciemniejszy — dużo więcej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cor do dia: gastos acima do normal; tons claros indicam pouco e escuros, muito"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cor do dia: despesas acima do habitual; mais clara indica pouco, mais escura indica muito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заливка дня — траты выше обычного: светлая — немного, насыщенная — намного"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранги рӯз: харҷ аз маъмул зиёдтар; ранги равшан — каме, тира — хеле зиёд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün rengi: normalin üzerindeki harcamalar; açık renk az, koyu renk çok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заповнення дня: витрати понад звичайні; світліше — трохи, темніше — значно"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun rangi: odatdagidan ortiq xarajat; ochroq — biroz, to‘qroq — ancha ko‘p"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日期底色：支出高於平常時，淺色表示略高，深色表示高出許多"
          }
        }
      }
    },
