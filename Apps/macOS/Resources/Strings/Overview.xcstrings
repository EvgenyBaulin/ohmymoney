    "why.free.overdue": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Planların %@ məbləğində hissəsi gecikir: hələ xərclənməmiş pul kimi hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З планаў пратэрмінавана %@: улічана як яшчэ не выдаткаваныя грошы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z plánů je %@ po splatnosti: počítá se jako dosud neutracená částka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Davon sind %@ der Pläne überfällig: als Geld gezählt, das noch nicht weg ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of the plans, %@ is overdue: counted as money not gone yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De los planes, %@ está vencido: se cuenta como dinero que todavía no se ha ido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmi les plans, %@ est en retard : compté comme argent pas encore parti."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պլաններից %@-ի ժամկետն անցել է․ հաշվարկվում է որպես դեռ չծախսված գումար։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra i piani, %@ è scaduto: è considerato denaro non ancora uscito."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გეგმებიდან %@ ვადაგადაცილებულია: ითვლება ჯერ კიდევ დაუხარჯავ თანხად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоспарлардың %@ мерзімі өтіп кетті: әлі кетпеген ақша ретінде саналады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Пландардын ичинен %@ мөөнөтү өтүп кеткен: жумшала элек акча катары эсептелди."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z planów %@ jest po terminie: kwota jest liczona jako niewydana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos planos, %@ está atrasado: contado como dinheiro ainda não gasto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos planos, %@ está em atraso: conta como dinheiro ainda não gasto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из планов %@ просрочено — считается, что деньги ещё не ушли."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз нақшаҳо муҳлати %@ гузаштааст: ҳамчун пули ҳанӯз харҷнашуда ҳисоб шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlardan %@ gecikmiş: henüz harcanmamış para olarak sayılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З планів %@ прострочено: рахується як гроші, що ще не пішли."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejalardan %@ muddati o‘tgan: hali sarflanmagan mablag‘ sifatida hisoblangan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計畫中有 %@ 已逾期，仍計為尚未支出的金額。"
          }
        }
      }
    },
