    "why.integrity.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilənlər bazası hələ yoxlanılmayıb; yoxlama həftədə bir dəfə aparılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "База даных яшчэ не правяралася; праверка запускаецца раз на тыдзень."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Databáze ještě nebyla zkontrolována. Kontrola probíhá jednou týdně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank wurde noch nicht geprüft; die Prüfung läuft einmal in der Woche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database has not been checked yet; the check runs once a week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos todavía no se ha comprobado; la comprobación se hace una vez por semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base n'a pas encore été vérifiée ; la vérification a lieu une fois par semaine."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների բազան դեռ չի ստուգվել․ ստուգումն իրականացվում է շաբաթը մեկ անգամ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database non è ancora stato controllato; il controllo viene eseguito una volta alla settimana."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ბაზა ჯერ არ შემოწმებულა; შემოწმება კვირაში ერთხელ ტარდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор әлі тексерілмеген; тексеру аптасына бір рет жүреді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат базасы текшериле элек; текшерүү жумасына бир жолу жүргүзүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza danych nie została jeszcze sprawdzona. Sprawdzanie odbywa się raz w tygodniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados ainda não foi verificado; a verificação ocorre uma vez por semana."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A base de dados ainda não foi verificada; a verificação é feita uma vez por semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База ещё не проверялась; проверка идёт раз в неделю."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пойгоҳи додаҳо ҳанӯз санҷида нашудааст; санҷиш ҳафтае як бор анҷом мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanı henüz denetlenmedi; denetim haftada bir yapılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу ще не перевіряли; перевірка йде раз на тиждень."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasi hali tekshirilmagan; tekshiruv haftada bir marta amalga oshiriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未檢查資料庫；每週會檢查一次。"
          }
        }
      }
    },
