          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисобҳои ҳеҷ гоҳ муқоисанашуда дохил нестанд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiç mutabakatı yapılmamış hesaplar dahil değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахунки, які ніколи не звіряли, сюди не входять"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hech qachon solishtirilmagan hisoblar kiritilmagan"
