        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս զույգի համար փոխարժեքներ դեռ չկան. բանկի աղյուսակները չհաջողվեց կարդալ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tasso disponibile per questa coppia: impossibile leggere le tabelle della banca."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ წყვილისთვის კურსები ჯერ არ არის: ბანკის ცხრილების წაკითხვა ვერ მოხერხდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл жұп үшін әзірге бағам жоқ: банктің кестелерін оқу мүмкін болмады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул жуп үчүн азырынча курстар жок: банктын таблицаларын окуу мүмкүн болгон жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursów dla tej pary: nie udało się odczytać tabel banku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há cotações para este par: não foi possível ler as tabelas do banco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há taxas para este par: não foi possível ler as tabelas do banco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсов этой пары пока нет: таблицы ЦБ не прочитались."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ин ҷуфт ҳанӯз қурб нест: ҷадвалҳои бонк хонда нашуданд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parite için henüz kur yok: Bankanın kur tabloları okunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсів для цієї пари ще немає: таблиці банку не вдалося прочитати."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu juftlik uchun kurslar yo‘q: bank jadvallarini o‘qib bo‘lmadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無此貨幣組合的匯率：無法讀取銀行匯率表。"
          }
        }
      }
    },
