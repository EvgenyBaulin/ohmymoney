    "why.income.none": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы паступленняў не было, а іншых даных для разліку няма."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat ist nichts eingegangen, und es gibt nichts, woran man sich halten könnte."
