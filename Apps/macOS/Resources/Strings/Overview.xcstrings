    "why.monthRest.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın qalan məbləği 1-dən 10-dək, siz onu bölüşdürənə və ya imtina edənə qədər təklif olunur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Астатак месяца прапануецца з 1-га да 10-га чысла, пакуль вы яго не размяркуеце або не адхіліце."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbytek měsíce se nabízí od 1. do 10. dne, dokud ho nerozdělíte nebo neodmítnete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rest des Monats wird vom 1. bis zum 10. angeboten, bis Sie ihn verteilen oder ablehnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rest of the month is offered from the 1st to the 10th, until you allocate it or decline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resto del mes se ofrece del 1 al 10, hasta que lo distribuya o lo rechace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reste du mois est proposé du 1er au 10, jusqu'à ce que vous le répartissiez ou le refusiez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա մնացորդն առաջարկվում է 1-ից 10-ը՝ մինչև այն բաշխեք կամ մերժեք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il resto del mese viene proposto dal 1º al 10, finché non lo assegni o lo rifiuti."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვის ნაშთი ხელმისაწვდომია 1-დან 10 რიცხვამდე, მის განაწილებამდე ან მასზე უარის თქმამდე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың қалғаны 1-нен 10-ына дейін ұсынылады, сіз бөлгенше немесе бас тартқанша."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдын калдыгы 1инен 10уна чейин, аны бөлүштүргөнгө же баш тартканга чейин сунушталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostała kwota miesiąca jest oferowana od 1. do 10. dnia, do czasu jej rozdysponowania lub odrzucenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O restante do mês é oferecido do dia 1 ao dia 10, até você distribuí-lo ou recusar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O restante do mês é proposto entre os dias 1 e 10, até o distribuir ou recusar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток месяца предлагается с 1-го по 10-е число, пока вы его не распределили или не отказались."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи моҳ аз 1 то 10 пешниҳод мешавад, то онро тақсим ё рад кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın kalanı, dağıtılana veya reddedilene kadar ayın 1'i ile 10'u arasında sunulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок місяця пропонується з 1-го по 10-те, доки ви його не розподілите або не відмовитеся."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oy qoldig‘i 1-sanadan 10-sanagacha, uni taqsimlamaguningizcha yoki rad etmaguningizcha taklif etiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月 1 日至 10 日會提供本月剩餘金額，直到你分配或略過。"
          }
        }
      }
    },
