    "why.calendar.rounding": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər gün və həftə ayrıca yuvarlaqlaşdırılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумы за кожны дзень і за тыдзень акругляюцца асобна да цэлых адзінак."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Útrata za každý den i za týden se zaokrouhluje samostatně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tag und die Woche werden für sich auf die Einheit gerundet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day and the week are rounded to the unit on their own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día y la semana se redondean por separado a la unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour et la semaine sont arrondis à l'unité séparément."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր օրվա և շաբաթվա գումարները կլորացվում են առանձին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno e la settimana sono arrotondati all’unità separatamente."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული დღის და კვირის ჯამი ცალ-ცალკე მრგვალდება მთელ ერთეულამდე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр күн мен апта бірлікке өз бетінше дөңгелектенеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир күндүн жана жуманын суммасы өзүнчө бүтүнгө тегеректелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwoty dla każdego dnia i tygodnia są zaokrąglane osobno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia e a semana são arredondados separadamente para a unidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia e a semana são arredondados à unidade separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый день и неделя округляются до целых отдельно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ҳар рӯз ва ҳафта алоҳида яклухт карда мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün ve hafta toplamı ayrı ayrı birime yuvarlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен день і тиждень округлюються до одиниці окремо."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir kun va hafta summasi alohida yaxlitlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每日和每週金額分別四捨五入至整數。"
          }
        }
      }
    },
