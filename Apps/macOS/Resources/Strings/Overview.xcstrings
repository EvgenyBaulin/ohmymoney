    "calendar.legend.level": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колер дня: выдаткі вышэйшыя за звычайныя; светлы — крыху, цёмны — значна"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagesfüllung: Ausgaben über dem Üblichen; heller heißt wenig, dunkler heißt viel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day fill: spending above usual, lighter is a little, deeper is much"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore del giorno: spesa superiore al solito; più chiaro indica poco, più scuro indica molto"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күн түсі: әдеттегіден көп шығыс, ашығырағы — аз, қоюырағы — көп"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заливка дня — траты выше обычного: светлая — немного, насыщенная — намного"
          }
        }
      }
    },
