    "why.income.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay gəlir olmayıb və əsas götürüləcək məlumat yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы паступленняў не было, а іншых даных для разліку няма."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento měsíc zatím nic nepřišlo a není z čeho vycházet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat ist nichts eingegangen, und es gibt nichts, woran man sich halten könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing came this month and there is nothing to go by."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mes no llegó nada y no hay en qué basarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est entré ce mois-ci et il n'y a rien pour s'appuyer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս եկամուտ չի ստացվել, և գնահատելու տվյալներ չկան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna entrata questo mese e nessun dato su cui basarsi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში შემოსავალი არ ყოფილა და შეფასებისთვის მონაცემები არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда ештеңе түспеді, сүйенетін нәрсе жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда киреше болгон жок жана эсептөөгө негиз жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu nie wpłynęły żadne środki i brak podstaw do szacunku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi recebido neste mês e não há dados para estimar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não recebeu nada este mês e não há dados de referência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце ничего не пришло, и опереться не на что."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин моҳ даромад набуд ва маълумоте барои ҳисоб нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay gelir gelmedi ve tahmin için yeterli veri yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього місяця нічого не надійшло, і спертися не на що."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy daromad kelmadi va hisoblash uchun ma’lumot yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月尚未收到收入，也沒有可供估算的資料。"
          }
        }
      }
    },
