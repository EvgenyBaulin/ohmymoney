    "why.selfEmployed.deductionUnknown": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qalan güzəşt göstərilməyib: onsuz hesablanıb."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэшта выліку не ўказана: разлік без яе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývající odpočet není uveden. Výpočet je bez něj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verbleibende Abzug ist nicht angegeben: ohne ihn berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deduction left is not said: counted without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se indica la deducción pendiente: se cuenta sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déduction restante n'est pas précisée : calculé sans elle."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մնացած նվազեցումը նշված չէ․ հաշվարկվել է առանց դրա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Detrazione residua non indicata: calcolo senza detrazione."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დარჩენილი შეღავათი მითითებული არ არის: დათვლილია მის გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалған шегерім айтылмаған: онсыз есептелді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Калган чегерүү көрсөтүлгөн эмес: ансыз эсептелди."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie podano pozostałego odliczenia. Obliczono bez niego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedução restante não foi informada. O cálculo não a inclui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedução restante não está indicada: cálculo sem dedução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток вычета не указан: считается без него."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имтиёзи боқимонда маълум нест: бе он ҳисоб шуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan indirim belirtilmedi; hesaplamaya dahil edilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок вирахування не вказано: враховано без нього."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qolgan chegirma ko‘rsatilmagan: hisobga olinmadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未提供剩餘扣抵額，計算時不予扣抵。"
          }
        }
      }
    },
