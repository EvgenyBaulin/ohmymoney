        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora conteggiato denaro nei conti del riepilogo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯამების ანგარიშებზე თანხა ჯერ არ აღირიცხება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындының есеп-шоттарында әлі санаған ақша жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалпы эсептеги эсептерде азырынча акча жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uwzględniono jeszcze środków na kontach w podsumowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há valores contabilizados nas contas do resumo."
          }
