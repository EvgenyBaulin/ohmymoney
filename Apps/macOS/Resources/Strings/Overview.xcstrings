          "stringUnit": {
            "state": "translated",
            "value": "Tax for %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог за %@"
          }
        }
      }
    },
    "why.selfEmployed.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-employment is off"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самозанятость выключена"
          }
        }
      }
    },
    "why.selfEmployed.rates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates: 4 % from individuals, 6 % from organisations; the deduction makes them 3 % and 4 %."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки: 4 % с физлиц, 6 % с организаций; вычет делает их 3 % и 4 %."
          }
        }
      }
    },
    "why.selfEmployed.rounding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rounding and carry"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Округление и перенос"
          }
        }
      }
    },
    "why.selfEmployed.taxBefore": {
      "extractionState": "manual",
      "localizations": {
