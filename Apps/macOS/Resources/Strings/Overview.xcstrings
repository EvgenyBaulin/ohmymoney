    "why.grew.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ötən ayın eyni günləri ilə müqayisədə heç bir kateqoriya artmayıb."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніводная катэгорыя не вырасла ў параўнанні з тымі ж днямі мінулага месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná kategorie nevzrostla oproti stejným dnům minulého měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kategorie ist gegenüber denselben Tagen des letzten Monats gewachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No category has grown against the same days of last month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna categoría ha subido frente a los mismos días del mes pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune catégorie n'a augmenté par rapport aux mêmes jours du mois dernier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անցած ամսվա նույն օրերի համեմատ ոչ մի կատեգորիա չի աճել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna categoria è aumentata rispetto agli stessi giorni del mese scorso."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გასული თვის იმავე დღეებთან შედარებით არც ერთი კატეგორია არ გაზრდილა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ешбір санат өткен айдың дәл сол күндерімен салыстырғанда өспеген."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөн айдын ушул күндөрүнө салыштырмалуу эч бир категория өскөн жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatki w żadnej kategorii nie wzrosły względem tych samych dni ubiegłego miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma categoria cresceu em relação aos mesmos dias do mês passado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma categoria aumentou face aos mesmos dias do mês passado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна категория не выросла к тем же дням прошлого месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар муқоиса бо ҳамин рӯзҳои моҳи гузашта ягон категория афзоиш наёфтааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen ayın aynı günlerine göre artan kategori yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодна категорія не зросла порівняно з тими самими днями минулого місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan oyning shu kunlariga nisbatan hech bir turkum o‘smagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與上個月同期相比，沒有類別增加。"
          }
        }
      }
    },
