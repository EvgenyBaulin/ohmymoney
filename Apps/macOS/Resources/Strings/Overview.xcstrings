    "why.savings.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даходу за гэты месяц яшчэ няма, таму долю вылічыць нельга."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat gibt es noch keine Einnahmen, daher gibt es keinen Anteil zu zählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no income this month yet, so there is no share to count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ingresos este mes, así que no hay parte que contar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de revenu ce mois-ci, donc pas de part à calculer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora entrate questo mese, quindi non è possibile calcolare la percentuale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда әлі табыс жоқ, сондықтан санайтын үлес жоқ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu nie ma jeszcze dochodu, więc nie można obliczyć udziału."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохода в этом месяце ещё нет, доли считать не от чего."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay henüz gelir yok, bu yüzden oran hesaplanamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходу цього місяця ще немає, тож частку рахувати нема з чого."
          }
        }
      }
    },
