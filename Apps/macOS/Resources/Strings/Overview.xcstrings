    "overview.goalsExceed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məqsəd üçün ayrılan pulu xərcləmisiniz? «Çıxar» düyməsinə basın"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Патрацілі грошы з мэты? Націсніце «Зняць»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Utratili jste peníze z cíle? Klepněte na «Vybrat»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld eines Ziels ausgegeben? Drücken Sie „Abheben“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spent a goal's money? Press «Withdraw»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Gastó dinero de un objetivo? Pulse «Retirar»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez dépensé l'argent d'un objectif ? Appuyez sur « Retirer »"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծախսե՞լ եք նպատակի գումարը։ Սեղմեք «Հանել»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai speso i soldi di un obiettivo? Premi «Preleva»"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიზნისთვის გადადებული თანხა დახარჯეთ? დააჭირეთ «გამოტანას»"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсат ақшасын жұмсадыңыз ба? «Алу» басыңыз"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Максаттагы акчаны сарптадыңызбы? «Алып чыгуу» баскычын басыңыз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydano środki z celu? Wybierz «Wypłać»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastou o dinheiro de uma meta? Toque em «Retirar»"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastou dinheiro de um objetivo? Toque em «Levantar»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потратили деньги цели? Нажмите «Забрать»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ҳадафро сарф кардед? «Бозпас гирифтан»-ро пахш кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hedefin parasını mı harcadınız? «Çek» düğmesine basın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витратили гроші цілі? Натисніть «Зняти»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maqsad uchun yig‘ilgan pulni sarfladingizmi? «Yechib olish»ni bosing"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "花掉目標的錢了？請按「提領」"
          }
        }
      }
    },
    "overview.goalsExceedDetail": {
      "extractionState": "manual",
      "localizations": {
        "az": {
