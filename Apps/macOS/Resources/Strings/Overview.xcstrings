    "why.look.goals": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məqsədlərdə %1$@, xülasədəki hesablarda %2$@ var: məqsəd pulu xərclənmiş görünür"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У мэтах — %1$@, на рахунках зводкі — %2$@: грошы мэт выглядаюць выдаткаванымі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V cílech je %1$@, na účtech v přehledu %2$@: peníze na cíle jsou zřejmě utraceny"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziele halten %1$@, die Konten der Übersicht %2$@: Das Zielgeld scheint ausgegeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goals hold %1$@, the accounts of the summary %2$@: goal money seems spent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetivos tienen %1$@, las cuentas del resumen %2$@: el dinero de los objetivos parece gastado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objectifs contiennent %1$@, les comptes du récapitulatif %2$@ : l'argent des objectifs semble dépensé"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նպատակներում՝ %1$@, ամփոփման հաշիվներում՝ %2$@․ նպատակների գումարը կարծես ծախսվել է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli obiettivi contengono %1$@, i conti nel riepilogo %2$@: il denaro degli obiettivi sembra già speso"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიზნებშია %1$@, მიმოხილვის ანგარიშებზე — %2$@: მიზნების თანხა, როგორც ჩანს, დახარჯულია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсаттарда %1$@, қорытындыдағы есеп-шоттарда %2$@: мақсат ақшасы жұмсалған сияқты"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Максаттарда %1$@, жыйынтыктагы эсептерде %2$@: максаттардын акчасы сарпталган окшойт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na cele odłożono %1$@, a na kontach w podsumowaniu jest %2$@: środki na cele mogły zostać wydane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As metas têm %1$@ e as contas do resumo têm %2$@: o dinheiro das metas parece ter sido gasto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os objetivos contêm %1$@, as contas do resumo %2$@: o dinheiro dos objetivos parece ter sido gasto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На целях %1$@, на счетах в сводке %2$@ — похоже, деньги целей потрачены"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҳадафҳо %1$@, дар ҳисобҳои ҷамъбаст %2$@: ба назар мерасад, пули ҳадафҳо харҷ шудааст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedeflerde %1$@, özetteki hesaplarda %2$@ var: hedeflerdeki para harcanmış görünüyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цілях %1$@, на рахунках підсумку %2$@: здається, гроші цілі витрачено"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maqsadlarda %1$@, umumiy hisobdagi mablag‘ %2$@: maqsadlar uchun ajratilgan pul sarflanganga o‘xshaydi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標儲蓄為 %1$@，摘要中的帳戶餘額為 %2$@：目標資金似乎已被使用"
          }
        }
      }
    },
