    },
    "why.savings.goals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contributions to goals"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aportaciones a objetivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contributions aux objectifs"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взносы в цели"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Внески в цілі"
          }
        }
      }
    },
    "why.savings.income": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income of the month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresos del mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenus du mois"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход месяца"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід за місяць"
          }
        }
      }
    },
    "why.savings.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no income this month yet, so there is no share to count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ingresos este mes, así que no hay parte que contar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de revenu ce mois-ci, donc pas de part à calculer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохода в этом месяце ещё нет, доли считать не от чего."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходу цього місяця ще немає, тож частку рахувати нема з чого."
          }
        }
      }
    },
    "why.savings.rate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share of the income"
