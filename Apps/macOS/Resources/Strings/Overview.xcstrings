    "overview.small.field.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Цэлыя рублі. Плітка «Дробныя пакупкі» ў аглядзе сумуе пакупкі за месяц да гэтай сумы. Пустое поле — не зададзена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Rubel. Die Kachel „Kleine Käufe“ in der Übersicht addiert die Käufe des Monats bis zu dieser Summe. Leer — nicht festgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole rubles. The tile «Small purchases» on Overview adds up the purchases of the month up to this sum. Empty — not set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rublos enteros. El mosaico «Compras pequeñas» del resumen suma las compras del mes hasta esta cantidad. Vacío — sin fijar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Roubles entiers. La tuile « Petits achats » de l'Aperçu additionne les achats du mois jusqu'à cette somme. Vide — non réglé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubli interi. Il riquadro «Piccoli acquisti» in Panoramica somma gli acquisti del mese fino a questo importo. Vuoto: non impostato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүтін рубльмен. Шолудағы «Майда сатып алулар» тақтайшасы осы сомаға дейінгі айдың сатып алуларын қосады. Бос — орнатылмаған."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełne ruble. Kafelek «Drobne zakupy» w Przeglądzie sumuje zakupy z tego miesiąca do tej kwoty. Puste pole oznacza brak ustawienia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целых рублях. Плитка «Мелкие покупки» на обзоре складывает покупки месяца до этой суммы. Пусто — не задано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ruble olarak girin. Genel Bakış'taki «Küçük alışverişler» kutucuğu, ay içinde bu tutara kadar olan alışverişleri toplar. Boş bırakılırsa ayarlanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цілі рублі. Плитка «Дрібні покупки» на «Огляді» додає покупки місяця до цієї суми. Порожньо — не задано."
          }
        }
      }
    },
