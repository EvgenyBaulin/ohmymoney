    "why.calendar.lowData": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова даных, каб вызначыць звычайныя выдаткі за дзень."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Verlauf, um zu sagen, was ein üblicher Tag ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too little history to say what a usual day is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial insuficiente para saber qué es un día habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique trop court pour dire ce qu'est un jour habituel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati insufficienti per stimare una giornata tipo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі күнді айту үшін тарих аз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych, aby określić typowy dzień."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истории мало, чтобы сказать, какой день обычный."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olağan bir günü belirlemek için yeterli geçmiş yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замало історії, щоб сказати, що таке звичайний день."
          }
        }
      }
    },
