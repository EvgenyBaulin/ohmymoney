    "currencyChart.noRates": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cüt üçün hələ məzənnə yoxdur: bankın cədvəllərini oxumaq mümkün olmadı."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсаў для гэтай пары пакуль няма: не ўдалося прачытаць табліцы банка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento pár zatím nejsou kurzy: tabulky banky se nepodařilo načíst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Paar gibt es noch keine Kurse: Die Tabellen der Bank konnten nicht gelesen werden."
