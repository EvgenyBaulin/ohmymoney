    "look.bank.cardAttached": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bununla ödənilir: %1$@ — onları yenidən bağlayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аплочваюцца ёй: %1$@ — прывяжыце іншую картку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí se jí: %1$@ — změňte platební kartu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit bezahlt: %1$@ — ordnen Sie sie neu zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid with it: %1$@ — rebind them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se paga con ella: %1$@ — reasígnelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payé avec elle : %1$@ — rattachez-les."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դրանով վճարվել է՝ %1$@։ Վերակապեք դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagati con questa carta: %1$@ — ricollegali."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ბარათით იხდით: %1$@ — მიაბით სხვა ბარათი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Онымен төленеді: %1$@ — оларды қайта байлаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул карта менен төлөнөт: %1$@ — аларды башка картага байлаңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatności tą kartą: %1$@ — zmień metodę płatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagos com ele: %1$@ — atualize a forma de pagamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamentos associados: %1$@ — volte a associá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежей и подписок по ней: %1$@ — перепривяжите."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бо ин корт пардохт мешуд: %1$@ — онҳоро аз нав пайваст кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kartla ödenenler: %1$@ — bağlantılarını değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ними сплачується: %1$@ — перепризначте їх."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "U bilan to‘lanadi: %1$@ — ularni qayta bog‘lang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此卡付款的項目：%1$@，請重新綁定。"
          }
        }
      }
    },
