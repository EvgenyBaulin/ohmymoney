    "calendar.lowData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too little data to tell a usual day: it takes 14 days with spending in the last 90"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocos datos para saber qué es un día habitual: hacen falta 14 días con gasto en los últimos 90"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de données pour définir un jour habituel : il faut 14 jours avec dépenses sur les 90 derniers"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных, чтобы понять, какой день обычный: нужно 14 дней с тратами за 90 дней"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замало даних, щоб визначити звичайний день: потрібно 14 днів із витратами за останні 90"
          }
        }
      }
    },
