    "overview.archivedMoney": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» arxivləşdirilib, amma hesabda %2$@ var — başqa hesaba köçürülsün?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» у архіве, але на ім ёсць %2$@ — перавесці на іншы рахунак?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» je archivovaný účet, ale zbývá na něm %2$@. Přesunout na jiný účet?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist archiviert, hält aber %2$@ — auf ein anderes Konto verschieben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» is archived but holds %2$@ — move it to another account?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está archivada pero tiene %2$@ — ¿pasar el dinero a otra cuenta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est aux archives mais contient %2$@ — le transférer sur un autre compte ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» արխիվացված է, բայց ունի %2$@։ Տեղափոխե՞լ այլ հաշիվ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è archiviato ma contiene %2$@. Vuoi trasferirli su un altro conto?"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» დაარქივებულია, მაგრამ მასზე %2$@ არის — გადაიტანოთ სხვა ანგარიშზე?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» мұрағатта, бірақ онда %2$@ бар — басқа есеп-шотқа көшірейік пе?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» архивде, бирок анда %2$@ бар — башка эсепке которосузбу?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» jest w archiwum, ale zawiera %2$@ — przenieść na inne konto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está arquivada, mas tem %2$@ — transferir para outra conta?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está arquivada, mas tem %2$@ — mover para outra conta?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На «%1$@» в архиве %2$@ — перевести на другой счёт?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» бойгонӣ шудааст, вале дар он %2$@ ҳаст — ба ҳисоби дигар гузаронед?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» arşivlendi ancak içinde %2$@ var — başka bir hesaba aktarılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» в архіві, але на ньому %2$@ — перенести на інший рахунок?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» arxivlangan, ammo unda %2$@ bor — boshqa hisobga o‘tkazilsinmi?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» 已封存，但仍有 %2$@ — 要轉至其他帳戶嗎？"
          }
        }
      }
    },
