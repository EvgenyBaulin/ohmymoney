    "why.selfEmployed.rates": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стаўкі: 4 % ад фізічных асоб, 6 % ад арганізацый; з вылікам — 3 % і 4 %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze: 4 % von Privatpersonen, 6 % von Organisationen; der Abzug macht sie 3 % und 4 %."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates: 4 % from individuals, 6 % from organisations; the deduction makes them 3 % and 4 %."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasas: 4 % a particulares, 6 % a organizaciones; la deducción las deja en 3 % y 4 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux : 4 % auprès de particuliers, 6 % auprès d'organisations ; la déduction les ramène à 3 % et 4 %."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aliquote: 4 % da privati, 6 % da organizzazioni; con la detrazione scendono al 3 % e al 4 %."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөлшерлемелер: жеке тұлғалардан 4 %, ұйымдардан 6 %; шегерім оларды 3 % және 4 %-ға жеткізеді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stawki: 4 % od osób fizycznych, 6 % od organizacji. Po odliczeniu wynoszą 3 % i 4 %."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки: 4 % с физлиц, 6 % с организаций; вычет делает их 3 % и 4 %."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oranlar: Bireylerden % 4, kuruluşlardan % 6; indirimle sırasıyla % 3 ve % 4."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки: 4 % від фізичних осіб, 6 % від організацій; вирахування робить їх 3 % і 4 %."
          }
        }
      }
    },
