        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app ainda não tem câmbios de moedas estrangeiras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В приложении пока нет курса иностранной валюты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар барнома ҳанӯз қурби асъори хориҷӣ нест."
          }
        },
