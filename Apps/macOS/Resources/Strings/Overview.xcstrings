    "why.savings.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даходу за гэты месяц яшчэ няма, таму долю вылічыць нельга."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat gibt es noch keine Einnahmen, daher gibt es keinen Anteil zu zählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no income this month yet, so there is no share to count."
          }
        },
        "it": {
