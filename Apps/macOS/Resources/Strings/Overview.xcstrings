    "overview.backups.stale": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gündən köhnədir — yeni nüsxə yaratmaq vaxtıdır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "старэйшая за %@ дзён — час стварыць новую"
          }
