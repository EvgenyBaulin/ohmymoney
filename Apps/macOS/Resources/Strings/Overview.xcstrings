    "why.free.noReconciliation": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk tutuşdurmanı edin: hesablanmış qalıq olmadan sərbəst məbləğ yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правядзіце першую зверку: без праверанага астатку свабодную суму не вызначыць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proveďte první kontrolu zůstatku. Bez ní nelze určit volnou částku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie den ersten Abgleich: Ohne gezählten Saldo gibt es keinen freien Betrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the first reconciliation: without a counted balance there is no free sum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga la primera conciliación: sin un saldo contado no hay suma libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites le premier rapprochement : sans solde compté, il n'y a pas de somme libre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կատարեք առաջին համադրումը․ առանց հաշվարկված մնացորդի ազատ գումար չկա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effettua la prima riconciliazione: senza un saldo verificato non è possibile calcolare la somma disponibile."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პირველად შეაჯერეთ ბალანსი: დათვლილი ბალანსის გარეშე თავისუფალი თანხა არ გამოჩნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алғашқы салыстыруды жасаңыз: санаған теңгерімсіз бос қаржы жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Биринчи салыштырууну жасаңыз: калдык эсептелмейинче, бош сумма жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzgodnij saldo po raz pierwszy: bez tego nie można obliczyć dostępnej kwoty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça a primeira conciliação: sem um saldo conferido, não há valor disponível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça a primeira reconciliação: sem um saldo contabilizado, não há valor disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте первую сверку: без сверенного остатка свободной суммы нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аввал бақияро санҷед: бе бақияи санҷидашуда маблағи озод муайян намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk hesap mutabakatını yapın: sayılmış bakiye olmadan kullanılabilir tutar hesaplanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробіть першу звірку: без порахованого залишку вільної суми немає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval qoldiqni tekshiring: hisoblangan qoldiqsiz erkin mablag‘ni aniqlab bo‘lmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先核對餘額：尚未核對餘額，無法計算可用金額。"
          }
        }
      }
    },
