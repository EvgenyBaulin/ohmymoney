          "stringUnit": {
            "state": "translated",
            "value": "Certains plans sont dans une devise sans taux : exclus de la somme"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որոշ ապառիկների արժույթի փոխարժեքը չկա․ դրանք գումարում ներառված չեն"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni piani sono in una valuta senza tasso di cambio e sono esclusi dal totale"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზოგი განვადების ვალუტას კურსი არ აქვს და ჯამში არ შედის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбір жоспарлар бағамы жоқ валютада: сомаға кірмеді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айрым бөлүп төлөөлөр курс көрсөтүлбөгөн валютада: суммага кошулган жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre plany są w walucie bez kursu i nie zostały uwzględnione w sumie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns parcelamentos estão em uma moeda sem cotação e ficaram fora da soma"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns planos estão numa moeda sem taxa de câmbio e foram excluídos do total"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть рассрочек — в валюте без курса: в сумму не вошла"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баъзе нақшаҳо бо асъори бе қурбанд: ба маблағи умумӣ дохил нашуданд"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı planların para birimi için kur yok: toplama dahil edilmedi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі плани в валюті без курсу: не входять до суми"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrim rejalar kursi mavjud bo‘lmagan valyutada: ular summaga kiritilmagan"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分分期使用沒有匯率的貨幣，未計入總額"
          }
        }
      }
    },
