    "why.noRate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для некаторых сум няма курсу на сёння, таму яны не ўлічаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Beträge haben heute keinen Kurs und bleiben weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some amounts have no rate today and are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos importes no tienen tipo hoy y se dejan fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains montants n'ont pas de taux aujourd'hui et sont laissés de côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni importi non hanno un tasso di cambio per oggi e sono esclusi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбір сомалардың бүгін бағамы жоқ және олар шығарылды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre kwoty pominięto z powodu braku dzisiejszego kursu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У части сумм нет курса на сегодня — они не учтены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı tutarların bugün için kuru yok ve hesaba katılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі суми сьогодні без курсу і не враховуються."
          }
        }
      }
    },
