    "why.income.none": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы паступленняў не было, а іншых даных для разліку няма."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat ist nichts eingegangen, und es gibt nichts, woran man sich halten könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing came this month and there is nothing to go by."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mes no llegó nada y no hay en qué basarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est entré ce mois-ci et il n'y a rien pour s'appuyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna entrata questo mese e nessun dato su cui basarsi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда ештеңе түспеді, сүйенетін нәрсе жоқ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu nie wpłynęły żadne środki i brak podstaw do szacunku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце ничего не пришло, и опереться не на что."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay gelir gelmedi ve tahmin için yeterli veri yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього місяця нічого не надійшло, і спертися не на що."
          }
        }
      }
    },
