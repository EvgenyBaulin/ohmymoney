    "overview.small.field.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam rublla. İcmaldakı «Kiçik alışlar» bölməsi ay ərzində bu məbləğədək olan alışları toplayır. Boşdursa, təyin edilməyib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Цэлыя рублі. Плітка «Дробныя пакупкі» ў аглядзе сумуе пакупкі за месяц да гэтай сумы. Пустое поле — не зададзена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celé rubly. Dlaždice «Drobné nákupy» v přehledu sčítá nákupy za měsíc do této částky. Prázdné pole znamená, že limit není nastaven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Rubel. Die Kachel „Kleine Käufe“ in der Übersicht addiert die Käufe des Monats bis zu dieser Summe. Leer — nicht festgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole rubles. The tile «Small purchases» on Overview adds up the purchases of the month up to this sum. Empty — not set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rublos enteros. El mosaico «Compras pequeñas» del resumen suma las compras del mes hasta esta cantidad. Vacío — sin fijar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Roubles entiers. La tuile « Petits achats » de l'Aperçu additionne les achats du mois jusqu'à cette somme. Vide — non réglé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամբողջ ռուբլիներով։ «Ամփոփում» բաժնի «Փոքր գնումներ» սալիկն ամփոփում է ամսվա՝ այս գումարը չգերազանցող գնումները։ Դատարկ՝ սահմանված չէ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubli interi. Il riquadro «Piccoli acquisti» in Panoramica somma gli acquisti del mese fino a questo importo. Vuoto: non impostato."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთელი რუბლები. მიმოხილვის ფილა «მცირე შენაძენები» აჯამებს თვის შენაძენებს ამ თანხამდე. ცარიელი — არ არის დაყენებული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүтін рубльмен. Шолудағы «Майда сатып алулар» тақтайшасы осы сомаға дейінгі айдың сатып алуларын қосады. Бос — орнатылмаған."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүтүн рубль менен. «Обзор» бөлүмүндөгү «Майда сатып алуулар» бул суммага чейинки айлык сатып алууларды кошот. Бош болсо — белгиленген эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełne ruble. Kafelek «Drobne zakupy» w Przeglądzie sumuje zakupy z tego miesiąca do tej kwoty. Puste pole oznacza brak ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rublos inteiros. O bloco «Compras pequenas» na Visão Geral soma as compras do mês até esse valor. Em branco: não definido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rublos inteiros. O cartão «Compras pequenas» na Vista geral soma as compras do mês até este valor. Em branco — não definido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целых рублях. Плитка «Мелкие покупки» на обзоре складывает покупки месяца до этой суммы. Пусто — не задано."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубли бутун. Лавҳаи «Харидҳои хурд» дар Шарҳ харидҳои моҳи то ин маблағро ҷамъ мекунад. Холигоҳ — муқаррар нашудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ruble olarak girin. Genel Bakış'taki «Küçük alışverişler» kutucuğu, ay içinde bu tutara kadar olan alışverişleri toplar. Boş bırakılırsa ayarlanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цілі рублі. Плитка «Дрібні покупки» на «Огляді» додає покупки місяця до цієї суми. Порожньо — не задано."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Butun rublda. Umumiy ko‘rinishdagi «Kichik xaridlar» kartasi oy davomida shu summagacha bo‘lgan xaridlarni jamlaydi. Bo‘sh — belgilanmagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以整數盧布計算。「總覽」中的「小額消費」會加總本月不超過此金額的消費。留空表示未設定。"
          }
        }
      }
    },
