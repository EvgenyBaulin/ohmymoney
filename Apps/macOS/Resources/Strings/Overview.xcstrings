            "state": "translated",
            "value": "Միայն ստացվածը․ այլ եկամուտ չի սպասվում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quanto ricevuto: non sono previste altre entrate"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ მიღებული თანხა: მეტი მოსალოდნელი არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек келгені: басқасы күтілмейді"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Алынганы гана: мындан ары киреше күтүлбөйт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko otrzymane wpływy: nie oczekujesz kolejnych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o que entrou: nada mais previsto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o recebido: não se espera mais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только полученное: больше ничего не ждём"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо маблағи гирифташуда: дигар чизе интизор нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca alınan gelir: başka gelir beklenmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише те, що надійшло: більше нічого не очікується"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat olingan daromad: boshqa daromad kutilmayapti"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅計入已入帳金額：沒有其他預期收入"
          }
        }
      }
    },
