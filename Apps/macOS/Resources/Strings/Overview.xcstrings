    "why.noRate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəzi məbləğlərin bugünkü məzənnəsi yoxdur və nəzərə alınmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для некаторых сум няма курсу на сёння, таму яны не ўлічаны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé částky nemají dnešní kurz a nejsou zahrnuty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Beträge haben heute keinen Kurs und bleiben weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some amounts have no rate today and are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos importes no tienen tipo hoy y se dejan fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains montants n'ont pas de taux aujourd'hui et sont laissés de côté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որոշ գումարների համար այսօրվա փոխարժեք չկա, ուստի դրանք ներառված չեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni importi non hanno un tasso di cambio per oggi e sono esclusi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზოგი თანხის დღევანდელი კურსი არ არის და ისინი არ შედის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбір сомалардың бүгін бағамы жоқ және олар шығарылды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айрым суммалардын бүгүнкү курсу жок болгондуктан, эсепке алынган жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre kwoty pominięto z powodu braku dzisiejszego kursu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns valores não têm cotação hoje e ficaram de fora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns valores não têm câmbio para hoje e foram excluídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У части сумм нет курса на сегодня — они не учтены."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баъзе маблағҳо қурби имрӯз надоранд ва ба ҳисоб дохил нашудаанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı tutarların bugün için kuru yok ve hesaba katılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі суми сьогодні без курсу і не враховуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrim summalar uchun bugungi kurs yo‘q, ular hisobga olinmagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分金額沒有今日匯率，未計入。"
          }
        }
      }
    },
