    "overview.archivedMoney": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» у архіве, але на ім ёсць %2$@ — перавесці на іншы рахунак?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist archiviert, hält aber %2$@ — auf ein anderes Konto verschieben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» is archived but holds %2$@ — move it to another account?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está archivada pero tiene %2$@ — ¿pasar el dinero a otra cuenta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est aux archives mais contient %2$@ — le transférer sur un autre compte ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è archiviato ma contiene %2$@. Vuoi trasferirli su un altro conto?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» мұрағатта, бірақ онда %2$@ бар — басқа есеп-шотқа көшірейік пе?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» jest w archiwum, ale zawiera %2$@ — przenieść na inne konto?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На «%1$@» в архиве %2$@ — перевести на другой счёт?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» arşivlendi ancak içinde %2$@ var — başka bir hesaba aktarılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» в архіві, але на ньому %2$@ — перенести на інший рахунок?"
          }
        }
      }
    },
