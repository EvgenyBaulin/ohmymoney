    "look.cardOverLimit": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ limitini %2$@ aşıb. Ən azı bu məbləği ödəyin: bank komissiya tuta bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ліміт перавышаны на %2$@. Унясіце не менш за гэтую суму: банк можа спагнаць камісію."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ překračuje limit o %2$@. Splaťte alespoň tuto částku, banka může účtovat poplatek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist um %2$@ über dem Limit. Zahlen Sie mindestens diesen Betrag ein: Die Bank kann eine Gebühr berechnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is over its limit by %2$@. Pay in at least that much: the bank may charge a fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ supera su límite en %2$@. Pague al menos esa cantidad: el banco puede cobrar una comisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dépasse son plafond de %2$@. Versez au moins cette somme : la banque peut facturer des frais."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ի սահմանաչափը գերազանցվել է %2$@-ով։ Մուտքագրեք առնվազն այդքան. բանկը կարող է միջնորդավճար գանձել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ supera il limite di %2$@. Versa almeno questa somma: la banca potrebbe applicare una commissione."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ლიმიტს %2$@-ით აღემატება. შეიტანეთ სულ მცირე ეს თანხა: ბანკმა შეიძლება საკომისიო ჩამოგაჭრათ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ лимитінен %2$@ асып кетті. Кем дегенде сонша салыңыз: банк комиссия алуы мүмкін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ боюнча чектен %2$@ ашты. Кеминде ушул сумманы төлөңүз: банк комиссия алышы мүмкүн."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: przekroczono limit o %2$@. Wpłać co najmniej tę kwotę — bank może naliczyć opłatę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está %2$@ acima do limite. Pague pelo menos esse valor: o banco pode cobrar uma tarifa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ultrapassou o limite em %2$@. Pague pelo menos esse valor: o banco pode cobrar uma comissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: выше лимита на %2$@. Внесите не меньше: возможна комиссия банка."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ аз ҳадди худ %2$@ зиёд аст. Ҳадди ақал ҳамин маблағро пардохт кунед: бонк метавонад ҳаққи хидмат гирад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ limitini %2$@ aştı. En az bu tutarı ödeyin: Banka ücret alabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ понад ліміт на %2$@. Внесіть щонайменше цю суму: банк може взяти комісію."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ limiti %2$@ ga oshgan. Kamida shu summani kiriting: bank komissiya olishi mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已超出額度 %2$@。請至少繳入此金額，銀行可能會收取手續費。"
          }
        }
      }
    },
