    },
    "why.balance.leftOut": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Некаторыя балансы не ўлічваюцца або не маюць курсу і выключаны з разліку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Salden sind nicht gezählt oder haben keinen Kurs und bleiben weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some balances are not counted or have no rate and are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos saldos no se cuentan o no tienen tipo y se dejan fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains soldes ne sont pas comptés ou n'ont pas de taux et sont laissés de côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni saldi non vengono conteggiati o non hanno un tasso di cambio e sono esclusi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбір теңгерімдер санаған жоқ немесе бағамы жоқ, сондықтан шығарылды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre salda pominięto, ponieważ nie są uwzględniane lub nie mają kursu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть остатков не сверена или без курса — они не учтены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı bakiyeler sayılmadığı veya kuru olmadığı için dahil edilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі залишки не враховано або для них немає курсу — вони не входять до суми."
          }
        }
      }
    },
    "why.balance.none": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніводзін баланс у зводцы пакуль не ўлічваецца: няма даных для прагнозу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Saldo der Übersicht ist gezählt: Es gibt nichts, woraus man prognostizieren könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No balance of the summary is counted yet: there is nothing to forecast from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se cuenta ningún saldo del resumen: no hay de qué hacer previsión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun solde du récapitulatif n'est encore compté : il n'y a rien à prévoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun saldo del riepilogo è ancora conteggiato: non ci sono dati per la previsione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындының бірде-бір теңгерімі әлі санаған жоқ: болжау жасайтын ештеңе жоқ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne saldo nie jest jeszcze uwzględniane w podsumowaniu. Nie można utworzyć prognozy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один остаток счетов в сводке ещё не сверен — прогнозировать не от чего."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özette henüz sayılan bakiye yok. Tahmin yapılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден залишок підсумку ще не враховано: прогнозувати нема з чого."
          }
        }
      }
    },
