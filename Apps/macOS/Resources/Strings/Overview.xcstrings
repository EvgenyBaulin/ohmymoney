    "overview.noRecent": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son iki ayda əməliyyat olmayıb. Bütün tarixçə Əməliyyatlar pəncərəsindədir (⇧⌘T)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "За апошнія два месяцы аперацый не было. Уся гісторыя — у акне «Аперацыі» (⇧⌘T)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za poslední dva měsíce žádné operace. Celá historie je v okně Transakce (⇧⌘T)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Vorgänge in den letzten zwei Monaten. Der ganze Verlauf steht im Fenster „Vorgänge“ (⇧⌘T)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No operations in the last two months. The whole history is in the Transactions window (⇧⌘T)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay operaciones en los últimos dos meses. Todo el historial está en la ventana de Operaciones (⇧⌘T)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune opération ces deux derniers mois. Tout l'historique est dans la fenêtre Opérations (⇧⌘T)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին երկու ամիսներին գործառնություններ չեն եղել։ Ամբողջ պատմությունը՝ «Գործառնություններ» պատուհանում (⇧⌘T)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna operazione negli ultimi due mesi. Trovi tutta la cronologia nella finestra Transazioni (⇧⌘T)."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო ორ თვეში ოპერაციები არ არის. სრული ისტორია იხილეთ ტრანზაქციების ფანჯარაში (⇧⌘T)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы екі айда операция жоқ. Бүкіл тарих «Операциялар» терезесінде (⇧⌘T)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы эки айда операциялар жок. Толук тарых «Операциялар» терезесинде (⇧⌘T)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak operacji w ostatnich dwóch miesiącach. Cała historia znajduje się w oknie Transakcje (⇧⌘T)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma operação nos últimos dois meses. Todo o histórico está na janela Transações (⇧⌘T)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem operações nos últimos dois meses. O histórico completo está na janela Transações (⇧⌘T)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За последние два месяца операций нет. Вся история — в окне «Операции» (⇧⌘T)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ду моҳи охир амалиёт набуд. Тамоми таърих дар равзанаи «Транзаксияҳо» аст (⇧⌘T)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son iki ayda işlem yok. Tüm geçmiş İşlemler penceresinde (⇧⌘T)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За останні два місяці операцій немає. Уся історія — у вікні «Операції» (⇧⌘T)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi ikki oyda operatsiyalar yo‘q. Barcha tarix Tranzaksiyalar oynasida (⇧⌘T)."
          }
        },
        "zh-Hant": {
