    "why.free.overdue": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З планаў пратэрмінавана %@: улічана як яшчэ не выдаткаваныя грошы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Davon sind %@ der Pläne überfällig: als Geld gezählt, das noch nicht weg ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of the plans, %@ is overdue: counted as money not gone yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De los planes, %@ está vencido: se cuenta como dinero que todavía no se ha ido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmi les plans, %@ est en retard : compté comme argent pas encore parti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra i piani, %@ è scaduto: è considerato denaro non ancora uscito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоспарлардың %@ мерзімі өтіп кетті: әлі кетпеген ақша ретінде саналады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z planów %@ jest po terminie: kwota jest liczona jako niewydana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из планов %@ просрочено — считается, что деньги ещё не ушли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlardan %@ gecikmiş: henüz harcanmamış para olarak sayılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З планів %@ прострочено: рахується як гроші, що ще не пішли."
          }
        }
      }
    },
