    "why.iOwe.notInOverview": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Borc qalıqları yalnız burada və xalis sərvətdə hesablanır, aylıq göstəricilərə daxil deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Астаткі даўгоў улічваюцца толькі тут і ў чыстым капітале, але не ў паказчыках месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatky dluhů se počítají pouze zde a v čistém jmění, nikoli v měsíčních údajích."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuldensalden zählen hier und nur im Vermögen, nicht in den Zahlen des Monats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debt balances count here and in Net Worth only, not in the figures of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos de deudas cuentan solo aquí y en el Patrimonio neto, no en las cifras del mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes de dettes comptent ici et dans le Patrimoine net seulement, pas dans les chiffres du mois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պարտքերի մնացորդները հաշվվում են միայն այստեղ և զուտ կապիտալում, ոչ թե ամսվա ցուցանիշներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi dei debiti sono inclusi solo qui e nel patrimonio netto, non nei dati del mese."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვალის ნაშთები ითვლება მხოლოდ აქ და წმინდა ქონებაში, თვის მაჩვენებლებში კი არა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек теңгерімдері тек осы жерде және Таза байлықта есептеледі, айдың көрсеткіштерінде емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Карыз калдыктары ушул жерде жана таза капиталда гана эсептелет, айлык көрсөткүчтөргө кирбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salda długów są uwzględnione tylko tutaj i w wartości netto, nie w podsumowaniu miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos de dívidas entram apenas aqui e no patrimônio líquido, não nos valores do mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos das dívidas contam apenas aqui e no património líquido, não nos valores do mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки долгов считаются только здесь и в «Капитале», не в цифрах месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи қарзҳо танҳо дар ин ҷо ва дар сарвати холис ҳисоб мешавад, на дар нишондиҳандаҳои моҳ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borç bakiyeleri yalnızca burada ve Net Varlık'ta sayılır, aylık tutarlara dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки боргів рахуються тут і лише в «Капіталі», а не в цифрах місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qarz qoldiqlari faqat shu yerda va sof kapitalda hisoblanadi, oylik ko‘rsatkichlarga kirmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "債務餘額僅計入此處和淨資產，不計入本月數據。"
          }
        }
      }
    },
