    "why.balance.leftOut": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəzi balanslar hesaba daxil edilməyib və ya məzənnəsi yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Некаторыя балансы не ўлічваюцца або не маюць курсу і выключаны з разліку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé zůstatky nejsou započítány nebo nemají kurz, a proto jsou vynechány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Salden sind nicht gezählt oder haben keinen Kurs und bleiben weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some balances are not counted or have no rate and are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos saldos no se cuentan o no tienen tipo y se dejan fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains soldes ne sont pas comptés ou n'ont pas de taux et sont laissés de côté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որոշ մնացորդներ չեն հաշվառվում կամ փոխարժեք չունեն և ներառված չեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni saldi non vengono conteggiati o non hanno un tasso di cambio e sono esclusi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზოგიერთი ნაშთი არ აღირიცხება ან კურსი არ აქვს და გამოტოვებულია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейбір теңгерімдер санаған жоқ немесе бағамы жоқ, сондықтан шығарылды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айрым калдыктар эсепке алынган жок же алардын курсу жок болгондуктан кошулган жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre salda pominięto, ponieważ nie są uwzględniane lub nie mają kursu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns saldos não são contabilizados ou não têm taxa de câmbio e foram excluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns saldos não são contabilizados ou não têm taxa de câmbio e ficam excluídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть остатков не сверена или без курса — они не учтены."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баъзе бақияҳо ба ҳисоб гирифта нашудаанд ё қурб надоранд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı bakiyeler sayılmadığı veya kuru olmadığı için dahil edilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі залишки не враховано або для них немає курсу — вони не входять до суми."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba’zi qoldiqlar hisobga olinmagan yoki ularning kursi yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分餘額未計入或缺少匯率，已從總計中排除。"
          }
        }
      }
    },
    "why.balance.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcmalda hələ heç bir balans hesablanmayıb: proqnoz üçün məlumat yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніводзін баланс у зводцы пакуль не ўлічваецца: няма даных для прагнозу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není započítán žádný zůstatek v přehledu. Prognózu nelze sestavit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Saldo der Übersicht ist gezählt: Es gibt nichts, woraus man prognostizieren könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No balance of the summary is counted yet: there is nothing to forecast from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se cuenta ningún saldo del resumen: no hay de qué hacer previsión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun solde du récapitulatif n'est encore compté : il n'y a rien à prévoir."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփման մեջ դեռ ոչ մի մնացորդ չի հաշվառվում․ կանխատեսման հիմք չկա։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun saldo del riepilogo è ancora conteggiato: non ci sono dati per la previsione."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯამებაში ჯერ არცერთი ნაშთი არ აღირიცხება: პროგნოზისთვის მონაცემები არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындының бірде-бір теңгерімі әлі санаған жоқ: болжау жасайтын ештеңе жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалпы эсепте азырынча калдык жок: болжолдоого негиз жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne saldo nie jest jeszcze uwzględniane w podsumowaniu. Nie można utworzyć prognozy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há saldos contabilizados no resumo para fazer uma previsão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há saldos contabilizados no resumo para fazer uma previsão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один остаток счетов в сводке ещё не сверен — прогнозировать не от чего."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз ягон бақия ба ҷамъбаст дохил нашудааст: барои пешгӯӣ маълумот нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özette henüz sayılan bakiye yok. Tahmin yapılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден залишок підсумку ще не враховано: прогнозувати нема з чого."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumiy hisobda hali qoldiq yo‘q: prognoz qilish uchun ma’lumot yetarli emas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要中尚無計入的餘額，無法進行預測。"
          }
        }
      }
    },
