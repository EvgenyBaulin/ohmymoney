        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "starší než %@ dní — je čas na novou"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "älter als %@ Tage — Zeit für eine neue"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "older than %@ days — time for a new one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "más de %@ días — es hora de hacer una nueva"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "plus vieille que %@ jours — il est temps d'en faire une nouvelle"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ օրից հին է․ ժամանակն է նոր պատճեն ստեղծել"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "più di %@ giorni fa — è ora di crearne una nuova"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ დღეზე ძველია — ახალი ასლის დროა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күннен ескі — жаңасын жасау уақыты"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ күндөн эски — жаңы көчүрмө түзүңүз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "starsza niż %@ dni — czas na nową"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "há mais de %@ dias — é hora de fazer outra"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "há mais de %@ dias — está na hora de criar outra"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "старше %@ дней — пора сделать новую"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "зиёда аз %@ рӯз гузаштааст — вақти нусхаи нав расид"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ günden eski — yeni kopya oluşturma zamanı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "старша за %@ днів — час зробити нову"
