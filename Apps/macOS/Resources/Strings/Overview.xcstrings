    "why.calendar.lowData": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Adi günü müəyyən etmək üçün tarixçə kifayət deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова даных, каб вызначыць звычайныя выдаткі за дзень."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro určení obvyklé denní útraty je k dispozici příliš málo údajů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Verlauf, um zu sagen, was ein üblicher Tag ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too little history to say what a usual day is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial insuficiente para saber qué es un día habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique trop court pour dire ce qu'est un jour habituel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սովորական օրվա ծախսը որոշելու համար տվյալները քիչ են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati insufficienti per stimare una giornata tipo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩვეულებრივი დღის დასადგენად მონაცემები არასაკმარისია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі күнді айту үшін тарих аз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадимки күндү аныктоо үчүн маалымат жетишсиз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych, aby określić typowy dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há histórico suficiente para determinar um dia típico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico insuficiente para calcular um dia habitual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истории мало, чтобы сказать, какой день обычный."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои муайян кардани рӯзи маъмулӣ маълумот кам аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olağan bir günü belirlemek için yeterli geçmiş yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замало історії, щоб сказати, що таке звичайний день."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatiy kunni aniqlash uchun ma’lumot yetarli emas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄不足，無法判斷每日平均支出。"
          }
        }
      }
    },
