          "stringUnit": {
            "state": "translated",
            "value": "Деньги на счетах из сводки ещё не посчитаны."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз маблағи ҳисобҳои ҷамъбаст ба ҳисоб гирифта нашудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özetteki hesaplarda henüz sayılan para yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунках підсумку ще немає порахованих грошей."
