    "why.calendar.rounding": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумы за кожны дзень і за тыдзень акругляюцца асобна да цэлых адзінак."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tag und die Woche werden für sich auf die Einheit gerundet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day and the week are rounded to the unit on their own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día y la semana se redondean por separado a la unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour et la semaine sont arrondis à l'unité séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno e la settimana sono arrotondati all’unità separatamente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр күн мен апта бірлікке өз бетінше дөңгелектенеді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwoty dla każdego dnia i tygodnia są zaokrąglane osobno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый день и неделя округляются до целых отдельно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün ve hafta toplamı ayrı ayrı birime yuvarlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен день і тиждень округлюються до одиниці окремо."
          }
        }
      }
    },
