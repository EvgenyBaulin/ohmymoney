          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The figure on the tile is being refreshed and may differ for a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cifra del mosaico se está actualizando y puede diferir un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffre de la tuile est en cours d'actualisation et peut différer un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore nel riquadro è in aggiornamento e potrebbe differire per qualche istante."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тақтайшадағы сан жаңартылып жатыр және бір сәт өзгеше болуы мүмкін."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość na kafelku jest odświeżana i może się chwilowo różnić."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цифра на плитке обновляется и может на миг отличаться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutucuktaki değer güncelleniyor ve kısa bir süre farklı görünebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цифра на плитці оновлюється і на мить може відрізнятися."
          }
        }
      }
    },
    "why.rule.averageDaily": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за гэты месяц, падзеленыя на колькасць дзён ад 1-га чысла да сёння."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben des Monats bisher, geteilt durch die Tage vom 1. bis heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of the month so far divided by the days from the 1st through today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto del mes hasta ahora dividido entre los días desde el 1 hasta hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses du mois jusqu'ici, divisées par le nombre de jours du 1er à aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese fino a oggi, divise per i giorni dal 1° a oggi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай басынан бүгінге дейінгі менің шығысым, 1-нен бүгінге дейінгі күндерге бөлінген."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu do dziś podzielone przez liczbę dni od 1. dnia miesiąca do dziś."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы месяца на сегодня, делённые на число дней с 1-го по сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay şu ana kadarki harcamamın ayın 1’inden bugüne kadar geçen gün sayısına bölümü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за місяць поки що, поділені на дні з 1-го по сьогодні."
          }
        }
      }
    },
    "why.rule.backups": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Найноўшая копія базы даных у папцы копій; копія старэйшая за тыдзень лічыцца састарэлай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neueste Kopie der Datenbank im Ordner der Kopien; eine Kopie, die älter als eine Woche ist, gilt als veraltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The newest copy of the database in the folder of copies; a copy older than a week is stale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia más reciente de la base de datos en la carpeta de copias; una copia de más de una semana está desfasada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie la plus récente de la base dans le dossier des copies ; une copie de plus d'une semaine est périmée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia più recente del database nella cartella delle copie; una copia più vecchia di una settimana non è aggiornata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірмелер қалтасындағы дерекқордың ең жаңа көшірмесі; бір аптадан ескі көшірме ескірген болып саналады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowsza kopia bazy danych w folderze kopii. Kopia starsza niż tydzień jest nieaktualna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая свежая копия базы в папке копий; копия старше недели считается устаревшей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler klasöründeki en yeni veritabanı kopyası; bir haftadan eski kopyalar güncel sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найновіша копія бази в теці копій; копія старша за тиждень вважається застарілою."
          }
        }
      }
    },
    "why.rule.balanceForecast": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожны ўлічаны баланс рахункаў у зводцы на канец месяца: грошы цяпер плюс чаканыя паступленні, мінус плацяжы і верагодныя выдаткі; сумуецца ў кожнай валюце."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder gezählte Saldo der Konten in der Übersicht am Monatsende: Geld jetzt, plus was noch kommt, minus Zahlungen und die wahrscheinlichen Ausgaben; innerhalb jeder Währung addiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each counted balance of the accounts in the summary at the end of the month: money now, plus what is due to come, less payments and the likely spending; added up within each currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo contado de cada cuenta del resumen a final de mes: el dinero de hoy, más lo que llegará, menos los pagos y el gasto probable; sumado dentro de cada divisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque solde compté des comptes du récapitulatif à la fin du mois : l'argent actuel, plus ce qui doit encore arriver, moins les paiements et les dépenses probables ; additionné par devise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo previsto a fine mese per ogni conto incluso nel riepilogo: denaro attuale, più le entrate previste, meno i pagamenti e le spese probabili; i saldi sono sommati per valuta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы әр есептелген теңгерім ай соңында: қазіргі ақша, плюс келетін, минус төлемдер мен болжамды шығын; әр валюта ішінде қосылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognozowane saldo każdego uwzględnionego konta na koniec miesiąca: obecne środki plus oczekiwane wpływy, minus płatności i przewidywane wydatki. Salda są sumowane dla każdej waluty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый сверенный остаток счетов в сводке на конец месяца: деньги сейчас плюс ожидаемые поступления минус платежи и вероятные траты; складываются внутри каждой валюты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özetteki her hesaba katılan hesabın ay sonu bakiyesi: mevcut para, beklenen gelirler eklenip ödemeler ve tahmini harcamalar çıkarılarak bulunur; her para birimi kendi içinde toplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен врахований залишок рахунків підсумку на кінець місяця: гроші зараз плюс те, що має надійти, мінус платежі й імовірні витрати; підсумовується в межах кожної валюти."
          }
        }
      }
    },
    "why.rule.canSave": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканы даход за месяц мінус выдаткаванае без унёскаў у мэты, будучыя плацяжы і верагодныя выдаткі за астатнія дні."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwartete Einnahmen des Monats, abzüglich dessen, was ohne Zielbeiträge ausgegeben wird, der noch fälligen Zahlungen und der wahrscheinlichen Ausgaben der verbleibenden Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected income of the month, less what is spent without goal contributions, the payments still due and the likely spending of the days left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso previsto del mes, menos lo que se gasta sin aportaciones a objetivos, los pagos todavía pendientes y el gasto probable de los días que quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus attendus du mois, moins ce qui est dépensé hors contributions aux objectifs, les paiements encore dus et les dépenses probables des jours restants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate previste del mese, meno le spese escluse le somme destinate agli obiettivi, i pagamenti ancora dovuti e le spese probabili dei giorni restanti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың күтілетін табысы, минус мақсат салымдарынсыз жұмсалған, әлі төленетін төлемдер және қалған күндердің болжамды шығыны."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwany dochód w tym miesiącu minus wydatki bez wpłat na cele, pozostałe płatności i przewidywane wydatki do końca miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемый доход месяца минус потраченное без взносов на цели, ещё не оплаченные платежи и вероятные траты оставшихся дней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın beklenen gelirinden, hedeflere yapılan katkılar hariç harcamalar, kalan ödemeler ve ayın kalan günleri için tahmini harcamalar çıkarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний дохід місяця мінус те, що витрачено без внесків у цілі, платежі, що ще належать, і імовірні витрати за дні, що лишилися."
          }
        }
      }
    },
    "why.rule.capital": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усё, што я маю — грошы на ўсіх рахунках, актывы і тое, што мне вінны, — мінус тое, што я вінен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ich habe — Geld auf jedem Konto, Vermögen und was mir geschuldet wird — abzüglich dessen, was ich schulde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What I have — money on every account, assets and what is owed to me — less what I owe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que tengo — el dinero de cada cuenta, los bienes y lo que me deben — menos lo que debo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que j'ai — l'argent de chaque compte, les actifs et ce qui m'est dû — moins ce que je dois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che possiedo — denaro su tutti i conti, beni e crediti — meno ciò che devo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менде не бар — әр есеп-шоттағы ақша, активтер және маған берілген — минус менің берешегім."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co mam — środki na wszystkich kontach, aktywa i należności — minus moje długi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что у меня есть — деньги на всех счетах, имущество и долги мне — минус то, что я должен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahip olduklarım — tüm hesaplardaki para, varlıklar ve alacaklarım — eksi borçlarım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що маю — гроші на кожному рахунку, майно і те, що мені винні, — мінус те, що винен я."
          }
        }
      }
    },
    "why.rule.categoryGrew": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыя, выдаткі ў якой найбольш выраслі ў рублях адносна тых жа дзён мінулага месяца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorie, deren Ausgaben in Rubel am stärksten gegenüber denselben Tagen des letzten Monats gewachsen sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category whose spending grew most in rubles against the same days of last month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoría cuyo gasto más creció en rublos frente a los mismos días del mes pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie dont les dépenses ont le plus augmenté en roubles par rapport aux mêmes jours du mois dernier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoria le cui spese sono aumentate di più in rubli rispetto agli stessi giorni del mese scorso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен айдың дәл сол күндерімен салыстырғанда рубльмен шығыны ең көп өскен санат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria, której wydatki wzrosły najbardziej w rublach względem tych samych dni poprzedniego miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория, расходы по которой выросли больше всех в рублях к тем же дням прошлого месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen ayın aynı günlerine göre harcaması ruble cinsinden en çok artan kategori."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія, витрати в якій зросли найбільше в рублях порівняно з тими самими днями минулого місяця."
          }
        }
      }
    },
    "why.rule.categoryShrank": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыя, выдаткі ў якой найбольш знізіліся ў рублях адносна тых жа дзён мінулага месяца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorie, deren Ausgaben in Rubel am stärksten gegenüber denselben Tagen des letzten Monats gesunken sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category whose spending fell most in rubles against the same days of last month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoría cuyo gasto más bajó en rublos frente a los mismos días del mes pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie dont les dépenses ont le plus baissé en roubles par rapport aux mêmes jours du mois dernier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoria le cui spese sono diminuite di più in rubli rispetto agli stessi giorni del mese scorso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен айдың дәл сол күндерімен салыстырғанда рубльмен шығыны ең көп кеміген санат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria, której wydatki spadły najbardziej w rublach względem tych samych dni poprzedniego miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория, расходы по которой сократились больше всех в рублях к тем же дням прошлого месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen ayın aynı günlerine göre harcaması ruble cinsinden en çok azalan kategori."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія, витрати в якій найбільше зменшилися в рублях порівняно з тими самими днями минулого місяця."
          }
        }
      }
    },
    "why.rule.currencyBalances": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансы рахункаў у зводцы, згрупаваныя па валюце; кожная валюта паказана ў рублях па курсе дня, а разам яны складаюць суму «Всего»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Salden der Konten in der Übersicht, nach Währung gruppiert; jede Währung wird in Rubel zum Kurs des Tages gezeigt, zusammen ergeben sie die Summe „Gesamt“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balances of the accounts in the summary, grouped by currency; each currency is shown in rubles at the rate of the day, and together they are the total of «Всего»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos de las cuentas del resumen, agrupados por divisa; cada divisa se muestra en rublos al tipo del día, y juntas son el total de «Todo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes des comptes du récapitulatif, groupés par devise ; chaque devise est montrée en roubles au cours du jour, et ensemble ils forment le total de « Всего »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi dei conti nel riepilogo, raggruppati per valuta; ogni valuta è mostrata in rubli al tasso del giorno e insieme formano il totale di «Всего»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы есеп-шоттардың теңгерімдері валюта бойынша топтастырылған; әр валюта сол күнгі бағам бойынша рубльмен көрсетіледі, олар бірге «Барлығы» жиыны болады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salda kont w podsumowaniu pogrupowane według waluty. Każda waluta jest przeliczana na ruble po kursie dnia, a ich suma to «Всего»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки счетов из сводки, сгруппированные по валютам; каждая валюта показана в рублях по курсу дня, вместе они дают «Всего»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özetteki hesap bakiyeleri para birimine göre gruplandırılır; her para birimi günün kuruyla ruble cinsinden gösterilir ve toplamları «Всего» değerini oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки рахунків підсумку, згруповані за валютою; кожну валюту показано в рублях за курсом дня, а разом вони дають суму «Усього»."
          }
        }
      }
    },
    "why.rule.currencyChart": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Штодзённыя курсы валютнай пары ад банка за выбраны перыяд: курс на пачатку, яго змяненне і курс цяпер."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die täglichen Kurse der Bank für das Paar im gewählten Zeitraum: der Kurs zu Beginn, wie er sich geändert hat, und der Kurs jetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank's daily rates of the pair over the chosen period: the rate at its start, how it changed, and the rate now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tipos diarios del banco del par durante el periodo elegido: el tipo al inicio, cómo cambió y el tipo ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cours quotidiens de la banque pour la paire sur la période choisie : le cours au début, son évolution et le cours actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tassi giornalieri della banca per la coppia nel periodo scelto: il tasso iniziale, la sua variazione e il tasso attuale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған кезеңдегі банктің күнделікті бағамдары: басындағы бағам, қалай өзгергені және қазіргі бағам."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzienne kursy bankowe pary walut w wybranym okresie: kurs na początku, jego zmiana i obecny kurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневные курсы ЦБ для пары за выбранный период: курс в начале, его изменение и курс сейчас."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dönem boyunca bankanın para birimi çiftine ait günlük kurları: başlangıç kuru, değişimi ve güncel kur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоденні курси банку для пари за обраний період: курс на початку, його зміна і курс зараз."
          }
        }
      }
    },
    "why.rule.cushion": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на рахунках падушкі, падзеленыя на абавязковыя выдаткі за месяц і акругленыя ўніз да дзясятай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld der Polster-Konten geteilt durch die Pflichtausgaben eines Monats, auf eine Zehntel abgerundet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money of the cushion accounts divided by the obligatory spending of a month, rounded down to a tenth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de las cuentas del colchón dividido entre el gasto obligatorio de un mes, redondeado hacia abajo a una décima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent des comptes du matelas divisé par les dépenses obligatoires d'un mois, arrondi au dixième inférieur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro nei conti del fondo di emergenza diviso per le spese obbligatorie di un mese, arrotondato per difetto al decimo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық есеп-шоттарының ақшасын айлық міндетті шығынға бөлу, оныншы бөлікке дейін төмен қарай дөңгелектеу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środki na kontach poduszki podzielone przez obowiązkowe wydatki za miesiąc, zaokrąglone w dół do jednej dziesiątej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги счетов подушки, делённые на обязательные траты месяца, с округлением вниз до десятых."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvence hesaplarındaki paranın bir aylık zorunlu harcamalara bölümü; sonuç onda bir basamağına aşağı yuvarlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші рахунків подушки, поділені на обов'язкові витрати за місяць, округлені вниз до десятих."
          }
        }
      }
    },
    "why.rule.event": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі на падзею па ўсіх яе аперацыях незалежна ад даты адносна яе бюджэту."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben für das Ereignis über alle seine Vorgänge, unabhängig von ihrem Datum, gegenüber seinem Budget."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending on the event over all its operations, whatever their date, against its budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto en el evento sumando todas sus operaciones, sea cual sea su fecha, frente a su presupuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses pour l'événement sur toutes ses opérations, quelle que soit leur date, comparées à son budget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese per l’evento in tutte le sue operazioni, indipendentemente dalla data, rispetto al budget."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Іс-шараға менің шығысым оның барлық операциялары бойынша, күніне қарамастан, бюджетіне қарсы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki na wydarzenie ze wszystkich jego operacji, niezależnie od daty, w porównaniu z budżetem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои траты на событие по всем его операциям, в какой бы день они ни были, против его бюджета."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihlerinden bağımsız olarak etkinliğe ait tüm işlemlerdeki harcamamın bütçeye göre durumu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати на подію за всіма її операціями, незалежно від дати, порівняно з її бюджетом."
          }
        }
      }
    },
    "why.rule.expectedIncome": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Яшчэ не атрыманыя сумы па кожнай даце паступлення ў гэтым месяцы па сённяшнім курсе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jede Fälligkeit dieses Monats bisher nicht gebracht hat, zum heutigen Kurs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What each due date of this month has not brought yet, at today's rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cada fecha de vencimiento de este mes todavía no ha traído, al tipo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que chaque échéance de ce mois n'a pas encore apporté, au cours du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto manca ancora per ogni scadenza di entrata di questo mese, al tasso di oggi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдың әр күтілетін күні әлі келмеген табыс, бүгінгі бағам бойынша."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwoty, które nie wpłynęły jeszcze w terminach przypadających w tym miesiącu, według dzisiejszego kursu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько ещё не принёс каждый срок ожидаемых поступлений этого месяца, по курсу сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın her beklenen gelirinden henüz alınmamış tutar, bugünkü kurla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що ще не надійшло за кожною датою очікування цього місяця, за сьогоднішнім курсом."
          }
        }
      }
    },
    "why.rule.financialHealth": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ацэнка са ста балаў, якая складаецца з пяці частак: падушка, даўгавая нагрузка, норма зберажэнняў, пратэрмінаваныя плацяжы і стабільнасць даходу. Часткі без даных не ўлічваюцца, а астатнія пералічваюцца да ста балаў; іх балы складаюць агульную ацэнку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahl von hundert aus fünf Teilen: dem Polster, der Schuldenlast, der Sparquote, überfälligen Fälligkeiten und der Stabilität der Einnahmen. Ein Teil ohne Daten bleibt weg, und die übrigen werden auf hundert hochgerechnet; die Punkte der Teile ergeben zusammen die Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One number out of a hundred made of five parts: the cushion, the debt load, the savings rate, overdue dues and the stability of income. A part with no data is left out and the rest are scaled to a hundred; the points of the parts add up to the number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número de cien hecho con cinco partes: el colchón, la carga de deudas, la tasa de ahorro, los vencimientos atrasados y la estabilidad de los ingresos. Una parte sin datos no se incluye y las demás se escalan a cien; los puntos de las partes suman el número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chiffre sur cent, composé de cinq parties : le matelas, le poids des dettes, le taux d'épargne, les échéances en retard et la stabilité des revenus. Une partie sans données est laissée de côté et les autres sont ramenées sur cent ; les points des parties font le chiffre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punteggio su cento composto da cinque parti: fondo di emergenza, peso dei debiti, tasso di risparmio, scadenze arretrate e stabilità delle entrate. Le parti senza dati sono escluse e le altre sono riproporzionate su cento; la somma dei punti dà il punteggio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүзден бір сан, бес бөліктен: жастық, берешек жүктемесі, жинақ мөлшерлемесі, мерзімі өткен төлемдер және табыстың тұрақтылығы. Деректері жоқ бөлік шығарылады, ал қалғандары жүзге дейін масштабталады; бөліктердің ұпайлары қосылып, санды береді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik na 100 punktów, złożony z pięciu części: poduszki, obciążenia długiem, stopy oszczędności, zaległych płatności i stabilności dochodów. Części bez danych są pomijane, a pozostałe przeliczane do 100 punktów. Suma punktów daje wynik."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно число из ста из пяти частей: подушка, долговая нагрузка, норма сбережений, просрочки и стабильность дохода. Часть без данных не считается, остальные пересчитываются на сто; баллы частей складываются в число."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş bölümden oluşan 100 üzerinden bir puan: güvence, borç yükü, birikim oranı, vadesi geçmiş ödemeler ve gelir istikrarı. Verisi olmayan bölümler çıkarılır ve kalanlar 100 üzerinden ölçeklenir; bölüm puanlarının toplamı sonucu verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне число зі ста, складене з п'яти частин: подушка, навантаження боргами, норма заощаджень, прострочені платежі й стабільність доходу. Частина без даних не враховується, а решта масштабується до ста; бали частин складаються в число."
          }
        }
      }
    },
    "why.rule.freeMoney": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на рахунках у зводцы цяпер мінус грошы на мэты (і падушка, калі яна выключана); затым адымаюцца запланаваныя сумы да канца месяца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld auf den Konten in der Übersicht jetzt, abzüglich Zielgeld (und des Polsters, wenn es herausgehalten wird); dann abzüglich dessen, was die Pläne bis Monatsende beanspruchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money on the accounts in the summary now, less goal money (and the cushion when it is kept out); then less what the plans take until the end of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de las cuentas del resumen ahora, menos el dinero de los objetivos (y el colchón cuando se deja fuera); después, menos lo que se llevan los planes hasta final de mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent des comptes du récapitulatif maintenant, moins l'argent des objectifs (et le matelas s'il est exclu) ; puis moins ce que prennent les plans jusqu'à la fin du mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro attuale sui conti nel riepilogo, meno le somme destinate agli obiettivi (e al fondo di emergenza, se escluso); vengono poi sottratte le somme previste dai piani fino a fine mese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы есеп-шоттардағы қазіргі ақша, минус мақсаттардың ақшасы (және жастық, ол бөлек ұсталса); одан кейін ай соңына дейін жоспарлар алатын сома."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecne środki na kontach w podsumowaniu minus środki na cele i, jeśli wyłączono ją z dostępnych środków, poduszka. Następnie odejmowane są kwoty zaplanowane do końca miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги на счетах в сводке сейчас минус деньги целей (и подушка, если она не считается свободной); затем минус то, что заберут планы до конца месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özetteki hesaplarda şu an bulunan paradan hedeflere ayrılan para ve hariç tutuluyorsa güvence çıkarılır; ardından ay sonuna kadar planlar için gereken tutar düşülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші на рахунках підсумку зараз, мінус гроші цілей (і подушка, якщо її відведено окремо); далі мінус те, що плани забирають до кінця місяця."
          }
        }
      }
    },
    "why.rule.iOwe": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэшта па кожным адкрытым доўгу, які я павінен, па сённяшнім курсе; рэшткі даўгоў не ўлічваюцца ў паказчыках месяца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was von jeder offenen Schuld, die ich schulde, übrig ist, zum heutigen Kurs; Schuldensalden zählen nicht in den Zahlen des Monats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is left of each open debt I owe, at today's rate; debt balances are not counted in the figures of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que queda de cada deuda abierta que debo, al tipo de hoy; los saldos de deudas no cuentan en las cifras del mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste de chaque dette ouverte que je dois, au cours du jour ; les soldes de dettes ne figurent pas dans les chiffres du mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo residuo di ogni mio debito aperto, al tasso di oggi; i saldi dei debiti non sono inclusi nei valori del mese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашық берешектердің әрқайсысынан менің қарызым қалғаны, бүгінгі бағам бойынша; берешек теңгерімдері айдың көрсеткіштеріне есептелмейді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostała kwota każdego mojego niespłaconego długu według dzisiejszego kursu. Salda długów nie są uwzględniane w wynikach miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток каждого открытого долга «Я должен» по курсу сегодня; остатки долгов не входят в цифры месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık borçlarımın her birinden kalan tutar, bugünkü kurla; borç bakiyeleri aylık rakamlara katılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що лишилося за кожним відкритим боргом, який я винен, за сьогоднішнім курсом; залишки боргів не входять до цифр місяця."
          }
        }
      }
    },
    "why.rule.incomeForecast": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Атрыманае за гэты месяц плюс чаканы даход гэтага месяца, які яшчэ не паступіў; калі чаканага даходу няма — медыяна за апошнія поўныя месяцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was diesen Monat eingegangen ist, plus was die erwarteten Einnahmen dieses Monats noch erwarten; ist keine erwartet, der Median der letzten vollen Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What came this month, plus what the expected income of this month still waits for; with none expected — the median of the last full months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que llegó este mes, más lo que todavía espera el ingreso previsto de este mes; si no hay ninguno previsto, la mediana de los últimos meses completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est entré ce mois-ci, plus ce que les revenus attendus de ce mois attendent encore ; sans revenu attendu — la médiane des derniers mois complets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ricevuto questo mese, più quanto ancora atteso dalle entrate previste del mese; se non ci sono entrate previste, si usa la mediana degli ultimi mesi completi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда түскені, плюс осы айдың күтілетін табысы әлі күтіп тұрғаны; ешбір табыс күтілмесе — соңғы толық айлардың медианасы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpływy z tego miesiąca plus pozostały oczekiwany dochód. Jeśli nie ma oczekiwanych wpływów, używana jest mediana z ostatnich pełnych miesięcy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пришедшее в этом месяце плюс то, чего ещё ждут ожидаемые поступления месяца; если ожиданий нет — медиана последних полных месяцев."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay gelen gelir ile bu ay için hâlâ beklenen gelirin toplamı; beklenen gelir yoksa son tamamlanmış ayların medyanı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що надійшло цього місяця плюс те, на що ще чекає очікуваний дохід місяця; якщо нічого не очікується — медіана останніх повних місяців."
          }
        }
      }
    },
    "why.rule.incomeSources": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход за гэты месяц па катэгорыях, у якія ён запісаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen dieses Monats nach der Kategorie, unter der sie eingeordnet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income of this month by the category it was filed under."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ingresos de este mes por la categoría en la que se archivaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus de ce mois par la catégorie dans laquelle ils ont été classés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate di questo mese, suddivise per la categoria in cui sono state registrate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдың табысы оның қай санатына жазылғанына қарай."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochody z tego miesiąca według przypisanych im kategorii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход этого месяца по категориям, в которых он записан."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın geliri, kaydedildiği kategoriye göre."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід цього місяця за категорією, під якою його записано."
          }
        }
      }
    },
    "why.rule.installments": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэшта па адкрытых растэрміноўках і пакупках у крэдыт у рублях па сённяшнім курсе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die offenen Ratenpläne und Käufe auf Kredit noch verlangen, in Rubel zum heutigen Kurs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the open instalment plans and purchases on credit still ask, in rubles at today's rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que todavía reclaman los planes de plazos abiertos y las compras a crédito, en rublos al tipo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que demandent encore les échéanciers et achats à crédit ouverts, en roubles au cours du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo residuo dei piani rateali aperti e degli acquisti a credito, in rubli al tasso di oggi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашық бөліп төлеу жоспарлары мен несиеге сатып алулардың әлі сұрайтыны, бүгінгі бағам бойынша рубльмен."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota pozostała do spłaty z otwartych planów ratalnych i zakupów na kredyt, w rublach według dzisiejszego kursu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько ещё должны открытые рассрочки и покупки в кредит, в рублях по курсу сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam eden taksitli ödeme planları ve kredili alışverişlerden kalan tutar, bugünkü kurla ruble cinsinden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що ще вимагають відкриті плани розстрочки й покупки в кредит, у рублях за сьогоднішнім курсом."
          }
        }
      }
    },
    "why.rule.integrity": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вынік апошняй праверкі базы даных, якая толькі счытвае даныя і запускаецца раз на тыдзень."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der letzten Prüfung der Datenbank, die nur liest und einmal in der Woche läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result of the last check of the database, which only reads and runs once a week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la última comprobación de la base de datos, que solo lee y se hace una vez por semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la dernière vérification de la base, qui ne fait que lire et a lieu une fois par semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato dell’ultimo controllo del database, eseguito in sola lettura una volta a settimana."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқорды соңғы тексеру нәтижесі; ол тек оқиды және аптасына бір рет жүреді."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik ostatniego sprawdzenia bazy danych. Sprawdzenie tylko odczytuje dane i odbywa się raz w tygodniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итог последней проверки базы, которая только читает и идёт раз в неделю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanının haftada bir yapılan, yalnızca okuma amaçlı son kontrolünün sonucu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат останньої перевірки бази; вона лише читає й запускається раз на тиждень."
          }
        }
      }
    },
    "why.rule.lastCount": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апошняя зверка рахункаў і адхіленне кожнага пералічанага балансу ад запісаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der neueste Abgleich der Konten und was jeder gezählte Saldo gegenüber den Büchern ergeben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest reconciliation of the accounts, and what each counted balance found against the books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última conciliación de las cuentas, y lo que encontró cada saldo contado frente a los registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier rapprochement des comptes, et ce que chaque solde compté a révélé par rapport aux écritures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima riconciliazione dei conti e la differenza tra ogni saldo verificato e quello registrato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттардың соңғы салыстыруы және әр санаған теңгерім жазбалармен салыстырғанда нені тапқаны."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie uzgodnienie kont i różnica między sprawdzonym saldem każdego konta a zapisami."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя сверка счетов и то, что каждый сверенный остаток нашёл против записей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesapların son mutabakatı ve sayılan her bakiyenin kayıtlara göre durumu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання звірка рахунків і те, що кожен врахований залишок показав порівняно з книгами."
          }
        }
      }
    },
    "why.rule.lastCountAndRecord": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Два адказы на пытанне «ці актуальныя лічбы»: апошняя зверка і апошняя запісаная аперацыя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Antworten auf „Sind die Zahlen aktuell?“: der neueste Abgleich und der zuletzt aufgeschriebene Vorgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both answers to «are the figures up to date»: the latest reconciliation and the operation written down last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos respuestas a «¿están las cifras al día?»: la última conciliación y la última operación anotada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux réponses à « les chiffres sont-ils à jour » : le dernier rapprochement et l'opération notée en dernier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe le risposte a «i dati sono aggiornati»: l’ultima riconciliazione e l’ultima operazione registrata."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мәліметтер жаңа ма» деген сұраққа екі жауап: соңғы салыстыру және соңында жазылған операция."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwie odpowiedzi na pytanie «czy dane są aktualne»: ostatnie uzgodnienie i ostatnio zapisana operacja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два ответа на вопрос «цифры свежие?»: последняя сверка и последняя записанная операция."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Rakamlar güncel mi» sorusunun iki yanıtı: son mutabakat ve en son kaydedilen işlem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дві відповіді на «чи актуальні цифри»: остання звірка і остання записана операція."
          }
        }
      }
    },
    "why.rule.lastRecord": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апошняя запісаная аперацыя паводле часу запісу, а не даты аперацыі; пераводы і службовыя запісы праграмы не ўлічваюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der zuletzt aufgeschriebene Vorgang — nach dem Zeitpunkt des Schreibens, nicht nach seinem Datum; Überweisungen und Zeilen, die die App für ihre Bücher schreibt, bleiben weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation written down last — by when it was written, not by its date; transfers and lines the app writes for its books are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última operación anotada — por cuándo se escribió, no por su fecha; se dejan fuera las transferencias y las líneas que la app escribe para sus cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération notée en dernier — d'après le moment où elle a été notée, pas sa date ; les virements et les lignes que l'app écrit pour ses comptes sont exclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima operazione registrata, in base al momento della registrazione e non alla sua data; sono esclusi i trasferimenti e le righe contabili create dall’app."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңында жазылған операция — оның күні бойынша емес, қашан жазылғаны бойынша; аударымдар мен қолданба өз кітабы үшін жазатын жолдар есепке алынбайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio zapisana operacja według czasu zapisu, a nie daty operacji. Przelewy i wpisy tworzone przez aplikację na potrzeby rozliczeń są pomijane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция, записанная последней, — по моменту записи, а не по её дате; переводы и служебные строки приложения не считаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En son kaydedilen işlem — işlem tarihine göre değil, kayıt zamanına göre; transferler ve uygulamanın kayıtlar için oluşturduğu satırlar hariç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання записана операція — за тим, коли її записано, а не за датою; перекази й рядки, які застосунок пише для своїх книг, не враховуються."
          }
        }
      }
    },
    "why.rule.limits": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожны ліміт параўноўвае мае выдаткі за гэты месяц з даступнай сумай — лімітам і перанесеным астаткам за мінулыя месяцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Limit vergleicht meine Ausgaben in diesem Monat darunter mit dem, was verfügbar ist — dem Limit plus was frühere Monate übertragen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each limit compares my spending this month under it with what is available — the limit plus what earlier months carried over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada límite compara mi gasto de este mes en él con lo disponible — el límite más lo que traspasaron los meses anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque plafond compare mes dépenses du mois sous ce plafond avec ce qui est disponible — le plafond plus ce que les mois précédents ont reporté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni limite confronta le mie spese del mese nella relativa categoria con l’importo disponibile: il limite più quanto riportato dai mesi precedenti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр лимит осы айдағы менің шығысымды оның астындағы қолжетімді сомамен салыстырады — лимит плюс бұрынғы айлардан көшкен сома."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy limit porównuje moje wydatki w tym miesiącu z dostępną kwotą: limitem powiększonym o środki przeniesione z poprzednich miesięcy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый лимит сравнивает мои траты месяца под ним с доступным — лимитом плюс перенесённым с прошлых месяцев."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her limit, bu ay kapsamındaki harcamamı kullanılabilir tutarla karşılaştırır: limit ve önceki aylardan devreden tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен ліміт порівнює мої витрати за місяць у його межах із тим, що доступно: ліміт плюс перенесене з попередніх місяців."
          }
        }
      }
    },
    "why.rule.monthIncome": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход гэтага месяца, атрыманы да сёння, па крыніцах; чаканыя паступленні паказаны асобна."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen, die zu diesem Monat gehören und bis heute eingegangen sind, nach Quelle; was noch erwartet wird, steht getrennt davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income that belongs to this month and has arrived by today, by source; what is still expected comes apart from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso que corresponde a este mes y ha llegado hasta hoy, por origen; lo que todavía se espera va aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus qui appartiennent à ce mois et sont arrivés jusqu'à aujourd'hui, par source ; ce qui est encore attendu en est séparé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate relative a questo mese e ricevute entro oggi, per fonte; quanto ancora atteso è indicato a parte."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айға тиесілі және бүгінгі күнге дейін келген табыс, дереккөзі бойынша; әлі күтілетіні одан бөлек көрсетіледі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochód należny za ten miesiąc i otrzymany do dziś, według źródła. Oczekiwane wpływy są pokazywane osobno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход, который относится к этому месяцу и пришёл к сегодняшнему дню, по источникам; ожидаемое показано отдельно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aya ait olup bugüne kadar gelen gelir, kaynağına göre; hâlâ beklenen tutar ayrıca gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід, що належить цьому місяцю і надійшов до сьогодні, за джерелами; те, що ще очікується, відокремлюється від нього."
          }
        }
      }
    },
    "why.rule.monthRest": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума, якую можна выдаткаваць цяпер, мінус плацяжы і сумы на пагашэнне даўгоў, зарэзерваваныя да сённяшняга дня ў першую дэкаду месяца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jetzt ausgegeben werden kann, abzüglich der Zahlungen und der Fälligkeiten von Schulden, die bis zum Tag zurückgehalten werden, in den ersten zehn Tagen des Monats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be spent now less the payments and the dues of debts held back through the day, in the first ten days of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se puede gastar ahora, menos los pagos y los vencimientos de deudas retenidos hasta el final del día, en los primeros diez días del mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui peut être dépensé maintenant, moins les paiements et les échéances de dettes mis de côté jusqu'à la fin de la journée, pendant les dix premiers jours du mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si può spendere ora, meno i pagamenti e le rate dei debiti accantonati per il giorno, nei primi dieci giorni del mese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір не жұмсауға болады, минус күн ішінде ұсталып қалған төлемдер мен берешек міндеттемелері; ай басындағы алғашқы он күнде."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota dostępna teraz do wydania minus płatności i raty długów zarezerwowane do dziś, w pierwszych dziesięciu dniach miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что можно тратить сейчас за вычетом платежей и сроков по долгам до этого дня — в первые десять дней месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an harcanabilir tutardan, ayın ilk on gününde gün sonuna kadar ayrılan ödemeler ve borç taksitleri çıkarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що можна витратити зараз мінус платежі й прострочені борги, утримані на сьогодні, у перші десять днів місяця."
          }
        }
      }
    },
    "why.rule.monthToDate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход гэтага месяца, атрыманы да сёння, мінус мае выдаткі ад 1-га чысла да сёння; абедзве сумы параўноўваюцца з тымі ж днямі мінулага месяца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen, die zu diesem Monat gehören und bis heute eingegangen sind, abzüglich meiner Ausgaben vom 1. bis heute; beides wird mit denselben Tagen des letzten Monats verglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income that belongs to this month and arrived by today, less my spending from the 1st to today; both are compared with the same days of last month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresos que corresponden a este mes y llegaron hasta hoy, menos mi gasto del 1 a hoy; ambos se comparan con los mismos días del mes pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus qui appartiennent à ce mois et sont arrivés jusqu'à aujourd'hui, moins mes dépenses du 1er à aujourd'hui ; les deux sont comparés aux mêmes jours du mois dernier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate relative a questo mese e ricevute entro oggi, meno le mie spese dal 1° a oggi; entrambe sono confrontate con gli stessi giorni del mese scorso."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айға тиесілі және бүгінге дейін келген табыс, минус 1-нен бүгінге дейінгі менің шығысым; екеуі де өткен айдың дәл сол күндерімен салыстырылады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochód należny za ten miesiąc i otrzymany do dziś minus moje wydatki od 1. dnia miesiąca do dziś. Obie kwoty są porównywane z tymi samymi dniami poprzedniego miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходы этого месяца, пришедшие по сегодня, минус мои расходы с 1-го числа по сегодня; оба сравниваются с теми же днями прошлого месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aya ait olup bugüne kadar gelen gelirden ayın 1’inden bugüne kadarki harcamam çıkarılır; ikisi de geçen ayın aynı günleriyle karşılaştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід, що належить цьому місяцю і надійшов до сьогодні, мінус мої витрати з 1-го по сьогодні; обидва порівнюються з тими самими днями минулого місяця."
          }
        }
      }
    },
    "why.rule.monthlySpending": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за кожны з апошніх дванаццаці месяцаў; за бягучы месяц — на сёння."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben in jedem der letzten zwölf Monate, der laufende bisher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of each of the last twelve months, the current one so far."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto de cada uno de los últimos doce meses, el actual hasta hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses de chacun des douze derniers mois, le mois en cours jusqu'à aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese di ciascuno degli ultimi dodici mesi; per il mese attuale, fino a oggi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы он екі айдың әрқайсысындағы менің шығысым, ағымдағы ай — осы уақытқа дейін."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w każdym z ostatnich dwunastu miesięcy, w tym wydatki w bieżącym miesiącu do dziś."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы за каждый из последних двенадцати месяцев, текущий — на сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son on iki ayın her birindeki harcamam; içinde bulunduğumuz ay için şu ana kadarki tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за кожен із останніх дванадцяти місяців, поточний — поки що."
          }
        }
      }
    },
    "why.rule.owedToMe": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Часткі, якія я аплаціў за іншых і чакаю назад: рэшта кожнай часткі пасля выліку вернутых грошай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile, die ich für andere bezahlt habe und die zurückerwartet werden: was von jedem übrig ist, wenn das zurückgegebene Geld abgezogen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parts I paid for others that are expected back: what is left of each once money back is taken off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partes que pagué por otros y que se espera que me devuelvan: lo que queda de cada una tras descontar el dinero devuelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parts que j'ai payées pour d'autres et qui doivent revenir : ce qui reste de chacune une fois l'argent rendu déduit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quote pagate per altri che devono essere restituite: il saldo di ciascuna quota dopo aver sottratto quanto già restituito."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқалар үшін төленген, қайтуы күтілетін бөліктер: ақша қайтарылғаннан кейін әрқайсысынан не қалғаны."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Części wydatków opłacone przeze mnie za innych, które mają zostać zwrócone, po odjęciu otrzymanych zwrotów."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Части, оплаченные за других и ещё ожидаемые назад: что осталось от каждой за вычетом уже вернувшихся денег."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başkaları için ödediğim ve geri almayı beklediğim paylar: her birinden geri ödenen tutar çıkarıldıktan sonra kalan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частини, які я сплатив за інших і які мають повернутися: що лишилося за кожною, після віднімання повернених грошей."
          }
        }
      }
    },
    "why.rule.qualities": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожная частка маіх выдаткаў за гэты месяц улічваецца паводле ацэнкі — добрая, нейтральная або дрэнная; долі разлічваюцца ад агульнай сумы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Teil meiner Ausgaben dieses Monats zählt unter seiner Bewertung — gut, neutral oder schlecht; die Anteile beziehen sich auf alle davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each part of my spending this month counts under its rating — good, neutral or bad; shares are of all of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada parte de mi gasto de este mes cuenta según su valoración — buena, neutral o mala; las partes son de todas ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque part de mes dépenses de ce mois compte selon sa note — utile, neutre ou superflu ; les parts sont calculées sur l'ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni parte delle mie spese di questo mese è conteggiata secondo la valutazione: buona, neutra o cattiva; le percentuali si riferiscono al totale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдағы шығысымның әр бөлігі өз бағасымен — жақсы, бейтарап немесе жаман — есептеледі; үлестер барлығынан алынады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda część moich wydatków w tym miesiącu jest uwzględniana zgodnie z oceną: dobra, neutralna lub zła. Udziały dotyczą wszystkich ocenionych wydatków."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая часть моих расходов этого месяца считается по своей оценке — хорошая, обычная или плохая; доли — от их суммы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamamın her bölümü değerlendirmesine göre sayılır: iyi, nötr veya kötü; oranlar tümü üzerinden hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна частина моїх витрат за місяць рахується за своєю оцінкою — добра, нейтральна чи погана; частки — від усіх них."
          }
        }
      }
    },
    "why.rule.ratesStatus": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата найноўшага курсу валюты ў праграме; банк не публікуе курсы ў выхадныя, таму некалькі дзён — гэта нармальна."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tag des neuesten Kurses einer Währung, die die App hält; die Bank veröffentlicht am Wochenende nicht, daher sind einige Tage normal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day of the newest rate of a currency the app holds; the bank does not publish on weekends, so a few days is normal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día del tipo más reciente de cada divisa que tiene la app; el banco no publica los fines de semana, así que unos días es normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du cours le plus récent d'une devise détenue par l'app ; la banque ne publie pas le week-end, donc quelques jours d'écart sont normaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data del tasso di cambio più recente disponibile nell’app; la banca non pubblica tassi nei fine settimana, quindi un ritardo di qualche giorno è normale."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба ұстайтын валютаның ең жаңа бағамының күні; банк демалыс күндері жарияламайды, сондықтан бірнеше күн кідіру қалыпты."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data najnowszego kursu waluty zapisanego w aplikacji. Bank nie publikuje kursów w weekendy, więc kilkudniowa przerwa jest normalna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День самого свежего курса валюты в приложении; по выходным банк не публикует, так что несколько дней — это нормально."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadaki en güncel döviz kurunun tarihi; banka hafta sonları kur yayımlamadığı için birkaç günlük fark normaldir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "День найновішого курсу валюти, яка є в застосунку; банк не публікує курси на вихідних, тож кілька днів — норма."
          }
        }
      }
    },
    "why.rule.savingsRate": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход за месяц мінус мае выдаткі (грошы на мэты адкладваюцца, а не трацяцца) — гэта зберажаная сума; яе доля ў даходзе — норма зберажэнняў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen des Monats abzüglich meiner Ausgaben (Geld in Ziele wird beiseitegelegt, nicht ausgegeben) bleiben übrig; ihr Anteil an den Einnahmen ist die Sparquote."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income of the month less my spending (money put into goals is put aside, not spent) is what is kept; its share of the income is the savings rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso del mes menos mi gasto (lo que se aporta a objetivos se aparta, no se gasta) es lo que se guarda; su parte del ingreso es la tasa de ahorro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus du mois moins mes dépenses (l'argent mis dans les objectifs est mis de côté, non dépensé) est ce qui reste ; sa part des revenus est le taux d'épargne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate del mese meno le mie spese danno la somma risparmiata; il denaro destinato agli obiettivi è accantonato, non speso. La percentuale delle entrate risparmiata è il tasso di risparmio."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың табысы, минус менің шығысым (мақсаттарға салынған ақша жұмсалмайды, бөлініп қойылады) — қалғаны; оның табыстағы үлесі — жинақ мөлшерлемесі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochód z miesiąca pomniejszony o wydatki to zaoszczędzona kwota. Wpłaty na cele są odkładane, a nie wydawane. Udział tej kwoty w dochodzie to stopa oszczędności."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход месяца минус мои траты (деньги в цели — отложенные, а не траты) — это то, что осталось; его доля в доходе и есть норма сбережений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın gelirinden harcamalarım çıkarıldığında kalan tutardır (hedeflere aktarılan para harcanmaz, biriktirilir). Bu tutarın gelire oranı tasarruf oranıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід місяця мінус мої витрати (гроші, відкладені в цілі, відкладаються, а не витрачаються) — це те, що лишилося; його частка від доходу і є нормою заощаджень."
          }
        }
      }
    },
    "why.rule.selfEmployment": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падатак за месяц: даход па курсе Банка Расіі на дзень атрымання × стаўка мінус вылік, з дакладнасцю да капейкі; сума менш за 100 ₽ пераносіцца на наступны месяц; тэрмін выплаты — 28-га чысла."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuer eines Monats: Einnahmen mal Satz der Bank of Russia ihres Tages, abzüglich des Abzugs, auf den Kopeken genau; unter 100 ₽ geht sie in den nächsten Monat; fällig am 28."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tax of a month: income by the rate of the Bank of Russia of its day × the rate, less the deduction, to the kopeck; below 100 ₽ it goes on to the next month; due on the 28th."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El impuesto de un mes: ingreso por la tasa del Banco de Rusia de su día × la tasa, menos la deducción, al kopek; por debajo de 100 ₽ pasa al mes siguiente; vence el día 28."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impôt d'un mois : revenus au taux de la Banque de Russie de leur jour × le taux, moins la déduction, au kopek près ; sous 100 ₽ il passe au mois suivant ; à payer le 28."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imposta del mese: entrate convertite al tasso della Banca di Russia del giorno × aliquota, meno la detrazione, al copeco; se inferiore a 100 ₽, passa al mese successivo; scade il 28."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың салығы: сол күнгі Ресей Банкінің бағамымен табыс × мөлшерлеме, минус шегерім, тиынға дейін; 100 ₽-тен аз болса, келесі айға өтеді; мерзімі — 28-і."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatek za miesiąc: dochód według kursu Banku Rosji z dnia uzyskania × stawka, pomniejszony o odliczenie, z dokładnością do kopiejki. Kwota poniżej 100 ₽ przechodzi na kolejny miesiąc. Termin płatności: 28. dzień miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог месяца: доход по курсу ЦБ дня × ставка минус вычет, до копейки; меньше 100 ₽ переносится; срок — 28-е следующего месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık vergi: Gelirin işlem günündeki Rusya Merkez Bankası kuruyla hesaplanan tutarı × oran, indirim düşülerek kopek hassasiyetinde hesaplanır. 100 ₽ altındaki tutar sonraki aya devreder; son ödeme günü ayın 28’idir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Податок за місяць: дохід за ставкою Банку Росії його дня × ставка, мінус вирахування, до копійки; менше 100 ₽ переходить на наступний місяць; сплачується 28-го."
          }
        }
      }
    },
    "why.rule.smallPurchases": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мая доля выдаткаў за месяц у межах зададзенага ліміту, без неабходных катэгорый, мэт і лічыльнікаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Anteile an den Ausgaben dieses Monats, die nicht mehr kosten als das Limit, das Sie festgelegt haben, außerhalb der notwendigen Kategorien, der Ziele und der Zählungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My parts of this month's spending that cost no more than the limit you set, outside the essential categories, the goals and the counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis partes del gasto de este mes que cuestan no más que el límite que fijó, fuera de las categorías esenciales, los objetivos y los recuentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes parts des dépenses de ce mois qui ne coûtent pas plus que le plafond que vous avez fixé, hors catégories essentielles, objectifs et comptages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie quote delle spese di questo mese entro il limite impostato, escluse categorie essenziali, obiettivi e conteggi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдағы шығысымның сіз белгілеген лимиттен аспайтын бөліктері; міндетті санаттардан, мақсаттардан және санаулардан тыс."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje części wydatków z tego miesiąca, które nie przekraczają ustawionego limitu, z wyłączeniem kategorii niezbędnych, celów i przeliczeń."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои части трат этого месяца не дороже заданного вами предела, вне необходимых категорий, целей и сверок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamalardan payıma düşen, belirlediğiniz limiti aşmayan tutarlar; zorunlu kategoriler, hedefler ve sayımlar hariç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої частки витрат цього місяця, що коштують не більше за ваш ліміт, поза необхідними категоріями, цілями й підрахунками."
          }
        }
      }
    },
    "why.rule.spendToday": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мая доля ўсіх сённяшніх аперацый за вылікам вяртанняў у параўнанні з сярэднім за папярэднія дні з апошніх 28."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ich heute ausgegeben habe — mein Anteil an jedem Vorgang des Tages, Erstattungen abgezogen — gegenüber dem Durchschnitt der Tage davor über die letzten 28."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What I spent today — my share of every operation of the day, refunds taken off — against the average of the days before it over the last 28."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que gasté hoy — mi parte de cada operación del día, descontadas las devoluciones — frente a la media de los días anteriores de los últimos 28."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que j'ai dépensé aujourd'hui — ma part de chaque opération du jour, remboursements déduits — comparé à la moyenne des jours précédents sur les 28 derniers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mia quota delle operazioni di oggi, al netto dei rimborsi, rispetto alla media dei giorni precedenti negli ultimi 28 giorni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін жұмсағаным — күнің әр операциясындағы менің үлесім, қайтарулар алынып тасталған — соңғы 28 күннің алдындағы күндердің орташасымен салыстырғанда."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje dzisiejsze wydatki — mój udział w każdej operacji, pomniejszony o zwroty — w porównaniu ze średnią z poprzednich dni w ciągu ostatnich 28 dni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько я потратил сегодня — моя доля каждой операции дня за вычетом возвратов — против среднего за предыдущие 28 дней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü harcamam (günün her işleminden payıma düşen tutar, iadeler düşüldükten sonra) ile son 28 gündeki önceki günlerin ortalaması."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки я витратив сьогодні — моя частка кожної операції дня, мінус повернення — порівняно із середнім за попередні дні за останні 28."
          }
        }
      }
    },
    "why.rule.spendingByPerson": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за месяц па полі «на кого» з зададзенымі вамі назвамі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben des Monats nach „für wen“; die Namen sind die, die Sie vergeben haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of the month by «на кого»; the names are the ones you gave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto del mes por «para quién»; los nombres son los que usted puso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses du mois par « pour qui » ; les noms sont ceux que vous avez donnés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese per «на кого», con i nomi che hai assegnato."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдағы менің шығысым «кім үшін» бойынша; аттары сіз берген атаулар."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu według «на кого»; nazwy są takie, jakie podano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы месяца по «на кого»; названия — те, что вы дали."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamalarım «на кого» alanına göre gösterilir; adlar sizin verdiğiniz adlardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за місяць за полем «для кого»; імена такі, як ви їх вказали."
          }
        }
      }
    },
    "why.rule.spendingCalendar": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за кожны дзень гэтага тыдня без розніц зверкі. Адзначаны дні, калі выдаткі былі значна большыя за звычайныя за апошнія 90 дзён."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben jedes Tages dieser Woche, Abgleichdifferenzen ausgenommen; ein Tag ist markiert, wenn er viel mehr gekostet hat als der übliche Tag der letzten 90."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of each day of this week, reconciliation differences left out; a day is marked when it cost much more than the usual day of the last 90 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto de cada día de esta semana, sin las diferencias de conciliación; un día se marca cuando costó mucho más que el día habitual de los últimos 90."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses de chaque jour de cette semaine, sans les écarts de comptage ; un jour est marqué quand il a coûté bien plus que le jour habituel des 90 derniers jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese per ogni giorno della settimana, escluse le differenze di riconciliazione. Sono evidenziati i giorni con spese molto superiori alla norma degli ultimi 90 giorni."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы аптаның әр күнідегі менің шығысым, санау айырмалары есепке алынбайды; күн соншама белгіленеді, егер ол соңғы 90 күннің әдеттегі күнінен едәуір көп тұрса."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w poszczególnych dniach tego tygodnia, bez różnic z rozliczenia. Dzień jest oznaczony, gdy wydatki znacznie przekraczają typowy dzień z ostatnich 90 dni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои траты каждого дня этой недели без разниц сверок; день отмечен, если он заметно дороже обычного дня за последние 90 дней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haftanın her günü için harcamalarım, mutabakat farkları hariç gösterilir. Son 90 gündeki sıradan bir günden çok daha fazla harcanan gün işaretlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за кожен день цього тижня, без різниць звірки; день позначається, коли витрачено значно більше, ніж у звичайний день за останні 90."
          }
        }
      }
    },
    "why.rule.spendingForecast": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ужо патрачанае, будучыя плацяжы за гэты месяц і звычайныя выдаткі за дні, што засталіся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was bisher ausgegeben ist, plus die noch fälligen Zahlungen dieses Monats, plus was die verbleibenden Tage üblicherweise dazugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is spent so far, plus the payments still due this month, plus what the days left usually add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo gastado hasta ahora, más los pagos todavía pendientes de este mes, más lo que suelen sumar los días que quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est dépensé jusqu'ici, plus les paiements encore dus ce mois-ci, plus ce que les jours restants ajoutent habituellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese finora, più i pagamenti ancora dovuti questo mese e le spese abituali dei giorni rimanenti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы уақытқа дейін жұмсалған, плюс осы айда әлі төленетін төлемдер, плюс қалған күндер әдетте қосатын сома."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotychczasowe wydatki, płatności pozostałe w tym miesiącu oraz typowe wydatki na pozostałe dni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже потраченное, плюс ещё не оплаченные платежи месяца, плюс то, что обычно добавляют оставшиеся дни."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye kadarki harcamalara bu ay ödenecek tutarlar ve kalan günlerde genellikle yapılan harcamalar eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що витрачено вже, плюс платежі, що ще належать цього місяця, плюс те, що зазвичай додають дні, які лишилися."
          }
        }
      }
    },
    "why.rule.subscriptions": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Месячны кошт дзейных падпісак па курсе дня, спачатку найдаражэйшыя. Скасаваная падпіска ўлічваецца да даты скасавання."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die laufenden Abos im Monat kosten, jedes zum Kurs des Tages; das teuerste zuerst. Ein Abo, das ab einem späteren Tag gekündigt ist, zählt bis dahin weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the running subscriptions cost a month, each at the rate of the day; the priciest first. A subscription cancelled from a later day still counts until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cuestan al mes las suscripciones activas, cada una al tipo del día; primero las más caras. Una suscripción cancelada desde un día posterior cuenta hasta entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que coûtent les abonnements en cours par mois, chacun au cours du jour ; le plus cher d'abord. Un abonnement résilié à partir d'un jour ultérieur compte encore jusqu'à cette date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il costo mensile degli abbonamenti attivi, al tasso del giorno, dal più costoso. Un abbonamento annullato da una data futura viene conteggiato fino a quella data."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жұмыс істеп тұрған жазылымдардың айына кететіні, әрқайсысы сол күнгі бағам бойынша; ең қымбаты бірінші. Кейінгі күннен бастап тоқтатылған жазылым сол күнге дейін әлі саналады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesięczny koszt aktywnych subskrypcji, każdej według kursu z danego dnia, od najdroższej. Anulowana subskrypcja jest uwzględniana do dnia jej zakończenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько в месяц стоят действующие подписки, каждая по курсу дня, дорогие первыми. Подписка, отменённая с будущего дня, считается до него."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin aboneliklerin her biri günün kuruyla hesaplanan aylık maliyeti, en pahalıdan başlayarak gösterilir. İleri bir tarihte iptal edilecek abonelik o tarihe kadar dahil edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки коштують діючі підписки за місяць, кожна за курсом дня; найдорожчі — першими. Підписка, скасована з пізнішого дня, рахується до нього."
          }
        }
      }
    },
    "why.rule.topCategories": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за месяц па галоўных катэгорыях, спачатку найбольшыя. Доля лічыцца ад усіх выдаткаў без розніц зверкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben dieses Monats nach Hauptkategorie, die größte zuerst; ein Anteil bezieht sich auf alles ausgegebene Geld, Abgleichdifferenzen sind ausgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending this month by top-level category, the largest first; a share is of all the money spent, and reconciliation differences are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto de este mes por categoría principal, de mayor a menor; una parte es de todo el dinero gastado, y las diferencias de conciliación se dejan fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses de ce mois par catégorie de premier niveau, la plus grande d'abord ; une part se calcule sur tout l'argent dépensé, et les écarts de comptage sont exclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese per categoria principale, dalla più alta. Le percentuali si riferiscono al totale speso, escluse le differenze di riconciliazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдағы менің шығысым жоғарғы деңгейдегі санат бойынша, ең үлкені бірінші; үлес — барлық жұмсалған ақшадан, санау айырмалары есепке алынбайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu według kategorii głównych, od największej. Udział odnosi się do wszystkich wydatków, bez różnic z rozliczenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы этого месяца по категориям верхнего уровня, крупные первыми; доля — от всех потраченных денег, разницы сверок не входят."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamalarım ana kategoriye göre, en büyükten başlayarak gösterilir. Oran, toplam harcama içindeki paydır; mutabakat farkları dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за місяць за категоріями верхнього рівня, найбільші першими; частка — від усіх витрачених грошей, різниці звірки не враховуються."
          }
        }
      }
    },
    "why.rule.topPlaces": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за месяц па месцах. Меншыя сумы і выдаткі без месца аб'яднаны ў адзін радок."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben des Monats nach Ort; die kleineren Orte und die Ausgaben ohne Ort bilden eine Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of the month by place; the smaller places and spending with no place are one line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto del mes por lugar; los lugares más pequeños y el gasto sin lugar forman una sola línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses du mois par lieu ; les petits lieux et les dépenses sans lieu forment une seule ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese per luogo. I luoghi meno frequenti e le spese senza luogo sono raggruppati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдағы менің шығысым орын бойынша; кіші орындар мен орыны жоқ шығын бір жол болады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu według miejsca. Mniejsze miejsca i wydatki bez miejsca są ujęte w jednym wierszu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы месяца по местам; мелкие места и траты без места — одной строкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamalarım yere göre gösterilir; daha küçük yerler ve yer belirtilmeyen harcamalar tek satırda toplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за місяць за місцями; менші місця і витрати без місця — один рядок."
          }
        }
      }
    },
    "why.rule.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нявыплачаныя плацяжы і наступныя выплаты па даўгах на тыдзень наперад, спачатку пратэрмінаваныя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbezahlte Fälligkeiten von Zahlungen und nächste Schuldenzahlungen bis eine Woche voraus, die überfälligen zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpaid due dates of payments and next debt payments up to a week ahead, the overdue ones first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vencimientos sin pagar de pagos y próximos pagos de deudas hasta una semana por delante, primero los atrasados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échéances non payées des paiements et les prochains remboursements de dettes, jusqu'à une semaine à l'avance ; les échues en premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scadenze non pagate e i prossimi pagamenti dei debiti entro una settimana, a partire da quelli scaduti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апта алдын ала дейінгі төленбеген төлемдер мен берешектің келесі төлемдері, мерзімі өткендері алдымен."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadchodzące w ciągu tygodnia niezapłacone płatności i kolejne spłaty długów, najpierw zaległe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неоплаченные сроки платежей и ближайшие платежи по долгам на неделю вперёд, просроченные — первыми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hafta içindeki ödenmemiş ödeme vadeleri ve sıradaki borç ödemeleri, gecikenler önce gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неоплачені дати платежів і найближчі платежі за борги на тиждень уперед, спершу прострочені."
          }
        }
      }
    },
    "why.rule.usualDay": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Медыяна дзённых выдаткаў за апошнія 90 дзён асобна для будняў і выходных, без аднаразовых пакупак."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Median der Tage mit Ausgaben in den letzten 90 Tagen, getrennt für Werktage und Wochenendtage; einmalige Käufe ausgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The median of the days with spending in the last 90 days, told apart for weekdays and weekend days; one-off purchases left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mediana de los días con gasto de los últimos 90 días, separada para días laborables y fines de semana; las compras puntuales se dejan fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La médiane des jours avec dépenses des 90 derniers jours, distincte pour les jours de semaine et de week-end ; les achats ponctuels sont exclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mediana dei giorni con spese negli ultimi 90 giorni, distinta tra giorni feriali e fine settimana, esclusi gli acquisti occasionali."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 90 күнде шығыс болған күндердің медианасы, жұмыс күндері мен демалыс күндері бөлек; бір реттік сатып алулар есепке алынбайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediana wydatków w dniach z wydatkami w ciągu ostatnich 90 dni, osobno dla dni roboczych i weekendów, bez jednorazowych zakupów."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиана дней с тратами за последние 90 дней отдельно для будней и выходных; разовые не входят."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 90 günde harcama yapılan günlerin medyanı, hafta içi ve hafta sonu günleri için ayrı hesaplanır; tek seferlik alışverişler dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіана днів із витратами за останні 90 днів, окремо для будніх і вихідних; разові покупки не враховуються."
          }
        }
      }
    },
    "why.rule.weekOverWeek": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі з панядзелка па сёння ў параўнанні з тымі ж днямі мінулага тыдня."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben von Montag bis heute gegenüber denselben Wochentagen davor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending from Monday through today against the same days of the week before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto desde el lunes hasta hoy frente a los mismos días de la semana anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses du lundi jusqu'à aujourd'hui, comparées aux mêmes jours de la semaine précédente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese da lunedì a oggi rispetto agli stessi giorni della settimana precedente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дүйсенбіден бүгінге дейінгі менің шығысым, өткен аптаның дәл сол апта күндерімен салыстырғанда."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki od poniedziałku do dziś w porównaniu z tymi samymi dniami poprzedniego tygodnia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы с понедельника по сегодня против тех же дней прошлой недели."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazartesiden bugüne kadar olan harcamalarım ile geçen haftanın aynı günleri karşılaştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати з понеділка по сьогодні порівняно з тими самими днями тижня перед ним."
          }
        }
      }
    },
    "why.rule.weekdaySpending": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за апошнія дванаццаць тыдняў па днях тыдня; сярэдняе — за адзін такі дзень."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben der letzten zwölf Wochen, nach Wochentag addiert; der Durchschnitt bezieht sich auf einen solchen Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of the last twelve weeks added up by day of the week; the average is of one such day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto de las últimas doce semanas sumado por día de la semana; la media es de un día de esos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses des douze dernières semaines additionnées par jour de la semaine ; la moyenne porte sur un seul de ces jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese delle ultime dodici settimane, sommate per giorno della settimana. La media si riferisce a un singolo giorno."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы он екі аптадағы менің шығысым апта күні бойынша қосылған; орташа — сондай бір күнге."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki z ostatnich dwunastu tygodni zsumowane według dnia tygodnia. Średnia dotyczy jednego takiego dnia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы за последние двенадцать недель, сложенные по дням недели; среднее — за один такой день."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son on iki haftadaki harcamalarım haftanın gününe göre toplanır; ortalama, o günlerden birine aittir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за останні дванадцять тижнів, підсумовані за днем тижня; середнє — за один такий день."
          }
        }
      }
    },
    "why.rule.weekendPrice": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за гэты месяц у гадзіны, вызначаныя ў наладах як выходныя, уключна з аднаразовымі пакупкамі. Побач — сума за мінулы месяц."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ich diesen Monat in den Stunden ausgegeben habe, die die Einstellungen als Wochenende bezeichnen, eine Summe, die einmalige Käufe enthält; der Monat davor steht daneben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What I spent this month in the hours the settings call the weekend, a total that keeps one-off purchases; the month before is beside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que gasté este mes en las horas que los ajustes llaman fin de semana, un total que mantiene las compras puntuales; el mes anterior va al lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que j'ai dépensé ce mois-ci aux heures que les réglages appellent le week-end, un total qui garde les achats ponctuels ; le mois précédent est à côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese nelle ore definite come fine settimana nelle impostazioni, inclusi gli acquisti occasionali, a confronto con il mese precedente."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда параметрлер демалыс деп атаған сағаттардағы менің шығысым, бір реттік сатып алуларды қоса алғандағы жиын; алдыңғы ай жанында тұр."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu w godzinach określonych w ustawieniach jako weekend, łącznie z jednorazowymi zakupami. Obok widoczna jest kwota z poprzedniego miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько я потратил в этом месяце в часы, которые настройки считают выходными, итогом вместе с разовыми; рядом — прошлый месяц."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay ayarlarda hafta sonu olarak tanımlanan saatlerde yaptığım harcamaların toplamı, tek seferlik alışverişler dahil gösterilir; yanında önceki ay yer alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки я витратив цього місяця в години, які налаштування називають вихідними; підсумок, у якому враховуються разові покупки; поруч — попередній місяць."
          }
        }
      }
    },
    "why.rule.worthALook": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Незвычайныя падзеі за апошні месяц, знойдзеныя правіламі, грошы мэт, якія, магчыма, патрачаны, і рэшткі на архіўных рахунках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungewöhnliche Dinge des letzten Monats, die die Regeln gefunden haben, Zielgeld, das ausgegeben scheint, und Geld auf archivierten Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unusual things of the last month the rules found, goal money that seems spent, and money left on archived accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosas fuera de lo normal del último mes que encontraron las reglas, dinero de objetivos que parece gastado, y dinero en cuentas archivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choses inhabituelles du dernier mois relevées par les règles, l'argent des objectifs qui semble dépensé, et l'argent resté sur des comptes archivés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le anomalie rilevate nell’ultimo mese, i fondi degli obiettivi che sembrano spesi e il denaro rimasto sui conti archiviati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер тапқан соңғы айдағы ерекше нәрселер, мақсат ақшасы жұмсалған сияқты және мұрағаттағы есеп-шоттарда қалған ақша."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nietypowe sytuacje wykryte przez reguły w ostatnim miesiącu, środki na cele, które wyglądają na wydane, oraz środki pozostałe na zarchiwizowanych kontach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необычное за последний месяц, найденное правилами, деньги целей, которые похоже потрачены, и деньги на счетах в архиве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuralların son bir ayda bulduğu olağandışı durumlar, harcanmış görünen hedef parası ve arşivlenmiş hesaplarda kalan para."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Незвичні речі за останній місяць, які знайшли правила, гроші цілей, що здаються витраченими, і гроші на архівних рахунках."
          }
        }
      }
    },
    "why.savings.accounts": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рублі, пераведзеныя ў падушку бяспекі і на дэпазіты, за вылікам зняццяў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubel, in das Polster und Einlagen verschoben, netto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubles moved into the cushion and deposits, net"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rublos pasados al colchón y a depósitos, neto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Roubles versés dans le matelas et les dépôts, net"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubli trasferiti nel fondo di emergenza e nei depositi, al netto"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастыққа және салымдарға аударылған рубльдер, таза"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruble przelane do poduszki finansowej i na lokaty, netto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рубли, переведённые в подушку и на вклады, за вычетом снятых"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvence fonuna ve mevduatlara aktarılan net ruble"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рублі, переведені в подушку й депозити, за вирахуванням"
          }
        }
      }
    },
