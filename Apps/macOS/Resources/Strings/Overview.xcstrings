    "overview.small.field.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole rubles. The tile «Small purchases» on Overview adds up the purchases of the month up to this sum. Empty — not set."
