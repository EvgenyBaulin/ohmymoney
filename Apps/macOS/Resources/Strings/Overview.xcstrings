            "value": "Астаткі даўгоў улічваюцца толькі тут і ў чыстым капітале, але не ў паказчыках месяца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schuldensalden zählen hier und nur im Vermögen, nicht in den Zahlen des Monats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debt balances count here and in Net Worth only, not in the figures of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos de deudas cuentan solo aquí y en el Patrimonio neto, no en las cifras del mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes de dettes comptent ici et dans le Patrimoine net seulement, pas dans les chiffres du mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi dei debiti sono inclusi solo qui e nel patrimonio netto, non nei dati del mese."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Берешек теңгерімдері тек осы жерде және Таза байлықта есептеледі, айдың көрсеткіштерінде емес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salda długów są uwzględnione tylko tutaj i w wartości netto, nie w podsumowaniu miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки долгов считаются только здесь и в «Капитале», не в цифрах месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Borç bakiyeleri yalnızca burada ve Net Varlık'ta sayılır, aylık tutarlara dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки боргів рахуються тут і лише в «Капіталі», а не в цифрах місяця."
          }
        }
      }
    },
