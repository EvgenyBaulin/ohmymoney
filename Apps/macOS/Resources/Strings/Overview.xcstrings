    "calendar.lowData": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова даных для звычайнага дня: патрэбна 14 дзён з выдаткамі за апошнія 90 дзён"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Daten für einen üblichen Tag: Es braucht 14 Tage mit Ausgaben in den letzten 90"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too little data to tell a usual day: it takes 14 days with spending in the last 90"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati insufficienti per stimare un giorno tipo: servono 14 giorni con spese negli ultimi 90"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі күнді анықтау үшін деректер аз: соңғы 90 күннің ішінде шығыс бар 14 күн керек"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных, чтобы понять, какой день обычный: нужно 14 дней с тратами за 90 дней"
          }
        }
      }
    },
