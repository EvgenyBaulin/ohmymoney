            "state": "translated",
            "value": "Bu ay gəlir gözlənilmir: adi ay son tam ayların medianıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы даход не чакаецца: звычайны месяц вызначаецца паводле медыяны апошніх поўных месяцаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento měsíc se neočekává žádný příjem. Obvyklý měsíc odpovídá mediánu posledních celých měsíců."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat wird keine Einnahme erwartet: Der übliche Monat ist der Median der letzten vollen Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No income is expected this month: the usual month is the median of the last full months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mes no se espera ningún ingreso: el mes habitual es la mediana de los últimos meses completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun revenu n'est attendu ce mois-ci : le mois habituel est la médiane des derniers mois complets."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս եկամուտ չի սպասվում․ սովորական ամսվա ցուցանիշը վերջին ամբողջական ամիսների մեդիանն է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna entrata prevista questo mese: il mese abituale è la mediana degli ultimi mesi completi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში შემოსავალი მოსალოდნელი არ არის: ჩვეულებრივი თვე ბოლო სრული თვეების მედიანით განისაზღვრება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда табыс күтілмейді: әдеттегі ай — соңғы толық айлардың медианасы."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда киреше күтүлбөйт: кадимки ай — акыркы толук айлардын медианасы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu nie są oczekiwane przychody: typowy miesiąc to mediana z ostatnich pełnych miesięcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma renda prevista para este mês: o mês habitual é a mediana dos últimos meses completos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há rendimentos esperados este mês: o mês habitual é a mediana dos últimos meses completos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожиданий в этом месяце нет: обычный месяц — медиана последних полных месяцев."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин моҳ даромад интизор нест: моҳи маъмулӣ медианаи моҳҳои пурраи охир аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay gelir beklenmiyor: olağan aylık gelir, son tam ayların medyanıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього місяця дохід не очікується: звичайний місяць — медіана останніх повних місяців."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy daromad kutilmayapti: odatiy oy oxirgi to‘liq oylar medianasi asosida hisoblangan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月沒有預期收入：一般月份以最近完整月份的中位數計算。"
          }
        }
      }
    },
    "why.income.source.receivedOnly": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız daxil olan məbləğ: hələ başqa məlumat yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі ўжо атрыманыя грошы: іншых даных для разліку пакуль няма."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze již přijaté příjmy. Zatím není z čeho dalšího vycházet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur was schon eingegangen ist: Es gibt noch nichts anderes, woran man sich halten könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what already came: there is nothing else to go by yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lo que ya llegó: todavía no hay nada más en que basarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement ce qui est déjà entré : il n'y a encore rien d'autre sur quoi s'appuyer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն արդեն ստացվածը․ այլ տվյալներ դեռ չկան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quanto già ricevuto: non ci sono ancora altri dati su cui basarsi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ უკვე მიღებული შემოსავალი: სხვა მონაცემები ჯერ არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек келгені ғана бар: сүйенетін басқа ештеңе әлі жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Түшкөн сумма гана: азырынча башка негиз жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko otrzymane środki: brak innych podstaw do szacunku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o que já foi recebido: ainda não há outros dados para estimar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o que já recebeu: ainda não há outros dados de referência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только уже пришедшее: больше опереться пока не на что."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо маблағи гирифташуда: ҳоло маълумоти дигар нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca alınan gelir: henüz başka veri yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише те, що вже надійшло: спертися поки що ні на що."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat olingan daromad: hozircha boshqa ma’lumot yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅計入已收到的收入：目前沒有其他可供估算的資料。"
          }
        }
      }
    },
