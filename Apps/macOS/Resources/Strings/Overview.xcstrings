        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նպատակներում կա %1$@, ամփոփման հաշիվներում՝ %2$@։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli obiettivi contengono %1$@, i conti nel riepilogo %2$@."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიზნებისთვის გადადებულია %1$@, შეჯამების ანგარიშებზეა %2$@."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсаттарда %1$@, қорытындыдағы есеп-шоттарда %2$@."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Максаттарда %1$@, жыйнактагы эсептерде %2$@ бар."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środki na cele: %1$@, na kontach w podsumowaniu: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As metas têm %1$@; as contas no resumo, %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os objetivos têm %1$@; as contas no resumo têm %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На целях %1$@, а на счетах в сводке — %2$@."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҳадафҳо %1$@, дар ҳисобҳои ҷамъбаст %2$@ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedeflerde %1$@, özetteki hesaplarda %2$@ var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цілях %1$@, на рахунках у підсумку %2$@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maqsadlarda %1$@, sharhdagi hisoblarda %2$@ bor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標金額為 %1$@，摘要帳戶餘額為 %2$@。"
          }
        }
      }
    },
