    "calendar.lowData": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Adi günü müəyyən etmək üçün məlumat azdır: son 90 gündə xərc olan 14 gün lazımdır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова даных для звычайнага дня: патрэбна 14 дзён з выдаткамі за апошнія 90 дзён"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro určení obvyklého dne je málo dat: za posledních 90 dní je potřeba 14 dní s výdaji"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Daten für einen üblichen Tag: Es braucht 14 Tage mit Ausgaben in den letzten 90"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too little data to tell a usual day: it takes 14 days with spending in the last 90"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocos datos para saber qué es un día habitual: hacen falta 14 días con gasto en los últimos 90"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de données pour définir un jour habituel : il faut 14 jours avec dépenses sur les 90 derniers"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սովորական օրը որոշելու համար տվյալները քիչ են. վերջին 90 օրում անհրաժեշտ է ծախսով 14 օր"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati insufficienti per stimare un giorno tipo: servono 14 giorni con spese negli ultimi 90"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩვეულებრივი დღის დასადგენად მონაცემები არ კმარა: ბოლო 90 დღეში ხარჯიანი 14 დღეა საჭირო"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі күнді анықтау үшін деректер аз: соңғы 90 күннің ішінде шығыс бар 14 күн керек"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаттагы күндү аныктоого маалымат жетишсиз: акыркы 90 күндүн ичинде чыгым болгон 14 күн керек"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych, aby określić typowy dzień: potrzeba 14 dni z wydatkami w ciągu ostatnich 90 dni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados insuficientes para definir um dia normal: são necessários 14 dias com gastos nos últimos 90"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados insuficientes para determinar um dia habitual: são necessários 14 dias com despesas nos últimos 90"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных, чтобы понять, какой день обычный: нужно 14 дней с тратами за 90 дней"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои муайян кардани рӯзи маъмул маълумот кам аст: дар 90 рӯзи охир 14 рӯзи харҷдор лозим аст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal bir günü belirlemek için yeterli veri yok: Son 90 günde harcama yapılan 14 gün gerekli"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замало даних, щоб визначити звичайний день: потрібно 14 днів із витратами за останні 90"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatdagi kunni aniqlash uchun ma’lumot kam: oxirgi 90 kunda xarajatli 14 kun kerak"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料不足，無法判斷平常支出：過去 90 天內須有 14 天有支出"
          }
        }
      }
    },
