    "why.savings.noIncome": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay hələ gəlir yoxdur, ona görə pay hesablamaq mümkün deyil."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даходу за гэты месяц яшчэ няма, таму долю вылічыць нельга."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento měsíc zatím nemáte příjmy, takže podíl nelze vypočítat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat gibt es noch keine Einnahmen, daher gibt es keinen Anteil zu zählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no income this month yet, so there is no share to count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ingresos este mes, así que no hay parte que contar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de revenu ce mois-ci, donc pas de part à calculer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս դեռ եկամուտ չկա, ուստի բաժինը հնարավոր չէ հաշվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora entrate questo mese, quindi non è possibile calcolare la percentuale."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში შემოსავალი ჯერ არ არის, ამიტომ წილი ვერ გამოითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда әлі табыс жоқ, сондықтан санайтын үлес жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда киреше боло элек, ошондуктан үлүштү эсептөө мүмкүн эмес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miesiącu nie ma jeszcze dochodu, więc nie można obliczyć udziału."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há renda neste mês para calcular a participação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há rendimento este mês, pelo que não é possível calcular a percentagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохода в этом месяце ещё нет, доли считать не от чего."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло даромади ин моҳ нест, бинобар ин ҳисса ҳисоб намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay henüz gelir yok, bu yüzden oran hesaplanamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходу цього місяця ще немає, тож частку рахувати нема з чого."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy hali daromad yo‘q, shuning uchun ulush hisoblanmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月尚無收入，因此無法計算占比。"
          }
        }
      }
    },
