        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мала месца для копій базы даных: свабодна %@. Вызваліць месца можна ў Налады → Рэзервовыя копіі; нічога не выдаляецца аўтаматычна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Málo místa pro kopie databáze: volné místo %@. Místo můžete uvolnit v Nastavení → Zálohy; nic se nemaže samo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Platz für Kopien der Datenbank: %@ frei. Einstellungen → Sicherungen können etwas freigeben; von selbst wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little room for copies of the database: %@ free. Settings → Backups can free some; nothing is deleted on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco espacio para las copias de la base de datos: libres %@. Ajustes → Copias de seguridad puede liberar algo; nada se elimina por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de place pour les copies de la base : %@ libres. Réglages → Sauvegardes peut en libérer ; rien n'est supprimé de soi-même."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների բազայի պատճենների համար քիչ տեղ կա. ազատ է %@։ Կարգավորումներ → Պահուստային պատճեններ բաժնում կարող եք տեղ ազատել։ Ինքնաբերաբար ոչինչ չի ջնջվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco spazio per le copie del database: %@ disponibili. Puoi liberarne in Impostazioni → Backup; nulla viene eliminato automaticamente."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონაცემთა ბაზის ასლებისთვის ადგილი ცოტაა: თავისუფალია %@. სივრცის გათავისუფლება შეგიძლიათ: პარამეტრები → სარეზერვო ასლები. არაფერი წაიშლება თავისით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқор көшірмелеріне орын аз: бос %@. Параметрлер → Резервтік көшірмелер кейбірін босатады; өздігінен ештеңе жойылмайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат базасынын көчүрмөлөрү үчүн орун аз: %@ бош. Жөндөөлөр → Камдык көчүрмөлөр бөлүмүнөн орун бошотсоңуз болот; эч нерсе өзүнөн өзү өчүрүлбөйт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mało miejsca na kopie bazy danych: %@ wolnego. Możesz je zwolnić w Ustawieniach → Kopie zapasowe; nic nie jest usuwane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco espaço para cópias do banco de dados: %@ livres. Você pode liberar espaço em Ajustes → Backups; nada é apagado automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco espaço para cópias da base de dados: %@ livres. Pode libertar espaço em Definições → Cópias de segurança; nada é apagado automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало места для копий базы: свободно %@. В «Настройки → Бэкапы» можно освободить место; само ничего не удаляется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои нусхаҳои пойгоҳи додаҳо ҷой кам аст: %@ холӣ. Дар Танзимот → Нусхаҳои эҳтиётӣ ҷойро холӣ кардан мумкин аст; чизе худ аз худ нест намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanı kopyaları için az yer kaldı: %@ boş. Ayarlar → Yedeklemeler bölümünden yer açabilirsiniz; hiçbir şey otomatik silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замало місця для копій бази: вільно %@. «Налаштування → Резервні копії» можуть звільнити частину; нічого не видаляється самостійно."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasi nusxalari uchun joy kam: %@ bo‘sh. Sozlamalar → Zaxira nusxalar bo‘limida joy bo‘shatish mumkin; hech narsa o‘z-o‘zidan o‘chirilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫備份空間不足：剩餘 %@。可在「設定」→「備份」釋出空間；資料不會自動刪除。"
          }
        }
      }
    },
