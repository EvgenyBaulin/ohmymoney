    "why.income.source.median": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтым месяцы даход не чакаецца: звычайны месяц вызначаецца паводле медыяны апошніх поўных месяцаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat wird keine Einnahme erwartet: Der übliche Monat ist der Median der letzten vollen Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No income is expected this month: the usual month is the median of the last full months."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna entrata prevista questo mese: il mese abituale è la mediana degli ultimi mesi completi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда табыс күтілмейді: әдеттегі ай — соңғы толық айлардың медианасы."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожиданий в этом месяце нет: обычный месяц — медиана последних полных месяцев."
          }
        }
      }
    },
