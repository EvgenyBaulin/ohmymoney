    "calendar.legend.level": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day fill: spending above usual, lighter is a little, deeper is much"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relleno del día: gasto por encima de lo habitual; más claro es poco, más oscuro es mucho"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplissage du jour : dépenses au-dessus de l'habituel, plus clair pour un peu, plus foncé pour beaucoup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заливка дня — траты выше обычного: светлая — немного, насыщенная — намного"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заповнення дня: витрати понад звичайні; світліше — трохи, темніше — значно"
          }
        }
      }
    },
