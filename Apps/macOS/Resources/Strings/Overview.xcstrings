    "why.refreshing": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartdakı göstərici yenilənir və bir müddət fərqli ola bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Значэнне на плітцы абнаўляецца і на момант можа адрознівацца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaj na dlaždici se aktualizuje a může se chvíli lišit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl der Kachel wird gerade aktualisiert und kann für einen Moment abweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The figure on the tile is being refreshed and may differ for a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cifra del mosaico se está actualizando y puede diferir un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffre de la tuile est en cours d'actualisation et peut différer un instant."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սալիկի ցուցանիշը թարմացվում է և մի պահ կարող է տարբերվել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore nel riquadro è in aggiornamento e potrebbe differire per qualche istante."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფილაზე მაჩვენებელი ახლდება და შეიძლება დროებით განსხვავდებოდეს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тақтайшадағы сан жаңартылып жатыр және бір сәт өзгеше болуы мүмкін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тактакчадагы көрсөткүч жаңыланып жатат жана бир азга айырмаланышы мүмкүн."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość na kafelku jest odświeżana i może się chwilowo różnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor do bloco está sendo atualizado e pode variar por um momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor no mosaico está a ser atualizado e pode diferir por instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цифра на плитке обновляется и может на миг отличаться."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рақами рӯи корт нав мешавад ва метавонад лаҳзае фарқ кунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutucuktaki değer güncelleniyor ve kısa bir süre farklı görünebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цифра на плитці оновлюється і на мить може відрізнятися."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Katakdagi ko‘rsatkich yangilanmoqda va bir muddat farq qilishi mumkin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖塊上的數字正在更新，可能暫時不同。"
          }
        }
      }
    },
    "why.rule.averageDaily": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay indiyədək xərclərim ayın 1-dən bu günə qədərki günlərin sayına bölünür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за гэты месяц, падзеленыя на колькасць дзён ад 1-га чысла да сёння."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje dosavadní výdaje za měsíc dělené počtem dní od 1. dne měsíce do dneška."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben des Monats bisher, geteilt durch die Tage vom 1. bis heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of the month so far divided by the days from the 1st through today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto del mes hasta ahora dividido entre los días desde el 1 hasta hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses du mois jusqu'ici, divisées par le nombre de jours du 1er à aujourd'hui."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչ օրս այս ամսվա իմ ծախսերը՝ բաժանած ամսի 1-ից մինչև այսօր ընկած օրերի թվին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese fino a oggi, divise per i giorni dal 1° a oggi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი ხარჯი ამ თვეში დღემდე, გაყოფილი 1 რიცხვიდან დღემდე დღეების რაოდენობაზე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай басынан бүгінге дейінгі менің шығысым, 1-нен бүгінге дейінгі күндерге бөлінген."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айдагы азыркыга чейинки чыгашам 1-күндөн бүгүнкү күнгө чейинки күндөрдүн санына бөлүнөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu do dziś podzielone przez liczbę dni od 1. dnia miesiąca do dziś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos do mês até agora divididos pelos dias desde o dia 1 até hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas do mês até hoje, divididas pelos dias desde o dia 1 até hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы месяца на сегодня, делённые на число дней с 1-го по сегодня."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ман дар ин моҳ то имрӯз, тақсим бар шумораи рӯзҳо аз рӯзи 1-ум то имрӯз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay şu ana kadarki harcamamın ayın 1’inden bugüne kadar geçen gün sayısına bölümü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за місяць поки що, поділені на дні з 1-го по сьогодні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu oy boshidan bugungacha xarajatlarim 1-sanadan bugungacha bo‘lgan kunlar soniga bo‘linadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月截至今天的個人支出，除以從 1 日到今天的天數。"
          }
        }
      }
    },
    "why.rule.backups": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehtiyat nüsxələr qovluğundakı ən yeni verilənlər bazası nüsxəsi; bir həftədən köhnə nüsxə köhnəlmiş sayılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Найноўшая копія базы даных у папцы копій; копія старэйшая за тыдзень лічыцца састарэлай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejnovější kopie databáze ve složce záloh; kopie starší než týden je zastaralá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neueste Kopie der Datenbank im Ordner der Kopien; eine Kopie, die älter als eine Woche ist, gilt als veraltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The newest copy of the database in the folder of copies; a copy older than a week is stale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia más reciente de la base de datos en la carpeta de copias; una copia de más de una semana está desfasada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie la plus récente de la base dans le dossier des copies ; une copie de plus d'une semaine est périmée."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների բազայի վերջին պատճենը՝ պատճենների պանակում։ Մեկ շաբաթից հին պատճենը հնացած է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia più recente del database nella cartella delle copie; una copia più vecchia di una settimana non è aggiornata."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბაზის უახლესი ასლი ასლების საქაღალდეში; კვირაზე ძველი ასლი მოძველებულია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірмелер қалтасындағы дерекқордың ең жаңа көшірмесі; бір аптадан ескі көшірме ескірген болып саналады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көчүрмөлөр папкасындагы маалымат базасынын эң акыркы көчүрмөсү; бир жумадан эски көчүрмө эскирген деп эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowsza kopia bazy danych w folderze kopii. Kopia starsza niż tydzień jest nieaktualna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia mais recente do banco de dados na pasta de cópias; uma cópia com mais de uma semana está desatualizada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia mais recente da base de dados na pasta de cópias; uma cópia com mais de uma semana está desatualizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая свежая копия базы в папке копий; копия старше недели считается устаревшей."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нусхаи навтарини пойгоҳи додаҳо дар ҷузвдони нусхаҳо; нусхаи зиёда аз якҳафтаина кӯҳна ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler klasöründeki en yeni veritabanı kopyası; bir haftadan eski kopyalar güncel sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найновіша копія бази в теці копій; копія старша за тиждень вважається застарілою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nusxalar jildidagi ma’lumotlar bazasining eng yangi nusxasi; bir haftadan eski nusxa eskirgan hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份資料夾中最新的資料庫副本；超過一週的副本視為過期。"
          }
        }
      }
    },
    "why.rule.balanceForecast": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcmaldakı hər hesabın ayın sonuna hesablanmış qalığı: hazırkı vəsaitə gözlənilən gəlirlər əlavə edilir, ödənişlər və ehtimal olunan xərclər çıxılır; nəticələr hər valyuta üzrə toplanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожны ўлічаны баланс рахункаў у зводцы на канец месяца: грошы цяпер плюс чаканыя паступленні, мінус плацяжы і верагодныя выдаткі; сумуецца ў кожнай валюце."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Očekávaný zůstatek každého účtu zahrnutého do souhrnu na konci měsíce: současné peníze plus očekávané příjmy minus platby a pravděpodobné výdaje; součty jsou uvedeny podle měn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder gezählte Saldo der Konten in der Übersicht am Monatsende: Geld jetzt, plus was noch kommt, minus Zahlungen und die wahrscheinlichen Ausgaben; innerhalb jeder Währung addiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each counted balance of the accounts in the summary at the end of the month: money now, plus what is due to come, less payments and the likely spending; added up within each currency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo contado de cada cuenta del resumen a final de mes: el dinero de hoy, más lo que llegará, menos los pagos y el gasto probable; sumado dentro de cada divisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque solde compté des comptes du récapitulatif à la fin du mois : l'argent actuel, plus ce qui doit encore arriver, moins les paiements et les dépenses probables ; additionné par devise."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփման մեջ հաշվառվող յուրաքանչյուր հաշվի ամսվա վերջի մնացորդը՝ ներկա գումարին գումարած սպասվող մուտքերը և հանած վճարումներն ու հավանական ծախսերը։ Մնացորդները գումարվում են ըստ արժույթի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo previsto a fine mese per ogni conto incluso nel riepilogo: denaro attuale, più le entrate previste, meno i pagamenti e le spese probabili; i saldi sono sommati per valuta."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვის ბოლოს შეჯამებაში შესული თითოეული ანგარიშის სავარაუდო ნაშთი: მიმდინარე თანხას ემატება მოსალოდნელი შემოსავალი და აკლდება გადასახდელები და სავარაუდო ხარჯები; ნაშთები ჯამდება ვალუტის მიხედვით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы әр есептелген теңгерім ай соңында: қазіргі ақша, плюс келетін, минус төлемдер мен болжамды шығын; әр валюта ішінде қосылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Серепке кирген эсептердин ай аягындагы болжолдуу калдыгы: учурдагы акчага күтүлгөн киреше кошулуп, төлөмдөр жана болжолдуу чыгашалар алынат; ар бир валюта өзүнчө жыйынтыкталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognozowane saldo każdego uwzględnionego konta na koniec miesiąca: obecne środki plus oczekiwane wpływy, minus płatności i przewidywane wydatki. Salda są sumowane dla każdej waluty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo previsto no fim do mês de cada conta incluída no resumo: dinheiro atual, mais o que está previsto receber, menos pagamentos e gastos prováveis; somados por moeda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo previsto no fim do mês de cada conta incluída no resumo: dinheiro atual, mais o que está por receber, menos pagamentos e despesas prováveis; somado por moeda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый сверенный остаток счетов в сводке на конец месяца: деньги сейчас плюс ожидаемые поступления минус платежи и вероятные траты; складываются внутри каждой валюты."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи пешбинишудаи ҳар ҳисоб дар ҷамъбаст дар охири моҳ: маблағи ҳозира, иловаи даромади интизорӣ, тарҳи пардохтҳо ва хароҷоти эҳтимолӣ; аз рӯи ҳар асъор ҷамъ карда мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özetteki her hesaba katılan hesabın ay sonu bakiyesi: mevcut para, beklenen gelirler eklenip ödemeler ve tahmini harcamalar çıkarılarak bulunur; her para birimi kendi içinde toplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен врахований залишок рахунків підсумку на кінець місяця: гроші зараз плюс те, що має надійти, мінус платежі й імовірні витрати; підсумовується в межах кожної валюти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oy oxirida umumiy ko‘rinishdagi har bir hisobning hisobga olinadigan qoldig‘i: hozirgi mablag‘ga kutilayotgan tushum qo‘shilib, to‘lovlar va taxminiy xarajatlar ayriladi; natijalar har bir valuta bo‘yicha jamlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要中每個納入計算的帳戶月底餘額：目前資金，加上預計收入，減去付款和預計支出；按幣別加總。"
          }
        }
      }
    },
    "why.rule.canSave": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın gözlənilən gəlirindən məqsədlərə köçürmələr istisna olmaqla çəkilmiş xərclər, qarşıdakı ödənişlər və qalan günlərin ehtimal olunan xərcləri çıxılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаканы даход за месяц мінус выдаткаванае без унёскаў у мэты, будучыя плацяжы і верагодныя выдаткі за астатнія дні."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Očekávané příjmy za měsíc minus výdaje bez příspěvků na cíle, zbývající platby a pravděpodobné výdaje do konce měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwartete Einnahmen des Monats, abzüglich dessen, was ohne Zielbeiträge ausgegeben wird, der noch fälligen Zahlungen und der wahrscheinlichen Ausgaben der verbleibenden Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected income of the month, less what is spent without goal contributions, the payments still due and the likely spending of the days left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso previsto del mes, menos lo que se gasta sin aportaciones a objetivos, los pagos todavía pendientes y el gasto probable de los días que quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus attendus du mois, moins ce qui est dépensé hors contributions aux objectifs, les paiements encore dus et les dépenses probables des jours restants."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա սպասվող եկամուտը՝ հանած ծախսերը՝ առանց նպատակներին կատարված մուծումների, սպասվող վճարումները և մնացած օրերի հավանական ծախսերը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate previste del mese, meno le spese escluse le somme destinate agli obiettivi, i pagamenti ancora dovuti e le spese probabili dei giorni restanti."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვის მოსალოდნელ შემოსავალს აკლდება ხარჯი მიზნებში შენატანების გარეშე, დარჩენილი გადასახდელები და დარჩენილი დღეების სავარაუდო ხარჯი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың күтілетін табысы, минус мақсат салымдарынсыз жұмсалған, әлі төленетін төлемдер және қалған күндердің болжамды шығыны."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда күтүлгөн кирешеден максаттарга төгүмдөрдү кошпогон чыгашалар, алдыдагы төлөмдөр жана калган күндөрдүн болжолдуу чыгашалары алынат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwany dochód w tym miesiącu minus wydatki bez wpłat na cele, pozostałe płatności i przewidywane wydatki do końca miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A receita prevista para o mês, menos os gastos sem aportes a metas, os pagamentos pendentes e os gastos prováveis dos dias restantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O rendimento previsto do mês, menos as despesas sem contribuições para objetivos, os pagamentos pendentes e as despesas prováveis dos dias restantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемый доход месяца минус потраченное без взносов на цели, ещё не оплаченные платежи и вероятные траты оставшихся дней."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади интизории моҳ, тарҳи хароҷот бе маблағҳои ба ҳадафҳо гузошташуда, пардохтҳои боқимонда ва хароҷоти эҳтимолии рӯзҳои боқимонда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın beklenen gelirinden, hedeflere yapılan katkılar hariç harcamalar, kalan ödemeler ve ayın kalan günleri için tahmini harcamalar çıkarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуваний дохід місяця мінус те, що витрачено без внесків у цілі, платежі, що ще належать, і імовірні витрати за дні, що лишилися."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyning kutilayotgan daromadidan maqsadlarga ajratilgan mablag‘larsiz xarajatlar, qolgan to‘lovlar va qolgan kunlarning taxminiy xarajatlari ayriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月預計收入，減去不含目標存款的支出、待付帳款及本月剩餘天數的預計支出。"
          }
        }
      }
    },
    "why.rule.capital": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahib olduqlarım — bütün hesablardakı vəsait, aktivlər və mənə olan borclar — borclarım çıxılmaqla."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усё, што я маю — грошы на ўсіх рахунках, актывы і тое, што мне вінны, — мінус тое, што я вінен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, co mám — peníze na všech účtech, majetek a pohledávky — minus moje dluhy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ich habe — Geld auf jedem Konto, Vermögen und was mir geschuldet wird — abzüglich dessen, was ich schulde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What I have — money on every account, assets and what is owed to me — less what I owe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que tengo — el dinero de cada cuenta, los bienes y lo que me deben — menos lo que debo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que j'ai — l'argent de chaque compte, les actifs et ce qui m'est dû — moins ce que je dois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն, ինչ ունեմ՝ բոլոր հաշիվների գումարը, ակտիվները և ինձ պարտք եղած գումարը, հանած իմ պարտքերը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che possiedo — denaro su tutti i conti, beni e crediti — meno ciò che devo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რაც მაქვს — თანხა ყველა ანგარიშზე, აქტივები და რაც მე მართებთ — მინუს ჩემი ვალები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менде не бар — әр есеп-шоттағы ақша, активтер және маған берілген — минус менің берешегім."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Менде бар нерселерден — бардык эсептердеги акча, активдер жана мага болгон карыздардан — менин карыздарым алынат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co mam — środki na wszystkich kontach, aktywa i należności — minus moje długi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que tenho — dinheiro em todas as contas, bens e valores a receber — menos o que devo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que tenho — dinheiro em todas as contas, ativos e o que me devem — menos o que devo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что у меня есть — деньги на всех счетах, имущество и долги мне — минус то, что я должен."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дороии ман — маблағи ҳамаи ҳисобҳо, дороиҳо ва қарзҳое, ки ба ман бармегардонанд — тарҳи қарзҳои ман."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahip olduklarım — tüm hesaplardaki para, varlıklar ve alacaklarım — eksi borçlarım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що маю — гроші на кожному рахунку, майно і те, що мені винні, — мінус те, що винен я."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bor mablag‘im — barcha hisoblardagi pul, aktivlar va menga bo‘lgan qarzlardan o‘z qarzlarim ayriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我擁有的資金、資產及應收款，減去我欠的款項。"
          }
        }
      }
    },
    "why.rule.categoryGrew": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ötən ayın eyni günləri ilə müqayisədə xərci rublla ən çox artan kateqoriya."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыя, выдаткі ў якой найбольш выраслі ў рублях адносна тых жа дзён мінулага месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie, jejíž výdaje v rublech vzrostly nejvíce oproti stejným dnům minulého měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorie, deren Ausgaben in Rubel am stärksten gegenüber denselben Tagen des letzten Monats gewachsen sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category whose spending grew most in rubles against the same days of last month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoría cuyo gasto más creció en rublos frente a los mismos días del mes pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie dont les dépenses ont le plus augmenté en roubles par rapport aux mêmes jours du mois dernier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն կատեգորիան, որի ծախսերը ռուբլով ամենաշատն են աճել՝ անցյալ ամսվա նույն օրերի համեմատ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoria le cui spese sono aumentate di più in rubli rispetto agli stessi giorni del mese scorso."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორია, რომლის ხარჯიც რუბლებში ყველაზე მეტად გაიზარდა გასული თვის იმავე დღეებთან შედარებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен айдың дәл сол күндерімен салыстырғанда рубльмен шығыны ең көп өскен санат."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөн айдын ушул эле күндөрүнө салыштырганда чыгашасы рубль менен эң көп өскөн категория."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria, której wydatki wzrosły najbardziej w rublach względem tych samych dni poprzedniego miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A categoria cujos gastos mais aumentaram em rublos em relação aos mesmos dias do mês passado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A categoria cujas despesas mais aumentaram em rublos face aos mesmos dias do mês passado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория, расходы по которой выросли больше всех в рублях к тем же дням прошлого месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияе, ки хароҷоташ нисбат ба ҳамин рӯзҳои моҳи гузашта бо рубл бештар аз ҳама афзуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen ayın aynı günlerine göre harcaması ruble cinsinden en çok artan kategori."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія, витрати в якій зросли найбільше в рублях порівняно з тими самими днями минулого місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan oyning shu kunlariga nisbatan xarajati rublda eng ko‘p oshgan toifa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與上個月同期相比，以盧布計算支出增幅最大的類別。"
          }
        }
      }
    },
    "why.rule.categoryShrank": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ötən ayın eyni günləri ilə müqayisədə xərci rublla ən çox azalan kateqoriya."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыя, выдаткі ў якой найбольш знізіліся ў рублях адносна тых жа дзён мінулага месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie, jejíž výdaje v rublech klesly nejvíce oproti stejným dnům minulého měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorie, deren Ausgaben in Rubel am stärksten gegenüber denselben Tagen des letzten Monats gesunken sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category whose spending fell most in rubles against the same days of last month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoría cuyo gasto más bajó en rublos frente a los mismos días del mes pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie dont les dépenses ont le plus baissé en roubles par rapport aux mêmes jours du mois dernier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն կատեգորիան, որի ծախսերը ռուբլով ամենաշատն են նվազել՝ անցյալ ամսվա նույն օրերի համեմատ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoria le cui spese sono diminuite di più in rubli rispetto agli stessi giorni del mese scorso."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორია, რომლის ხარჯიც რუბლებში ყველაზე მეტად შემცირდა გასული თვის იმავე დღეებთან შედარებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен айдың дәл сол күндерімен салыстырғанда рубльмен шығыны ең көп кеміген санат."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөн айдын ушул эле күндөрүнө салыштырганда чыгашасы рубль менен эң көп азайган категория."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria, której wydatki spadły najbardziej w rublach względem tych samych dni poprzedniego miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A categoria cujos gastos mais diminuíram em rublos em relação aos mesmos dias do mês passado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A categoria cujas despesas mais diminuíram em rublos face aos mesmos dias do mês passado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория, расходы по которой сократились больше всех в рублях к тем же дням прошлого месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияе, ки хароҷоташ нисбат ба ҳамин рӯзҳои моҳи гузашта бо рубл бештар аз ҳама кам шуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen ayın aynı günlerine göre harcaması ruble cinsinden en çok azalan kategori."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія, витрати в якій найбільше зменшилися в рублях порівняно з тими самими днями минулого місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan oyning shu kunlariga nisbatan xarajati rublda eng ko‘p kamaygan toifa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與上個月同期相比，以盧布計算支出減幅最大的類別。"
          }
        }
      }
    },
    "why.rule.currencyBalances": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcmaldakı hesabların qalıqları valyutaya görə qruplaşdırılır; hər valyuta günün məzənnəsi ilə rublda göstərilir və birlikdə «Всего» cəmini təşkil edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансы рахункаў у зводцы, згрупаваныя па валюце; кожная валюта паказана ў рублях па курсе дня, а разам яны складаюць суму «Всего»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatky účtů v souhrnu podle měn; každá měna je přepočtena na rubly denním kurzem a jejich součet tvoří «Всего»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Salden der Konten in der Übersicht, nach Währung gruppiert; jede Währung wird in Rubel zum Kurs des Tages gezeigt, zusammen ergeben sie die Summe „Gesamt“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balances of the accounts in the summary, grouped by currency; each currency is shown in rubles at the rate of the day, and together they are the total of «Всего»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saldos de las cuentas del resumen, agrupados por divisa; cada divisa se muestra en rublos al tipo del día, y juntas son el total de «Todo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soldes des comptes du récapitulatif, groupés par devise ; chaque devise est montrée en roubles au cours du jour, et ensemble ils forment le total de « Всего »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփման հաշիվների մնացորդները՝ ըստ արժույթի։ Յուրաքանչյուր արժույթ ցուցադրվում է ռուբլով՝ օրվա փոխարժեքով, իսկ դրանց գումարը «Всего»-ի ընդհանուր գումարն է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I saldi dei conti nel riepilogo, raggruppati per valuta; ogni valuta è mostrata in rubli al tasso del giorno e insieme formano il totale di «Всего»."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯამებაში შესული ანგარიშების ნაშთები ვალუტის მიხედვით; თითოეული ვალუტა ნაჩვენებია რუბლებში დღიური კურსით, მათი ჯამი კი არის «Всего»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы есеп-шоттардың теңгерімдері валюта бойынша топтастырылған; әр валюта сол күнгі бағам бойынша рубльмен көрсетіледі, олар бірге «Барлығы» жиыны болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Серепке кирген эсептердин калдыктары валюта боюнча топтолот; ар бир валюта күндүн курсу боюнча рубль менен көрсөтүлүп, чогуу «Всего» жыйынтыгын түзөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Salda kont w podsumowaniu pogrupowane według waluty. Każda waluta jest przeliczana na ruble po kursie dnia, a ich suma to «Всего»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos das contas no resumo, agrupados por moeda; cada moeda é exibida em rublos pela cotação do dia, e a soma corresponde a «Всего»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos das contas no resumo, agrupados por moeda; cada moeda é apresentada em rublos ao câmbio do dia e, juntas, formam o total de «Всего»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатки счетов из сводки, сгруппированные по валютам; каждая валюта показана в рублях по курсу дня, вместе они дают «Всего»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи ҳисобҳо дар ҷамъбаст, аз рӯи асъор гурӯҳбандӣ шудааст; ҳар асъор бо қурби рӯз ба рубл нишон дода мешавад ва ҷамъи онҳо ба «Всего» баробар аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özetteki hesap bakiyeleri para birimine göre gruplandırılır; her para birimi günün kuruyla ruble cinsinden gösterilir ve toplamları «Всего» değerini oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишки рахунків підсумку, згруповані за валютою; кожну валюту показано в рублях за курсом дня, а разом вони дають суму «Усього»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumiy ko‘rinishdagi hisoblar qoldiqlari valuta bo‘yicha guruhlanadi; har bir valuta kun kursida rublda ko‘rsatiladi va ularning yig‘indisi «Всего»ni tashkil etadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要中的帳戶餘額，按幣別分組；各幣別按當日匯率換算為盧布，加總後即為「Всего」。"
          }
        }
      }
    },
    "why.rule.currencyChart": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş dövrdə valyuta cütü üzrə bankın gündəlik məzənnələri: dövrün əvvəlindəki məzənnə, dəyişikliyi və hazırkı məzənnə."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Штодзённыя курсы валютнай пары ад банка за выбраны перыяд: курс на пачатку, яго змяненне і курс цяпер."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Denní kurzy měnového páru od banky za vybrané období: kurz na začátku, jeho vývoj a současný kurz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die täglichen Kurse der Bank für das Paar im gewählten Zeitraum: der Kurs zu Beginn, wie er sich geändert hat, und der Kurs jetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank's daily rates of the pair over the chosen period: the rate at its start, how it changed, and the rate now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tipos diarios del banco del par durante el periodo elegido: el tipo al inicio, cómo cambió y el tipo ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cours quotidiens de la banque pour la paire sur la période choisie : le cours au début, son évolution et le cours actuel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանկի օրական փոխարժեքները ընտրված արժութային զույգի համար՝ ժամանակահատվածի սկզբի փոխարժեքը, դրա փոփոխությունը և ներկայիս փոխարժեքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tassi giornalieri della banca per la coppia nel periodo scelto: il tasso iniziale, la sua variazione e il tasso attuale."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბანკის მიერ არჩეულ პერიოდში გამოქვეყნებული ვალუტის წყვილის დღიური კურსები: საწყისი კურსი, მისი ცვლილება და მიმდინარე კურსი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған кезеңдегі банктің күнделікті бағамдары: басындағы бағам, қалай өзгергені және қазіргі бағам."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тандалган мезгилдеги валюта жубунун банктын күнүмдүк курстары: мезгилдин башындагы курс, анын өзгөрүшү жана учурдагы курс."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzienne kursy bankowe pary walut w wybranym okresie: kurs na początku, jego zmiana i obecny kurs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cotações diárias do par publicadas pelo banco no período escolhido: a cotação inicial, sua variação e a cotação atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os câmbios diários do par publicados pelo banco no período escolhido: o câmbio inicial, a sua variação e o câmbio atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневные курсы ЦБ для пары за выбранный период: курс в начале, его изменение и курс сейчас."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурбҳои ҳаррӯзаи бонк барои ҷуфти асъор дар давраи интихобшуда: қурб дар оғоз, тағйироти он ва қурби ҳозира."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dönem boyunca bankanın para birimi çiftine ait günlük kurları: başlangıç kuru, değişimi ve güncel kur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоденні курси банку для пари за обраний період: курс на початку, його зміна і курс зараз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlangan davr uchun valuta juftligining bankdagi kunlik kurslari: davr boshidagi kurs, uning o‘zgarishi va hozirgi kurs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選期間內銀行每日公布的貨幣對匯率：期初匯率、變動情況及目前匯率。"
          }
        }
      }
    },
    "why.rule.cushion": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehtiyat hesablarındakı vəsait bir ayın məcburi xərclərinə bölünür və onda birə qədər aşağı yuvarlaqlaşdırılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на рахунках падушкі, падзеленыя на абавязковыя выдаткі за месяц і акругленыя ўніз да дзясятай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze na účtech rezervy dělené měsíčními nutnými výdaji, zaokrouhlené dolů na desetiny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld der Polster-Konten geteilt durch die Pflichtausgaben eines Monats, auf eine Zehntel abgerundet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money of the cushion accounts divided by the obligatory spending of a month, rounded down to a tenth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de las cuentas del colchón dividido entre el gasto obligatorio de un mes, redondeado hacia abajo a una décima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent des comptes du matelas divisé par les dépenses obligatoires d'un mois, arrondi au dixième inférieur."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահուստային հաշիվների գումարը՝ բաժանած մեկ ամսվա պարտադիր ծախսերին և կլորացրած դեպի ներքև՝ մինչև տասնորդական։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro nei conti del fondo di emergenza diviso per le spese obbligatorie di un mese, arrotondato per difetto al decimo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უსაფრთხოების ბალიშის ანგარიშებზე არსებული თანხა გაყოფილი თვის სავალდებულო ხარჯზე და დამრგვალებული მეათედამდე შემცირებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық есеп-шоттарының ақшасын айлық міндетті шығынға бөлу, оныншы бөлікке дейін төмен қарай дөңгелектеу."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Коопсуздук жаздыгынын эсептериндеги акча бир айлык милдеттүү чыгашаларга бөлүнүп, ондук үлүшкө чейин төмөн карай тегеректелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środki na kontach poduszki podzielone przez obowiązkowe wydatki za miesiąc, zaokrąglone w dół do jednej dziesiątej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro das contas de reserva dividido pelos gastos obrigatórios de um mês, arredondado para baixo até uma casa decimal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro das contas de reserva dividido pelas despesas obrigatórias de um mês, arredondado por defeito às décimas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги счетов подушки, делённые на обязательные траты месяца, с округлением вниз до десятых."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ҳисобҳои захиравӣ тақсим бар хароҷоти ҳатмии як моҳ, ба даҳяк ба поён яклухт карда шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvence hesaplarındaki paranın bir aylık zorunlu harcamalara bölümü; sonuç onda bir basamağına aşağı yuvarlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші рахунків подушки, поділені на обов'язкові витрати за місяць, округлені вниз до десятих."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaxira hisoblardagi mablag‘ bir oylik majburiy xarajatlarga bo‘linadi va o‘ndan birgacha pastga yaxlitlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "緊急預備金帳戶的資金，除以一個月的必要支出，無條件捨去至小數點後一位。"
          }
        }
      }
    },
    "why.rule.event": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarixindən asılı olmayaraq tədbirin bütün əməliyyatları üzrə xərclərim onun büdcəsi ilə müqayisə edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі на падзею па ўсіх яе аперацыях незалежна ад даты адносна яе бюджэту."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje výdaje na událost ze všech jejích operací bez ohledu na datum v porovnání s jejím rozpočtem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben für das Ereignis über alle seine Vorgänge, unabhängig von ihrem Datum, gegenüber seinem Budget."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending on the event over all its operations, whatever their date, against its budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto en el evento sumando todas sus operaciones, sea cual sea su fecha, frente a su presupuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses pour l'événement sur toutes ses opérations, quelle que soit leur date, comparées à son budget."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Իրադարձության հետ կապված բոլոր գործարքներով իմ ծախսերը՝ անկախ ամսաթվից, համեմատած դրա բյուջեի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese per l’evento in tutte le sue operazioni, indipendentemente dalla data, rispetto al budget."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ღონისძიების ყველა ოპერაციაში ჩემი ხარჯი, მათი თარიღის მიუხედავად, მის ბიუჯეტთან შედარებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Іс-шараға менің шығысым оның барлық операциялары бойынша, күніне қарамастан, бюджетіне қарсы."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Иш-чаранын датасына карабастан, ага байланышкан бардык операциялар боюнча чыгашам анын бюджети менен салыштырылат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki na wydarzenie ze wszystkich jego operacji, niezależnie od daty, w porównaniu z budżetem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos no evento em todas as suas operações, independentemente da data, em relação ao orçamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas no evento em todas as suas operações, independentemente da data, face ao orçamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои траты на событие по всем его операциям, в какой бы день они ни были, против его бюджета."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ман барои рӯйдод дар ҳамаи амалиётҳои он, новобаста аз сана, нисбат ба буҷети он."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihlerinden bağımsız olarak etkinliğe ait tüm işlemlerdeki harcamamın bütçeye göre durumu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати на подію за всіма її операціями, незалежно від дати, порівняно з її бюджетом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tadbirga tegishli barcha operatsiyalardagi xarajatlarim, sanasidan qat’i nazar, uning budjeti bilan solishtiriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "活動所有交易中的個人支出，不論日期，與預算比較。"
          }
        }
      }
    },
    "why.rule.expectedIncome": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın hər gözlənilən gəlir tarixindən hələ daxil olmayan məbləğ, bugünkü məzənnə ilə."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Яшчэ не атрыманыя сумы па кожнай даце паступлення ў гэтым месяцы па сённяшнім курсе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částky z očekávaných příjmů se splatností v tomto měsíci, které dosud nepřišly, přepočtené dnešním kurzem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jede Fälligkeit dieses Monats bisher nicht gebracht hat, zum heutigen Kurs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What each due date of this month has not brought yet, at today's rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cada fecha de vencimiento de este mes todavía no ha traído, al tipo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que chaque échéance de ce mois n'a pas encore apporté, au cours du jour."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվա յուրաքանչյուր սպասվող մուտքի դեռ չստացված մասը՝ այսօրվա փոխարժեքով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto manca ancora per ogni scadenza di entrata di questo mese, al tasso di oggi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვის თითოეულ თარიღზე ჯერ კიდევ მისაღები შემოსავალი დღევანდელი კურსით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдың әр күтілетін күні әлі келмеген табыс, бүгінгі бағам бойынша."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушул айда белгиленген даталарда али түшө элек киреше, бүгүнкү курс боюнча."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwoty, które nie wpłynęły jeszcze w terminach przypadających w tym miesiącu, według dzisiejszego kursu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ainda falta receber em cada data prevista deste mês, pela cotação de hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ainda falta receber em cada data de vencimento deste mês, ao câmbio de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько ещё не принёс каждый срок ожидаемых поступлений этого месяца, по курсу сегодня."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қисми ҳанӯз нарасидаи даромад барои ҳар санаи пешбинишудаи ин моҳ, бо қурби имрӯз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın her beklenen gelirinden henüz alınmamış tutar, bugünkü kurla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що ще не надійшло за кожною датою очікування цього місяця, за сьогоднішнім курсом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu oy uchun har bir kutilgan sanada hali kelib tushmagan daromad bugungi kursda hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月各到期日尚未收到的款項，按今日匯率計算。"
          }
        }
      }
    },
    "why.rule.financialHealth": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş hissədən ibarət yüz ballıq göstərici: ehtiyat, borc yükü, yığım faizi, vaxtı keçmiş ödənişlər və gəlirin sabitliyi. Məlumatı olmayan hissə nəzərə alınmır, qalan hissələr yüz bala uyğunlaşdırılır; hissələrin balları göstəricini təşkil edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ацэнка са ста балаў, якая складаецца з пяці частак: падушка, даўгавая нагрузка, норма зберажэнняў, пратэрмінаваныя плацяжы і стабільнасць даходу. Часткі без даных не ўлічваюцца, а астатнія пералічваюцца да ста балаў; іх балы складаюць агульную ацэнку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skóre ze sta bodů složené z pěti částí: rezerva, dluhové zatížení, míra úspor, závazky po splatnosti a stabilita příjmů. Část bez údajů se vynechá a ostatní se přepočítají na sto bodů; jejich body dávají výsledné skóre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahl von hundert aus fünf Teilen: dem Polster, der Schuldenlast, der Sparquote, überfälligen Fälligkeiten und der Stabilität der Einnahmen. Ein Teil ohne Daten bleibt weg, und die übrigen werden auf hundert hochgerechnet; die Punkte der Teile ergeben zusammen die Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One number out of a hundred made of five parts: the cushion, the debt load, the savings rate, overdue dues and the stability of income. A part with no data is left out and the rest are scaled to a hundred; the points of the parts add up to the number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número de cien hecho con cinco partes: el colchón, la carga de deudas, la tasa de ahorro, los vencimientos atrasados y la estabilidad de los ingresos. Una parte sin datos no se incluye y las demás se escalan a cien; los puntos de las partes suman el número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chiffre sur cent, composé de cinq parties : le matelas, le poids des dettes, le taux d'épargne, les échéances en retard et la stabilité des revenus. Une partie sans données est laissée de côté et les autres sont ramenées sur cent ; les points des parties font le chiffre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարյուրից մեկ ցուցանիշ՝ կազմված հինգ մասից՝ պահուստ, պարտքային բեռ, խնայողության մակարդակ, ժամկետանց պարտավորություններ և եկամտի կայունություն։ Առանց տվյալների մասերը չեն ներառվում, իսկ մնացածը վերահաշվարկվում են մինչև հարյուր։ Մասերի միավորների գումարը տալիս է ցուցանիշը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punteggio su cento composto da cinque parti: fondo di emergenza, peso dei debiti, tasso di risparmio, scadenze arretrate e stabilità delle entrate. Le parti senza dati sono escluse e le altre sono riproporzionate su cento; la somma dei punti dà il punteggio."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაჩვენებელი ასიდან, რომელიც ხუთი ნაწილისგან შედგება: უსაფრთხოების ბალიში, ვალის ტვირთი, დანაზოგის წილი, ვადაგადაცილებული გადასახდელები და შემოსავლის სტაბილურობა. ნაწილი მონაცემების გარეშე არ ითვლება, დანარჩენი კი ას ქულამდე გადაითვლება; ნაწილების ქულების ჯამი მაჩვენებელს უდრის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүзден бір сан, бес бөліктен: жастық, берешек жүктемесі, жинақ мөлшерлемесі, мерзімі өткен төлемдер және табыстың тұрақтылығы. Деректері жоқ бөлік шығарылады, ал қалғандары жүзге дейін масштабталады; бөліктердің ұпайлары қосылып, санды береді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүздөн бир көрсөткүч беш бөлүктөн турат: коопсуздук жаздыгы, карыз жүгү, топтоо деңгээли, мөөнөтү өткөн төлөмдөр жана кирешенин туруктуулугу. Маалыматы жок бөлүк эсепке алынбайт, калгандары жүзгө ылайыкталат; бөлүктөрдүн упайлары кошулуп, көрсөткүчтү түзөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik na 100 punktów, złożony z pięciu części: poduszki, obciążenia długiem, stopy oszczędności, zaległych płatności i stabilności dochodów. Części bez danych są pomijane, a pozostałe przeliczane do 100 punktów. Suma punktów daje wynik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pontuação de zero a cem composta por cinco partes: reserva, peso das dívidas, taxa de economia, pagamentos em atraso e estabilidade da receita. Partes sem dados ficam de fora, e as demais são ajustadas para somar cem; seus pontos compõem a pontuação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor de zero a cem composto por cinco partes: a reserva, o peso da dívida, a taxa de poupança, os valores em atraso e a estabilidade dos rendimentos. As partes sem dados são excluídas e as restantes ajustadas a cem; a soma dos pontos das partes dá o valor final."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно число из ста из пяти частей: подушка, долговая нагрузка, норма сбережений, просрочки и стабильность дохода. Часть без данных не считается, остальные пересчитываются на сто; баллы частей складываются в число."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Як рақам аз сад, ки аз панҷ қисм иборат аст: захира, бори қарз, меъёри пасандоз, пардохтҳои муҳлаташон гузашта ва устувории даромад. Қисмҳои бе маълумот ба ҳисоб гирифта намешаванд ва боқимонда ба сад мутаносиб карда мешавад; ҷамъи холҳои қисмҳо ба ин рақам баробар аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş bölümden oluşan 100 üzerinden bir puan: güvence, borç yükü, birikim oranı, vadesi geçmiş ödemeler ve gelir istikrarı. Verisi olmayan bölümler çıkarılır ve kalanlar 100 üzerinden ölçeklenir; bölüm puanlarının toplamı sonucu verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне число зі ста, складене з п'яти частин: подушка, навантаження боргами, норма заощаджень, прострочені платежі й стабільність доходу. Частина без даних не враховується, а решта масштабується до ста; бали частин складаються в число."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuz ballik ko‘rsatkich besh qismdan iborat: zaxira, qarz yuki, jamg‘arish darajasi, muddati o‘tgan to‘lovlar va daromad barqarorligi. Ma’lumot yo‘q qism hisobga olinmaydi, qolganlari esa yuz ballga moslanadi; qismlar ballari yig‘indisi umumiy ko‘rsatkichni beradi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由緊急預備金、債務負擔、儲蓄率、逾期款項及收入穩定度五部分組成的百分制分數。沒有資料的部分不計入，其餘部分按比例換算為百分制；各部分分數加總即為總分。"
          }
        }
      }
    },
    "why.rule.freeMoney": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcmaldakı hesablarda hazırda olan vəsaitdən məqsədlər üçün ayrılan vəsait və nəzərə alınmırsa ehtiyat çıxılır; sonra ayın sonuna qədər planlaşdırılan xərclər çıxılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на рахунках у зводцы цяпер мінус грошы на мэты (і падушка, калі яна выключана); затым адымаюцца запланаваныя сумы да канца месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Současné peníze na účtech v souhrnu minus peníze na cíle a případně rezerva; dále se odečtou plánované výdaje do konce měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld auf den Konten in der Übersicht jetzt, abzüglich Zielgeld (und des Polsters, wenn es herausgehalten wird); dann abzüglich dessen, was die Pläne bis Monatsende beanspruchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money on the accounts in the summary now, less goal money (and the cushion when it is kept out); then less what the plans take until the end of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de las cuentas del resumen ahora, menos el dinero de los objetivos (y el colchón cuando se deja fuera); después, menos lo que se llevan los planes hasta final de mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'argent des comptes du récapitulatif maintenant, moins l'argent des objectifs (et le matelas s'il est exclu) ; puis moins ce que prennent les plans jusqu'à la fin du mois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփման հաշիվների ներկա գումարը՝ հանած նպատակների գումարը և, եթե առանձնացված է, պահուստը, ապա՝ մինչև ամսվա վերջ պլանավորված ծախսերը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro attuale sui conti nel riepilogo, meno le somme destinate agli obiettivi (e al fondo di emergenza, se escluso); vengono poi sottratte le somme previste dai piani fino a fine mese."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯამებაში შესულ ანგარიშებზე არსებული თანხა, მიზნებისთვის გადადებული თანხისა და, გამორიცხვის შემთხვევაში, უსაფრთხოების ბალიშის გამოკლებით; შემდეგ აკლდება თვის ბოლომდე დაგეგმილი ხარჯები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы есеп-шоттардағы қазіргі ақша, минус мақсаттардың ақшасы (және жастық, ол бөлек ұсталса); одан кейін ай соңына дейін жоспарлар алатын сома."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Серепке кирген эсептердеги учурдагы акчадан максаттарга бөлүнгөн акча жана кошулбаса, коопсуздук жаздыгы алынат; андан кийин айдын аягына чейинки пландалган чыгашалар алынат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecne środki na kontach w podsumowaniu minus środki na cele i, jeśli wyłączono ją z dostępnych środków, poduszka. Następnie odejmowane są kwoty zaplanowane do końca miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro atual nas contas do resumo, menos o dinheiro das metas (e da reserva, quando excluída); depois, são descontados os valores reservados pelos planos até o fim do mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro atual nas contas do resumo, menos o dinheiro dos objetivos (e da reserva, quando excluída); depois, menos o valor dos planos até ao fim do mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги на счетах в сводке сейчас минус деньги целей (и подушка, если она не считается свободной); затем минус то, что заберут планы до конца месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ҳозираи ҳисобҳо дар ҷамъбаст, тарҳи маблағи ҳадафҳо ва, агар истисно шуда бошад, захира; сипас маблағи барои нақшаҳо то охири моҳ зарурӣ тарҳ мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özetteki hesaplarda şu an bulunan paradan hedeflere ayrılan para ve hariç tutuluyorsa güvence çıkarılır; ardından ay sonuna kadar planlar için gereken tutar düşülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гроші на рахунках підсумку зараз, мінус гроші цілей (і подушка, якщо її відведено окремо); далі мінус те, що плани забирають до кінця місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumiy ko‘rinishdagi hisoblardagi joriy mablag‘dan maqsadlar uchun ajratilgan pul va, hisobga kiritilmasa, zaxira ayriladi; so‘ng oy oxirigacha rejalashtirilgan xarajatlar ayriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要中帳戶目前的資金，減去目標資金（以及未納入的緊急預備金），再減去月底前規劃所需的款項。"
          }
        }
      }
    },
    "why.rule.iOwe": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər açıq borcumun qalığı bugünkü məzənnə ilə; borc qalıqları ayın göstəricilərinə daxil edilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэшта па кожным адкрытым доўгу, які я павінен, па сённяшнім курсе; рэшткі даўгоў не ўлічваюцца ў паказчыках месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývající část každého mého otevřeného dluhu přepočtená dnešním kurzem; zůstatky dluhů se do měsíčních údajů nezapočítávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was von jeder offenen Schuld, die ich schulde, übrig ist, zum heutigen Kurs; Schuldensalden zählen nicht in den Zahlen des Monats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is left of each open debt I owe, at today's rate; debt balances are not counted in the figures of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que queda de cada deuda abierta que debo, al tipo de hoy; los saldos de deudas no cuentan en las cifras del mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste de chaque dette ouverte que je dois, au cours du jour ; les soldes de dettes ne figurent pas dans les chiffres du mois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Իմ յուրաքանչյուր չմարված պարտքի մնացորդը՝ այսօրվա փոխարժեքով։ Պարտքերի մնացորդները չեն ներառվում ամսվա ցուցանիշներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo residuo di ogni mio debito aperto, al tasso di oggi; i saldi dei debiti non sono inclusi nei valori del mese."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი თითოეული დაუფარავი ვალის ნაშთი დღევანდელი კურსით; ვალების ნაშთები თვის მაჩვენებლებში არ ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашық берешектердің әрқайсысынан менің қарызым қалғаны, бүгінгі бағам бойынша; берешек теңгерімдері айдың көрсеткіштеріне есептелмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Менин ар бир жабыла элек карызымдын калдыгы, бүгүнкү курс боюнча; карыз калдыктары айлык көрсөткүчтөргө кирбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostała kwota każdego mojego niespłaconego długu według dzisiejszego kursu. Salda długów nie są uwzględniane w wynikach miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de cada dívida em aberto que devo, pela cotação de hoje; saldos de dívidas não entram nos valores do mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de cada dívida por liquidar que devo, ao câmbio de hoje; os saldos das dívidas não contam para os valores do mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток каждого открытого долга «Я должен» по курсу сегодня; остатки долгов не входят в цифры месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи ҳар қарзи пардохтнашудаи ман бо қурби имрӯз; бақияи қарзҳо ба рақамҳои моҳ дохил намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık borçlarımın her birinden kalan tutar, bugünkü kurla; borç bakiyeleri aylık rakamlara katılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що лишилося за кожним відкритим боргом, який я винен, за сьогоднішнім курсом; залишки боргів не входять до цифр місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir ochiq qarzimning qoldig‘i bugungi kursda hisoblanadi; qarz qoldiqlari oylik ko‘rsatkichlarga kiritilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每筆未結清應付款的剩餘金額，按今日匯率計算；債務餘額不計入本月數字。"
          }
        }
      }
    },
    "why.rule.incomeForecast": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay daxil olan gəlirə bu ay üçün hələ gözlənilən gəlir əlavə edilir; gözlənilən gəlir yoxdursa, son tam ayların medianı götürülür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Атрыманае за гэты месяц плюс чаканы даход гэтага месяца, які яшчэ не паступіў; калі чаканага даходу няма — медыяна за апошнія поўныя месяцы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjmy, které tento měsíc přišly, plus dosud nepřijaté očekávané příjmy tohoto měsíce; pokud žádné očekávané příjmy nejsou, použije se medián posledních celých měsíců."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was diesen Monat eingegangen ist, plus was die erwarteten Einnahmen dieses Monats noch erwarten; ist keine erwartet, der Median der letzten vollen Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What came this month, plus what the expected income of this month still waits for; with none expected — the median of the last full months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que llegó este mes, más lo que todavía espera el ingreso previsto de este mes; si no hay ninguno previsto, la mediana de los últimos meses completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est entré ce mois-ci, plus ce que les revenus attendus de ce mois attendent encore ; sans revenu attendu — la médiane des derniers mois complets."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամիս ստացված գումարը՝ գումարած այս ամսվա սպասվող եկամտի դեռ չստացված մասը։ Եթե սպասվող եկամուտ չկա՝ վերջին լրիվ ամիսների մեդիանը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ricevuto questo mese, più quanto ancora atteso dalle entrate previste del mese; se non ci sono entrate previste, si usa la mediana degli ultimi mesi completi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში მიღებული შემოსავალი და ამავე თვის ჯერ კიდევ მოსალოდნელი შემოსავალი; თუ შემოსავალი მოსალოდნელი არ არის — ბოლო სრული თვეების მედიანა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда түскені, плюс осы айдың күтілетін табысы әлі күтіп тұрғаны; ешбір табыс күтілмесе — соңғы толық айлардың медианасы."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айда түшкөн кирешеге ушул айда күтүлүп жаткан кирешенин калдыгы кошулат; күтүлгөн киреше жок болсо — акыркы толук айлардын медианасы алынат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpływy z tego miesiąca plus pozostały oczekiwany dochód. Jeśli nie ma oczekiwanych wpływów, używana jest mediana z ostatnich pełnych miesięcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que entrou neste mês, mais o que ainda falta receber da receita prevista para o mês; se não houver previsão, usa-se a mediana dos últimos meses completos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que foi recebido este mês, mais o rendimento previsto para este mês ainda por receber; se não houver previsão, usa-se a mediana dos últimos meses completos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пришедшее в этом месяце плюс то, чего ещё ждут ожидаемые поступления месяца; если ожиданий нет — медиана последних полных месяцев."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади расидаи ин моҳ, иловаи қисми ҳанӯз нарасидаи даромади интизорӣ; агар даромаде интизор набошад — медианаи моҳҳои пурраи охир."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay gelen gelir ile bu ay için hâlâ beklenen gelirin toplamı; beklenen gelir yoksa son tamamlanmış ayların medyanı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що надійшло цього місяця плюс те, на що ще чекає очікуваний дохід місяця; якщо нічого не очікується — медіана останніх повних місяців."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu oy kelib tushgan daromadga hali kutilayotgan daromad qo‘shiladi; daromad kutilmasa, so‘nggi to‘liq oylar medianasi olinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月已收到的收入，加上本月預計收入中尚未收到的款項；若沒有預計收入，則使用最近幾個完整月份的中位數。"
          }
        }
      }
    },
    "why.rule.incomeSources": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın gəlirləri qeydə alındıqları kateqoriyalara görə."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход за гэты месяц па катэгорыях, у якія ён запісаны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjmy tohoto měsíce podle kategorií, do kterých byly zařazeny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen dieses Monats nach der Kategorie, unter der sie eingeordnet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income of this month by the category it was filed under."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ingresos de este mes por la categoría en la que se archivaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus de ce mois par la catégorie dans laquelle ils ont été classés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվա եկամուտը՝ ըստ գրանցված կատեգորիայի։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate di questo mese, suddivise per la categoria in cui sono state registrate."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვის შემოსავალი იმ კატეგორიების მიხედვით, რომლებშიც ის ჩაიწერა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдың табысы оның қай санатына жазылғанына қарай."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айдагы киреше жазылган категориясы боюнча көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochody z tego miesiąca według przypisanych im kategorii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A receita deste mês por categoria em que foi registrada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O rendimento deste mês por categoria em que foi registado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход этого месяца по категориям, в которых он записан."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади ин моҳ аз рӯи категорияи сабтшуда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın geliri, kaydedildiği kategoriye göre."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід цього місяця за категорією, під якою його записано."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu oydagi daromad qayd etilgan toifalar bo‘yicha."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月收入，按記錄時所選的類別分組。"
          }
        }
      }
    },
    "why.rule.installments": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıq taksit planları və kreditlə alışlar üzrə qalan məbləğ, bugünkü məzənnə ilə rublda."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэшта па адкрытых растэрміноўках і пакупках у крэдыт у рублях па сённяшнім курсе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývající částky otevřených splátkových plánů a nákupů na úvěr v rublech podle dnešního kurzu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die offenen Ratenpläne und Käufe auf Kredit noch verlangen, in Rubel zum heutigen Kurs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the open instalment plans and purchases on credit still ask, in rubles at today's rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que todavía reclaman los planes de plazos abiertos y las compras a crédito, en rublos al tipo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que demandent encore les échéanciers et achats à crédit ouverts, en roubles au cours du jour."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործող ապառիկների և վարկով գնումների չվճարված գումարը՝ ռուբլով, այսօրվա փոխարժեքով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo residuo dei piani rateali aperti e degli acquisti a credito, in rubli al tasso di oggi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოქმედი განვადებებისა და კრედიტით შესყიდვების დარჩენილი გადასახდელი რუბლებში, დღევანდელი კურსით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашық бөліп төлеу жоспарлары мен несиеге сатып алулардың әлі сұрайтыны, бүгінгі бағам бойынша рубльмен."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ачык бөлүп төлөө пландары жана насыяга алынган нерселер боюнча төлөнө элек сумма, бүгүнкү курс менен рубль түрүндө."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota pozostała do spłaty z otwartych planów ratalnych i zakupów na kredyt, w rublach według dzisiejszego kursu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor pendente dos parcelamentos e compras a crédito em aberto, em rublos pela cotação de hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que falta pagar dos planos de prestações e compras a crédito em aberto, em rublos ao câmbio de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько ещё должны открытые рассрочки и покупки в кредит, в рублях по курсу сегодня."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақияи пардохтҳои қисмии фаъол ва харидҳои қарзӣ, бо рубл ва қурби имрӯз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam eden taksitli ödeme planları ve kredili alışverişlerden kalan tutar, bugünkü kurla ruble cinsinden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що ще вимагають відкриті плани розстрочки й покупки в кредит, у рублях за сьогоднішнім курсом."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochiq bo‘lib to‘lash rejalari va kreditga xaridlar bo‘yicha qolgan summa bugungi kursda rublda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未結清的分期計畫及賒購款項，按今日匯率換算為盧布。"
          }
        }
      }
    },
    "why.rule.integrity": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilənlər bazasının yalnız oxuma ilə aparılan və həftədə bir dəfə işləyən son yoxlamasının nəticəsi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вынік апошняй праверкі базы даных, якая толькі счытвае даныя і запускаецца раз на тыдзень."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledek poslední kontroly databáze, která data pouze čte a probíhá jednou týdně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der letzten Prüfung der Datenbank, die nur liest und einmal in der Woche läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result of the last check of the database, which only reads and runs once a week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la última comprobación de la base de datos, que solo lee y se hace una vez por semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la dernière vérification de la base, qui ne fait que lire et a lieu une fois par semaine."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվյալների բազայի վերջին ստուգման արդյունքը։ Ստուգումը միայն կարդում է տվյալները և կատարվում է շաբաթը մեկ անգամ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato dell’ultimo controllo del database, eseguito in sola lettura una volta a settimana."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბაზის ბოლო შემოწმების შედეგი. შემოწმება მხოლოდ კითხულობს მონაცემებს და კვირაში ერთხელ სრულდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерекқорды соңғы тексеру нәтижесі; ол тек оқиды және аптасына бір рет жүреді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат базасын акыркы текшерүүнүн жыйынтыгы. Текшерүү маалыматтарды гана окуйт жана жумасына бир жолу жүргүзүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik ostatniego sprawdzenia bazy danych. Sprawdzenie tylko odczytuje dane i odbywa się raz w tygodniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da última verificação do banco de dados, que apenas lê os dados e é executada uma vez por semana."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da última verificação da base de dados, que apenas lê os dados e é executada uma vez por semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итог последней проверки базы, которая только читает и идёт раз в неделю."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натиҷаи санҷиши охирини пойгоҳи додаҳо, ки танҳо мехонад ва ҳафтае як бор иҷро мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanının haftada bir yapılan, yalnızca okuma amaçlı son kontrolünün sonucu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат останньої перевірки бази; вона лише читає й запускається раз на тиждень."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar bazasining so‘nggi tekshiruvi natijasi. Tekshiruv faqat o‘qiydi va haftada bir marta ishlaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次資料庫檢查的結果；檢查為唯讀操作，每週執行一次。"
          }
        }
      }
    },
    "why.rule.lastCount": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabların son üzləşdirilməsi və hər hesab üzrə faktiki qalıqla qeydlər arasındakı fərq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апошняя зверка рахункаў і адхіленне кожнага пералічанага балансу ад запісаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední odsouhlasení účtů a rozdíl mezi zjištěným a evidovaným zůstatkem každého kontrolovaného účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der neueste Abgleich der Konten und was jeder gezählte Saldo gegenüber den Büchern ergeben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest reconciliation of the accounts, and what each counted balance found against the books."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última conciliación de las cuentas, y lo que encontró cada saldo contado frente a los registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier rapprochement des comptes, et ce que chaque solde compté a révélé par rapport aux écritures."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշիվների վերջին համադրումը և յուրաքանչյուր ստուգված մնացորդի տարբերությունը գրանցվածի համեմատ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima riconciliazione dei conti e la differenza tra ogni saldo verificato e quello registrato."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშების ბოლო შეჯერება და თითოეულ დათვლილ ნაშთსა და აღრიცხვას შორის სხვაობა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттардың соңғы салыстыруы және әр санаған теңгерім жазбалармен салыстырғанда нені тапқаны."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептерди акыркы салыштыруу жана эсептелген ар бир калдыктын жазуулардан айырмасы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie uzgodnienie kont i różnica między sprawdzonym saldem każdego konta a zapisami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conciliação mais recente das contas e a diferença entre cada saldo conferido e os registros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A última conciliação das contas e a diferença entre cada saldo apurado e o saldo registado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя сверка счетов и то, что каждый сверенный остаток нашёл против записей."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муқоисаи охирини ҳисобҳо ва фарқи ҳар бақияи санҷидашуда аз бақияи сабтшуда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesapların son mutabakatı ve sayılan her bakiyenin kayıtlara göre durumu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання звірка рахунків і те, що кожен врахований залишок показав порівняно з книгами."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblarning so‘nggi solishtiruvi va har bir tekshirilgan qoldiqning qaydlardan farqi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次帳戶對帳，以及各次盤點的餘額與帳面記錄的差異。"
          }
        }
      }
    },
    "why.rule.lastCountAndRecord": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Göstəricilər aktualdırmı?» sualına iki cavab: son üzləşdirmə və son qeydə alınan əməliyyat."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Два адказы на пытанне «ці актуальныя лічбы»: апошняя зверка і апошняя запісаная аперацыя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvě odpovědi na otázku «jsou údaje aktuální»: poslední odsouhlasení a naposledy zapsaná operace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Antworten auf „Sind die Zahlen aktuell?“: der neueste Abgleich und der zuletzt aufgeschriebene Vorgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both answers to «are the figures up to date»: the latest reconciliation and the operation written down last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos respuestas a «¿están las cifras al día?»: la última conciliación y la última operación anotada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux réponses à « les chiffres sont-ils à jour » : le dernier rapprochement et l'opération notée en dernier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Արդյոք ցուցանիշները արդի՞ են» հարցի երկու պատասխանները՝ վերջին համադրումը և վերջին գրանցված գործարքը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe le risposte a «i dati sono aggiornati»: l’ultima riconciliazione e l’ultima operazione registrata."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ორი პასუხი კითხვაზე «მონაცემები განახლებულია?»: ბოლო შეჯერება და ბოლოს ჩაწერილი ოპერაცია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Мәліметтер жаңа ма» деген сұраққа екі жауап: соңғы салыстыру және соңында жазылған операция."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Көрсөткүчтөр актуалдуубу» деген суроого эки жооп: акыркы салыштыруу жана акыркы жазылган операция."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwie odpowiedzi na pytanie «czy dane są aktualne»: ostatnie uzgodnienie i ostatnio zapisana operacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas formas de verificar se os valores estão atualizados: a conciliação mais recente e a última operação registrada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas respostas à pergunta «os valores estão atualizados»: a última conciliação e a última operação registada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два ответа на вопрос «цифры свежие?»: последняя сверка и последняя записанная операция."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ду ҷавоб ба «оё рақамҳо наванд»: муқоисаи охирини ҳисобҳо ва амалиёте, ки охирин шуда сабт шудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Rakamlar güncel mi» sorusunun iki yanıtı: son mutabakat ve en son kaydedilen işlem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дві відповіді на «чи актуальні цифри»: остання звірка і остання записана операція."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ko‘rsatkichlar yangimi» degan savolga ikki javob: so‘nggi solishtiruv va oxirgi qayd etilgan operatsiya."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「數字是否為最新」的兩項依據：最近一次對帳和最後記錄的交易。"
          }
        }
      }
    },
    "why.rule.lastRecord": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əməliyyatın tarixinə görə deyil, qeydə alınma vaxtına görə son əməliyyat; köçürmələr və tətbiqin uçot üçün yaratdığı qeydlər nəzərə alınmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апошняя запісаная аперацыя паводле часу запісу, а не даты аперацыі; пераводы і службовыя запісы праграмы не ўлічваюцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naposledy zapsaná operace podle času zápisu, nikoli data operace; převody a položky vytvářené aplikací pro evidenci jsou vynechány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der zuletzt aufgeschriebene Vorgang — nach dem Zeitpunkt des Schreibens, nicht nach seinem Datum; Überweisungen und Zeilen, die die App für ihre Bücher schreibt, bleiben weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation written down last — by when it was written, not by its date; transfers and lines the app writes for its books are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última operación anotada — por cuándo se escribió, no por su fecha; se dejan fuera las transferencias y las líneas que la app escribe para sus cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération notée en dernier — d'après le moment où elle a été notée, pas sa date ; les virements et les lignes que l'app écrit pour ses comptes sont exclus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին գրանցված գործարքը՝ ըստ գրանցման պահի, ոչ թե ամսաթվի։ Փոխանցումները և հավելվածի հաշվառման գրառումները ներառված չեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima operazione registrata, in base al momento della registrazione e non alla sua data; sono esclusi i trasferimenti e le righe contabili create dall’app."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლოს ჩაწერილი ოპერაცია ჩაწერის დროის და არა ოპერაციის თარიღის მიხედვით; გადარიცხვები და აპის მიერ აღრიცხვისთვის შექმნილი ჩანაწერები არ ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңында жазылған операция — оның күні бойынша емес, қашан жазылғаны бойынша; аударымдар мен қолданба өз кітабы үшін жазатын жолдар есепке алынбайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы жазылган операция — операциянын датасы боюнча эмес, жазылган убактысы боюнча; которуулар жана колдонмо эсепке алуу үчүн түзгөн жазуулар кирбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio zapisana operacja według czasu zapisu, a nie daty operacji. Przelewy i wpisy tworzone przez aplikację na potrzeby rozliczeń są pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última operação registrada, pela data do registro e não pela data da operação; transferências e lançamentos criados pelo app para controle ficam de fora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A última operação registada, pela data do registo e não pela data da operação; exclui transferências e registos criados pela app para efeitos contabilísticos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция, записанная последней, — по моменту записи, а не по её дате; переводы и служебные строки приложения не считаются."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиёте, ки аз рӯи вақти сабт охирин аст, на аз рӯи санаи амалиёт; интиқолҳо ва сабтҳои ҳисобдории барнома дохил намешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En son kaydedilen işlem — işlem tarihine göre değil, kayıt zamanına göre; transferler ve uygulamanın kayıtlar için oluşturduğu satırlar hariç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання записана операція — за тим, коли її записано, а не за датою; перекази й рядки, які застосунок пише для своїх книг, не враховуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi qayd etilgan operatsiya — operatsiya sanasi emas, qayd etilgan vaqti bo‘yicha; o‘tkazmalar va ilova hisob-kitob uchun yaratgan yozuvlar kiritilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最後記錄的交易，依記錄時間而非交易日期判斷；不包括轉帳及 App 為記帳而建立的項目。"
          }
        }
      }
    },
    "why.rule.limits": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər limit üzrə bu ay xərclərim mövcud məbləğlə — limit və əvvəlki aylardan qalan vəsaitlə — müqayisə edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожны ліміт параўноўвае мае выдаткі за гэты месяц з даступнай сумай — лімітам і перанесеным астаткам за мінулыя месяцы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý limit porovnává moje letošní výdaje v daném limitu s dostupnou částkou — limitem navýšeným o převody z předchozích měsíců."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Limit vergleicht meine Ausgaben in diesem Monat darunter mit dem, was verfügbar ist — dem Limit plus was frühere Monate übertragen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each limit compares my spending this month under it with what is available — the limit plus what earlier months carried over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada límite compara mi gasto de este mes en él con lo disponible — el límite más lo que traspasaron los meses anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque plafond compare mes dépenses du mois sous ce plafond avec ce qui est disponible — le plafond plus ce que les mois précédents ont reporté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր սահմանաչափ համեմատում է այս ամսվա իմ ծախսերը հասանելի գումարի հետ՝ սահմանաչափին գումարած նախորդ ամիսներից փոխանցված մնացորդը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni limite confronta le mie spese del mese nella relativa categoria con l’importo disponibile: il limite più quanto riportato dai mesi precedenti."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული ლიმიტი ადარებს მასში შესულ ჩემს ამ თვის ხარჯს ხელმისაწვდომ თანხას — ლიმიტსა და წინა თვეებიდან გადმოტანილ ნაშთს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр лимит осы айдағы менің шығысымды оның астындағы қолжетімді сомамен салыстырады — лимит плюс бұрынғы айлардан көшкен сома."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир лимит ушул айдагы ага тиешелүү чыгашамды жеткиликтүү сумма менен салыштырат: лимитке мурунку айлардан өткөн калдык кошулат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy limit porównuje moje wydatki w tym miesiącu z dostępną kwotą: limitem powiększonym o środki przeniesione z poprzednich miesięcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada limite compara meus gastos deste mês com o valor disponível: o limite mais o saldo transferido de meses anteriores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada limite compara as minhas despesas deste mês abrangidas por ele com o valor disponível — o limite mais o valor transitado dos meses anteriores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый лимит сравнивает мои траты месяца под ним с доступным — лимитом плюс перенесённым с прошлых месяцев."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳар маҳдудият хароҷоти ман дар ин моҳро бо маблағи дастрас муқоиса мекунад: маҳдудият иловаи бақияи аз моҳҳои пеш гузаронидашуда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her limit, bu ay kapsamındaki harcamamı kullanılabilir tutarla karşılaştırır: limit ve önceki aylardan devreden tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен ліміт порівнює мої витрати за місяць у його межах із тим, що доступно: ліміт плюс перенесене з попередніх місяців."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir limit bo‘yicha shu oydagi xarajatlarim mavjud summa — limit va oldingi oylardan o‘tgan qoldiq bilan solishtiriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各額度比較本月該額度下的個人支出與可用金額；可用金額為額度加上前幾個月結轉的金額。"
          }
        }
      }
    },
    "why.rule.monthIncome": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aya aid olan və bu günə qədər daxil olmuş gəlir, mənbəyə görə; hələ gözlənilən məbləğ ayrıca göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход гэтага месяца, атрыманы да сёння, па крыніцах; чаканыя паступленні паказаны асобна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjmy náležející tomuto měsíci, které přišly do dneška, podle zdroje; dosud očekávané příjmy se uvádějí zvlášť."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen, die zu diesem Monat gehören und bis heute eingegangen sind, nach Quelle; was noch erwartet wird, steht getrennt davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income that belongs to this month and has arrived by today, by source; what is still expected comes apart from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso que corresponde a este mes y ha llegado hasta hoy, por origen; lo que todavía se espera va aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus qui appartiennent à ce mois et sont arrivés jusqu'à aujourd'hui, par source ; ce qui est encore attendu en est séparé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվան պատկանող և մինչ օրս ստացված եկամուտը՝ ըստ աղբյուրի։ Դեռ սպասվող գումարը ցուցադրվում է առանձին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate relative a questo mese e ricevute entro oggi, per fonte; quanto ancora atteso è indicato a parte."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეზე მიკუთვნებული და დღემდე მიღებული შემოსავალი წყაროების მიხედვით; ჯერ კიდევ მოსალოდნელი შემოსავალი ცალკე ნაჩვენებია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айға тиесілі және бүгінгі күнге дейін келген табыс, дереккөзі бойынша; әлі күтілетіні одан бөлек көрсетіледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айга тиешелүү жана бүгүнкү күнгө чейин түшкөн киреше булактары боюнча көрсөтүлөт; күтүлүп жаткан киреше өзүнчө эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochód należny za ten miesiąc i otrzymany do dziś, według źródła. Oczekiwane wpływy są pokazywane osobno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A receita referente a este mês recebida até hoje, por fonte; o que ainda é esperado aparece à parte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O rendimento deste mês recebido até hoje, por origem; o que ainda está previsto é apresentado à parte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход, который относится к этому месяцу и пришёл к сегодняшнему дню, по источникам; ожидаемое показано отдельно."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади марбут ба ин моҳ, ки то имрӯз расидааст, аз рӯи манбаъ; даромади ҳанӯз интизорӣ ҷудо нишон дода мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aya ait olup bugüne kadar gelen gelir, kaynağına göre; hâlâ beklenen tutar ayrıca gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід, що належить цьому місяцю і надійшов до сьогодні, за джерелами; те, що ще очікується, відокремлюється від нього."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu oyga tegishli va bugungacha kelib tushgan daromad manba bo‘yicha; hali kutilayotgan daromad alohida ko‘rsatiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屬於本月且截至今天已收到的收入，按來源分組；尚待收取的金額另列。"
          }
        }
      }
    },
    "why.rule.monthRest": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın ilk on günündə hazırda xərclənə bilən məbləğdən gün ərzində qarşıdakı ödənişlər və borc ödənişləri üçün ayrılan vəsait çıxılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума, якую можна выдаткаваць цяпер, мінус плацяжы і сумы на пагашэнне даўгоў, зарэзерваваныя да сённяшняга дня ў першую дэкаду месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částka dostupná k utracení po odečtení plateb a splátek dluhů zadržovaných do dnešního dne během prvních deseti dní v měsíci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jetzt ausgegeben werden kann, abzüglich der Zahlungen und der Fälligkeiten von Schulden, die bis zum Tag zurückgehalten werden, in den ersten zehn Tagen des Monats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be spent now less the payments and the dues of debts held back through the day, in the first ten days of the month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se puede gastar ahora, menos los pagos y los vencimientos de deudas retenidos hasta el final del día, en los primeros diez días del mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui peut être dépensé maintenant, moins les paiements et les échéances de dettes mis de côté jusqu'à la fin de la journée, pendant les dix premiers jours du mois."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա առաջին տասը օրերին՝ ներկայում ծախսելու համար հասանելի գումարը՝ հանած մինչև օրվա վերջ պահվող վճարումները և պարտքերի մարումները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si può spendere ora, meno i pagamenti e le rate dei debiti accantonati per il giorno, nei primi dieci giorni del mese."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა, რომლის დახარჯვაც ახლა შეიძლება, თვის პირველ ათ დღეში დღემდე გადადებული გადასახდელებისა და ვალის შენატანების გამოკლებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір не жұмсауға болады, минус күн ішінде ұсталып қалған төлемдер мен берешек міндеттемелері; ай басындағы алғашқы он күнде."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдын алгачкы он күнүндө азыр сарптоого мүмкүн болгон суммадан күн бою төлөмдөр жана карыз төлөмдөрү үчүн сакталган акча алынат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota dostępna teraz do wydania minus płatności i raty długów zarezerwowane do dziś, w pierwszych dziesięciu dniach miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pode ser gasto agora, menos os pagamentos e vencimentos de dívidas reservados até hoje, nos primeiros dez dias do mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pode ser gasto agora, menos os pagamentos e as prestações de dívidas reservados até hoje, nos primeiros dez dias do mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что можно тратить сейчас за вычетом платежей и сроков по долгам до этого дня — в первые десять дней месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ҳоло дастрас барои харҷ, тарҳи пардохтҳо ва маблағи қарзҳои то имрӯз ҷудошуда дар даҳ рӯзи аввали моҳ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an harcanabilir tutardan, ayın ilk on gününde gün sonuna kadar ayrılan ödemeler ve borç taksitleri çıkarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що можна витратити зараз мінус платежі й прострочені борги, утримані на сьогодні, у перші десять днів місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oy boshidagi o‘n kunda hozir sarflash mumkin bo‘lgan mablag‘dan shu kungacha saqlab turilgan to‘lovlar va qarz to‘lovlari ayriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月前十天內，目前可用於支出的金額，減去截至當天預留的付款及到期債務。"
          }
        }
      }
    },
    "why.rule.monthToDate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aya aid olan və bu günə qədər daxil olmuş gəlirdən ayın 1-dən bu günə qədər xərclərim çıxılır; hər ikisi ötən ayın eyni günləri ilə müqayisə edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход гэтага месяца, атрыманы да сёння, мінус мае выдаткі ад 1-га чысла да сёння; абедзве сумы параўноўваюцца з тымі ж днямі мінулага месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjmy náležející tomuto měsíci, které přišly do dneška, minus moje výdaje od 1. dne měsíce do dneška; obě částky se porovnávají se stejnými dny minulého měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen, die zu diesem Monat gehören und bis heute eingegangen sind, abzüglich meiner Ausgaben vom 1. bis heute; beides wird mit denselben Tagen des letzten Monats verglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income that belongs to this month and arrived by today, less my spending from the 1st to today; both are compared with the same days of last month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresos que corresponden a este mes y llegaron hasta hoy, menos mi gasto del 1 a hoy; ambos se comparan con los mismos días del mes pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus qui appartiennent à ce mois et sont arrivés jusqu'à aujourd'hui, moins mes dépenses du 1er à aujourd'hui ; les deux sont comparés aux mêmes jours du mois dernier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվան պատկանող և մինչ օրս ստացված եկամուտը՝ հանած ամսի 1-ից մինչ օրս իմ ծախսերը։ Երկուսն էլ համեմատվում են անցյալ ամսվա նույն օրերի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate relative a questo mese e ricevute entro oggi, meno le mie spese dal 1° a oggi; entrambe sono confrontate con gli stessi giorni del mese scorso."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეზე მიკუთვნებული და დღემდე მიღებული შემოსავალი მინუს ჩემი ხარჯი 1 რიცხვიდან დღემდე; ორივე შედარებულია გასული თვის იმავე დღეებთან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айға тиесілі және бүгінге дейін келген табыс, минус 1-нен бүгінге дейінгі менің шығысым; екеуі де өткен айдың дәл сол күндерімен салыстырылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айга тиешелүү жана бүгүнкү күнгө чейин түшкөн кирешеден 1-күндөн бүгүнкү күнгө чейинки чыгашам алынат; экөө тең өткөн айдын ушул эле күндөрү менен салыштырылат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochód należny za ten miesiąc i otrzymany do dziś minus moje wydatki od 1. dnia miesiąca do dziś. Obie kwoty są porównywane z tymi samymi dniami poprzedniego miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A receita referente a este mês recebida até hoje, menos meus gastos do dia 1 até hoje; ambos são comparados com os mesmos dias do mês passado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O rendimento deste mês recebido até hoje, menos as minhas despesas desde o dia 1 até hoje; ambos são comparados com os mesmos dias do mês passado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходы этого месяца, пришедшие по сегодня, минус мои расходы с 1-го числа по сегодня; оба сравниваются с теми же днями прошлого месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади марбут ба ин моҳ, ки то имрӯз расидааст, тарҳи хароҷоти ман аз рӯзи 1-ум то имрӯз; ҳар ду бо ҳамин рӯзҳои моҳи гузашта муқоиса мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aya ait olup bugüne kadar gelen gelirden ayın 1’inden bugüne kadarki harcamam çıkarılır; ikisi de geçen ayın aynı günleriyle karşılaştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід, що належить цьому місяцю і надійшов до сьогодні, мінус мої витрати з 1-го по сьогодні; обидва порівнюються з тими самими днями минулого місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu oyga tegishli va bugungacha kelib tushgan daromaddan 1-sanadan bugungacha xarajatlarim ayriladi; ikkalasi ham o‘tgan oyning shu kunlari bilan solishtiriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屬於本月且截至今天已收到的收入，減去從 1 日到今天的個人支出；兩者皆與上個月同期比較。"
          }
        }
      }
    },
    "why.rule.monthlySpending": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son on iki ayın hər birində xərclərim; cari ay üçün indiyədək olan xərclər göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за кожны з апошніх дванаццаці месяцаў; за бягучы месяц — на сёння."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje výdaje za každý z posledních dvanácti měsíců, u současného měsíce dosud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben in jedem der letzten zwölf Monate, der laufende bisher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of each of the last twelve months, the current one so far."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto de cada uno de los últimos doce meses, el actual hasta hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses de chacun des douze derniers mois, le mois en cours jusqu'à aujourd'hui."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Իմ ծախսերը վերջին տասներկու ամիսներից յուրաքանչյուրում, իսկ ընթացիկ ամսվա համար՝ մինչ օրս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese di ciascuno degli ultimi dodici mesi; per il mese attuale, fino a oggi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი ხარჯი ბოლო თორმეტი თვიდან თითოეულში, მიმდინარე თვისთვის კი — დღემდე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы он екі айдың әрқайсысындағы менің шығысым, ағымдағы ай — осы уақытқа дейін."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы он эки айдын ар бириндеги чыгашам; учурдагы ай үчүн азыркыга чейинки чыгаша көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w każdym z ostatnich dwunastu miesięcy, w tym wydatki w bieżącym miesiącu do dziś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos em cada um dos últimos doze meses, incluindo o mês atual até agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas de cada um dos últimos doze meses, incluindo o mês atual até hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы за каждый из последних двенадцати месяцев, текущий — на сегодня."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ман дар ҳар яке аз дувоздаҳ моҳи охир; барои моҳи ҷорӣ — то имрӯз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son on iki ayın her birindeki harcamam; içinde bulunduğumuz ay için şu ana kadarki tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за кожен із останніх дванадцяти місяців, поточний — поки що."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "So‘nggi o‘n ikki oyning har biridagi xarajatlarim, joriy oy uchun esa bugungacha bo‘lgan xarajatlar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近十二個月每月的個人支出，本月計算至今。"
          }
        }
      }
    },
    "why.rule.owedToMe": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqaları üçün ödədiyim və qaytarılması gözlənilən paylar: hər paydan qaytarılmış məbləğ çıxıldıqdan sonra qalan məbləğ."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Часткі, якія я аплаціў за іншых і чакаю назад: рэшта кожнай часткі пасля выліку вернутых грошай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Části zaplacené za ostatní, které mají být vráceny: zbývající částka po odečtení vrácených peněz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile, die ich für andere bezahlt habe und die zurückerwartet werden: was von jedem übrig ist, wenn das zurückgegebene Geld abgezogen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parts I paid for others that are expected back: what is left of each once money back is taken off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partes que pagué por otros y que se espera que me devuelvan: lo que queda de cada una tras descontar el dinero devuelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parts que j'ai payées pour d'autres et qui doivent revenir : ce qui reste de chacune une fois l'argent rendu déduit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուրիշների համար իմ վճարած և վերադարձի սպասվող գումարները՝ յուրաքանչյուր բաժնի մնացորդը՝ հանած արդեն վերադարձվածը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quote pagate per altri che devono essere restituite: il saldo di ciascuna quota dopo aver sottratto quanto già restituito."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვებისთვის ჩემ მიერ გადახდილი და დასაბრუნებელი წილები: თითოეულის ნაშთი უკვე დაბრუნებული თანხის გამოკლებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқалар үшін төленген, қайтуы күтілетін бөліктер: ақша қайтарылғаннан кейін әрқайсысынан не қалғаны."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Башкалар үчүн төлөгөн жана кайтарылышы күтүлгөн үлүштөр: ар биринен кайтарылган акча алынгандан кийинки калдык."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Części wydatków opłacone przeze mnie za innych, które mają zostać zwrócone, po odjęciu otrzymanych zwrotów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Partes que paguei por outras pessoas e espero receber de volta: o saldo de cada uma após descontar o que já foi recebido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes que paguei por outros e que espero receber: o valor restante de cada uma após deduzir o que já foi devolvido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Части, оплаченные за других и ещё ожидаемые назад: что осталось от каждой за вычетом уже вернувшихся денег."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қисмҳое, ки ман барои дигарон пардохтаам ва бояд баргарданд: бақияи ҳар қисм пас аз тарҳи маблағи баргардонидашуда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başkaları için ödediğim ve geri almayı beklediğim paylar: her birinden geri ödenen tutar çıkarıldıktan sonra kalan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частини, які я сплатив за інших і які мають повернутися: що лишилося за кожною, після віднімання повернених грошей."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqalar uchun to‘lagan va qaytarilishi kutilayotgan ulushlar: har biridan qaytarilgan pul ayrilgandan keyingi qoldiq."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代他人支付且預計收回的款項：各筆金額扣除已歸還款項後的餘額。"
          }
        }
      }
    },
    "why.rule.qualities": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay xərclərimin hər hissəsi qiymətinə görə — yaxşı, neytral və ya pis — hesablanır; faizlər bütün qiymətləndirilmiş xərclərə əsaslanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожная частка маіх выдаткаў за гэты месяц улічваецца паводле ацэнкі — добрая, нейтральная або дрэнная; долі разлічваюцца ад агульнай сумы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá část mých výdajů tohoto měsíce se započítává podle hodnocení — dobré, neutrální nebo špatné; podíly jsou vypočteny ze všech těchto výdajů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Teil meiner Ausgaben dieses Monats zählt unter seiner Bewertung — gut, neutral oder schlecht; die Anteile beziehen sich auf alle davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each part of my spending this month counts under its rating — good, neutral or bad; shares are of all of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada parte de mi gasto de este mes cuenta según su valoración — buena, neutral o mala; las partes son de todas ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque part de mes dépenses de ce mois compte selon sa note — utile, neutre ou superflu ; les parts sont calculées sur l'ensemble."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվա իմ յուրաքանչյուր ծախս հաշվվում է ըստ գնահատականի՝ լավ, չեզոք կամ վատ։ Տոկոսային բաժինները հաշվվում են բոլոր գնահատված ծախսերից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni parte delle mie spese di questo mese è conteggiata secondo la valutazione: buona, neutra o cattiva; le percentuali si riferiscono al totale."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვის ჩემი ხარჯის თითოეული ნაწილი ითვლება მისი შეფასების მიხედვით — კარგი, ნეიტრალური ან ცუდი; წილები ყველა შეფასებული ხარჯის ჯამიდან გამოითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдағы шығысымның әр бөлігі өз бағасымен — жақсы, бейтарап немесе жаман — есептеледі; үлестер барлығынан алынады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул айдагы ар бир чыгашам өз баасы боюнча эсептелет: жакшы, нейтралдуу же жаман; үлүштөр бардык бааланган чыгашалардан эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda część moich wydatków w tym miesiącu jest uwzględniana zgodnie z oceną: dobra, neutralna lub zła. Udziały dotyczą wszystkich ocenionych wydatków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada parte dos meus gastos deste mês é agrupada por avaliação — boa, neutra ou ruim; as porcentagens consideram o total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada parte das minhas despesas deste mês conta para a respetiva classificação — boa, neutra ou má; as percentagens são calculadas sobre o total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая часть моих расходов этого месяца считается по своей оценке — хорошая, обычная или плохая; доли — от их суммы."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳар қисми хароҷоти ман дар ин моҳ аз рӯи баҳояш ҳисоб мешавад — хуб, бетараф ё бад; ҳиссаҳо аз ҷамъи онҳо ҳисоб мешаванд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamamın her bölümü değerlendirmesine göre sayılır: iyi, nötr veya kötü; oranlar tümü üzerinden hesaplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна частина моїх витрат за місяць рахується за своєю оцінкою — добра, нейтральна чи погана; частки — від усіх них."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu oydagi xarajatlarimning har bir qismi bahosi — yaxshi, neytral yoki yomon bo‘yicha hisoblanadi; ulushlar barcha baholangan xarajatlarga nisbatan olinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月各筆個人支出按評級歸類為好、普通或壞；比例以所有這些支出計算。"
          }
        }
      }
    },
    "why.rule.ratesStatus": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqdə saxlanılan valyutanın ən son məzənnəsinin tarixi; bank həftəsonları məzənnə dərc etmir, buna görə bir neçə günlük fərq normaldır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата найноўшага курсу валюты ў праграме; банк не публікуе курсы ў выхадныя, таму некалькі дзён — гэта нармальна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum nejnovějšího kurzu měny, který má aplikace k dispozici; banka kurzy o víkendech nezveřejňuje, takže stáří několika dní je běžné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tag des neuesten Kurses einer Währung, die die App hält; die Bank veröffentlicht am Wochenende nicht, daher sind einige Tage normal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day of the newest rate of a currency the app holds; the bank does not publish on weekends, so a few days is normal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día del tipo más reciente de cada divisa que tiene la app; el banco no publica los fines de semana, así que unos días es normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du cours le plus récent d'une devise détenue par l'app ; la banque ne publie pas le week-end, donc quelques jours d'écart sont normaux."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածում պահվող արժույթի վերջին փոխարժեքի ամսաթիվը։ Բանկը հանգստյան օրերին փոխարժեք չի հրապարակում, ուստի մի քանի օրվա վաղեմությունը սովորական է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data del tasso di cambio più recente disponibile nell’app; la banca non pubblica tassi nei fine settimana, quindi un ritardo di qualche giorno è normale."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპში არსებული ვალუტის უახლესი კურსის თარიღი; ბანკი შაბათ-კვირას კურსს არ აქვეყნებს, ამიტომ რამდენიმე დღის სხვაობა ნორმალურია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба ұстайтын валютаның ең жаңа бағамының күні; банк демалыс күндері жарияламайды, сондықтан бірнеше күн кідіру қалыпты."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмодо сакталган валюталардын эң акыркы курсунун күнү; банк дем алышта курс жарыялабайт, ошондуктан бир нече күндүк айырма кадыресе."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data najnowszego kursu waluty zapisanego w aplikacji. Bank nie publikuje kursów w weekendy, więc kilkudniowa przerwa jest normalna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data da cotação de moeda mais recente disponível no app; o banco não publica cotações nos fins de semana, por isso alguns dias de diferença são normais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A data do câmbio mais recente de uma moeda guardado na app; o banco não publica câmbios ao fim de semana, pelo que alguns dias de diferença são normais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День самого свежего курса валюты в приложении; по выходным банк не публикует, так что несколько дней — это нормально."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Санаи қурби навтарини асъоре, ки дар барнома мавҷуд аст; бонк дар рӯзҳои истироҳат қурб нашр намекунад, аз ин рӯ фарқи чандрӯза муқаррарӣ аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadaki en güncel döviz kurunun tarihi; banka hafta sonları kur yayımlamadığı için birkaç günlük fark normaldir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "День найновішого курсу валюти, яка є в застосунку; банк не публікує курси на вихідних, тож кілька днів — норма."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilovadagi valuta kurslarining eng yangisi sanasi; bank dam olish kunlari kurs e’lon qilmaydi, shuning uchun bir necha kunlik farq odatiy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 儲存的最新貨幣匯率日期；銀行週末不公布匯率，因此相隔幾天屬正常情況。"
          }
        }
      }
    },
    "why.rule.savingsRate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın gəlirindən xərclərim çıxıldıqdan sonra qalan məbləğdir (məqsədlərə ayrılan pul xərc sayılmır); onun gəlirdəki payı yığım nisbətidir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даход за месяц мінус мае выдаткі (грошы на мэты адкладваюцца, а не трацяцца) — гэта зберажаная сума; яе доля ў даходзе — норма зберажэнняў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjmy za měsíc po odečtení výdajů tvoří úspory. Peníze vložené do cílů se odkládají, neutrácí. Podíl úspor na příjmech je míra úspor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen des Monats abzüglich meiner Ausgaben (Geld in Ziele wird beiseitegelegt, nicht ausgegeben) bleiben übrig; ihr Anteil an den Einnahmen ist die Sparquote."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income of the month less my spending (money put into goals is put aside, not spent) is what is kept; its share of the income is the savings rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ingreso del mes menos mi gasto (lo que se aporta a objetivos se aparta, no se gasta) es lo que se guarda; su parte del ingreso es la tasa de ahorro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les revenus du mois moins mes dépenses (l'argent mis dans les objectifs est mis de côté, non dépensé) est ce qui reste ; sa part des revenus est le taux d'épargne."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա եկամտից հանած իմ ծախսերը խնայված գումարն է (նպատակներին փոխանցված գումարը մի կողմ է դրված, ոչ թե ծախսված)։ Դրա բաժինը եկամտի մեջ խնայողության տոկոսն է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le entrate del mese meno le mie spese danno la somma risparmiata; il denaro destinato agli obiettivi è accantonato, non speso. La percentuale delle entrate risparmiata è il tasso di risparmio."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვის შემოსავალს გამოკლებული ხარჯები (მიზნებისთვის გადადებული თანხა ხარჯად არ ითვლება) დანაზოგია; მისი წილი შემოსავალში დანაზოგის მაჩვენებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың табысы, минус менің шығысым (мақсаттарға салынған ақша жұмсалмайды, бөлініп қойылады) — қалғаны; оның табыстағы үлесі — жинақ мөлшерлемесі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлык кирешеден чыгашаларымды алып салганда калган акча; максаттарга салынган акча чыгашага кирбейт. Калган акчанын кирешедеги үлүшү — топтоо чени."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochód z miesiąca pomniejszony o wydatki to zaoszczędzona kwota. Wpłaty na cele są odkładane, a nie wydawane. Udział tej kwoty w dochodzie to stopa oszczędności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A renda do mês menos meus gastos é o valor guardado. O dinheiro destinado a metas é guardado, não gasto. A parte da renda guardada é a taxa de poupança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O rendimento do mês menos as despesas (o dinheiro destinado a objetivos é poupado, não gasto) é o valor poupado; a sua percentagem do rendimento é a taxa de poupança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход месяца минус мои траты (деньги в цели — отложенные, а не траты) — это то, что осталось; его доля в доходе и есть норма сбережений."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Даромади моҳ бо тарҳи хароҷот маблағи пасандозшуда аст; ҳиссаи он аз даромад меъёри пасандоз аст. Маблағи ҳадафҳо пасандоз мешавад, на харҷ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın gelirinden harcamalarım çıkarıldığında kalan tutardır (hedeflere aktarılan para harcanmaz, biriktirilir). Bu tutarın gelire oranı tasarruf oranıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дохід місяця мінус мої витрати (гроші, відкладені в цілі, відкладаються, а не витрачаються) — це те, що лишилося; його частка від доходу і є нормою заощаджень."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylik daromaddan xarajatlar ayirilganda qolgan pul jamg‘ariladi (maqsadlarga ajratilgan pul sarflanmaydi). Uning daromaddagi ulushi jamg‘arish darajasidir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月收入減去支出後的金額（存入目標的錢是儲蓄，不算支出），占收入的比例就是儲蓄率。"
          }
        }
      }
    },
    "why.rule.selfEmployment": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylıq vergi: gəlir × həmin günün Bank of Russia məzənnəsi × vergi dərəcəsi, güzəşt çıxılmaqla və qəpiyədək hesablanır; 100 ₽-dən az olduqda növbəti aya keçirilir; ayın 28-dək ödənilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падатак за месяц: даход па курсе Банка Расіі на дзень атрымання × стаўка мінус вылік, з дакладнасцю да капейкі; сума менш за 100 ₽ пераносіцца на наступны месяц; тэрмін выплаты — 28-га чысла."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční daň: příjem přepočtený kurzem Ruské banky platným v daný den × sazba minus odpočet, na kopějky. Částka pod 100 ₽ se převádí do dalšího měsíce. Splatnost je 28. dne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuer eines Monats: Einnahmen mal Satz der Bank of Russia ihres Tages, abzüglich des Abzugs, auf den Kopeken genau; unter 100 ₽ geht sie in den nächsten Monat; fällig am 28."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tax of a month: income by the rate of the Bank of Russia of its day × the rate, less the deduction, to the kopeck; below 100 ₽ it goes on to the next month; due on the 28th."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El impuesto de un mes: ingreso por la tasa del Banco de Rusia de su día × la tasa, menos la deducción, al kopek; por debajo de 100 ₽ pasa al mes siguiente; vence el día 28."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impôt d'un mois : revenus au taux de la Banque de Russie de leur jour × le taux, moins la déduction, au kopek près ; sous 100 ₽ il passe au mois suivant ; à payer le 28."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա հարկը՝ եկամուտը՝ ըստ տվյալ օրվա Ռուսաստանի բանկի փոխարժեքի, × դրույքաչափը՝ հանած նվազեցումը, կոպեկի ճշտությամբ։ 100 ₽-ից պակասը փոխանցվում է հաջորդ ամիս։ Վճարման օրը՝ 28-ը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imposta del mese: entrate convertite al tasso della Banca di Russia del giorno × aliquota, meno la detrazione, al copeco; se inferiore a 100 ₽, passa al mese successivo; scade il 28."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თვის გადასახადი: შემოსავალი რუსეთის ბანკის იმ დღის კურსით × განაკვეთი, გამოკლებული შეღავათი, კაპიკამდე; 100 ₽-ზე ნაკლები თანხა გადადის მომდევნო თვეში; გადახდის ვადაა 28 რიცხვი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдың салығы: сол күнгі Ресей Банкінің бағамымен табыс × мөлшерлеме, минус шегерім, тиынға дейін; 100 ₽-тен аз болса, келесі айға өтеді; мерзімі — 28-і."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлык салык: киреше ошол күнкү Россия Банкынын курсу боюнча × салык чени, чегерүүнү алып салганда, тыйынга чейин; 100 ₽ аз болсо кийинки айга өтөт; төлөө мөөнөтү — 28и."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatek za miesiąc: dochód według kursu Banku Rosji z dnia uzyskania × stawka, pomniejszony o odliczenie, z dokładnością do kopiejki. Kwota poniżej 100 ₽ przechodzi na kolejny miesiąc. Termin płatności: 28. dzień miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O imposto do mês: renda pela cotação do Banco da Rússia no dia × a alíquota, menos a dedução, até o copeque; abaixo de 100 ₽, passa para o mês seguinte; vence no dia 28."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposto do mês: rendimento à taxa do Bank of Russia do respetivo dia × taxa de imposto, menos a dedução, arredondado ao copeque; valores inferiores a 100 ₽ passam para o mês seguinte; pagamento até dia 28."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог месяца: доход по курсу ЦБ дня × ставка минус вычет, до копейки; меньше 100 ₽ переносится; срок — 28-е следующего месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Андози моҳ: даромад бо қурби ҳамонрӯзаи Бонки Русия × меъёр, бо тарҳи имтиёз, то тин; камтар аз 100 ₽ ба моҳи оянда мегузарад; муҳлати пардохт — рӯзи 28-ум."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık vergi: Gelirin işlem günündeki Rusya Merkez Bankası kuruyla hesaplanan tutarı × oran, indirim düşülerek kopek hassasiyetinde hesaplanır. 100 ₽ altındaki tutar sonraki aya devreder; son ödeme günü ayın 28’idir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Податок за місяць: дохід за ставкою Банку Росії його дня × ставка, мінус вирахування, до копійки; менше 100 ₽ переходить на наступний місяць; сплачується 28-го."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylik soliq: daromad tushgan kundagi Rossiya banki kursi bo‘yicha hisoblanib, soliq stavkasiga ko‘paytiriladi va undan chegirma ayiriladi. Summa tiyingacha yaxlitlanadi; 100 ₽ dan kam bo‘lsa, keyingi oyga o‘tkaziladi. To‘lov muddati — 28-sana."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月稅額：收入按當日俄羅斯銀行匯率換算後乘以稅率，再減去扣抵額，精確至戈比；不足 100 ₽ 則結轉下月；28 日到期。"
          }
        }
      }
    },
    "why.rule.smallPurchases": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay xərclərimdəki payımdan təyin etdiyiniz limiti aşmayan alışlar; zəruri kateqoriyalar, məqsədlər və sayğaclar nəzərə alınmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мая доля выдаткаў за месяц у межах зададзенага ліміту, без неабходных катэгорый, мэт і лічыльнікаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje podíly na měsíčních výdajích do nastaveného limitu, bez nezbytných kategorií, cílů a počítadel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Anteile an den Ausgaben dieses Monats, die nicht mehr kosten als das Limit, das Sie festgelegt haben, außerhalb der notwendigen Kategorien, der Ziele und der Zählungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My parts of this month's spending that cost no more than the limit you set, outside the essential categories, the goals and the counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis partes del gasto de este mes que cuestan no más que el límite que fijó, fuera de las categorías esenciales, los objetivos y los recuentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes parts des dépenses de ce mois qui ne coûtent pas plus que le plafond que vous avez fixé, hors catégories essentielles, objectifs et comptages."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվա ծախսերում իմ բաժինները, որոնք չեն գերազանցում ձեր սահմանած շեմը՝ առանց անհրաժեշտ կատեգորիաների, նպատակների և հաշվարկների։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie quote delle spese di questo mese entro il limite impostato, escluse categorie essenziali, obiettivi e conteggi."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვის ხარჯებში ჩემი წილი, რომელიც არ აღემატება თქვენ მიერ დადგენილ ზღვარს, აუცილებელი კატეგორიების, მიზნებისა და გადათვლების გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдағы шығысымның сіз белгілеген лимиттен аспайтын бөліктері; міндетті санаттардан, мақсаттардан және санаулардан тыс."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушул айдагы чыгашаларымдын сиз койгон чектен ашпаган бөлүгү; зарыл категориялар, максаттар жана эсептер кирбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje części wydatków z tego miesiąca, które nie przekraczają ustawionego limitu, z wyłączeniem kategorii niezbędnych, celów i przeliczeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Minhas partes dos gastos deste mês que não passam do limite definido, exceto categorias essenciais, metas e contagens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas partes das despesas deste mês que não ultrapassam o limite definido, excluindo categorias essenciais, objetivos e contagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои части трат этого месяца не дороже заданного вами предела, вне необходимых категорий, целей и сверок."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳиссаи ман аз хариди ин моҳ, ки аз ҳадди таъинкардаатон зиёд нест, ба ҷуз категорияҳои зарурӣ, ҳадафҳо ва ҳисобҳо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamalardan payıma düşen, belirlediğiniz limiti aşmayan tutarlar; zorunlu kategoriler, hedefler ve sayımlar hariç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої частки витрат цього місяця, що коштують не більше за ваш ліміт, поза необхідними категоріями, цілями й підрахунками."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy xarajatlarimdagi ulushimdan siz belgilagan limitdan oshmaganlari. Zarur toifalar, maqsadlar va hisoblar kiritilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月我的支出中，金額不超過所設上限的購買項目，不含必要類別、目標及盤點。"
          }
        }
      }
    },
    "why.rule.spendToday": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün xərclədiyim məbləğ — günün hər əməliyyatında payımdan qaytarmalar çıxılmaqla — əvvəlki 28 günün ortalaması ilə müqayisədə."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мая доля ўсіх сённяшніх аперацый за вылікам вяртанняў у параўнанні з сярэднім за папярэднія дні з апошніх 28."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik jsem dnes utratil: můj podíl na všech dnešních operacích po odečtení vratek, ve srovnání s průměrem předchozích 28 dnů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ich heute ausgegeben habe — mein Anteil an jedem Vorgang des Tages, Erstattungen abgezogen — gegenüber dem Durchschnitt der Tage davor über die letzten 28."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What I spent today — my share of every operation of the day, refunds taken off — against the average of the days before it over the last 28."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que gasté hoy — mi parte de cada operación del día, descontadas las devoluciones — frente a la media de los días anteriores de los últimos 28."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que j'ai dépensé aujourd'hui — ma part de chaque opération du jour, remboursements déduits — comparé à la moyenne des jours précédents sur les 28 derniers."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօրվա ծախսերս՝ օրվա յուրաքանչյուր գործարքում իմ բաժինը՝ հանած վերադարձները, համեմատած նախորդ 28 օրվա միջինի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mia quota delle operazioni di oggi, al netto dei rimborsi, rispetto alla media dei giorni precedenti negli ultimi 28 giorni."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღეს დახარჯული თანხა — ჩემი წილი დღის ყველა ოპერაციაში, დაბრუნებების გამოკლებით — წინა დღეების საშუალოსთან შედარებით ბოლო 28 დღეში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін жұмсағаным — күнің әр операциясындағы менің үлесім, қайтарулар алынып тасталған — соңғы 28 күннің алдындағы күндердің орташасымен салыстырғанда."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүн коротконум — күндүн ар бир операциясындагы менин үлүшүм, кайтарылган акча алынып салынат — мурунку 28 күндүн орточо көрсөткүчүнө салыштырмалуу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje dzisiejsze wydatki — mój udział w każdej operacji, pomniejszony o zwroty — w porównaniu ze średnią z poprzednich dni w ciągu ostatnich 28 dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que gastei hoje — minha parte de cada operação do dia, descontados os reembolsos — em comparação com a média dos dias anteriores nos últimos 28 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que gastei hoje — a minha parte de cada operação do dia, descontados os reembolsos — comparado com a média dos dias anteriores nos últimos 28 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько я потратил сегодня — моя доля каждой операции дня за вычетом возвратов — против среднего за предыдущие 28 дней."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти имрӯзаи ман — ҳиссаи ман аз ҳар амалиёти рӯз бо тарҳи баргардониҳо — дар муқоиса бо миёнаи рӯзҳои пешина дар 28 рӯзи охир."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü harcamam (günün her işleminden payıma düşen tutar, iadeler düşüldükten sonra) ile son 28 gündeki önceki günlerin ortalaması."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки я витратив сьогодні — моя частка кожної операції дня, мінус повернення — порівняно із середнім за попередні дні за останні 28."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun sarflagan pulim — kunlik amallardagi ulushim, qaytarilgan pullar ayirilgan holda — oxirgi 28 kundagi oldingi kunlar o‘rtachasi bilan solishtiriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我今天的支出：當日每筆交易中我的分攤金額，扣除退款後，與此前 28 天的日均支出比較。"
          }
        }
      }
    },
    "why.rule.spendingByPerson": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay xərclərim «на кого» üzrə; adlar sizin verdiyiniz kimidir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за месяц па полі «на кого» з зададзенымі вамі назвамі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje měsíční výdaje podle položky «на кого» s názvy, které jste zadali."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben des Monats nach „für wen“; die Namen sind die, die Sie vergeben haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of the month by «на кого»; the names are the ones you gave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto del mes por «para quién»; los nombres son los que usted puso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses du mois par « pour qui » ; les noms sont ceux que vous avez donnés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա իմ ծախսերը՝ ըստ «на кого»-ի։ Անունները ձեր նշածներն են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese per «на кого», con i nomi che hai assegnato."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი თვის ხარჯები «на кого»-ს მიხედვით; სახელები თქვენ მიერაა მითითებული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдағы менің шығысым «кім үшін» бойынша; аттары сіз берген атаулар."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлык чыгашаларым «на кого» боюнча; аталыштар сиз койгондой."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu według «на кого»; nazwy są takie, jakie podano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos do mês por «на кого», com os nomes que você definiu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas do mês por «на кого»; os nomes são os que definiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы месяца по «на кого»; названия — те, что вы дали."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти моҳонаи ман аз рӯи «на кого»; номҳо ҳамонҳоянд, ки шумо додаед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamalarım «на кого» alanına göre gösterilir; adlar sizin verdiğiniz adlardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за місяць за полем «для кого»; імена такі, як ви їх вказали."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylik xarajatlarim «на кого» bo‘yicha; ismlar siz kiritgandek ko‘rsatiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依「消費對象」顯示本月我的支出；名稱由你設定。"
          }
        }
      }
    },
    "why.rule.spendingCalendar": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu həftənin hər günü üzrə xərclərim, uzlaşdırma fərqləri istisna olmaqla; xərc son 90 günün adi günündən xeyli çox olduqda gün işarələnir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за кожны дзень гэтага тыдня без розніц зверкі. Адзначаны дні, калі выдаткі былі значна большыя за звычайныя за апошнія 90 дзён."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje výdaje za jednotlivé dny tohoto týdne bez rozdílů při odsouhlasení. Označený den má výrazně vyšší výdaje než běžný den za posledních 90 dnů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben jedes Tages dieser Woche, Abgleichdifferenzen ausgenommen; ein Tag ist markiert, wenn er viel mehr gekostet hat als der übliche Tag der letzten 90."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of each day of this week, reconciliation differences left out; a day is marked when it cost much more than the usual day of the last 90 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto de cada día de esta semana, sin las diferencias de conciliación; un día se marca cuando costó mucho más que el día habitual de los últimos 90."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses de chaque jour de cette semaine, sans les écarts de comptage ; un jour est marqué quand il a coûté bien plus que le jour habituel des 90 derniers jours."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս շաբաթվա իմ օրական ծախսերը՝ առանց համադրման տարբերությունների։ Օրը նշվում է, երբ ծախսը զգալիորեն գերազանցում է վերջին 90 օրվա սովորական օրվա ծախսը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese per ogni giorno della settimana, escluse le differenze di riconciliazione. Sono evidenziati i giorni con spese molto superiori alla norma degli ultimi 90 giorni."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი ხარჯები ამ კვირის თითოეულ დღეს, შეჯერების სხვაობების გარეშე; დღე მოინიშნება, თუ ხარჯი ბოლო 90 დღის ჩვეულებრივ დღეზე ბევრად მეტია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы аптаның әр күнідегі менің шығысым, санау айырмалары есепке алынбайды; күн соншама белгіленеді, егер ол соңғы 90 күннің әдеттегі күнінен едәуір көп тұрса."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушул жуманын ар бир күнүндөгү чыгашаларым, салыштыруу айырмалары кирбейт; акыркы 90 күндөгү кадимки күндөн кыйла көп сарпталган күн белгиленет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w poszczególnych dniach tego tygodnia, bez różnic z rozliczenia. Dzień jest oznaczony, gdy wydatki znacznie przekraczają typowy dzień z ostatnich 90 dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos em cada dia desta semana, sem diferenças de conciliação. Um dia é marcado quando os gastos superam muito os de um dia normal nos últimos 90 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas de cada dia desta semana, excluindo diferenças de reconciliação; um dia é assinalado quando o gasto é muito superior ao de um dia habitual dos últimos 90 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои траты каждого дня этой недели без разниц сверок; день отмечен, если он заметно дороже обычного дня за последние 90 дней."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ман дар ҳар рӯзи ин ҳафта, бе фарқиятҳои муқоисавӣ; рӯзе ишора мешавад, ки хароҷоташ аз рӯзи маъмулии 90 рӯзи охир хеле зиёд аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haftanın her günü için harcamalarım, mutabakat farkları hariç gösterilir. Son 90 gündeki sıradan bir günden çok daha fazla harcanan gün işaretlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за кожен день цього тижня, без різниць звірки; день позначається, коли витрачено значно більше, ніж у звичайний день за останні 90."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu haftaning har bir kunidagi xarajatlarim, solishtirish farqlarisiz. Oxirgi 90 kundagi odatiy kundan ancha ko‘p sarflangan kun belgilanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週每天我的支出，不含對帳差額；遠高於過去 90 天日常支出的日期會標示出來。"
          }
        }
      }
    },
    "why.rule.spendingForecast": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İndiyədək xərclənən məbləğ, bu ay ödənilməli qalan ödənişlər və qalan günlərin adi xərcləri."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ужо патрачанае, будучыя плацяжы за гэты месяц і звычайныя выдаткі за дні, што засталіся."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosavadní výdaje plus platby splatné do konce měsíce a obvyklé výdaje za zbývající dny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was bisher ausgegeben ist, plus die noch fälligen Zahlungen dieses Monats, plus was die verbleibenden Tage üblicherweise dazugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is spent so far, plus the payments still due this month, plus what the days left usually add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo gastado hasta ahora, más los pagos todavía pendientes de este mes, más lo que suelen sumar los días que quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est dépensé jusqu'ici, plus les paiements encore dus ce mois-ci, plus ce que les jours restants ajoutent habituellement."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչ այժմ ծախսված գումարը՝ գումարած այս ամիս վճարման ենթակա վճարումները և մնացած օրերի սովորական ծախսերը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese finora, più i pagamenti ancora dovuti questo mese e le spese abituali dei giorni rimanenti."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უკვე დახარჯული თანხა, ამ თვეში გადასახდელი თანხები და დარჩენილ დღეებში მოსალოდნელი ხარჯები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы уақытқа дейін жұмсалған, плюс осы айда әлі төленетін төлемдер, плюс қалған күндер әдетте қосатын сома."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Буга чейин сарпталган акча, ушул айда төлөнө турган төлөмдөр жана калган күндөрдөгү болжолдуу чыгашалар."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotychczasowe wydatki, płatności pozostałe w tym miesiącu oraz typowe wydatki na pozostałe dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que já foi gasto, mais os pagamentos pendentes deste mês e o que costuma ser gasto nos dias restantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que já foi gasto, mais os pagamentos ainda previstos para este mês e o gasto habitual dos dias restantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже потраченное, плюс ещё не оплаченные платежи месяца, плюс то, что обычно добавляют оставшиеся дни."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти то имрӯз, пардохтҳои боқимондаи моҳ ва хароҷоти маъмулии рӯзҳои боқимонда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye kadarki harcamalara bu ay ödenecek tutarlar ve kalan günlerde genellikle yapılan harcamalar eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що витрачено вже, плюс платежі, що ще належать цього місяця, плюс те, що зазвичай додають дні, які лишилися."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozirgacha sarflangan pul, bu oy to‘lanishi kerak bo‘lgan to‘lovlar va qolgan kunlardagi odatiy xarajatlar yig‘indisi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的支出，加上本月尚未支付的款項，以及剩餘天數的預計支出。"
          }
        }
      }
    },
    "why.rule.subscriptions": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv abunəliklərin hər biri günün məzənnəsi ilə aylıq dəyəri; ən bahalılar əvvəl göstərilir. Sonrakı tarixdən ləğv edilən abunəlik o tarixədək hesablanır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Месячны кошт дзейных падпісак па курсе дня, спачатку найдаражэйшыя. Скасаваная падпіска ўлічваецца да даты скасавання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční cena aktivních předplatných přepočtená aktuálním kurzem, od nejdražšího. Zrušené předplatné se započítává až do dne ukončení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die laufenden Abos im Monat kosten, jedes zum Kurs des Tages; das teuerste zuerst. Ein Abo, das ab einem späteren Tag gekündigt ist, zählt bis dahin weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the running subscriptions cost a month, each at the rate of the day; the priciest first. A subscription cancelled from a later day still counts until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cuestan al mes las suscripciones activas, cada una al tipo del día; primero las más caras. Una suscripción cancelada desde un día posterior cuenta hasta entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que coûtent les abonnements en cours par mois, chacun au cours du jour ; le plus cher d'abord. Un abonnement résilié à partir d'un jour ultérieur compte encore jusqu'à cette date."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գործող բաժանորդագրությունների ամսական արժեքը՝ յուրաքանչյուրը տվյալ օրվա փոխարժեքով։ Ամենաթանկը՝ սկզբում։ Ավելի ուշ չեղարկվող բաժանորդագրությունը հաշվվում է մինչև չեղարկման օրը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il costo mensile degli abbonamenti attivi, al tasso del giorno, dal più costoso. Un abbonamento annullato da una data futura viene conteggiato fino a quella data."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქტიური გამოწერების თვიური ღირებულება, თითოეული დღის კურსით; ყველაზე ძვირი პირველია. მოგვიანებით გაუქმებული გამოწერა მანამდე ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жұмыс істеп тұрған жазылымдардың айына кететіні, әрқайсысы сол күнгі бағам бойынша; ең қымбаты бірінші. Кейінгі күннен бастап тоқтатылған жазылым сол күнге дейін әлі саналады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Активдүү жазылуулардын ар бири күндүн курсу боюнча эсептелген айлык баасы; эң кымбаты биринчи. Кийинчерээк жокко чыгарыла турган жазылуу ошол күнгө чейин эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesięczny koszt aktywnych subskrypcji, każdej według kursu z danego dnia, od najdroższej. Anulowana subskrypcja jest uwzględniana do dnia jej zakończenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O custo mensal das assinaturas ativas, cada uma pela cotação do dia, da mais cara para a mais barata. Uma assinatura cancelada para uma data futura conta até essa data."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O custo mensal das assinaturas ativas, cada uma à taxa do dia, começando pela mais cara. Uma assinatura cancelada a partir de uma data futura conta até essa data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько в месяц стоят действующие подписки, каждая по курсу дня, дорогие первыми. Подписка, отменённая с будущего дня, считается до него."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Арзиши моҳонаи обунаҳои фаъол бо қурби рӯз; аввал гаронтаринҳо. Обунае, ки бекоркуниаш дертар амал мекунад, то он рӯз ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin aboneliklerin her biri günün kuruyla hesaplanan aylık maliyeti, en pahalıdan başlayarak gösterilir. İleri bir tarihte iptal edilecek abonelik o tarihe kadar dahil edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки коштують діючі підписки за місяць, кожна за курсом дня; найдорожчі — першими. Підписка, скасована з пізнішого дня, рахується до нього."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faol obunalarning har biri kunlik kurs bo‘yicha hisoblangan oylik narxi; eng qimmati birinchi. Keyinroq bekor qilinadigan obuna o‘sha kungacha hisoblanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有效訂閱的每月費用，按當日匯率換算，金額最高的排在前面。已排定日後取消的訂閱在取消前仍會計入。"
          }
        }
      }
    },
    "why.rule.topCategories": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay xərclərim əsas kateqoriyalar üzrə, ən böyüyü əvvəl; pay bütün xərclənən məbləğə nisbətəndir, uzlaşdırma fərqləri nəzərə alınmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за месяц па галоўных катэгорыях, спачатку найбольшыя. Доля лічыцца ад усіх выдаткаў без розніц зверкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje měsíční výdaje podle hlavních kategorií, od největší. Podíl se počítá ze všech výdajů bez rozdílů při odsouhlasení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben dieses Monats nach Hauptkategorie, die größte zuerst; ein Anteil bezieht sich auf alles ausgegebene Geld, Abgleichdifferenzen sind ausgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending this month by top-level category, the largest first; a share is of all the money spent, and reconciliation differences are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto de este mes por categoría principal, de mayor a menor; una parte es de todo el dinero gastado, y las diferencias de conciliación se dejan fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses de ce mois par catégorie de premier niveau, la plus grande d'abord ; une part se calcule sur tout l'argent dépensé, et les écarts de comptage sont exclus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվա իմ ծախսերը՝ ըստ հիմնական կատեգորիայի, ամենամեծը՝ սկզբում։ Բաժինը հաշվվում է ընդհանուր ծախսից՝ առանց համադրման տարբերությունների։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese per categoria principale, dalla più alta. Le percentuali si riferiscono al totale speso, escluse le differenze di riconciliazione."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი ხარჯები ამ თვეში მთავარი კატეგორიების მიხედვით, უდიდესი პირველია; წილი ყველა ხარჯიდან ითვლება, შეჯერების სხვაობების გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айдағы менің шығысым жоғарғы деңгейдегі санат бойынша, ең үлкені бірінші; үлес — барлық жұмсалған ақшадан, санау айырмалары есепке алынбайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушул айдагы чыгашаларым негизги категориялар боюнча, эң чоңу биринчи; үлүш жалпы чыгашадан эсептелет, салыштыруу айырмалары кирбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu według kategorii głównych, od największej. Udział odnosi się do wszystkich wydatków, bez różnic z rozliczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos neste mês por categoria principal, da maior para a menor. A participação considera todo o dinheiro gasto, sem diferenças de conciliação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas deste mês por categoria principal, começando pela maior; a percentagem é calculada sobre o total gasto e exclui diferenças de reconciliação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы этого месяца по категориям верхнего уровня, крупные первыми; доля — от всех потраченных денег, разницы сверок не входят."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти инмоҳаи ман аз рӯи категорияҳои асосӣ, аввал калонтаринҳо; ҳисса аз тамоми хароҷот ҳисоб мешавад, бе фарқиятҳои муқоисавӣ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamalarım ana kategoriye göre, en büyükten başlayarak gösterilir. Oran, toplam harcama içindeki paydır; mutabakat farkları dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за місяць за категоріями верхнього рівня, найбільші першими; частка — від усіх витрачених грошей, різниці звірки не враховуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oydagi xarajatlarim asosiy toifalar bo‘yicha, eng kattasi birinchi. Ulush jami xarajatlardan hisoblanadi; solishtirish farqlari kiritilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依主要類別顯示本月我的支出，金額最高的排在前面；占比以總支出計算，不含對帳差額。"
          }
        }
      }
    },
    "why.rule.topPlaces": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay xərclərim məkan üzrə; az xərc olan məkanlar və məkanı göstərilməyən xərclər bir sətirdədir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за месяц па месцах. Меншыя сумы і выдаткі без месца аб'яднаны ў адзін радок."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje měsíční výdaje podle místa. Méně častá místa a výdaje bez místa jsou na jednom řádku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben des Monats nach Ort; die kleineren Orte und die Ausgaben ohne Ort bilden eine Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of the month by place; the smaller places and spending with no place are one line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto del mes por lugar; los lugares más pequeños y el gasto sin lugar forman una sola línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses du mois par lieu ; les petits lieux et les dépenses sans lieu forment une seule ligne."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամսվա իմ ծախսերը՝ ըստ վայրի։ Փոքր ծախսերով վայրերը և առանց վայրի ծախսերը ներկայացված են մեկ տողով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese per luogo. I luoghi meno frequenti e le spese senza luogo sono raggruppati."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი თვის ხარჯები ადგილის მიხედვით; ნაკლები ხარჯის მქონე ადგილები და ადგილის გარეშე ხარჯები ერთ სტრიქონშია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Айдағы менің шығысым орын бойынша; кіші орындар мен орыны жоқ шығын бір жол болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Айлык чыгашаларым жайлар боюнча; чакан жайлар жана жайы көрсөтүлбөгөн чыгашалар бир сапта."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu według miejsca. Mniejsze miejsca i wydatki bez miejsca są ujęte w jednym wierszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos do mês por local. Os locais menores e os gastos sem local aparecem juntos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas do mês por local; os locais com menos despesas e as despesas sem local aparecem numa só linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы месяца по местам; мелкие места и траты без места — одной строкой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти моҳонаи ман аз рӯи ҷой; ҷойҳои хурд ва хароҷоти бе ҷой дар як сатр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki harcamalarım yere göre gösterilir; daha küçük yerler ve yer belirtilmeyen harcamalar tek satırda toplanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за місяць за місцями; менші місця і витрати без місця — один рядок."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylik xarajatlarim joylar bo‘yicha; kamroq xarajat qilingan joylar va joyi ko‘rsatilmagan xarajatlar bir qatorda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依地點顯示本月我的支出；支出較少的地點和未填地點的支出合併為一列。"
          }
        }
      }
    },
    "why.rule.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir həftə ərzində ödənilməli olan ödənişlər və növbəti borc ödənişləri; vaxtı keçənlər əvvəl göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нявыплачаныя плацяжы і наступныя выплаты па даўгах на тыдзень наперад, спачатку пратэрмінаваныя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuhrazené splatné platby a další splátky dluhů v následujícím týdnu, nejprve po splatnosti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbezahlte Fälligkeiten von Zahlungen und nächste Schuldenzahlungen bis eine Woche voraus, die überfälligen zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpaid due dates of payments and next debt payments up to a week ahead, the overdue ones first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vencimientos sin pagar de pagos y próximos pagos de deudas hasta una semana por delante, primero los atrasados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échéances non payées des paiements et les prochains remboursements de dettes, jusqu'à une semaine à l'avance ; les échues en premier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չվճարված վճարումների ժամկետները և պարտքերի հաջորդ վճարումները՝ մինչև մեկ շաբաթ առաջ։ Ժամկետանցները՝ սկզբում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scadenze non pagate e i prossimi pagamenti dei debiti entro una settimana, a partire da quelli scaduti."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაუხდელი გადასახადებისა და ვალის შემდეგი შენატანების ვადები ერთი კვირის განმავლობაში; ვადაგადაცილებული პირველია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апта алдын ала дейінгі төленбеген төлемдер мен берешектің келесі төлемдері, мерзімі өткендері алдымен."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир жума ичиндеги төлөнө элек төлөмдөр жана карыз боюнча кезектеги төлөмдөр; мөөнөтү өткөндөрү биринчи."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadchodzące w ciągu tygodnia niezapłacone płatności i kolejne spłaty długów, najpierw zaległe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vencimentos de pagamentos não pagos e próximas parcelas de dívidas nos próximos sete dias, com os atrasados primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamentos por liquidar e próximos pagamentos de dívidas até uma semana à frente, começando pelos atrasados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неоплаченные сроки платежей и ближайшие платежи по долгам на неделю вперёд, просроченные — первыми."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Муҳлатҳои пардохтнашуда ва пардохтҳои навбатии қарз то як ҳафтаи оянда, аввал муҳлатгузаштаҳо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hafta içindeki ödenmemiş ödeme vadeleri ve sıradaki borç ödemeleri, gecikenler önce gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неоплачені дати платежів і найближчі платежі за борги на тиждень уперед, спершу прострочені."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hafta ichidagi to‘lanmagan to‘lovlar va navbatdagi qarz to‘lovlari, muddati o‘tganlari birinchi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未付且將於一週內到期的款項及下次債務還款，逾期項目排在前面。"
          }
        }
      }
    },
    "why.rule.usualDay": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 90 gündə xərc olan günlərin medianı, iş və həftəsonu günləri ayrı hesablanmaqla; birdəfəlik alışlar nəzərə alınmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Медыяна дзённых выдаткаў за апошнія 90 дзён асобна для будняў і выходных, без аднаразовых пакупак."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Medián dnů s výdaji za posledních 90 dnů, zvlášť pro všední dny a víkendy, bez jednorázových nákupů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Median der Tage mit Ausgaben in den letzten 90 Tagen, getrennt für Werktage und Wochenendtage; einmalige Käufe ausgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The median of the days with spending in the last 90 days, told apart for weekdays and weekend days; one-off purchases left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mediana de los días con gasto de los últimos 90 días, separada para días laborables y fines de semana; las compras puntuales se dejan fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La médiane des jours avec dépenses des 90 derniers jours, distincte pour les jours de semaine et de week-end ; les achats ponctuels sont exclus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին 90 օրվա ծախսեր ունեցող օրերի մեդիանը՝ առանձին աշխատանքային և հանգստյան օրերի համար, առանց միանվագ գնումների։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mediana dei giorni con spese negli ultimi 90 giorni, distinta tra giorni feriali e fine settimana, esclusi gli acquisti occasionali."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო 90 დღეში ხარჯიანი დღეების მედიანა, სამუშაო და უქმე დღეებისთვის ცალ-ცალკე; ერთჯერადი შესყიდვების გარეშე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 90 күнде шығыс болған күндердің медианасы, жұмыс күндері мен демалыс күндері бөлек; бір реттік сатып алулар есепке алынбайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы 90 күндөгү чыгаша болгон күндөрдүн медианасы, иш жана дем алыш күндөрү өзүнчө эсептелет; бир жолку сатып алуулар кирбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediana wydatków w dniach z wydatkami w ciągu ostatnich 90 dni, osobno dla dni roboczych i weekendów, bez jednorazowych zakupów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mediana dos dias com gastos nos últimos 90 dias, separada entre dias úteis e fins de semana, sem compras pontuais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mediana dos dias com despesas nos últimos 90 dias, calculada separadamente para dias úteis e fins de semana, excluindo compras pontuais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиана дней с тратами за последние 90 дней отдельно для будней и выходных; разовые не входят."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Медианаи рӯзҳои хароҷотдор дар 90 рӯзи охир, ҷудогона барои рӯзҳои корӣ ва истироҳат; бе харидҳои якдафъаина."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 90 günde harcama yapılan günlerin medyanı, hafta içi ve hafta sonu günleri için ayrı hesaplanır; tek seferlik alışverişler dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіана днів із витратами за останні 90 днів, окремо для будніх і вихідних; разові покупки не враховуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi 90 kunda xarajat qilingan kunlarning medianasi, ish kunlari va dam olish kunlari uchun alohida. Bir martalik xaridlar kiritilmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 90 天有支出的日子之支出中位數，平日與週末分開計算，不含一次性購買。"
          }
        }
      }
    },
    "why.rule.weekOverWeek": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazar ertəsindən bu günə qədər xərclərim əvvəlki həftənin eyni günləri ilə müqayisədə."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі з панядзелка па сёння ў параўнанні з тымі ж днямі мінулага тыдня."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje výdaje od pondělí do dneška ve srovnání se stejnými dny minulého týdne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben von Montag bis heute gegenüber denselben Wochentagen davor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending from Monday through today against the same days of the week before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto desde el lunes hasta hoy frente a los mismos días de la semana anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses du lundi jusqu'à aujourd'hui, comparées aux mêmes jours de la semaine précédente."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Իմ ծախսերը երկուշաբթիից մինչև այսօր՝ համեմատած նախորդ շաբաթվա նույն օրերի հետ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese da lunedì a oggi rispetto agli stessi giorni della settimana precedente."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი ხარჯები ორშაბათიდან დღემდე, წინა კვირის იმავე დღეებთან შედარებით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дүйсенбіден бүгінге дейінгі менің шығысым, өткен аптаның дәл сол апта күндерімен салыстырғанда."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Дүйшөмбүдөн бүгүнкү күнгө чейинки чыгашаларым өткөн аптанын ошол эле күндөрүнө салыштырмалуу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki od poniedziałku do dziś w porównaniu z tymi samymi dniami poprzedniego tygodnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos de segunda-feira até hoje em comparação com os mesmos dias da semana passada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas de segunda-feira até hoje, comparadas com os mesmos dias da semana anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы с понедельника по сегодня против тех же дней прошлой недели."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ман аз душанбе то имрӯз дар муқоиса бо ҳамон рӯзҳои ҳафтаи пеш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazartesiden bugüne kadar olan harcamalarım ile geçen haftanın aynı günleri karşılaştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати з понеділка по сьогодні порівняно з тими самими днями тижня перед ним."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Dushanbadan bugungacha bo‘lgan xarajatlarim o‘tgan haftaning shu kunlari bilan solishtiriladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我從週一至今的支出，與上週相同天數的支出比較。"
          }
        }
      }
    },
    "why.rule.weekdaySpending": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son on iki həftənin xərclərim həftənin günləri üzrə toplanıb; orta məbləğ bir belə gün üçündür."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за апошнія дванаццаць тыдняў па днях тыдня; сярэдняе — за адзін такі дзень."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje výdaje za posledních dvanáct týdnů podle dnů v týdnu. Průměr připadá na jeden takový den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausgaben der letzten zwölf Wochen, nach Wochentag addiert; der Durchschnitt bezieht sich auf einen solchen Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spending of the last twelve weeks added up by day of the week; the average is of one such day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi gasto de las últimas doce semanas sumado por día de la semana; la media es de un día de esos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes dépenses des douze dernières semaines additionnées par jour de la semaine ; la moyenne porte sur un seul de ces jours."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին տասներկու շաբաթվա իմ ծախսերը՝ գումարված ըստ շաբաթվա օրվա։ Միջինը մեկ այդպիսի օրվա համար է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese delle ultime dodici settimane, sommate per giorno della settimana. La media si riferisce a un singolo giorno."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩემი ბოლო თორმეტი კვირის ხარჯები კვირის დღეების მიხედვით; საშუალო ერთი ასეთი დღის მაჩვენებელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы он екі аптадағы менің шығысым апта күні бойынша қосылған; орташа — сондай бір күнге."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Акыркы он эки аптадагы чыгашаларым аптанын күндөрү боюнча кошулат; орточо көрсөткүч бир күнгө эсептелет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki z ostatnich dwunastu tygodni zsumowane według dnia tygodnia. Średnia dotyczy jednego takiego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meus gastos das últimas 12 semanas somados por dia da semana. A média corresponde a um desses dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As minhas despesas das últimas doze semanas, somadas por dia da semana; a média corresponde a um desses dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мои расходы за последние двенадцать недель, сложенные по дням недели; среднее — за один такой день."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти ман дар 12 ҳафтаи охир аз рӯи рӯзҳои ҳафта; миёна барои як чунин рӯз аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son on iki haftadaki harcamalarım haftanın gününe göre toplanır; ortalama, o günlerden birine aittir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мої витрати за останні дванадцять тижнів, підсумовані за днем тижня; середнє — за один такий день."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi 12 haftadagi xarajatlarim hafta kunlari bo‘yicha jamlangan; o‘rtacha qiymat shunday bir kun uchun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去十二週我的支出按星期幾加總；平均值是該日的單日平均。"
          }
        }
      }
    },
    "why.rule.weekendPrice": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay ayarlarda həftəsonu kimi təyin edilən saatlarda xərclədiyim məbləğ, birdəfəlik alışlar da daxil olmaqla; yanında əvvəlki ay göstərilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мае выдаткі за гэты месяц у гадзіны, вызначаныя ў наладах як выходныя, уключна з аднаразовымі пакупкамі. Побач — сума за мінулы месяц."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje výdaje v tomto měsíci za hodiny označené v nastavení jako víkend, včetně jednorázových nákupů. Vedle je předchozí měsíc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ich diesen Monat in den Stunden ausgegeben habe, die die Einstellungen als Wochenende bezeichnen, eine Summe, die einmalige Käufe enthält; der Monat davor steht daneben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What I spent this month in the hours the settings call the weekend, a total that keeps one-off purchases; the month before is beside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que gasté este mes en las horas que los ajustes llaman fin de semana, un total que mantiene las compras puntuales; el mes anterior va al lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que j'ai dépensé ce mois-ci aux heures que les réglages appellent le week-end, un total qui garde les achats ponctuels ; le mois précédent est à côté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ամսվա իմ ծախսերը այն ժամերին, որոնք կարգավորումներում նշված են որպես հանգստյան օրեր՝ ներառյալ միանվագ գնումները։ Կողքին՝ նախորդ ամսվա գումարը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mie spese del mese nelle ore definite come fine settimana nelle impostazioni, inclusi gli acquisti occasionali, a confronto con il mese precedente."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თვეში პარამეტრებში უქმედ მითითებულ საათებში დახარჯული თანხა, ერთჯერადი შესყიდვების ჩათვლით; გვერდით წინა თვეა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы айда параметрлер демалыс деп атаған сағаттардағы менің шығысым, бір реттік сатып алуларды қоса алғандағы жиын; алдыңғы ай жанында тұр."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушул айда жөндөөлөрдө дем алыш деп белгиленген сааттарда коротконум, бир жолку сатып алуулар кошо эсептелет; жанында өткөн айдын көрсөткүчү."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje wydatki w tym miesiącu w godzinach określonych w ustawieniach jako weekend, łącznie z jednorazowymi zakupami. Obok widoczna jest kwota z poprzedniego miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que gastei neste mês nos horários definidos como fim de semana, incluindo compras pontuais. O mês anterior aparece ao lado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que gastei este mês nas horas definidas como fim de semana, incluindo compras pontuais, ao lado do valor do mês anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько я потратил в этом месяце в часы, которые настройки считают выходными, итогом вместе с разовыми; рядом — прошлый месяц."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хароҷоти инмоҳаи ман дар соатҳое, ки дар танзимот рӯзҳои истироҳат шуморида мешаванд, бо харидҳои якдафъаина; дар паҳлу моҳи пеш аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay ayarlarda hafta sonu olarak tanımlanan saatlerde yaptığım harcamaların toplamı, tek seferlik alışverişler dahil gösterilir; yanında önceki ay yer alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки я витратив цього місяця в години, які налаштування називають вихідними; підсумок, у якому враховуються разові покупки; поруч — попередній місяць."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oy sozlamalarda dam olish kunlari deb belgilangan soatlarda sarflagan pulim, bir martalik xaridlar bilan birga. Yonida o‘tgan oy ko‘rsatiladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本月設定中所定週末時段的支出總額，包含一次性購買；旁邊顯示上月金額。"
          }
        }
      }
    },
    "why.rule.worthALook": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaydaların son ayda tapdığı qeyri-adi hallar, xərclənmiş kimi görünən məqsəd vəsaitləri və arxivlənmiş hesablarda qalan pul."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Незвычайныя падзеі за апошні месяц, знойдзеныя правіламі, грошы мэт, якія, магчыма, патрачаны, і рэшткі на архіўных рахунках."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobvyklé události za poslední měsíc nalezené podle pravidel, zdánlivě utracené peníze z cílů a peníze na archivovaných účtech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungewöhnliche Dinge des letzten Monats, die die Regeln gefunden haben, Zielgeld, das ausgegeben scheint, und Geld auf archivierten Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unusual things of the last month the rules found, goal money that seems spent, and money left on archived accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosas fuera de lo normal del último mes que encontraron las reglas, dinero de objetivos que parece gastado, y dinero en cuentas archivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choses inhabituelles du dernier mois relevées par les règles, l'argent des objectifs qui semble dépensé, et l'argent resté sur des comptes archivés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանոններով հայտնաբերված վերջին ամսվա անսովոր դեպքերը, նպատակների գումարը, որը կարծես ծախսվել է, և արխիվացված հաշիվների մնացորդները։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le anomalie rilevate nell’ultimo mese, i fondi degli obiettivi che sembrano spesi e il denaro rimasto sui conti archiviati."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გასული თვის უჩვეულო მოვლენები, რომლებიც წესებმა გამოავლინა, სავარაუდოდ დახარჯული მიზნების თანხა და დაარქივებულ ანგარიშებზე დარჩენილი ფული."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер тапқан соңғы айдағы ерекше нәрселер, мақсат ақшасы жұмсалған сияқты және мұрағаттағы есеп-шоттарда қалған ақша."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эрежелер тапкан акыркы айдагы адаттан тыш жагдайлар, сарпталгандай көрүнгөн максат акчасы жана архивделген эсептердеги акча."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nietypowe sytuacje wykryte przez reguły w ostatnim miesiącu, środki na cele, które wyglądają na wydane, oraz środki pozostałe na zarchiwizowanych kontach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorrências incomuns do último mês encontradas pelas regras, dinheiro de metas que parece ter sido gasto e saldo em contas arquivadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Situações invulgares do último mês detetadas pelas regras, dinheiro de objetivos que parece ter sido gasto e dinheiro em contas arquivadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необычное за последний месяц, найденное правилами, деньги целей, которые похоже потрачены, и деньги на счетах в архиве."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳолатҳои ғайриодии моҳи охир, ки қоидаҳо ёфтанд, маблағи ҳадафҳо, ки гӯё харҷ шудааст ва бақияи ҳисобҳои бойгонӣ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuralların son bir ayda bulduğu olağandışı durumlar, harcanmış görünen hedef parası ve arşivlenmiş hesaplarda kalan para."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Незвичні речі за останній місяць, які знайшли правила, гроші цілей, що здаються витраченими, і гроші на архівних рахунках."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoidalar aniqlagan o‘tgan oydagi noodatiy holatlar, sarflanganga o‘xshagan maqsad pullari va arxivlangan hisoblardagi qoldiq."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則找出的上月異常項目、看似已花費的目標資金，以及封存帳戶中的餘額。"
          }
        }
      }
    },
    "why.savings.accounts": {
