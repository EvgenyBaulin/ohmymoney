    "calendar.lowData": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова даных для звычайнага дня: патрэбна 14 дзён з выдаткамі за апошнія 90 дзён"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Daten für einen üblichen Tag: Es braucht 14 Tage mit Ausgaben in den letzten 90"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too little data to tell a usual day: it takes 14 days with spending in the last 90"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocos datos para saber qué es un día habitual: hacen falta 14 días con gasto en los últimos 90"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de données pour définir un jour habituel : il faut 14 jours avec dépenses sur les 90 derniers"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati insufficienti per stimare un giorno tipo: servono 14 giorni con spese negli ultimi 90"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі күнді анықтау үшін деректер аз: соңғы 90 күннің ішінде шығыс бар 14 күн керек"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych, aby określić typowy dzień: potrzeba 14 dni z wydatkami w ciągu ostatnich 90 dni"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало данных, чтобы понять, какой день обычный: нужно 14 дней с тратами за 90 дней"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal bir günü belirlemek için yeterli veri yok: Son 90 günde harcama yapılan 14 gün gerekli"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замало даних, щоб визначити звичайний день: потрібно 14 днів із витратами за останні 90"
          }
        }
      }
    },
