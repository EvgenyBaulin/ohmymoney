            "value": "Առաջիկա յոթ օրում վճարումներ չկան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun pagamento nei prossimi sette giorni."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მომდევნო შვიდ დღეში გადასახადები არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Келесі жеті күнде төлемдер жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кийинки жети күндө төлөмдөр жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak płatności w ciągu najbliższych siedmiu dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum pagamento nos próximos sete dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem pagamentos nos próximos sete dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ближайшие семь дней платежей нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар ҳафт рӯзи оянда пардохт нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki yedi gün içinde ödeme yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежів на найближчі сім днів немає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyingi yetti kunda to‘lovlar yo‘q."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未來七天沒有應付款項。"
          }
        }
      }
    },
