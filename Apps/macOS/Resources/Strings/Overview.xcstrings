    "why.refreshing": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Значэнне на плітцы абнаўляецца і на момант можа адрознівацца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
