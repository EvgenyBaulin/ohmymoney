    "why.selfEmployed.rates": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dərəcələr: fiziki şəxslərdən 4 %, təşkilatlardan 6 %; güzəştlə 3 % və 4 % olur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стаўкі: 4 % ад фізічных асоб, 6 % ад арганізацый; з вылікам — 3 % і 4 %."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazby: 4 % od fyzických osob, 6 % od organizací. S odpočtem jsou 3 % a 4 %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze: 4 % von Privatpersonen, 6 % von Organisationen; der Abzug macht sie 3 % und 4 %."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates: 4 % from individuals, 6 % from organisations; the deduction makes them 3 % and 4 %."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasas: 4 % a particulares, 6 % a organizaciones; la deducción las deja en 3 % y 4 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux : 4 % auprès de particuliers, 6 % auprès d'organisations ; la déduction les ramène à 3 % et 4 %."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դրույքաչափեր՝ 4 % ֆիզիկական անձանցից, 6 % կազմակերպություններից։ Նվազեցմամբ՝ 3 % և 4 %։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aliquote: 4 % da privati, 6 % da organizzazioni; con la detrazione scendono al 3 % e al 4 %."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განაკვეთები: 4 % ფიზიკური პირებისგან, 6 % ორგანიზაციებისგან; შეღავათით — 3 % და 4 %."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөлшерлемелер: жеке тұлғалардан 4 %, ұйымдардан 6 %; шегерім оларды 3 % және 4 %-ға жеткізеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чендер: жеке жактардан 4 %, уюмдардан 6 %; чегерүү менен 3 % жана 4 % болот."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stawki: 4 % od osób fizycznych, 6 % od organizacji. Po odliczeniu wynoszą 3 % i 4 %."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alíquotas: 4 % de pessoas físicas, 6 % de organizações; com a dedução, são 3 % e 4 %."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxas: 4 % para particulares, 6 % para organizações; a dedução reduz as taxas para 3 % e 4 %."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки: 4 % с физлиц, 6 % с организаций; вычет делает их 3 % и 4 %."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Меъёрҳо: 4 % аз шахсони воқеӣ, 6 % аз ташкилотҳо; бо имтиёз — 3 % ва 4 %."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oranlar: Bireylerden % 4, kuruluşlardan % 6; indirimle sırasıyla % 3 ve % 4."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставки: 4 % від фізичних осіб, 6 % від організацій; вирахування робить їх 3 % і 4 %."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavkalar: jismoniy shaxslardan 4 %, tashkilotlardan 6 %; chegirma bilan 3 % va 4 %."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稅率：個人收入為 4 %，組織收入為 6 %；扣抵後分別為 3 % 和 4 %。"
          }
        }
      }
    },
