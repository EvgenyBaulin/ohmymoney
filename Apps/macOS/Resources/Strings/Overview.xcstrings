    "why.small.notSet": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайце ліміт дробнай пакупкі ў раздзеле Налады → Увод, і плітка іх падлічыць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie unter Einstellungen → Eingabe fest, was ein kleiner Kauf ist, dann zählt die Kachel sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say how small a small purchase is in Settings → Entry, and the tile counts them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique cuánto es una compra pequeña en Ajustes → Apuntes, y el mosaico las cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez ce qu'est un petit achat dans Réglages → Saisie, et la tuile les comptera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il limite per i piccoli acquisti in Impostazioni → Inserimento per visualizzarli nel riquadro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майда сатып алу қанша болатынын Параметрлер → Енгізу ішінде айтыңыз — сонда тақтайша оларды санайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw limit drobnego zakupu w Ustawienia → Wprowadzanie, aby kafelek mógł je zliczać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите в Настройки → Ввод, какая покупка мелкая, и плитка их посчитает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → Giriş bölümünde küçük alışveriş limitini belirleyin; kutucuk bunları saysın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть, що вважати дрібною покупкою, у «Налаштування → Введення», і плитка їх порахує."
          }
        }
      }
    },
