    "overview.balanceForecast.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcmaldakı hesabların heç biri hələ üzləşdirilməyib — proqnoz üçün məlumat yoxdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніводны рахунак у аглядзе яшчэ не звераны — няма даных для прагнозу"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není zkontrolovaný žádný účet v přehledu — není z čeho vytvořit odhad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto der Übersicht ist schon abgeglichen — es gibt nichts, woraus man prognostizieren könnte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account of the summary is reconciled yet — there is nothing to forecast from"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna cuenta del resumen está conciliada todavía — no hay de qué hacer previsión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte du récapitulatif n'est encore rapproché — il n'y a rien à prévoir"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամփոփման հաշիվներից ոչ մեկը դեռ չի համադրվել․ կանխատեսման տվյալներ չկան"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conto nel riepilogo è stato riconciliato: impossibile fare una previsione"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეჯამების არცერთი ანგარიში ჯერ არ შეჯერებულა — პროგნოზისთვის მონაცემები არ არის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қорытындыдағы бірде-бір есеп-шот әлі салыстырылмаған — болжау жасайтын ештеңе жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жыйнактагы эсептердин бири да текшериле элек — божомолдоо үчүн маалымат жок"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne konto w podsumowaniu nie zostało jeszcze uzgodnione — brak danych do prognozy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta do resumo foi conferida ainda — não há dados para a previsão"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há contas do resumo reconciliadas — não é possível criar uma previsão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один счёт сводки ещё не сверен — прогнозировать не от чего"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳеҷ ҳисоби ҷамъбаст ҳанӯз муқоиса нашудааст — барои пешгӯӣ маълумот нест"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özetteki hiçbir hesap henüz mutabık değil — tahmin yapılamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден рахунок зі складу підсумку ще не звірено — прогнозувати нема з чого"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharhdagi hech bir hisob hali solishtirilmagan — prognoz uchun ma’lumot yo‘q"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要中的帳戶皆尚未對帳，無法預測"
          }
        }
      }
    },
