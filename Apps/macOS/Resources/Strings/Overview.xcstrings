            "state": "translated",
            "value": "Почему так"
          }
        }
      }
    },
    "why.sheet.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still being calculated — the breakdown will appear when it is ready."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё считается — разбор появится, когда расчёт закончится."
          }
        }
      }
    },
    "why.top.refunded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (refunds outweighed)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (возвраты больше трат)"
          }
        }
      }
    },
    "why.top.refundedNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a share of the money spent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не входит в доли потраченного."
          }
        }
      }
    },
