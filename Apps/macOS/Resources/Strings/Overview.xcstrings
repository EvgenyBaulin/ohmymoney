    "why.currencies.withoutRate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üçün məzənnə yoxdur: bu məbləğ cəmə daxil edilməyib."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма курсу для %@: грошы ў гэтай валюце не ўлічаны ў агульнай суме."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybí kurz pro %@. Peníze v této měně nejsou zahrnuty do součtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kurs für %@: Ihr Geld bleibt aus der Summe weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate for %@: their money is left out of the total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin tipo para %@: su dinero se deja fuera del total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux pour %@ : leur argent est exclu du total."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ի փոխարժեքը չկա․ գումարը ներառված չէ ընդհանուր գումարում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tasso di cambio per %@: gli importi sono esclusi dal totale."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ის კურსი არ არის: შესაბამისი თანხა ჯამში არ შედის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ үшін бағам жоқ: олардың ақшасы жиыннан тыс қалды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ үчүн курс жок: бул акча жалпы суммага кошулган жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kursu dla %@. Środki w tej walucie pominięto w sumie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem taxa de câmbio para %@: os valores foram excluídos do total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem taxa de câmbio para %@: o respetivo dinheiro fica excluído do total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса для %@: их деньги не входят в итог."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои %@ қурб нест: маблағи онҳо ба ҷамъбаст дохил нашудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için kur yok. İlgili tutar toplama dahil edilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає курсу для %@: їхні гроші не входять до суми."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uchun kurs yo‘q: bu mablag‘ jami summaga kiritilmagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 缺少匯率，相關金額已從總計中排除。"
          }
        }
      }
    },
