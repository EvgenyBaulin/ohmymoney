    "overview.freeMoney.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesablardakı vəsaitdir, xərcləmə büdcəsi deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Грошы на рахунках, а не бюджэт на выдаткі"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze na účtech, ne rozpočet k utracení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Konten halten, kein Budget zum Ausgeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the accounts hold, not a budget to spend"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que tienen las cuentas, no un presupuesto para gastar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que contiennent les comptes, pas un budget à dépenser"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշիվների գումարը, ոչ թե ծախսելու բյուջեն"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo dei conti, non un budget da spendere"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა ანგარიშებზე და არა დასახარჯი ბიუჯეტი"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есеп-шоттарда не бар — жұмсауға арналған бюджет емес"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептердеги акча, сарптоо бюджети эмес"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środki na kontach, a nie budżet do wydania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo das contas, não um orçamento para gastar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo das contas, não um orçamento para gastar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток на счетах, не бюджет для трат"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи ҳисобҳо, на буҷет барои харҷ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplardaki tutar; harcama bütçesi değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що є на рахунках, а не бюджет на витрати"
