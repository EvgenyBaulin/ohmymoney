    "look.creditHistory": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit tarixçənizi sorğulayın — hər bürodan ildə iki dəfə pulsuzdur"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запытайце крэдытную гісторыю — бясплатна двойчы на год у кожным бюро"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádejte o svou úvěrovou historii — dvakrát ročně zdarma od každého registru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordern Sie Ihre Kreditauskunft an — bei jeder Auskunftei zweimal im Jahr kostenlos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request your credit history — free twice a year from every bureau"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pida su historial crediticio — gratis dos veces al año en cada oficina de crédito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez votre historique de crédit — gratuit deux fois par an auprès de chaque bureau"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահանջեք ձեր վարկային պատմությունը՝ յուրաքանչյուր բյուրոյից տարեկան երկու անգամ անվճար"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi la tua storia creditizia: è gratuita due volte l'anno presso ogni ufficio"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოითხოვეთ საკრედიტო ისტორია — თითოეული ბიუროდან წელიწადში ორჯერ უფასოდ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиттік тарихыңызды сұраңыз — әр бюрода жылына екі рет тегін"
          }
        },
        "ky": {
          "stringUnit": {
