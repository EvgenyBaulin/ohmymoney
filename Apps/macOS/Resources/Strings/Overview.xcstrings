    "why.small.notSet": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → Daxiletmə bölməsində kiçik alış limitini təyin edin, kart onları hesablasın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайце ліміт дробнай пакупкі ў раздзеле Налады → Увод, і плітка іх падлічыць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit drobného nákupu nastavíte v Nastavení → Zadávání. Dlaždice je pak spočítá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie unter Einstellungen → Eingabe fest, was ein kleiner Kauf ist, dann zählt die Kachel sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say how small a small purchase is in Settings → Entry, and the tile counts them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique cuánto es una compra pequeña en Ajustes → Apuntes, y el mosaico las cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez ce qu'est un petit achat dans Réglages → Saisie, et la tuile les comptera."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարգավորումներ → Մուտքագրում բաժնում նշեք փոքր գնման շեմը, և սալիկը կհաշվի դրանք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il limite per i piccoli acquisti in Impostazioni → Inserimento per visualizzarli nel riquadro."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიუთითეთ მცირე შესყიდვის ზღვარი: პარამეტრები → შეყვანა, და ფილა მათ დაითვლის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майда сатып алу қанша болатынын Параметрлер → Енгізу ішінде айтыңыз — сонда тақтайша оларды санайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жөндөөлөр → Киргизүү бөлүмүндө майда сатып алуунун чегин коюңуз, ошондо плитка аларды эсептейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw limit drobnego zakupu w Ustawienia → Wprowadzanie, aby kafelek mógł je zliczać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o limite de uma compra pequena em Ajustes → Entrada para que o cartão faça a contagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o limite de uma pequena compra em Definições → Registo para que o bloco as conte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите в Настройки → Ввод, какая покупка мелкая, и плитка их посчитает."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳадди хариди хурдро дар Танзимот → Воридкунӣ муайян кунед, то шуморида шавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → Giriş bölümünde küçük alışveriş limitini belirleyin; kutucuk bunları saysın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть, що вважати дрібною покупкою, у «Налаштування → Введення», і плитка їх порахує."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlamalar → Kiritish bo‘limida mayda xarid limitini belgilang, shunda karta ularni hisoblaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」→「輸入」中設定小額購買上限，即可在圖塊中查看統計。"
          }
        }
      }
    },
