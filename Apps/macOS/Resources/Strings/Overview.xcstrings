    "why.iOwe.noRate": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün məzənnə yoxdur: cəmə daxil deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма курсу на сёння: не ўлічана ў выніку"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnešní kurz není k dispozici: nezahrnuto v celku"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute kein Kurs: nicht in der Summe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rate today: not in the total"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin tipo hoy: no está en el total"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de taux aujourd'hui : hors du total"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այսօրվա փոխարժեքը չկա․ ընդհանուրում ներառված չէ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tasso disponibile oggi: escluso dal totale"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დღევანდელი კურსი არ არის: ჯამში არ შედის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгін бағам жоқ: жиында жоқ"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгүнкү курс жок: жыйынтыкка кирбейт"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dzisiejszego kursu: nie uwzględniono w sumie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cotação hoje: não incluído no total"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem taxa de câmbio hoje: excluído do total"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет курса на сегодня — не в итоге"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қурби имрӯза нест: ба маблағи умумӣ дохил нашудааст"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün kur yok: toplama dahil değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсу сьогодні немає: не входить до суми"
