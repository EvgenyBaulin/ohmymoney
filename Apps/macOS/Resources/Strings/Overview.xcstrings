    "why.sheet.waiting": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ hesablanır — təfərrüatlar hazır olduqda görünəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Яшчэ разлічваецца — падрабязнасці з'явяцца, калі ўсё будзе гатова."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výpočet stále probíhá. Rozpis se zobrazí po dokončení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird noch berechnet — die Aufschlüsselung erscheint, wenn sie fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still being calculated — the breakdown will appear when it is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía se está calculando — el desglose aparecerá cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore en calcul — le détail apparaîtra quand il sera prêt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ հաշվարկվում է․ մանրամասները կհայտնվեն պատրաստ լինելուն պես։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolo in corso. Il dettaglio apparirà quando sarà pronto."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ ითვლება — დეტალები გამოჩნდება, როცა მზად იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әлі есептелуде — бөлшектеу дайын болғанда көрінеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептелип жатат — даяр болгондо толук маалымат көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa obliczanie. Szczegóły pojawią się po jego zakończeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda calculando. Os detalhes aparecerão quando estiverem prontos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda a calcular — os detalhes aparecerão quando estiverem prontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё считается — разбор появится, когда расчёт закончится."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳоло ҳисоб мешавад — тафсилот пас аз омодагӣ пайдо мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplama sürüyor; döküm hazır olduğunda görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще рахується — розбивка з'явиться, коли буде готова."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali hisoblanmoqda — tayyor bo‘lgach, tafsilotlar ko‘rinadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在計算中，完成後會顯示明細。"
          }
        }
      }
    },
    "why.shrank.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ötən ayın eyni günləri ilə müqayisədə heç bir kateqoriya azalmayıb."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніводная катэгорыя не зменшылася ў параўнанні з тымі ж днямі мінулага месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná kategorie neklesla oproti stejným dnům minulého měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kategorie ist gegenüber denselben Tagen des letzten Monats geschrumpft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No category has shrunk against the same days of last month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna categoría ha bajado frente a los mismos días del mes pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune catégorie n'a diminué par rapport aux mêmes jours du mois dernier."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախորդ ամսվա նույն օրերի համեմատ ոչ մի կատեգորիա չի նվազել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna categoria è diminuita rispetto agli stessi giorni del mese scorso."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გასული თვის იმავე დღეებთან შედარებით არცერთი კატეგორიის ხარჯი არ შემცირებულა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен айдың дәл сол күндерімен салыстырғанда ешбір санат кемімеген."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткөн айдын ушул эле күндөрүнө салыштырмалуу азайган категориялар жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydatki w żadnej kategorii nie zmalały względem tych samych dni poprzedniego miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma categoria diminuiu em relação aos mesmos dias do mês passado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma categoria diminuiu face aos mesmos dias do mês passado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна категория не сократилась к тем же дням прошлого месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар муқоиса бо ҳамон рӯзҳои моҳи пеш ягон категория кам нашудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen ayın aynı günlerine göre azalan kategori yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодна категорія не зменшилася порівняно з тими самими днями минулого місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘tgan oyning shu kunlariga nisbatan hech bir toifa kamaymagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與上月同期相比，沒有類別的支出減少。"
          }
        }
      }
    },
