    "why.capital.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ heç nə hesablanmayıb: balans, aktiv və ya borc yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль не ўлічаны ні балансы, ні актывы, ні даўгі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není započítán žádný zůstatek, majetek ani dluh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts gezählt: kein Saldo, kein Vermögenswert, keine Schuld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is counted yet: no balance, asset or debt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se cuenta nada: ni saldo, ni bien, ni deuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore compté : ni solde, ni actif, ni dette."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ ոչինչ չի հաշվառվում՝ ոչ մնացորդ, ոչ ակտիվ, ոչ պարտք։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora conteggiato nulla: nessun saldo, bene o debito."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არაფერი აღირიცხება: არც ნაშთი, არც აქტივი და არც ვალი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге ештеңе есептелмеген: теңгерім, актив немесе берешек жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азырынча эч нерсе эсепке алынган жок: калдык, актив же карыз жок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uwzględniono jeszcze żadnego salda, składnika majątku ani długu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há saldos, bens ou dívidas contabilizados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há saldos, ativos ou dívidas contabilizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего не посчитано: нет ни остатков, ни имущества, ни долгов."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз ягон бақия, дороӣ ё қарз ба ҳисоб гирифта нашудааст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sayılan bakiye, varlık veya borç yok."
