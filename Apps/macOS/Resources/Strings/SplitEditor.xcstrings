    "entry.split.overshoot": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума частак перавышае агульную на %@ — захаваць можна толькі пры нулявой розніцы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anteile überschreiten den Gesamtbetrag um %@ — Speichern nur bei null möglich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parts are %@ over the total — it can be saved only at zero"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes superan el total en %@. Solo se puede guardar si es cero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parts dépassent le total de %@ — l’écart doit être nul pour enregistrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parti superano il totale di %@ — puoi salvare solo quando la differenza è zero"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлестер жалпы сомадан %@ артық — нөл болғанда ғана сақтауға болады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma części przekracza kwotę o %@ — zapis jest możliwy tylko przy zerze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes excedem o total em %@ — só é possível salvar quando a diferença for zero"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Части больше суммы на %@ — записать можно только при нуле"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçalar toplamı %@ aşıyor — yalnızca fark sıfırken kaydedilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частини перевищують загальну суму на %@ — зберегти можна, лише коли різниця дорівнює нулю"
          }
        }
      }
    },
    "entry.split.remainder": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Засталося %@ — захаваць можна толькі пры нулявой розніцы"
          }
        },
        "de": {
