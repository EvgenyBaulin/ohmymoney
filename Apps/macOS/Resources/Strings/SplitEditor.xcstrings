    "entry.payingFor.paysBack.segment.yes": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bəli, qaytaracaq"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, верне грошы"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano, vrátí mi to"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, zahlt zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, will pay back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, me lo devolverá"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, remboursement prévu"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այո, կվերադարձնի"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì, mi rimborserà"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい、返済予定"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დიახ, დააბრუნებს"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Иә, қайтарады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예, 돌려받을 거예요"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ооба, кайтарат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, betaalt terug"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, odda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, vai me pagar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, vai reembolsar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, вернёт"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бале, бармегардонад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet, geri ödeyecek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, поверне"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha, qaytaradi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会还"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會，之後會還"
          }
        }
      }
    },
    "entry.payingFor.paysBack.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şəxs sizə pulu qaytaracaq?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чалавек верне вам грошы?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí vám tato osoba peníze?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlt die Person dir das Geld zurück?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will the person pay you back?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te devolverá el dinero?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne vous remboursera-t-elle ?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կվերադարձնի՞ գումարը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona ti rimborserà?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手から返済されますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაგიბრუნებთ თანხას?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақшаны қайтара ма?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람에게 돈을 돌려받을 예정인가요?"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул адам акчаңызды кайтарабы?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaalt deze persoon je terug?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy ta osoba Ci odda?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa vai pagar você de volta?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa vai reembolsá-lo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернёт ли человек деньги?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин шахс пулро бармегардонад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişi size geri ödeyecek mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця людина поверне вам гроші?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu odam pulni qaytaradimi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会还款吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方會還款給你嗎？"
          }
        }
      }
    },
