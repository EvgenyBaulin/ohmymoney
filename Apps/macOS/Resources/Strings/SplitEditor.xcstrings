            "value": "%@ übrig — Speichern nur bei null möglich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ left — it can be saved only at zero"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan %@. Solo se puede guardar si es cero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %@ — l’écart doit être nul pour enregistrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano %@ — puoi salvare solo quando la differenza è zero"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ қалды — нөл болғанда ғана сақтауға болады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostało %@ — zapis jest możliwy tylko przy zerze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %@ — só é possível salvar quando a diferença for zero"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток %@ — записать можно только при нуле"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kaldı — yalnızca kalan sıfırken kaydedilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишилося %@ — зберегти можна, лише коли залишок дорівнює нулю"
          }
        }
      }
    },
