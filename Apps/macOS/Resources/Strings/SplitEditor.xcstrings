    "entry.split.giveRemainder": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аддаць рэшту «%@»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest „%@“ zuweisen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the remainder to “%@”"
          }
        },
        "es": {
          "stringUnit": {
