    "entry.payingFor.paysBack.segment.no": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не, гэта падарунак"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein, ein Geschenk"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, a gift"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No, es un regalo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non, c’est un cadeau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No, è un regalo"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоқ, сыйлық"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie, to prezent"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não, é um presente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет, дарю"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayır, hediye"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні, це подарунок"
          }
        }
      }
    },
    "entry.payingFor.paysBack.segment.yes": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, верне грошы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, zahlt zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, will pay back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, me lo devolverá"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, remboursement prévu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì, mi rimborserà"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Иә, қайтарады"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, odda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, vai me pagar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, вернёт"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet, geri ödeyecek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, поверне"
          }
        }
      }
    },
    "entry.payingFor.paysBack.title": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чалавек верне вам грошы?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlt die Person dir das Geld zurück?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will the person pay you back?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te devolverá el dinero?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne vous remboursera-t-elle ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa persona ti rimborserà?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ақшаны қайтара ма?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy ta osoba Ci odda?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa vai pagar você de volta?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернёт ли человек деньги?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişi size geri ödeyecek mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця людина поверне вам гроші?"
          }
        }
      }
    },
