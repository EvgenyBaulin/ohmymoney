    "tags.merge.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu teqin əməliyyatları digər teqə keçəcək, teq silinəcək və qaydalarda onun yerinə digər teq istifadə olunacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыі гэтага тэга пяройдуць да іншага, тэг знікне, а ў правілах замест яго будзе пазначаны іншы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace tohoto štítku se převedou na druhý štítek, tento štítek zmizí a pravidla budou používat druhý štítek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorgänge dieses Schlagworts wandern zum anderen, das Schlagwort verschwindet, und die Regeln, die es nannten, nennen das andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operations of this tag move to the other one, the tag disappears, and the rules that named it name the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones de esta etiqueta pasan a la otra, la etiqueta desaparece, y las reglas que la citaban citan la otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations de cette étiquette passent sur l'autre, l'étiquette disparaît, et les règles qui la nommaient nomment l'autre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս պիտակի գործարքները կանցնեն մյուսին, պիտակը կանհետանա, իսկ այն օգտագործող կանոնները կօգտագործեն մյուսը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni di questo tag passeranno all’altro, il tag verrà rimosso e le regole useranno l’altro tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグの取引は統合先に移され、このタグは削除されます。このタグを指定しているルールも統合先を指定するようになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ თეგის ოპერაციები გადავა მეორე თეგზე, ეს თეგი გაქრება და წესებიც მეორე თეგს გამოიყენებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл белгінің операциялары басқасына көшеді, белги жоғалады, ал оны атаған ережелер басқасын атайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул тегдеги операциялар башка тегге өтөт, тег өчөт, ал эми эрежелерде анын ордуна башка тег көрсөтүлөт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transacties van deze tag krijgen de andere tag, deze tag verdwijnt en regels die deze tag gebruiken, krijgen de andere tag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacje tego tagu zostaną przypisane do drugiego tagu, ten tag zniknie, a reguły będą używać drugiego tagu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações desta etiqueta passam para a outra, a etiqueta desaparece e as regras passam a usar a outra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações desta etiqueta passam para a outra, a etiqueta desaparece e as regras que a usam passam a usar a outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операции этого тега перейдут к другому, этот тег исчезнет, а правила, где он назван, будут называть другой."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Амалиётҳои ин барчасп ба барчаспи дигар мегузаранд, ин барчасп нест мешавад ва қоидаҳои марбут барчаспи дигарро истифода мебаранд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu etiketin işlemleri diğerine taşınır, etiket kaybolur ve onu kullanan kurallar diğer etiketi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операції цієї позначки переходять до іншої, сама позначка зникає, а правила, що її називали, називатимуть іншу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tegdagi amallar boshqa tegga o‘tadi, teg yo‘qoladi va qoidalardagi teg o‘rniga boshqasi qo‘yiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签的交易将移至另一个标签，此标签会被移除，使用此标签的规则将改用另一个标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此標籤的交易會移至另一個標籤，此標籤會消失，使用此標籤的規則也會改用另一個標籤。"
          }
        }
      }
    },
