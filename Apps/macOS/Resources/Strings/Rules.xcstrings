        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви редагували вручну після запису"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yozgandan keyin qo‘lda tahrirlangansiz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
