    "rules.hub.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правілы задаюць катэгорыю, тэгі і ацэнку пры ўводзе аперацыі. Перад ужываннем да мінулых аперацый можна паглядзець, што зменіцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln setzen Kategorie, Schlagwörter und Bewertung, wenn Sie einen Vorgang erfassen. Ihre Anwendung auf die Vergangenheit zeigt zuerst, was sich ändern würde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules set the category, tags and rating when you enter an operation. Applying them to the past shows what would change first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas fijan la categoría, las etiquetas y la valoración al introducir una operación. Aplicarlas al pasado muestra antes lo que cambiaría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles fixent la catégorie, les étiquettes et l'utilité lorsque vous saisissez une opération. Les appliquer au passé montre d'abord ce qui changerait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole impostano categoria, tag e valutazione quando inserisci un’operazione. Prima di applicarle al passato, puoi vedere cosa cambierebbe."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер операцияны енгізгенде санатты, белгілерді және бағаны белгілейді. Өткенге қолдану алдымен не өзгеретінін көрсетеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эрежелер операцияны киргизгенде категорияны, тегдерди жана бааны коёт. Өткөнгө колдонууда адегенде эмне өзгөрөрү көрсөтүлөт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły ustawiają kategorię, tagi i ocenę podczas dodawania operacji. Przed zastosowaniem ich do wcześniejszych operacji zobaczysz proponowane zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras definem a categoria, as etiquetas e a avaliação ao inserir uma operação. Ao aplicá-las ao passado, você vê primeiro o que mudaria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила ставят категорию, теги и оценку при вводе. Применение к прошлым сначала показывает, что изменится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurallar, işlem girerken kategoriyi, etiketleri ve puanı belirler. Geçmişe uygularken önce nelerin değişeceği gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила задають категорію, позначки й оцінку під час введення операції. Застосування до минулого спершу показує, що змінилося б."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoidalar amal kiritilganda turkum, teglar va bahoni belgilaydi. O‘tmishga qo‘llash avval nimalar o‘zgarishini ko‘rsatadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入交易時，規則會設定類別、標籤和評分。將規則套用至過往記錄前，會先顯示變更內容。"
          }
        }
      }
    },
