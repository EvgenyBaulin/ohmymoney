    "tags.collision.merge": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "#%@ teqini #%@ ilə birləşdir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аб'яднаць #%@ з #%@"
          }
        },
        "cs": {
          "stringUnit": {
