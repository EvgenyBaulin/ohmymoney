    "tagreport.overlap": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аперацыя з некалькімі тэгамі ўлічваецца пад кожным з іх, таму сума па тэгах — %@, больш за %@ ахопленых імі выдаткаў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorgang mit mehreren Schlagwörtern zählt unter jedem von ihnen, daher ergeben die Schlagwörter zusammen %@, mehr als die %@, die sie abdecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation with several tags counts under each of them, so the tags add up to %@, more than the %@ they cover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una operación con varias etiquetas cuenta en cada una de ellas, así que las etiquetas suman %1$@, más que los %2$@ que cubren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération à plusieurs étiquettes compte sous chacune d'elles ; les étiquettes s'additionnent donc à %@, plus que les %@ qu'elles couvrent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’operazione con più tag viene conteggiata per ciascuno di essi. Il totale dei tag è quindi %@, superiore a %@, il totale delle operazioni associate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірнеше белгісі бар операция әр белгіге жазылады, сондықтан белгілердің қосындысы %1$@ болады, ал олар қамтитыны — %2$@."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир нече теги бар операция ар биринде эсептелет. Ошондуктан тегдердин суммасы %@ болуп, алар камтыган %@ суммасынан ашат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja z kilkoma tagami jest liczona dla każdego z nich, więc suma tagów wynosi %@ i jest większa niż %@, które obejmują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma operação com várias etiquetas conta em cada uma delas. Por isso, as etiquetas somam %@, mais que os %@ que abrangem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция с несколькими тегами входит в каждый из них, поэтому по тегам выходит %@ — больше, чем %@ самих расходов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla etiketi olan işlem her etikette sayılır. Bu yüzden etiketlerin toplamı %@, kapsadıkları %@ tutarından fazladır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція з кількома позначками рахується під кожною з них, тож позначки разом дають %1$@, більше за %2$@, які вони покривають."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir nechta tegli amal har bir teg ostida hisoblanadi. Shu sababli teglar jami %@ ni tashkil qiladi, bu esa ular qamrab olgan %@ dan ko‘p."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有多個標籤的交易會計入每個標籤，因此標籤合計為 %@，高於涵蓋的 %@。"
          }
        }
      }
    },
