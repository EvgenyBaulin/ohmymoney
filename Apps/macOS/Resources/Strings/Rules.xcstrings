            "value": "⌘Z баарын бир кадамда артка кайтарып, акыркы түзөтүү даталарын калыбына келтирет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z cofnie wszystko w jednym kroku i przywróci poprzednie daty ostatniej edycji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z desfaz tudo de uma vez e restaura as datas da última edição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z вернёт всё одним шагом, вместе с прежними датами правки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z tümünü tek adımda geri alır ve son düzenleme tarihlerini eski hâline getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z скасовує все одним кроком, з датами останньої зміни як були."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z hammasini bir qadamda qaytaradi, oxirgi tahrir sanalari ham tiklanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
