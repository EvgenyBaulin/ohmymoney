    "exchange.export.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick the rules to put in the file. Rules that name an account, a card or a person start unticked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque las reglas que quiere incluir en el archivo. Las reglas que citan una cuenta, una tarjeta o una persona empiezan desmarcadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez les règles à mettre dans le fichier. Les règles qui nomment un compte, une carte ou une personne sont décochées au départ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте правила для файла. Правила, где назван счёт, карта или человек, по умолчанию не отмечены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте правила, які потраплять до файлу. Правила, що називають рахунок, картку чи людину, позначені спочатку знятими."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлға салатын ережелерді белгілеңіз. Есеп-шотты, картаны не адамды атайтын ережелер белгіленбеген күйде басталады."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreuzen Sie die Regeln an, die in die Datei sollen. Regeln, die ein Konto, eine Karte oder eine Person nennen, sind zunächst abgewählt."
          }
        }
      }
    },
