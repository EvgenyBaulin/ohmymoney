    "exchange.export.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayla əlavə ediləcək qaydaları seçin. Hesab, kart və ya şəxs göstərilən qaydalar əvvəlcədən seçilmir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазначце правілы для файла. Правілы, у якіх названы рахунак, картка або асоба, першапачаткова не пазначаны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaškrtněte pravidla, která chcete uložit. Pravidla obsahující účet, kartu nebo osobu jsou zpočátku nezaškrtnutá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreuzen Sie die Regeln an, die in die Datei sollen. Regeln, die ein Konto, eine Karte oder eine Person nennen, sind zunächst abgewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick the rules to put in the file. Rules that name an account, a card or a person start unticked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque las reglas que quiere incluir en el archivo. Las reglas que citan una cuenta, una tarjeta o una persona empiezan desmarcadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez les règles à mettre dans le fichier. Les règles qui nomment un compte, une carte ou une personne sont décochées au départ."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշեք ֆայլում ներառվող կանոնները։ Հաշիվ, քարտ կամ անձ նշող կանոնների նշումները սկզբում հանված են։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona le regole da includere nel file. Le regole che indicano un conto, una carta o una persona sono inizialmente deselezionate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに保存するルールを選択してください。口座、カード、または人を指定するルールは、初めは選択されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონიშნეთ ფაილში შესატანი წესები. წესები, რომლებშიც ანგარიში, ბარათი ან პირია მითითებული, თავდაპირველად მონიშნული არ არის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлға салатын ережелерді белгілеңіз. Есеп-шотты, картаны не адамды атайтын ережелер белгіленбеген күйде басталады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 담을 규칙을 선택하십시오. 계좌, 카드 또는 사람이 지정된 규칙은 기본적으로 선택되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлга кошула турган эрежелерди белгилеңиз. Эсеп, карта же адам көрсөтүлгөн эрежелер башында белгиленбейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer de regels voor het bestand. Regels die een rekening, kaart of persoon noemen, zijn standaard uitgevinkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz reguły, które chcesz zapisać w pliku. Reguły wskazujące konto, kartę lub osobę są domyślnie odznaczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione as regras para incluir no arquivo. As regras que mencionam uma conta, um cartão ou uma pessoa aparecem desmarcadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione as regras a incluir no ficheiro. As regras que mencionam uma conta, um cartão ou uma pessoa estão desmarcadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте правила для файла. Правила, где назван счёт, карта или человек, по умолчанию не отмечены."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоидаҳоро барои захира ба файл интихоб кунед. Қоидаҳое, ки ҳисоб, корт ё шахсро ном мебаранд, аввал интихоб нашудаанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaya eklenecek kuralları seçin. Hesap, kart veya kişi belirten kurallar başlangıçta seçili değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте правила, які потраплять до файлу. Правила, що називають рахунок, картку чи людину, позначені спочатку знятими."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylga kiritiladigan qoidalarni belgilang. Hisob, karta yoki shaxs ko‘rsatilgan qoidalar dastlab belgilanmagan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选要存入文件的规则。涉及账户、卡片或人员的规则默认不勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾選要放入檔案的規則。指定帳戶、卡片或人員的規則預設不勾選。"
          }
        }
      }
    },
