    "backfill.nothing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rules would change nothing: everything already looks as they want it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas no cambiarían nada: todo ya tiene el aspecto que quieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles ne changeraient rien : tout est déjà comme elles le veulent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила ничего не изменили бы: всё уже выглядит так, как они хотят."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила нічого не змінили б: усе вже виглядає так, як вони хочуть."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер ешнәрсені өзгертпейді: бәрі бұрынғыдан қалаған күйінде тұр."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln würden nichts ändern: Alles sieht schon so aus, wie sie es wollen."
          }
        }
      }
    },
