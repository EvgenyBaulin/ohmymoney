    "tags.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ён будзе выдалены з %lld частак аперацый. Аперацыі застануцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird von %lld Teilen von Vorgängen entfernt. Die Vorgänge bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is taken off %lld parts of operations. The operations stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quita de %lld partes de operaciones. Las operaciones se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est retirée de %lld parties d'opérations. Les opérations restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tag verrà rimosso da %lld parti di operazioni. Le operazioni resteranno."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол операциялардың %lld бөлігінен алынады. Операциялар қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег операциялардын %lld бөлүгүнөн алынып салынат. Операциялар сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag zostanie usunięty z %lld części operacji. Operacje pozostaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela será removida de %lld partes de operações. As operações serão mantidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет снят с частей операций: %lld. Сами операции останутся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket, işlemlerin %lld bölümünden kaldırılır. İşlemler korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її знімають з %lld частин операцій. Операції лишаються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Teg amallarning %lld ta qismidan olib tashlanadi. Amallar saqlanadi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此標籤會從 %lld 個交易項目中移除，交易會保留。"
          }
        }
      }
    },
    "tags.delete.rules": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзеянне з гэтым тэгам будзе выдалена з правіл (%lld); правілы без дзеянняў будуць выдалены (%lld)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln, die es nannten, verlieren diese Aktion (%lld); Regeln, die dann nichts mehr tun, werden gelöscht (%lld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules that named it lose that action (%lld); rules left with nothing to do are deleted (%lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas que la citaban pierden esa acción (%1$lld); las reglas que se quedan sin nada que hacer se eliminan (%2$lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles qui la nommaient perdent cette action (%lld) ; les règles qui ne font plus rien sont supprimées (%lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole che usano il tag perderanno questa azione (%lld); quelle senza più azioni verranno eliminate (%lld)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оны атаған ережелер сол әрекетті жоғалтады (%lld); істейтін ісі қалмаған ережелер жойылады (%lld)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул тег көрсөтүлгөн эрежелер ал аракетин жоготот (%lld); аракети калбаган эрежелер өчүрүлөт (%lld)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły używające tego tagu utracą to działanie (%lld). Reguły bez działań zostaną usunięte (%lld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras que a usam perderão essa ação (%lld); as regras sem nenhuma ação serão apagadas (%lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила, где он назван, потеряют это действие (%lld); правила, которым нечего делать, удалятся (%lld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu etiketi kullanan kurallardan ilgili eylem kaldırılır (%lld); eylemsiz kalan kurallar silinir (%lld)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила, що її називали, втрачають цю дію (%1$lld); правила, яким не лишилося що робити, видаляються (%2$lld)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu teg ko‘rsatilgan qoidalardan tegishli harakat olib tashlanadi (%lld); harakatsiz qolgan qoidalar o‘chiriladi (%lld)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此標籤的規則會移除該動作（%lld）；沒有剩餘動作的規則會被刪除（%lld）。"
          }
        }
      }
    },
