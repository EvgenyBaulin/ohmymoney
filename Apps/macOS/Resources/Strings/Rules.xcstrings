    "exchange.import.failed": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўсё ўдалося дадаць. Дададзенае застанецца; адкрыйце файл зноў, каб дадаць астатняе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alles konnte ergänzt werden. Was ergänzt wurde, bleibt; öffnen Sie die Datei erneut, um den Rest zu ergänzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not everything could be added. What was added stays; open the file again to add the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo añadir todo. Lo que se añadió se queda; vuelva a abrir el archivo para añadir el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout n'a pas pu être ajouté. Ce qui a été ajouté reste ; rouvrez le fichier pour ajouter le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aggiungere tutto. Gli elementi aggiunti restano; apri di nuovo il file per aggiungere il resto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бәрі қосылмады. Қосылғаны қалады; қалғанын қосу үшін файлды қайта ашыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Баарын кошуу мүмкүн болгон жок. Кошулгандары сакталат; калганын кошуу үчүн файлды кайра ачыңыз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dodać wszystkiego. Dodane elementy pozostaną; otwórz plik ponownie, aby dodać resztę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível adicionar tudo. O que foi adicionado será mantido; abra o arquivo novamente para adicionar o restante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить удалось не всё. Что добавлено, то осталось; откройте файл ещё раз, чтобы добавить остальное."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey eklenemedi. Eklenenler kalır; kalanları eklemek için dosyayı yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не все вдалося додати. Додане лишається; відкрийте файл знову, щоб додати решту."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hammasini qo‘shib bo‘lmadi. Qo‘shilganlar saqlanadi; qolganini qo‘shish uchun faylni qayta oching."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法加入所有內容。已加入的內容會保留；請重新開啟檔案以加入其餘內容。"
          }
        }
      }
    },
