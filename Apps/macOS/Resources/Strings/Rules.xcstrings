        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt dit na het invoeren handmatig gewijzigd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniono ręcznie po zapisaniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você editou manualmente após registrar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Editou-a manualmente depois de a registar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы правили её руками после записи"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шумо онро пас аз сабт дастӣ таҳрир кардед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettikten sonra elle düzenlediniz"
