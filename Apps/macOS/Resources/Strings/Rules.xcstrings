    "rules.editor.thenHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlagwörter addieren sich. Von zwei Regeln, die eine Kategorie setzen, gewinnt die obere in der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags add up. Of two rules that set a category, the upper one in the list wins."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгілер қосылады. Санатты белгілейтін екі ереженің тізімде жоғарғысы жеңеді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теги складываются. Из двух правил, которые ставят категорию, побеждает верхнее в списке."
          }
        }
      }
    },
