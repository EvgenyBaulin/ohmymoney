        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить удалось не всё. Что добавлено, то осталось; откройте файл ещё раз, чтобы добавить остальное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не все вдалося додати. Додане лишається; відкрийте файл знову, щоб додати решту."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бәрі қосылмады. Қосылғаны қалады; қалғанын қосу үшін файлды қайта ашыңыз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alles konnte ergänzt werden. Was ergänzt wurde, bleibt; öffnen Sie die Datei erneut, um den Rest zu ergänzen."
          }
        }
      }
    },
