          "stringUnit": {
            "state": "translated",
            "value": "파일에 포함된 다른 기능의 데이터는 해당 기능을 위해 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлда башка функциялар үчүн да бөлүктөр бар; алар ошол функциялар үчүн сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand bevat ook onderdelen voor andere functies; die blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zawiera też dane innych funkcji; zostaną one zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo também contém dados de outros recursos, que serão preservados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro também contém dados para outras funcionalidades, que serão conservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле есть и части для других возможностей; они сохраняются для них."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл ҳамчунин маълумот барои дигар функсияҳо дорад; он барои онҳо нигоҳ дошта мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya, diğer özelliklere ait bölümler de içeriyor; bunlar ilgili özellikler için saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл також містить частини для інших функцій; вони збережуться для них."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylda boshqa funksiyalar uchun ham ma’lumotlar bor; ular saqlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件还包含其他功能的数据，已为这些功能保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案也包含其他功能的資料，這些資料會保留供其使用。"
          }
        }
      }
    },
