    "rules.editor.ifHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün şərtlər eyni anda ödənməlidir («və»). «Və ya» üçün iki qayda yaradın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе ўмовы павінны выконвацца адначасова («і»). Для «або» стварыце два правілы."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny podmínky musí platit současně («a»). Pro «nebo» vytvořte dvě pravidla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Bedingungen müssen gleichzeitig zutreffen („und“). Für „oder“ legen Sie zwei Regeln an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All conditions must hold at once («and»). For «or», make two rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las condiciones deben cumplirse a la vez («y»). Para «o», cree dos reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les conditions doivent être vraies à la fois (« et »). Pour « ou », faites deux règles."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բոլոր պայմանները պետք է կատարվեն միաժամանակ («և»)։ «Կամ»-ի համար ստեղծեք երկու կանոն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le condizioni devono essere soddisfatte («e»). Per usare «o», crea due regole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての条件を同時に満たす必要があります（«and»）。«or»の場合は、ルールを2つ作成してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველა პირობა ერთდროულად უნდა სრულდებოდეს («და»). «ან»-ისთვის შექმენით ორი წესი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық шарт бірден орындалуы керек («және»). «Немесе» үшін екі ереже жасаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 조건을 동시에 충족해야 합니다(«그리고»). «또는»을 사용하려면 규칙을 두 개 만드세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бардык шарттар бир убакта аткарылышы керек («жана»). «Же» үчүн эки эреже түзүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan alle voorwaarden moet tegelijk worden voldaan («en»). Maak voor «of» twee regels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie warunki muszą być spełnione jednocześnie («i»). Aby użyć «lub», utwórz dwie reguły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as condições devem ser atendidas ao mesmo tempo («e»). Para «ou», crie duas regras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as condições têm de ser cumpridas («e»). Para «ou», crie duas regras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все условия должны сойтись сразу («и»). Для «или» заведите два правила."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳамаи шартҳо бояд ҳамзамон иҷро шаванд («ва»). Барои «ё» ду қоида созед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm koşullar aynı anda sağlanmalı («ve»). «Veya» için iki kural oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі умови мають виконуватися разом («і»). Для «або» зробіть два правила."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha shartlar bir vaqtda bajarilishi kerak («va»). «Yoki» uchun ikkita qoida yarating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有条件必须同时满足（«且»）。如需 «或»，请创建两条规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有條件都必須符合（«且»）。若要使用 «或»，請建立兩個規則。"
          }
        }
      }
    },
    "rules.editor.name": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
