    "backfill.conflicts": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaydalar %lld dəfə ziddiyyət təşkil etdi; siyahıda yuxarıdakı qayda tətbiq edildi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правілы супярэчылі адно аднаму %lld разоў; перамагло правіла вышэй у спісе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidla se %lldkrát neshodla; platilo pravidlo výše v seznamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln widersprachen sich %lld Mal; die obere Regel der Liste hat gewonnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules disagreed %lld times; the upper rule of the list won."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas discreparon %lld veces; gana la regla de arriba de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles se sont contredites %lld fois ; c'est la règle la plus haute de la liste qui l'a emporté."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանոնները %lld անգամ հակասել են․ կիրառվել է ցանկի վերին կանոնը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole erano in conflitto %lld volte; ha prevalso la regola più in alto nell’elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールが%lld回競合しました。リストの上にあるルールが優先されました。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წესები %lld-ჯერ არ დაემთხვა; უპირატესობა სიის ზედა წესს მიენიჭა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер %lld рет келіспеді; тізімде жоғарғы ереже жеңді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙이 %lld번 충돌하여 목록에서 위에 있는 규칙이 적용되었습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эрежелер %lld жолу дал келген жок; тизмедеги жогорку эреже колдонулду."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regels spraken elkaar %lld keer tegen; de bovenste regel kreeg voorrang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły były sprzeczne %lld razy; zastosowano regułę wyżej na liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras divergiram %lld vezes; prevaleceu a regra mais acima na lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras entraram em conflito %lld vezes; prevaleceu a regra mais acima na lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила спорили %lld раз; победило верхнее в списке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоидаҳо %lld бор мухолиф шуданд; қоидаи болотари рӯйхат татбиқ шуд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurallar %lld kez çelişti; listede üstteki kural uygulandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила суперечили одне одному %lld разів; перемогло правило вище в списку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoidalar %lld marta zid keldi; ro‘yxatdagi yuqori qoida qo‘llandi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则有 %lld 次冲突，已采用列表中靠上的规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則有 %lld 次不一致；以列表中較上方的規則為準。"
          }
        }
      }
    },
    "backfill.editedByHand": {
