    "rules.problem.mixedKinds": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыі даходаў і выдаткаў не могуць быць у адной аперацыі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einnahmekategorie und eine Ausgabenkategorie treffen sich nie in einem Vorgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An income category and an expense one never meet in one operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoría de ingreso y una de gasto nunca coinciden en una misma operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une catégorie de revenus et une de dépenses ne se rencontrent jamais dans une même opération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoria di entrata e una di spesa non possono appartenere alla stessa operazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Табыс санаты мен шығыс санаты бір операцияда кездеспейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир операцияда киреше жана чыгаша категориялары чогуу болбойт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna operacja nie może mieć kategorii przychodu i wydatku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma operação não pode ter categorias de receita e de despesa ao mesmo tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория дохода и категория расхода не встречаются в одной операции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir işlemde hem gelir hem de gider kategorisi olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорія доходу й категорія витрат ніколи не зустрічаються в одній операції."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir amalda daromad va xarajat turkumlari birga bo‘la olmaydi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一筆交易不能同時使用收入和支出類別。"
          }
        }
      }
    },
