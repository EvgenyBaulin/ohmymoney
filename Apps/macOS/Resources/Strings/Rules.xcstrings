  "strings": {
    "backfill.apply": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anwenden (%lld)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply (%lld)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолдану (%lld)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить (%lld)"
          }
        }
      }
    },
    "backfill.conflicts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln widersprachen sich %lld Mal; die obere Regel der Liste hat gewonnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules disagreed %lld times; the upper rule of the list won."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер %lld рет келіспеді; тізімде жоғарғы ереже жеңді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила спорили %lld раз; победило верхнее в списке."
          }
        }
      }
    },
    "backfill.editedByHand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben es nach dem Schreiben von Hand bearbeitet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You edited it by hand after writing it"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазғаннан кейін оны қолмен өңдедіңіз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы правили её руками после записи"
          }
        }
      }
    },
    "backfill.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf konnte nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The history could not be read."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарих оқылмады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать историю."
          }
        }
      }
    },
    "backfill.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das würden die Regeln an den bereits geschriebenen Vorgängen ändern. Nichts wird geschrieben, bis Sie „Anwenden“ drücken; ein ⌘Z nimmt alles zurück. Vorgänge, die Sie von Hand bearbeitet haben, sind abgewählt: Ihre Entscheidung wiegt mehr als eine Regel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is what the rules would change in the operations already written. Nothing is written until «Apply»; one ⌘Z takes everything back. Operations you edited by hand are unticked: your decision is worth more than a rule."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер бұрын жазылған операцияларда не өзгертетінін осы. «Қолдану» басылмайынша ештеңе жазылмайды; бір ⌘Z бәрін қайтарады. Қолмен өңделген операциялар белгіленбейді: сіздің шешіміңіз ереженің күшінен жоғары."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот что правила изменили бы в уже записанных операциях. Пока вы не нажмёте «Применить», ничего не пишется; один ⌘Z вернёт всё. Операции, которые вы правили руками, не отмечены: ваше решение ценнее правила."
          }
        }
      }
    },
    "backfill.hint.touch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das würden die Regeln an den bereits geschriebenen Vorgängen ändern. Nichts wird geschrieben, bis Sie „Anwenden“ drücken; ein „Rückgängig“ nimmt alles zurück. Vorgänge, die Sie von Hand bearbeitet haben, sind abgewählt: Ihre Entscheidung wiegt mehr als eine Regel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is what the rules would change in the operations already written. Nothing is written until «Apply»; one “Undo” takes everything back. Operations you edited by hand are unticked: your decision is worth more than a rule."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер бұрын жазылған операцияларда не өзгертетінін осы. «Қолдану» басылмайынша ештеңе жазылмайды; бір «Болдырмау» бәрін қайтарады. Қолмен өңделген операциялар белгіленбейді: сіздің шешіміңіз ереженің күшінен жоғары."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот что правила изменили бы в уже записанных операциях. Пока вы не нажмёте «Применить», ничего не пишется; один «Отменить» вернёт всё. Операции, которые вы правили руками, не отмечены: ваше решение ценнее правила."
          }
        }
      }
    },
