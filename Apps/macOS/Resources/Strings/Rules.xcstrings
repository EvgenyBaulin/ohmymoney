    },
    "tags.collision.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two tags cannot share a name. They can be merged into one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два тега не могут называться одинаково. Их можно объединить в один."
          }
        }
      }
    },
    "tags.collision.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name is another tag's"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое название уже есть у другого тега"
          }
        }
