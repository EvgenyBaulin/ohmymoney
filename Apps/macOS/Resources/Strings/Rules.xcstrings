    "rules.trial.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarixçədə bu qaydaya uyğun əməliyyat yoxdur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніводная аперацыя ў гісторыі не адпавядае гэтаму правілу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomuto pravidlu neodpovídá žádná operace v historii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Vorgang des Verlaufs passt zu dieser Regel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No operation of the history matches this rule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna operación del historial encaja con esta regla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune opération de l'historique ne correspond à cette règle."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատմության գործարքներից ոչ մեկը չի համապատասխանում այս կանոնին։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna operazione nella cronologia corrisponde a questa regola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルールに一致する取引履歴はありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ისტორიაში ამ წესს არცერთი ოპერაცია არ შეესაბამება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарихтағы ешбір операция бұл ережеге сәйкес келмейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарыхтагы бир да операция бул эрежеге дал келбейт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkele transactie in de geschiedenis voldoet aan deze regel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna operacja w historii nie pasuje do tej reguły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma operação do histórico corresponde a esta regra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma operação do histórico corresponde a esta regra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна операция истории не подходит под это правило."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ягон амалиёт дар таърих ба ин қоида мувофиқ нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişte bu kuralla eşleşen işlem yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодна операція з історії не підходить під це правило."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarixdagi hech bir amal bu qoidaga mos kelmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录中没有符合此规则的交易。"
