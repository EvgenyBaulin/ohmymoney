    "rules.trial.waiting": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaydanın neçə əməliyyata təsir edəcəyini görmək üçün şərt və əməl əlavə edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадайце ўмову і дзеянне, каб убачыць, колькі аперацый закране правіла."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte podmínku a akci a zjistěte, kolika operací by se pravidlo dotklo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie eine Bedingung und eine Aktion hinzu, um zu sehen, wie viele Vorgänge die Regel berühren würde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a condition and an action to see how many operations the rule would touch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada una condición y una acción para ver cuántas operaciones tocaría la regla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une condition et une action pour voir combien d'opérations la règle toucherait."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացրեք պայման և գործողություն՝ տեսնելու համար, թե քանի գործարքի վրա կազդի կանոնը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una condizione e un’azione per vedere quante operazioni saranno interessate dalla regola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件とアクションを追加すると、ルールの対象となる取引の件数が表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაამატეთ პირობა და მოქმედება, რომ ნახოთ, რამდენ ოპერაციას შეეხება წესი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ереже нешеше операцияға әсер ететінін көру үшін шарт пен әрекет қосыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эреже канча операцияга таасир этерин көрүү үчүн шарт менен аракет кошуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een voorwaarde en een actie toe om te zien hoeveel transacties de regel raakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj warunek i działanie, aby zobaczyć, ilu operacji dotyczyłaby reguła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma condição e uma ação para ver quantas operações a regra afetaria."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma condição e uma ação para ver quantas operações seriam afetadas pela regra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте условие и действие, чтобы увидеть, сколько операций затронет правило."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шарт ва амалеро илова кунед, то шумораи амалиётҳои дахлдорро бинед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuralın kaç işlemi etkileyeceğini görmek için bir koşul ve eylem ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте умову і дію, щоб побачити, скільки операцій правило зачепить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoida nechta amalga ta’sir qilishini ko‘rish uchun shart va harakat qo‘shing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加条件和操作，查看此规则会影响多少笔交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入條件和動作，查看此規則會影響多少筆交易。"
          }
        }
      }
    },
