    },
    "tags.delete.rules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules that named it lose that action (%lld); rules left with nothing to do are deleted (%lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
