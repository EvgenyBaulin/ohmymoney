    "backfill.nothing": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правілы нічога не зменяць: усё ўжо адпавядае ім."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln würden nichts ändern: Alles sieht schon so aus, wie sie es wollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rules would change nothing: everything already looks as they want it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas no cambiarían nada: todo ya tiene el aspecto que quieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles ne changeraient rien : tout est déjà comme elles le veulent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole non cambierebbero nulla: è già tutto come previsto."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер ешнәрсені өзгертпейді: бәрі бұрынғыдан қалаған күйінде тұр."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эрежелер эч нерсени өзгөртпөйт: баары мурунтан эле аларга ылайык."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły niczego nie zmienią: wszystko jest już zgodne z regułami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras não alterariam nada: tudo já está conforme definido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила ничего не изменили бы: всё уже выглядит так, как они хотят."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurallar hiçbir şeyi değiştirmeyecek: her şey zaten kurallara uygun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила нічого не змінили б: усе вже виглядає так, як вони хочуть."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoidalar hech narsani o‘zgartirmaydi: hammasi allaqachon ularga mos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則不會更改任何內容：所有項目都已符合規則。"
          }
        }
      }
    },
