    "exchange.import.sections": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл таксама змяшчае даныя для іншых функцый; яны захоўваюцца для іх."
          }
        },
        "de": {
