    "backfill.notLanded": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaddaşda saxlanma hələ davam edir. Az sonra görünəcək; ⌘Z ilə geri qaytarılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запіс яшчэ выконваецца. Ён хутка з'явіцца; ⌘Z адменіць яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zápis se ještě dokončuje. Za chvíli se zobrazí; pomocí ⌘Z ho vrátíte zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schreibung ist noch unterwegs. Sie erscheint gleich; ⌘Z nimmt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The write is still on its way. It will show in a moment; ⌘Z takes it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura todavía está en camino. Aparecerá en un momento; ⌘Z la deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écriture est encore en route. Elle apparaîtra dans un instant ; ⌘Z la reprend."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրանցումը դեռ ընթացքի մեջ է։ Այն շուտով կհայտնվի․ ⌘Z-ը հետ կվերադարձնի այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio in corso. Le modifiche appariranno tra poco; ⌘Z le annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存中です。まもなく反映されます。⌘Zで元に戻せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცვლილება ჯერ მუშავდება. ის მალე გამოჩნდება; ⌘Z მას გააუქმებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазу әлі жолда. Ол бір сәттен кейін көрінеді; ⌘Z қайтарады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 저장 중입니다. 잠시 후 표시되며 ⌘Z로 되돌릴 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазуу аткарылууда. Ал бир аздан кийин көрүнөт; ⌘Z аны артка кайтарат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijziging wordt nog verwerkt. Deze verschijnt zo; met ⌘Z maak je deze ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisywanie nadal trwa. Zmiany pojawią się za chwilę; ⌘Z je cofnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro ainda está sendo salvo. Ele aparecerá em instantes; ⌘Z desfaz a alteração."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração ainda está a ser guardada. Aparecerá dentro de instantes; ⌘Z desfaz a alteração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись ещё идёт. Она появится через мгновение; ⌘Z вернёт её."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сабт ҳоло идома дорад. Он ба зудӣ пайдо мешавад; ⌘Z онро бекор мекунад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt henüz tamamlanmadı. Birazdan görünecek; ⌘Z ile geri alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис ще в дорозі. Він з'явиться за мить; ⌘Z його скасовує."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zgarish hali yozilmoqda. Bir zumda ko‘rinadi; ⌘Z uni qaytaradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在写入，稍后即可显示；按 ⌘Z 可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在寫入，稍後就會顯示；按 ⌘Z 可還原。"
          }
        }
      }
    },
