    "exchange.import.undoHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z nimmt zuerst die Regeln zurück, dann die Schlagwörter. Ergänzte Kategorien bleiben: Entfernen Sie sie in den Einstellungen, wenn Sie sie nicht brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z takes back the rules, then the tags. Added categories stay: remove them in the settings if you do not need them."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z алдымен ережелерді, сосын белгілерді қайтарады. Қосылған санаттар қалады: қажет болмаса, оларды параметрлерде жойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z вернёт правила, а затем теги. Добавленные категории остаются: уберите их в настройках, если не нужны."
          }
        }
      }
    },
    "exchange.import.undoHint.touch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Rückgängig“ nimmt zuerst die Regeln zurück, dann die Schlagwörter. Ergänzte Kategorien bleiben: Entfernen Sie sie in den Einstellungen, wenn Sie sie nicht brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Undo” takes back the rules, then the tags. Added categories stay: remove them in the settings if you do not need them."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Болдырмау» алдымен ережелерді, сосын белгілерді қайтарады. Қосылған санаттар қалады: қажет болмаса, оларды параметрлерде жойыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отменить» вернёт правила, а затем теги. Добавленные категории остаются: уберите их в настройках, если не нужны."
          }
        }
      }
    },
