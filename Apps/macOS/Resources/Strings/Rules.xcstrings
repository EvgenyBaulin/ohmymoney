    "exchange.import.undoHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z адменіць даданне правілаў, а затым тэгаў. Дададзеныя катэгорыі застануцца: выдаліце іх у наладах, калі яны не патрэбны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z nimmt zuerst die Regeln zurück, dann die Schlagwörter. Ergänzte Kategorien bleiben: Entfernen Sie sie in den Einstellungen, wenn Sie sie nicht brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z takes back the rules, then the tags. Added categories stay: remove them in the settings if you do not need them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z quita las reglas, después las etiquetas. Las categorías añadidas se quedan: quítelas en los ajustes si no las necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z reprend les règles, puis les étiquettes. Les catégories ajoutées restent : supprimez-les dans les réglages si vous n'en avez pas besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z annulla l’aggiunta delle regole e poi dei tag. Le categorie aggiunte restano: rimuovile nelle impostazioni se non ti servono."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z алдымен ережелерді, сосын белгілерді қайтарады. Қосылған санаттар қалады: қажет болмаса, оларды параметрлерде жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z адегенде эрежелерди, андан соң тегдерди артка кайтарат. Кошулган категориялар калат: кереги жок болсо, жөндөөлөрдөн өчүрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z cofnie dodanie reguł, a następnie tagów. Dodane kategorie pozostaną: usuń je w ustawieniach, jeśli ich nie potrzebujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z remove as regras e depois as tags. As categorias adicionadas permanecem: remova-as nos ajustes se não precisar delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z вернёт правила, а затем теги. Добавленные категории остаются: уберите их в настройках, если не нужны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z önce kuralları, sonra etiketleri geri alır. Eklenen kategoriler kalır; gerekmezlerse ayarlardan silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z скасовує правила, потім позначки. Додані категорії лишаються: приберіть їх у налаштуваннях, якщо вони не потрібні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z avval qoidalarni, keyin teglarni qaytaradi. Qo‘shilgan turkumlar qoladi: kerak bo‘lmasa, ularni sozlamalarda o‘chiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌘Z 會先還原規則，再還原標籤。已加入的類別會保留；如不需要，可在設定中移除。"
          }
        }
      }
    },
    "exchange.import.undoHint.touch": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "“Адмяніць” адменіць даданне правілаў, а затым тэгаў. Дададзеныя катэгорыі застануцца: выдаліце іх у наладах, калі яны не патрэбны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Rückgängig“ nimmt zuerst die Regeln zurück, dann die Schlagwörter. Ergänzte Kategorien bleiben: Entfernen Sie sie in den Einstellungen, wenn Sie sie nicht brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Undo” takes back the rules, then the tags. Added categories stay: remove them in the settings if you do not need them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Deshacer» quita las reglas, después las etiquetas. Las categorías añadidas se quedan: quítelas en los ajustes si no las necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Annuler » reprend les règles, puis les étiquettes. Les catégories ajoutées restent : supprimez-les dans les réglages si vous n'en avez pas besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Annulla” annulla l’aggiunta delle regole e poi dei tag. Le categorie aggiunte restano: rimuovile nelle impostazioni se non ti servono."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Болдырмау» алдымен ережелерді, сосын белгілерді қайтарады. Қосылған санаттар қалады: қажет болмаса, оларды параметрлерде жойыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“Артка кайтаруу” адегенде эрежелерди, андан соң тегдерди артка кайтарат. Кошулган категориялар калат: кереги жок болсо, жөндөөлөрдөн өчүрүңүз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Cofnij” cofnie dodanie reguł, a następnie tagów. Dodane kategorie pozostaną: usuń je w ustawieniach, jeśli ich nie potrzebujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Desfazer” remove as regras e depois as tags. As categorias adicionadas permanecem: remova-as nos ajustes se não precisar delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отменить» вернёт правила, а затем теги. Добавленные категории остаются: уберите их в настройках, если не нужны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Geri Al” önce kuralları, sonra etiketleri geri alır. Eklenen kategoriler kalır; gerekmezlerse ayarlardan silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скасувати» скасовує правила, потім позначки. Додані категорії лишаються: приберіть їх у налаштуваннях, якщо вони не потрібні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bekor qilish” avval qoidalarni, keyin teglarni qaytaradi. Qo‘shilgan turkumlar qoladi: kerak bo‘lmasa, ularni sozlamalarda o‘chiring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按「還原」會先還原規則，再還原標籤。已加入的類別會保留；如不需要，可在設定中移除。"
          }
        }
      }
    },
