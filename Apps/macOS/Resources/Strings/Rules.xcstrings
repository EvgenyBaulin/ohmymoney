    "tags.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag is a free word: type «#vacation» in the entry line. It is not an event: no dates and no budget. An operation can carry several; in a report it counts under each."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег — свободное слово: напишите «#отпуск» в строке ввода. Это не событие: без дат и бюджета. У операции может быть несколько тегов; в отчёте она входит в каждый."
          }
        }
      }
    },
    "tags.invalidName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag is letters, digits, «-» and «_», with at least one letter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В названии тега — буквы, цифры, «-» и «_», хотя бы одна буква."
          }
        }
      }
