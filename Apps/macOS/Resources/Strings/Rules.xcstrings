    "exchange.import.undoHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z əvvəlcə qaydaları, sonra teqləri geri alır. Əlavə edilmiş kateqoriyalar qalır: lazım deyilsə, onları parametrlərdə silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z адменіць даданне правілаў, а затым тэгаў. Дададзеныя катэгорыі застануцца: выдаліце іх у наладах, калі яны не патрэбны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí ⌘Z vrátíte zpět pravidla a poté štítky. Přidané kategorie zůstanou zachovány; pokud je nepotřebujete, odstraňte je v nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z nimmt zuerst die Regeln zurück, dann die Schlagwörter. Ergänzte Kategorien bleiben: Entfernen Sie sie in den Einstellungen, wenn Sie sie nicht brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z takes back the rules, then the tags. Added categories stay: remove them in the settings if you do not need them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z quita las reglas, después las etiquetas. Las categorías añadidas se quedan: quítelas en los ajustes si no las necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z reprend les règles, puis les étiquettes. Les catégories ajoutées restent : supprimez-les dans les réglages si vous n'en avez pas besoin."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z-ը կհետարկի կանոնների, ապա՝ պիտակների ավելացումը։ Ավելացված կատեգորիաները կմնան․ եթե դրանք պետք չեն, հեռացրեք կարգավորումներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z annulla l’aggiunta delle regole e poi dei tag. Le categorie aggiunte restano: rimuovile nelle impostazioni se non ti servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Zでルール、タグの順に元に戻せます。追加されたカテゴリは残ります。不要な場合は設定で削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ჯერ წესებს გააუქმებს, შემდეგ კი ჭდეებს. დამატებული კატეგორიები დარჩება: თუ არ გჭირდებათ, წაშალეთ პარამეტრებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z алдымен ережелерді, сосын белгілерді қайтарады. Қосылған санаттар қалады: қажет болмаса, оларды параметрлерде жойыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z로 규칙과 태그를 차례로 되돌립니다. 추가된 카테고리는 유지되므로 필요하지 않으면 설정에서 제거하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z адегенде эрежелерди, андан соң тегдерди артка кайтарат. Кошулган категориялар калат: кереги жок болсо, жөндөөлөрдөн өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ⌘Z maak je eerst de regels en dan de tags ongedaan. Toegevoegde categorieën blijven staan: verwijder ze in de instellingen als je ze niet nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z cofnie dodanie reguł, a następnie tagów. Dodane kategorie pozostaną: usuń je w ustawieniach, jeśli ich nie potrzebujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z remove as regras e depois as tags. As categorias adicionadas permanecem: remova-as nos ajustes se não precisar delas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z remove as regras e depois as etiquetas. As categorias adicionadas mantêm-se: remova-as nas definições se não precisar delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z вернёт правила, а затем теги. Добавленные категории остаются: уберите их в настройках, если не нужны."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z аввал қоидаҳо ва баъд барчаспҳоро бармегардонад. Категорияҳои иловашуда мемонанд: агар лозим набошанд, онҳоро дар танзимот нест кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z önce kuralları, sonra etiketleri geri alır. Eklenen kategoriler kalır; gerekmezlerse ayarlardan silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z скасовує правила, потім позначки. Додані категорії лишаються: приберіть їх у налаштуваннях, якщо вони не потрібні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z avval qoidalarni, keyin teglarni qaytaradi. Qo‘shilgan turkumlar qoladi: kerak bo‘lmasa, ularni sozlamalarda o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌘Z 可依次撤销规则和标签。添加的类别会保留；如不需要，请在设置中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌘Z 會先還原規則，再還原標籤。已加入的類別會保留；如不需要，可在設定中移除。"
          }
        }
      }
    },
    "exchange.import.undoHint.touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“Geri al” əvvəlcə qaydaları, sonra teqləri geri alır. Əlavə edilmiş kateqoriyalar qalır: lazım deyilsə, onları parametrlərdə silin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "“Адмяніць” адменіць даданне правілаў, а затым тэгаў. Дададзеныя катэгорыі застануцца: выдаліце іх у наладах, калі яны не патрэбны."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volbou „Zpět“ vrátíte zpět pravidla a poté štítky. Přidané kategorie zůstanou zachovány; pokud je nepotřebujete, odstraňte je v nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Rückgängig“ nimmt zuerst die Regeln zurück, dann die Schlagwörter. Ergänzte Kategorien bleiben: Entfernen Sie sie in den Einstellungen, wenn Sie sie nicht brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Undo” takes back the rules, then the tags. Added categories stay: remove them in the settings if you do not need them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Deshacer» quita las reglas, después las etiquetas. Las categorías añadidas se quedan: quítelas en los ajustes si no las necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Annuler » reprend les règles, puis les étiquettes. Les catégories ajoutées restent : supprimez-les dans les réglages si vous n'en avez pas besoin."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "“Հետարկել”-ը կհետարկի կանոնների, ապա՝ պիտակների ավելացումը։ Ավելացված կատեգորիաները կմնան․ եթե դրանք պետք չեն, հեռացրեք կարգավորումներում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Annulla” annulla l’aggiunta delle regole e poi dei tag. Le categorie aggiunte restano: rimuovile nelle impostazioni se non ti servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“元に戻す”でルール、タグの順に元に戻せます。追加されたカテゴリは残ります。不要な場合は設定で削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "“გაუქმება” ჯერ წესებს გააუქმებს, შემდეგ კი ჭდეებს. დამატებული კატეგორიები დარჩება: თუ არ გჭირდებათ, წაშალეთ პარამეტრებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Болдырмау» алдымен ережелерді, сосын белгілерді қайтарады. Қосылған санаттар қалады: қажет болмаса, оларды параметрлерде жойыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“실행 취소”로 규칙과 태그를 차례로 되돌립니다. 추가된 카테고리는 유지되므로 필요하지 않으면 설정에서 제거하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "“Артка кайтаруу” адегенде эрежелерди, андан соң тегдерди артка кайтарат. Кошулган категориялар калат: кереги жок болсо, жөндөөлөрдөн өчүрүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ‘Herstel’ maak je eerst de regels en dan de tags ongedaan. Toegevoegde categorieën blijven staan: verwijder ze in de instellingen als je ze niet nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Cofnij” cofnie dodanie reguł, a następnie tagów. Dodane kategorie pozostaną: usuń je w ustawieniach, jeśli ich nie potrzebujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Desfazer” remove as regras e depois as tags. As categorias adicionadas permanecem: remova-as nos ajustes se não precisar delas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Desfazer” remove as regras e depois as etiquetas. As categorias adicionadas mantêm-se: remova-as nas definições se não precisar delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отменить» вернёт правила, а затем теги. Добавленные категории остаются: уберите их в настройках, если не нужны."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "“Бекор кардан” аввал қоидаҳо ва баъд барчаспҳоро бармегардонад. Категорияҳои иловашуда мемонанд: агар лозим набошанд, онҳоро дар танзимот нест кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Geri Al” önce kuralları, sonra etiketleri geri alır. Eklenen kategoriler kalır; gerekmezlerse ayarlardan silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скасувати» скасовує правила, потім позначки. Додані категорії лишаються: приберіть їх у налаштуваннях, якщо вони не потрібні."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bekor qilish” avval qoidalarni, keyin teglarni qaytaradi. Qo‘shilgan turkumlar qoladi: kerak bo‘lmasa, ularni sozlamalarda o‘chiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“撤销”可依次撤销规则和标签。添加的类别会保留；如不需要，请在设置中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按「還原」會先還原規則，再還原標籤。已加入的類別會保留；如不需要，可在設定中移除。"
          }
        }
      }
    },
