            "value": "Ese nombre es de otra etiqueta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom appartient à une autre étiquette"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անունն արդեն օգտագործվում է"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome già usato da un altro tag"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前は使用されています"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს სახელი სხვა თეგს ეკუთვნის"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ат басқа белгінікі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул аталыш башка тегге таандык"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze naam is al in gebruik"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta nazwa należy do innego tagu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nome já pertence a outra etiqueta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nome pertence a outra etiqueta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое название уже есть у другого тега"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин ном ба барчаспи дигар тааллуқ дорад"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad başka bir etikete ait"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця назва вже належить іншій позначці"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nom boshqa tegga tegishli"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此名称已用于其他标签"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此名稱已用於另一個標籤"
          }
        }
      }
    },
