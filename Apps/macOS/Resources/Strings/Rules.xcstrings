        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ат басқа белгінікі"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул аталыш башка тегге таандык"
