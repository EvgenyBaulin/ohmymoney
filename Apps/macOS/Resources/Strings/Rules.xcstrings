        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque las reglas que quiere incluir en el archivo. Las reglas que citan una cuenta, una tarjeta o una persona empiezan desmarcadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez les règles à mettre dans le fichier. Les règles qui nomment un compte, une carte ou une personne sont décochées au départ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona le regole da includere nel file. Le regole che indicano un conto, una carta o una persona sono inizialmente deselezionate."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлға салатын ережелерді белгілеңіз. Есеп-шотты, картаны не адамды атайтын ережелер белгіленбеген күйде басталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлга кошула турган эрежелерди белгилеңиз. Эсеп, карта же адам көрсөтүлгөн эрежелер башында белгиленбейт."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz reguły, które chcesz zapisać w pliku. Reguły wskazujące konto, kartę lub osobę są domyślnie odznaczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione as regras para incluir no arquivo. As regras que mencionam uma conta, um cartão ou uma pessoa aparecem desmarcadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте правила для файла. Правила, где назван счёт, карта или человек, по умолчанию не отмечены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaya eklenecek kuralları seçin. Hesap, kart veya kişi belirten kurallar başlangıçta seçili değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте правила, які потраплять до файлу. Правила, що називають рахунок, картку чи людину, позначені спочатку знятими."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylga kiritiladigan qoidalarni belgilang. Hisob, karta yoki shaxs ko‘rsatilgan qoidalar dastlab belgilanmagan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾選要放入檔案的規則。指定帳戶、卡片或人員的規則預設不勾選。"
          }
        }
      }
    },
