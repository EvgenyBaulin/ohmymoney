    "rules.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules yet. Add one: for example, «place contains Yandex Go and amount above 1,000 → tag #work»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay reglas. Añada una: por ejemplo, «el lugar contiene Yandex Go y el importe mayor que 1.000 → etiqueta #trabajo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de règle. Ajoutez-en une : par exemple, « lieu contient Yandex Go et montant supérieur à 1 000 → étiquette #travail »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил пока нет. Добавьте первое: например, «место содержит Яндекс Go и сумма больше 1 000 → тег #работа»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил ще немає. Додайте одне, наприклад: «місце містить Яндекс Go і сума більша за 1 000 → позначка #робота»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер әлі жоқ. Бір ереже қосыңыз: мысалы, «орында Yandex Go бар және сома 1 000-нан асады → белгі #work»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Regeln. Legen Sie eine an: zum Beispiel „Ort enthält Yandex Go und Betrag über 1.000 → Schlagwort #arbeit“."
          }
        }
      }
    },
