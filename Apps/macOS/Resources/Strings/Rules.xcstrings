    "rules.empty": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ qayda yoxdur. Birini əlavə edin: məsələn, «məkanda Yandex Go var və məbləğ 1,000-dən çoxdur → #work teqi»."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правілаў пакуль няма. Дадайце, напрыклад: «месца змяшчае Yandex Go і сума большая за 1,000 → тэг #work»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím tu nejsou žádná pravidla. Přidejte třeba «místo obsahuje Yandex Go a částka je vyšší než 1 000 → štítek #work»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Regeln. Legen Sie eine an: zum Beispiel „Ort enthält Yandex Go und Betrag über 1.000 → Schlagwort #arbeit“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules yet. Add one: for example, «place contains Yandex Go and amount above 1,000 → tag #work»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay reglas. Añada una: por ejemplo, «el lugar contiene Yandex Go y el importe mayor que 1.000 → etiqueta #trabajo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de règle. Ajoutez-en une : par exemple, « lieu contient Yandex Go et montant supérieur à 1 000 → étiquette #travail »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ կանոններ չկան։ Ավելացրեք մեկը, օրինակ՝ «վայրը պարունակում է Yandex Go և գումարը գերազանցում է 1,000 → պիտակ #work»։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna regola. Aggiungine una, per esempio: «il luogo contiene Yandex Go e l’importo è superiore a 1.000 → tag #work»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールはまだありません。たとえば、«場所にYandex Goを含み、金額が1,000より大きい → タグ#work»を追加できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წესები ჯერ არ არის. დაამატეთ წესი, მაგალითად: «ადგილი შეიცავს Yandex Go-ს და თანხა მეტია 1,000-ზე → ტეგი #work»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер әлі жоқ. Бір ереже қосыңыз: мысалы, «орында Yandex Go бар және сома 1 000-нан асады → белгі #work»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 규칙이 없습니다. 예: «장소에 Yandex Go 포함 및 금액 1,000 초과 → 태그 #work»."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эрежелер жок. Мисалы, «жерде Yandex Go бар жана сумма 1,000 ашык → #work тегин кошуу» деген эрежени кошуңуз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen regels. Voeg er een toe, bijvoorbeeld: «plaats bevat Yandex Go en bedrag hoger dan 1.000 → tag #work»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze reguł. Dodaj regułę, na przykład: «miejsce zawiera Yandex Go i kwota powyżej 1 000 → tag #praca»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma regra ainda. Adicione uma, por exemplo: «local contém Yandex Go e valor maior que 1.000 → etiqueta #work»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há regras. Adicione uma: por exemplo, «o local contém Yandex Go e o valor é superior a 1 000 → etiqueta #trabalho»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил пока нет. Добавьте первое: например, «место содержит Яндекс Go и сумма больше 1 000 → тег #работа»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз қоидае нест. Қоида илова кунед, масалан: «ҷой Yandex Go-ро дар бар мегирад ва маблағ аз 1,000 зиёд аст → барчаспи #work»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kural yok. Bir kural ekleyin: örneğin, «yer Yandex Go içeriyor ve tutar 1.000 üzerinde → #iş etiketi»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил ще немає. Додайте одне, наприклад: «місце містить Яндекс Go і сума більша за 1 000 → позначка #робота»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha qoidalar yo‘q. Qoida qo‘shing: masalan, «joyda Yandex Go bor va summa 1,000 dan katta → #work tegi»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有规则。添加一条，例如 «地点包含 Yandex Go 且金额大于 1,000 → 标签 #work»。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無規則。加入一個規則，例如 «地點包含 Yandex Go 且金額大於 1,000 → 標籤 #work»。"
          }
        }
      }
    },
