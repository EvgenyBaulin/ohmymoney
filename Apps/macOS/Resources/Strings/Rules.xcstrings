    "rules.hub.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules set the category, tags and rating when you enter an operation. Applying them to the past shows what would change first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas fijan la categoría, las etiquetas y la valoración al introducir una operación. Aplicarlas al pasado muestra antes lo que cambiaría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles fixent la catégorie, les étiquettes et l'utilité lorsque vous saisissez une opération. Les appliquer au passé montre d'abord ce qui changerait."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила ставят категорию, теги и оценку при вводе. Применение к прошлым сначала показывает, что изменится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила задають категорію, позначки й оцінку під час введення операції. Застосування до минулого спершу показує, що змінилося б."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер операцияны енгізгенде санатты, белгілерді және бағаны белгілейді. Өткенге қолдану алдымен не өзгеретінін көрсетеді."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln setzen Kategorie, Schlagwörter und Bewertung, wenn Sie einen Vorgang erfassen. Ihre Anwendung auf die Vergangenheit zeigt zuerst, was sich ändern würde."
          }
        }
      }
    },
