    "backfill.nothing": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaydalar heç nəyi dəyişməyəcək: hər şey artıq qaydalara uyğundur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правілы нічога не зменяць: усё ўжо адпавядае ім."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidla by nic nezměnila: vše jim již odpovídá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln würden nichts ändern: Alles sieht schon so aus, wie sie es wollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rules would change nothing: everything already looks as they want it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas no cambiarían nada: todo ya tiene el aspecto que quieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles ne changeraient rien : tout est déjà comme elles le veulent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանոնները ոչինչ չեն փոխի․ ամեն ինչ արդեն համապատասխանում է դրանց։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole non cambierebbero nulla: è già tutto come previsto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての取引がルールに一致しているため、変更はありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წესები არაფერს შეცვლიდა: ყველაფერი უკვე წესებს შეესაბამება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ережелер ешнәрсені өзгертпейді: бәрі бұрынғыдан қалаған күйінде тұр."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙에 따라 변경할 내용이 없습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эрежелер эч нерсени өзгөртпөйт: баары мурунтан эле аларга ылайык."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
