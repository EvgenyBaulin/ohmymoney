    "tags.collision.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İki teqin adı eyni ola bilməz. Onları birləşdirmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Два тэгі не могуць мець аднолькавую назву. Іх можна аб'яднаць."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva štítky nemohou mít stejný název. Můžete je sloučit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Schlagwörter können keinen Namen teilen. Sie können zu einem zusammengeführt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two tags cannot share a name. They can be merged into one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos etiquetas no pueden tener el mismo nombre. Se pueden fusionar en una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux étiquettes ne peuvent pas porter le même nom. Elles peuvent être fusionnées en une seule."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երկու պիտակ չեն կարող նույն անունն ունենալ։ Դրանք կարելի է միավորել։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due tag non possono avere lo stesso nome. Puoi unirli in uno solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のタグは作成できません。1つに統合できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ორ თეგს ერთი სახელი ვერ ექნება. შეგიძლიათ მათი შერწყმა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екі белгі бірдей атқа ие бола алмайды. Оларды біреуіне біріктіруге болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эки тегдин аталышы бирдей боло албайт. Аларды бириктирсе болот."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee tags kunnen niet dezelfde naam hebben. Je kunt ze samenvoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa tagi nie mogą mieć tej samej nazwy. Można je połączyć w jeden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas etiquetas não podem ter o mesmo nome. Elas podem ser combinadas em uma só."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas etiquetas não podem ter o mesmo nome. Pode combiná-las numa só."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два тега не могут называться одинаково. Их можно объединить в один."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ду барчасп наметавонанд як ном дошта бошанд. Онҳоро якҷо кардан мумкин аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki etiket aynı adı taşıyamaz. Bunları birleştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дві позначки не можуть мати одну назву. Їх можна злити в одну."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikki teg bir xil nomga ega bo‘la olmaydi. Ularni birlashtirish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签名称不能重复。你可以将它们合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤名稱不能重複。你可以將它們合併。"
          }
        }
      }
    },
    "tags.collision.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ad başqa teqə aiddir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Такая назва ўжо ёсць"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento název už má jiný štítek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name gehört einem anderen Schlagwort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name is another tag's"
          }
        },
        "es": {
          "stringUnit": {
