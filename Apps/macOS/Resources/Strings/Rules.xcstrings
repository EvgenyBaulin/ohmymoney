    "tags.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schlagwort ist ein freies Wort: Tippen Sie „#urlaub“ in die Eingabezeile. Es ist kein Ereignis: keine Daten und kein Budget. Ein Vorgang kann mehrere tragen; in einem Bericht zählt er unter jedem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag is a free word: type «#vacation» in the entry line. It is not an event: no dates and no budget. An operation can carry several; in a report it counts under each."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгі — еркін сөз: енгізу жолына «#демалыс» деп теріңіз. Ол іс-шара емес: күндері де, бюджеті де жоқ. Операцияда бірнеше белгі болуы мүмкін; есепте әрқайсысына жазылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег — свободное слово: напишите «#отпуск» в строке ввода. Это не событие: без дат и бюджета. У операции может быть несколько тегов; в отчёте она входит в каждый."
          }
        }
      }
    },
    "tags.invalidName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schlagwort besteht aus Buchstaben, Ziffern, „-“ und „_“, mit mindestens einem Buchstaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag is letters, digits, «-» and «_», with at least one letter."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгі — әріптер, сандар, «-» және «_», кем дегенде бір әріп болуы керек."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В названии тега — буквы, цифры, «-» и «_», хотя бы одна буква."
          }
        }
      }
    },
