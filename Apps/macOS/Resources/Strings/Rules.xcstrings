        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há etiquetas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тегов пока нет."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳанӯз барчасп нест."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz etiket yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначок ще немає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali teglar yo‘q."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無標籤。"
          }
        }
      }
    },
    "tags.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Teq sərbəst sözdür: daxiletmə sətrində «#vacation» yazın. Bu, hadisə deyil: tarixləri və büdcəsi yoxdur. Əməliyyatın bir neçə teqi ola bilər; hesabatda hər biri üzrə sayılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэг — адвольнае слова: увядзіце «#vacation» у радку ўводу. Гэта не падзея: у яго няма дат і бюджэту. Аперацыя можа мець некалькі тэгаў; у справаздачы яна ўлічваецца пад кожным."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítek je libovolné slovo: do řádku pro zadávání napište «#vacation». Není to událost: nemá datum ani rozpočet. Operace může mít více štítků; v přehledu se započítá u každého z nich."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schlagwort ist ein freies Wort: Tippen Sie „#urlaub“ in die Eingabezeile. Es ist kein Ereignis: keine Daten und kein Budget. Ein Vorgang kann mehrere tragen; in einem Bericht zählt er unter jedem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag is a free word: type «#vacation» in the entry line. It is not an event: no dates and no budget. An operation can carry several; in a report it counts under each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etiqueta es una palabra libre: escriba «#vacaciones» en la línea de entrada. No es un evento: no tiene fechas ni presupuesto. Una operación puede llevar varias; en un informe cuenta en cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étiquette est un mot libre : tapez « #vacances » dans la ligne de saisie. Ce n'est pas un événement : ni dates ni budget. Une opération peut en porter plusieurs ; dans un rapport, elle compte sous chacune."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պիտակը կամայական բառ է․ մուտքի տողում գրեք «#vacation»։ Այն իրադարձություն չէ․ ամսաթվեր և բյուջե չունի։ Գործարքը կարող է մի քանի պիտակ ունենալ․ հաշվետվությունում այն կհաշվվի յուրաքանչյուրի տակ։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tag è una parola libera: digita «#vacation» nella riga di inserimento. Non è un evento: non ha date né budget. Un’operazione può avere più tag; nel resoconto viene conteggiata per ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグは自由に付けられるキーワードです。入力欄に«#vacation»のように入力します。イベントとは異なり、日付や予算はありません。1つの取引に複数のタグを付けることができ、レポートでは各タグに計上されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თეგი თავისუფლად არჩეული სიტყვაა: შეყვანის ველში ჩაწერეთ «#vacation». ის მოვლენა არ არის: არ აქვს თარიღები და ბიუჯეტი. ოპერაციას შეიძლება რამდენიმე თეგი ჰქონდეს; ანგარიშში ის თითოეულში ითვლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгі — еркін сөз: енгізу жолына «#демалыс» деп теріңіз. Ол іс-шара емес: күндері де, бюджеті де жоқ. Операцияда бірнеше белгі болуы мүмкін; есепте әрқайсысына жазылады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег — эркин сөз: киргизүү сабына «#vacation» деп жазыңыз. Бул окуя эмес: датасы да, бюджети да жок. Операцияга бир нече тег койсо болот; отчетто ал ар биринде эсептелет."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tag is een vrij te kiezen woord: typ «#vacation» in het invoerveld. Een tag is geen gebeurtenis en heeft geen datums of budget. Een transactie kan meerdere tags hebben en telt in een overzicht mee bij elke tag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag to dowolne słowo: wpisz «#vacation» w polu wpisu. Nie jest wydarzeniem: nie ma dat ani budżetu. Operacja może mieć kilka tagów; w raporcie jest liczona dla każdego z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etiqueta é uma palavra livre: digite «#vacation» na linha de entrada. Ela não é um evento: não tem datas nem orçamento. Uma operação pode ter várias; no relatório, ela conta em cada uma delas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etiqueta é uma palavra à sua escolha: escreva «#vacation» na linha de entrada. Não é um evento: não tem datas nem orçamento. Uma operação pode ter várias etiquetas; num relatório, é contabilizada em cada uma delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег — свободное слово: напишите «#отпуск» в строке ввода. Это не событие: без дат и бюджета. У операции может быть несколько тегов; в отчёте она входит в каждый."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барчасп калимаи дилхоҳ аст: дар сатри воридкунӣ «#vacation» нависед. Он рӯйдод нест: сана ва буҷа надорад. Амалиёт метавонад чанд барчасп дошта бошад; дар ҳисобот он зери ҳар яки онҳо ҳисоб мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket serbestçe seçilen bir sözcüktür: giriş satırına «#vacation» yazın. Etkinlik değildir; tarihi veya bütçesi yoktur. Bir işlemde birden fazla etiket olabilir; raporda her birinde sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка — це вільне слово: введіть «#відпустка» в рядку вводу. Вона не є подією: без дат і бюджету. Операція може мати кілька; у звіті вона рахується під кожною."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Teg — ixtiyoriy so‘z: kiritish satriga «#vacation» deb yozing. U hodisa emas: sana va byudjeti yo‘q. Amalda bir nechta teg bo‘lishi mumkin; hisobotda amal har bir teg ostida hisoblanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签可以自由命名：在输入栏中输入 «#vacation»。标签不是事件，没有日期和预算。一笔交易可带多个标签，并在报告中计入每个标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤可自由命名：在輸入欄輸入 «#vacation»。標籤不是活動，沒有日期和預算。一筆交易可有多個標籤；報表會將交易計入每個標籤。"
          }
        }
      }
    },
    "tags.invalidName": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Teq hərflərdən, rəqəmlərdən, «-» və «_» işarələrindən ibarət olmalı və ən azı bir hərf olmalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэг можа змяшчаць літары, лічбы, «-» і «_» і мусіць мець хаця б адну літару."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítek může obsahovat písmena, číslice, «-» a «_» a musí obsahovat alespoň jedno písmeno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schlagwort besteht aus Buchstaben, Ziffern, „-“ und „_“, mit mindestens einem Buchstaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag is letters, digits, «-» and «_», with at least one letter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etiqueta son letras, cifras, «-» y «_», con al menos una letra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étiquette se compose de lettres, de chiffres, de « - » et de « _ », avec au moins une lettre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պիտակը կարող է պարունակել տառեր, թվեր, «-» և «_»՝ առնվազն մեկ տառով։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tag può contenere lettere, numeri, «-» e «_» e deve includere almeno una lettera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグには英数字、«-»、«_»を使用でき、文字を1文字以上含める必要があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თეგი შედგება ასოებისგან, ციფრებისგან, «-» და «_» ნიშნებისგან და შეიცავს სულ მცირე ერთ ასოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгі — әріптер, сандар, «-» және «_», кем дегенде бір әріп болуы керек."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег тамгалардан, сандардан, «-» жана «_» белгилеринен турат. Кеминде бир тамга болушу керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tag bestaat uit letters, cijfers, «-» en «_» en bevat minstens één letter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag może zawierać litery, cyfry, «-» i «_» oraz musi zawierać co najmniej jedną literę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etiqueta pode conter letras, números, «-» e «_», com pelo menos uma letra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etiqueta pode conter letras, algarismos, «-» e «_», e tem de ter pelo menos uma letra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В названии тега — буквы, цифры, «-» и «_», хотя бы одна буква."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барчасп аз ҳарфҳо, рақамҳо, «-» ва «_» иборат буда, бояд ҳадди ақал як ҳарф дошта бошад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket harf, rakam, «-» ve «_» içerebilir ve en az bir harf içermelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка складається з літер, цифр, «-» і «_», і в ній має бути хоча б одна літера."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Teg harflar, raqamlar, «-» va «_» dan iborat bo‘lib, kamida bitta harf bo‘lishi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签可包含字母、数字、«-» 和 «_»，且必须至少包含一个字母。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤可包含字母、數字、«-» 和 «_」，且至少須有一個字母。"
          }
        }
      }
    },
