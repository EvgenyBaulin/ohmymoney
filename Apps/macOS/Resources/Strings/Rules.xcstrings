        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file contiene anche dati per altre funzioni, che vengono conservati."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлда басқа мүмкіндіктерге арналған бөліктер де бар; олар соларға сақталады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлда башка функциялар үчүн да бөлүктөр бар; алар ошол функциялар үчүн сакталат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zawiera też dane innych funkcji; zostaną one zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo também contém dados de outros recursos, que serão preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле есть и части для других возможностей; они сохраняются для них."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya, diğer özelliklere ait bölümler de içeriyor; bunlar ilgili özellikler için saklanır."
