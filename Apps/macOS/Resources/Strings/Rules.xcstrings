    "exchange.error.newerFormat": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayl tətbiqin daha yeni versiyasında yaradılıb. Açmaq üçün tətbiqi yeniləyin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл створаны ў навейшай версіі праграмы. Абнавіце праграму, каб адкрыць яго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor byl vytvořen v novější verzi aplikace. Chcete-li ho otevřít, aplikaci aktualizujte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde von einer neueren Version der App erstellt. Aktualisieren Sie die App, um sie zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file was made by a newer version of the app. Update the app to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo lo hizo una versión más reciente de la app. Actualice la app para abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a été créé par une version plus récente de l'app. Mettez l'app à jour pour l'ouvrir."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլը ստեղծվել է հավելվածի ավելի նոր տարբերակով։ Այն բացելու համար թարմացրեք հավելվածը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è stato creato con una versione più recente dell’app. Aggiorna l’app per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは新しいバージョンのアプリで作成されました。開くにはアプリをアップデートしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილი აპის უფრო ახალი ვერსიით შეიქმნა. გასახსნელად განაახლეთ აპი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл қолданбаның жаңа нұсқасында жасалған. Оны ашу үшін қолданбаны жаңартыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 최신 버전의 앱에서 생성되었습니다. 파일을 열려면 앱을 업데이트하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл колдонмонун жаңыраак версиясында түзүлгөн. Аны ачуу үчүн колдонмону жаңыртыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand is gemaakt met een nieuwere versie van de app. Werk de app bij om het te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik utworzono w nowszej wersji aplikacji. Uaktualnij aplikację, aby go otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo foi criado em uma versão mais recente do app. Atualize o app para abri-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro foi criado por uma versão mais recente da app. Atualize a app para o abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл сделан более новой версией приложения. Обновите приложение, чтобы его открыть."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл бо версияи навтари барнома сохта шудааст. Барои кушодани он барномаро навсозӣ кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya, uygulamanın daha yeni bir sürümüyle oluşturulmuş. Açmak için uygulamayı güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл створено новішою версією застосунку. Оновіть застосунок, щоб його відкрити."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayl ilovaning yangiroq versiyasida yaratilgan. Uni ochish uchun ilovani yangilang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件由较新版本的 App 创建。请更新 App 以打开文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案由較新版本的 App 製作。請更新 App 以開啟。"
          }
        }
      }
    },
