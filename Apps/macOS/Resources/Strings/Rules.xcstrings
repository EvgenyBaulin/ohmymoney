          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets van jou verwijderd of hernoemd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden z Twoich elementów nie zostanie usunięty ani przemianowany."
