    "rules.editor.thenHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Teqlər toplanır. Kateqoriya təyin edən iki qaydadan siyahıda yuxarıda olan tətbiq edilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэгі дадаюцца. Калі два правілы задаюць катэгорыю, дзейнічае верхняе ў спісе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítky se sčítají. Pokud dvě pravidla nastavují kategorii, platí to výše v seznamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlagwörter addieren sich. Von zwei Regeln, die eine Kategorie setzen, gewinnt die obere in der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags add up. Of two rules that set a category, the upper one in the list wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas se suman. De dos reglas que fijan una categoría, gana la de arriba de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étiquettes s'ajoutent. Entre deux règles qui fixent une catégorie, c'est la plus haute de la liste qui l'emporte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պիտակները գումարվում են։ Եթե երկու կանոն սահմանում են կատեգորիա, կիրառվում է ցանկում ավելի բարձր գտնվողը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tag si sommano. Se due regole impostano una categoria, prevale quella più in alto nell’elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグは追加されます。カテゴリを設定するルールが2つある場合は、リストの上にあるルールが優先されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტეგები ემატება ერთმანეთს. თუ ორი წესი კატეგორიას განსაზღვრავს, უპირატესობა სიაში უფრო მაღლა მდგომს ენიჭება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Белгілер қосылады. Санатты белгілейтін екі ереженің тізімде жоғарғысы жеңеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그는 모두 추가됩니다. 두 규칙이 카테고리를 설정하면 목록에서 위에 있는 규칙이 적용됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тегдер кошулат. Категория койгон эки эреженин тизмедеги үстүңкүсү колдонулат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags worden bij elkaar opgeteld. Als twee regels een categorie instellen, geldt de bovenste regel in de lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagi są sumowane. Jeśli dwie reguły ustawiają kategorię, pierwszeństwo ma wyższa na liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As etiquetas se acumulam. Se duas regras definirem uma categoria, prevalece a que estiver acima na lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As etiquetas acumulam-se. Se duas regras definirem uma categoria, prevalece a que estiver mais acima na lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теги складываются. Из двух правил, которые ставят категорию, побеждает верхнее в списке."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барчаспҳо ҷамъ мешаванд. Агар ду қоида категорияро таъин кунанд, қоидаи болоӣ афзал аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketler birikir. Kategori belirleyen iki kuraldan listede üstte olan geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначки додаються. З двох правил, що задають категорію, перемагає верхнє в списку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Teglar qo‘shilib boradi. Turkum belgilovchi ikki qoidadan ro‘yxatda yuqoridagisi ustun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签会累加。如果两条规则设置了类别，列表中靠上的规则优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤會累加。如果兩個規則都設定類別，列表中較上方的規則優先。"
          }
        }
      }
    },
