    "rules.problem.badTime": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Başlanğıc» və «son» vaxtları fərqli olmalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Час «ад» і «да» павінен адрознівацца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časy «od» a «do» se musí lišit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhrzeit „von“ und „bis“ muss sich unterscheiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time «from» and «to» must differ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora «desde» y «hasta» deben ser distintas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure « de » et « à » doivent différer."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սկզբի և ավարտի ժամերը պետք է տարբեր լինեն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ora iniziale e quella finale devono essere diverse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時刻と終了時刻は異なる値にしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "«დან» და «მდე» დროები განსხვავებული უნდა იყოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Бастап» және «дейін» уақыты бір-бірінен өзгеше болуы керек."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 시간과 종료 시간은 달라야 합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "«Баштап» жана «чейин» убакыттары ар башка болушу керек."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De begin- en eindtijd moeten verschillen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny «od» i «do» muszą być różne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários «de» e «até» devem ser diferentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas de início e de fim têm de ser diferentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время «с» и «до» должны различаться."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вақтҳои «аз» ва «то» бояд фарқ кунанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç ve bitiş saatleri farklı olmalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час «від» і «до» має відрізнятися."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshlanish va tugash vaqtlari turlicha bo‘lishi kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始和结束时间不能相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "«從» 和 «至» 的時間必須不同。"
          }
        }
      }
    },
