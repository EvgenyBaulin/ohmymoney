    "exchange.import.failed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər şeyi əlavə etmək mümkün olmadı. Əlavə edilənlər saxlanılır; qalanlarını əlavə etmək üçün faylı yenidən açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўсё ўдалося дадаць. Дададзенае застанецца; адкрыйце файл зноў, каб дадаць астатняе."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se přidat vše. Přidané položky zůstanou zachovány; zbytek přidáte opětovným otevřením souboru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alles konnte ergänzt werden. Was ergänzt wurde, bleibt; öffnen Sie die Datei erneut, um den Rest zu ergänzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not everything could be added. What was added stays; open the file again to add the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo añadir todo. Lo que se añadió se queda; vuelva a abrir el archivo para añadir el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout n'a pas pu être ajouté. Ce qui a été ajouté reste ; rouvrez le fichier pour ajouter le reste."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց ավելացնել ամեն ինչ։ Ավելացվածը կպահպանվի․ մնացածն ավելացնելու համար կրկին բացեք ֆայլը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aggiungere tutto. Gli elementi aggiunti restano; apri di nuovo il file per aggiungere il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部を追加できませんでした。追加済みの内容は保持されます。残りを追加するには、ファイルをもう一度開いてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველაფრის დამატება ვერ მოხერხდა. დამატებული დარჩება; დანარჩენის დასამატებლად კვლავ გახსენით ფაილი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бәрі қосылмады. Қосылғаны қалады; қалғанын қосу үшін файлды қайта ашыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 항목을 추가할 수 없습니다. 추가된 항목은 유지됩니다. 나머지를 추가하려면 파일을 다시 여십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Баарын кошуу мүмкүн болгон жок. Кошулгандары сакталат; калганын кошуу үчүн файлды кайра ачыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet alles kon worden toegevoegd. Wat is toegevoegd, blijft staan; open het bestand opnieuw om de rest toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dodać wszystkiego. Dodane elementy pozostaną; otwórz plik ponownie, aby dodać resztę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível adicionar tudo. O que foi adicionado será mantido; abra o arquivo novamente para adicionar o restante."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível adicionar tudo. O que foi adicionado mantém-se; abra novamente o ficheiro para adicionar o resto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить удалось не всё. Что добавлено, то осталось; откройте файл ещё раз, чтобы добавить остальное."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "На ҳама чиз илова шуд. Чизҳои иловашуда мемонанд; барои илова кардани боқимонда файлро дубора кушоед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey eklenemedi. Eklenenler kalır; kalanları eklemek için dosyayı yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не все вдалося додати. Додане лишається; відкрийте файл знову, щоб додати решту."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hammasini qo‘shib bo‘lmadi. Qo‘shilganlar saqlanadi; qolganini qo‘shish uchun faylni qayta oching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能添加全部内容。已添加的内容会保留；请再次打开文件以添加其余内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法加入所有內容。已加入的內容會保留；請重新開啟檔案以加入其餘內容。"
          }
        }
      }
    },
