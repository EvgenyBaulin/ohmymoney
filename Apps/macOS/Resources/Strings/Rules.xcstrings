    "tags.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Teq əməliyyatların %lld hissəsindən silinəcək. Əməliyyatlar qalacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ён будзе выдалены з %lld частак аперацый. Аперацыі застануцца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítek bude odebrán z %lld částí operací. Operace zůstanou zachovány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird von %lld Teilen von Vorgängen entfernt. Die Vorgänge bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is taken off %lld parts of operations. The operations stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quita de %lld partes de operaciones. Las operaciones se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est retirée de %lld parties d'opérations. Les opérations restent."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն կհեռացվի գործարքների %lld մասից։ Գործարքները կմնան։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tag verrà rimosso da %lld parti di operazioni. Le operazioni resteranno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引の内訳%lld件からタグが削除されます。取引は残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თეგი მოიხსნება ოპერაციების %lld ნაწილიდან. ოპერაციები დარჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ол операциялардың %lld бөлігінен алынады. Операциялар қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег операциялардын %lld бөлүгүнөн алынып салынат. Операциялар сакталат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tag wordt verwijderd van %lld transactieonderdelen. De transacties blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag zostanie usunięty z %lld części operacji. Operacje pozostaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela será removida de %lld partes de operações. As operações serão mantidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Será removida de %lld partes de operações. As operações mantêm-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет снят с частей операций: %lld. Сами операции останутся."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Он аз %lld қисми амалиётҳо бардошта мешавад. Амалиётҳо боқӣ мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket, işlemlerin %lld bölümünden kaldırılır. İşlemler korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її знімають з %lld частин операцій. Операції лишаються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Teg amallarning %lld ta qismidan olib tashlanadi. Amallar saqlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签将从 %lld 个交易部分中移除，交易会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此標籤會從 %lld 個交易項目中移除，交易會保留。"
          }
        }
      }
    },
    "tags.delete.rules": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu teqdən istifadə edən qaydalardan müvafiq əməl silinəcək (%lld); əməli qalmayan qaydalar silinəcək (%lld)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзеянне з гэтым тэгам будзе выдалена з правіл (%lld); правілы без дзеянняў будуць выдалены (%lld)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z pravidel, která tento štítek používají, bude odebrána příslušná akce (%lld). Pravidla bez dalších akcí budou smazána (%lld)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln, die es nannten, verlieren diese Aktion (%lld); Regeln, die dann nichts mehr tun, werden gelöscht (%lld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules that named it lose that action (%lld); rules left with nothing to do are deleted (%lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas que la citaban pierden esa acción (%1$lld); las reglas que se quedan sin nada que hacer se eliminan (%2$lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles qui la nommaient perdent cette action (%lld) ; les règles qui ne font plus rien sont supprimées (%lld)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն օգտագործող կանոններից կհեռացվի այդ գործողությունը (%lld), իսկ առանց գործողության մնացած կանոնները կջնջվեն (%lld)։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole che usano il tag perderanno questa azione (%lld); quelle senza più azioni verranno eliminate (%lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグを指定しているルールから、そのアクションが削除されます（%lld件）。アクションがなくなったルールは削除されます（%lld件）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წესებს, რომლებიც ამ თეგს იყენებს, შესაბამისი მოქმედება მოეხსნება (%lld); წესები, რომლებსაც მოქმედება აღარ დარჩება, წაიშლება (%lld)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оны атаған ережелер сол әрекетті жоғалтады (%lld); істейтін ісі қалмаған ережелер жойылады (%lld)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул тег көрсөтүлгөн эрежелер ал аракетин жоготот (%lld); аракети калбаган эрежелер өчүрүлөт (%lld)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De actie wordt verwijderd uit regels die deze tag gebruiken (%lld). Regels zonder acties worden verwijderd (%lld)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły używające tego tagu utracą to działanie (%lld). Reguły bez działań zostaną usunięte (%lld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras que a usam perderão essa ação (%lld); as regras sem nenhuma ação serão apagadas (%lld)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras que a usam perdem essa ação (%lld); as regras sem ações são apagadas (%lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила, где он назван, потеряют это действие (%lld); правила, которым нечего делать, удалятся (%lld)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Қоидаҳое, ки ин барчаспро истифода мебаранд, он амалро аз даст медиҳанд (%lld); қоидаҳои бе амал нест карда мешаванд (%lld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu etiketi kullanan kurallardan ilgili eylem kaldırılır (%lld); eylemsiz kalan kurallar silinir (%lld)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила, що її називали, втрачають цю дію (%1$lld); правила, яким не лишилося що робити, видаляються (%2$lld)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu teg ko‘rsatilgan qoidalardan tegishli harakat olib tashlanadi (%lld); harakatsiz qolgan qoidalar o‘chiriladi (%lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此标签的规则将移除该操作（%lld 条）；没有剩余操作的规则将被删除（%lld 条）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此標籤的規則會移除該動作（%lld）；沒有剩餘動作的規則會被刪除（%lld）。"
          }
        }
      }
    },
