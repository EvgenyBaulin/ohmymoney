    "selfEmployed.setup.ownHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametrlər → Kateqoriyalar bölməsində hər kateqoriyanızın vergi dərəcəsini işarələyin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазначце стаўку кожнай катэгорыі ў Наладах → Катэгорыі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazbu pro každou kategorii nastavte v Nastavení → Kategorie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie den Satz jeder Ihrer Kategorien unter Einstellungen → Kategorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the rate of each of your categories in Settings → Categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque la tasa de cada una de sus categorías en Ajustes → Categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez le taux de chacune de vos catégories dans Réglages → Catégories."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր կատեգորիայի դրույքաչափը նշեք «Կարգավորումներ» → «Կատեգորիաներ» բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica l'aliquota di ogni categoria in Impostazioni → Categorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」→「カテゴリ」で、各カテゴリの税率を指定してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული კატეგორიის განაკვეთი მიუთითეთ: პარამეტრები → კატეგორიები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Параметрлер → Санаттар» ішінде әр санатыңыздың мөлшерлемесін белгілеңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 카테고리에서 각 카테고리의 세율을 지정하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир категорияңыздын ченин Жөндөөлөр → Категориялар бөлүмүнөн белгилеңиз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef het tarief van elke categorie op in Instellingen → Categorieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz stawkę każdej kategorii w Ustawienia → Kategorie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a alíquota de cada categoria em Ajustes → Categorias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a taxa de cada uma das tuas categorias em Definições → Categorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте ставку у своих категорий в «Настройки → Категории»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Меъёри ҳар категорияро дар «Танзимот» → «Категорияҳо» қайд кунед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → Kategoriler bölümünde her kategorinizin oranını işaretleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте ставку кожної з ваших категорій у «Налаштування → Категорії»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlamalar → Kategoriyalarda har bir kategoriyangiz uchun stavkani belgilang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”→“类别”中标记各类别的税率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」→「類別」中標示各類別的稅率。"
          }
        }
      }
    },
    "selfEmployed.setup.ready": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırdır: Gəlirlər → Özünüməşğulluq → fiziki şəxslərdən (4 %) və təşkilatlardan (6 %)"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гатова: Заробак → Самазанятасць → ад фізічных асоб (4 %) і ад арганізацый (6 %)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovo: Příjmy → Samostatná výdělečná činnost → od fyzických osob (4 %) a od organizací (6 %)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig: Einnahmen → Selbstständigkeit → von Privatpersonen (4 %) und von Organisationen (6 %)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready: Earnings → Self-employment → from individuals (4 %) and from organisations (6 %)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo: Ingresos → Actividad propia → de particulares (4 %) y de organizaciones (6 %)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt : Gains → Activité indépendante → de particuliers (4 %) et d'organisations (6 %)"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատրաստ է․ Եկամուտներ → Ինքնազբաղվածություն → ֆիզիկական անձանցից (4 %) և կազմակերպություններից (6 %)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto: Entrate → Lavoro autonomo → da privati (4 %) e da organizzazioni (6 %)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了：収入 → 個人事業 → 個人から（4 %）、法人から（6 %）"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მზადაა: შემოსავალი → თვითდასაქმება → ფიზიკური პირებისგან (4 %) და ორგანიზაციებისგან (6 %)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайын: Табыс → Өзін-өзі жұмыспен қамту → жеке тұлғалардан (4 %) және ұйымдардан (6 %)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료: 수입 → 자영업 → 개인 수입(4 %) 및 법인 수입(6 %)"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Даяр: Кирешелер → Өзүн-өзү иш менен камсыз кылуу → жеке жактардан (4 %) жана уюмдардан (6 %)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereed: Inkomsten → Zelfstandige activiteiten → van particulieren (4 %) en van organisaties (6 %)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe: Przychody → Samozatrudnienie → od osób fizycznych (4 %) i od organizacji (6 %)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto: Ganhos → Trabalho autônomo → de pessoas físicas (4 %) e de organizações (6 %)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto: Rendimentos → Trabalho independente → de particulares (4 %) e de organizações (6 %)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовые: Заработок → Самозанятость → от физлиц (4 %) и от организаций (6 %)"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тайёр: Даромад → Худмашғулӣ → аз шахсони воқеӣ (4 %) ва аз ташкилотҳо (6 %)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır: Kazançlar → Serbest çalışma → kişilerden (%4) ve kurumlardan (%6)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово: Заробіток → Самозайнятість → від фізичних осіб (4 %) і від організацій (6 %)"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tayyor: Daromadlar → O‘zini o‘zi band qilish → jismoniy shaxslardan (4 %) va tashkilotlardan (6 %)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已就绪：收入 → 个体经营 → 来自个人（4 %）和来自机构（6 %）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已就緒：收入 → 自僱 → 來自個人（4 %）及機構（6 %）"
          }
        }
      }
    },
    "selfEmployed.setup.readyHint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kateqoriyalar yaradıldı və ya mövcud kateqoriyalara dərəcələr əlavə edildi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыі будуць створаны, а наяўныя атрымаюць свае стаўкі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie jsou vytvořené. Pokud už existovaly, mají nastavené sazby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorien sind angelegt oder bekommen ihre Sätze, wo sie schon sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The categories are made, or get their rates where they are already."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías están creadas, o reciben sus tasas donde ya existen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories sont créées, ou reçoivent leurs taux là où elles existent déjà."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կատեգորիաները ստեղծվել են, իսկ գոյություն ունեցողներին ավելացվել են դրույքաչափերը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le categorie vengono create oppure, se esistono già, vengono aggiornate le aliquote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリを作成するか、既存のカテゴリに税率を設定します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კატეგორიები შეიქმნა ან არსებულებს განაკვეთები დაემატა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санаттар жасалды немесе бар жерінде өз мөлшерлемесін алды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리가 생성되었거나 기존 카테고리에 세율이 적용되었습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Категориялар түзүлдү же мурунтан бар категорияларга чендер коюлду."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De categorieën zijn aangemaakt of hebben hun tarieven gekregen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie zostały utworzone lub przypisano stawki do istniejących."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias serão criadas ou terão suas alíquotas atualizadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias são criadas ou, se já existirem, recebem as respetivas taxas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории создадутся, а если уже есть — получат ставки."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорияҳо сохта шуданд ё меъёрҳояшон нав шуданд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoriler oluşturuldu veya mevcut kategorilerin oranları güncellendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорії створено або вони вже мають свої ставки."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Toifalar yaratildi yoki mavjudlariga stavkalar belgilandi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已创建类别，或为现有类别设置税率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已建立類別，或為現有類別設定稅率。"
          }
        }
      }
    },
