        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst die Selbstständigensteuer ≈ %@; die Regeln nehmen ihren Anteil von %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax of self-employment ≈ %@ first; the rules take their share of %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero, el impuesto por actividad propia ≈ %@; las reglas toman su parte de %@"
