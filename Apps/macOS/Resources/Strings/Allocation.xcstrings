        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "განაწილება ვერ ჩაიწერა. სცადეთ ხელახლა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлуді жазу мүмкін болмады. Қайталап көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배분을 기록할 수 없습니다. 다시 시도하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бөлүштүрүүнү сактоо мүмкүн болгон жок. Кайра аракет кылыңыз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verdeling kon niet worden vastgelegd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać podziału. Spróbuj ponownie."
          }
        },
        "pt-BR": {
