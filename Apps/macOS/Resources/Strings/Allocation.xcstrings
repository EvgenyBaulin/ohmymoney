  "strings": {
    "allocation.base": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку падатак на прафесійны даход ≈ %@; правілы бяруць долю ад %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst die Selbstständigensteuer ≈ %@; die Regeln nehmen ihren Anteil von %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax of self-employment ≈ %@ first; the rules take their share of %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima imposta sul lavoro autonomo ≈ %@; le regole ripartiscono %@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдымен өзін-өзі жұмыспен қамтығандар салығы ≈ %@; ережелер өз үлесін %@ ішінен алады"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала налог самозанятого ≈ %@; правила берут долю от %@"
          }
        }
      }
    },
