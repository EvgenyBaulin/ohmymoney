    "rules.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнт бярэцца ад даходу пасля падатку на прафесійны даход. Правілы толькі прапануюць: без «Запісаць» нічога не запісваецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Prozentsatz wird vom Einkommen nach der Selbstständigensteuer genommen. Regeln schlagen nur vor: Ohne „Eintragen“ wird nichts geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A percent is taken of the income after the tax of self-employment. Rules only suggest: nothing is written without «Write»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje se toma de los ingresos después del impuesto por actividad propia. Las reglas solo proponen: nada se anota sin «Anotar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pourcentage se prend sur le revenu après l'impôt sur l'activité. Les règles ne font que proposer : rien n'est noté sans « Noter »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale è calcolata sull'entrata al netto dell'imposta sul lavoro autonomo. Le regole sono solo suggerimenti: nulla viene registrato senza «Registra»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз өзін-өзі жұмыспен қамтығандар салығынан кейінгі табыстан алынады. Ережелер тек ұсынады: «Жазу» басылмайынша ештеңе жазылмайды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procent jest liczony od przychodu po odliczeniu podatku od samozatrudnienia. Reguły tylko sugerują podział: nic nie zostanie zapisane bez wybrania «Zapisz»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porcentagem é calculada sobre a receita após o imposto de autônomo. As regras apenas sugerem valores: nada é registrado sem tocar em «Registrar»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процент берётся от дохода после налога самозанятого. Правила только предлагают: без «Записать» ничего не пишется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzde, serbest çalışma vergisi düşüldükten sonraki gelirden alınır. Kurallar yalnızca öneri sunar; «Kaydet» seçilmeden hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсоток береться від доходу після податку на самозайнятість. Правила лише пропонують: нічого не записується без «Записати»."
          }
        }
      }
    },
    "rules.refusal.amount": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце працэнт ад 0 да 100 або суму большую за нуль"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Prozentsatz von 0 bis 100 oder einen Betrag über null ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a percent from 0 to 100 or a sum above zero"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba un porcentaje de 0 a 100 o una suma mayor que cero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un pourcentage de 0 à 100 ou une somme supérieure à zéro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una percentuale tra 0 e 100 o un importo superiore a zero"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "0-ден 100-ге дейінгі пайызды немесе нөлден жоғары соманы енгізіңіз"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz procent od 0 do 100 lub kwotę większą od zera"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira uma porcentagem de 0 a 100 ou um valor maior que zero"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите процент от 0 до 100 или сумму больше нуля"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 ile 100 arasında bir yüzde veya sıfırdan büyük bir tutar girin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть відсоток від 0 до 100 або суму більше нуля"
          }
        }
      }
    },
