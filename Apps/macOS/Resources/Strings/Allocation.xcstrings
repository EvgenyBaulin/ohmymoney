    "rules.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнт бярэцца ад даходу пасля падатку на прафесійны даход. Правілы толькі прапануюць: без «Запісаць» нічога не запісваецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Prozentsatz wird vom Einkommen nach der Selbstständigensteuer genommen. Regeln schlagen nur vor: Ohne „Eintragen“ wird nichts geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A percent is taken of the income after the tax of self-employment. Rules only suggest: nothing is written without «Write»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale è calcolata sull'entrata al netto dell'imposta sul lavoro autonomo. Le regole sono solo suggerimenti: nulla viene registrato senza «Registra»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз өзін-өзі жұмыспен қамтығандар салығынан кейінгі табыстан алынады. Ережелер тек ұсынады: «Жазу» басылмайынша ештеңе жазылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процент берётся от дохода после налога самозанятого. Правила только предлагают: без «Записать» ничего не пишется."
          }
        }
      }
    },
    "rules.refusal.amount": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце працэнт ад 0 да 100 або суму большую за нуль"
          }
