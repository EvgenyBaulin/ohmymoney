    "allocation.shown.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі паказана: плацяжы, абавязковыя выплаты і ліміты тут не запісваюцца. Змяняйце ліміты ў Планаванні."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zur Anzeige: Zahlungen, Fälligkeiten und Limits werden hier nicht eingetragen. Limits ändern Sie in der Planung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only shown: payments, dues and limits are not written here. Change limits in Planning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo a titolo informativo: pagamenti, importi dovuti e limiti non vengono registrati qui. Modifica i limiti in Pianificazione."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек көрсетіледі: төлемдер, берешектер және лимиттер мұнда жазылмайды. Лимиттерді «Жоспарлауда» өзгертіңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только показано: платежи, сроки и лимиты здесь не записываются. Изменить лимиты — в «Планировании»."
          }
        }
      }
    },
