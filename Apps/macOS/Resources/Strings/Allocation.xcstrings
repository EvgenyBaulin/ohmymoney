        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'abord l'impôt sur l'activité ≈ %@ ; les règles prennent leur part de %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала налог самозанятого ≈ %@; правила берут долю от %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу податок на самозайнятість ≈ %@; правила беруть свою частку з %@"
