          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare la ripartizione. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り当てを記録できませんでした。もう一度お試しください。"
