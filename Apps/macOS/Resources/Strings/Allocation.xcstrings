    "rules.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faiz fərdi fəaliyyət vergisi çıxıldıqdan sonra gəlirdən hesablanır. Qaydalar yalnız təklifdir: «Saxla» seçilmədən heç nə saxlanmır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працэнт бярэцца ад даходу пасля падатку на прафесійны даход. Правілы толькі прапануюць: без «Запісаць» нічога не запісваецца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procenta se počítají z příjmu po odečtení daně ze samostatné činnosti. Pravidla slouží jen jako návrh: bez volby «Zapsat» se nic nezapíše."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Prozentsatz wird vom Einkommen nach der Selbstständigensteuer genommen. Regeln schlagen nur vor: Ohne „Eintragen“ wird nichts geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A percent is taken of the income after the tax of self-employment. Rules only suggest: nothing is written without «Write»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje se toma de los ingresos después del impuesto por actividad propia. Las reglas solo proponen: nada se anota sin «Anotar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pourcentage se prend sur le revenu après l'impôt sur l'activité. Les règles ne font que proposer : rien n'est noté sans « Noter »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տոկոսը հաշվարկվում է եկամտից՝ ինքնազբաղվածության հարկը հանելուց հետո։ Կանոնները միայն առաջարկում են․ առանց «Գրանցել» ընտրելու ոչինչ չի գրանցվում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale è calcolata sull'entrata al netto dell'imposta sul lavoro autonomo. Le regole sono solo suggerimenti: nulla viene registrato senza «Registra»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割合は自営業税を差し引いた収入に適用されます。ルールは提案のみで、「記録」を押すまで記録されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პროცენტი ითვლება თვითდასაქმების გადასახადის გამოკლების შემდეგ. წესები მხოლოდ შეთავაზებაა: «ჩაწერა»-ს გარეშე არაფერი ჩაიწერება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз өзін-өзі жұмыспен қамтығандар салығынан кейінгі табыстан алынады. Ережелер тек ұсынады: «Жазу» басылмайынша ештеңе жазылмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자영업세를 뺀 수입을 기준으로 비율을 계산합니다. 규칙은 배분을 제안하며 «기록»을 선택해야 저장됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайыз өз алдынча иштөө салыгы алынгандан кийинки кирешеден эсептелет. Эрежелер сунуш гана берет: «Сактоо» басылмайынча эч нерсе сакталбайт."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het percentage wordt berekend over het inkomen na belasting voor zelfstandigen. Regels doen alleen voorstellen: er wordt niets vastgelegd zonder «Leg vast»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procent jest liczony od przychodu po odliczeniu podatku od samozatrudnienia. Reguły tylko sugerują podział: nic nie zostanie zapisane bez wybrania «Zapisz»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porcentagem é calculada sobre a receita após o imposto de autônomo. As regras apenas sugerem valores: nada é registrado sem tocar em «Registrar»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A percentagem é calculada sobre o rendimento após o imposto sobre trabalho independente. As regras são apenas sugestões: nada é registado sem tocar em «Registar»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процент берётся от дохода после налога самозанятого. Правила только предлагают: без «Записать» ничего не пишется."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоиз аз даромад пас аз андози худмашғулият ҳисоб мешавад. Қоидаҳо танҳо пешниҳод мекунанд: бе «Сабт кардан» чизе сабт намешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzde, serbest çalışma vergisi düşüldükten sonraki gelirden alınır. Kurallar yalnızca öneri sunar; «Kaydet» seçilmeden hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсоток береться від доходу після податку на самозайнятість. Правила лише пропонують: нічого не записується без «Записати»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Foiz daromaddan o‘zini o‘zi band qilish solig‘i ayirilgach hisoblanadi. Qoidalar faqat taklif qiladi: «Saqlash» bosilmaguncha hech narsa saqlanmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比按扣除自雇税后的收入计算。规则仅提供建议；点击“记录”后才会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比依扣除自僱稅後的收入計算。規則僅供建議；點按「記錄」後才會儲存。"
          }
        }
      }
    },
    "rules.refusal.amount": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "0-dan 100-ə qədər faiz və ya sıfırdan böyük məbləğ daxil edin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увядзіце працэнт ад 0 да 100 або суму большую за нуль"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte procento od 0 do 100 nebo částku vyšší než nula"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Prozentsatz von 0 bis 100 oder einen Betrag über null ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a percent from 0 to 100 or a sum above zero"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba un porcentaje de 0 a 100 o una suma mayor que cero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un pourcentage de 0 à 100 ou une somme supérieure à zéro"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք 0-ից 100 տոկոս կամ զրոյից մեծ գումար"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una percentuale tra 0 e 100 o un importo superiore a zero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0から100までの割合、または0より大きい金額を入力してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ პროცენტი 0-დან 100-მდე ან ნულზე მეტი თანხა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "0-ден 100-ге дейінгі пайызды немесе нөлден жоғары соманы енгізіңіз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0~100 사이의 비율 또는 0보다 큰 금액을 입력하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "0дөн 100гө чейинки пайызды же нөлдөн чоң сумманы киргизиңиз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een percentage van 0 tot 100 of een bedrag boven nul in"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz procent od 0 do 100 lub kwotę większą od zera"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira uma porcentagem de 0 a 100 ou um valor maior que zero"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduz uma percentagem de 0 a 100 ou um montante superior a zero"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите процент от 0 до 100 или сумму больше нуля"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоиз аз 0 то 100 ё маблағи аз сифр зиёдро ворид кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 ile 100 arasında bir yüzde veya sıfırdan büyük bir tutar girin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть відсоток від 0 до 100 або суму більше нуля"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dan 100 gacha foiz yoki noldan katta summa kiriting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 0 到 100 之间的百分比或大于零的金额"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 0 到 100 之間的百分比，或大於零的金額"
          }
        }
      }
    },
    "rules.refusal.cushionTaken": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehtiyat fondu üçün artıq qayda var"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для падушкі ўжо ёсць правіла"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerva už má pravidlo"
          }
        },
        "de": {
