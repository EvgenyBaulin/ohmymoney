        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fondo di emergenza ha già una regola"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生活防衛資金のルールはすでにあります"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბუფერს უკვე აქვს წესი"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастықтың ережесі бұрыннан бар"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비상금에 이미 규칙이 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Коопсуздук жаздыгынын эрежеси мурунтан бар"
