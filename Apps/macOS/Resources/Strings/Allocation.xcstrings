        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу податок на самозайнятість ≈ %@; правила беруть свою частку з %@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval o‘zini o‘zi band qilish solig‘i ≈ %@; qoidalar %@dan ulush oladi"
          }
        },
