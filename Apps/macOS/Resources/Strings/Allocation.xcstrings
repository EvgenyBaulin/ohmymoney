    "monthRest.hint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што можна патраціць цяпер мінус будучыя плацяжы. «Не цяпер» схавае да наступнага месяца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jetzt ausgegeben werden kann, abzüglich der anstehenden Zahlungen. „Nicht jetzt“ legt es bis zum nächsten Monat beiseite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be spent now less the payments ahead. «Not now» puts it away until next month."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto puoi spendere ora, al netto dei pagamenti previsti. «Non ora» rimanda al mese prossimo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір не жұмсауға болатыны, минус алдағы төлемдер. «Қазір емес» оны келесі айға дейін бөлек қояды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Можно тратить сейчас» минус платежи впереди. «Не надо» — до следующего месяца."
          }
        }
      }
    },
