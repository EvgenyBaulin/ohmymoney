    "monthRest.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İndi xərclənə bilən məbləğdən qarşıdakı ödənişlər çıxılıb. «İndi yox» məbləği gələn aya saxlayır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Што можна патраціць цяпер мінус будучыя плацяжы. «Не цяпер» схавае да наступнага месяца."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částka, kterou lze nyní utratit, po odečtení nadcházejících plateb. Volba «Teď ne» ji odloží do příštího měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jetzt ausgegeben werden kann, abzüglich der anstehenden Zahlungen. „Nicht jetzt“ legt es bis zum nächsten Monat beiseite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be spent now less the payments ahead. «Not now» puts it away until next month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se puede gastar ahora menos los pagos pendientes. «Ahora no» lo aparta hasta el mes que viene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui peut être dépensé maintenant, moins les paiements à venir. « Pas maintenant » le met de côté jusqu'au mois prochain."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այժմ ծախսելու համար հասանելի գումարը՝ հանած առաջիկա վճարումները։ «Ոչ հիմա» ընտրելիս այն հետաձգվում է մինչև հաջորդ ամիս։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto puoi spendere ora, al netto dei pagamenti previsti. «Non ora» rimanda al mese prossimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今使える金額から今後の支払いを差し引いた額です。「今はしない」を選ぶと、来月まで保留されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახლა დასახარჯი თანხა მომავალი გადახდების გამოკლებით. «ახლა არა» მას მომავალ თვემდე გადადებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір не жұмсауға болатыны, минус алдағы төлемдер. «Қазір емес» оны келесі айға дейін бөлек қояды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 쓸 수 있는 금액에서 앞으로의 결제액을 뺀 금액입니다. «나중에»를 선택하면 다음 달로 미룹니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Азыр сарптоого жеткиликтүү суммадан алдыдагы төлөмдөр алып салынат. «Азыр эмес» аны кийинки айга калтырат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je nu kunt uitgeven, min de komende betalingen. Met «Niet nu» bewaar je het tot volgende maand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępne środki pomniejszone o nadchodzące płatności. Wybierz «Nie teraz», aby odłożyć je do przyszłego miesiąca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pode ser gasto agora, descontados os pagamentos futuros. «Agora não» guarda o valor até o próximo mês."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que podes gastar agora, descontando os pagamentos futuros. «Agora não» guarda-o até ao próximo mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Можно тратить сейчас» минус платежи впереди. «Не надо» — до следующего месяца."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маблағи дастрас бо тарҳи пардохтҳои дарпешистода. «Ҳоло не» онро то моҳи оянда нигоҳ медорад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi harcanabilecek tutardan yaklaşan ödemeler düşülür. «Şimdi Değil» seçeneği tutarı gelecek aya bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що можна витратити зараз, без наперед запланованих платежів. «Не зараз» відкладає це до наступного місяця."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozir sarflash mumkin bo‘lgan puldan kelgusi to‘lovlar ayiriladi. «Hozir emas» summani keyingi oygacha qoldiradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前可花费的金额减去即将到来的付款。选择“暂不”可将其留到下个月。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前可用金額扣除即將到期的付款。「稍後再說」會將金額保留至下個月。"
          }
        }
      }
    },
