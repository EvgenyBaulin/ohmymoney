    "npd.pay.check": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesablanıb: %@. «Мой налог» xidmətində yoxlayın — son məbləği vergi idarəsi müəyyən edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана: %@. Праверце ў «Мой налог» — канчатковая сума за падатковай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypočteno: %@. Ověřte v «Мой налог» — rozhodující je částka od finančního úřadu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet: %@. Prüfen Sie es in „Mein Steuer“ — das letzte Wort hat das Finanzamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worked out: %@. Check it in «Мой налог» — the tax office has the last word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado: %@. Compruébelo en «Mi impuesto»: la última palabra la tiene la oficina de impuestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé : %@. Vérifiez-le dans « Mon impôt » — le dernier mot revient au fisc."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվարկված է՝ %@։ Ստուգեք «Мой налог»-ում․ վերջնական գումարը որոշում է հարկայինը։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato: %@. Verifica in «Мой налог»: fa fede l'importo del fisco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算額: %@。「Мой налог」で確認してください。税務署の金額が確定額です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოითვალა: %@. გადაამოწმეთ «Мой налог»-ში — საბოლოო თანხას საგადასახადო ადგენს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептелді: %@. «Менің салығым» ішінде тексеріңіз — соңғы сөз салық басқармасында."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산 금액: %@. «Мой налог»에서 확인하십시오. 최종 금액은 세무서에서 결정합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептелди: %@. «Мой налог» кызматынан текшериңиз — акыркы чечимди салык кызматы чыгарат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berekend: %@. Controleer dit in «Мой налог»; de belastingdienst bepaalt het definitieve bedrag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczono: %@. Sprawdź w «Мой налог» — decyduje urząd skarbowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado: %@. Confira em «Мой налог» — o valor do fisco prevalece."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado: %@. Confirma em «Мой налог» — prevalece o valor da autoridade tributária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитано: %@. Проверьте в «Мой налог» — последнее слово за ФНС."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоб шуд: %@. Дар «Мой налог» санҷед — қарори ниҳоӣ аз они идораи андоз аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplanan: %@. «Мой налог» üzerinden kontrol edin — son sözü vergi dairesi söyler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розраховано: %@. Перевірте в «Мой налог» — останнє слово за податковою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblandi: %@. «Мой налог»da tekshiring — yakuniy summani soliq idorasi belgilaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算结果：%@。请在«Мой налог»中核对，以税务局数据为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算結果：%@。請在 «Мой налог» 中確認，最終金額以稅務機關為準。"
          }
        }
      }
    },
