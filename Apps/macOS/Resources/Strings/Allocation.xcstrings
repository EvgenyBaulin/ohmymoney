          "stringUnit": {
            "state": "translated",
            "value": "Адаттагыдан %@ көп. Айырмасын бөлүштүрөсүзбү?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ meer dan normaal. Verschil verdelen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ więcej niż zwykle. Rozdzielić różnicę?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a mais que o habitual. Distribuir a diferença?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ acima do habitual. Distribuir a diferença?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ больше обычного. Разложить разницу?"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аз маъмулӣ %@ бештар. Фарқ тақсим шавад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalden %@ fazla. Fark dağıtılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ більше, ніж зазвичай. Розподілити різницю?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatdagidan %@ ko‘p. Farq taqsimlansinmi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比平时多 %@。分配差额？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比平常多 %@。要分配差額嗎？"
          }
        }
      }
    },
