    "selfEmployed.tile.off": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце «Я самазаняты» ў Наладах → Планаванне"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie „Ich bin selbstständig“ unter Einstellungen → Planung ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on «I am self-employed» in Settings → Planning"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva «Sono un lavoratore autonomo» in Impostazioni → Pianificazione"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Параметрлер → Жоспарлау» ішінде «Мен өзін-өзі жұмыспен қамтамын» қосыңыз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Я самозанятый» в «Настройки → Планирование»"
          }
        }
      }
    },
    "tax.pay.check": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана: %@ — стаўка катэгорыі ад даходу за квартал. Зверце з падатковай — канчатковая сума за ёй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet: %@ — der Satz der Kategorie auf die Einnahmen des Quartals. Prüfen Sie ihn beim Finanzamt — das letzte Wort hat es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worked out: %@ — the rate of the category on the income of the quarter. Check it against the tax office — it has the last word."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolo: %@ — aliquota della categoria applicata al reddito del trimestre. Verifica con l’ufficio delle imposte: spetta a lui l’ultima parola."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептелді: %@ — тоқсан табысына санаттың мөлшерлемесі. Салық басқармасымен тексеріңіз — соңғы сөз оныкі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитано: %@ — ставка категории с доходов квартала. Сверьте с ФНС — последнее слово за ней."
          }
        }
      }
    },
    "tax.pay.title": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падатак па спрошчанай сістэме (USN) за %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereinfachte Steuer (USN) für %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplified tax (USN) for %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta semplificata (USN) per %@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ үшін жеңілдетілген салық (УСН)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог УСН за %@"
          }
        }
      }
    }
