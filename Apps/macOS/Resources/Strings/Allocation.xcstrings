        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախ՝ ինքնազբաղվածության հարկը՝ ≈ %@, ապա %@-ից՝ ըստ կանոնների"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima imposta sul lavoro autonomo ≈ %@; le regole ripartiscono %@"
