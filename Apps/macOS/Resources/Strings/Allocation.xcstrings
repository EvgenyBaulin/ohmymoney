    "selfEmployed.setup.ownHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазначце стаўку кожнай катэгорыі ў Наладах → Катэгорыі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie den Satz jeder Ihrer Kategorien unter Einstellungen → Kategorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the rate of each of your categories in Settings → Categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque la tasa de cada una de sus categorías en Ajustes → Categorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez le taux de chacune de vos catégories dans Réglages → Catégories."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica l'aliquota di ogni categoria in Impostazioni → Categorie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Параметрлер → Санаттар» ішінде әр санатыңыздың мөлшерлемесін белгілеңіз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz stawkę każdej kategorii w Ustawienia → Kategorie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a alíquota de cada categoria em Ajustes → Categorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте ставку у своих категорий в «Настройки → Категории»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → Kategoriler bölümünde her kategorinizin oranını işaretleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте ставку кожної з ваших категорій у «Налаштування → Категорії»."
          }
        }
      }
    },
    "selfEmployed.setup.ready": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гатова: Заробак → Самазанятасць → ад фізічных асоб (4 %) і ад арганізацый (6 %)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig: Einnahmen → Selbstständigkeit → von Privatpersonen (4 %) und von Organisationen (6 %)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready: Earnings → Self-employment → from individuals (4 %) and from organisations (6 %)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo: Ingresos → Actividad propia → de particulares (4 %) y de organizaciones (6 %)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt : Gains → Activité indépendante → de particuliers (4 %) et d'organisations (6 %)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto: Entrate → Lavoro autonomo → da privati (4 %) e da organizzazioni (6 %)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайын: Табыс → Өзін-өзі жұмыспен қамту → жеке тұлғалардан (4 %) және ұйымдардан (6 %)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe: Przychody → Samozatrudnienie → od osób fizycznych (4 %) i od organizacji (6 %)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto: Ganhos → Trabalho autônomo → de pessoas físicas (4 %) e de organizações (6 %)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовые: Заработок → Самозанятость → от физлиц (4 %) и от организаций (6 %)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır: Kazançlar → Serbest çalışma → kişilerden (%4) ve kurumlardan (%6)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово: Заробіток → Самозайнятість → від фізичних осіб (4 %) і від організацій (6 %)"
          }
        }
      }
    },
    "selfEmployed.setup.readyHint": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыі будуць створаны, а наяўныя атрымаюць свае стаўкі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kategorien sind angelegt oder bekommen ihre Sätze, wo sie schon sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The categories are made, or get their rates where they are already."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías están creadas, o reciben sus tasas donde ya existen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories sont créées, ou reçoivent leurs taux là où elles existent déjà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le categorie vengono create oppure, se esistono già, vengono aggiornate le aliquote."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Санаттар жасалды немесе бар жерінде өз мөлшерлемесін алды."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie zostały utworzone lub przypisano stawki do istniejących."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias serão criadas ou terão suas alíquotas atualizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории создадутся, а если уже есть — получат ставки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoriler oluşturuldu veya mevcut kategorilerin oranları güncellendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорії створено або вони вже мають свої ставки."
          }
        }
      }
    },
