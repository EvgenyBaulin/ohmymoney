    "allocation.shown.hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız göstərilir: ödənişlər, borclar və limitlər burada saxlanmır. Limitləri Planlamada dəyişin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Толькі паказана: плацяжы, абавязковыя выплаты і ліміты тут не запісваюцца. Змяняйце ліміты ў Планаванні."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze pro přehled: platby, závazky a limity se zde nezapisují. Limity změníte v Plánování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zur Anzeige: Zahlungen, Fälligkeiten und Limits werden hier nicht eingetragen. Limits ändern Sie in der Planung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only shown: payments, dues and limits are not written here. Change limits in Planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestra: aquí no se anotan pagos, vencimientos ni límites. Cambie los límites en Planificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplement affiché : les paiements, échéances et plafonds ne sont pas notés ici. Modifiez les plafonds dans « Planification »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն ցուցադրվում է․ վճարումները, պարտքերը և սահմանաչափերը այստեղ չեն գրանցվում։ Սահմանաչափերը փոխեք «Պլանավորում» բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo a titolo informativo: pagamenti, importi dovuti e limiti non vengono registrati qui. Modifica i limiti in Pianificazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示のみです。支払い、支払予定、上限はここでは記録されません。上限は「計画」で変更できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ საჩვენებლად: გადახდები, გადასახდელები და ლიმიტები აქ არ იწერება. ლიმიტები შეცვალეთ დაგეგმვაში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек көрсетіледі: төлемдер, берешектер және лимиттер мұнда жазылмайды. Лимиттерді «Жоспарлауда» өзгертіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 전용: 결제, 납부액 및 한도는 여기에 기록되지 않습니다. 한도는 계획에서 변경하십시오."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Маалымат үчүн гана: төлөмдөр, карыздар жана лимиттер бул жерден сакталбайт. Лимиттерди «Пландоо» бөлүмүнөн өзгөртүңүз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen ter informatie: betalingen, verplichtingen en limieten worden hier niet vastgelegd. Wijzig limieten bij Planning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko podgląd: płatności, zobowiązania i limity nie są tu zapisywane. Zmienisz je w Planowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para consulta: pagamentos, valores devidos e limites não são registrados aqui. Altere os limites em Planejamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para consulta: os pagamentos, valores a pagar e limites não são aqui registados. Altera os limites em Planeamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только показано: платежи, сроки и лимиты здесь не записываются. Изменить лимиты — в «Планировании»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Танҳо намоиш дода мешавад: пардохтҳо, қарзҳо ва лимитҳо дар ин ҷо сабт намешаванд. Лимитҳоро дар «Банақшагирӣ» тағйир диҳед."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca gösterilir: ödemeler, borçlar ve limitler buraya kaydedilmez. Limitleri Planlama bölümünden değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише показано: платежі, внески й ліміти тут не записуються. Змініть ліміти в «Плануванні»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat ko‘rsatilgan: to‘lovlar, qarzlar va limitlar bu yerda saqlanmaydi. Limitlarni Rejalashtirishda o‘zgartiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供查看：付款、应付款和限额不会在此记录。请在“规划”中更改限额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供顯示：付款、應繳款項和限額不會在此記錄。請在「規劃」中更改限額。"
          }
        }
      }
    },
