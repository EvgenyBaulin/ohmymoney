    "npd.gap.less": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergi idarəsi %@ az hesablayıb"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падатковая налічыла на %@ менш"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Finanční úřad vyměřil o %@ méně"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Finanzamt hat %@ weniger berechnet"
          }
        },
        "en": {
