            "value": "The tax office charged %@ less"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La oficina de impuestos cobró %@ menos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fisc a prélevé %@ de moins"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարկայինը հաշվարկել է %@-ով պակաս"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fisco ha addebitato %@ in meno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "税務署の請求額は%@少なくなりました"
