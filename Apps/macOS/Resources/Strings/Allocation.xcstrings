    "allocation.shown.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only shown: payments, dues and limits are not written here. Change limits in Planning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestra: aquí no se anotan pagos, vencimientos ni límites. Cambie los límites en Planificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplement affiché : les paiements, échéances et plafonds ne sont pas notés ici. Modifiez les plafonds dans « Planification »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только показано: платежи, сроки и лимиты здесь не записываются. Изменить лимиты — в «Планировании»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише показано: платежі, внески й ліміти тут не записуються. Змініть ліміти в «Плануванні»."
