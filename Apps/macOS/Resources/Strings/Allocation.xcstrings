        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず自営業税の概算%@を差し引き、残りの%@をルールに従って割り当てます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ თვითდასაქმების გადასახადი ≈ %@; წესებით ნაწილდება %@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдымен өзін-өзі жұмыспен қамтығандар салығы ≈ %@; ережелер өз үлесін %@ ішінен алады"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 자영업세 약 %@, 규칙에 따라 %@ 배분"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Адегенде өз алдынча иштөө салыгы ≈ %@; эрежелер %@ суммасынан үлүш алат"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerst circa %@ belasting voor zelfstandigen; de regels verdelen %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw podatek od samozatrudnienia ≈ %@; reguły dzielą %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposto de autônomo ≈ %@ primeiro; as regras usam parte de %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, imposto sobre trabalho independente ≈ %@; as regras aplicam-se a %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала налог самозанятого ≈ %@; правила берут долю от %@"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Аввал андози худмашғулият ≈ %@; ҳиссаи қоидаҳо аз %@"
