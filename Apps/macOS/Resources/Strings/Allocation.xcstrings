    "allocation.base": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə fərdi fəaliyyət vergisi ≈ %@; qaydalar %@ məbləğindən pay ayırır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спачатку падатак на прафесійны даход ≈ %@; правілы бяруць долю ад %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve daň ze samostatné činnosti ≈ %@; pravidla rozdělí podíl z %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst die Selbstständigensteuer ≈ %@; die Regeln nehmen ihren Anteil von %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax of self-employment ≈ %@ first; the rules take their share of %@"
          }
