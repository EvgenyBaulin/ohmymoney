    "monthRest.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be spent now less the payments ahead. «Not now» puts it away until next month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se puede gastar ahora menos los pagos pendientes. «Ahora no» lo aparta hasta el mes que viene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui peut être dépensé maintenant, moins les paiements à venir. « Pas maintenant » le met de côté jusqu'au mois prochain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Можно тратить сейчас» минус платежи впереди. «Не надо» — до следующего месяца."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що можна витратити зараз, без наперед запланованих платежів. «Не зараз» відкладає це до наступного місяця."
          }
        }
      }
    },
