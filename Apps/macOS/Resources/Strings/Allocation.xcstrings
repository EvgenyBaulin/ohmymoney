    "selfEmployed.tile.off": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametrlər → Planlaşdırma bölməsində «Özünüməşğulam» seçimini aktiv edin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце «Я самазаняты» ў Наладах → Планаванне"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte „Jsem OSVČ“ v Nastavení → Plánování"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie „Ich bin selbstständig“ unter Einstellungen → Planung ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on «I am self-employed» in Settings → Planning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active «Soy autónomo» en Ajustes → Planificación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez « Je suis indépendant » dans Réglages → Planification"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացրեք «Ես ինքնազբաղված եմ» տարբերակը Կարգավորումներ → Պլանավորում բաժնում"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva «Sono un lavoratore autonomo» in Impostazioni → Pianificazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」→「プランニング」で「個人事業主」をオンにしてください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართეთ «თვითდასაქმებული ვარ»: პარამეტრები → დაგეგმვა"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Параметрлер → Жоспарлау» ішінде «Мен өзін-өзі жұмыспен қамтамын» қосыңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 계획에서 «자영업자입니다»를 켜세요"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Орнотуулар → Пландоо бөлүмүндө «Мен өзүн-өзү иш менен камсыз кылам» дегенди күйгүзүңүз"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel ‘Ik ben zelfstandig’ in via Instellingen → Planning"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz «Jestem samozatrudniony» w Ustawienia → Planowanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative «Sou autônomo» em Ajustes → Planejamento"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative «Sou trabalhador independente» em Definições → Planeamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Я самозанятый» в «Настройки → Планирование»"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар Танзимот → Банақшагирӣ «Ман худмашғулам»-ро фаъол кунед"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → Planlama bölümünde «Serbest çalışıyorum» seçeneğini açın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть «Я самозайнятий» у «Налаштування → Планування»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlamalar → Rejalashtirish bo‘limida «O‘zimni o‘zim band qilganman»ni yoqing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”→“规划”中开启“我是个体经营者”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」→「規劃」中開啟「我是自僱人士」"
          }
        }
      }
    },
    "tax.pay.check": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesablanıb: %@ — rübün gəlirinə kateqoriyanın dərəcəsi tətbiq edilib. Vergi orqanı ilə dəqiqləşdirin — son qərar onundur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлічана: %@ — стаўка катэгорыі ад даходу за квартал. Зверце з падатковай — канчатковая сума за ёй."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypočteno: %@ — sazba kategorie z příjmů za čtvrtletí. Ověřte ji u finančního úřadu, který má poslední slovo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet: %@ — der Satz der Kategorie auf die Einnahmen des Quartals. Prüfen Sie ihn beim Finanzamt — das letzte Wort hat es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worked out: %@ — the rate of the category on the income of the quarter. Check it against the tax office — it has the last word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado: %@ — la tasa de la categoría sobre los ingresos del trimestre. Compruébelo con la oficina de impuestos: la última palabra la tiene ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé : %@ — le taux de la catégorie sur le revenu du trimestre. Vérifiez-le auprès du fisc — le dernier mot lui revient."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվարկված է՝ %@՝ եռամսյակի եկամտի նկատմամբ կատեգորիայի դրույքաչափով։ Ստուգեք հարկային ծառայությունում․ վերջնական որոշումը նրանն է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolo: %@ — aliquota della categoria applicata al reddito del trimestre. Verifica con l’ufficio delle imposte: spetta a lui l’ultima parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算結果：%@ — 四半期の収入にカテゴリの税率を適用。税務署の確定額をご確認ください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოთვლილია: %@ — კატეგორიის განაკვეთი კვარტლის შემოსავალზე. გადაამოწმეთ საგადასახადოში — საბოლოო გადაწყვეტილებას ის იღებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Есептелді: %@ — тоқсан табысына санаттың мөлшерлемесі. Салық басқармасымен тексеріңіз — соңғы сөз оныкі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산 결과: %@ — 분기 수입에 카테고리 세율을 적용했습니다. 세무서의 최종 결정과 대조하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эсептелди: %@ — чейректеги кирешеге категориянын чени колдонулду. Салык кызматы менен тактаңыз — акыркы чечим ошолордуку."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berekend: %@ — het categorietarief over de inkomsten van het kwartaal. Controleer dit bij de belastingdienst; die heeft het laatste woord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczono: %@ — według stawki kategorii od przychodu za kwartał. Sprawdź kwotę w urzędzie skarbowym — jego wyliczenie jest wiążące."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado: %@ — alíquota da categoria sobre a renda do trimestre. Confira com a autoridade fiscal, que tem a palavra final."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado: %@ — a taxa da categoria sobre os rendimentos do trimestre. Confirme junto da autoridade tributária — é ela que tem a palavra final."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитано: %@ — ставка категории с доходов квартала. Сверьте с ФНС — последнее слово за ней."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳисоб шуд: %@ — меъёри категория аз даромади семоҳа. Бо идораи андоз санҷед — қарори ниҳоӣ аз они он аст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplanan: %@ — kategori oranı üç aylık gelire uygulandı. Vergi dairesinden kontrol edin; son karar vergi dairesinindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розраховано: %@ — ставка категорії від доходу за квартал. Звірте з податковою — останнє слово за нею."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisoblandi: %@ — chorak daromadiga toifa stavkasi qo‘llandi. Soliq idorasida tekshiring — yakuniy qaror uniki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算结果：%@，按该类别税率计算本季度收入的税额。请与税务机关核对，以其结果为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算結果：%@ — 依本季收入類別的稅率計算。請向稅務機關核對，以其結果為準。"
          }
        }
      }
    },
