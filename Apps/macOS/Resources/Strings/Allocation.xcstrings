            "value": "Салык кызматы %@ аз эсептеди"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De belastingdienst heeft %@ minder in rekening gebracht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urząd naliczył o %@ mniej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fisco cobrou %@ a menos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A autoridade tributária cobrou menos %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ФНС насчитала на %@ меньше"
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Идораи андоз %@ камтар ҳисоб кард"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergi dairesi %@ daha az tahakkuk ettirdi"
