        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la cuenta marcada como colchón; si son varias, la hoja pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers le compte marqué comme matelas ; s'il y en a plusieurs, la feuille demande lequel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեպի պահուստ նշված հաշիվը։ Մի քանիսի դեպքում ընտրեք ցանկից։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al conto indicato come fondo di emergenza; se ce ne sono diversi, ti verrà chiesto quale usare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生活防衛資金に指定した口座に振り分けます。複数ある場合は選択できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბუფერად მონიშნულ ანგარიშზე; რამდენიმე ანგარიშის შემთხვევაში აირჩევთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жастық ретінде белгіленген есеп-шотқа; бірнеше болса, парақ сұрайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비상금으로 지정된 계좌에 배분합니다. 계좌가 여러 개면 선택할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Коопсуздук жаздыгы деп белгиленген эсепке; бир нече эсеп болсо, тандоо суралат."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar de rekening die als buffer is gemarkeerd. Bij meerdere rekeningen kies je er een."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na konto oznaczone jako poduszka; jeśli jest ich kilka, wybierz je w arkuszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a conta marcada como reserva. Se houver várias, escolha uma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a conta assinalada como fundo de emergência; se houver várias, ser-te-á perguntado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На счёт, отмеченный подушкой; если их несколько, лист спросит."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ба ҳисоби захиравӣ; агар чандто бошад, интихоб пурсида мешавад."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik yastığı olarak işaretlenen hesaba aktarılır; birden fazla hesap varsa seçim istenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На рахунок, позначений як подушка; якщо їх кілька, аркуш запитає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaxira deb belgilangan hisobga; bir nechta bo‘lsa, tanlash so‘raladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存入标记为备用金的账户；如有多个账户，将提示选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分配至標示為預備金的帳戶；若有多個帳戶，系統會請你選擇。"
          }
        }
      }
    },
