        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposto de autônomo ≈ %@ primeiro; as regras usam parte de %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала налог самозанятого ≈ %@; правила берут долю от %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce serbest çalışma vergisi ≈ %@; kurallar %@ üzerinden pay alır"
