    "nav.edit.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dörd bölmə seçin və onları istədiyiniz ardıcıllıqla düzün. Qalanları «Daha çox» bölməsində qalır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце чатыры раздзелы і перацягніце іх у патрэбным парадку. Астатнія застануцца ў «Яшчэ»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie vier Bereiche und ziehen Sie sie in die gewünschte Reihenfolge. Die übrigen bleiben unter „Mehr“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose four sections and drag them into the order you like. The rest stay in More."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija cuatro secciones y arrástrelas al orden que prefiera. El resto se queda en Más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quatre sections et faites-les glisser dans l'ordre souhaité. Les autres restent dans « Plus »."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք չորս բաժին և քաշելով դասավորեք դրանք։ Մնացածը կմնան «Ավելին» բաժնում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quattro sezioni e trascinale nell’ordine che preferisci. Le altre restano in Altro."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ ოთხი სექცია და გადაათრიეთ სასურველი მიმდევრობით. დანარჩენი დარჩება განყოფილებაში „მეტი“."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төрт бөлім таңдап, қалаған тәртіпке сүйреңіз. Қалғандары «Көбірек» ішінде қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Төрт бөлүмдү тандап, каалаган тартипте сүйрөп жайгаштырыңыз. Калгандары «Дагы» бөлүмүндө калат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz cztery sekcje i przeciągnij je w wybranej kolejności. Pozostałe zostaną w Więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quatro seções e arraste-as para ordená-las. As demais ficam em Mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quatro secções e arraste-as para a ordem pretendida. As restantes ficam em Mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите четыре раздела и перетащите их в нужном порядке. Остальные останутся в «Ещё»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чор бахшро интихоб кунед ва ба тартиби дилхоҳ кашед. Боқимонда дар «Бештар» мемонанд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört bölüm seçin ve istediğiniz sıraya sürükleyin. Diğerleri Daha Fazla’da kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть чотири розділи й перетягніть їх у зручному порядку. Решта залишиться в «Ще»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "To‘rtta bo‘limni tanlang va kerakli tartibda joylashtiring. Qolganlari «Yana» bo‘limida qoladi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇四個區段，拖移以調整順序。其餘區段會保留在「更多」。"
          }
        }
      }
    },
