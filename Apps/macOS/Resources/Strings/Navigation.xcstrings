    "nav.edit.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце чатыры раздзелы і перацягніце іх у патрэбным парадку. Астатнія застануцца ў «Яшчэ»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie vier Bereiche und ziehen Sie sie in die gewünschte Reihenfolge. Die übrigen bleiben unter „Mehr“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose four sections and drag them into the order you like. The rest stay in More."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija cuatro secciones y arrástrelas al orden que prefiera. El resto se queda en Más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quatre sections et faites-les glisser dans l'ordre souhaité. Les autres restent dans « Plus »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quattro sezioni e trascinale nell’ordine che preferisci. Le altre restano in Altro."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төрт бөлім таңдап, қалаған тәртіпке сүйреңіз. Қалғандары «Көбірек» ішінде қалады."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz cztery sekcje i przeciągnij je w wybranej kolejności. Pozostałe zostaną w Więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quatro seções e arraste-as para ordená-las. As demais ficam em Mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите четыре раздела и перетащите их в нужном порядке. Остальные останутся в «Ещё»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört bölüm seçin ve istediğiniz sıraya sürükleyin. Diğerleri Daha Fazla’da kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть чотири розділи й перетягніть їх у зручному порядку. Решта залишиться в «Ще»."
          }
        }
      }
    },
