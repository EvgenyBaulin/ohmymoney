    "nav.edit.footer": {
      "comment": "Translation not verified by a native speaker.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie vier Bereiche und ziehen Sie sie in die gewünschte Reihenfolge. Die übrigen bleiben unter „Mehr“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose four sections and drag them into the order you like. The rest stay in More."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Төрт бөлім таңдап, қалаған тәртіпке сүйреңіз. Қалғандары «Көбірек» ішінде қалады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите четыре раздела и перетащите их в нужном порядке. Остальные останутся в «Ещё»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть чотири розділи й перетягніть їх у зручному порядку. Решта залишиться в «Ще»."
          }
        }
      }
    },
